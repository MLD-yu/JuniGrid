<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JuniGrid</RootNamespace>
    <AssemblyName>JuniGrid</AssemblyName>
    <!-- 唯一版本源：发版只改这里。AppInfo.Version 在运行时从程序集版本读取，
         保证 Nexus Application-Version 头与发行构建永远一致（AUP 要求） -->
    <Version>1.2.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\junigrid-logo.ico</ApplicationIcon>
    <!-- 只保留中英文卫星资源：自包含发布里 40+ 语言的 WPF/FluentUI 资源 dll 占 8MB+，
         中文应用用不到（cs/de/es/fr/... 每个语言一套 PresentationFramework.resources.dll） -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 白盒单测（test-harness）需要碰 internal 工具类 -->
    <InternalsVisibleTo Include="JuniGridTestHarness" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.12" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\junigrid-logo.ico" />
    <Resource Include="Assets\junigrid-logo-256.png" />
    <Resource Include="Assets\keyart.png" />
  </ItemGroup>

  <!--
    CRITICAL: Razor SDK auto-includes wwwroot as Content but does NOT copy
    it to the output dir by default in WPF hybrid projects. We use <Update>
    (not <Include>) to modify the SDK-provided items instead of duplicating.
  -->
  <ItemGroup>
    <Content Update="wwwroot\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Blazor Hybrid Debug 会把 IntermediateOutputPath 下的若干目录（scopedcss\bundle、
    jsmodules\ 等）当作静态资源 ContentRoot 交给 PhysicalFileProvider。目录不存在时
    直接 DirectoryNotFoundException（2026-09-24 实测：先缺 scopedcss\bundle，补后又缺
    jsmodules\）。这里统一：构建结束时把清单里所有落在 IntermediateOutputPath 下的
    ContentRoot 都建出来，外加两个 SDK 约定目录兜底。
  -->
  <Target Name="EnsureStaticWebAssetContentRoots"
          AfterTargets="ResolveScopedCssOutputs;ResolveJSModuleStaticWebAssets;GenerateStaticWebAssetsManifest;Build">
    <MakeDir Directories="$(IntermediateOutputPath)scopedcss\bundle" />
    <MakeDir Directories="$(IntermediateOutputPath)scopedcss\projectbundle" />
    <MakeDir Directories="$(IntermediateOutputPath)jsmodules" />
    <ItemGroup>
      <_SwaIntermediateRoots Include="@(StaticWebAsset->'%(ContentRoot)')"
                             Condition="'%(ContentRoot)' != ''" />
    </ItemGroup>
    <MakeDir Directories="@(_SwaIntermediateRoots->Distinct())" />
  </Target>

</Project>

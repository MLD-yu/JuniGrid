<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JuniGrid</RootNamespace>
    <AssemblyName>JuniGrid</AssemblyName>
    <!-- 唯一版本源：发版只改这里。AppInfo.Version 在运行时从程序集版本读取，
         保证 Nexus Application-Version 头与发行构建永远一致（AUP 要求） -->
    <Version>1.2.9</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\junigrid-logo.ico</ApplicationIcon>
    <!-- 只保留中英文卫星资源：自包含发布里 40+ 语言的 WPF/FluentUI 资源 dll 占 8MB+，
         中文应用用不到（cs/de/es/fr/... 每个语言一套 PresentationFramework.resources.dll） -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <!-- 与安装器同一颗雷：主程序要加载 WebView2 等原生库，声明 CET 后在老 ntdll /
         带不守规则钩子的机器上启动即被 OS 终止。关掉声明换兼容；少一层 ROP 缓解。 -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <!-- 白盒单测（test-harness）需要碰 internal 工具类 -->
    <InternalsVisibleTo Include="JuniGridTestHarness" />
  </ItemGroup>

  <!--
    命令桥（smapi-bridge/，net6 的 SMAPI mod）要随应用发到用户机器上：日志页的
    「启用命令桥」把 <应用目录>\bridge-mod\ 整个复制进 Mods。
    ReferenceOutputAssembly=false + Private=false ⇒ 只借它的构建顺序，不把 net6 程序集
    当依赖塞进应用（塞了会被 .NET 10 的 deps.json 认成加载项）。

    ⚠ 它有外部依赖：smapi-bridge.csproj 故意不用 net6 的隐式框架引用，而是直接拿
    游戏根目录那 244 个程序集当编译期引用（理由见那边的注释）。所以游戏本体不在的
    机器上（CI、新克隆的仓库、别人的电脑）编它是必然失败的 —— CS0518 满屏。
    这里按「游戏目录在不在」自动决定编不编，-p:BuildBridgeMod=true/false 可强制覆盖。
    不编的后果：产物里没有 bridge-mod，应用侧 CopyBridgedInto 返回
    「安装包里缺少命令桥文件」—— 功能降级，不是崩溃。
  -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">$(JUNIGRID_GAME_PATH)</GamePath>
    <GamePath Condition="'$(GamePath)' == ''">E:\Steam\steamapps\common\Stardew Valley</GamePath>
    <BuildBridgeMod Condition="'$(BuildBridgeMod)' == '' and Exists('$(GamePath)\StardewModdingAPI.dll')">true</BuildBridgeMod>
    <BuildBridgeMod Condition="'$(BuildBridgeMod)' == ''">false</BuildBridgeMod>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildBridgeMod)' == 'true'">
    <ProjectReference Include="..\smapi-bridge\JuniGridCommandBridge.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="StageBridgeMod" AfterTargets="Build" Condition="'$(BuildBridgeMod)' == 'true'">
    <ItemGroup>
      <_BridgeFiles Include="..\smapi-bridge\bin\$(Configuration)\*.*"
                    Exclude="..\smapi-bridge\bin\$(Configuration)\*.pdb;..\smapi-bridge\bin\$(Configuration)\*.deps.json;..\smapi-bridge\bin\$(Configuration)\*.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_BridgeFiles)" DestinationFolder="$(OutDir)bridge-mod"
          SkipUnchangedFiles="true" Condition="'@(_BridgeFiles)' != ''" />
  </Target>

  <Target Name="StageBridgeModOnPublish" AfterTargets="Publish" Condition="'$(BuildBridgeMod)' == 'true'">
    <ItemGroup>
      <_BridgePub Include="..\smapi-bridge\bin\$(Configuration)\*.*"
                  Exclude="..\smapi-bridge\bin\$(Configuration)\*.pdb;..\smapi-bridge\bin\$(Configuration)\*.deps.json;..\smapi-bridge\bin\$(Configuration)\*.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_BridgePub)" DestinationFolder="$(PublishDir)bridge-mod"
          SkipUnchangedFiles="true" Condition="'@(_BridgePub)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\junigrid-logo.ico" />
    <Resource Include="Assets\junigrid-logo-256.png" />
    <Resource Include="Assets\keyart.png" />
  </ItemGroup>

  <!-- i18n 语言目录：内嵌进程序集，LocService 启动时读取（自包含/单文件发布也取得到）。
       源文本即 key 方案只需英文目录（中文即原文）。 -->
  <ItemGroup>
    <EmbeddedResource Include="i18n\en.json" />
  </ItemGroup>

  <!--
    CRITICAL: Razor SDK auto-includes wwwroot as Content but does NOT copy
    it to the output dir by default in WPF hybrid projects. We use <Update>
    (not <Include>) to modify the SDK-provided items instead of duplicating.
  -->
  <ItemGroup>
    <Content Update="wwwroot\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Blazor Hybrid Debug 会把 IntermediateOutputPath 下的若干目录（scopedcss\bundle、
    jsmodules\ 等）当作静态资源 ContentRoot 交给 PhysicalFileProvider。目录不存在时
    直接 DirectoryNotFoundException（2026-09-24 实测：先缺 scopedcss\bundle，补后又缺
    jsmodules\）。这里统一：构建结束时把清单里所有落在 IntermediateOutputPath 下的
    ContentRoot 都建出来，外加两个 SDK 约定目录兜底。
  -->
  <Target Name="EnsureStaticWebAssetContentRoots"
          AfterTargets="ResolveScopedCssOutputs;ResolveJSModuleStaticWebAssets;GenerateStaticWebAssetsManifest;Build">
    <MakeDir Directories="$(IntermediateOutputPath)scopedcss\bundle" />
    <MakeDir Directories="$(IntermediateOutputPath)scopedcss\projectbundle" />
    <MakeDir Directories="$(IntermediateOutputPath)jsmodules" />
    <ItemGroup>
      <_SwaIntermediateRoots Include="@(StaticWebAsset->'%(ContentRoot)')"
                             Condition="'%(ContentRoot)' != ''" />
    </ItemGroup>
    <MakeDir Directories="@(_SwaIntermediateRoots->Distinct())" />
  </Target>

</Project>

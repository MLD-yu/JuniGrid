<Window x:Class="JuniGrid.NexusBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nexus Mods — 内置浏览器（点 Mod Manager Download 自动安装）"
        Width="1150" Height="760"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB"
        Icon="Assets/junigrid-logo.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="#11000000" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="◀" Width="30" Height="28" Margin="0,0,4,0" Click="Back_Click"/>
                    <Button Content="▶" Width="30" Height="28" Margin="0,0,4,0" Click="Forward_Click"/>
                    <Button Content="⟳" Width="30" Height="28" Margin="0,0,8,0" Click="Reload_Click"/>
                </StackPanel>
                <Button Content="🌐 外部浏览器打开" DockPanel.Dock="Right"
                        Height="28" VerticalAlignment="Center" Padding="8,0"
                        Click="OpenExternal_Click"/>
                <TextBlock x:Name="txtUrl" VerticalAlignment="Center"
                           Foreground="#66000000" FontSize="12"
                           TextTrimming="CharacterEllipsis" Text="加载中…"/>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="web" Grid.Row="1"/>
    </Grid>
</Window>

<Window x:Class="JuniGrid.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载 JuniGrid"
        Width="500" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#FFFFFF"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="0"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF4655" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF5A66" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#E63A4A" />

    <!-- 红色危险按钮（卸载） -->
    <Style x:Key="DangerButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource DangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#3A000000" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 浅灰按钮（白底上的取消） -->
    <Style x:Key="LightGrayButton" TargetType="Button">
      <Setter Property="Background" Value="#ECEEF0" />
      <Setter Property="Foreground" Value="#1A1A1A" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E0E3E6" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#D5D9DD" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 黑色按钮（完成） -->
    <Style x:Key="BlackButton" TargetType="Button">
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#333333" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0F0F0F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标题栏按钮：图标描边在用例里内联指定，Tag 覆盖悬停底色 -->
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=#22FFFFFF}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- ========== 拦截页（应用正在运行） ========== -->
    <Grid x:Name="BlockedScreen" Visibility="Collapsed" Background="#FFFFFF">
      <Image Source="/Assets/keyart.png" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.07" IsHitTestVisible="False" />
      <StackPanel Margin="36,44,40,0">
        <Image Source="/Assets/junigrid-logo-256.png" Width="52" Height="52" HorizontalAlignment="Left"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="JuniGrid 正在运行" FontSize="26" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,26,0,0" TextWrapping="Wrap" />
        <Rectangle Height="5" Width="170" HorizontalAlignment="Left" Fill="#1A1A1A" RadiusX="2.5" RadiusY="2.5" Margin="0,10,0,0" />
        <TextBlock Text="我们无法卸载，因为 JuniGrid 仍在运行中。请关闭 JuniGrid 并重试。"
                   FontSize="15" Foreground="#555555" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,0" />
      </StackPanel>
      <Button x:Name="BtnOk" Style="{StaticResource BlackButton}" Content="好　的" Width="340" Height="56"
              VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,44" Click="OnCancel" />
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Orientation="Horizontal">
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnMinimize">
          <Path Data="M1,5 H11" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnClose">
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ========== 确认页（白底 + 洗白立绘） ========== -->
    <Grid x:Name="ConfirmScreen" Background="#FFFFFF">
      <Image Source="/Assets/keyart.png" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.07" IsHitTestVisible="False" />
      <StackPanel Margin="36,44,40,0">
        <Image Source="/Assets/junigrid-logo-256.png" Width="52" Height="52" HorizontalAlignment="Left"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="卸载 JuniGrid？" FontSize="26" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,26,0,0" TextWrapping="Wrap" />
        <TextBlock Text="程序文件、快捷方式和本地数据（userdata）都将被删除，此操作无法撤销。&#x0a;确定要卸载 JuniGrid 吗？"
                   FontSize="15" Foreground="#555555" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="36,0,36,44">
        <Button x:Name="BtnCancel" Style="{StaticResource LightGrayButton}" Content="取　消" Width="150" Height="48" Click="OnCancel" />
        <Button x:Name="BtnUninstall" Style="{StaticResource BlackButton}" Content="卸　载" Width="150" Height="48" Margin="18,0,0,0" Click="OnUninstall" />
      </StackPanel>
      <!-- 白底上的深色窗口按钮 -->
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Orientation="Horizontal">
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnMinimize" ToolTip="最小化">
          <Path Data="M1,5 H11" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnClose" ToolTip="关闭">
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ========== 卸载中（立绘 + 红条） ========== -->
    <Grid x:Name="WorkingScreen" Visibility="Collapsed">
      <Image Source="/Assets/keyart.png" Stretch="UniformToFill" VerticalAlignment="Top" />
      <Rectangle VerticalAlignment="Bottom" Height="200" IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#000D0F12" Offset="0" />
            <GradientStop Color="#E60D0F12" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <TextBlock Text="正在卸载" Foreground="#F4F7F5" FontWeight="Bold" FontSize="14"
                 VerticalAlignment="Bottom" Margin="24,0,0,28" />
      <Rectangle VerticalAlignment="Bottom" Height="7" Fill="#2EFFFFFF" />
      <Canvas x:Name="IndHost" VerticalAlignment="Bottom" Height="7" ClipToBounds="True">
        <Rectangle x:Name="IndBar" Canvas.Top="0" Height="7" Width="140" Fill="{StaticResource DangerBrush}" RadiusX="3.5" RadiusY="3.5" />
      </Canvas>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Orientation="Horizontal">
        <Button Style="{StaticResource ChromeButton}" Click="OnMinimize">
          <Path Data="M1,5 H11" Stroke="#E6FFFFFF" StrokeThickness="1.4" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Tag="#E81123" Click="OnClose">
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#E6FFFFFF" StrokeThickness="1.4" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ========== 完成（白底 + 洗白立绘） ========== -->
    <Grid x:Name="DoneScreen" Visibility="Collapsed" Background="#FFFFFF">
      <Image Source="/Assets/keyart.png" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.07" IsHitTestVisible="False" />
      <StackPanel Margin="36,44,40,0">
        <TextBlock Text="卸载完成" FontSize="26" FontWeight="Bold" Foreground="#1A1A1A" />
        <Rectangle Height="5" Width="150" HorizontalAlignment="Left" Fill="#1A1A1A" RadiusX="2.5" RadiusY="2.5" Margin="0,10,0,0" />
        <TextBlock Text="JuniGrid 已成功卸载。" FontSize="15" Foreground="#555555" Margin="0,22,0,0" />
      </StackPanel>
      <Button x:Name="BtnDone" Style="{StaticResource BlackButton}" Content="完　成" Width="340" Height="56"
              VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,44" Click="OnDone" />
      <!-- 白底上的深色窗口按钮 -->
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Orientation="Horizontal">
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnMinimize">
          <Path Data="M1,5 H11" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Tag="#22000000" Click="OnClose">
          <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#88000000" StrokeThickness="1.4" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>

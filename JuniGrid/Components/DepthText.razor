@namespace JuniGrid.Components
@inject IJSRuntime JS

@* v0.93.0：React Bits DepthText 的 Blazor 移植 —— 3D 挤出文字，指针视差 + 空闲自动环绕 *@
<span class="depth-text" @ref="_root"
      style="--dt-persp:900px;--dt-size:@FontSize;--dt-weight:800;--dt-face:#f8fafc;--dt-shadow:0 14px 22px color-mix(in srgb,#3d3d3d 30%,transparent),0 2px 5px rgba(0,0,0,.22)">
    <span class="depth-text__stage">
        @foreach (var L in _layers)
        {
            <span aria-hidden="true" class="depth-text__layer" style="color:@L.Color;transform:translateZ(@(L.Z)px)">@Text</span>
        }
        <span class="depth-text__face">@Text</span>
    </span>
</span>

@code {
    private const int LayerCount = 18;
    private const double LayerDepth = 1.2;

    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string FontSize { get; set; } = "16px";

    private ElementReference _root;
    private readonly List<(string Color, string Z)> _layers = new();

    protected override void OnParametersSet()
    {
        _layers.Clear();
        for (var li = 0; li < LayerCount; li++)
        {
            var idx = LayerCount - li;
            var prog = (double)idx / LayerCount;
            var mix = (int)Math.Round((1 - prog * prog) * 72 + 4);
            _layers.Add(($"color-mix(in srgb,#f8fafc {mix}%,#3d3d3d)",
                (-idx * LayerDepth).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            try { await JS.InvokeVoidAsync("junigridJs.depthTextInit", _root, 7.5); } catch { }
    }
}

    private void CancelSwitch() => _switchCts?.Cancel();

    private void ToggleLock()
    {
        if (_manifestPath is null) return;
        var want = !_manifestLocked;
        var (ok, err) = SteamService.SetGameVersionLock(_manifestPath, want);
        if (!ok)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", err, "err");
            return;
        }
        _manifestLocked = want;
        var cfg = Cfg.Current;
        cfg.LockGameVersion = want;
        Cfg.Save(cfg);
        _ = JS.InvokeVoidAsync("junigridJs.toast", want ? LocService.Tr("已锁定游戏版本") : LocService.Tr("已解除锁定"));
        StateHasChanged();
    }

    // 删除走 Depot.DeleteStagedPackage → Directory.Delete，硬删、不进回收站；一个包又是几 GB
    // 且要重下才能回来。所以点「删除」先只记下目标，把大小和后果写在按钮上方再问一句。
    private string? _pendingDeleteId;
    private string? _pendingDeleteText;

    private void AskDelete(string label, DepotDownloaderService.StagedPackage pkg)
    {
        _pendingDeleteId = pkg.ManifestId;
        // 文案口径收在服务层：设置页那个「删除」按钮删的是同一个目录，两处必须报同一句话
        _pendingDeleteText = DepotDownloaderService.DeletePackConfirmText(pkg);
        StateHasChanged();
    }

    private void CancelDelete() { _pendingDeleteId = null; _pendingDeleteText = null; }

    /// <summary>认领一个本地版本包（别的机器 / U盘 / 网盘拷来的）。校验、补元数据、必要时搬进
    /// 统一缓存目录，之后点它就能离线切换 —— Steam CM 连不上时这是唯一的路。</summary>
    private async Task ImportLocal()
    {
        // 导入是往 depot-staging 里那个版本的目录写；那正是下载中的目录的话，
        // 半成品和整包会混在一个抽屉里（切它时锚点校验会拦，但包已经坏了）。
        if (Center.Snapshot().Any(t => t.Kind == "gameversion" && t.Status is "running" or "paused"))
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("有版本正在下载或排队，等它结束再导入本地包"), "err");
            return;
        }
        var dlg = new Microsoft.Win32.OpenFolderDialog
        { Title = LocService.Tr("选择版本包文件夹（里面有 Stardew Valley.dll 或 Stardew Valley.exe）") };
        if (dlg.ShowDialog() != true) return;
        try
        {
            var label = Depot.ImportLocalPackage(dlg.FolderName);
            RefreshLibrary();
            StateHasChanged();
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tf("已认领本地版本包 {0}，点它即可离线切换", label));
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast",
                ex is DepotDownloaderService.DepotException ? ex.Message : LocService.Tr("导入失败：") + ex.Message, "err");
        }
    }

    // ------------------------------------------------------------------
    // 「用 Steam 客户端下载」
    //
    // 为什么存在：DepotDownloader 出二维码前必须先连上 Steam 的 CM 中继，国内这一段经常整段断
    // （实测日志：21 次 Connection to Steam failed、0 次出码）。Steam 客户端自己为玩星露谷本来就
    // 登录着、也连得上，控制台的 download_depot 用的就是它自己的会话 —— 不需要扫码、不需要密码。
    // ------------------------------------------------------------------

    /// <summary>面板里可选的版本。优先用整理过顺序的 _ordered（已下载的置顶）；
    /// 刚打开弹窗、后台还没读完盘时 _ordered 是空的，退回原始表 —— 否则面板里一个版本都没有。</summary>
    private IEnumerable<DepotDownloaderService.KnownVersion> SteamPickList
        => (_ordered.Count > 0 ? _ordered : _known).Where(x => x.HasManifest).Take(60);

    /// <summary>打开面板。<paramref name="preset"/> 是用户点的那个版本（从行内「下载」进来时带）。</summary>
    private void OpenSteamPanel(DepotDownloaderService.KnownVersion? preset)
    {
        if (_gameRunning)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("游戏正在运行 — 请先退出后再下载"), "err");
            return;
        }
        StopSteamWatch();
        _steamOpen = true;
        _steamError = null;
        _steamStatus = "";
        _steamWhy = LocService.Tr("正在自检 Steam 登录链路…");
        // 默认挑第一个「还没有缓存、也不是当前版本」的，省得每次都手点
        var pick = preset
                   ?? SteamPickList.FirstOrDefault(x => !IsInstalled(x) && StagedOf(x) is null)
                   ?? SteamPickList.FirstOrDefault();
        if (pick is not null) SelectSteamVersion(pick);
        StateHasChanged();
        _ = ProbeSteamAsync();
    }

    /// <summary>自检只为把话说准：是「登录接口都不通」还是「中继全灭」，对策不一样，都不该再让人干等扫码。</summary>
    private async Task ProbeSteamAsync()
    {
        var gen = ++_steamProbeGen;
        try
        {
            var r = await SteamConsoleDepot.ProbeLoginPathAsync(CancellationToken.None);
            if (gen != _steamProbeGen) return;
            await InvokeAsync(() =>
            {
                _steamWhy = SteamConsoleDepot.DescribeProbe(r);
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (gen != _steamProbeGen) return;
            await InvokeAsync(() =>
            {
                _steamWhy = LocService.Tr("自检失败（不影响下面这条路）：") + ex.Message;
                StateHasChanged();
            });
        }
    }

    private void SelectSteamVersion(DepotDownloaderService.KnownVersion k)
    {
        StopSteamWatch();
        var appId = Cfg.Current.SteamAppId;
        _steamManifest = k.ManifestId;
        _steamCommand = SteamConsoleDepot.BuildCommand(appId, "413151", k.ManifestId);
        _steamContentDir = SteamConsoleDepot.ContentDir(SteamService.FindSteamPath(), appId, "413151");
        // 基线 = 命令执行前的体积：只认「和它不一样」的样本，否则上一次下过同版本、
        // 或目录里本来就躺着半截包时，一开拍就会被判成下完
        var snap = SteamConsoleDepot.Measure(_steamContentDir);
        _steamBaseline = snap.Bytes;
        _steamError = null;
        _steamStatus = _steamContentDir is null
            ? LocService.Tr("找不到 Steam 安装目录 —— 请先安装/启动 Steam，或用「导入本地包」")
            : snap.Bytes > 0
                ? LocService.Tf("这个目录里已经有 {0}（上一次下的）。执行命令后 Steam 会自己覆盖或补全", snap.Human)
                : LocService.Tr("还没开始：点下面的按钮复制命令并打开控制台");
        StateHasChanged();
    }

    private void CopyAndOpenConsole()
    {
        if (!CopyTextToClipboard(_steamCommand))
        {
            _steamError = LocService.Tr("复制到剪贴板失败");
            _steamStatus = LocService.Tr("请手动选中上面那条命令复制（左键拖选即可）");
            StateHasChanged();
            return;
        }
        var running = SteamConsoleDepot.IsSteamRunning();
        _steamError = null;
        _steamStatus = running
            ? LocService.Tr("已复制。在 Steam 的「控制台」输入框里 Ctrl+V 粘贴，回车")
            : LocService.Tr("已复制。Steam 没在运行 —— 等它启动并登录完，再打开「控制台」粘贴");
        StateHasChanged();
        SteamConsoleDepot.OpenConsole();
        if (_steamContentDir is not null) StartSteamWatch(_steamContentDir);
    }

    private void StartSteamWatch(string dir)
    {
        StopSteamWatch();
        _steamWatching = true;
        _steamCts = new CancellationTokenSource();
        var ct = _steamCts.Token;
        var baseline = _steamBaseline;
        // 同时盯 Steam 控制台日志：Steam 报「No connection to content servers」这类失败时
        // content 目录永远不涨，只盯目录的面板会傻等 90 分钟（2026-11-16 实机）
        var logPath = SteamConsoleDepot.ConsoleLogPath(SteamService.FindSteamPath());
        long logBase = 0;
        try { if (logPath is not null && File.Exists(logPath)) logBase = new FileInfo(logPath).Length; } catch { }
        _ = Task.Run(async () =>
        {
            try
            {
                while (!ct.IsCancellationRequested)
                {
                    await Task.Delay(2000, ct);
                    var fail = SteamConsoleDepot.ScanConsoleFailure(logPath, logBase);
                    if (fail is null) continue;
                    await InvokeAsync(() =>
                    {
                        StopSteamWatch();
                        _steamError = fail;
                        _steamStatus = fail.Contains("content servers", StringComparison.OrdinalIgnoreCase)
                            ? LocService.Tr("连不上 Steam 内容服务器（CDN），是网络问题：① Steam 设置→下载 换个下载地区，重启 Steam 再试；② 或开加速器/系统代理、或换手机热点后重启 Steam 再试。原样重试没用。")
                            : LocService.Tr("Steam 控制台报了下载失败（原文见上）。检查磁盘空间与写入权限、确认 manifest 属于这个 depot 后重试；也可改用本程序下载或导入本地包。");
                        StateHasChanged();
                    });
                    return;
                }
            }
            catch (OperationCanceledException) { }
        }, CancellationToken.None);
        _ = Task.Run(async () =>
        {
            try
            {
                var done = await SteamConsoleDepot.WaitForDownloadAsync(dir, baseline, async snap =>
                {
                    await InvokeAsync(() =>
                    {
                        _steamStatus = LocService.Tf("Steam 正在下载… 已写入 {0}（{1} 个文件）", snap.Human, snap.Files);
                        StateHasChanged();
                    });
                }, ct);

                if (ct.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    StopSteamWatch();   // 下完了：把控制台日志监听也停掉
                    _steamWatching = false;
                    if (done)
                    {
                        _steamStatus = LocService.Tr("看起来写完了，正在收进版本缓存…");
                        StateHasChanged();
                        await ImportSteamContentAsync();
                    }
                    else
                    {
                        _steamStatus = LocService.Tr(
                            "等了很久也没等到「写完」。如果 Steam 控制台已经显示 Depot download complete，点右下角「我已下完，导入」");
                        StateHasChanged();
                    }
                });
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _steamWatching = false;
                    _steamError = ex.Message;
                    _steamStatus = ex.Message;
                    StateHasChanged();
                });
            }
        }, CancellationToken.None);
    }

    private void StopSteamWatch()
    {
        _steamWatching = false;
        try { _steamCts?.Cancel(); } catch { }
        try { _steamCts?.Dispose(); } catch { }
        _steamCts = null;
    }

    private void StopWatching()
    {
        StopSteamWatch();
        _steamStatus = LocService.Tr("已停止等待。Steam 那边的下载不受影响，下完后点「我已下完，导入」");
        StateHasChanged();
    }

    private void ImportSteamContentManually() => _ = ImportSteamContentAsync();

    private async Task ImportSteamContentAsync()
    {
        if (_steamImporting || _steamManifest is null || _steamContentDir is null) return;
        StopSteamWatch();
        _steamImporting = true;
        _steamError = null;
        _steamStatus = LocService.Tr("正在收进版本缓存…");
        await InvokeAsync(StateHasChanged);
        try
        {
            // 手动导入时 Steam 可能还在写：间隔 2.5 秒量两次，还在涨就退回去接着等。
            // 半截包一旦被标成「已下完」，切过去进档会在 NPC 构造那里空引用闪退
            //（09-22 00:04 WER 实录），所以这道闸不能省。
            var a = SteamConsoleDepot.Measure(_steamContentDir);
            await Task.Delay(2500);
            var b = SteamConsoleDepot.Measure(_steamContentDir);
            if (b.Bytes != a.Bytes)
            {
                _steamStatus = LocService.Tr("Steam 还在写文件（体积还在涨），等它下完再导入");
                StartSteamWatch(_steamContentDir);
                return;
            }
            if (!SteamConsoleDepot.HasGameBinary(_steamContentDir))
                throw new DepotDownloaderService.DepotException(
                    LocService.Tr("这个目录里还没有游戏本体 —— 命令可能没执行成功（或还早着）"));

            var dir = _steamContentDir;
            var manifest = _steamManifest;
            var appId = Cfg.Current.SteamAppId;
            var label = await Task.Run(() => Depot.ImportLocalPackage(dir, appId, "413151", manifest));

            RefreshLibrary();
            _steamOpen = false;
            await InvokeAsync(StateHasChanged);
            _ = JS.InvokeVoidAsync("junigridJs.toast",
                LocService.Tf("已把 {0} 收进版本缓存，点版本号即可切换", label), "ok");
        }
        catch (Exception ex)
        {
            _steamError = ex.Message;
            _steamStatus = ex is DepotDownloaderService.DepotException
                ? ex.Message : LocService.Tr("导入失败：") + ex.Message;
        }
        finally
        {
            _steamImporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseSteamPanel()
    {
        StopSteamWatch();
        _steamOpen = false;
        _steamError = null;
        StateHasChanged();
    }

    /// <summary>剪贴板会被别的程序短暂占用（Clipboard.SetText 抛 COMException），重试几次。</summary>
    private static bool CopyTextToClipboard(string text)
    {
        for (var i = 0; i < 3; i++)
        {
            try
            {
                System.Windows.Clipboard.SetText(text);
                return true;
            }
            catch { Thread.Sleep(60); }
        }
        return false;
    }

    private void DoDeleteStaged()
    {
        var manifestId = _pendingDeleteId!;
        CancelDelete();
        if (!Depot.DeleteStagedPackage(manifestId))
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("删除失败（文件可能被占用）"), "err");
            return;
        }
        if (_selectedStaged?.ManifestId == manifestId) _selectedStaged = null;
        RefreshLibrary();
        StateHasChanged();
        _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("已删除本地缓存"), "ok");
    }

    private async Task Close()
    {
        // 关窗要停掉目录监听：那是个 2 秒一轮的递归枚举，弹窗都没了还留着它只是白耗 IO
        StopSteamWatch();
        _steamOpen = false;
        // v1.1.7：本地应用进行中允许关闭 —— 取消本次切换，后台历史版本下载不受影响
        if (_busy)
        {
            try { _switchCts?.Cancel(); } catch { }
            _busy = false;
            _error = LocService.Tr("已取消");
        }
        // App Store 卡片收回：先 FLIP 缩回版本卡，再卸弹窗
        try { await JS.InvokeVoidAsync("junigridJs.flipModal", "jgVerCard", false); } catch { }
        await Task.Delay(320);
        _flipInPlayed = false;
        await OnClose.InvokeAsync();
    }
}

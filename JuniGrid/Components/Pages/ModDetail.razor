    /// <summary>装完之后把这一页装出来的目录归入所选分类。
    /// 键取顶层目录 —— 与 Mods 页的登记单位一致（捆绑包记顶层，散装记自己的文件夹）；
    /// 一个都不给 = 从分类表里摘掉。整段失败只记日志，绝不因为归类没写进去就说安装失败。
    /// <para>一个 mod 只属于一个分类（2026-11-09 晚用户口径），这里写的就是单个值。
    /// 老配置里可能还留着 <c>"9,10"</c> 这种历史多值：读取侧（Mods 页 <c>CategoryOfGroup</c>）
    /// 本来就只认第一个，用户下次在这页选一次分类就会被覆盖成单值。</para></summary>
    private void ApplyInstalledCategory(string category)
    {
        if (!HasCategoryChoices) return;      // 没有分类可选：不凭空往分类表里写东西
        try
        {
            _scanCache = null;    // 刚装完，缓存必然是旧的
            var mods = ScanLocal(Cfg.Current.GamePath)
                .Where(m => m.NexusModId == ModId).ToList();
            if (mods.Count == 0) return;
            var cfg = Cfg.Current;
            foreach (var m in mods)
            {
                var i = m.Folder.IndexOf('/');
                var key = i > 0 ? m.Folder[..i] : m.Folder;
                if (category.Length == 0) cfg.ModUserCategory.Remove(key);
                else cfg.ModUserCategory[key] = category;
            }
            // 逗号里的每个分类都要进名单，否则「第二个分类」在列表里没有段位、会垫到最下面
            foreach (var one in ModCategoryUtil.Split(category))
                if (!cfg.ModUserCategoryOrder.Contains(one, StringComparer.OrdinalIgnoreCase))
                    cfg.ModUserCategoryOrder.Add(one);
            Cfg.Save(cfg);
        }
        catch (Exception ex) { AppLog.Warn("ModDetail", $"[分类] 安装后归类失败：{ex.Message}"); }
    }

    /// <summary>弹窗里的「下载并安装」：指定 fileId 走完整安装管线。
    /// <para>v1.3.21：点下去<b>立刻</b>收弹窗。InstallModDirectAsync 是等「下载 + 解压 + 装完」
    /// 整段返回的，90 MB 的包要挂好几分钟 —— 弹窗一直开着挡在页面上，按钮停在「处理中…」，
    /// 用户看到的就是「点了下载，弹窗再也不消失」。真正的进度本来就在任务中心，
    /// 这里只留一条 toast 把人指过去；成功/失败再发一条。</para></summary>
    private async Task InstallPicked()
    {
        if (_pickedFileId <= 0) return;
        var f = _files?.FirstOrDefault(x => x.FileId == _pickedFileId);
        if (f is null) return;
        if (_pickBusy)
        {
            // 上次那一击已经在跑了。再点一下不该多排一条任务（StartOrRestart 对
            // running 的行只会新开一行），所以拦在这里并指路。
            _ = Toast(LocService.Tr("这个 mod 正在下载，进度在任务中心"));
            return;
        }

        _pickBusy = true;
        _installMsg = null;
        if (_pickVddOpen) await ClosePickVdd();
        if (_pickCatOpen) await ClosePickCat();
        _pickOpen = false;
        StateHasChanged();
        _ = Toast(LocService.Tr("已加入任务中心，下载在后台继续"));

        try
        {
            var err = await Installer.InstallModDirectAsync(ModId, f.FileId, f.Name);
            if (err is null)
            {
                _scanCache = null;
                _installedFolder ??= ModSvc.Scan(Cfg.Current.GamePath)
                    .FirstOrDefault(m => m.NexusModId == ModId)?.Folder;
                _overlayInstalled = _installedFolder is null
                    && ModService.OverlayAppliedForMod(Cfg.Current.GamePath, Cfg.Current, ModId);
                ApplyInstalledCategory(_pickedCategory);
                await RefreshSmapiStateAsync(freshRead: true);
                _ = Toast(LocService.Tf("{0} 安装完成", f.Name), "ok");
            }
            else if (err is "已取消" or "已暂停")
            {
                // 用户自己取消/暂停的：不再报错，任务中心那一行已经有状态
            }
            else if (err == InstallService.AlreadyRunning)
            {
                // v1.3.44：已经在装同一个 mod 了 —— 提示一下就行，别报「安装失败」
                _ = Toast(LocService.Tr("这个 mod 已经在安装中，进度见任务管理"), "ok");
            }
            else if (err.Contains("premium", StringComparison.OrdinalIgnoreCase))
            {
                // 服务已经替他开过系统浏览器（PremiumNeedsWebFallback / v1.3.85 的
                // BuiltinWebOffFallback）—— 这是交接，不是失败，别用红色 toast 把人劝退。
                _ = Toast(LocService.Tr("应用内没能自动取到下载链接 —— 已为你打开系统浏览器，点 Mod Manager Download 即可自动安装"), "ok");
            }
            else
            {
                _ = Toast(LocService.Tr("安装失败：") + err, "err");
            }
        }
        catch (Exception ex)
        {
            _ = Toast(LocService.Tr("失败：") + ex.Message, "err");
        }
        finally
        {
            _pickBusy = false;
            StateHasChanged();
        }
    }


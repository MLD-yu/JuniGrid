    // ══════════════════════════════════════════════════════════════════
    // v1.3.5：04 Files —— 文件列表（挑文件装 / 只下载）
    // ══════════════════════════════════════════════════════════════════
    /// <summary>一组文件（按 N 网类别分）。Label 已本地化。</summary>
    private sealed record FileGroup(string Label, List<NexusFileInfo> Items);

    /// <summary>旧版本/杂项默认收起 —— 有的 mod 挂着几十个历史文件，全铺开会把
    /// 真正想装的 CP/AT 两条挤到看不见。</summary>
    private bool _showAllFiles;

    private void ToggleFilesAcc()
    {
        ToggleAcc(4);
        // 首次展开才拉 —— 失败也不自动重试，交给区里的「重试」按钮
        if (_openAccs.Contains(4) && _files is null && !_filesLoading) _ = LoadFilesAsync();
    }

    private async Task LoadFilesAsync()
    {
        if (_filesLoading) return;
        _filesLoading = true;
        _filesFailed = false;
        StateHasChanged();
        try
        {
            var list = await NexusApi.GetAllFilesAsync(ModId);
            if (list is null) { _filesFailed = true; _files = new(); }
            else _files = list;
        }
        catch
        {
            _filesFailed = true;
            _files = new();
        }
        finally
        {
            _filesLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>按类别分组，空组不显示。顺序由 <c>GetAllFilesAsync</c> 的排序决定，
    /// 这里只做「连续同类别聚在一起」，不重新排序（保住上传时间倒序）。</summary>
    private List<FileGroup> FileGroups()
    {
        var groups = new List<FileGroup>();
        if (_files is null) return groups;
        foreach (var f in _files)
        {
            if (!_showAllFiles && IsArchivedCat(f.Category)) continue;
            var label = FileCatLabel(f.Category);
            var g = groups.FirstOrDefault(x => x.Label == label);
            if (g is null) { g = new FileGroup(label, new List<NexusFileInfo>()); groups.Add(g); }
            g.Items.Add(f);
        }
        return groups;
    }

    /// <summary>旧版本 / 杂项 —— 折叠时跳过。</summary>
    private static bool IsArchivedCat(string cat) => (cat ?? "").ToUpperInvariant()
        is "OLD_VERSION" or "MISCELLANEOUS";

    /// <summary>被「显示全部」藏起来的文件数（0 = 不用显示那个开关）。</summary>
    private int HiddenFileCount => _showAllFiles || _files is null
        ? 0 : _files.Count(f => IsArchivedCat(f.Category));

    /// <summary>N 网的文件类别名 → 界面文字。CP 主包 / AT 素材包这类区别在【文件名字】里
    /// （作者自己写的），类别只有 MAIN/OPTIONAL/OLD_VERSION/MISCELLANEOUS 四种，别混为一谈。</summary>
    private static string FileCatLabel(string cat) => (cat ?? "").ToUpperInvariant() switch
    {
        "MAIN" => LocService.Tr("主文件"),
        "OPTIONAL" => LocService.Tr("可选文件"),
        "OLD_VERSION" => LocService.Tr("旧版本"),
        "MISCELLANEOUS" => LocService.Tr("其他"),
        _ => LocService.Tr("未分类"),
    };

    private static string FileDate(long unixTs) =>
        DateTimeOffset.FromUnixTimeSeconds(unixTs).ToLocalTime().ToString("yyyy-MM-dd");

    /// <summary>这一条文件本机装过没有。
    /// <para><b>第一步先看磁盘</b>：这个 mod 现在必须在本地（Mods 里扫到它，或是 overlay 覆盖式安装）。
    /// 光看记账会出一个很显眼的错 —— <c>ModFileLastDownload</c> 只增不减，用户在 Mods 里删掉
    /// 这个 mod 之后，详情页每条文件仍然挂着「已安装」（2026-11-04 用户截图就是这个）。</para>
    /// <para><b>第二步看 <c>ModInstalledFile</c></b>：一个 mod 常有 CP / AT 好几个包，先装 AT
    /// 再换 CP，流水账里两条都在，但真正生效的只有最后那条。老数据没这个键 → 回落到流水账。</para></summary>
    private bool IsInstalledFile(long fileId)
    {
        if (_installedFolder is null && !_overlayInstalled) return false;

        // v1.3.45：先看安装账本（UID → 真正装上的那条 fileId）。旧实现只看
        // ModInstalledFile，那一格缺失就退回 ModFileLastDownload（「下载过」）——
        // 同一页下 0.7.1 和 0.7.0 于是都标成「已安装」（2026-11-06 用户截图）。
        if (_thisEntry is not null)
        {
            var rec = NexusUpdateTruth.GetInstallRecord(Cfg.Current, _thisEntry);
            if (rec is not null && rec.FileId > 0) return rec.FileId == fileId;
        }
        var cur = Cfg.Current.ModInstalledFile.GetValueOrDefault(ModId.ToString());
        if (!string.IsNullOrEmpty(cur)) return cur == fileId.ToString();

        // 旧账（既没记录也没快照）才退回下载记录，而且只认【最近下载的那一条】：
        // 同一页里下过多条旧版本时，全标「已安装」就是把下载过说成装过。
        if (_files is null || _files.Count == 0) return false;
        var dates = Cfg.Current.ModFileLastDownload;
        var mine = dates.GetValueOrDefault(fileId.ToString());
        if (mine is null) return false;
        var newest = _files
            .Select(f => (Id: f.FileId.ToString(), Date: dates.GetValueOrDefault(f.FileId.ToString())))
            .Where(x => x.Date is not null)
            .OrderByDescending(x => x.Date, StringComparer.Ordinal)
            .ThenByDescending(x => x.Id, StringComparer.Ordinal)
            .ToList();
        if (newest.Count == 0) return false;
        var top = newest[0].Date;
        var topIds = newest.Where(x => string.Equals(x.Date, top, StringComparison.Ordinal)).Select(x => x.Id).ToList();
        return topIds.Count == 1 && topIds[0] == fileId.ToString();
    }

    /// <summary>单个文件（04 Files 里那一排）的「安装」。
    /// v1.3.50：存在自定义分类时先弹一张「选分类」小卡 —— 装完才建目录，分类只能在那之后写，
    /// 所以选择要在发起前问；只有一个「未分类」时直接装，不拿这一步烦人。</summary>
    private async Task InstallFile(NexusFileInfo f)
    {
        if (_fileBusyId is not null) return;
        if (!Cfg.Current.EnableOneClickInstall)
        {
            OpenPage();
            return;
        }
        // v1.3.69：不再要求「已经有自定义分类」才问 —— 没分类的人也要能看到这一步，
        // 并且能在弹窗里当场新建一个（用户 2026-11-07 明确要求「没创建分类时也要显示」）。
        if (!LooksLikeContentOverrideFile(f))
        {
            _catPickFile = f;
            // 2026-11-07：不再预选任何分类（以前会预选当前分类，甚至预选到「未分类」）。
            // 一个都不选、直接点「不分类，直接安装」就是未分类，和以前空选的语义一致。
            _pickedCat = "";
            ResetNewCategoryInput();
            _catPickOpen = true;
            StateHasChanged();
            return;
        }
        await InstallFileCore(f, "");
    }

    private async Task InstallFileCore(NexusFileInfo f, string category)
    {
        if (_fileBusyId is not null) return;
        _fileBusyId = f.FileId;
        _fileMsg = LocService.Tf("正在安装 {0}…", f.Name);
        StateHasChanged();
        try
        {
            // 指定 fileId —— 装的就是列表里这一条，不是「最新 MAIN」
            var err = await Installer.InstallModDirectAsync(ModId, f.FileId, f.Name);
            if (err is null)
            {
                _scanCache = null;   // 磁盘变了，本地扫描缓存立即失效
                _installedFolder ??= ModSvc.Scan(Cfg.Current.GamePath)
                    .FirstOrDefault(m => m.NexusModId == ModId)?.Folder;
                _overlayInstalled = _installedFolder is null
                    && ModService.OverlayAppliedForMod(Cfg.Current.GamePath, Cfg.Current, ModId);
                ApplyInstalledCategory(category);
                _fileMsg = LocService.Tf("已安装 {0}", f.Name);
                await RefreshSmapiStateAsync(freshRead: true);
            }
            else if (err == InstallService.AlreadyRunning)
                _fileMsg = LocService.Tr("这个 mod 已经在安装中，进度见任务管理");
            else if (err is "已取消" or "已暂停")
                _fileMsg = err == "已暂停" ? LocService.Tr("任务已暂停，可在任务中心继续") : null;
            else if (err.Contains("premium", StringComparison.OrdinalIgnoreCase))
                // 同上：浏览器已经开好了，这句话只是告知，不该带「安装失败：」前缀
                _fileMsg = LocService.Tr("应用内没能自动取到下载链接 —— 已为你打开系统浏览器，点 Mod Manager Download 即可自动安装");
            else
                _fileMsg = LocService.Tr("安装失败：") + err;
        }
        catch (Exception ex) { _fileMsg = LocService.Tr("失败：") + ex.Message; }
        finally
        {
            _fileBusyId = null;
            StateHasChanged();
        }
    }

    private static void OpenExt(string url) => UpdateService.OpenUrl(url);

    /// <summary>把详情富文本里写死的灰色文字颜色改成继承色，避免暗色模式下看不清。</summary>
    /// <summary>
    /// v1.1.1：描述 HTML 可读性规整（白底详情页）——
    /// ① 中性灰阶文字一律 color:inherit（≈黑）。作者用浅灰做弱化强调，白底看不清；
    ///    近白(#f7+)视为深色底块上的白字，保留。
    /// 旧版正则只认 #77~#aa 前缀灰值，#efefef/#d8d8d8 全部漏网（如 Weather Wonders 天气名）。
    /// </summary>
    private static string NormalizeGrayColors(string html)
    {
        if (string.IsNullOrEmpty(html)) return html ?? "";
        // (?<![a-z-]) 避免误伤 background-color / border-color 等属性
        return Regex.Replace(html,
            @"(?i)(?<![a-z-])(color\s*:\s*)(#[0-9a-f]{3,8}\b|rgba?\(\s*[\d.]+\s*,\s*[\d.]+\s*,\s*[\d.]+[^)]*\)|hsla?\(\s*[\d.]+\s*,\s*[\d.]+%\s*,\s*[\d.]+%[^)]*\)|[a-z]+)",
            m => NormalizeDescColor(m.Groups[1].Value, m.Groups[2].Value));
    }

    private static string NormalizeDescColor(string prefix, string value)
    {
        if (!TryParseDescColor(value, out var r, out var g, out var b))
            return prefix + value;   // 未知写法（var(--x)、罕见色名）原样保留
        int max = Math.Max(r, Math.Max(g, b)), min = Math.Min(r, Math.Min(g, b));
        if (max - min <= 16)   // 中性灰阶
        {
            double lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0;
            if (lum >= 0.97) return prefix + value;   // 近白：多半是深色底上的白字
            return prefix + "inherit";
        }
        return prefix + value;   // 彩色：保留原色
    }

    private static bool TryParseDescColor(string s, out int r, out int g, out int b)
    {
        r = g = b = 0;
        s = s.Trim();
        try
        {
            if (s.StartsWith("#"))
            {
                var hex = s[1..];
                if (hex.Length is 3 or 4) hex = string.Concat(hex.Select(c => $"{c}{c}"))[..6];
                if (hex.Length != 6 && hex.Length != 8) return false;
                r = Convert.ToInt32(hex[..2], 16);
                g = Convert.ToInt32(hex.Substring(2, 2), 16);
                b = Convert.ToInt32(hex.Substring(4, 2), 16);
                return true;
            }
            if (s.StartsWith("rgb") || s.StartsWith("hsl"))
            {
                var nums = Regex.Matches(s, @"[\d.]+");
                if (s.StartsWith("rgb"))
                {
                    if (nums.Count < 3) return false;
                    r = (int)double.Parse(nums[0].Value, CultureInfo.InvariantCulture);
                    g = (int)double.Parse(nums[1].Value, CultureInfo.InvariantCulture);
                    b = (int)double.Parse(nums[2].Value, CultureInfo.InvariantCulture);
                    return true;
                }
                if (nums.Count < 3) return false;
                double h = double.Parse(nums[0].Value, CultureInfo.InvariantCulture) % 360;
                double sat = double.Parse(nums[1].Value, CultureInfo.InvariantCulture);
                double l = double.Parse(nums[2].Value, CultureInfo.InvariantCulture);
                if (sat <= 10) { r = g = b = (int)(l * 2.55); return true; }   // 低饱和≈灰
                double c = (1 - Math.Abs(2 * l / 100 - 1)) * sat / 100;
                double x = c * (1 - Math.Abs(h / 60 % 2 - 1));
                double m2 = l / 100 - c / 2;
                // 注意：不能用 `h switch { < 60 => ... }` —— Razor 把行首的关系模式 `< 60` 当 HTML 标签解析
                double rr, gg, bb;
                if (h < 60) { rr = c; gg = x; bb = 0.0; }
                else if (h < 120) { rr = x; gg = c; bb = 0.0; }
                else if (h < 180) { rr = 0.0; gg = c; bb = x; }
                else if (h < 240) { rr = 0.0; gg = x; bb = c; }
                else if (h < 300) { rr = x; gg = 0.0; bb = c; }
                else { rr = c; gg = 0.0; bb = x; }
                r = (int)((rr + m2) * 255); g = (int)((gg + m2) * 255); b = (int)((bb + m2) * 255);
                return true;
            }
            (int, int, int)? named = s.ToLowerInvariant() switch
            {
                "gray" or "grey" => (128, 128, 128),
                "dimgray" or "dimgrey" => (105, 105, 105),
                "darkgray" or "darkgrey" => (169, 169, 169),
                "lightgray" or "lightgrey" => (211, 211, 211),
                "gainsboro" => (220, 220, 220),
                "silver" => (192, 192, 192),
                "whitesmoke" => (245, 245, 245),
                "black" => (0, 0, 0),
                "white" => (255, 255, 255),
                "red" => (255, 0, 0),
                "green" => (0, 128, 0),
                "lime" => (0, 255, 0),
                "blue" => (0, 0, 255),
                "yellow" => (255, 255, 0),
                "orange" => (255, 165, 0),
                "purple" => (128, 0, 128),
                "pink" => (255, 192, 203),
                "brown" => (165, 42, 42),
                "cyan" or "aqua" => (0, 255, 255),
                "magenta" or "fuchsia" => (255, 0, 255),
                _ => null
            };
            if (named is null) return false;
            (r, g, b) = named.Value;
            return true;
        }
        catch { return false; }
    }

    private static string FormatDownloads(long n) =>
        n >= 1_000_000 ? $"{n / 1_000_000.0:0.#}M"
        : n >= 1_000 ? $"{n / 1_000.0:0.#}K"
        : n.ToString();

    /// <summary>v1.04.0：文件大小格式化（详情页统计行「大小」；0 也显示成 0 B）。</summary>
    private static string FormatBytes(long b) => b >= 1_048_576 ? (b / 1_048_576.0).ToString("0.#") + " MB"
        : b >= 1024 ? (b / 1024.0).ToString("0.#") + " KB" : b + " B";

    // ─── 分类图标（弹窗里那几行小图）───
    private bool _iconThumbQueued;
    private bool _disposed;

    /// <summary>后台出一张图标就重画一次；合并 220ms，避免一次生成几十张时疯狂重渲染。</summary>
    private void OnIconThumbReady()
    {
        if (_disposed || _iconThumbQueued) return;
        _iconThumbQueued = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(220);
            _iconThumbQueued = false;
            if (!_disposed) StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        PackThumbService.Changed -= OnIconThumbReady;
        _catIconScrollRef?.Dispose();
        _catIconScrollRef = null;
    }
}

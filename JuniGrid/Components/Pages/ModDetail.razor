@namespace JuniGrid.Components.Pages
@page "/mod/{ModId:int}/{UniqueID?}"
@using System.Text.RegularExpressions
@using System.Globalization
@inject ConfigService Cfg
@inject NexusService NexusApi
@inject ModService ModSvc
@inject InstallService Installer
@inject GameService Game
@inject UpdateService Updater
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<div class="jg-page">
    <div class="jg-detail-topbar">
    <button class="jg-detail-back" @onclick="GoBack" data-tip='@Loc.T("返回")' aria-label='@Loc.T("返回")'>
        <svg viewBox="0 0 24 24" fill="none" stroke="#3d3d3d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
    </button>


    </div>

    @if (_loading)
    {
        <div class="jg-shimmer-hero">
            <div class="jg-shimmer-left">
                <div class="jg-shimmer jg-shimmer-title"></div>
                <div class="jg-shimmer jg-shimmer-line" style="width:70%"></div>
                <div class="jg-shimmer jg-shimmer-line" style="width:55%"></div>
                <div class="jg-shimmer jg-shimmer-btns">
                    <div class="jg-shimmer jg-shimmer-btn"></div>
                    <div class="jg-shimmer jg-shimmer-btn" style="width:110px"></div>
                </div>
                <div class="jg-shimmer jg-shimmer-line" style="width:80%;margin-top:12px"></div>
            </div>
            <div class="jg-shimmer jg-shimmer-cover"></div>
        </div>
        <div class="jg-shimmer-scrollstack">
            <div class="jg-shimmer jg-shimmer-card"></div>
            <div class="jg-shimmer jg-shimmer-card"></div>
            <div class="jg-shimmer jg-shimmer-card"></div>
        </div>
    }
    else if (_error is not null)
    {
        <div class="jg-card" style="margin-top:10px">@_error</div>
    }
    else if (_mod is not null)
    {
        @* ─── Download-4 版式：左字右图 ─── *@
        <div class="jg-dl4-hero">
            <div class="jg-dl4-left">
                <h1 class="jg-dl4-title">@_mod.Name@if (_lastDownloaded is not null)
                {
                    <span class="jg-dl4-lastdl">@Loc.F("最后一次安装时间是 {0}", _lastDownloaded)</span>
                }</h1>
                @if (!string.IsNullOrWhiteSpace(_mod.Summary))
                {
                    <p class="jg-dl4-sub">@_mod.Summary</p>
                }

                <div class="jg-dl4-actions">
                    @{
                        var alreadyInstalled = _installedFolder is not null || _smapiInstalled || _overlayInstalled;
                        // v1.3.85：关掉「内置网页下载」+ 免费账号 = 软件内根本取不到直链，
                        // 这颗按钮点下去只会开浏览器 —— 那就在标题上直说，别让人以为能软件内装。
                        var browserOnly = !Cfg.Current.EnableOneClickInstall
                            || (!Cfg.Current.EnableBuiltinWebDownload && !Cfg.Current.NexusIsPremium);
                        // v1.04.0：已装判定优先于一键安装开关 —— 无论开关与否，「Mod 列表已有该 mod」都要显示
                        var installLabel = _installing ? Loc.T("安装中…")
                            : _smapiLabel ?? (alreadyInstalled ? (HasUpdate ? Loc.T("更新")
                                // 覆盖包装完不在 Mods 列表里，说「Mod 列表已有该 mod」是假的 → 只说已安装
                                : _installedFolder is null ? Loc.T("已安装") : Loc.T("Mod 列表已有该 mod"))
                            : browserOnly ? Loc.T("在浏览器安装") : Loc.T("安装"));
                        // SMAPI 不需要例外：已装就禁用，跟其它 mod 一条规矩。换适配版是 Mod 页
                        // 那条按游戏版本选包的通道干的活，不在这里给一个点得动的口子。
                        var disableInstall = _installing || (alreadyInstalled && !HasUpdate);
                    }
                    <button class="jg-dl4-cta" @onclick="OpenVersionPicker" disabled="@disableInstall">
                        @installLabel
                        <span class="jg-dl4-cta-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px"><path d="M12 3v12"/><polyline points="7 10 12 15 17 10"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg></span>
                    </button>
                    <button class="jg-dl4-ghost" @onclick="OpenPage" data-tip='@Loc.T("在 Nexus 网站打开")'>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;vertical-align:-3px;margin-right:6px">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                            <polyline points="15 3 21 3 21 9"/>
                            <line x1="10" y1="14" x2="21" y2="3"/>
                        </svg> @Loc.T("官网打开") </button>
                </div>



                @if (_installMsg is not null)
                {
                    <div class="jg-dl4-msg">@Loc.T(_installMsg)</div>
                }

                @* ─── 版本选择弹窗：点「安装」先选文件，再下载 ───
                   上面那颗 CTA 以前直接抓「最新 MAIN」闷头开下 —— 一个 mod 常并行发布
                   CP 主包 / AT 素材包，玩家要的那条未必是最新那条；而且下错了也看不出来。
                   现在把选择权交回来：主文件单选（无 MAIN 时退化成「最新文件」一条），
                   其余全部塞进「历史版本」下拉。 ─── *@
                @if (_pickOpen)
                {
                    <div class="jg-modal-overlay" @onclick="ClosePicker">
                        <div class="jg-modal jg-pick-modal" @onclick:stopPropagation>
                            <div class="jg-pick-title">@Loc.T("选择要安装的版本")</div>
                            <div class="jg-pick-sub">@_mod.Name</div>

                            @if (_filesLoading && _files is null)
                            {
                                <div class="jg-shimmer" style="height:46px;border-radius:10px;margin:8px 0"></div>
                                <div class="jg-shimmer" style="height:46px;border-radius:10px;margin:8px 0"></div>
                            }
                            else if (_files is null || _files.Count == 0)
                            {
                                <div class="jg-pick-empty">@Loc.T("这个 mod 没有可下载的文件。")</div>
                            }
                            else
                            {
                                <div class="jg-pick-cap">@PickPrimaryLabel</div>
                                <div class="jg-pick-list jg-pick-sm">
                                    @foreach (var f in PickPrimaryFiles)
                                    {
                                        <label class="jg-pick-row @(_pickedFileId == f.FileId ? "on" : "")">
                                            <input type="radio" name="jgPickFile" checked="@(_pickedFileId == f.FileId)"
                                                   @onchange="() => _pickedFileId = f.FileId" />
                                            <span class="jg-pick-main">
                                                <span class="jg-pick-name" title="@f.Name">@f.Name</span>
                                                <span class="jg-pick-meta">@PickMeta(f)</span>
                                            </span>
                                        </label>
                                    }
                                </div>

                                @* 可选文件（OPTIONAL）：以前全被塞进「历史版本」下拉，玩家以为这个 mod
                                   只有主包 + 一堆老版本，AT 素材包/补丁压根看不见。单独一节平铺出来，
                                   和主文件共用同一个单选组 —— 一次只装一个文件，选了它主文件那条自动取消。 *@
                                @if (PickOptionalFiles.Count > 0)
                                {
                                    <div class="jg-pick-cap">@Loc.T("可选文件")</div>
                                    <div class="jg-pick-list jg-pick-sm">
                                        @foreach (var f in PickOptionalFiles)
                                        {
                                            <label class="jg-pick-row @(_pickedFileId == f.FileId ? "on" : "")">
                                                <input type="radio" name="jgPickFile" checked="@(_pickedFileId == f.FileId)"
                                                       @onchange="() => _pickedFileId = f.FileId" />
                                                <span class="jg-pick-main">
                                                    <span class="jg-pick-name" title="@f.Name">@f.Name</span>
                                                    <span class="jg-pick-meta">@PickMeta(f)</span>
                                                </span>
                                            </label>
                                        }
                                    </div>
                                }

                                @if (PickMoreFiles.Count > 0)
                                {
                                    var histPicked = PickMoreFiles.FirstOrDefault(f => f.FileId == _pickedFileId);
                                    <div class="jg-pick-cap">@PickMoreLabel</div>
                                    @* 原生 &lt;select&gt; 的下拉列表由系统绘制：圆角/字体/配色全都不受主题控制，
                                       深浅色切换时它永远是那副白底方角长相（用户反馈「这个下拉框不行」）。
                                       换成站内那套 .jg-sort-dd（mod 管理的排序、存档下拉同款）：
                                       药丸触发按钮 + 弹性展开的玻璃菜单，颜色全走 token。 *@
                                    <div class="jg-sort-dd jg-pick-vdd @(_pickVddOpen ? "open" : "")" id="jgPickVdd">
                                        <button type="button" class="jg-sort-trigger jg-pick-vdd-btn"
                                                @onclick="TogglePickVdd">
                                            <span class="jg-pick-vdd-t @(histPicked is null ? "jg-pick-vdd-ph" : "")">
                                                @(histPicked is null
                                                    ? PickMorePlaceholder
                                                    : $"{histPicked.Name} · {(string.IsNullOrWhiteSpace(histPicked.Version) ? Loc.T("无版本号") : "v" + histPicked.Version)}")
                                            </span>
                                            <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                                                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>
                                        <div class="jg-sort-menu">
                                            <div class="jg-sort-menu-in">
                                                @foreach (var hf in PickMoreFiles)
                                                {
                                                    var h = hf;
                                                    <button type="button"
                                                            class="jg-sort-item @(_pickedFileId == h.FileId ? "active" : "")"
                                                            @onclick="() => PickHistoryFile(h.FileId)">
                                                        @h.Name · @(string.IsNullOrWhiteSpace(h.Version) ? Loc.T("无版本号") : "v" + h.Version)
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    @* 菜单展开时铺一层透明遮罩：点弹窗里别处就收回。
                                       必须常驻 DOM 且 z-index 压到菜单下面（全局是 9000，会盖住菜单）。 *@
                                    <div class="jg-dd-overlay @(_pickVddOpen ? "open" : "")" data-dd="pick"
                                         @onclick="ClosePickVdd"></div>
                                }
                            }

                            @* v1.3.69：分类栏**始终显示**（以前一个自定义分类都没有时整块藏起来，
                               用户根本不知道有这功能，也没地方新建 —— 2026-11-07 反馈）。
                               v1.3.60：素材包（XNB）走「内容覆盖」通道，装完不占 Mod 列表一行，
                               分类对它没有意义，选中这类文件时改成一句说明。
                               v1.3.72：列表改成**内嵌在按钮下方**（不用绝对定位的浮层）——
                               它坐在弹窗最底一节，往下浮必然压住「取消/下载并安装」，往上浮用户又觉得别扭。
                               内嵌展开只是把弹窗撑高，超出就自己在框里滚，怎么都不挡按钮。 *@
                            @if (_files is { Count: > 0 } && !PickedIsContentOverride)
                            {
                                <div class="jg-pick-cap">@Loc.T("分类")</div>
                                @* v1.3.73：回到**浮层**（绝对定位、可以探出弹窗边界），不要再内嵌展开 ——
                                   内嵌会把弹窗撑高，用户明确说「下拉框不能超出这个弹窗吗」。
                                   这里只靠 `.open` 类控制显隐（纯 CSS），不调 dropdownToggle 那套 gsap 动画：
                                   fitPickVdd 是在动画途中量矩形的，量不到最终高度，翻不上去还容易抖。 *@
                                <div class="jg-sort-dd jg-pick-vdd @(_pickCatOpen ? "open" : "")" id="jgPickCat" data-dd="pickcat">
                                    <button type="button" class="jg-sort-trigger jg-pick-vdd-btn"
                                            @onclick="TogglePickCat"
                                            aria-expanded="@(_pickCatOpen ? "true" : "false")">
                                        <span class="jg-pick-vdd-t @(_pickedCategory.Length == 0 ? "jg-pick-vdd-ph" : "")">
                                            @(_pickedCategory.Length == 0 ? Loc.T("未分类") : _pickedCategory)
                                        </span>
                                        @* 箭头旋转交给 dropdownToggle 的 GSAP（back.out），别在这里加 .flip 类，
                                           两套 transform 会互相覆盖 *@
                                        <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                                            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                    <div class="jg-sort-menu">
                                        <div class="jg-cat-menu">
                                            <div class="jg-profile-item @(!_newCatOpen && _pickedCategory.Length == 0 ? "active" : "")">
                                                @CategoryIconBadge("")
                                                <button type="button" class="jg-profile-name"
                                                        @onclick='() => PickCategory("")'>@Loc.T("未分类")</button>
                                            </div>
                                            @foreach (var c in CategoryChoices())
                                            {
                                                var cc = c;
                                                // 这里只负责「选」，不给删除按钮 —— 分类管理在 Mods 页做，
                                                // 在下载弹窗里删分类是越界（2026-11-07 用户要求）。
                                                <div class="jg-profile-item @(!_newCatOpen && _pickedCategory == cc ? "active" : "")">
                                                    @CategoryIconBadge(cc)
                                                    <button type="button" class="jg-profile-name"
                                                            @onclick="() => PickCategory(cc)">@cc</button>
                                                </div>
                                            }
                                        </div>
                                        <div class="jg-cat-foot">
                                            @if (!_newCatOpen)
                                            {
                                                <button type="button" class="jg-profile-addcap"
                                                        data-tip='@Loc.T("新建分类")' aria-label='@Loc.T("新建分类")'
                                                        @onclick="OpenNewCategoryInput"><span class="plus">＋</span></button>
                                            }
                                            else
                                            {
                                                @* ＋ 原地变成输入框（不再在下面多长一行），右侧是同一个字数计数器 *@
                                                @* 前面那颗图标是"将用默认小鸡"的占位 —— 不然这一行比上面短一截，
                                                   看起来像漏了；建好后可在 Mods 页点它换掉。 *@
                                                <div class="jg-cat-newrow">
                                                    @CategoryIconBadge(NewCatIconKey)
                                                    <div class="jg-remark-field">
                                                        <input @ref="_newCatInput"
                                                               class="jg-remark-input @(_newCatName.Length >= 16 ? "near-limit" : "")"
                                                               maxlength="20" placeholder='@Loc.T("新分类名")'
                                                               value="@_newCatName"
                                                               @oninput="OnNewCatInput" @onkeydown="OnNewCatKeydown" />
                                                        <span class="jg-remark-count jg-cat-count-new @(_newCatName.Length >= 20 ? "full" : _newCatName.Length >= 16 ? "warn" : "")">@(20 - _newCatName.Length)</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (PickedIsContentOverride)
                            {
                                <div class="jg-pick-cap">@Loc.T("分类")</div>
                                <div class="jg-pick-note">
                                    @Loc.T("这类文件是素材/覆盖包，会直接盖到游戏 Content 里，不进入 Mod 列表 —— 分类不适用。")
                                </div>
                            }

                            <div class="jg-pick-actions">
                                <button class="jg-pick-btn" @onclick="ClosePicker">@Loc.T("取消")</button>
                                @* 下载中不 disable：disabled 的按钮连 onclick 都不触发，用户只会觉得
                                   「点了没反应」。留着可点，由 InstallPicked 里回一条 toast 指路。 *@
                                <button class="jg-pick-btn primary" @onclick="InstallPicked"
                                        disabled="@(_pickedFileId <= 0)">
                                    @(_pickBusy ? Loc.T("下载中…") : Loc.T("下载并安装"))
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @* v1.3.50：04 Files 里单条文件「安装」前先问一句装进哪个分类。
                   v1.3.69：现在就算一个自定义分类都没有也照样弹（以前靠 HasCategoryChoices 短路，
                   结果「没分类」的人压根看不到这一步，也没地方新建分类）。
                   列表用 Mods 页「加入分类」那套竖排样式：每行右侧 × 删除，底部 ＋ 现场新建。 *@
                @if (_catPickOpen && _catPickFile is not null)
                {
                    <div class="jg-modal-overlay" @onclick="CloseCatPick">
                        <div class="jg-modal jg-pick-modal" @onclick:stopPropagation>
                            <div class="jg-pick-title">@Loc.T("选择分类")</div>
                            <div class="jg-pick-sub">@_catPickFile.Name</div>
                            <div class="jg-pick-cap">@Loc.T("装好之后放进哪个分类（一个都不选就是未分类）")</div>
                            <div class="jg-pick-list jg-pick-sm jg-catpick-list">
                                <div class="jg-cat-menu">
                                    <div class="jg-profile-item @(!_newCatOpen && _pickedCat.Length == 0 ? "active" : "")">
                                        @CategoryIconBadge("")
                                        <button type="button" class="jg-profile-name" @onclick="ClearCatPick">
                                            @Loc.T("未分类")
                                        </button>
                                    </div>
                                    @foreach (var c in CategoryChoices())
                                    {
                                        var cc = c;
                                        // 同上：详情页只负责选，分类的增删都归 Mods 页管。
                                        <div class="jg-profile-item @(!_newCatOpen && string.Equals(_pickedCat, cc, StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                            @CategoryIconBadge(cc)
                                            <button type="button" class="jg-profile-name" @onclick="() => PickCatPick(cc)">@cc</button>
                                        </div>
                                    }
                                </div>
                                <div class="jg-cat-foot">
                                    @if (!_newCatOpen)
                                    {
                                        <button type="button" class="jg-profile-addcap"
                                                data-tip='@Loc.T("新建分类")' aria-label='@Loc.T("新建分类")'
                                                @onclick="OpenNewCategoryInput"><span class="plus">＋</span></button>
                                    }
                                    else
                                    {
                                        @* ＋ 原地变成输入框，右侧是同一个字数计数器（与 Mods 页「加入分类」一致） *@
                                        <div class="jg-cat-newrow">
                                            @CategoryIconBadge(NewCatIconKey)
                                            <div class="jg-remark-field">
                                                <input @ref="_newCatInput"
                                                       class="jg-remark-input @(_newCatName.Length >= 16 ? "near-limit" : "")"
                                                       maxlength="20" placeholder='@Loc.T("新分类名")'
                                                       value="@_newCatName"
                                                       @oninput="OnNewCatInput" @onkeydown="OnNewCatKeydown" />
                                                <span class="jg-remark-count jg-cat-count-new @(_newCatName.Length >= 20 ? "full" : _newCatName.Length >= 16 ? "warn" : "")">@(20 - _newCatName.Length)</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="jg-pick-actions">
                                <button class="jg-pick-btn" @onclick="CloseCatPick">@Loc.T("取消")</button>
                                <button class="jg-pick-btn primary" @onclick="ConfirmCatPick">
                                    @(_pickedCat.Length == 0 ? Loc.T("不分类，直接安装") : Loc.T("继续安装"))
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @* 2026-11-10：分类图标选择器 —— 和 Mods 页同一套（默认 / 角色 / 物品）。
                   点分类行前面那颗图标就到这里；新建行选中的图先记草稿，建完分类才落盘。 *@
                @if (_catIconPickOpen)
                {
                    var curIcon = CategoryIconSpec(_catIconPickKey);
                    <div class="jg-dlg-overlay" @onclick="CloseCatIconPicker">
                        <div class="jg-dialog jg-cat-icon-dialog" @onclick:stopPropagation>
                            <div class="jg-remark-title">@Loc.F("给「{0}」选个图标", CatIconPickLabel())</div>
                            <div class="jg-icon-tabs">
                                <button class="jg-icon-tab @(_catIconTab == "default" ? "on" : "")" @onclick='() => SwitchCatIconTab("default")'>@Loc.T("默认")</button>
                                <button class="jg-icon-tab @(_catIconTab == "portrait" ? "on" : "")" @onclick='() => SwitchCatIconTab("portrait")'>@Loc.T("角色")</button>
                                <button class="jg-icon-tab @(_catIconTab == "item" ? "on" : "")" @onclick='() => SwitchCatIconTab("item")'>@Loc.T("物品")</button>
                                @if (_catIconTab != "default")
                                {
                                    <input class="jg-remark-input jg-icon-search" placeholder='@Loc.T(_catIconTab == "item" ? "搜物品名" : "搜角色名")'
                                           value="@_catIconSearch" @oninput="OnCatIconSearch" />
                                }
                            </div>
                            <div class="jg-icon-grid">
                                @foreach (var opt in CatIconOptions())
                                {
                                    @CatIconOptionButton(opt, curIcon)
                                }
                            </div>
                            <div class="jg-dialog-actions">
                                <button class="jg-btn" @onclick="CloseCatIconPicker">@Loc.T("关闭")</button>
                            </div>
                        </div>
                    </div>
                }

            @* ─── v0.69.5：三项手风琴（多开不互关 / 平滑展开 / 超长内部滚动且标题吸顶）─── *@
            <div class="jg-about-acc">
                @{ var reqTotal = _requirements is null ? 0 : ReqTotal(); }
                <div class="jg-acc @(_openAccs.Contains(1) ? "open" : "")" id="jgAcc1">
                    <div class="jg-acc-inner">
                        <button class="jg-acc-head" @onclick="() => ToggleAcc(1)">
                            <span class="jg-acc-no">01</span><span class="jg-acc-name">Requirements@(reqTotal > 0 ? $"（{reqTotal}）" : "")</span>
                            <svg class="jg-acc-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="jg-acc-body">
                            @{ var manifestReqs = ManifestReqs(); }
                            @* ─── 本机 manifest 那一半：SMAPI 实际判的就是这份，而且它是本地数据，
                               第一帧就有，不等网络，官网拉失败也不该遮住它 ─── *@
                            @if (manifestReqs.Count > 0)
                            {
                                <div class="jg-req-sub">@Loc.T("本机 manifest 声明的前置")</div>
                                <div class="jg-req-table">
                                    <div class="jg-req-th"><span>@Loc.T("模组名称")</span><span>@Loc.T("注释")</span></div>
                                    @foreach (var r in manifestReqs)
                                    {
                                        <div class="jg-req-row">
                                            <span class="jg-req-name">
                                                @if (r.ModId > 0)
                                                {
                                                    <button class="jg-req-link" @onclick="() => GoDep(r.ModId, r.Name)">@r.Name</button>
                                                }
                                                else { @r.Name }
                                                @if (r.State is not null)
                                                {
                                                    <span class="@ReqBadgeClass(r.State)">@ReqBadgeText(r.State)</span>
                                                }
                                            </span>
                                            <span class="jg-req-notes">@(string.IsNullOrWhiteSpace(r.Notes) ? "—" : r.Notes)</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (_requirements is null)
                            {
                                <div class="jg-shimmer" style="height:16px;border-radius:5px;margin:4px 0"></div>
                                <div class="jg-shimmer" style="height:16px;border-radius:5px;margin:4px 0;width:60%"></div>
                            }
                            else if (_reqFailed)
                            {
                                <span style="opacity:.65">@Loc.T("要求数据拉取失败，")</span><button class="jg-linklike" @onclick="OpenPage">@Loc.T("点此到官网查看")</button>
                            }
                            else
                            {
                                @* 官网手填表里与 manifest 撞车的那行不再单列：同一个前置说两遍，
                                   而官网那版连版本号都没有，看着像两条要求。 *@
                                var siteReqs = _requirements
                                    .Where(r => !manifestReqs.Any(x => SameReq(x, r)))
                                    .ToList();
                                var nexusReqs = siteReqs.Where(r => !r.External).ToList();
                                var offsiteReqs = siteReqs.Where(r => r.External).ToList();
                                @if (siteReqs.Count == 0 && manifestReqs.Count == 0)
                                {
                                    @* 「该模组没有前置要求」这句以前只照着官网那张表说 —— 而那张表
                                       是作者手填的，实测 29 个 mod 里 0 个填过，说满了。 *@
                                    <span style="opacity:.6">@Loc.T(_thisEntry is null
                                        ? "官网没登记前置；本机还没装这个 mod，读不到它的 manifest。"
                                        : "官网没登记前置，它的 manifest 里也没声明依赖。")</span>
                                }
                                if (nexusReqs.Count > 0)
                                {
                                    <div class="jg-req-sub" style="@(manifestReqs.Count > 0 ? "margin-top:10px" : null)">@Loc.T("Nexus 要求")</div>
                                    <div class="jg-req-table">
                                        <div class="jg-req-th"><span>@Loc.T("模组名称")</span><span>@Loc.T("注释")</span></div>
                                        @foreach (var r in nexusReqs)
                                        {
                                            <div class="jg-req-row">
                                                <span class="jg-req-name">
                                                    @if (!string.IsNullOrEmpty(r.PictureUrl))
                                                    {
                                                        <img class="jg-req-cover" src="@r.PictureUrl" alt="" loading="lazy" />
                                                    }
                                                    @if (r.ModId > 0)
                                                    {
                                                        <button class="jg-req-link" @onclick="() => GoDep(r.ModId, r.ModName)">@r.ModName</button>
                                                    }
                                                    else { @r.ModName }
                                                    @if (!IsReqInstalled(r))
                                                    {
                                                        <span class="@(IsReqOptional(r) ? "jg-req-optional" : "jg-req-missing")">@(IsReqOptional(r) ? Loc.T("可选未装") : Loc.T("未安装"))</span>
                                                    }
                                                </span>
                                                <span class="jg-req-notes">@(string.IsNullOrWhiteSpace(r.Notes) ? "—" : r.Notes)</span>
                                            </div>
                                        }
                                    </div>
                                }
                                if (offsiteReqs.Count > 0)
                                {
                                    <div class="jg-req-sub" style="margin-top:10px">@Loc.T("场外需求")</div>
                                    <div class="jg-req-table">
                                        <div class="jg-req-th"><span>@Loc.T("模组名称")</span><span>@Loc.T("注释")</span></div>
                                        @foreach (var r in offsiteReqs)
                                        {
                                            <div class="jg-req-row">
                                                <span class="jg-req-name">
                                                    @if (!string.IsNullOrEmpty(r.Url))
                                                    {
                                                        <button class="jg-req-link" @onclick="() => OpenExt(r.Url)">@r.ModName</button>
                                                    }
                                                    else { @r.ModName }
                                                </span>
                                                <span class="jg-req-notes">@(string.IsNullOrWhiteSpace(r.Notes) ? "—" : r.Notes)</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="jg-acc @(_openAccs.Contains(2) ? "open" : "")" id="jgAcc2">
                    <div class="jg-acc-inner">
                        <button class="jg-acc-head" @onclick="() => ToggleAcc(2)">
                            <span class="jg-acc-no">02</span><span class="jg-acc-name">Translations@(_translations is { Count: > 0 } ? $"（{_translations.Count}）" : "")</span>
                            <svg class="jg-acc-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="jg-acc-body">
                            @if (_translations is null) { <span style="opacity:.65">@Loc.T("正在拉取…")</span> }
                            else if (_translations.Count == 0) { <span style="opacity:.6">@Loc.T("暂无译本。")</span> }
                            else
                            {
                                @foreach (var t in _translations)
                                {
                                    <div class="jg-acc-row" style="align-items:center;gap:10px">
                                        @if (!string.IsNullOrEmpty(t.PictureUrl))
                                        {
                                            <img class="jg-req-cover" src="@t.PictureUrl" alt="" loading="lazy" />
                                        }
                                        <button class="jg-req-link" style="flex:1;text-align:left" @onclick="() => GoDep(t.ModId, t.Name)">@t.Name</button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="jg-acc @(_openAccs.Contains(3) ? "open" : "")" id="jgAcc3">
                    <div class="jg-acc-inner">
                        <button class="jg-acc-head" @onclick="() => ToggleAcc(3)">
                            <span class="jg-acc-no">03</span><span class="jg-acc-name">Changelogs@(_changelogs is { Count: > 0 } ? Loc.F("（{0} 个版本）", _changelogs.Count) : "")</span>
                            <svg class="jg-acc-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="jg-acc-body">
                            @if (_changelogs is null) { <span style="opacity:.65">@Loc.T("正在拉取…")</span> }
                            else if (_changelogs.Count == 0) { <span style="opacity:.6">@Loc.T("暂无更新日志。")</span> }
                            else
                            {
                                @foreach (var c in _changelogs)
                                {
                                    <div class="jg-acc-row" style="flex-direction:column;align-items:flex-start;gap:2px">
                                        <b>v@(c.Version)</b>
                                        @foreach (var line in c.Lines) { <span style="opacity:.75;font-size:12.5px">· @line</span> }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                @* ─── v1.3.5：04 Files —— 这个 mod 的全部文件（CP 主包 / AT 素材包 / 旧版本 / 杂项），
                   每一条都能单独安装。顶部的「安装」按钮会先弹版本选择，这里则是「看见某条就直接装」。 ─── *@
                <div class="jg-acc @(_openAccs.Contains(4) ? "open" : "")" id="jgAcc4">
                    <div class="jg-acc-inner">
                        <button class="jg-acc-head" @onclick="ToggleFilesAcc">
                            <span class="jg-acc-no">04</span><span class="jg-acc-name">Files@(_files is { Count: > 0 } ? $" ({_files.Count})" : "")</span>
                            <svg class="jg-acc-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="jg-acc-body">
                            @if (_filesLoading)
                            {
                                <div class="jg-shimmer" style="height:16px;border-radius:5px;margin:4px 0"></div>
                                <div class="jg-shimmer" style="height:16px;border-radius:5px;margin:4px 0;width:60%"></div>
                            }
                            else if (_filesFailed)
                            {
                                <span style="opacity:.65">@Loc.T("文件列表拉取失败，")</span><button class="jg-linklike" @onclick="() => _ = LoadFilesAsync()">@Loc.T("重试")</button>
                                <span style="opacity:.45"> · </span><button class="jg-linklike" @onclick="OpenPage">@Loc.T("到官网查看")</button>
                            }
                            else if (_files is null || _files.Count == 0)
                            {
                                <span style="opacity:.6">@Loc.T("这个 mod 没有可下载的文件。")</span>
                            }
                            else
                            {
                                @foreach (var g in FileGroups())
                                {
                                    <div class="jg-file-cat">
                                        <span>@g.Label</span><span class="jg-file-cat-n">@g.Items.Count</span>
                                    </div>
                                    <div class="jg-file-table">
                                        @foreach (var f in g.Items)
                                        {
                                            <div class="jg-file-row">
                                                <div class="jg-file-main">
                                                    <span class="jg-file-name" title="@f.Name">@f.Name</span>
                                                    <span class="jg-file-meta">
                                                        @(string.IsNullOrWhiteSpace(f.Version) ? Loc.T("无版本号") : "v" + f.Version)
                                                        · @FormatBytes(f.Size)
                                                        @if (f.UploadedTs > 0) { <text> · @FileDate(f.UploadedTs)</text> }
                                                    </span>
                                                </div>
                                                <div class="jg-file-actions">
                                                    @if (ModId != InstallService.SmapiNexusId)
                                                    {
                                                        @* 装过的那条按钮直接变「已安装」并禁用 —— 状态挂在按钮上，
                                                           比在文件名后面挂一枚绿色小标更好扫。 *@
                                                        if (IsInstalledFile(f.FileId))
                                                        {
                                                            <button class="jg-mini-btn jg-file-btn-done" disabled
                                                                    data-tip='@Loc.T("这个文件已经装进 Mods 了")'>@Loc.T("已安装")</button>
                                                        }
                                                        else
                                                        {
                                                            <button class="jg-mini-btn jg-file-btn-main"
                                                                    disabled="@(_fileBusyId is not null)"
                                                                    data-tip='@Loc.T("解压装进 Mods 目录并登记，装完即可生效")'
                                                                    aria-label='@Loc.T("安装这个文件到 Mods 目录")'
                                                                    @onclick="() => InstallFile(f)">
                                                                @(_fileBusyId == f.FileId ? Loc.T("处理中…") : Loc.T("安装"))
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (HiddenFileCount > 0 || _showAllFiles)
                                {
                                    <div style="margin-top:10px">
                                        <button class="jg-file-more" @onclick="() => _showAllFiles = !_showAllFiles">
                                            @(_showAllFiles
                                                ? Loc.T("只看主文件与可选文件")
                                                : Loc.F("显示全部（另有 {0} 个旧版本/杂项）", HiddenFileCount))
                                        </button>
                                    </div>
                                }
                                @if (_fileMsg is not null)
                                {
                                    <div class="jg-dl4-msg" style="margin-top:8px">@_fileMsg</div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            </div>
            <div class="jg-dl4-right">
                @if (!string.IsNullOrEmpty(_mod.PictureUrl))
                {
                    <img class="jg-dl4-cover jg-flip-cover" src="@_mod.PictureUrl" alt="@_mod.Name" data-flip-src="@_mod.PictureUrl" />
                }
                else
                {
                    <div class="jg-dl4-cover jg-dl4-cover-fallback">
                        @(_mod.Name.Length > 0 ? _mod.Name[..1].ToUpperInvariant() : "?")
                    </div>
                }

                <div class="jg-dl4-meta jg-dl4-meta-under">
                    <span class="jg-dl4-meta-item">by
                        @* ─── v1.04.0：作者名可点击跳转个人主页 + blur 高光（深#3d3d3d/浅#ffffff）+ hover 头像预览（GSAP easeReverse）─── *@
                        <span class="jg-author-wrap" id="jgAuthorTip">
                            <button type="button" class="jg-author-name" @onclick="OpenAuthorPage" aria-label='@Loc.T("查看作者主页")'>
                                <span class="jg-author-hl"></span>
                                <span class="jg-author-name-txt">@(_mod.Author ?? "Unknown")</span>
                            </button>
                            <span class="jg-author-bubble" id="jgAuthorBubble">
                                @if (!string.IsNullOrEmpty(_authorAvatar))
                                {
                                    <img class="jg-author-ava" src="@_authorAvatar" alt="" />
                                }
                                else
                                {
                                    <span class="jg-author-ava jg-author-ava-fb">@(_mod.Author is { Length: > 0 } a ? a[..1].ToUpperInvariant() : "U")</span>
                                }
                                <span class="jg-author-bubble-txt">@Loc.T("查看 TA 的主页 →")</span>
                            </span>
                        </span>
                    </span>
                    <span class="jg-dl4-dot">·</span>
                    @* v1.06.7：优先显示最新 MAIN 文件版本 —— 作者常忘改 mod 页的声明版本字段
                       （声明 0.2.8 但最新文件已是 0.2.9），文件版本才与列表更新徽标、官网一致 *@
                    <span class="jg-dl4-meta-item">v@(_latestFile?.Version is { Length: > 0 } lv ? lv : _mod.Version)</span>
                    <span class="jg-dl4-dot">·</span>
                    <span class="jg-dl4-meta-item"><svg class="jg-meta-ico" viewBox="0 0 24 24" fill="none" stroke="#3d3d3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><polyline points="7 10 12 15 17 10"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>@FormatDownloads(_mod.Downloads)</span>
                    <span class="jg-dl4-dot">·</span>
                    <span class="jg-dl4-meta-item"><svg class="jg-meta-ico" viewBox="0 0 24 24" fill="none" stroke="#3d3d3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>@_mod.Endorsements</span>
                    @* ─── v1.04.0：mod 大小（box 图标）固定在「更新于」之前；0 B 也照样显示 ─── *@
                    <span class="jg-dl4-dot">·</span>
                    <span class="jg-dl4-meta-item"><svg class="jg-meta-ico" viewBox="0 0 24 24" fill="none" stroke="#3d3d3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="12" x2="2" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" y1="16" x2="6.01" y2="16"/><line x1="10" y1="16" x2="10.01" y2="16"/></svg>@FormatBytes(_latestFile?.Size ?? 0)</span>
                    @if (!string.IsNullOrEmpty(_mod.UpdatedAt))
                    {
                        <span class="jg-dl4-dot">·</span>
                        <span class="jg-dl4-meta-item">@Loc.F("更新于 {0}", _mod.UpdatedAt)</span>
                    }
                </div>
            </div>
        </div>

        @* ─── v0.69.8：详细介绍（独立通栏模块，在整个 hero 模块下方，图片/链接原样渲染）─── *@
        @if (!string.IsNullOrWhiteSpace(_mod.DescriptionHtml))
        {
            <div class="jg-detail-section jg-detail-full">
                <div class="jg-detail-section-title">@Loc.T("详细介绍")</div>
                <div class="jg-moddetail-desc jg-desc-with-imgs">@((MarkupString)(_descHtml ?? ""))</div>
            </div>
        }

        @* ─── Flip 放大用的 modal 容器（右上 ✕ 关闭按钮：v1.1.5 之前只能点图关闭，小封面时几乎找不到）─── *@
        <div class="jg-flip-modal" id="jgFlipModal">
            <div class="jg-flip-overlay"></div>
            <div class="jg-flip-content"></div>
            <button class="jg-flip-close" type="button" aria-label='@Loc.T("关闭")'>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                    <path d="M6 6l12 12M18 6L6 18" />
                </svg>
            </button>
        </div>
    }
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 「新分类名」输入框刚出现的那一帧把焦点送进去（点 ＋ 就该直接能打字）
        if (_focusNewCatPending && _newCatOpen)
        {
            _focusNewCatPending = false;
            try { await _newCatInput.FocusAsync(); } catch { }
        }
        if (firstRender)
        {
            // 分类图标是后台解 XNB 一张张出的：出好一张就重画一次，否则第一次显示
            // 某个角色头像图标时会一直挂着占位小方块（Mods 页早就这么做了）。
            PackThumbService.Changed += OnIconThumbReady;
            // v0.72.1：.jg-main 是 MainLayout 的共享滚动容器 —— 从列表页滚到 y 再进详情，
            // 详情页会继承 y，一打开就停在半中间。详情页永远从顶部开始；
            // 返回列表的位置由 Mods 页 OpenDetail 存的快照恢复，两条路互不影响。
            try { await JS.InvokeVoidAsync("junigridJs.setScroll", ".jg-main", 0); } catch { }
        }
        // 图标选择器的懒加载：对话框一出现就把滚动监听挂上（DOM 没渲染出来时找不到网格）
        if (_catIconPickOpen && !_catIconScrollBound)
        {
            _catIconScrollBound = true;
            try
            {
                _catIconScrollRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("junigridJs.iconGridInfinite", _catIconScrollRef);
            }
            catch (Exception ex)
            {
                _catIconScrollBound = false;
                AppLog.Warn("ModDetail", "[图标] 懒加载监听挂载失败: " + ex.Message);
            }
        }
        if (!_loading && _mod is not null)
        {
            // v1.2.5：modDetailInit / authorTipInit 按「当前 mod」只跑一次 ——
            // 组件实例会在 ModId/UniqueID 参数变化时被复用，故以 mod 键而非布尔标记守卫。
            // accMeasureScroll 是对已展开手风琴的内容高度测量（内容随异步数据加载变化），保留每次渲染执行。
            var modKey = $"{ModId}/{UniqueID}";
            if (!string.Equals(_interopsInitedFor, modKey, StringComparison.Ordinal))
            {
                _interopsInitedFor = modKey;
                try { await JS.InvokeVoidAsync("junigridJs.modDetailInit"); } catch { }
                // v1.04.0：by 作者名 blur 高光 + hover 头像预览（GSAP easeReverse）
                try { await JS.InvokeVoidAsync("junigridJs.authorTipInit", "jgAuthorTip", "jgAuthorBubble"); } catch { }
            }
            if (_pendingAnimAcc > 0)
            {
                var animId = "jgAcc" + _pendingAnimAcc;
                var animOpen = _pendingAnimOpening;
                _pendingAnimAcc = 0;
                try { await JS.InvokeVoidAsync("junigridJs.accAnimate", animId, animOpen); } catch { }
            }
            try { await JS.InvokeVoidAsync("junigridJs.accMeasureScroll"); } catch { }
        }
    }

    [Parameter] public int ModId { get; set; }
    /// <summary>同一 Nexus Mod 可能含多个子包（共享 UpdateKey），靠 UniqueID 二次定位到具体那条。</summary>
    [Parameter] public string? UniqueID { get; set; }

    private NexusModDetail? _mod;
    // v0.72.0：最新 MAIN 文件（可更新判定与一键直装 InstallModDirectAsync 同一权威源）
    private NexusFileInfo? _latestFile;
    // v1.04.0：作者头像（data URI，hover 预览气泡用；拉取失败用首字母兜底）
    private string? _authorAvatar;
    private bool _loading = true;
    /// <summary>v1.2.5：modDetailInit/authorTipInit 已绑定过的 mod 键（"ModId/UniqueID"），
    /// 防止每次渲染重复发 interop；参数变化（换 mod）时重置以重新绑定。</summary>
    private string? _interopsInitedFor;
    private string? _error;

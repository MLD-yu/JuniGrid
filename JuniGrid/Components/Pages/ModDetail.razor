    /// <summary>官网表的一行是否已被 manifest 那半段说过（同 N 网页面号，或名字对得上）。</summary>
    private static bool SameReq(ReqRow x, NexusRequirementEx r)
        => (r.ModId > 0 && x.ModId == r.ModId)
        || string.Equals(x.Name.Trim(), (r.ModName ?? "").Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>标题上的计数 = manifest 那批 + 官网表里没跟它撞车的。</summary>
    private int ReqTotal()
    {
        var man = ManifestReqs();
        return _requirements is null ? man.Count
            : man.Count + _requirements.Count(r => !man.Any(x => SameReq(x, r)));
    }


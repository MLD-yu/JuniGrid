    private bool PickedIsContentOverride =>
        _files?.FirstOrDefault(f => f.FileId == _pickedFileId) is { } f && LooksLikeContentOverrideFile(f);

    /// <summary>这个文件是不是「内容覆盖」类 —— 它会直接盖到游戏 Content 里，装完不在 Mod 列表
    /// 占一行，所以「装到哪个分类」对它没有意义（2026-11-07 用户反馈：选了分类，装完列表里
    /// 根本找不到这个 mod）。
    /// <para>判据只看文件名里的 xnb：N 网素材包几乎都这么命名（"xxx - xnb"），而 CP 版通常
    /// 叫 "xxx - CP"。宁可漏判（照旧问分类，只是白问一次），也不要把正常 mod 误判掉。</para></summary>
    private static bool LooksLikeContentOverrideFile(NexusFileInfo f)
        => f.Name.Contains("xnb", StringComparison.OrdinalIgnoreCase);

    /// <summary>主文件区：有 MAIN 就全列出来（CP/AT 这种并行发布很常见），一条都没有
    /// 就退化成「上传时间最新的那一条」—— 有些老 mod 压根没标 MAIN。</summary>
    private List<NexusFileInfo> PickPrimaryFiles
    {
        get
        {
            if (_files is null || _files.Count == 0) return new();
            var mains = _files.Where(f => string.Equals(f.Category, "MAIN", StringComparison.OrdinalIgnoreCase)).ToList();
            if (mains.Count > 0) return mains;
            var newest = _files.MaxBy(f => f.UploadedTs);
            return newest is null ? new() : new List<NexusFileInfo> { newest };
        }
    }

    private string PickPrimaryLabel => _files is { Count: > 0 }
        && _files.Any(f => string.Equals(f.Category, "MAIN", StringComparison.OrdinalIgnoreCase))
        ? LocService.Tr("主文件")
        : LocService.Tr("最新文件");

    /// <summary>可选文件 = 除主文件区之外、N 网标成 OPTIONAL 的那些（补丁 / 素材包 / 配置文件）。
    /// 原先它们和旧版本混在同一个下拉里，弹窗看上去只有「主文件 + 历史版本」两节，
    /// 玩家根本不知道这个 mod 还有别的包可选。</summary>
    private List<NexusFileInfo> PickOptionalFiles
    {
        get
        {
            if (_files is null || _files.Count == 0) return new();
            var shown = PickPrimaryFiles.Select(f => f.FileId).ToHashSet();
            return _files.Where(f => !shown.Contains(f.FileId)
                    && string.Equals(f.Category, "OPTIONAL", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    /// <summary>下拉里的「更多文件」= 主文件区 / 可选文件区都没列出的其余全部
    /// （旧版本 / 更新补丁 / 杂项）。这些要么是几十条历史包，要么是边缘文件，平铺太占地方。</summary>
    private List<NexusFileInfo> PickMoreFiles
    {
        get
        {
            if (_files is null || _files.Count == 0) return new();
            var shown = PickPrimaryFiles.Concat(PickOptionalFiles).Select(f => f.FileId).ToHashSet();
            return _files.Where(f => !shown.Contains(f.FileId)).ToList();
        }
    }

    /// <summary>下拉标题：清一色 OLD_VERSION 就叫「历史版本」，混了补丁/杂项就叫「更多文件」。</summary>
    private string PickMoreLabel => PickMoreFiles.Count > 0
        && PickMoreFiles.All(f => string.Equals(f.Category, "OLD_VERSION", StringComparison.OrdinalIgnoreCase))
            ? LocService.Tr("历史版本")
            : LocService.Tr("更多文件");

    private string PickMorePlaceholder => PickMoreFiles.Count > 0
        && PickMoreFiles.All(f => string.Equals(f.Category, "OLD_VERSION", StringComparison.OrdinalIgnoreCase))
            ? LocService.Tr("选择历史版本")
            : LocService.Tr("选择文件");

    private string PickMeta(NexusFileInfo f)
    {
        var ver = string.IsNullOrWhiteSpace(f.Version) ? LocService.Tr("无版本号") : "v" + f.Version;
        var size = FormatBytes(f.Size);
        return f.UploadedTs > 0
            ? $"{ver} · {size} · {FileDate(f.UploadedTs)}"
            : $"{ver} · {size}";
    }

    // 本地已装的 mod 全集（用于依赖匹配）
    private IReadOnlyList<ModEntry> _localMods = Array.Empty<ModEntry>();
    /// <summary>v1.1.6：规整后的描述 HTML（取数时算一次；模板直接用，渲染不再重跑正则）。</summary>
    private string? _descHtml;
    /// <summary>当前详情页这个 mod 的本地条目（null = 未安装）。读它的 Dependencies 列依赖。</summary>
    private ModEntry? _thisEntry;

    // v1.06.8：详情数据内存缓存 —— 依赖跳转 A→B→返回 A 不再重新走网络，A 秒开。
    // 静态字段跨组件实例存活；TTL 10 分钟内重复进同一详情零请求。
    // v1.1.6：条目上限 + FIFO 淘汰 —— 旧版无界（每条含完整 HTML 描述），连续浏览几十个
    // 详情页内存持续增长。
    private const int DetailCacheCap = 60;
    private static readonly Dictionary<int, (NexusModDetail Mod, NexusFileInfo? Latest, DateTime At)> _detailCache = new();
    private static readonly TimeSpan DetailCacheTtl = TimeSpan.FromMinutes(10);

    private static void RememberDetail(int modId,
        (NexusModDetail Mod, NexusFileInfo? Latest, DateTime At) hit)
    {
        _detailCache[modId] = hit;
        while (_detailCache.Count > DetailCacheCap)
        {
            var oldestKey = (int?)null;
            var oldest = DateTime.MaxValue;
            foreach (var kv in _detailCache)
                if (kv.Value.At < oldest) { oldest = kv.Value.At; oldestKey = kv.Key; }
            if (oldestKey is null) break;
            _detailCache.Remove(oldestKey.Value);
        }
    }

    /// <summary>v1.2.4：本地已装列表的 5 秒 TTL 缓存（key 含 GamePath，换游戏目录自动失效）。
    /// TTL 取得极短：过期即重扫，唯一需要主动失效的是详情页自己的一键安装（改磁盘）。</summary>
    private static readonly TimeSpan ScanCacheTtl = TimeSpan.FromSeconds(5);
    private static (string Path, DateTime At, IReadOnlyList<ModEntry> Mods)? _scanCache;

    private IReadOnlyList<ModEntry> ScanLocal(string gamePath)
    {
        var c = _scanCache;
        if (c is not null && c.Value.Path == gamePath && DateTime.UtcNow - c.Value.At < ScanCacheTtl)
            return c.Value.Mods;
        var mods = ModSvc.Scan(gamePath);
        _scanCache = (gamePath, DateTime.UtcNow, mods);
        return mods;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _mod = null;
        _descHtml = null;
        _latestFile = null;
        _lastDownloaded = null;
        _reqFailed = false;
        _openAccs.Clear();
        _requirements = null;
        _translations = null;
        _changelogs = null;
        _files = null;
        _filesLoading = false;
        _filesFailed = false;
        _showAllFiles = false;
        _fileBusyId = null;
        _fileMsg = null;
        _installMsg = null;

        if (!NexusService.IsAuthenticated)
        {
            _loading = false;
            _error = LocService.Tr("还没登录 Nexus —— 先到「Nexus」页登录，再回来看详情页。");
            return;
        }

        // 这个 mod 是不是已经装了？装了的话安装按钮变成"更新到原文件夹"
        // v1.1.6：全盘扫描移出 UI 线程 —— 进详情页不该为查一个本地条目卡住整页
        // v1.2.4：走 5 秒 TTL 静态缓存 —— 网络侧数据有 10 分钟详情缓存，磁盘侧却每次
        // 进详情都重扫全盘 manifest（被 await，挡在 shimmer 后面）。同会话反复进详情/
        // 依赖跳转结果必然一样；一键安装成功即失效，已装判定不会用旧数据。
        _localMods = await Task.Run(() => ScanLocal(Cfg.Current.GamePath));
        // 同 NexusModId 可能存在多个子包（如 [CC]/[CS]/[DLL]/[FTM] 共用 UpdateKey）。
        // 优先按路由带来的 UniqueID 精确定位；没带（旧路由/依赖跳转）才退化到按 ModId 取第一个。
        _thisEntry = !string.IsNullOrEmpty(UniqueID)
            ? _localMods.FirstOrDefault(m => m.NexusModId == ModId
                && string.Equals(m.UniqueID, UniqueID, StringComparison.OrdinalIgnoreCase))
            : _localMods.FirstOrDefault(m => m.NexusModId == ModId);
        _installedFolder = _thisEntry?.Folder;
        _overlayInstalled = _installedFolder is null
            && ModService.OverlayAppliedForMod(Cfg.Current.GamePath, Cfg.Current, ModId);

        // v1.7.39：SMAPI 这一格单独问游戏根 —— 上面的已装判据是「Mods\ 里有没有这个文件夹」，
        // 而加载器根本不住在 Mods\ 里，于是本机装着 4.5.2 按钮还说「安装」。判据用
        // Game.SmapiState（与浏览页卡片、依赖栏同一个入口），这里不再写第二套。
        await RefreshSmapiStateAsync();
        // 没装的前置要显示成"是哪个 mod"而不是裸 UID，得问官网搜索 —— 后台补，不挡首屏
        _ = ResolveMissingDepNamesAsync();

        try
        {
            // v1.06.8：缓存命中（10 分钟内看过）直接用，返回 A 秒开不转圈；未命中才走网络
            if (!_detailCache.TryGetValue(ModId, out var hit) || DateTime.UtcNow - hit.At > DetailCacheTtl)
            {
                var mod = await NexusApi.GetModDetailAsync(ModId);
                if (mod is null) { _error = LocService.Tr("拉取失败 —— 检查网络；若一直失败，去「Nexus」页重新登录一次。"); }
                else
                {
                    // v0.72.0：拉最新 MAIN 文件做可更新判定（与一键直装同源）。失败静默。
                    NexusFileInfo? latest = null;
                    try { latest = await NexusApi.GetLatestMainFileAsync(ModId, patient: true, installedFolder: _installedFolder); }
                    catch { latest = null; }
                    hit = (mod, latest, DateTime.UtcNow);
                    RememberDetail(ModId, hit);
                }
            }
            if (_error is null && hit.Mod is not null)
            {
                _mod = hit.Mod;
                _latestFile = hit.Latest;
                // v1.1.6：灰阶颜色规整只算一次 —— 旧版写在模板里，任何 StateHasChanged
                //（封面下载完成、后台任务回填）都会对整段 HTML 重跑正则
                _descHtml = NormalizeGrayColors(_mod.DescriptionHtml ?? "");
            }

            // v0.69.0：最后下载时间 = 本地记录 ∪ N 网下载历史（取较新者；端点失效则静默）
            if (_mod is not null)
            {
                if (Cfg.Current.ModLastDownload.TryGetValue(ModId.ToString(), out var localDl))
                    _lastDownloaded = localDl;
                _ = Task.Run(async () =>
                {
                    // v0.69.5：后台并行补齐 —— Requirements(GraphQL v2) + 页面附加数据 + 更新日志
                    try
                    {
                        var req = await NexusApi.GetModRequirementsWithCoversAsync(ModId);
                        if (req is null) { _reqFailed = true; _requirements = new(); }
                        else _requirements = req;
                        await InvokeAsync(StateHasChanged);
                    }
                    catch { _reqFailed = true; _requirements = new(); }
                    try
                    {
                        _translations = await NexusApi.GetModTranslationsAsync(ModId, _mod?.Name ?? "") ?? new();
                        await InvokeAsync(StateHasChanged);
                    }
                    catch { _translations = new(); }
                    try
                    {
                        _changelogs = await NexusApi.GetChangelogsAsync(ModId) ?? new();
                        await InvokeAsync(StateHasChanged);
                    }
                    catch { _changelogs = new(); }
                });
                _ = Task.Run(async () =>
                {
                    try
                    {
                        var hist = await NexusApi.GetDownloadHistoryAsync();
                        if (hist is not null && hist.TryGetValue(ModId, out var remote)
                            && (_lastDownloaded is null
                                || string.Compare(remote, _lastDownloaded, StringComparison.Ordinal) > 0))
                        {
                            _lastDownloaded = remote;
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                    catch { /* 遗留端点失败静默 */ }
                });
                // v1.04.0：作者头像 —— by 作者名 hover 预览气泡用；失败静默（首字母兜底）
                // v1.06.1：GetUploaderAvatarAsync 改走 GraphQL legacyModsByDomain ——
                // 官网 HTML 被 Cloudflare 403、旧 GraphQL modId 过滤被服务端拒绝，两条旧通道全断
                _ = Task.Run(async () =>
                {
                    try
                    {
                        var av = await NexusApi.GetUploaderAvatarAsync(ModId);
                        if (!string.IsNullOrEmpty(av))
                        {
                            _authorAvatar = await NexusApi.FetchAvatarAsync(av);
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                    catch { }
                });
            }
        }
        catch (Exception ex)
        {
            _error = LocService.Tr("拉取失败：") + ex.Message;
        }
        _loading = false;
    }

    /// <summary>
    /// 一键直装：后台请求 Nexus 一次性下载链接 → 流式下载 → 装进 Mods，
    /// 全程不出启动器。服务端拒绝直链（该 mod 强制 Premium）时，
    /// 自动打开内置浏览器兜底。设置里关掉「一键安装」时则直接走浏览器方式。
    /// </summary>
    /// <summary>本地已装且 Nexus 版本【确实高于】本地 → 可更新。
    /// v0.71.9：旧版用字符串全等判断"有更新"——v1.3.0 与 1.3.0、1.3.0 与 1.3.0.0、
    /// 尾空格/预发布后缀等写法差异都会被误判成更新（详情页有更新按钮、列表页却没有，
    /// 两边判定标准不一致的根因）。改为与列表页 IsUpdatable 相同的逐段数值语义化比较。
    /// v0.72.0：比较对象改用「可更新版本」EffectiveRemoteVersion —— 与一键直装
    /// （InstallModDirectAsync → GetLatestMainFileAsync）同一权威源。旧版比较 mod
    /// 顶层 version（作者手填字段），主文件已到 1.3.1 时顶层还写 1.3.0，就会
    /// 「判无更新、一点更新却装出 1.3.1」。</summary>
    private bool HasUpdate =>
        _thisEntry is not null && _mod is not null
        && NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, _thisEntry, EffectiveRemoteVersion, _latestFile?.FileId);

    /// <summary>v0.72.0：可更新判定的权威远端版本 = 最新 MAIN 文件的版本；
    /// 主文件没写版本号时退回 mod 顶层 version（旧逻辑的唯一来源）。</summary>
    private string EffectiveRemoteVersion =>
        !string.IsNullOrWhiteSpace(_latestFile?.Version) ? _latestFile!.Version : _mod?.Version ?? "";


    /// <summary>这个 mod 就是 SMAPI 时，刷新「游戏根实况 + 按钮该写什么」。非 SMAPI 直接返回。
    /// <paramref name="freshRead"/> 用在刚装完的场合：Windows 按路径缓存版本资源，
    /// 覆盖安装后立即重探会拿到旧版本号（v1.3.4 实测）。</summary>
    private async Task RefreshSmapiStateAsync(bool freshRead = false)
    {
        if (ModId != InstallService.SmapiNexusId) return;
        var gp = Cfg.Current.GamePath;
        var st = await Task.Run(() =>
        {
            var s = Game.SmapiState(gp, freshRead);
            return (s.Installed,
                Label: s.Installed ? UpdateService.SmapiDetailLabel(true, s.Version, Updater.GetGameVersion(gp)) : null);
        });
        _smapiInstalled = st.Installed;
        _smapiLabel = st.Label;
    }

    private async Task Install()
    {
        if (_mod is null) return;
        if (!NexusService.IsAuthenticated)
        {
            _installMsg = LocService.Tr("请先在「设置 → Nexus」里填入 API key 才能一键安装");
            return;
        }
        if (!Cfg.Current.EnableOneClickInstall)
        {
            // 一键安装开关被关了 → 降级为系统浏览器手动下载
            MainWindow.OpenNexusOverlay(
                $"https://www.nexusmods.com/stardewvalley/mods/{ModId}?tab=files");
            return;
        }
        _installing = true;
        _installMsg = LocService.Tr("正在后台下载安装…（大文件需要一点时间）");
        StateHasChanged();
        try
        {
            var err = await Installer.InstallModDirectAsync(ModId);
            if (err is null)
            {
                _installMsg = null;   // v0.69.1：安装成功不再显示提示条（用户要求删掉）
                _scanCache = null;   // v1.2.4：磁盘变了，本地扫描缓存立即失效
                _installedFolder ??= ModSvc.Scan(Cfg.Current.GamePath)
                    .FirstOrDefault(m => m.NexusModId == ModId)?.Folder;
                _overlayInstalled = _installedFolder is null
                    && ModService.OverlayAppliedForMod(Cfg.Current.GamePath, Cfg.Current, ModId);
                // SMAPI 走的是游戏根，上面那句扫 Mods 对它无效 —— 装完直接重探实况
                await RefreshSmapiStateAsync(freshRead: true);
            }
            else if (err.Contains("premium", StringComparison.OrdinalIgnoreCase))
            {
                // 打开文件页这件事已经在 InstallService 里做过了（PremiumNeedsWebFallback /
                // BuiltinWebOffFallback）—— 这里只负责说人话。
                // v1.3.85：去掉「可能未登录 Nexus 网页」这个猜测 —— 关掉「内置网页下载」时也走这条，
                // 那时跟登录毫无关系，一句猜错的解释比不说更糟。
                _installMsg = LocService.Tr("应用内没能自动取到下载链接 —— 已为你打开系统浏览器，点 Mod Manager Download 即可自动安装");
            }
            else if (err == InstallService.AlreadyRunning)
            {
                // v1.3.44：同一个 mod 已经有一行在跑（重复点击 / 登录后自动重跑先一步出发）。
                // 这不是失败：任务中心那一行就是这次的进度。
                _installMsg = LocService.Tr("这个 mod 已经在安装中，进度见任务管理");
            }
            else if (err is "已取消" or "已暂停")
            {
                // v1.1.7：用户暂停/取消任务 —— 不是安装失败，别吓人
                _installMsg = err == "已暂停" ? "任务已暂停，可在任务中心继续" : null;
            }
            else
            {
                _installMsg = LocService.Tr("安装失败：") + err;
            }
        }
        catch (Exception ex)
        {
            _installMsg = LocService.Tr("失败：") + ex.Message;
        }
        finally
        {
            _installing = false;
        }
    }

    /// <summary>顶部「安装」→ 先弹版本选择，不再闷头抓「最新 MAIN」。
    /// <para>为什么改：一个 mod 经常并行发布 CP 主包 / AT 素材包，两条都是 MAIN，
    /// 「最新」只差几秒，装错的那条用户看不出来；而旧流程一旦取链失败，用户对着
    /// 一颗按钮只能反复点，也不知道问题出在文件选择还是下载。</para></summary>
    private async Task OpenVersionPicker()
    {
        if (_mod is null || _pickOpen) return;
        if (!NexusService.IsAuthenticated)
        {
            _installMsg = LocService.Tr("请先在「设置 → Nexus」里填入 API key 才能一键安装");
            return;
        }
        if (!Cfg.Current.EnableOneClickInstall)
        {
            // 一键安装关着 → 直接给官网文件页，用户自己在浏览器点
            MainWindow.OpenNexusOverlay($"https://www.nexusmods.com/stardewvalley/mods/{ModId}?tab=files");
            return;
        }
        if (!Cfg.Current.EnableBuiltinWebDownload && !Cfg.Current.NexusIsPremium)
        {
            // v1.3.85：关掉「内置网页下载」+ 免费账号 —— 软件内本来就下不了（API 直链必然 403，
            // 内置网页又被关掉）。再弹一层「选文件」只是让网络不好的人多等一次慢请求，
            // 直接给文件页：点 Mod Manager Download，nxm 回流照样把这包装进 Mods。
            _installMsg = LocService.Tr("已关闭「通过内置 N 网网页下载」—— 已在浏览器打开 N 网文件页，点 Mod Manager Download 即可自动安装");
            MainWindow.OpenNexusOverlay($"https://www.nexusmods.com/stardewvalley/mods/{ModId}?tab=files");
            return;
        }

        _pickOpen = true;
        _pickedFileId = 0;
        _pickVddOpen = false;   // 上次是带着展开的下拉关掉的，重开时别让它自己弹着
        _pickCatOpen = false;
        ResetNewCategoryInput();   // 上次点过 ＋ 就收着，别让输入框一打开就挂在那儿
        // 已经装过且在某个分类里 → 预选上，重装不会顺手把归类清掉
        _pickedCategory = CurrentCategoryOfMod();
        StateHasChanged();

        // 复用 04 Files 的懒加载（同一次请求，开过手风琴就不再发）
        if (_files is null) await LoadFilesAsync();

        var primary = PickPrimaryFiles;
        _pickedFileId = primary.Count > 0 ? primary[0].FileId
            : _files is { Count: > 0 } ? _files[0].FileId : 0;
        StateHasChanged();
    }

    private void ClosePicker()
    {
        // v1.3.18：这里以前是 `if (_pickBusy) return;` —— 下载中不许关弹窗。
        // 但关闭那一击是先被 junigrid.ui.js 的退场动画拦下的：它给遮罩挂上
        // .closing（180ms 播完 opacity 已经是 0），再把点击重派发过来。处理器
        // 一 return，遮罩就永远留在 DOM 里：看不见，却还是 position:fixed
        // 铺满整窗、照样吃指针事件 —— 表现就是「整个页面点什么都没反应」。
        // 下载本身早已在任务中心的后台管线里跑，关掉弹窗不会中断它，所以放行。
        if (_pickBusy)
        {
            _pickOpen = false;
            ResetNewCategoryInput();
            _ = JS.InvokeVoidAsync("junigridJs.toast",
                LocService.Tr("下载在后台继续，可在任务中心查看"), "ok");
            return;
        }
        if (_pickVddOpen) _ = ClosePickVdd();
        if (_pickCatOpen) _ = ClosePickCat();
        _pickOpen = false;
        ResetNewCategoryInput();
    }

    /// <summary>历史版本下拉：开合走站内 dropdownToggle（GSAP 弹性动画 + 遮罩配对）。</summary>
    private async Task TogglePickVdd()
    {
        _pickVddOpen = !_pickVddOpen;
        if (_pickVddOpen && _pickCatOpen) await ClosePickCat();   // 两个下拉不并存
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgPickVdd", _pickVddOpen); } catch { }
        // 向下展开会掉出弹窗/窗口时整块翻到触发按钮上方（同素材包弹窗那条 fitPkVar）
        if (_pickVddOpen)
        {
            try { await JS.InvokeVoidAsync("junigridJs.fitPickVdd"); } catch { }
        }
    }

    private async Task ClosePickVdd()
    {
        if (!_pickVddOpen) return;
        _pickVddOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgPickVdd", false); } catch { }
    }

    /// <summary>下拉里点某条历史/可选文件即以它为准（覆盖上方主文件单选）。
    /// 想换回主文件就点上面那排单选 —— 那个才是主文件的选择器。</summary>
    private async Task PickHistoryFile(long fileId)
    {
        if (fileId > 0) _pickedFileId = fileId;
        await ClosePickVdd();
    }

    // ─── v1.3.50：安装时的分类选择 ───
    /// <summary>「新建分类」这一行的草稿图标键 —— 和真分类名区分开（分类名不会是控制字符）。</summary>
    private const string NewCatIconKey = "\u0001new";

    /// <summary>分类那一行前面的小图标，<b>点一下就能换</b>（和 Mods 页同一个选择器）。
    /// 图标配置跟 Mods 页共用 <c>ModCategoryIcon</c>；没设过 = 默认小鸡，所以每行都有图。
    /// <para>新建行传 <see cref="NewCatIconKey"/>：选中的图先进草稿，等分类真建出来才落盘。</para></summary>
    private RenderFragment CategoryIconBadge(string category) => @<button
        type="button" class="jg-cat-icon jg-cat-icon-row" data-tip='@Loc.T("点图标换一个")'
        aria-label='@Loc.T("点图标换一个")'
        @onclick="() => OpenCatIconPicker(category)" @onclick:stopPropagation="true">
        @if (CategoryIconUrl(category) is { } u)
        {
            <img src="@u" alt="" draggable="false" loading="lazy" decoding="async" />
        }
        else
        {
            <span class="jg-cat-icon-ph"></span>
        }
    </button>;

    /// <summary>这一行当前该显示哪个图标规格（新建行读草稿，其余读配置）。</summary>
    private string CategoryIconSpec(string category)
        => category == NewCatIconKey
            ? CategoryIconService.NormalizeSpec(_newCatIcon)
            : category.Length > 0
              && Cfg.Current.ModCategoryIcon.TryGetValue(category, out var s)
              && !string.IsNullOrWhiteSpace(s)
                ? CategoryIconService.NormalizeSpec(s)
                : CategoryIconService.DefaultSpec;

    private string? CategoryIconUrl(string category)
        => CategoryIconService.Url(CategoryIconSpec(category), Cfg.Current.GamePath);

    // ─── 分类图标选择器（与 Mods 页同一套引擎，只是宿主换成了详情页）───
    private void OpenCatIconPicker(string key)
    {
        _catIconPickKey = key;
        _catIconTab = "default";
        _catIconSearch = "";
        _catIconItemLimit = 140;
        _catIconPickOpen = true;
        _catIconScrollBound = false;   // 对话框是新元素，滚动监听要重新挂
        // 600 多件物品要解析两个 xnb：先把后台热起来，切到「物品」页签时基本就绪
        ItemCatalogService.Prewarm(Cfg.Current.GamePath);
    }

    private void CloseCatIconPicker()
    {
        _catIconPickOpen = false;
        _catIconScrollBound = false;
    }

    private string CatIconPickLabel()
        => _catIconPickKey == NewCatIconKey
            ? Loc.T("新分类")
            : _catIconPickKey.Length > 0 ? _catIconPickKey : Loc.T("未分类");

    private void SwitchCatIconTab(string tab)
    {
        if (_catIconTab == tab) return;
        _catIconTab = tab;
        _catIconSearch = "";
        _catIconItemLimit = 140;
    }

    private void OnCatIconSearch(ChangeEventArgs e)
    {
        _catIconSearch = e.Value?.ToString() ?? "";
        _catIconItemLimit = 140;       // 换了搜索词就从第一批重新铺
    }

    /// <summary>物品全量清单（搜索过滤后）。</summary>
    private List<CategoryIconService.IconOption> CatIconItemSource()
    {
        var gp = Cfg.Current.GamePath;
        if (_catIconItems is null || !string.Equals(_catIconItemsFor, gp, StringComparison.OrdinalIgnoreCase))
        {
            _catIconItems = CategoryIconService.Items(gp);
            _catIconItemsFor = gp;
        }
        var q = _catIconSearch.Trim();
        if (q.Length == 0) return _catIconItems;
        return _catIconItems.Where(o => o.Name.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private int CatIconHiddenCount()
        => _catIconTab != "item" ? 0 : Math.Max(0, CatIconItemSource().Count - _catIconItemLimit);

    /// <summary>网格滚到底时由 <c>junigridJs.iconGridInfinite</c> 回调：再铺一批。</summary>
    [JSInvokable]
    public void LoadMoreIcons()
    {
        if (_disposed || !_catIconPickOpen || _catIconTab != "item") return;
        if (CatIconHiddenCount() <= 0) return;
        _catIconItemLimit += CatIconBatch;
        _ = InvokeAsync(StateHasChanged);
    }

    private IEnumerable<CategoryIconService.IconOption> CatIconOptions()
    {
        switch (_catIconTab)
        {
            case "portrait":
            {
                var gp = Cfg.Current.GamePath;
                if (_catIconPortraits is null || !string.Equals(_catIconPortraitsFor, gp, StringComparison.OrdinalIgnoreCase))
                {
                    _catIconPortraits = CategoryIconService.Portraits(gp);
                    _catIconPortraitsFor = gp;
                }
                var q = _catIconSearch.Trim();
                if (q.Length == 0) return _catIconPortraits;
                return _catIconPortraits
                    .Where(o => o.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                                || o.Spec.Contains(q, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            case "item":
                return CatIconItemSource().Take(_catIconItemLimit);
            default:
                return new[]
                {
                    new CategoryIconService.IconOption(CategoryIconService.DefaultSpec, Loc.T("星露谷小鸡"), "默认"),
                };
        }
    }

    private RenderFragment CatIconOptionButton(CategoryIconService.IconOption opt, string curSpec) => @<button
        type="button" class="jg-icon-opt @(string.Equals(opt.Spec, curSpec, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
        data-tip="@opt.Name" @onclick="() => SetCatIcon(opt.Spec)">
        <span class="jg-icon-opt-img">
            @if (CategoryIconService.Url(opt.Spec, Cfg.Current.GamePath) is { } u)
            {
                <img src="@u" alt="" loading="lazy" decoding="async" />
            }
        </span>
        <span class="jg-icon-opt-name">@opt.Name</span>
    </button>;

    /// <summary>选定即生效（点一下就走）。新建行只记草稿；已有分类直接写配置。
    /// 选回默认（小鸡）等于清掉这一项 —— 配置里不留无意义的键。</summary>
    private void SetCatIcon(string spec)
    {
        var normalized = CategoryIconService.NormalizeSpec(spec);
        if (_catIconPickKey == NewCatIconKey)
        {
            _newCatIcon = normalized;
            _catIconPickOpen = false;
            _catIconScrollBound = false;
            StateHasChanged();
            return;
        }
        var cfg = Cfg.Current;
        if (string.Equals(normalized, CategoryIconService.DefaultSpec, StringComparison.OrdinalIgnoreCase))
            cfg.ModCategoryIcon.Remove(_catIconPickKey);
        else
            cfg.ModCategoryIcon[_catIconPickKey] = normalized;
        Cfg.Save(cfg);
        _catIconPickOpen = false;
        _catIconScrollBound = false;
        StateHasChanged();
    }

    /// <summary>有没有「可选」的分类。只有默认（未分类）时这一层整个不出现 ——
    /// 一个只有「未分类」一项的下拉/弹窗，等于让用户白点一步。</summary>
    private bool HasCategoryChoices
        => Cfg.Current.ModUserCategoryOrder.Any(x => !string.IsNullOrWhiteSpace(x))
           || Cfg.Current.ModUserCategory.Values.Any(v => !string.IsNullOrWhiteSpace(v));

    /// <summary>可选分类。顺序与 Mods 页的分段/右侧导航一致：新建的在最前
    /// （ModUserCategoryOrder 是建分类时追加的，倒过来读就是最新在前）。
    /// <para>值可能是多选拼起来的 <c>"9,10"</c>，先拆再收集（否则列表里会冒出一个叫「9,10」的分类）。</para></summary>
    private List<string> CategoryChoices()
    {
        var list = Cfg.Current.ModUserCategoryOrder
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Reverse()
            .ToList();
        foreach (var c in Cfg.Current.ModUserCategory.Values
                     .SelectMany(ModCategoryUtil.Split)
                     .Where(v => v.Length > 0 && !list.Contains(v, StringComparer.OrdinalIgnoreCase))
                     .Distinct(StringComparer.OrdinalIgnoreCase)
                     .OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
            list.Add(c);
        return list;
    }

    /// <summary>展开「新建分类」输入框（两个弹窗共用）。</summary>
    private void OpenNewCategoryInput()
    {
        // 2026-11-09：进「新建」= 还没定分类 —— 小弹窗里上一次点中的行要一起取消高亮，
        // 否则看着像「既选了 111 又在新建」。下拉那处不动 _pickedCategory：
        // 它显示的是这个 mod 当前所在的分类（事实），不是待选值。
        if (_catPickOpen) _pickedCat = "";
        _newCatOpen = true;
        _newCatName = "";
        _newCatIcon = CategoryIconService.DefaultSpec;   // 每次开都从默认小鸡起（上次选的图不该跟过来）
        _focusNewCatPending = true;   // 渲染完由 OnAfterRenderAsync 送焦点
        StateHasChanged();
    }

    /// <summary>收起「新建分类」输入框 —— 换弹窗、关弹窗时都要清掉，
    /// 否则上次点过 ＋ 的状态会带进下一次弹窗（2026-11-07 用户截图：输入框一打开就在那儿）。</summary>
    private void ResetNewCategoryInput()
    {
        _newCatOpen = false;
        _newCatName = "";
        _newCatIcon = CategoryIconService.DefaultSpec;
        _focusNewCatPending = false;
    }

    private async Task OnNewCatInput(ChangeEventArgs e)
    {
        _newCatName = e.Value?.ToString() ?? "";
        // 和 Mods 页「加入分类」同一个弹簧（Motion 的 characters-remaining）：每次敲字计数器
        // back.out 弹一下，满 20 字再敲弹得更明显。只显示数字不算「有计数器」—— 2026-11-07 用户反馈。
        try { await JS.InvokeVoidAsync("junigridJs.remarkCountBump", _newCatName.Length >= 20, ".jg-cat-count-new"); } catch { }
    }

    private async Task OnNewCatKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateCategoryAndPick();
        else if (e.Key == "Escape") { _newCatOpen = false; _newCatName = ""; }
    }

    /// <summary>新建分类并直接选中它 —— 用户点「＋」就是为了「装到这个新分类里」，
    /// 让他在建完再点一次名字是多余的一步。
    /// <para>2026-11-10：以前这里直接把 <c>_pickCatOpen</c> 置 false —— 只改了 C# 状态，
    /// 没走 <c>dropdownToggle</c>，gsap 写下的 inline style（autoAlpha/transform）还在，
    /// 于是菜单看着并没关；等用户再点触发按钮，又当成「打开」重播一遍入场动画，
    /// 表现就是「关了又开」。必须走 ClosePickCat() 让 JS 把动画和 inline style 一起收掉。</para></summary>
    private async Task CreateCategoryAndPick()
    {
        var name = (_newCatName ?? "").Trim();
        if (name.Length == 0) { _newCatOpen = false; return; }
        var cfg = Cfg.Current;
        if (!cfg.ModUserCategoryOrder.Contains(name, StringComparer.OrdinalIgnoreCase))
            cfg.ModUserCategoryOrder.Add(name);
        // 新建行上选过的图跟着分类一起落盘（选的是默认小鸡就不写键，保持配置干净）
        var icon = CategoryIconService.NormalizeSpec(_newCatIcon);
        if (!string.Equals(icon, CategoryIconService.DefaultSpec, StringComparison.OrdinalIgnoreCase))
            cfg.ModCategoryIcon[name] = icon;
        Cfg.Save(cfg);
        _newCatOpen = false;
        _newCatName = "";
        _newCatIcon = CategoryIconService.DefaultSpec;
        // 两个弹窗都是单选：新建出来的分类直接选中它
        _pickedCategory = name;
        _pickedCat = name;
        await ClosePickCat();     // 内含 _pickCatOpen = false + JS 收起（含清 inline style）
        StateHasChanged();
    }

    /// <summary>这一页的 mod 现在归在哪个分类（没装过/没归类 = ""）。</summary>
    private string CurrentCategoryOfMod()
    {
        var folder = _installedFolder;
        if (folder is null) return "";
        var i = folder.IndexOf('/');
        var key = i > 0 ? folder[..i] : folder;
        return Cfg.Current.ModUserCategory.TryGetValue(key, out var c) && !string.IsNullOrWhiteSpace(c) ? c : "";
    }

    /// <summary>分类列表开合。v1.3.77：走 Mods 页同一个 <c>dropdownToggle</c> ——
    /// 箭头 back.out 转 180°、浮层 y/-scale 弹簧、每个分类项依次滑入（stagger 0.05），
    /// 这样详情页的下拉和列表页的手感一致（用户要求）。
    /// <para>⚠ 别在这里再调 <c>fitPickVdd</c>：它是在 gsap 展开动画【途中】量矩形的，
    /// 量不到最终高度，翻不上去还会把位置算歪（v1.3.71 踩过）。</para></summary>
    private async Task TogglePickCat()
    {
        _pickCatOpen = !_pickCatOpen;
        if (_pickCatOpen && _pickVddOpen) await ClosePickVdd();   // 两个下拉不并存
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgPickCat", _pickCatOpen); } catch { }
    }

    private async Task ClosePickCat()
    {
        if (!_pickCatOpen) return;
        _pickCatOpen = false;
        // 2026-11-09：选了已有分类/关下拉就把「新建分类」输入行一起收掉，
        // 否则下次拉开下拉还是那个半截输入框（和 Mods 页一样的老坑）
        ResetNewCategoryInput();
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgPickCat", false); } catch { }
    }

    private async Task PickCategory(string c)
    {
        _pickedCategory = c ?? "";
        await ClosePickCat();
        StateHasChanged();
    }

    private void CloseCatPick()
    {
        _catPickOpen = false;
        _catPickFile = null;
        ResetNewCategoryInput();
    }

    /// <summary>小弹窗里选一个分类（单选）：点新的换过去，点当前这个退回未分类。
    /// <para>2026-11-09：如果在「新建分类」输入行开着的时候点了已有分类，必须把新建行收掉，
    /// 否则输入框留在那儿，看着像还要新建一个、和已经选中的分类打架。</para></summary>
    private void PickCatPick(string c)
    {
        if (_newCatOpen)
        {
            ResetNewCategoryInput();
            _pickedCat = c;      // 新建行开着时点是「改用这个」，不做取消切换
        }
        else
        {
            _pickedCat = string.Equals(_pickedCat, c, StringComparison.OrdinalIgnoreCase) ? "" : c;
        }
    }

    /// <summary>清回未分类。</summary>
    private void ClearCatPick()
    {
        ResetNewCategoryInput();
        _pickedCat = "";
    }

    /// <summary>「选分类」小弹窗确认 → 接着装那条文件。</summary>

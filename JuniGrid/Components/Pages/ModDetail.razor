    /// <summary>Requirements 里的某项是否已安装：先按 Nexus ModId 对本地已装列表匹配，
    /// 匹配不到再按名字兜底（Nexus 名和本地 manifest Name 通常一致）。
    /// v1.1.4：SMAPI 特判 —— 它装在游戏根目录（StardewModdingAPI.exe），不在 Mods/
    /// 里，扫 Mods 永远判"未安装"；直接探测游戏目录的 SMAPI 主程序。</summary>
    private bool IsReqInstalled(NexusRequirementEx r)
    {
        if (r.ModId > 0 && _localMods.Any(m => m.NexusModId == r.ModId)) return true;
        var n = r.ModName?.Trim();
        if (string.IsNullOrEmpty(n)) return true;   // 没名字可判 → 别误报
        if (n.Equals("SMAPI", StringComparison.OrdinalIgnoreCase)
            || n.Contains("Stardew Modding API", StringComparison.OrdinalIgnoreCase))
        {
            // v1.7.39：改问 Game.SmapiState —— 顶部按钮和这里必须同一口径，
            // 否则会出现「依赖栏说装了、按钮说没装」的两套账。
            return Game.SmapiState(Cfg.Current.GamePath).Installed;
        }
        return _localMods.Any(m => string.Equals(m.Name?.Trim(), n, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>官网 Requirements 没有"是否必需"的结构化字段，只有注释栏（notes）作者会写
    /// "Required." / "Optional"（实测 Miku skin for Abigail 的 Seasonal Outfits = Optional）。
    /// 只认以 optional 开头的写法；认不出仍按必需的红标处理，宁可多提示不误吞。</summary>
    private static bool IsReqOptional(NexusRequirementEx r) =>
        (r.Notes ?? "").TrimStart().StartsWith("optional", StringComparison.OrdinalIgnoreCase);

    /// <summary>详情页「要求」的一行。State 为 null = 已就位；否则是徽标：
    /// missing = 没装，optional = 可选且没装，stale = 装了但版本低于 manifest 要求。</summary>
    private sealed record ReqRow(string Name, int ModId, string Notes, string? State);

    /// <summary>本机已装条目 manifest 里声明的前置 —— 这才是 SMAPI 决定加不加载用的那一份，
    /// 官网的 Requirements 表只是作者手填的说明。三档状态见 <see cref="ReqRow"/>。</summary>
    private List<ReqRow> ManifestReqs()
    {
        var list = new List<ReqRow>();
        if (_thisEntry is null) return list;   // 没装过 → 本机没有它的 manifest 可读
        foreach (var uid in _thisEntry.Dependencies.Concat(_thisEntry.ContentPackIds))
            AddManifestReq(list, uid, optional: false);
        foreach (var uid in _thisEntry.OptionalDependencies)
            AddManifestReq(list, uid, optional: true);
        return list;
    }

    private void AddManifestReq(List<ReqRow> list, string? uid, bool optional)
    {
        var key = uid?.Trim();
        if (string.IsNullOrEmpty(key)
            || list.Any(x => string.Equals(x.Name, key, StringComparison.OrdinalIgnoreCase))) return;
        var need = _thisEntry!.DependencyMinVersions.TryGetValue(key, out var nv) ? nv.Trim() : null;
        var badge = optional ? "optional" : "missing";

        if (_localMods.FirstOrDefault(m => string.Equals(m.UniqueID.Trim(), key, StringComparison.OrdinalIgnoreCase))
            is { } have)
        {
            var hv = (have.Version ?? "").Trim();
            list.Add(new ReqRow(string.IsNullOrWhiteSpace(have.Name) ? key : have.Name.Trim(),
                have.NexusModId ?? 0,
                need is null ? Loc.F("本机 {0}", hv.Length > 0 ? hv : "?")
                             : Loc.F("需要 ≥{0}，本机 {1}", need, hv.Length > 0 ? hv : "?"),
                need is not null && VersionUtil.IsOlderThan(hv, need) ? "stale" : null));
            return;
        }

        // 捆绑包里不单独成行的子包：磁盘上有、列表没条目，说「未安装」是假的
        var hidden = ModSvc.HiddenChildUids;
        if (hidden.Enabled.Contains(key) || hidden.Disabled.Contains(key))
        {
            var parentUid = ModService.BundledParentOf(key, _localMods.Select(m => m.UniqueID));
            var pn = parentUid is null ? null : _localMods.FirstOrDefault(
                m => string.Equals(m.UniqueID.Trim(), parentUid, StringComparison.OrdinalIgnoreCase))?.Name;
            list.Add(new ReqRow(key, 0,
                string.IsNullOrWhiteSpace(pn) ? Loc.T("随宿主包一起装") : Loc.F("随「{0}」一起装", pn!.Trim()),
                hidden.Disabled.Contains(key) ? badge : null));
            return;
        }

        // SMAPI 不住在 Mods\ 里，按 Mods 目录扫永远判「未安装」—— 与官网那半段同一口径直接探游戏根目录
        if (key.Equals("SMAPI", StringComparison.OrdinalIgnoreCase))
        {
            list.Add(new ReqRow("SMAPI", 0, need is null ? "—" : Loc.F("需要 ≥{0}", need),
                Game.SmapiState(Cfg.Current.GamePath).Installed ? null : badge));
            return;
        }

        // 没装的前置：名字和页面靠官网搜索解析（与 Mods 页一键安装同一本缓存，解析过就不再发请求）。
        // 解析不出来就退回裸 UID + 「未安装」，不假装精确。
        var shown = _depDisplay.TryGetValue(key, out var di) && !string.IsNullOrWhiteSpace(di.Name) ? di.Name!.Trim() : key;
        list.Add(new ReqRow(shown, di?.ModId ?? 0, need is null ? "—" : Loc.F("需要 ≥{0}", need), badge));
    }

    /// <summary>把「本机没装的前置」解析成名字 + N 网页面号（进程内/配置缓存命中则零请求）。
    /// 解析不出来那一行就继续显示裸 UID —— 这只影响显示，不该拖住详情页，也不该抛未观察异常。</summary>
    private async Task ResolveMissingDepNamesAsync()
    {
        try
        {
            foreach (var uid in ManifestReqs()
                         .Where(r => r.ModId == 0 && (r.State == "missing" || r.State == "optional"))
                         .Select(r => r.Name).ToList())
            {
                if (!_depTried.Add(uid)) continue;
                // 本详情页这个 mod 就是它的父包：先拿官网 Requirements 认（作者手填、带 modId），
                // 认不出来才降级到全站搜索猜。
                var res = await Installer.ResolveDependencyDisplayAsync(uid, new[] { ModId });
                if (res.Status == InstallService.DependencyResolveStatus.Found && res.Info is { } info)
                {
                    _depDisplay[uid] = info;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex) { AppLog.Warn("ModDetail", "依赖名解析失败: " + ex.Message); }
    }

    /// <summary>徽标配色：过旧与没装都是"这条会让依赖方跑不起来"，但不是一个颜色，
    /// 因为出路不同 —— 一个去装，一个去换成更新的版本。</summary>
    private static string ReqBadgeClass(string state) => state switch
    {
        "optional" => "jg-req-optional",
        "stale" => "jg-req-old",
        _ => "jg-req-missing",
    };

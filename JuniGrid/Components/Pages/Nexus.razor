    // ─── v1.01.0：搜索历史（对照官网 Recent Searches）
    // v1.05.1：显隐改由 JS toggle .history-open class（Blazor @onfocus 收不到 JS focus() 触发的事件）
    private List<string> _searchHistory = new();

    private void LoadSearchHistory()
    {
        try { _searchHistory = Cfg.Current.NexusSearchHistory ?? new(); } catch { _searchHistory = new(); }
    }

    private void SaveSearchHistory()
    {
        try { var cfg = Cfg.Current; cfg.NexusSearchHistory = _searchHistory; Cfg.Save(cfg); } catch { }
    }

    private void PushSearchHistory(string q)
    {
        if (string.IsNullOrWhiteSpace(q)) return;
        q = q.Trim();
        _searchHistory.RemoveAll(x => string.Equals(x, q, StringComparison.OrdinalIgnoreCase));
        _searchHistory.Insert(0, q);
        // v1.04.0：仅保留最新 10 条
        if (_searchHistory.Count > 10) _searchHistory = _searchHistory.Take(10).ToList();
        SaveSearchHistory();
    }

    private async Task PickHistory(string q)
    {
        _searchText = q;
        await OnIslandKeyDown(new KeyboardEventArgs { Key = "Enter" });
    }

    private void RemoveHistory(string q)
    {
        _searchHistory.RemoveAll(x => string.Equals(x, q, StringComparison.OrdinalIgnoreCase));
        SaveSearchHistory();
    }

    private void ClearAllHistory()
    {
        _searchHistory.Clear();
        SaveSearchHistory();
    }

    // 回车触发搜索：纯数字 → mod 尾号直查；否则 → 浏览页服务端搜索
    private async Task OnIslandKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        await RunSearchAsync();
    }

    /// <summary>v1.02.0：统一搜索 —— 进独立搜索页；纯数字额外并行尾号直查，结果作为「精确匹配」卡显示，
    /// 不再直接跳详情（避免 mod 名恰好是数字时与尾号冲突）。</summary>
    private async Task RunSearchAsync()
    {
        var q = _searchText.Trim();
        if (string.IsNullOrEmpty(q) || string.IsNullOrEmpty(_key)) return;
        PushSearchHistory(q);
        _searchTitle = q;   // v1.05.0：标题/提示只在回车提交后更新
        _viewMode = "search";
        _browseKind = "new";
        _page = 1;
        _timeRange = "all";
        _exactMod = null;
        _browseLoading = true;
        StateHasChanged();
        // 纯数字 → 并行尾号直查（mods/{id}.json），与名称搜索结果同时呈现
        var exactTask = q.All(char.IsDigit) ? NexusApi.GetModAsync(_key, int.Parse(q)) : null;
        try
        {
            _browse = await NexusApi.BrowseModsAsync("new", 0, _pageSize, searchText: q,
                timeRange: "all") ?? new();
        }
        catch { _browse = new(); }
        if (exactTask is not null) { try { _exactMod = await exactTask; } catch { } }
        _browseLoading = false;
        StateHasChanged();
    }


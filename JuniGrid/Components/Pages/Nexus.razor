    /// <summary>v0.90.0：筛选条件变化 → 回第 1 页重新加载。</summary>
    private async Task ReloadBrowseAsync()
    {
        _page = 1;
        await LoadCurrentPageAsync();
    }

    /// <summary>v0.90.0：加载当前页（分页数据源，offset = (页码-1) × 每页条数）。
    /// v1.04.0：带上正序/倒序方向；分类与自定义时间参数已随功能移除。</summary>
    private async Task LoadCurrentPageAsync()
    {
        if (string.IsNullOrEmpty(_key)) return;
        _browseLoading = true;
        StateHasChanged();
        try
        {
            _browse = await NexusApi.BrowseModsAsync(_browseKind, (_page - 1) * _pageSize, _pageSize,
                searchText: _searchText, timeRange: _timeRange, direction: _direction) ?? new();
        }
        catch { _browse = new(); }
        _browseLoading = false;
        StateHasChanged();
    }

    // ─── v0.90.0：分页导航 ───
    /// <summary>总页数：v0.96.0 时间过滤下移服务端后，所有时段都有精确 totalCount，尾页全程可用。</summary>
    private int? TotalPages => NexusApi.LastBrowseTotalCount is int tc && tc > 0
        ? (int)Math.Ceiling(tc / (double)_pageSize) : null;
    private bool _hasNextPage => TotalPages is int tp ? _page < tp : _browse.Count >= _pageSize;

    /// <summary>页码窗口：当前页 ±2 + 首尾，中间省略号。</summary>
    private List<(int Page, bool Dots)> PageNumbers
    {
        get
        {
            var list = new List<(int, bool)>();
            var last = TotalPages ?? (_hasNextPage ? _page + 1 : _page);
            var pages = new SortedSet<int> { 1, last };
            for (var p = _page - 2; p <= _page + 2; p++) if (p >= 1 && p <= last) pages.Add(p);
            var prev = 0;
            foreach (var p in pages)
            {
                if (prev > 0 && p - prev > 1) list.Add((0, true));
                list.Add((p, false));
                prev = p;
            }
            return list;
        }
    }

    private async Task GoToPage(int p)
    {
        if (_browseLoading || string.IsNullOrEmpty(_key)) return;
        if (TotalPages is int t) p = Math.Min(p, t);
        p = Math.Max(1, p);
        if (p == _page) return;
        _page = p;
        await LoadCurrentPageAsync();
        try { await JS.InvokeVoidAsync("junigridJs.setScroll", ".jg-main", 0); } catch { }   // 翻页回顶部
    }
    private Task PrevPage() => GoToPage(_page - 1);
    private Task NextPage() => GoToPage(_page + 1);
    private async Task JumpToPage()
    {
        if (int.TryParse(_jumpText, out var p)) await GoToPage(p);
        _jumpText = "";
    }

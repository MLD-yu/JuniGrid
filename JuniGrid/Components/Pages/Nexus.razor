    private async Task ToggleDdCore(bool current, Action<bool> set, string ddId)
    {
        var next = !current;
        CloseAllDdCore(except: next ? ddId : null);
        set(next);
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#" + ddId, next); } catch { }
    }

    private Task ToggleKindDd() => ToggleDdCore(_kindOpen, v => _kindOpen = v, "jgKindDd");
    private Task ToggleTimeDd() => ToggleDdCore(_timeOpen, v => _timeOpen = v, "jgTimeDd");
    private Task ToggleDirDd() => ToggleDdCore(_dirOpen, v => _dirOpen = v, "jgDirDd");

    private void CloseAllDdCore(string? except = null)
    {
        foreach (var (flag, id) in new[] { (_kindOpen, "jgKindDd"), (_timeOpen, "jgTimeDd"), (_dirOpen, "jgDirDd") })
        {
            if (!flag || id == except) continue;
            _ = JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#" + id, false);
        }
        if (except != "jgKindDd") _kindOpen = false;
        if (except != "jgTimeDd") _timeOpen = false;
        if (except != "jgDirDd") _dirOpen = false;
    }

    private Task CloseAllDd() { CloseAllDdCore(); return Task.CompletedTask; }


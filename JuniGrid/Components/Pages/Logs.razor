@namespace JuniGrid.Components.Pages
@page "/logs"
@using System.Text.RegularExpressions
@inject LauncherService Launcher
@inject CommandBridgeService Bridge
@inject IJSRuntime JS
@implements IDisposable

<div class="jg-page jg-page-wide">
    <div class="jg-logs-head">
        <div>
            <div class="jg-logs-title">
                <h1 style="margin-top:0;margin-bottom:8px">@Loc.T("SMAPI 日志")</h1>
                @* 开关状态 = Mods 里那个目录在不在（不带点=开、点前缀=关、没有=从没开），
                   和立绘页那个换肤开关同一套语义，所以 markup 也直接复用。 *@
                <span class="jg-squish-host jg-logs-switch @(_bridgeOn ? "on" : "")" role="switch" aria-checked="@_bridgeOn"
                      aria-label='@Loc.T("命令桥")' data-tip="@(_bridgeOn ? Loc.T("禁用 SMAPI 命令输入") : Loc.T("启用 SMAPI 命令输入"))"
                      @onclick="OnToggleBridge">
                    <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                </span>
                <span class="jg-help-tip jg-help-tip--down">
                    <span class="jg-help-tip-btn">?</span>
                    <span class="jg-help-tip-bubble">@Loc.T("命令桥 = 让本页底部的输入框能把命令直接交给 SMAPI 执行。关闭时输入框不可用；开关改动要重启游戏才生效。")</span>
                </span>
            </div>
            <div class="jg-sort-dd @(_filterOpen ? "open" : "")" id="jgLogFilter" data-dd="logfilter">
                <button type="button" class="jg-sort-trigger" @onclick="ToggleFilterMenu">
                    @FilterLabel(_filter)
                    <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <div class="jg-sort-menu">
                    @foreach (var f in Filters)
                    {
                        <button type="button" class="jg-sort-item @(_filter == f.Key ? "active" : "")"
                                @onclick="() => SelectFilter(f.Key)">@Loc.T(f.Label)</button>
                    }
                </div>
            </div>
            <div class="jg-dd-overlay @(_filterOpen ? "open" : "")" data-dd="logfilter" @onclick="CloseFilter"></div>
        </div>
        <div class="jg-logs-actions">
            <button type="button" class="jg-pill-dark" @onclick="AskClear">@Loc.T("清空")</button>
            <button type="button" class="jg-pill-dark" @onclick="CopyAll">@Loc.T("复制全部")</button>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px;padding:0">
        <div class="jg-logview">
            @if (_lines.Count == 0)
            {
                <div style="padding:20px;opacity:.5;font-size:13px"> @Loc.T("暂无日志。点左侧「▶ 启动游戏」（SMAPI 模式）后，输出会实时显示在这里。") </div>
            }
            else if (_visible.Count == 0)
            {
                <div style="padding:20px;opacity:.5;font-size:13px"> @Loc.T("当前分类没有匹配的日志。") </div>
            }
            @foreach (var line in _visible)
            {
                <div class="jg-logline @LogLineClassifier.Classify(line)">
                    @foreach (var seg in Segments(line))
                    {
                        if (seg.IsUrl)
                        {
                            <a href="@seg.Text" @onclick="() => OpenUrl(seg.Text)" @onclick:preventDefault="true">@seg.Text</a>
                        }
                        else
                        {
                            @seg.Text
                        }
                    }
                </div>
            }
        </div>
        <div class="jg-loginput">
            <div class="jg-cmdcaps">
                <input type="text" value="@_command"
                       @oninput="e => _command = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="HandleCommandKey"
                       disabled="@(!_bridgeOn)"
                       placeholder='@(_bridgeOn ? Loc.T("输入 SMAPI 命令，回车发送，如 help")
                                                : Loc.T("命令桥已关闭 · 打开页头「SMAPI 日志」旁的开关后才能输入"))' />
                <button type="button" class="jg-cmdsend" @onclick="SubmitCommand"
                        disabled="@(_sending || !_bridgeOn)">@Loc.T("发送")</button>
            </div>
            @* 命令桥的开关在页头（和立绘页换肤开关同一位置、同一套 markup）。
               桥不可用时输入框直接禁用（关闭态），或只报"为什么没发出去"（开着但游戏没跑等）。 *@
        </div>
        <div class="jg-logfooter">@Loc.F("实时输出 · 共 {0} 行", _visible.Count)</div>
    </div>

    @* ─── 清空日志确认弹窗 ─── *@
    @if (_confirmClear)
    {
        <div class="jg-modal-overlay" @onclick="() => _confirmClear = false">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">@Loc.T("清空日志")</div>
                <div class="jg-modal-body">@Loc.T("是否清空日志全部内容？")</div>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" data-modal-close @onclick="() => _confirmClear = false">@Loc.T("取消")</button>
                    <button type="button" class="jg-pill-dark" @onclick="DoClear">@Loc.T("确定")</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // 渲染源是 LauncherService 里的共享缓冲快照——页面组件随路由销毁重建，
    // 本地存的行会在离开 /logs 后"清空"，所以历史行一律从服务取。
    private IReadOnlyList<string> _lines = Array.Empty<string>();    // 服务缓冲快照（全量）
    private IReadOnlyList<string> _visible = Array.Empty<string>();  // 视图：分类筛选
    private string _filter = "all"; // all | err | upd | loaded
    private bool _pendingScroll;
    private bool _pendingScrollForce;   // 首屏带历史 → 强制落底；日常新行只在用户位于底部附近时跟随（JS 侧判定）

    private static readonly (string Key, string Label)[] Filters =
    {
        ("all", "全部"), ("err", "错误"), ("upd", "可更新"), ("loaded", "已加载")
    };
    private string FilterLabel(string key) =>
        Loc.T(Array.Find(Filters, f => f.Key == key).Label);

    protected override void OnInitialized()
    {
        _lines = Launcher.GetLogSnapshot();
        _visible = BuildVisible();
        _pendingScroll = _lines.Count > 0;
        _pendingScrollForce = true;
        Launcher.OnLogLine += HandleLog;
        _bridgeOn = Bridge.Enabled;
    }

    public void Dispose() => Launcher.OnLogLine -= HandleLog;

    // v1.1.6：日志行 250ms 防抖合并 —— SMAPI 启动期每秒几十行，旧行为每行都
    // 全量快照 + 全表重筛 + 整页重渲染（启动期 O(n²)），合并后每 250ms 最多刷一次。
    private readonly object _flushGate = new();
    private bool _flushPending;

    private void HandleLog(string line)
    {
        lock (_flushGate)
        {
            if (_flushPending) return;
            _flushPending = true;
        }
        _ = Task.Delay(250).ContinueWith(_t => InvokeAsync(FlushNow));
    }

    private void FlushNow()
    {
        lock (_flushGate) _flushPending = false;
        _lines = Launcher.GetLogSnapshot();
        _visible = BuildVisible();
        _pendingScroll = true;
        _pendingScrollForce = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingScroll)
        {
            _pendingScroll = false;
            var force = _pendingScrollForce;
            _pendingScrollForce = false;
            try { await JS.InvokeVoidAsync("junigridJs.scrollToBottom", ".jg-logview", force); } catch { }
        }
    }

    // 日志筛选下拉：与「排序方式」同款 —— Blazor 状态 + dropdownToggle 的 GSAP 动画 + 遮罩点外关闭
    private bool _filterOpen;
    private async Task ToggleFilterMenu()
    {
        _filterOpen = !_filterOpen;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgLogFilter", _filterOpen); } catch { }
    }
    private async Task CloseFilter()
    {
        if (!_filterOpen) return;
        _filterOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgLogFilter", false); } catch { }
    }

    private async Task SelectFilter(string filter)
    {
        _filter = filter;
        _visible = BuildVisible();
        _filterOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgLogFilter", false); } catch { }
    }

    // 视图 = 服务缓冲快照按分类筛选。TRACE 组已在 LauncherService 读取文件时整组丢弃
    // （SMAPI 文件日志 verbose，TRACE 占九成以上，进缓冲只会挤掉可见行），此处不再重复过滤。
    // 分类判定复用 LogLineClassifier，和行着色永远同一套规则。
    private IReadOnlyList<string> BuildVisible() =>
        _filter == "all"
            ? _lines
            : _lines.Where(l => LogLineClassifier.MatchesFilter(l, _filter)).ToList();

    // ─── 清空 / 复制：清空走确认弹窗，复制成功弹 toast ───
    private bool _confirmClear;
    private void AskClear() => _confirmClear = true;

    private void DoClear()
    {
        _confirmClear = false;
        Launcher.ClearLog();
        _lines = Array.Empty<string>();
        _visible = Array.Empty<string>();
    }

    private async Task CopyAll()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join('\n', _visible));
            await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("复制成功"));
        }
        catch
        {
            await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("复制失败"), "err");
        }
    }

    // ---- SMAPI 命令输入：桥就绪才发送，发不出去只报原因（复制兜底已删）----
    private string _command = string.Empty;
    private bool _bridgeOn;
    private bool _sending;

    private void HandleCommandKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = SubmitCommand();
    }

    private async Task SubmitCommand()
    {
        var cmd = _command.Trim();
        if (cmd.Length == 0 || _sending || !_bridgeOn) return;

        // 发不出去就只说清"为什么发不出去"，文字留在框里等他处理。
        // 这里原来还有一条"退回复制到剪贴板"的路，已删：按钮写着「发送」却偷偷复制，
        // 用户报过一次"我点回车怎么是复制"；而且 toast 会把原因和"已复制"叠成一句废话。
        var (state, detail) = Bridge.State();
        if (state != CommandBridgeService.BridgeState.Ready)
        {
            await JS.InvokeVoidAsync("junigridJs.toast", state switch
            {
                CommandBridgeService.BridgeState.Incompatible =>
                    LocService.Tr("当前 SMAPI 版本暂不支持命令桥") + (detail.Length > 0 ? " · " + detail : ""),
                CommandBridgeService.BridgeState.NoSmapi =>
                    LocService.Tr("这个游戏还没装 SMAPI"),
                CommandBridgeService.BridgeState.GameNotRunning =>
                    LocService.Tr("游戏没在跑，命令没有发出"),
                _ => LocService.Tr("命令桥未开启，命令没有发出"),
            }, "err");
            return;
        }

        _sending = true;
        _command = string.Empty;
        Launcher.AppendLogLines("[JuniGrid] > " + cmd);
        StateHasChanged();

        var r = await Bridge.SendAsync(cmd);
        _sending = false;
        if (!r.Ok) Launcher.AppendLogLines("[JuniGrid] " + (r.Error.Length > 0 ? r.Error : LocService.Tr("命令执行失败")));
        StateHasChanged();
        await JS.InvokeVoidAsync("junigridJs.toast",
            r.Ok ? LocService.Tr("已在 SMAPI 执行") : LocService.Tr("命令桥报错") + "：" + r.Error,
            r.Ok ? "ok" : "err");
    }

    private async Task OnToggleBridge()
    {
        var want = !Bridge.Enabled;
        var err = Bridge.SetEnabled(want);
        await JS.InvokeVoidAsync("junigridJs.toast",
            err ?? (want ? LocService.Tr("命令桥已开启 · 重启游戏后生效")
                         : LocService.Tr("命令桥已关闭")),
            err is null ? "ok" : "err");
        _bridgeOn = Bridge.Enabled;
        StateHasChanged();
    }

    // ---- 日志行内链接：拆出 URL 渲染成 <a>，点击用系统浏览器打开 ----
    // （Blazor WebView 里点链接会把整个应用导航走，所以 preventDefault 后走 Process.Start）
    private static readonly Regex UrlRegex = new(@"https?://\S+", RegexOptions.Compiled);

    // 日志可能上千行且每来一行就整表重渲，按行内容缓存拆分结果
    private readonly Dictionary<string, (string Text, bool IsUrl)[]> _segmentCache = new();

    private (string Text, bool IsUrl)[] Segments(string line)
    {
        if (_segmentCache.TryGetValue(line, out var cached)) return cached;

        var segs = new List<(string Text, bool IsUrl)>();
        var pos = 0;
        foreach (Match m in UrlRegex.Matches(line))
        {
            var url = TrimUrlTail(m.Value);
            if (m.Index > pos) segs.Add((line[pos..m.Index], false));
            if (url.Length > 0) segs.Add((url, true));
            if (m.Value.Length > url.Length) segs.Add((m.Value[url.Length..], false));  // 剥掉的句尾标点按普通文本渲染
            pos = m.Index + m.Length;
        }
        if (pos < line.Length) segs.Add((line[pos..], false));
        var result = segs.ToArray();

        if (_segmentCache.Count < 4000) _segmentCache[line] = result;
        return result;
    }

    private static string TrimUrlTail(string url)
    {
        // 句尾标点不属于链接；右括号只在未配平时才算句读（链接本身可能含括号）
        while (url.Length > 0)
        {
            var last = url[^1];
            if (last == ')' && url.Count(c => c == '(') < url.Count(c => c == ')')) { url = url[..^1]; continue; }
            if (last is '.' or ',' or ';' or ':' or '!' or '?' or '"' or '\'' or ']' or '}' or '。' or '，' or '）')
            { url = url[..^1]; continue; }
            break;
        }
        return url;
    }

    private void OpenUrl(string url)
    {
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(url) { UseShellExecute = true });
        }
        catch
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("无法打开链接"), "err");
        }
    }
}

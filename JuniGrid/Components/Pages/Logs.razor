@namespace JuniGrid.Components.Pages
@page "/logs"
@using System.Text.RegularExpressions
@inject LauncherService Launcher
@inject CommandBridgeService Bridge
@inject IJSRuntime JS
@implements IDisposable

<div class="jg-page jg-page-wide">
    <div class="jg-logs-head">
        <div>
            <div class="jg-logs-title">
                <h1 style="margin-top:0;margin-bottom:8px">@Loc.T("SMAPI 日志")</h1>
                @* 开关状态 = Mods 里那个目录在不在（不带点=开、点前缀=关、没有=从没开），
                   和立绘页那个换肤开关同一套语义，所以 markup 也直接复用。 *@
                <span class="jg-squish-host jg-logs-switch @(_bridgeOn ? "on" : "")" role="switch" aria-checked="@_bridgeOn"
                      aria-label='@Loc.T("命令桥")' data-tip="@(_bridgeOn ? Loc.T("禁用 SMAPI 命令输入") : Loc.T("启用 SMAPI 命令输入"))"
                      @onclick="OnToggleBridge">
                    <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                </span>
                <span class="jg-help-tip jg-help-tip--down">
                    <span class="jg-help-tip-btn">?</span>
                    <span class="jg-help-tip-bubble">@Loc.T("命令桥 = 让本页底部的输入框能把命令直接交给 SMAPI 执行。关闭时输入框不可用；开关改动要重启游戏才生效。")</span>
                </span>
            </div>
            @* 筛选框 + 问号 + 本次加载小结同处一行：这三样都是「我看到的到底是哪些行」，
               分开摆（问号在右、小结在右上角）会让人以为问号讲的是别处的东西。
               问号紧贴筛选框右侧，中间只留 4px，视觉上是一组。 *@
            <div class="jg-filterrow">
                <div class="jg-sort-dd @(_filterOpen ? "open" : "")" id="jgLogFilter" data-dd="logfilter">
                    <button type="button" class="jg-sort-trigger" @onclick="ToggleFilterMenu">
                        @FilterLabel(_filter)
                        <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <div class="jg-sort-menu">
                        @foreach (var f in Filters)
                        {
                            <button type="button" class="jg-sort-item @(_filter == f.Key ? "active" : "")"
                                    @onclick="() => SelectFilter(f.Key)">@Loc.T(f.Label)</button>
                        }
                    </div>
                </div>
                @* 本次加载小结：SMAPI 自己说了多少次加载/跳过，就是「我装的 mod 为什么没进游戏」的第一手答案。
                   没有这一段时，点前缀（禁用态）这类「SMAPI 只在 TRACE 里提一句」的跳过在页面上完全无声。 *@
                @if (_loadSum.Any || _modsPathMismatch || _crash is not null)
                {
                    <div class="jg-loadsum">
                        @if (_crash is not null)
                        {
                            <button type="button" class="jg-loadsum-item jg-loadsum-link bad"
                                    data-tip="@CrashTip()" @onclick="OpenCrashReport">
                                @Loc.F("上次崩溃 {0}", _crash.Modified.ToString("MM-dd HH:mm"))
                            </button>
                        }
                        @if (_modsPathMismatch)
                        {
                            <span class="jg-loadsum-item jg-loadsum-warn" data-tip="@ModsPathTip()">@Loc.T("Mods 目录不一致")</span>
                        }
                        @if (_loadSum.Mods is not null || _loadSum.Packs is not null)
                        {
                            <span class="jg-loadsum-item">@Loc.F("本次加载：{0} 个 mod · {1} 个内容包", _loadSum.Mods ?? 0, _loadSum.Packs ?? 0)</span>
                        }
                        @if (_loadSum.Skipped > 0)
                        {
                            <button type="button" class="jg-loadsum-item jg-loadsum-link"
                                    @onclick='() => SelectFilter("skip")'>
                                @Loc.F("跳过 {0} 个", _loadSum.Skipped)@(_loadSum.DotIgnored > 0 ? Loc.F("（点前缀 {0}）", _loadSum.DotIgnored) : "")
                            </button>
                        }
                        @if (_loadSum.Failures.Count > 0)
                        {
                            <button type="button" class="jg-loadsum-item jg-loadsum-link bad"
                                    @onclick='() => SelectFilter("err")'>
                                @Loc.F("加载失败 {0} 个", _loadSum.Failures.Count)
                            </button>
                        }
                    </div>
                }
                @* 开发者模式：SMAPI 的控制台本来就会打印 TRACE，本页跟着打印。
                   不解释一句，用户只会觉得「日志页怎么突然刷屏了」。 *@
                @if (ShowTrace)
                {
                    <div class="jg-loadsum">
                        <span class="jg-loadsum-item" data-tip="@Loc.T("SMAPI 的配置里开了开发者模式（DeveloperMode: true），它的控制台会把 TRACE 也打印出来 —— 所以本页也跟着显示：逐条「跳过了哪个文件夹」、每个 mod 的失败细节、Content Patcher 的刷屏都会出现。想回到干净的样子，把 smapi-internal/config.json 里的 DeveloperMode 改回 false，再重启游戏。")">
                            @Loc.T("含 TRACE（开发者模式）")
                        </span>
                    </div>
                }
            </div>
            <div class="jg-dd-overlay @(_filterOpen ? "open" : "")" data-dd="logfilter" @onclick="CloseFilter"></div>
        </div>
        <div class="jg-logs-actions">
            @* 这里没有「显示全部」开关，是有意的：本页的口径只有一个 —— SMAPI 控制台打印什么，
               这里就是什么。TRACE 显不显示由 SMAPI 自己的 DeveloperMode 决定（见 SmapiConsoleSettings），
               多给一个开关就等于给出第二套口径，两边迟早对不上。
               要看文件里多出来的那些行，就用「打开日志」。 *@
            <button type="button" class="jg-pill-dark"
                    data-tip="@Loc.T("用系统默认程序打开 ErrorLogs\\SMAPI-latest.txt。本页是 SMAPI 控制台的镜像，文件里比这里多的那部分（TRACE、逐条跳过证据、游戏期刷屏）只能从这里看。")"
                    @onclick="OpenLogFile">@Loc.T("打开日志")</button>
            <button type="button" class="jg-pill-dark" @onclick="AskClear">@Loc.T("清空")</button>
            <button type="button" class="jg-pill-dark" @onclick="CopyAll">@Loc.T("复制全部")</button>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px;padding:0">
        <div class="jg-logview">
            @if (_lines.Count == 0)
            {
                <div style="padding:20px;opacity:.5;font-size:13px"> @Loc.T("暂无日志。点左侧「▶ 启动游戏」（SMAPI 模式）后，输出会实时显示在这里。") </div>
            }
            else if (_visible.Count == 0)
            {
                <div style="padding:20px;opacity:.5;font-size:13px">@EmptyText()</div>
            }
            @foreach (var row in _visible)
            {
                <div class="jg-logline @row.Cls">
                    @foreach (var seg in Segments(row.Line))
                    {
                        if (seg.IsUrl)
                        {
                            <a href="@seg.Text" @onclick="() => OpenUrl(seg.Text)" @onclick:preventDefault="true">@seg.Text</a>
                        }
                        else
                        {
                            @seg.Text
                        }
                    }
                </div>
            }
        </div>
        <div class="jg-loginput">
            <div class="jg-cmdcaps">
                <input type="text" value="@_command"
                       @oninput="e => _command = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="HandleCommandKey"
                       disabled="@(!_bridgeOn)"
                       placeholder='@(_bridgeOn ? Loc.T("输入 SMAPI 命令，回车发送，如 help")
                                                : Loc.T("命令桥已关闭 · 打开页头「SMAPI 日志」旁的开关后才能输入"))' />
                <button type="button" class="jg-cmdsend" @onclick="SubmitCommand"
                        disabled="@(_sending || !_bridgeOn)">@Loc.T("发送")</button>
            </div>
            @* 命令桥的开关在页头（和立绘页换肤开关同一位置、同一套 markup）。
               桥不可用时输入框直接禁用（关闭态），或只报"为什么没发出去"（开着但游戏没跑等）。 *@
        </div>
        <div class="jg-logfooter">@FooterText()</div>
    </div>

    @* ─── 清空日志确认弹窗 ─── *@
    @if (_confirmClear)
    {
        <div class="jg-modal-overlay" @onclick="() => _confirmClear = false">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">@Loc.T("清空日志")</div>
                <div class="jg-modal-body">@Loc.T("是否清空日志全部内容？")</div>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" data-modal-close @onclick="() => _confirmClear = false">@Loc.T("取消")</button>
                    <button type="button" class="jg-pill-dark" @onclick="DoClear">@Loc.T("确定")</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // 渲染源是 LauncherService 里的共享缓冲快照——页面组件随路由销毁重建，
    // 本地存的行会在离开 /logs 后"清空"，所以历史行一律从服务取。
    private IReadOnlyList<string> _lines = Array.Empty<string>();    // 服务缓冲快照（全量）
    // 与 _lines 等长：每行的颜色。必须整页算（ClassifyAll），因为没级别头的续行
    // 要沿用上一条头的颜色 —— 单行判定会把 WARN 的多行正文后半截变白。
    private string[] _classes = Array.Empty<string>();
    private IReadOnlyList<(string Line, string Cls)> _visible = Array.Empty<(string, string)>();  // 视图：分类筛选
    private string _filter = "all"; // all | err | skip | warn | upd | loaded
    // 本页口径 = SMAPI 控制台（见 LauncherService.ConsoleShowsTrace）：只有 SMAPI 开了开发者模式、
    // 控制台自己会打印 TRACE 时，「全部」才显示 TRACE。否则一行都不显示 —— 控制台里也没有。
    private bool ShowTrace => Launcher.ConsoleShowsTrace;
    private bool _pendingScroll;
    private bool _pendingScrollForce;   // 首屏带历史 → 强制落底；日常新行只在用户位于底部附近时跟随（JS 侧判定）
    private SmapiLoadSummary _loadSum = SmapiLoadSummary.FromLines(Array.Empty<string>());

    // SMAPI 崩溃报告（ErrorLogs 里那份 Message/Stack Trace）。它不在 SMAPI-latest.txt 里，
    // 原来日志页完全看不到 —— 「游戏闪退了」时玩家最需要的就是它。
    private LauncherService.CrashReport? _crash;
    private DateTime _crashCheckedAt = DateTime.MinValue;

    private static readonly (string Key, string Label)[] Filters =
    {
        ("all", "全部"), ("err", "错误"), ("skip", "未加载"), ("warn", "警告"), ("upd", "可更新"), ("loaded", "已加载")
    };
    private string FilterLabel(string key) =>
        Loc.T(Array.Find(Filters, f => f.Key == key).Label);

    /// <summary>空态：说得清「不是日志丢了，是这一档里确实没有」。</summary>
    private string EmptyText() => Loc.T("当前分类没有匹配的日志。");

    protected override void OnInitialized()
    {
        _lines = Launcher.GetLogSnapshot();
        _classes = LogLineClassifier.ClassifyAll(_lines);
        _loadSum = SmapiLoadSummary.FromLines(_lines);
        CheckModsPath();
        RefreshCrashReport();
        _visible = BuildVisible();
        _pendingScroll = _lines.Count > 0;
        _pendingScrollForce = true;
        Launcher.OnLogLine += HandleLog;
        _bridgeOn = Bridge.Enabled;
    }

    // 崩溃报告是磁盘上的文件，不是日志行：只在进入页面和之后每 10 秒各扫一次 ——
    // 游戏在页面开着的时候崩掉，页头也能立刻冒出「上次崩溃」。
    private void RefreshCrashReport()
    {
        if (DateTime.Now - _crashCheckedAt < TimeSpan.FromSeconds(10)) return;
        _crashCheckedAt = DateTime.Now;
        _crash = LauncherService.LatestCrashReport();
    }

    private string CrashTip() =>
        Loc.F("上次游戏崩溃：{0}", _crash?.Modified.ToString("yyyy-MM-dd HH:mm") ?? "") + "\n"
        + (_crash?.Message ?? "") + "\n" + (_crash?.Path ?? "") + "\n"
        + Loc.T("这是 SMAPI 写的崩溃报告（Message / 堆栈），不在 SMAPI 日志里。点一下直接打开这个文件。");

    private string FooterText()
    {
        var text = _filter == "all"
            ? Loc.F("实时输出 · 共 {0} 行", _lines.Count)
            : Loc.F("实时输出 · 当前筛选 {0} 行 / 共 {1} 行", _visible.Count, _lines.Count);
        var dropped = Launcher.DroppedLineCount;
        if (dropped > 0)
            text += Loc.F("（另有 {0} 行已滚出视图，完整内容在 ErrorLogs\\SMAPI-latest.txt）", dropped);
        return text;
    }

    // 「SMAPI 扫的 Mods 目录」vs「设置里的游戏目录」—— 两边不一致时，用户在列表里装得再对，
    // 游戏那边也一个都看不到，而 SMAPI 不会为此报错（它只把真实路径 INFO 一句）。
    private bool _modsPathMismatch;

    private void CheckModsPath()
    {
        var used = _loadSum.ModsPath;
        var mine = Launcher.ConfiguredModsDir;
        _modsPathMismatch = !string.IsNullOrWhiteSpace(used)
                            && !string.IsNullOrWhiteSpace(mine)
                            && !string.Equals(TrimDir(used), TrimDir(mine), StringComparison.OrdinalIgnoreCase);

        static string TrimDir(string p) => p.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
    }

    private string ModsPathTip() =>
        Loc.T("游戏实际读取的 Mods 目录") + "\n  " + _loadSum.ModsPath + "\n"
        + Loc.T("设置里这个目录") + "\n  " + Launcher.ConfiguredModsDir + "\n"
        + Loc.T("两边不是同一个目录 → 列表里装好的 mod 游戏一个也读不到。请到设置页把游戏目录改成实际在用的那个。");

    public void Dispose() => Launcher.OnLogLine -= HandleLog;

    // v1.1.6：日志行 250ms 防抖合并 —— SMAPI 启动期每秒几十行，旧行为每行都
    // 全量快照 + 全表重筛 + 整页重渲染（启动期 O(n²)），合并后每 250ms 最多刷一次。
    private readonly object _flushGate = new();
    private bool _flushPending;

    private void HandleLog(string line)
    {
        lock (_flushGate)
        {
            if (_flushPending) return;
            _flushPending = true;
        }
        _ = Task.Delay(250).ContinueWith(_t => InvokeAsync(FlushNow));
    }

    private void FlushNow()
    {
        lock (_flushGate) _flushPending = false;
        _lines = Launcher.GetLogSnapshot();
        _classes = LogLineClassifier.ClassifyAll(_lines);
        _loadSum = SmapiLoadSummary.FromLines(_lines);
        CheckModsPath();
        RefreshCrashReport();
        _visible = BuildVisible();
        _pendingScroll = true;
        _pendingScrollForce = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingScroll)
        {
            _pendingScroll = false;
            var force = _pendingScrollForce;
            _pendingScrollForce = false;
            try { await JS.InvokeVoidAsync("junigridJs.scrollToBottom", ".jg-logview", force); } catch { }
        }
    }

    // 日志筛选下拉：与「排序方式」同款 —— Blazor 状态 + dropdownToggle 的 GSAP 动画 + 遮罩点外关闭
    private bool _filterOpen;
    private async Task ToggleFilterMenu()
    {
        _filterOpen = !_filterOpen;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgLogFilter", _filterOpen); } catch { }
    }
    private async Task CloseFilter()
    {
        if (!_filterOpen) return;
        _filterOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgLogFilter", false); } catch { }
    }

    private async Task SelectFilter(string filter)
    {
        _filter = filter;
        _visible = BuildVisible();
        _filterOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", "#jgLogFilter", false); } catch { }
    }

    // 视图 = 服务缓冲快照按分类筛选。
    // 「全部」= SMAPI 控制台的镜像：文件里独有的 TRACE 行不出现（控制台默认不打印它们），
    // 包括我们为查案特意留在缓冲里的跳过/加载失败证据。要查那一条：点页头「跳过 N 个」进
    // 「未加载」，或者右上「打开日志」看原文。
    // 唯一例外是 SMAPI 自己的开发者模式：那时控制台会打印 TRACE（SMAPI 源码里
    // ShowTraceInConsole = isDeveloperMode），本页就跟上，免得「控制台有、这里没有」。
    // 筛选用整页算好的颜色（_classes）而不是逐行重判：这样「错误」筛选也会带出 ERROR 块里
    // 那些没级别头的续行（堆栈、多行正文），单独看一条错误时不会只剩个开头。
    private IReadOnlyList<(string Line, string Cls)> BuildVisible()
    {
        var trace = ShowTrace;
        var rows = new List<(string Line, string Cls)>(_lines.Count);
        for (var i = 0; i < _lines.Count; i++)
        {
            var line = _lines[i];
            var cls = i < _classes.Length ? _classes[i] : LogLineClassifier.Classify(line);
            var keep = _filter switch
            {
                "all" => trace || !LogLineClassifier.IsFileOnly(line),
                "loaded" => LogLineClassifier.MatchesFilter(line, "loaded"),
                _ => cls == _filter,
            };
            if (keep) rows.Add((line, cls));
        }
        return rows;
    }

    // ─── 清空 / 复制：清空走确认弹窗，复制成功弹 toast ───
    private bool _confirmClear;
    private void AskClear() => _confirmClear = true;

    private void DoClear()
    {
        _confirmClear = false;
        Launcher.ClearLog();
        _lines = Array.Empty<string>();
        _classes = Array.Empty<string>();
        _visible = Array.Empty<(string, string)>();
        _loadSum = SmapiLoadSummary.FromLines(Array.Empty<string>());
        _modsPathMismatch = false;
    }

    private async Task CopyAll()
    {
        try
        {
            // 「复制全部」= 整个日志，不是当前筛选结果。之前复制的是 _visible，
            // 在「错误」筛选下点它会只复制那几行，用户拿去求助时恰好少了上下文。
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join('\n', _lines));
            await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("复制成功"));
        }
        catch
        {
            await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("复制失败"), "err");
        }
    }

    private void OpenCrashReport()
    {
        if (_crash is not null) Reveal(_crash.Path);
    }

    /// <summary>用系统默认程序打开 SMAPI 原始日志。本页是「控制台镜像」，文件里比这里多的那部分
    /// （TRACE、逐条跳过证据）只能从这儿看 —— 说本页没有少显示，总得给出处。
    /// 没有关联程序时退回资源管理器定位，至少把人带到文件跟前。</summary>
    private void OpenLogFile()
    {
        try
        {
            var path = LauncherService.SmapiLogPath;
            if (!File.Exists(path)) throw new FileNotFoundException(path);
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(path) { UseShellExecute = true });
        }
        catch { Reveal(LauncherService.SmapiLogPath); }
    }

    private async void Reveal(string path)    {
        try
        {
            if (!File.Exists(path))
                throw new FileNotFoundException(path);
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("explorer.exe")
            {
                Arguments = $"/select,\"{path}\"",
                UseShellExecute = true
            });
        }
        catch (Exception ex)
        {
            AppLog.Warn("Logs", "打开日志文件失败: " + ex.Message);
            await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("找不到日志文件"), "err");
        }
    }

    // ---- SMAPI 命令输入：桥就绪才发送，发不出去只报原因（复制兜底已删）----
    private string _command = string.Empty;
    private bool _bridgeOn;
    private bool _sending;

    private void HandleCommandKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = SubmitCommand();
    }

    private async Task SubmitCommand()
    {
        var cmd = _command.Trim();
        if (cmd.Length == 0 || _sending || !_bridgeOn) return;

        // 发不出去就只说清"为什么发不出去"，文字留在框里等他处理。
        // 这里原来还有一条"退回复制到剪贴板"的路，已删：按钮写着「发送」却偷偷复制，
        // 用户报过一次"我点回车怎么是复制"；而且 toast 会把原因和"已复制"叠成一句废话。
        var (state, detail) = Bridge.State();
        if (state != CommandBridgeService.BridgeState.Ready)
        {
            await JS.InvokeVoidAsync("junigridJs.toast", state switch
            {
                CommandBridgeService.BridgeState.Incompatible =>
                    LocService.Tr("当前 SMAPI 版本暂不支持命令桥") + (detail.Length > 0 ? " · " + detail : ""),
                CommandBridgeService.BridgeState.NoSmapi =>
                    LocService.Tr("这个游戏还没装 SMAPI"),
                CommandBridgeService.BridgeState.GameNotRunning =>
                    LocService.Tr("游戏没在跑，命令没有发出"),
                _ => LocService.Tr("命令桥未开启，命令没有发出"),
            }, "err");
            return;
        }

        _sending = true;
        _command = string.Empty;
        Launcher.AppendLogLines("[JuniGrid] > " + cmd);
        StateHasChanged();

        var r = await Bridge.SendAsync(cmd);
        _sending = false;
        if (!r.Ok) Launcher.AppendLogLines("[JuniGrid] " + (r.Error.Length > 0 ? r.Error : LocService.Tr("命令执行失败")));
        StateHasChanged();
        await JS.InvokeVoidAsync("junigridJs.toast",
            r.Ok ? LocService.Tr("已在 SMAPI 执行") : LocService.Tr("命令桥报错") + "：" + r.Error,
            r.Ok ? "ok" : "err");
    }

    private async Task OnToggleBridge()
    {
        var want = !Bridge.Enabled;
        var err = Bridge.SetEnabled(want);
        await JS.InvokeVoidAsync("junigridJs.toast",
            err ?? (want ? LocService.Tr("命令桥已开启 · 重启游戏后生效")
                         : LocService.Tr("命令桥已关闭")),
            err is null ? "ok" : "err");
        _bridgeOn = Bridge.Enabled;
        StateHasChanged();
    }

    // ---- 日志行内链接：拆出 URL 渲染成 <a>，点击用系统浏览器打开 ----
    // （Blazor WebView 里点链接会把整个应用导航走，所以 preventDefault 后走 Process.Start）
    private static readonly Regex UrlRegex = new(@"https?://\S+", RegexOptions.Compiled);

    // 日志可能上千行且每来一行就整表重渲，按行内容缓存拆分结果
    private readonly Dictionary<string, (string Text, bool IsUrl)[]> _segmentCache = new();

    private (string Text, bool IsUrl)[] Segments(string line)
    {
        if (_segmentCache.TryGetValue(line, out var cached)) return cached;

        var segs = new List<(string Text, bool IsUrl)>();
        var pos = 0;
        foreach (Match m in UrlRegex.Matches(line))
        {
            var url = TrimUrlTail(m.Value);
            if (m.Index > pos) segs.Add((line[pos..m.Index], false));
            if (url.Length > 0) segs.Add((url, true));
            if (m.Value.Length > url.Length) segs.Add((m.Value[url.Length..], false));  // 剥掉的句尾标点按普通文本渲染
            pos = m.Index + m.Length;
        }
        if (pos < line.Length) segs.Add((line[pos..], false));
        var result = segs.ToArray();

        if (_segmentCache.Count < 4000) _segmentCache[line] = result;
        return result;
    }

    private static string TrimUrlTail(string url)
    {
        // 句尾标点不属于链接；右括号只在未配平时才算句读（链接本身可能含括号）
        while (url.Length > 0)
        {
            var last = url[^1];
            if (last == ')' && url.Count(c => c == '(') < url.Count(c => c == ')')) { url = url[..^1]; continue; }
            if (last is '.' or ',' or ';' or ':' or '!' or '?' or '"' or '\'' or ']' or '}' or '。' or '，' or '）')
            { url = url[..^1]; continue; }
            break;
        }
        return url;
    }

    private void OpenUrl(string url)
    {
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(url) { UseShellExecute = true });
        }
        catch
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("无法打开链接"), "err");
        }
    }
}

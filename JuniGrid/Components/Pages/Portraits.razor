@namespace JuniGrid.Components.Pages
@page "/portraits"
@inject ConfigService Cfg
@inject PortraitSkinService PortraitSkin
@inject PageRefreshService PageRefresh
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<div class="jg-page jg-pt-page">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px">
        <div>
            <div style="display:flex;align-items:center;gap:14px">
                <h1 style="margin-top:0;margin-bottom:4px">立绘</h1>
            </div>
            <div style="opacity:.7;font-size:13px">
                @if (_scanning)
                {
                    <span>正在扫描已装的肖像/皮肤 mod…</span>
                }
                else if (_characters is null)
                {
                    <span>还没有设置游戏目录 —— 先到「设置」页选择</span>
                }
                else
                {
                    <text>@VisibleCharacters.Count() 个角色</text>
                }
            </div>
        </div>
        <div class="jg-pt-actions">
            <button type="button" class="jg-pill-ghost" title="全部皮肤/季节分配/锁定恢复为默认"
                    disabled="@(_scanning || _characters is null || _busy)"
                    @onclick="OnRestoreDefaults">
                <svg class="jg-pt-act-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
                一键恢复默认
            </button>
            <button type="button" class="jg-pill-dark" title="选一个肖像包，套到所有拥有它的角色（锁定中的跳过）"
                    disabled="@(_scanning || _characters is null || _busy)"
                    @onclick="OpenApplyPack">
                <svg class="jg-pt-act-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                批量应用
            </button>
        </div>
    </div>

    @* ── 工具行：搜索（筛选页签已去掉，只显示全部） ── *@
    <div class="jg-mods-toolbar" style="margin-top:10px">
        <div class="jg-chips" role="group">
            @foreach (var tab in Tabs)
            {
                <button class="jg-chip @(_tab == tab.Key ? "active" : "")" @onclick='() => SetTab(tab.Key)'>@tab.Label</button>
            }
        </div>
        <div class="jg-search-x @(_searchOpen ? "open" : "")">
            <button class="jg-search-btn" @onclick="ToggleSearch">
                <img src="assets/search.svg" alt="搜索" style="width:18px;height:18px;display:block" />
            </button>
            <div class="jg-search-field">
                <input class="jg-search-input" placeholder="搜角色名" @bind="SearchText" @bind:event="oninput" />
                <button class="jg-search-clear" @onclick="ClearSearchAndClose">✕</button>
            </div>
        </div>
    </div>

    @* ── 角色网格：底色透明，封面=当前生效真实大头照（像素风放大）── *@
    @if (_scanning)
    {
        @* v1.6.8：扫描中 shimmer 骨架卡（复用 Mods 页同款微光原语，不再白屏干等） *@
        <div class="jg-pt-grid jg-pt-skelgrid">
            @for (var i = 0; i < 12; i++)
            {
                <div class="jg-pt-card jg-pt-skelcard">
                    <span class="jg-shimmer jg-pt-skelcover"></span>
                    <span class="jg-shimmer jg-pt-skelname"></span>
                </div>
            }
        </div>
    }
    else if (_characters is not null && VisibleCharacters.Any())
    {
        <div class="jg-pt-grid">
            @foreach (var ch in VisibleCharacters)
            {
                var chLocal = ch;
                var selected = SelectedFolder(chLocal);
                var skinCount = chLocal.Skins.Count(s => !s.IsNative);
                var locked = IsCharLocked(chLocal);
                <div class="jg-pt-slot">
                    <button class="jg-pt-card @(locked ? "locked-card" : "")" @onclick="() => OpenModal(chLocal)" aria-label="@chLocal.DisplayName">
                    @* 磁吸/倾斜只作用在这一层：按钮自己的盒子一旦 transform，它的命中区就跟着挪走，
                       边缘那几像素的点会落到外层槽上 —— Blazor 挂在按钮上的 @onclick 收不到，
                       表现成"有些角色要点两遍才进弹窗"（用户 09-24 反馈）。 *@
                    <span class="jg-pt-tilt">
                    @if (locked)
                    {
                        <span class="jg-pt-lockbadge" title="已锁定">
                            <svg viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true"><path d="M385.150849 385.662338l-128.895105 0 0-150.377622q0-49.102897 19.436563-91.556444t53.706294-74.677323 80.815185-50.637363 101.786214-18.413586q49.102897 0 94.625375 18.413586t80.815185 50.637363 56.263736 74.677323 20.971029 91.556444l0 150.377622-123.78022 0 0-121.734266q0-64.447552-35.804196-99.74026t-97.182817-35.292707q-55.240759 0-88.999001 35.292707t-33.758242 99.74026l0 121.734266zM826.053946 447.040959q27.62038 0 47.568432 19.948052t19.948052 47.568432l0 317.122877q0 27.62038-9.718282 51.66034t-26.597403 41.942058-39.896104 28.131868-50.637363 10.22977l-516.603397 0q-27.62038 0-50.125874-10.22977t-38.361638-27.108891-24.551449-39.384615-8.695305-48.07992l0-324.283716q0-27.62038 19.436563-47.568432t47.056943-19.948052l61.378621 0 128.895105 0 255.744256 0 123.78022 0 61.378621 0z"/></svg>
                        </span>
                    }
                    @if (skinCount > 0)
                    {
                        <span class="jg-pt-badge" data-tip="有 @skinCount 个可选皮肤">@skinCount</span>
                    }
                    <span class="jg-pt-cover">
                        @{
                            var cover = PortraitSkin.GetCharacterCover(GamePath, chLocal, selected);
                        }
                        @if (cover is not null)
                        {
                            <img src="@cover" alt="" draggable="false" />
                        }
                        else
                        {
                            <span class="jg-pt-cover-empty"></span>
                        }
                    </span>
                    <span class="jg-pt-name">@chLocal.DisplayName</span>
                    </span>
                </button>
                </div>
            }
        </div>
    }
    else if (_characters is not null && !_scanning)
    {
        <div class="jg-card" style="margin-top:12px">
            @(string.IsNullOrWhiteSpace(SearchText) && _tab == "all"
                ? "没有找到任何角色 —— 确认游戏目录指向的是星露谷本体，或先装一个肖像 mod 试试。"
                : "没有符合筛选条件的角色。")
        </div>
    }

    @* ── 皮肤选择弹窗（v2 单列表：默认行置顶，全部是大头照格子）── *@
    @if (_modalChar is not null)
    {
        var charLocked = IsCharLocked(_modalChar);
        <div class="jg-modal-overlay" @onclick="CloseModal">
            <div class="jg-modal jg-pt-modal @(charLocked ? "is-locked" : "")" @onclick:stopPropagation>
                @{
                    // v1.3.9：季节激活时的"生效皮肤" = 该季分配的皮肤（右键固定的），
                    // 没分配才回落全局选择 —— 高亮/标题/预览全部按它来，
                    // 否则"右键固定了第二张卡、高亮还停在第一张"（用户实测）
                    var effSeasonSkins = PortraitSkinService.GetSeasonSkins(Cfg.Current, _modalChar.Id);
                    PortraitSkinOption? EffectiveOption()
                    {
                        if (_season is not null && effSeasonSkins.TryGetValue(_season, out var pk))
                        {
                            var hit = _modalChar.AllOptions.FirstOrDefault(o =>
                                string.Equals(o.PackFolder ?? "", pk ?? "", StringComparison.OrdinalIgnoreCase));
                            if (hit is not null) return hit;
                        }
                        return ActiveOption(_modalChar);
                    }
                    var ptActive = EffectiveOption();
                    var seasonPortraitFiles = PortraitSkinService.GetSeasonFilesForChar(ptActive?.SourceFile, _modalChar.Id);
                    // 锁定中：大图/卡片直接用 PinFile（锁定瞬间那张，含冬装）
                    var lockPreview = charLocked
                        ? PortraitSkinService.GetLock(Cfg.Current, _modalChar.Id)
                            ?? _modalChar.Members
                                .Select(m => PortraitSkinService.GetLock(Cfg.Current, m))
                                .FirstOrDefault(l => l is not null)
                        : null;
                }
                <button type="button"
                        class="jg-pt-lockbtn @(charLocked ? "on" : "")"
                        title="@(charLocked ? "已锁定：游戏内四季固定为当前肖像。点击解锁" : "点击锁定：游戏内四季都用这一张，页面同步禁用")"
                        @onclick="() => ToggleLock(_modalChar, ptActive)">
                    @* 未锁定 = 解锁.svg（开锁）；锁定后 = 锁定.svg（闭锁） *@
                    @if (charLocked)
                    {
                        <svg viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true"><path d="M385.150849 385.662338l-128.895105 0 0-150.377622q0-49.102897 19.436563-91.556444t53.706294-74.677323 80.815185-50.637363 101.786214-18.413586q49.102897 0 94.625375 18.413586t80.815185 50.637363 56.263736 74.677323 20.971029 91.556444l0 150.377622-123.78022 0 0-121.734266q0-64.447552-35.804196-99.74026t-97.182817-35.292707q-55.240759 0-88.999001 35.292707t-33.758242 99.74026l0 121.734266zM826.053946 447.040959q27.62038 0 47.568432 19.948052t19.948052 47.568432l0 317.122877q0 27.62038-9.718282 51.66034t-26.597403 41.942058-39.896104 28.131868-50.637363 10.22977l-516.603397 0q-27.62038 0-50.125874-10.22977t-38.361638-27.108891-24.551449-39.384615-8.695305-48.07992l0-324.283716q0-27.62038 19.436563-47.568432t47.056943-19.948052l61.378621 0 128.895105 0 255.744256 0 123.78022 0 61.378621 0z"/></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true"><path d="M768.25422 0q48.810328 0 94.061569 18.303873t80.333664 50.33565 56.436941 74.740814 21.354518 91.519364l0 150.49851-123.042701 0 0-122.025819q0-64.063555-36.099305-99.654419t-97.112214-35.590864q-54.911619 0-88.468719 35.590864t-33.5571 99.654419l0 124.059583-128.12711 0 0-152.532274q0-48.810328 19.320755-91.519364t53.386296-74.740814 80.333664-50.33565 101.179742-18.303873zM766.220457 693.513406l0 87.451837 0 47.793446q0 27.455809-9.660377 51.860973t-26.438928 41.692155-39.658391 27.455809-50.33565 10.168818l-514.542205 0q-27.455809 0-49.82721-9.660377t-38.641509-26.438928-24.913605-39.14995-8.643496-47.793446l0-323.368421q0-28.472691 19.829196-47.793446t46.268123-19.320755l629.449851 0q28.472691 0 47.793446 19.320755t19.320755 47.793446l0 179.988083z"/></svg>
                    }
                </button>
                <div class="jg-pt-head">
                    <div class="jg-modal-title" style="margin-bottom:2px">@_modalChar.DisplayName</div>
                    <span style="font-size:12px;opacity:.55">@(_modalChar.Members.Count > 1
                        ? string.Join(" · ", _modalChar.Members) : _modalChar.Id)</span>
                    @* 当前生效的皮肤（悬停某张卡时临时变成灰色的那个皮肤名，离开恢复）。
                       v1.3.9：mod 名可点 → 直接进该 mod 的详情页 *@
                    <span class="jg-pt-active jg-pt-packlink @(_hoverLabel is not null ? "hovering" : "")"
                          @onclick="@(() => GoPackDetail(_modalChar))">@(_hoverLabel ?? (ptActive?.PackName ?? ""))</span>
                </div>
                @if (_modalChar.Members.Count > 1)
                {
                    @* 同一个人的几份 NPC 数据并成了一张卡（SVE 为剧情多开的条目，连显示名
                       都写的是本尊的）—— 说清楚点一次会同时改哪几个，免得以为漏了 *@
                    <div class="jg-pt-members">
                        这张卡同时管游戏里的 @_modalChar.Members.Count 份 NPC 数据（@string.Join("、", _modalChar.Members)），点任何一张皮肤它们一起换。
                    </div>
                }

                <div class="jg-pt-body">
                    <div class="jg-pt-left">
                        @* 季节行：点选预览该季；长按左侧皮肤格 = 固定到当前季 *@
                        <div class="jg-pt-seasons">
                            @foreach (var (sKey, sLabel) in new[] { ("spring", "春"), ("summer", "夏"), ("fall", "秋"), ("winter", "冬") })
                            {
                                var k = sKey;
                                @* 锁定时仍可点季节做预览（只是不能改皮肤），打开默认停在锁定季 *@
                                <button type="button"
                                        class="jg-pt-season @(_season == k ? "active" : "")"
                                        title="@(seasonPortraitFiles.ContainsKey(k) ? $"预览{sLabel}季外观；长按皮肤格可固定到{sLabel}季" : $"当前皮肤没有{sLabel}季变体，点击显示当前外观")"
                                        @onclick="() => ToggleSeason(k)">@sLabel</button>
                            }
                            <span class="jg-pt-hint">长按皮肤 = 固定到当前季</span>
                        </div>
                        <div class="jg-pt-skinbox">
                            @foreach (var opt in _modalChar.AllOptions.ToList())
                            {
                                var optLocal = opt;
                                // 高亮 = EffectiveOption（季节分配命中才用它，否则回落全局选择）。
                                // 不能直接比 effSeasonSkins[_season]：分配指向已卸载/已折叠包时
                                // 没有任何卡能匹配，春天会整排无选中框（Emily+Seasonal Baechu 实测）
                                var isSel = ptActive is not null
                                    && string.Equals(optLocal.PackFolder ?? "", ptActive.PackFolder ?? "", StringComparison.OrdinalIgnoreCase)
                                    && optLocal.IsVanilla == ptActive.IsVanilla
                                    && optLocal.IsNative == ptActive.IsNative;
                                var unavailable = !optLocal.IsVanilla && !optLocal.IsNative && optLocal.SourceFile is null;
                                // 同画面的其它包（作者 CP 版 + 我们转换的素材包 + 手放进 Portraiture 的同一批画）
                                // 已经并到这一条上：卡右上角标 ×N，卡底铺来源名，悬停看没截断的全名。
                                // 近似同款（整张差 ≤5%）另算一批，标 ≈ 让人知道不是同一份文件。
                                var merged = optLocal.Dupes.Count + optLocal.NearDupes.Count;
                                var dupeTip = merged > 0
                                    ? (optLocal.Dupes.Count > 0
                                        ? $"\n另有 {optLocal.Dupes.Count} 个相同画面来源：" + string.Join(" / ", optLocal.Dupes) : "")
                                      + (optLocal.NearDupes.Count > 0
                                        ? $"\n≈ 另有 {optLocal.NearDupes.Count} 个近似来源（整张画面差 ≤5%）："
                                          + string.Join(" / ", optLocal.NearDupes) : "")
                                    : "";
                                // 选了季节 → 该皮肤格显示它自己的该季变体（没有就保持默认图）
                                var seasonCardSrc = lockPreview?.PinFile is not null && File.Exists(lockPreview.PinFile)
                                        && string.Equals(optLocal.PackFolder ?? "", lockPreview.PackFolder ?? "", StringComparison.OrdinalIgnoreCase)
                                    ? lockPreview.PinFile
                                    : _season is not null
                                    && PortraitSkinService.GetSeasonFilesForChar(optLocal.SourceFile, _modalChar.Id).TryGetValue(_season, out var osf)
                                        ? osf : optLocal.SourceFile;
                                var skinKey = (optLocal.IsVanilla ? "V|" : optLocal.IsNative ? "N|" : "S|") + (optLocal.PackFolder ?? "");
                                <div class="jg-pt-skin @(isSel ? "selected" : "") @(unavailable ? "unavailable" : "") @(_busy ? "busy" : "") @(charLocked ? "locked" : "")"
                                     data-skin-id="@skinKey"
                                     title="@((unavailable ? "这个皮肤包未找到可用立绘文件，不能切换，避免游戏中出现透明头像。" : _busy ? "正在切换皮肤，请稍候…" : charLocked ? "已锁定，先点右上角锁解锁" : _season is not null ? $"单击 = 换成这个皮肤；长按 = 只给{_season switch { "spring" => "春", "summer" => "夏", "fall" => "秋", _ => "冬" }}季固定这个皮肤" : "单击 = 换成这个皮肤；先点季节再长按可按季固定") + dupeTip)"
                                     @onclick="() => OnSkinClick(_modalChar, optLocal)"
                                     @oncontextmenu:preventDefault
                                     @oncontextmenu="() => AssignSeasonSkin(_modalChar, optLocal)"
                                     @onmouseenter="() => _hoverLabel = optLocal.PackName"
                                     @onmouseleave="() => _hoverLabel = null">
                                    @{
                                        var thumb = PortraitSkin.GetPortraitThumbByPath(seasonCardSrc);
                                    }
                                    @if (thumb is not null)
                                    {
                                        <img src="@thumb" alt="" draggable="false" />
                                    }
                                    else
                                    {
                                        <span class="jg-pt-cover-empty"></span>
                                    }
                                    @if (merged > 0)
                                    {
                                        <span class="jg-pt-dupes">×@(merged + 1)</span>
                                        <span class="jg-pt-dupenames">@DupesLine(optLocal)</span>
                                    }
                                    @* v1.3.8：皮肤卡 ✕ 删除按钮取消（用户要求）—— 点删会把整个
                                       mod 包移进回收站，误触代价太大；卸载 mod 请走「Mod 管理」页。 *@
                                </div>
                            }
                        </div>
                    </div>

                    @* 右侧：当前选中皮肤对应的精灵图（走动小人整表），随季节一起切换。
                       所选皮肤没带精灵图（纯立绘包）→ 显示原版样貌；解码失败继续尝试
                       默认/mod 默认精灵图，不能留空白面板。 *@
                    @{
                        var seasonSpriteFile = _season is not null
                            && ptActive?.SpriteFile is not null
                            && PortraitSkinService.GetSeasonFilesForChar(ptActive.SpriteFile, _modalChar.Id).TryGetValue(_season, out var ssf)
                                ? ssf : null;
                        var spriteCandidates = new[]
                        {
                            ptActive, _modalChar.Vanilla, _modalChar.Native
                        }.Where(o => o?.SpriteFile is not null)
                         .Select(o => o!)
                         // 娘家没精灵时兜底到皮肤包自带的精灵（LittleGruff 实测：精灵在
                         // East Scarp: Locations 包里）
                         .Concat(_modalChar.Skins.Where(s => s.SpriteFile is not null))
                         .DistinctBy(o => o!.SpriteFile, StringComparer.OrdinalIgnoreCase)
                         .ToList();
                        var spriteThumb = seasonSpriteFile is not null
                            ? PortraitSkin.GetSpriteThumbByPath(seasonSpriteFile)
                            : spriteCandidates
                                .Select(o => PortraitSkin.GetSpriteThumbByPath(o!.SpriteFile))
                                .FirstOrDefault(t => t is not null);
                    }
                    <div class="jg-pt-spritepane">
                        @if (spriteThumb is not null)
                        {
                            <img src="@spriteThumb" alt="" draggable="false" />
                        }
                    </div>
                </div>
                <div class="jg-pt-lockveil">
                    <span>已锁定 —— 四季固定为当前肖像，点右上角锁可解锁</span>
                </div>
            </div>
        </div>
    }

    @* ── 批量应用：选包 ── *@
    @if (_applyOpen)
    {
        <div class="jg-modal-overlay" @onclick="() => _applyOpen = false">
            <div class="jg-modal" style="max-width:560px" @onclick:stopPropagation>
                <div class="jg-modal-title">批量应用肖像包</div>
                <div class="jg-modal-body" style="margin-bottom:10px">
                    选一个包，所有拥有它皮肤的角色都会切换过去。已锁定的角色自动跳过。
                </div>
                <div class="jg-pt-packlist">
                    @foreach (var p in _appliablePacks)
                    {
                        var pLocal = p;
                        var coverUrl = PackCoverUrl(pLocal.PackFolder);
                        var thumb = coverUrl is null
                            ? PortraitSkin.GetPortraitThumbByPath(pLocal.SampleSource)
                            : null;
                        <button type="button" class="jg-pt-packrow" @onclick="() => OnApplyPack(pLocal.PackFolder, pLocal.PackName)">
                            <span class="cover">
                                @if (coverUrl is not null)
                                {
                                    <img src="@coverUrl" alt="" draggable="false" loading="lazy"
                                         style="object-fit:cover;width:100%;height:100%" />
                                }
                                else if (thumb is not null)
                                {
                                    <img src="@thumb" alt="" draggable="false" />
                                }
                                else
                                {
                                    <span class="cover-empty"></span>
                                }
                            </span>
                            <span class="meta">
                                <span class="nm">@pLocal.PackName</span>
                                <span class="ct" style="align-self:flex-start">@pLocal.CharCount 个角色</span>
                            </span>
                        </button>
                    }
                    @if (_appliablePacks.Count == 0)
                    {
                        <div style="opacity:.7;font-size:13px;padding:8px 2px">没有可批量应用的皮肤包（先装一个肖像 mod）。</div>
                    }
                </div>
                <div class="jg-modal-actions">
                    <button class="jg-pill-ghost" @onclick="() => _applyOpen = false">取消</button>
                </div>
            </div>
        </div>
    }

    @* ── 恢复默认确认 ── *@
    @if (_restoreOpen)
    {
        <div class="jg-modal-overlay" @onclick="() => _restoreOpen = false">
            <div class="jg-modal" style="max-width:420px" @onclick:stopPropagation>
                <div class="jg-modal-title">一键恢复默认</div>
                <div class="jg-modal-body">
                    将清除全部皮肤选择、季节固定和锁定，恢复为默认肖像。
                </div>
                <div class="jg-modal-actions">
                    <button class="jg-pill-ghost" @onclick="() => _restoreOpen = false">取消</button>
                    <button class="jg-pill-danger" disabled="@_busy" @onclick="ConfirmRestoreDefaults">恢复默认</button>
                </div>
            </div>
        </div>
    }

    @if (_toast is not null)
    {
        <div class="jg-pt-toast">@_toast</div>
    }
</div>

@code {
    private string GamePath => Cfg.Current.GamePath ?? "";

    private List<PortraitCharacter>? _characters;
    private bool _scanning;

    // ── 筛选 ──
    private string _tab = "all";        // all | vanilla | others | skin:<包 Folder>
    private string SearchText { get; set; } = "";
    private bool _searchOpen;

    /// <summary>只保留「全部」—— 筛选页签已按用户要求去掉。</summary>
    private IEnumerable<(string Key, string Label)> Tabs
    {
        get
        {
            yield return ("all", "全部");
        }
    }

    /// <summary>卡面上的「同画面来源」一行：名字先按页签那套洗干净（剥 [CP] 等前后缀），
    /// 每段截断后用 / 连接 —— 用户要求合并了哪几个包要直接看得见，不能只藏在悬停里。
    /// 近似同款（整张画面差 ≤5%）带一个 ≈ 前缀，跟「完全相同」区分开。</summary>
    private static string DupesLine(PortraitSkinOption o) =>
        string.Join(" / ", new[] { o.PackName }
            .Concat(o.Dupes)
            .Concat(o.NearDupes.Select(n => "≈" + n))
            .Select(ClipPackName));

    private static string ClipPackName(string name)
    {
        var n = CleanPackName(name);
        return n.Length <= 10 ? n : n[..10] + "…";
    }

    /// <summary>页签只显示干净的 mod 名：剥开头 "[CP] " 标记前缀、结尾 " [Content Patcher
    /// component]" 组件后缀，以及 "Seven.Deadly.Sins-CP" 这类点分/带 CP 尾缀的 manifest 写法。</summary>
    private static string CleanPackName(string name)
    {
        var n = name.Trim();
        while (n.StartsWith("["))
        {
            var close = n.IndexOf(']');
            if (close < 0) break;
            n = n[(close + 1)..].Trim();
        }
        while (n.EndsWith("]"))
        {
            var open = n.LastIndexOf('[');
            if (open < 0) break;
            n = n[..open].Trim();
        }
        if (!n.Contains(' ') && n.Contains('.'))
            n = n.Replace('.', ' ');
        n = System.Text.RegularExpressions.Regex.Replace(
            n, @"[\s\-_]+CP$", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return n.Length > 0 ? n : name;
    }

    private IEnumerable<PortraitCharacter> VisibleCharacters
    {
        get
        {
            if (_characters is null) yield break;
            foreach (var ch in _characters)
            {
                if (ch.Hidden) continue;   // 已并进本尊那张卡的别名条目
                if (_tab == "vanilla" && !ch.IsVanilla) continue;
                if (_tab == "others" && ch.IsVanilla) continue;
                if (_tab.StartsWith("skin:", StringComparison.Ordinal))
                {
                    var pack = _tab["skin:".Length..];
                    // 有这个美化包的皮肤选项才算（内容扩展的娘家皮肤不在此列）
                    if (!ch.Skins.Any(s => !s.IsVanilla && !s.IsNative
                        && string.Equals(s.PackFolder ?? "", pack, StringComparison.OrdinalIgnoreCase)))
                        continue;
                }
                if (SearchText.Length > 0 && !MatchesSearch(ch)) continue;
                yield return ch;
            }
        }
    }

    /// <summary>搜索同时认显示名、本尊 id 和并进来的别名 id（搜 "ScarlettFake" 也要出斯嘉丽）。</summary>
    private bool MatchesSearch(PortraitCharacter ch)
    {
        if (ch.DisplayName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
            ch.Id.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) return true;
        return ch.Members.Any(m => m.Contains(SearchText, StringComparison.OrdinalIgnoreCase));
    }

    // ── 弹窗状态 ──
    private PortraitCharacter? _modalChar;
    private bool _busy;
    /// <summary>悬停皮肤格时临时显示那个皮肤名（标题旁标签变灰），离开恢复当前生效名。</summary>
    private string? _hoverLabel;

    // ── 批量 / 恢复 ──
    private bool _applyOpen;
    private bool _restoreOpen;
    private List<(string PackFolder, string PackName, int CharCount, string? SampleSource)> _appliablePacks = new();

    // ── JS 互操作（长按 / ESC）──
    private DotNetObjectReference<Portraits>? _jsRef;

    // ── 提示（「下次启动游戏生效」/ Portraiture 按 P 提示）──
    private string? _toast;
    private System.Threading.Timer? _toastTimer;

    protected override void OnInitialized()
    {
        PortraitSkin.Changed += OnThumbsChanged;
        PageRefresh.OnRefresh += OnPageRefresh;
        if (string.IsNullOrWhiteSpace(GamePath)) return;
        // 内存里已有本轮扫描 → 直接上屏；后台也不再重扫/重预热（签名未变时 Scan 会秒回，
        // 但 Prewarm 仍会把几百张图再派发一遍 —— 这就是「每次进肖像页都在重载」）
        var mem = PortraitSkin.TryGetMemoryScan(GamePath);
        if (mem is not null)
        {
            _characters = mem.Characters;
            _scan = mem;
            _scanning = false;
            return;
        }
        _scanning = true;
        _ = Task.Run(() =>
        {
            PortraitScanResult scan;
            try { scan = PortraitSkin.Scan(GamePath); }
            catch (Exception ex)
            {
                AppLog.Error("Portraits", "扫描失败: " + ex.Message);
                scan = new PortraitScanResult();
            }
            return InvokeAsync(() =>
            {
                _characters = scan.Characters;
                _scan = scan;
                RepairUnavailableSelections(scan);
                _scanning = false;
                StateHasChanged();
                _ = Task.Run(() => PortraitSkin.PrewarmThumbs(GamePath, scan));
            });
        });
    }

    private PortraitScanResult? _scan;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _jsRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("junigridJs.portraitsBind", _jsRef);
                // 悬停动效（磁吸 + 3D 倾斜 + 镭射膜坐标）。它内部是一次性的文档级委托，
                // 所以只需要挂一次，列表再怎么变也不用补绑、也不用每次渲染打 JS。
                await JS.InvokeVoidAsync("junigridJs.ptMagnetic");
            }
            catch { }
        }
        // 只在弹窗开合状态变化时挂/摘 ESC —— 每次 StateHasChanged 都打 JS 是切页卡顿来源
        try
        {
            var wantEsc = _modalChar is not null || _applyOpen || _restoreOpen;
            if (wantEsc != _escBound)
            {
                _escBound = wantEsc;
                await JS.InvokeVoidAsync("junigridJs.portraitsEsc", wantEsc ? _jsRef : null);
            }
        }
        catch { }
    }

    private bool _escBound;

    [JSInvokable]
    public async Task OnSkinLongPress(string skinId)
    {
        if (_modalChar is null || _busy) return;
        if (IsCharLocked(_modalChar)) return;
        var opt = ResolveSkinById(_modalChar, skinId);
        if (opt is null) return;
        await AssignSeasonSkin(_modalChar, opt);
    }

    [JSInvokable]
    public void OnEscapeClose()
    {
        if (_applyOpen) { _applyOpen = false; StateHasChanged(); return; }
        if (_restoreOpen) { _restoreOpen = false; StateHasChanged(); return; }
        if (_modalChar is not null) { CloseModal(); StateHasChanged(); }
    }

    private static PortraitSkinOption? ResolveSkinById(PortraitCharacter ch, string skinId)
    {
        if (string.IsNullOrEmpty(skinId)) return null;
        var sep = skinId.IndexOf('|');
        if (sep <= 0) return null;
        var kind = skinId[..sep];
        var pack = skinId[(sep + 1)..];
        foreach (var o in ch.AllOptions)
        {
            if (kind == "V" && o.IsVanilla) return o;
            if (kind == "N" && o.IsNative) return o;
            if (kind == "S" && !o.IsVanilla && !o.IsNative
                && string.Equals(o.PackFolder ?? "", pack, StringComparison.OrdinalIgnoreCase))
                return o;
        }
        return null;
    }

    private void OnThumbsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PortraitSkin.Changed -= OnThumbsChanged;
        PageRefresh.OnRefresh -= OnPageRefresh;
        _toastTimer?.Dispose();
        try { _ = JS.InvokeVoidAsync("junigridJs.portraitsDispose"); } catch { }
        _jsRef?.Dispose();
    }

    private void OnPageRefresh(string key)
    {
        if (key != "portraits") return;
        Rescan();
    }

    private void Rescan()
    {
        if (string.IsNullOrWhiteSpace(GamePath)) return;
        // 已有数据时不闪骨架、不清空 —— 后台对齐完再替换
        if (_characters is null) _scanning = true;
        PortraitSkin.InvalidateMemoryScan();
        _ = Task.Run(() =>
        {
            PortraitScanResult scan;
            try { scan = PortraitSkin.Scan(GamePath); }
            catch { scan = new PortraitScanResult(); }
            return InvokeAsync(() =>
            {
                _characters = scan.Characters;
                _scan = scan;
                RepairUnavailableSelections(scan);
                _scanning = false;
                // 弹窗里的角色引用可能已失效（包被删）→ 关掉最稳
                _modalChar = null;
                StateHasChanged();
                _ = Task.Run(() => PortraitSkin.PrewarmThumbs(GamePath, scan));
                // 自愈：按当前配置刷新覆盖包（幂等；防配置与覆盖包内容脱节）
                _ = Task.Run(() =>
                {
                    try { PortraitSkin.SyncToDisk(GamePath, scan); }
                    catch { /* 覆盖包写入失败只影响下次启动游戏的效果 */ }
                });
            });
        });
    }

    // ── 选择状态 ──
    private string? SelectedFolder(PortraitCharacter ch) =>
        Cfg.Current.PortraitSkins.TryGetValue(ch.Id, out var f) ? f : null;

    private bool IsCharLocked(PortraitCharacter ch)
    {
        if (PortraitSkinService.IsLocked(Cfg.Current, ch.Id)) return true;
        return ch.Members.Any(m => PortraitSkinService.IsLocked(Cfg.Current, m));
    }

    /// <summary>切换皮肤后同步会改名启用/禁用包（.X ↔ X），内存里扫到的绝对路径随之失效。
    /// 重新扫描刷新路径；与 Rescan 不同 —— 弹窗按 id 重映射保持打开，不打断用户。</summary>
    private void RefreshAfterSync()
    {
        if (string.IsNullOrWhiteSpace(GamePath)) return;
        // v1.6.8：弹窗开着时延迟背景刷新 —— 立即刷新会让背后整页角色卡重新
        // diff/渲染（WebView 大 DOM），正是切换皮肤"卡一下"的来源。弹窗里
        // 已通过 StateHasChanged 即时反映新选择，关弹窗时统一补刷背景。
        if (_modalChar is not null) { _pendingRefresh = true; return; }
        var modalId = _modalChar?.Id;
        _ = Task.Run(() =>
        {
            PortraitScanResult scan;
            try { scan = PortraitSkin.Scan(GamePath); }
            catch { return; }
            _ = InvokeAsync(() =>
            {
                _scan = scan;
                _characters = scan.Characters;
                RepairUnavailableSelections(scan);
                _modalChar = modalId is null
                    ? null
                    : scan.Characters.FirstOrDefault(c => c.Id == modalId);
                StateHasChanged();
                _ = Task.Run(() => PortraitSkin.PrewarmThumbs(GamePath, scan));
            });
        });
    }

    private bool IsSelected(PortraitCharacter ch, PortraitSkinOption opt)
    {
        var sel = SelectedFolder(ch);
        // 无选择 = 默认外观（原版角色高亮官方皮肤行、mod 角色高亮默认外观行）
        if (sel is null) return opt.IsVanilla || opt.IsNative;
        return !opt.IsVanilla && string.Equals(sel, opt.PackFolder, StringComparison.OrdinalIgnoreCase);
    }

    private async Task PickSkin(PortraitSkinOption opt)
    {
        if (_modalChar is null || _busy || _scan is null) return;
        // 动态路径无法解析的包没有可确认的完整立绘；不写入选择，避免 Content Patcher
        // 载入错误素材后把游戏里的肖像变成透明。
        if (!opt.IsVanilla && !opt.IsNative && opt.SourceFile is null)
        {
            ShowToast("这个皮肤包未找到可用立绘文件，已阻止切换以避免透明头像");
            return;
        }
        if (IsCharLocked(_modalChar))
        {
            ShowToast("已锁定，先点右上角锁解锁再改");
            return;
        }
        _busy = true;
        var ch = _modalChar;
        // 默认行（官方/mod 默认外观）= 回到默认（不写选择）。
        // 「已选中的再点一次」以前也当回默认 —— 用户 09-24 明确要求改掉：再点同一张应该啥也不发生，
        // 想回默认有点「默认」那一行走，不该拿误触当命令。
        if (!opt.IsVanilla && !opt.IsNative && IsSelected(ch, opt)) return;
        var folder = (opt.IsVanilla || opt.IsNative) ? null : opt.PackFolder;
        // v1.6.8：点选瞬间先在后台预热目标立绘/季节变体的缩略图 —— 切换落盘完成时
        // 图已就绪，弹窗渲染零等待（否则新图要在渲染线程当场解码+裁剪+缩放，卡一下）
        _ = PortraitSkin.GetSkinThumb(ch, opt);
        PortraitSkin.PrewarmSeasonThumbs(ch);
        try
        {
            await Task.Run(() => PortraitSkin.SelectSkin(GamePath, _scan, ch.Id, folder));
            if (opt.IsPortraiture && folder is not null)
                ShowToast("已切换");
            else if (folder is null && ch.Skins.Any(s => s.IsPortraiture))
                ShowToast("已切换回默认");
            else
                ShowToast("已切换");
            // SelectSkin 不再启停/改名包，路径仍有效 —— 全量重扫是卡顿主因，只刷界面
        }
        catch (Exception ex)
        {
            ShowToast("写入失败：" + ex.Message);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>旧版本已把“找不到实际立绘文件”的包写入选择时，主动回到默认。
    /// 这类选择只会让 Content Patcher 加载空素材，游戏里表现为透明肖像。
    /// v1.6.7：Mods 按版本隔离、选择是全局的 —— 当前版本扫不到来源 ≠ 包没了
    ///（可能只是躺在别的版本的 staging 里）。只有整个磁盘（游戏目录 + 全部
    /// 版本 staging）都没有这个包时才回默认，否则版本往返会永久误清选择。</summary>
    private void RepairUnavailableSelections(PortraitScanResult scan)
    {
        var invalidChars = scan.Characters.Where(ch =>
        {
            var selected = SelectedFolder(ch);
            if (selected is null) return false;
            if (IsCharLocked(ch)) return false;   // 锁定中的不自动修
            var opt = ch.AllOptions.FirstOrDefault(o =>
                !o.IsVanilla && string.Equals(o.PackFolder, selected, StringComparison.OrdinalIgnoreCase));
            return opt is not null
                && opt.SourceFile is null
                && !PackExistsAnywhere(selected);
        }).ToList();

        foreach (var ch in invalidChars)
            PortraitSkin.SelectSkin(GamePath, scan, ch.Id, null);

        if (invalidChars.Count > 0)
            ShowToast("已切换回默认");
    }

    /// <summary>包目录在游戏 Mods 或任一版本 staging 的 Mods 里是否存在。</summary>
    private bool PackExistsAnywhere(string packFolder)
    {
        var rel = packFolder.Replace('/', Path.DirectorySeparatorChar);
        if (Directory.Exists(Path.Combine(GamePath, "Mods", rel))) return true;
        try
        {
            var stagingRoot = StoragePaths.DepotStagingDir;
            if (!Directory.Exists(stagingRoot)) return false;
            foreach (var st in Directory.EnumerateDirectories(stagingRoot))
            {
                if (Path.GetFileName(st).StartsWith('_')) continue;   // 共享池等内部目录
                if (Directory.Exists(Path.Combine(st, "Mods", rel))) return true;
            }
        }
        catch { }
        return false;
    }


    // ── 弹窗交互 ──
    // 弹窗季节预览：默认停在春季（用户要求）；spring/summer/fall/winter
    private string? _season = "spring";

    // v1.3.9：关闭后的短暂保护窗 —— 双击/快速连点关闭时，第二下会点到弹窗底下
    // 压着的角色卡，弹窗立刻重开（用户实测"关闭后有时重新打开"）
    private DateTime _modalClosedAt = DateTime.MinValue;
    // v1.6.8：弹窗开着时延迟的背景刷新标记（关弹窗统一补刷）
    private bool _pendingRefresh;

    private void OpenModal(PortraitCharacter ch)
    {
        // Windows 双击间隔设置最长 500ms，保护窗必须盖过它
        if ((DateTime.Now - _modalClosedAt).TotalMilliseconds < 650) return;
        _modalChar = ch;
        _season = "spring";
        // 锁定时预览停在锁定的那一季（锁了冬天，打开就该是冬天，而不是死在春季）
        var lk = PortraitSkinService.GetLock(Cfg.Current, ch.Id);
        if (lk is null)
            foreach (var m in ch.Members)
            {
                lk = PortraitSkinService.GetLock(Cfg.Current, m);
                if (lk is not null) break;
            }
        if (lk?.Season is { Length: > 0 } lockSeason)
            _season = lockSeason;
        // 预生成该角色全部皮肤的四季缩略图（后台），点季节按钮零等待
        PortraitSkin.PrewarmSeasonThumbs(ch);
    }

    private void CloseModal()
    {
        _modalChar = null;
        _modalClosedAt = DateTime.Now;
        // v1.6.8：补刷弹窗期间延迟的背景刷新
        if (_pendingRefresh)
        {
            _pendingRefresh = false;
            RefreshAfterSync();
        }
        try { _ = JS.InvokeVoidAsync("junigridJs.portraitsEsc", null); } catch { }
    }

    /// <summary>切换季节预览（默认即春季，点谁切谁）。</summary>
    private void ToggleSeason(string s)
    {
        _season = s;
        try { _ = JS.InvokeVoidAsync("junigridJs.ptSeasonPulse"); } catch { }
    }

    /// <summary>单击皮肤卡 = 全局换肤；长按（或右键）= 只固定到当前选中季节。</summary>
    private async Task OnSkinClick(PortraitCharacter ch, PortraitSkinOption opt)
    {
        if (_busy) return;
        if (IsCharLocked(ch)) { ShowToast("已锁定，先点右上角锁解锁再改"); return; }
        try
        {
            var gamePath = Cfg.Current.GamePath ?? "";
            if (gamePath.Length == 0 || _scan is null) return;
            await PickSkin(opt);
            StateHasChanged();
        }
        catch (Exception ex) { ShowToast("操作失败: " + ex.Message); }
        await Task.CompletedTask;
    }

    /// <summary>长按/右键皮肤卡 = 只给当前选中季节固定这个皮肤。</summary>
    private async Task AssignSeasonSkin(PortraitCharacter ch, PortraitSkinOption opt)
    {
        if (IsCharLocked(ch)) { ShowToast("已锁定，先点右上角锁解锁再改"); return; }
        if (_season is null)
        {
            ShowToast("先点一个季节按钮，再右键皮肤卡即可只固定那一季");
            return;
        }
        try
        {
            var gamePath = Cfg.Current.GamePath ?? "";
            if (gamePath.Length == 0 || _scan is null) return;
            // 已固定同一张卡再右键 = 解除该季固定（回落全局选择）。
            // ⚠ 不能用 GetValueOrDefault：未分配时返回 null → ""，
            // 会和默认行的 PackFolder="" 比成相等，右键「默认」永远写不进去（Emily 冬季实测）。
            var seasonSkins = PortraitSkinService.GetSeasonSkins(Cfg.Current, ch.Id);
            var already = seasonSkins.TryGetValue(_season, out var curPk)
                && string.Equals(curPk ?? "", opt.PackFolder ?? "", StringComparison.OrdinalIgnoreCase);
            if (already)
            {
                PortraitSkin.SetSeasonSkin(gamePath, _scan, ch.Id, _season, null);
                ShowToast($"{ch.DisplayName} 的{_season switch { "spring" => "春", "summer" => "夏", "fall" => "秋", _ => "冬" }}季已解除固定（回落全局选择，重启游戏生效）");
            }
            else
            {
                PortraitSkin.SetSeasonSkin(gamePath, _scan, ch.Id, _season, opt.PackFolder);
                ShowToast($"{ch.DisplayName} 的{_season switch { "spring" => "春", "summer" => "夏", "fall" => "秋", _ => "冬" }}季已固定使用「{opt.PackName}」（重启游戏生效）");
            }
            StateHasChanged();
        }
        catch (Exception ex) { ShowToast("操作失败: " + ex.Message); }
        await Task.CompletedTask;
    }

    /// <summary>锁定/解锁当前肖像。锁定后整卡禁用，游戏内四季固定为这一张。</summary>
    private async Task ToggleLock(PortraitCharacter ch, PortraitSkinOption? active)
    {
        if (_busy || _scan is null) return;
        var locked = IsCharLocked(ch);
        try
        {
            _busy = true;
            await Task.Run(() =>
            {
                if (locked)
                {
                    PortraitSkin.SetLocked(GamePath, _scan, ch.Id, false, null, null, null);
                }
                else
                {
                    string? pin = null;
                    if (active?.SourceFile is not null)
                    {
                        pin = _season is not null
                            && PortraitSkinService.GetSeasonFilesForChar(active.SourceFile, ch.Id)
                                .TryGetValue(_season, out var sf)
                                ? sf
                                : active.SourceFile;
                    }
                    PortraitSkin.SetLocked(GamePath, _scan, ch.Id, true, active, pin, _season);
                }
            });
            ShowToast(locked ? "已解锁，可继续换肤" : "已锁定：游戏内四季固定为当前肖像");
        }
        catch (Exception ex)
        {
            ShowToast("锁定失败：" + ex.Message);
        }
        finally
        {
            _busy = false;
            try { _ = JS.InvokeVoidAsync("junigridJs.ptLockFlip", !locked); } catch { }
            StateHasChanged();
        }
    }

    // ── 批量应用 / 一键恢复 ──
    /// <summary>Mod 管理页同款封面：Cfg.ModCovers（N 网 picture_url）按包目录查；
    /// 子包回落父目录；禁用包（. 前缀）用规范化 key 兜底。</summary>
    private string? PackCoverUrl(string packFolder)
    {
        if (string.IsNullOrWhiteSpace(packFolder)) return null;
        var map = Cfg.Current.ModCovers;
        if (map.TryGetValue(packFolder, out var u) && !string.IsNullOrWhiteSpace(u)) return u;
        static string Norm(string f)
        {
            var parts = f.Split('/');
            parts[0] = parts[0].TrimStart('.');
            return string.Join('/', parts);
        }
        var norm = Norm(packFolder);
        if (map.TryGetValue(norm, out var u2) && !string.IsNullOrWhiteSpace(u2)) return u2;
        if (packFolder.Contains('/'))
        {
            var cut = packFolder.LastIndexOf('/');
            var parent = packFolder[..cut];
            if (map.TryGetValue(parent, out var u3) && !string.IsNullOrWhiteSpace(u3)) return u3;
            var pnorm = Norm(parent);
            if (map.TryGetValue(pnorm, out var u4) && !string.IsNullOrWhiteSpace(u4)) return u4;
        }
        return null;
    }

    private void OpenApplyPack()
    {
        if (_scan is null) return;
        _appliablePacks = PortraitSkinService.ListAppliablePacks(_scan);
        _applyOpen = true;
    }

    private async Task OnApplyPack(string packFolder, string packName)
    {
        if (_scan is null || _busy) return;
        _applyOpen = false;
        _busy = true;
        try
        {
            var (applied, skipped) = await Task.Run(() =>
                PortraitSkin.ApplyPackToAll(GamePath, _scan, packFolder));
            ShowToast($"已应用「{packName}」到 {applied} 个角色"
                + (skipped > 0 ? $"，跳过 {skipped} 个已锁定" : ""));
            try { _ = JS.InvokeVoidAsync("junigridJs.ptGridFlash"); } catch { }
        }
        catch (Exception ex)
        {
            ShowToast("批量应用失败：" + ex.Message);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void OnRestoreDefaults()
    {
        _restoreOpen = true;
    }

    private async Task ConfirmRestoreDefaults()
    {
        if (_scan is null || _busy) return;
        _restoreOpen = false;
        _busy = true;
        try
        {
            await Task.Run(() => PortraitSkin.RestoreAllDefaults(GamePath, _scan));
            ShowToast("已全部恢复默认（原版角色使用原版肖像）");
            try { _ = JS.InvokeVoidAsync("junigridJs.ptGridFlash"); } catch { }
        }
        catch (Exception ex)
        {
            ShowToast("恢复失败：" + ex.Message);
        }
        finally
        {
            _busy = false;
            _modalChar = null;
            StateHasChanged();
        }
    }

    /// <summary>mod 名点击 → 该 mod 的详情页（经包目录 .junigrid.json 里的 nexusModId）。</summary>
    private void GoPackDetail(PortraitCharacter ch)
    {
        var opt = ActiveOption(ch);
        if (opt?.PackFolder is null) return;
        var nid = PortraitSkinService.GetNexusModId(Cfg.Current.GamePath ?? "", opt.PackFolder);
        if (nid is int id) Nav.NavigateTo("/mod/" + id);
        else ShowToast("这个皮肤包不是从 Nexus 安装的，没有详情页");
    }


    /// <summary>当前生效的皮肤选项（无选择 = 官方/mod 默认行）。</summary>
    private PortraitSkinOption? ActiveOption(PortraitCharacter ch)
    {
        foreach (var o in ch.AllOptions)
            if (IsSelected(ch, o)) return o;
        return ch.Vanilla ?? ch.Native;
    }


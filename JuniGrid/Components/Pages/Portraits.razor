    private void ShowToast(string msg)
    {
        _toast = msg;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ =>
            _ = InvokeAsync(() => { _toast = null; StateHasChanged(); }),
            null, 3200, System.Threading.Timeout.Infinite);
    }

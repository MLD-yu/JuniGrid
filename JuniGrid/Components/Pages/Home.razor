@namespace JuniGrid.Components.Pages
@page "/"
@inject ConfigService Cfg
@inject GameService Game
@inject ModService Mods
@inject LauncherService Launcher
@inject UpdateService Updater
@inject PlayTimeService PlayTime
@inject IJSRuntime JS
@implements IDisposable

<div class="jg-page">
    <div class="jg-grid-4">
        <div class="jg-card">
            <div class="jg-stat-label">已装 Mod</div>
            <div class="jg-stat-num">@_totalModCount</div>
            <div class="jg-stat-sub">@_activeModCount 启用 · @(_totalModCount - _activeModCount) 禁用</div>
        </div>

        <div class="jg-card">
            <div class="jg-stat-label">SMAPI</div>
            <div class="jg-stat-num">@(_smapiVersion is null ? "未安装" : _smapiVersion)</div>
            <div class="jg-stat-sub">
                @(_smapiVersion is null ? "仅支持 Steam 官方启动" : "Mod 加载器就绪")
            </div>
        </div>

        <div class="jg-card">
            <div class="jg-stat-label">游戏版本</div>
            <div class="jg-stat-num">@(_gameVersion ?? "未定位")</div>
            <div class="jg-stat-sub">Stardew Valley</div>
        </div>

        <div class="jg-card">
            <div class="jg-stat-label">最近游玩</div>
            <div class="jg-stat-num" style="font-size:18px;line-height:1.3;">
                @(_cfg.LastLaunchTime is null ? "还没启动过" : FormatTime(_cfg.LastLaunchTime))
            </div>
            @* v1.1.2：总时长改用热力图口径（PlayTimeService 全部年份的秒数总和） *@
            <div class="jg-stat-sub">
                @_cfg.TotalLaunchCount 次启动 · 共 @FormatHours(PlayTime.TotalSeconds)
            </div>
        </div>
    </div>

    @* ── v1.1.5：游玩时长热力图（GitHub contributions 风格）──
       数据只来自 PlayTimeService 的系统统计（游戏进程每 30s 自动累计），不做手动修改入口 *@
    <div class="jg-card jg-heat-card">
        <div class="jg-heat-head">
            <div class="jg-heat-title">@_heatYear 年共游玩 @FormatHours(_yearTotalSeconds)（@_yearDays 天）</div>
            @* v1.1.6：年份选择改通用下拉（复用 dropdownToggle 的 GSAP 弹性动画 + 遮罩点外收回）；
               jg-dd-right 让菜单右对齐（贴标题行右缘不超出卡片） *@
            <div class="jg-sort-dd jg-dd-right jg-heat-yeardd @(_heatDdOpen ? "open" : "")" data-dd="heatyear">
                <button class="jg-sort-trigger" @onclick="ToggleYearDd">
                    @_heatYear 年
                    <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <div class="jg-sort-menu">
                    @foreach (var y in _years)
                    {
                        var year = y;
                        <button class="jg-sort-item @(_heatYear == year ? "active" : "")" @onclick="() => PickYear(year)">@year 年</button>
                    }
                </div>
            </div>
            <div class="jg-dd-overlay" data-dd="heatyear" @(_heatDdOpen ? "open" : "") @onclick="CloseYearDd"></div>
        </div>
        <div class="jg-heat-scroll">
            <table class="jg-heat-grid">
                <tr>
                    <th class="jg-heat-wday"></th>
                    @foreach (var m in _monthLabels)
                    {
                        @* 月份标签绝对定位浮在列上方，不占表格列宽（占宽会周期性撑宽月份列，
                           小屏顶出横向滚动、大屏在 10/11/12 月处留大空隙）
                           v1.1.9：标签带 data-tip（该月总时长）+ data-month（junigrid.ui.js 据此圈出整月描边）；
                           无标签的占位列不渲染属性，避免属性存在选择器命中空值弹出空气泡 *@
                        <th class="jg-heat-month">
                            @if (m.Month is int heatMonth)
                            {
                                <span data-tip="@m.Tip" data-month="@heatMonth">@m.Text</span>
                            }
                            else
                            {
                                <span>@m.Text</span>
                            }
                        </th>
                    }
                </tr>
                @for (var r = 0; r < 7; r++)
                {
                    var row = r;
                    <tr>
                        <th class="jg-heat-wday">@WdayLabel(row)</th>
                        @for (var c = 0; c < _weeks.Count; c++)
                        {
                            var cell = _weeks[c][row];
                            <td>
                            @* v1.1.9：data-m 标记格子所属月份（含 future），月份标签悬停时 JS 据此圈出整月 *@
                            @if (cell.InYear && !cell.Future)
                            {
                                <span class="jg-heat-cell l@(cell.Level)" data-tip="@Tip(cell)" data-m="@cell.Month"></span>
                            }
                            else if (cell.InYear && cell.Future)
                            {
                                <span class="jg-heat-cell future" data-m="@cell.Month"></span>
                            }
                            @* 非本年的溢出格子（首列上年/末列下年）不渲染任何元素 —— GitHub 同款留白 *@
                            </td>
                        }
                    </tr>
                }
            </table>
        </div>
        @* v1.1.6：左下说明文字已删（颜色含义由图例 data-tip 承载） *@
        <div class="jg-heat-foot">
            @* v1.1.6：图例色块 hover 放大 + data-tip 胶囊提示显示该色对应时长档位
               （data-tip 全局委托自动生效，文案与 HeatCell.Level 阈值一一对应）*@
            <div class="jg-heat-legend">
                少
                <span class="jg-heat-cell l0" data-tip="没有游玩"></span>
                <span class="jg-heat-cell l1" data-tip="少于 1 小时"></span>
                <span class="jg-heat-cell l2" data-tip="1–2 小时"></span>
                <span class="jg-heat-cell l3" data-tip="2–4 小时"></span>
                <span class="jg-heat-cell l4" data-tip="4 小时以上"></span>
                多
            </div>
        </div>
    </div>
</div>

@code {
    private JuniGridConfig _cfg = new();
    private string? _smapiVersion;
    private string? _gameVersion;
    private int _totalModCount;
    private int _activeModCount;

    // ─── v1.1.5：热力图 ───
    private sealed record HeatCell(string Key, bool InYear, bool Future, long Seconds, int Month)
    {
        public int Level => Seconds <= 0 ? 0
            : Seconds < 3600 ? 1        // <1 小时
            : Seconds < 7200 ? 2        // 1–2 小时
            : Seconds < 14400 ? 3       // 2–4 小时
            : 4;                        // ≥4 小时
    }

    // v1.1.9：月份标签 —— 悬停 data-tip 显示该月总时长，data-month 驱动 JS 整月描边
    private sealed record HeatMonth(string Text, int? Month, string? Tip);

    private int _heatYear = DateTime.Now.Year;
    private List<int> _years = new();
    private List<List<HeatCell>> _weeks = new();   // 每列一周（周日→周六），7 行
    private List<HeatMonth> _monthLabels = new();  // 与周列对齐的月份表头
    private long _yearTotalSeconds;
    private int _yearDays;

    protected override void OnInitialized()
    {
        _cfg = Cfg.Current;

        if (string.IsNullOrWhiteSpace(_cfg.GamePath))
        {
            var detected = Game.DetectGamePath();
            if (!string.IsNullOrEmpty(detected))
            {
                _cfg.GamePath = detected;
                Cfg.Save(_cfg);
            }
        }

        _smapiVersion = Game.ProbeSmapiVersion(_cfg.GamePath);
        _gameVersion = Updater.GetGameVersion(_cfg.GamePath);

        // v1.1.6：全盘扫描移出 UI 线程 —— 首页只为取两个计数，旧版同步 Scan
        // 几百个 mod 的 manifest 会让首页切换明显卡顿；计数就位后再刷新一帧。
        _ = Task.Run(() =>
        {
            var mods = Mods.Scan(_cfg.GamePath);
            _totalModCount = mods.Count;
            _activeModCount = mods.Count(m => !m.Disabled);
            return InvokeAsync(StateHasChanged);
        });

        // v1.1.5：时长数据每 30s 可能被后台累计，订阅变化实时刷新热力图
        PlayTime.OnChanged += OnPlayChanged;
        RebuildHeat();
    }

    private void OnPlayChanged() => InvokeAsync(RebuildHeat);

    public void Dispose() => PlayTime.OnChanged -= OnPlayChanged;

    private void RebuildHeat()
    {
        var data = PlayTime.Snapshot;

        // 年份列表：首次使用 JuniGrid 的年份 → 今年 ∪ 有游玩记录的年份
        var firstYear = DateTime.TryParse(_cfg.FirstRunDate, out var fr) ? fr.Year : DateTime.Now.Year;
        var ys = new HashSet<int>();
        for (var y = firstYear; y <= DateTime.Now.Year; y++) ys.Add(y);
        foreach (var k in data.Keys)
            if (k.Length >= 4 && int.TryParse(k.AsSpan(0, 4), out var y)) ys.Add(y);
        _years = ys.OrderByDescending(x => x).ToList();

        // 列从「1 月 1 日所在周的周日」开始，铺到 12 月 31 日（GitHub 同款布局）
        var start = new DateTime(_heatYear, 1, 1);
        var d = start.AddDays(-((int)start.DayOfWeek));   // 回退到周日
        var end = new DateTime(_heatYear, 12, 31);
        var today = DateTime.Today;

        _weeks = new();
        var colMonths = new List<int?>();   // 每列要标的月份（与周列对齐），无标签为 null
        var monthNames = new[] { "", "1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月" };
        int lastMonth = -1;
        long total = 0;
        int days = 0;

        while (d <= end)
        {
            var col = new List<HeatCell>(7);
            int colMonth = -1;   // 本列第一个「年内」日期的月份（列头月份标签用）
            for (var i = 0; i < 7; i++)
            {
                if (d.Year == _heatYear) { if (colMonth < 0) colMonth = d.Month; }
                col.Add(new HeatCell(d.ToString("yyyy-MM-dd"), d.Year == _heatYear, d > today,
                    d.Year == _heatYear && d <= today && data.TryGetValue(d.ToString("yyyy-MM-dd"), out var s) ? s : 0, d.Month));
                d = d.AddDays(1);
            }
            _weeks.Add(col);

            // 月份标签：本月第一次出现的列才标，与 demo 同规则
            if (colMonth > 0 && colMonth != lastMonth)
            {
                colMonths.Add(colMonth);
                lastMonth = colMonth;
            }
            else colMonths.Add(null);
        }

        // v1.1.9：顺手按月汇总（月份标签悬停提示用）
        var monthTotals = new long[13];
        var monthDays = new int[13];
        foreach (var cell in _weeks.SelectMany(w => w))
        {
            if (cell.InYear && !cell.Future && cell.Seconds > 0)
            {
                total += cell.Seconds; days++;
                monthTotals[cell.Month] += cell.Seconds; monthDays[cell.Month]++;
            }
        }
        _yearTotalSeconds = total;
        _yearDays = days;

        _monthLabels = colMonths.Select(cm =>
        {
            if (cm is not int m) return new HeatMonth("", null, null);
            var name = monthNames[m];
            return new DateTime(_heatYear, m, 1) > today ? new HeatMonth(name, m, $"{name} 还没到")
                : monthTotals[m] > 0 ? new HeatMonth(name, m, $"{name} 共游玩 {FormatHours(monthTotals[m])}（{monthDays[m]} 天）")
                : new HeatMonth(name, m, $"{name} 没有游玩");
        }).ToList();
    }

    // ─── v1.1.6：年份下拉（通用 dropdownToggle GSAP 动画，遮罩点外收回）───
    private bool _heatDdOpen;

    private async Task ToggleYearDd()
    {
        _heatDdOpen = !_heatDdOpen;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-heat-yeardd", _heatDdOpen); } catch { }
    }

    private async Task CloseYearDd()
    {
        if (!_heatDdOpen) return;
        _heatDdOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-heat-yeardd", false); } catch { }
    }

    private async Task PickYear(int y)
    {
        _heatYear = y;
        await CloseYearDd();
        RebuildHeat();
    }

    private static string WdayLabel(int row) => row switch
    {
        1 => "一", 3 => "三", 5 => "五", _ => ""
    };

    // 悬停胶囊提示（data-tip 全局委托，动态格子也能用）
    private static string Tip(HeatCell cell) =>
        cell.Seconds > 0
            ? $"{Math.Round(cell.Seconds / 3600.0, 1)} 小时 · {cell.Key}"
            : $"没有游玩 · {cell.Key}";

    private static string FormatHours(long seconds) =>
        seconds <= 0 ? "0 小时" : (seconds / 3600.0).ToString("0.0") + " 小时";

    private static string FormatTime(string iso) =>
        DateTime.TryParse(iso, out var t) ? t.ToString("MM-dd HH:mm") : iso;
}

    private void GoTargetPackDetail(ContentOverrideTargets.TargetGroup t)
        => GoPackDetail(t.Active?.NexusModId, t.Active?.PackName ?? "");

    /// <summary>打开素材包文件夹：优先打开【完整原包】（下载时原样保留、结构不变的 mod 目录），
    /// 老账（没有原包记录）退回逐资产副本目录；都不存在就给一句实话。</summary>
    private void OpenPackFolder(ContentOverrideService.PackGroup p)
    {
        var packDir = p.Items.FirstOrDefault(r => r.PackDir.Length > 0)?.PackDir;
        if (packDir is not null)
        {
            var dir = ContentOverrideService.PackOriginalDir(GamePath, packDir);
            if (System.IO.Directory.Exists(dir)) { OpenFolderDir(dir); return; }
        }
        var storeId = p.Items.FirstOrDefault(r => r.StoreId.Length > 0)?.StoreId;
        if (storeId is null) { Toast(Loc.T("该包未保留文件副本")); return; }
        OpenFolderDir(ContentOverrideService.StoreDir(GamePath, storeId));
    }

    private void OpenFolderDir(string dir)
    {
        try
        {
            if (System.IO.Directory.Exists(dir))
                System.Diagnostics.Process.Start("explorer.exe", $"\"{dir}\"");
            else
                Toast(Loc.T("文件夹不存在，可能已被移动或删除"));
        }
        catch { }
    }

    private List<string> TargetCategories()
        => _targets.Select(t => t.Category).Distinct()
            .OrderBy(ContentOverrideTargets.CategoryOrder).ToList();

    private IEnumerable<ContentOverrideTargets.TargetGroup> VisibleTargets()
    {
        foreach (var t in _targets)
        {
            if (SearchText.Length > 0
                && !t.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                && !t.Sub.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
                continue;
            yield return t;
        }
    }


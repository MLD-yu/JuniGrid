    /// <summary>mod 详情页：有页号直接进；没页号（账本被抹过、或手装的包）不再只给一句
    /// 「无详情页」就完事 —— 那是一条走不通的死路。改成按包名打开 N 网搜索页，
    /// 并把下一步说清楚：找到那一页后把链接粘回来，页号一写回，详情页、封面、分类一起回来。</summary>
    private void GoPackDetail(int? page, string packName)
    {
        if (page is int id) { Nav.NavigateTo("/mod/" + id); return; }
        UpdateService.OpenUrl("https://www.nexusmods.com/stardewvalley/search/?gsearch="
            + Uri.EscapeDataString(packName));
        Toast(LocService.Tf("这个包没有记 N 网页号，已按包名「{0}」打开 N 网搜索页 —— "
            + "找到那一页后从那里重新安装一次，这个包就接回详情页与封面了", packName));
    }

    /// <summary>mod 详情页：有 N 网页号直接进；没页号就按包名去 N 网搜（见 <see cref="GoPackDetail"/>）。</summary>
    private void GoPackDetailPage(ContentOverrideService.PackGroup p) => GoPackDetail(p.NexusModId, p.PackName);


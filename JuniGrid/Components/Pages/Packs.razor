    // ───────────────────── 按对象：弹窗与逐版本应用 ─────────────────────

    private void OpenTarget(ContentOverrideTargets.TargetGroup t)
    {
        _openTarget = t;
        _tVariantKey = "";        // 形象选择跟着对象走，不跨对象残留
        // 弹窗里的版本缩略图按需排产（原版 + 各包副本），后台生成完 Changed 会刷新
        _ = Task.Run(() =>
        {
            var gp = GamePath;
            var jobs = new List<(string, PackThumbService.Kind)>();
            foreach (var asset in t.Assets)
            {
                var kind = PackThumbService.KindOf(asset);
                var v = ContentOverrideTargets.VanillaSource(gp, asset);
                if (v is not null) jobs.Add((v, kind));
                foreach (var ver in t.Versions)
                {
                    var s = ContentOverrideTargets.VersionSource(gp, ver.ToList(), asset);
                    if (s is not null) jobs.Add((s, kind));
                }
            }
            PackThumbService.Prewarm(jobs);
        });
    }

    private void PickVariant(string key, string variant)
    {
        _tVariantKey = key;
        _tVariant = variant;
    }

    /// <summary>把指定那几张资产盖成 slot（null = 退回原版）。逐资产走 SetEnabled：同一张图同时
    /// 只能有一个版本在位，新版本上位时兄弟版本自动转关 —— 这就是"几十张肖像的包可以一个 NPC
    /// 一个 NPC 地挑"的实现。盖的范围由调用方给：单击给当前形象那几张，长按给全部形象。</summary>
    private async Task ApplyAssets(ContentOverrideTargets.TargetGroup t, string? slot,
        List<string> assets, string okToast)
    {
        if (_busy) return;
        _busy = true;
        var gp = GamePath;
        string? err = null;
        var applied = 0;
        await Task.Run(() =>
        {
            foreach (var asset in assets)
            {
                ContentOverrideRecord? r = slot is null
                    ? t.Records.FirstOrDefault(x => x.Enabled
                        && x.Asset.Equals(asset, StringComparison.OrdinalIgnoreCase))
                    : t.Records.FirstOrDefault(x => x.Slot.Equals(slot, StringComparison.OrdinalIgnoreCase)
                        && x.Asset.Equals(asset, StringComparison.OrdinalIgnoreCase));
                if (r is null) continue;
                // 界面上的一行 = 一张图的全部文件（基名 + 这个包账上的语言副本）。
                // 只动基名那张的话，中文客户端读的还是 .zh-CN 那份，
                // 症状就是"这包关掉了却还有半包没还原"。
                foreach (var file in ContentOverrideService.SlotSiblings(Cfg, r.Slot, r.Asset))
                {
                    var one = ContentOverrideService.SetEnabled(Cfg, gp,
                        ContentOverrideService.KeyOf(file, r.Slot), slot is not null);
                    if (one is not null) err = one;
                    else applied++;
                }
            }
        });
        if (err is not null) Toast(err);
        else if (slot is null && applied == 0) { /* 本来就是原版，点了等于没点 —— 不弹成功谎报 */ }
        else Toast(okToast);
        Reload();
        _openTarget = _targets.FirstOrDefault(x => x.Key == t.Key);
        _busy = false;
        StateHasChanged();
    }

    private string ScopeToast(ContentOverrideTargets.TargetGroup t, string? slot, string scope)
    {
        if (slot is null) return Loc.F("已把「{0}」还原为原版", scope);
        var pack = ContentOverrideTargets.DisplayPack(t.Records.First(r =>
            r.Slot.Equals(slot, StringComparison.OrdinalIgnoreCase)));
        return Loc.F("已把「{0}」换成「{1}」", scope, pack);
    }

    /// <summary>长按 = 这个对象的全部形象都用它。</summary>
    private Task ApplyVersion(ContentOverrideTargets.TargetGroup t, string? slot)
        => ApplyAssets(t, slot, t.Assets, ScopeToast(t, slot,
            t.VariantCount > 1 ? Loc.F("{0} 的全部 {1} 个形象", t.Name, t.VariantCount) : t.Name));

    /// <summary>单击 = 只换当前形象。与立绘页相反：那边轻点就是全季统一，长按才固定到当季。</summary>
    private Task ApplyVariant(ContentOverrideTargets.TargetGroup t, string? slot, string variant)
        => ApplyAssets(t, slot, t.AssetsOf(variant), ScopeToast(t, slot,
            t.VariantCount > 1 ? Loc.F("{0} 的「{1}」形象", t.Name, Loc.T(variant)) : t.Name));

    /// <summary>这一行那个包里，某张目标是否还有别的配色可换（有就给出全部版本，含在位那个）。</summary>
    private static List<(string Asset, string Label, bool Active)> ColorChips(List<ContentOverrideRecord> recs)
    {
        var list = new List<(string Asset, string Label, bool Active)>();
        foreach (var r in recs.Where(r => r.Variants.Count > 1))
            list.AddRange(r.Variants.Select(v => (r.Asset, v,
                string.Equals(v, r.VariantLabel, StringComparison.Ordinal))));
        return list;
    }

    /// <summary>换配色：拿原包备份里那一版，按<b>当前</b>本体重编一份盖上去（一张表只有一份在位，
    /// 所以是换不是加）。账上那条记录不新增，只换 <c>VariantLabel</c> 与副本。</summary>
    private async Task PickColor(string what, string slot, string asset, string label)
    {
        if (_busy) return;
        _busy = true;
        var gp = GamePath;
        string? err = null;
        await Task.Run(() => err = ContentOverrideService.SwitchVariant(Cfg, gp, asset, slot, label));
        if (err is not null) Toast(err);
        else Toast(Loc.F("已把「{0}」换成配色「{1}」", what, label));
        Reload();
        // 重扫之后把弹窗指回"同一个包 / 同一个对象"，不然换完配色弹窗会跳没
        _open = _groups.FirstOrDefault(x => x.Slot == slot);
        _openTarget = _targets.FirstOrDefault(x => x.Key == _openTarget?.Key);
        _busy = false;
        StateHasChanged();
    }

    /// <summary>一个记录的配色清单。老记录（加 VariantFacts 之前装的）只有名字没有说明，
    /// 照样要能筛能换，所以按名字补一份空说明。</summary>
    private static List<ContentOverrideVariant> FactsOf(ContentOverrideRecord r)
        => r.VariantFacts.Count == r.Variants.Count
            ? r.VariantFacts
            : r.Variants.Select(v => new ContentOverrideVariant(v, "")).ToList();

    /// <summary>这张资产【安装当时】留下的尺寸说明；没有则 null。
    /// <para>说明原本是整包一份、抄到包里每条记录上的（<c>ResizedNote</c>），界面按它逐行再渲染一批
    /// 卡片 —— 于是"装上了但比本体高/矮"的那批图一包里出现两遍：一次正常行、一次备注行，
    /// 右边那颗胶囊还写着状态，看着像两张不同的图（用户 2026-10-07：为什么有两个玛鲁沙滩图）。
    /// 现在说明并回它自己那一行的小字，备注栏只留对不上记录的。</para></summary>
    private static string? ResizedNoteFor(ContentOverrideService.PackGroup p, ContentOverrideRecord rec)
    {
        foreach (var rz in ParseResized(p))
            if (rz.Reason.Length > 0 && SameRow(RecordFor(p, rz), rec))
                return rz.Reason;
        return null;
    }

    /// <summary>这条备注认领的那条记录，和界面上这一行是不是【同一张图】。
    /// 按基名比：语言副本并成一行之后，行是基名那条，而包里那 11 份副本各自留过自己的
    /// 尺寸备注 —— 只比整名的话那些备注会掉进兜底栏，又变成同一张图列两遍
    /// （<see cref="ResizedNoteFor"/> 上面记的就是这个已经修过的坑）。</summary>
    private static bool SameRow(ContentOverrideRecord? a, ContentOverrideRecord? b)
        => a is not null && b is not null
           && ContentOverrideService.LocaleBase(a.Asset).Equals(
               ContentOverrideService.LocaleBase(b.Asset), StringComparison.OrdinalIgnoreCase);

    /// <summary>这条尺寸备注是否已经被某个显示行认领了。记录都没了（被还原过 / 删过账）的
    /// 返回 false —— 那种还得单独留一行，不然这件事就彻底没人说了。</summary>
    private static bool RowCovers(ContentOverrideService.PackGroup p, ContentOverrideRecord? rec)
        => rec is not null && p.ImageItems.Any(r => SameRow(r, rec));


    // ───────────────────── 按包：原有逻辑 ─────────────────────

    private static string PackName(ContentOverrideService.PackGroup g)
        => string.IsNullOrWhiteSpace(g.PackTitle) ? g.PackName : g.PackTitle;

    private string CategoryOf(ContentOverrideService.PackGroup g)
        => string.IsNullOrWhiteSpace(g.Category) ? Loc.T(Uncat) : g.Category;

    private List<string> CategoryList()
        => _groups.Select(CategoryOf).Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x == Loc.T(Uncat))
            .ThenBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();

    private int CountIn(string bucket) => _groups.Count(x => CategoryOf(x) == bucket);

    /// <summary>卡片组件的 OnOpen 只回传一个 int，而这类包没有 Mods 目录可当身份 ——
    /// 就用【这一屏列表里的序号】当 id，点开时按同一个序号映射回包。Reload 会重建这个顺序，
    /// 卡片与 _groups 始终出自同一次计算，所以不会串到别的包上。</summary>
    private NexusModListEntry CardFor(ContentOverrideService.PackGroup g)
    {
        var on = g.ImageItems.Count(r => r.Enabled);
        var bits = new List<string> { Loc.F("{0} 个图像文件", g.ImageItems.Count) };
        // 全关掉时直接说「已还原」，而不是留一张看不出区别的卡：角标已经没了，
        // 摘要里再不算数的话，人分不清"这包没装"和"这包装了但被我关了"。
        if (on == 0) bits.Add(Loc.T("已还原"));
        else if (on != g.ImageItems.Count) bits.Add(Loc.F("已运用 {0}", on));
        if (g.DriftedCount > 0) bits.Add(Loc.F("{0} 个文件已失效", g.DriftedCount));
        if (g.VanillaCount > 0) bits.Add(Loc.F("{0} 个文件已还原为原版", g.VanillaCount));
        // 版本戳与当前本体不同时必须在卡面上就说出来：这包的字节是别的版本编的，
        // 打开时走的是"照当前本体重编"那条路，不是回放。
        if (g.StampedVersion.Length > 0 && !g.StampedVersion.Equals(_curVer, StringComparison.OrdinalIgnoreCase))
            bits.Add(Loc.F("记录于 {0}", g.StampedVersion));
        if (g.Skipped > 0) bits.Add(Loc.F("{0} 个文件不适配", g.Skipped));
        return new NexusModListEntry(Math.Max(0, _groups.IndexOf(g)), PackName(g),
            string.Join(" · ", bits), "", 0, g.PackCover,
            Category: string.IsNullOrWhiteSpace(g.Category) ? null : g.Category);
    }

    private void OnCardOpen(int id)
    {
        _menuSlot = null;   // 开着菜单点卡面 = 进详情，菜单顺手收掉
        if (id >= 0 && id < _groups.Count) _open = _groups[id];
        // 详情行的逐图缩略图按需排产，后台生成完 Changed 会刷新。
        // 只排显示出来的那些行 —— 一个 1554 份文件的包，语言副本与文本表都不在这一屏里，
        // 照 Items 排队就是一千多个解不开的解码任务。
        if (_open is null) return;
        var jobs = new List<(string, PackThumbService.Kind)>();
        foreach (var r in _open.ImageItems)
        {
            var src = ContentOverrideService.PackImageSource(GamePath, r);
            if (src is not null && System.IO.File.Exists(src)) jobs.Add((src, PackThumbService.KindOf(r.Asset)));
        }
        if (jobs.Count > 0) _ = Task.Run(() => PackThumbService.Prewarm(jobs));
    }

    private async Task TogglePack(ContentOverrideService.PackGroup p)
    {
        if (_busy) return;
        _busy = true;
        var gp = GamePath;
        var turnOn = !p.AnyOn;
        await Task.Run(() =>
        {
            try
            {
                var err = ContentOverrideService.SetPackEnabled(Cfg, gp, p.Slot, turnOn);
                if (err is not null) Toast(err);
            }
            catch (Exception ex) { Toast(LocService.Tr("操作失败：") + ex.Message); }
        });
        Reload();
        _open = _groups.FirstOrDefault(g => g.Slot == p.Slot);
        _busy = false;
        StateHasChanged();
    }

    private async Task DeletePack(ContentOverrideService.PackGroup p)
    {
        if (_busy) return;
        _busy = true;
        var gp = GamePath;
        await Task.Run(() =>
        {
            try
            {
                // 盘上那张是别人放的 ⇒ 服务层会拒绝删账（删了就成了"界面没这个包、本体躺着无主图"），
                // 这话必须传到用户耳朵里，不能只是静默地"没删掉"。
                var err = ContentOverrideService.DeletePack(Cfg, gp, p.Slot);
                if (err is not null) Toast(err);
            }
            catch (Exception ex) { Toast(LocService.Tr("删除失败：") + ex.Message); }
        });
        _open = null;
        if (_groups.Count == 0) _cat = "";
        Reload();
        _busy = false;
        StateHasChanged();
    }

    private async Task OnRevertAll()
    {
        if (_busy) return;
        _busy = true;
        var gp = GamePath;
        await Task.Run(() =>
        {
            try
            {
                var (n, held) = ContentOverrideService.RevertAll(Cfg, gp);
                Toast(held > 0
                    ? Loc.F("已还原 {0} 个文件；另有 {1} 个文件当前为外部写入，未作覆盖", n, held)
                    : Loc.F("已还原 {0} 个图像文件", n));
            }
            catch (Exception ex) { Toast(LocService.Tr("还原失败：") + ex.Message); }
        });
        Reload();
        _openTarget = null;
        _busy = false;
        StateHasChanged();
    }

    /// <summary>账外资产在界面上的名字 = 资产路径最后一段（Abigail），hover 给全路径。
    /// 与上面卡片"hover 看全名"同一套手势。</summary>
    private static string StrayName(string asset) => asset.Contains('/') ? asset[(asset.LastIndexOf('/') + 1)..] : asset;

    /// <summary>分类名与封面从 N 网各补一次再写回记录，之后离线也认得。
    /// 只有带页号的包补得到；没页号的留在「未分类」，不拿包名去猜一个分类 ——
    /// 猜错的话人会在错的分类底下找不着自己的包。</summary>
    private async Task EnsureMetaAsync()
    {
        var need = Cfg.Current.ContentOverrides.Values
            .Where(v => v.NexusModId is int
                && (string.IsNullOrEmpty(v.CategoryName) || string.IsNullOrEmpty(v.PackTitle)
                    || string.IsNullOrEmpty(v.PackCover)))
            .GroupBy(v => v.Slot, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First()).ToList();
        foreach (var rec in need)
        {
            NexusModInfo? info;
            try { info = await Nexus.GetModAsync(rec.NexusModId!.Value); }
            catch { continue; }
            if (info is null) continue;
            var changed = false;
            // 名字与封面各判各的：原来的写法把封面赋值嵌在【PackTitle 为空】里面，
            // 于是"有名字、缺封面"的包（旧版本写下的记录就是这样）永远轮不到补封面，
            // 卡片会一直停在字母块上 —— 而界面看起来像是 N 网图挂了。
            if (string.IsNullOrEmpty(rec.PackTitle) && !string.IsNullOrWhiteSpace(info.Name))
            {
                foreach (var s in Cfg.Current.ContentOverrides.Values.Where(v => v.Slot == rec.Slot))
                    s.PackTitle = info.Name;
                changed = true;
            }
            if (string.IsNullOrEmpty(rec.PackCover) && !string.IsNullOrWhiteSpace(info.PictureUrl))
            {
                // 同一包的所有记录一起写：卡片取的是分组里第一条，而"第一条"由 Groups 的排序决定，
                // 未必是这里循环拿到的那条 —— 只写 rec 的话封面可能落在一张不显示的记录上。
                foreach (var s in Cfg.Current.ContentOverrides.Values.Where(v => v.Slot == rec.Slot))
                    s.PackCover = info.PictureUrl;
                changed = true;
            }
            if (string.IsNullOrEmpty(rec.CategoryName) && info.CategoryId is int cid
                && Cfg.Current.NexusCategories.TryGetValue(cid, out var cname))
            {
                foreach (var s in Cfg.Current.ContentOverrides.Values.Where(v => v.Slot == rec.Slot))
                    s.CategoryName = cname;
                changed = true;
            }
            if (!changed) continue;
            Cfg.Save(Cfg.Current);
            Reload();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Toast(string msg)
    {
        _toast = msg;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ =>
            _ = InvokeAsync(() => { _toast = null; StateHasChanged(); }),
            null, 3200, System.Threading.Timeout.Infinite);
    }

    // ───────────────────── 长按使用 / 点击放大 ─────────────────────
    //
    // 版本行的手势分工：按住不动 480ms = 盖上这个版本（行上有充能条动画，时长一致），
    // 提前松手 = 点开大图。click 在 pointerup 之后必然触发，所以长按成功后要吞掉
    // 紧跟着的那一下 click，否则盖完版本还会弹一次大图。

    private const int LongPressMs = 480;
    private string? _pressKey;                  // 正在按下的行（CSS 充能条跟着它走）
    private CancellationTokenSource? _pressCts;
    private bool _skipNextClick;                // 长按已触发 ⇒ 松开那一下的 click 不是"看大图"
    private DateTime _lastLongPressUtc;         // 兜底：button 被 disabled 后 click 可能不触发，靠时间窗再挡一次

    // ── 大图弹层状态：自包含（标题/副题/说明/使用动作），对象版本与包内单图共用一套 ──
    private string _lbTitle = "";
    private string _lbSub = "";
    private string? _lbNote;                    // 没有图可显示时的说明（不适配原因等）
    private bool _lbActive;                     // 显示「使用中」胶囊（此时不出使用按钮）
    private string _lbApplyLabel = "";
    private Func<Task>? _lbApply;               // null = 不提供使用动作（不适配的图只能看）
    private List<LbImage>? _lbImages;

    private sealed record LbImage(string Label, string Path, PackThumbService.Kind Kind);

    /// <summary>大图弹层副题的手势提示已删（2026-10-07 他要求）：滚轮缩放现在不需要按 Ctrl，
    /// 拖动/双击也不用教 —— 弹层里能滚能拖是默认预期，写出来反而像说明书。</summary>
    private static bool IsFontAsset(string asset)
        => asset.StartsWith("Fonts/", StringComparison.OrdinalIgnoreCase);

    /// <summary>字体大图后面挂的那句免责。为什么必须留：这张图是【所有字形平铺的一张表】，
    /// 不是游戏里某句话的样子，而且游戏会把文字染成 UI 颜色 —— 不写这句，人拿这张表去
    /// 对游戏里的字，对不上就成了"你解错了"。
    /// ⚠ 措辞里【不写 DXT5】：实测字体图集是 BC4 单通道遮罩，按 DXT5 整块解出来是彩色雪花。</summary>
    private string LbFontNote(string asset)
        => IsFontAsset(asset)
            ? " · " + Loc.T("字体预览为整张字形表，由图集遮罩解码生成，实际效果以游戏内显示为准")
            : "";

    private void PressStart(string key, Func<Task> apply)
    {
        if (_busy) return;
        _pressCts?.Cancel();
        _pressKey = key;
        var cts = new CancellationTokenSource();
        _pressCts = cts;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(LongPressMs, cts.Token);
                _skipNextClick = true;
                _lastLongPressUtc = DateTime.UtcNow;
                await InvokeAsync(async () =>
                {
                    if (_pressKey == key) _pressKey = null;
                    await apply();
                });
            }
            catch (TaskCanceledException) { /* 提前松手 = 想看大图，不是想用 */ }
        });
    }

    private void PressEnd(string key)
    {
        if (_pressKey == key) _pressKey = null;
        _pressCts?.Cancel();
    }

    private void PressCancel(string key) => PressEnd(key);

    private void RowClick(Action open)
    {
        if (_skipNextClick) { _skipNextClick = false; return; }
        if ((DateTime.UtcNow - _lastLongPressUtc).TotalMilliseconds < LongPressMs + 250) return;
        open();
    }

    /// <summary>对象弹窗里点缩略图 → 大图（原版 slot = null），只看【当前形象】那几张。
    /// 在位的版本只给「使用中」胶囊，不再出使用按钮 —— 对同一个版本再盖一次是空操作，
    /// 出了按钮只会换来一句谎报。</summary>
    private void OpenTargetLightbox(ContentOverrideTargets.TargetGroup t, string? slot, string variant)
    {
        var gp = GamePath;
        var person = ContentOverrideTargets.IsPerson(t.Assets[0]);
        var assets = t.AssetsOf(variant);
        List<ContentOverrideRecord>? recs = null;
        if (slot is not null)
        {
            var group = t.Versions.FirstOrDefault(g => g.Key.Equals(slot, StringComparison.OrdinalIgnoreCase));
            if (group is null) return;
            recs = group.ToList();
        }
        var onNow = t.ActiveOf(variant);
        _lbTitle = slot is null ? Loc.T("原版") : ContentOverrideTargets.DisplayPack(recs![0]);
        _lbSub = t.Name + (t.VariantCount > 1 ? " · " + Loc.T(variant) : "") + " · " + Loc.T(t.Sub)
            + LbFontNote(t.Assets.FirstOrDefault() ?? "");
        _lbNote = null;
        _lbActive = slot is null ? onNow is null
            : onNow is not null && onNow.Slot.Equals(slot, StringComparison.OrdinalIgnoreCase);
        // 弹层里的「使用」只管当前形象 —— 人在这儿看的就是这一张，别替他改全部
        _lbApply = _lbActive ? null : () => ApplyVariant(t, slot, variant);
        _lbApplyLabel = slot is null ? Loc.T("还原为原版") : Loc.T("使用这个版本");
        _lbImages = new List<LbImage>();
        foreach (var asset in assets)
        {
            var src = slot is null
                ? ContentOverrideTargets.VanillaSource(gp, asset)
                : ContentOverrideTargets.VersionSource(gp, recs!, asset);
            if (src is null) continue;
            var kind = PackThumbService.KindOf(asset);
            var label = person
                ? (kind == PackThumbService.Kind.Portrait ? Loc.T("立绘") : Loc.T("行走图"))
                : System.IO.Path.GetFileNameWithoutExtension(asset);
            _lbImages.Add(new LbImage(label, src, kind));
        }
        _ = Task.Run(() => PackThumbService.Prewarm(_lbImages.Select(i => (i.Path, i.Kind)), large: true));
    }

    /// <summary>包详情里的单张图 → 大图。使用动作是【这张图的开/关】（Toggle），
    /// 标签跟着当前状态走；在位的图一样给按钮 —— 对单图来说"还原"是有意义的动作。</summary>
    private void OpenPackItemLightbox(ContentOverrideService.PackGroup p, ContentOverrideRecord r)
    {
        var kind = PackThumbService.KindOf(r.Asset);
        // 副本与"账上记的那个原包备份"两处都找（判据见 PackImageSource）：只认 StoreId 的话，
        // 从盘上认回来的那些关着的行会被报成"副本已不在磁盘上"，而图其实就在 asset-packs 里。
        var src = ContentOverrideService.PackImageSource(GamePath, r);
        _lbTitle = r.Asset[(r.Asset.LastIndexOf('/') + 1)..];
        _lbSub = r.Asset + LbFontNote(r.Asset);
        _lbImages = new List<LbImage>();
        if (src is not null && System.IO.File.Exists(src))
            _lbImages.Add(new LbImage(Loc.T("包里的图"), src, kind));
        _lbNote = _lbImages.Count == 0 ? Loc.T("该副本文件已不在磁盘上，无法预览。") : null;
        _lbActive = false;   // 单图不摆「使用中」胶囊：按钮文案（使用/还原）已经把状态说清了
        _lbApplyLabel = r.Enabled ? Loc.T("还原此图像") : Loc.T("应用此图像");
        _lbApply = () => TogglePackAsset(p, r);
        if (_lbImages.Count > 0)
            _ = Task.Run(() => PackThumbService.Prewarm(_lbImages.Select(i => (i.Path, i.Kind)), large: true));
    }

    /// <summary>不适配的图 → 大图。安装当时副本就没留下来，只能给原因；
    /// 没有使用动作（按钮不出现），但弹层/缩放手势与其他图完全一致。</summary>
    private void OpenSkipLightbox(SkipItem sk)
    {
        _lbTitle = sk.Name;
        _lbSub = Loc.T("此文件未安装 · 仅可查看");
        _lbImages = new List<LbImage>();
        _lbNote = sk.Reason.Length > 0 ? sk.Reason
            : Loc.T("安装时未匹配到游戏本体，没有可预览的图像。");
        _lbActive = false;
        _lbApply = null;
    }

    private void CloseLightbox()
    {
        _lbImages = null;
        _lbApply = null;
        _lbNote = null;
    }

    private async Task ApplyFromLightbox()
    {
        var apply = _lbApply;
        CloseLightbox();
        if (apply is not null) await apply();
    }

    // ───────────────────── 包详情：逐图开关与不适配项 ─────────────────────

    /// <summary>长按包内一张图：盖上（开着 → 还原回原版）。逐资产走 SetEnabled，
    /// 与对象弹窗的"一个版本上位、兄弟转关"是同一套规矩。
    /// <para>动的是【这一行代表的那张图】的全部文件 —— 基名加上这个包账上的语言副本，
    /// 一次点完 12 份。只动基名的话中文客户端读的还是另一份。</para></summary>
    private async Task TogglePackAsset(ContentOverrideService.PackGroup p, ContentOverrideRecord r)
    {
        if (_busy) return;
        _busy = true;
        var gp = GamePath;
        // 开关跟着这一行【显示】的状态走（整组算出来的），不跟着基名那一条的 Enabled：
        // 基名关着而语言副本还盖着时，这一行显示的就是"在位"，长按它该是全关掉。
        var turnOn = ContentOverrideService.ImageGroupState(gp, Cfg, r.Slot, r.Asset)
                     != ContentOverrideService.OverrideState.InPlace;
        string? err = null;
        var done = 0;
        await Task.Run(() =>
        {
            foreach (var f in ContentOverrideService.SlotSiblings(Cfg, r.Slot, r.Asset))
            {
                var one = ContentOverrideService.SetEnabled(Cfg, gp,
                    ContentOverrideService.KeyOf(f, r.Slot), turnOn);
                if (one is not null) { err = one; break; }
                done++;
            }
        });
        var what = done > 1 ? Loc.F("{0}（{1} 个文件）", r.Asset, done) : r.Asset;
        Toast(err ?? (turnOn ? Loc.F("已盖上：{0}", what) : Loc.F("已还原：{0}", what)));
        Reload();
        _open = _groups.FirstOrDefault(g => g.Slot == p.Slot);
        _busy = false;
        StateHasChanged();
    }

    /// <summary>不适配条目（安装时留在账上的 SkippedNote 逐行解析）：文件名 + 原因。
    /// 也用于解析 ResizedNote —— 那批是"装上了但尺寸不同"，结构与不适配条目完全一样
    /// （都写成"文件名：说明"），所以共用一个 record，只是渲染样式不同。</summary>
    private sealed record SkipItem(string Name, string Reason);

    private static List<SkipItem> ParseSkips(ContentOverrideService.PackGroup p) => ParseNote(p.SkippedNote);

    private static List<SkipItem> ParseResized(ContentOverrideService.PackGroup p) => ParseNote(p.ResizedNote);

    /// <summary>「尺寸不同」栏的一条备注 → 账上对应的那张图。备注里带着完整资产路径
    /// （"游戏的 Portraits/Alex_Winter 是 128×384"），退一步再按文件名比。找不到就是账上
    /// 真没这张了（被还原/记录被删），那一行只留当初的说明。</summary>
    private static ContentOverrideRecord? RecordFor(ContentOverrideService.PackGroup p, SkipItem rz)
        => ContentOverrideTargets.RecordForNote(p.Items, rz.Name, rz.Reason);

    private static List<SkipItem> ParseNote(string note)
    {
        var list = new List<SkipItem>();
        foreach (var line in note.Split('\n',
                     StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var i = line.IndexOf('：');
            list.Add(i > 0 ? new SkipItem(line[..i], line[(i + 1)..]) : new SkipItem(line, ""));
        }
        return list;
    }
}

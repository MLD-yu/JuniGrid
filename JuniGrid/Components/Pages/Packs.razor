    private void SetView(string v) { _view = v; _menuSlot = null; }    private void GoNexus() => Nav.NavigateTo("nexus");
    private void SetCat(string c) { _cat = c; }

    /// <summary>切版本桶。分类 chips 是渲染期过滤，版本桶是 <c>Reload</c> 里过滤的
    /// （对象视图也要跟着换桶，就得重算一次），所以这里必须重跑 Reload，
    /// 否则点了 chips 列表一动不动。</summary>
    private void SetVer(string v)
    {
        _ver = v;
        _menuSlot = null;
        Reload();
    }

    /// <summary>一条账属不属于"当前这一版"。版本空白 = 老账且原版在哪一层都查不出来，
    /// 按当前版本处理（它当初就是照着当时那副本体编的，而那副本体如今就是现役本体）；
    /// 只有明确记着别的版本戳的才算旧账。</summary>
    private bool RecCur(ContentOverrideRecord r)
        => r.Version.Length == 0 || r.Version.Equals(_curVer, StringComparison.OrdinalIgnoreCase);

    /// <summary>一个包进哪一桶看它【每一行】的戳：重编是按行发生的，
    /// 同一个包里出现两种戳时两桶都该看得见它，而不是替它挑一个。</summary>
    private bool VerMatch(ContentOverrideService.PackGroup g)
        => _ver switch
        {
            "all" => true,
            "cur" => g.Items.Any(RecCur),
            _ => g.Items.Any(r => !RecCur(r)),
        };

    private int CurCount() => _all.Count(g => g.Items.Any(RecCur));
    private int OtherCount() => _all.Count(g => g.Items.Any(r => !RecCur(r)));

    /// <summary>只有一个版本时这排 chips 纯属噪音（切了也没东西变），所以只在账上真出现
    /// 第二个版本戳时才出来 —— 版本分层是为了"切过版本之后看得清"，不是为了多一排按钮。</summary>
    private bool ShowVerChips => OtherCount() > 0;

    /// <summary>字体卡第一行：这张卡盖的到底是哪张资产（SmallFont 与它的 zh-CN 变体不是一张图）。</summary>
    private static string FontAssetPath(ContentOverrideTargets.TargetGroup t)
        => t.Assets.FirstOrDefault() ?? t.Name;

    /// <summary>字体卡第二行，只摆能核对的事实：
    /// 「整份替换」= 字体不比像素尺寸，整个文件换掉（与图类覆盖的机制差别，值得说清）；
    /// 「N 个语言变体」= 中文客户端读的是 <名>.zh-CN 那一张，而我们只换基名 ⇒ 装了可能看不见。
    /// 这条是字体包"没效果"的头号原因，摆在卡面上比藏在弹窗里有用。</summary>
    private string FontFacts(ContentOverrideTargets.TargetGroup t)
    {
        var asset = FontAssetPath(t);
        var sib = string.IsNullOrWhiteSpace(GamePath) || asset.Length == 0
            ? 0 : ContentOverrideService.LocaleSiblings(GamePath, asset).Count;
        return sib > 0
            ? Loc.T("整份替换") + " · " + Loc.F("{0} 个语言变体", sib)
            : Loc.T("整份替换");
    }

    /// <summary>版本行下面那行小字。账上记的版本不是当前本体那一版时要说出来 ——
    /// 长按它不会回放旧字节，而是拿原包对当前本体重编一遍（不说的话，人只会奇怪
    /// "为什么点一下要等"或"为什么这张和截图上不一样"）。</summary>
    private string RowSub(ContentOverrideRecord r)    {
        var s = (r.Encoded ? "PNG→XNB" : "XNB") + " · "
            + (r.Enabled ? Loc.T("长按可还原此图像") : Loc.T("长按可应用此图像"));
        if (r.Version.Length > 0 && !r.Version.Equals(_curVer, StringComparison.OrdinalIgnoreCase))
            s += " · " + Loc.F("记录于 {0}，启用前将按当前版本重新编码", r.Version);
        return s;
    }

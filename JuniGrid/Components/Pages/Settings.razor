@code {
    private SteamProfile _steam = SteamProfile.None;

    /// <summary>关于卡片里的交流群：与新手引导共用同一份清单（改号只改这里和 WelcomeGuide）。</summary>
    private static readonly (string Tag, string Number)[] QqGroups =
    {
        ("1 群", "327685379"),
        ("2 群", "631232833"),
        ("3 群", "817276781"),
    };

    // i18n：语言下拉（复用 .jg-sort-dd 结构 + dropdownToggle 的 GSAP 动画）。
    // 选中 → 持久化并触发 Loc.OnChanged，本页就地重渲染。
    private bool _langOpen;
    private async Task ToggleLang()
    {
        _langOpen = !_langOpen;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-lang-dd", _langOpen); } catch { }
    }
    private async Task CloseLang()
    {
        if (!_langOpen) return;
        _langOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-lang-dd", false); } catch { }
    }
    private async Task PickLang(string lang)
    {
        _langOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-lang-dd", false); } catch { }
        Loc.SetLang(lang);
    }

    private void OnLocChanged() => InvokeAsync(StateHasChanged);

    // 颜色主题：data-accent 是纯 CSS 变量轴，切换即时全站重上色（无需重载/重渲染）。
    // "system" 用 Windows 系统色作强调色、按钮保持中性；其余走 base.css 主题块。
    private string SystemHex => JuniGrid.App.GetSystemAccentHex() ?? "#7aa2ff";

    private static readonly (string Key, string Zh, string En, string Accent)[] Accents =
    {
        ("system",    "默认",   "Default",   ""),
        ("forest",    "森林绿", "Forest",    "#2f9e5c"),
        ("mint",      "薄荷青", "Mint",      "#12a0a0"),
        ("honey",     "蜂蜜金", "Honey",     "#e0a512"),
        ("parchment", "羊皮纸", "Parchment", "#b07b45"),
        ("sky",       "天蓝",   "Sky",       "#2f80d8"),
        ("rose",      "玫红",   "Rose",      "#dd4a72"),
        ("violet",    "紫罗兰", "Violet",    "#7c3aed"),
    };

    private async Task SetAccent(string key, MouseEventArgs e)
    {
        var c = Cfg.Current;
        if (string.Equals(c.Accent, key, StringComparison.OrdinalIgnoreCase)) return;
        c.Accent = key;
        Cfg.Save(c);

        // 先让选中描边落到新卡片上（下一次渲染批次），再让 JS 拍「旧画面」快照 ——
        // 否则旧快照里描边还在老卡片，波形铺完的瞬间会跳一下。16ms ≈ 一帧。
        StateHasChanged();
        await Task.Delay(16);

        try
        {
            // 带点击坐标 ⇒ 圆形从按下去的那一点扩散；JS 侧不支持 View Transitions 时自动退化为瞬间切换
            var accentHex = await JS.InvokeAsync<string>("junigridJs.applyAccentWave",
                key, SystemHex, e.ClientX, e.ClientY);
            MainWindow.ApplyAccent(accentHex);
        }
        catch { }
        StateHasChanged();   // 兜底刷新选中态描边
    }
    private string _nexusName = "";
    private string? _nexusAvatar;
    private bool   _nexusPremium;
    private bool   _sponsorWechat = true;
    private bool   _showForgotQr;          // 关于页的「忘记备注」二维码弹窗

    private void OpenForgotQr() => _showForgotQr = true;
    private void CloseForgotQr() => _showForgotQr = false;

    private void NexusLogout()
    {
        OAuth.Logout();   // 清空 OAuth2 令牌、已挂载的 Bearer 以及缓存的账号字段
        _nexusName = ""; _nexusAvatar = null; _nexusPremium = false;
        _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("已退出 Nexus 登录"));
        StateHasChanged();
    }

    // ─── Steam 下载授权（左账密 / 右扫码 并排；任何时刻只有一路活着）───
    private bool _ddQrOpen;
    private bool _ddQrBusy;      // 扫码那路在跑
    private bool _ddQrFailed;    // 扫码那路以失败告终（非被切走）→ 只显示「二维码获取失败」+刷新
    private string? _ddQrDataUri;
    private IReadOnlyList<string>? _ddQrLines;
    private string _ddQrState = "";
    private CancellationTokenSource? _ddQrCts;

    // ─── 账号密码登录（密码只在内存里活一次）───
    private bool _ddPwdBusy;     // 账密那路在跑
    private string? _ddPwdError; // 账密表单/登录错误，只挂在左栏
    private string _ddPwdAccount = "";
    private string _ddPwdPassword = "";
    private bool _ddGuardOpen;
    private string _ddGuardCode = "";
    private string _ddGuardPrompt = "";
    private bool _ddGuardError;
    private bool _ddGuardBusy;
    private bool _ddGuardSuccess;
    private string _ddPwdLive = "";
    private bool _ddMobileConfirm;
    // 本次账密登录的密码暂存：表单那份开跑即抹（界面上不留第二份），但「改为输入验证码」
    // 回落要重开一路，得拿得到它。跑完/关窗/成功三处都清，生命周期与原先的局部变量等价。
    private string? _ddPwdRunPassword;
    private bool _ddPreferCode;
    private bool _guardMounted;
    private DotNetObjectReference<Settings>? _guardRef;
    private TaskCompletionSource<string?>? _ddGuardTcs;

    // 验证已通过到授权落盘期间，禁止重开或取消登录。
    private bool _ddDone;

    /// <summary>每开窗一次自增。成功后那次「延时关窗」要认这一代：用户在 600ms 里关掉又重开，
    /// 旧的那次关窗不能把刚打开的新窗顺手关掉。</summary>
    private int _ddOpenGen;

    /// <summary>每开一路登录就自增。被取消的那一路收尾时会拿着旧值回来 —— 不认这一代，
    /// 就会把「已取消」写进用户刚刚切过去的另一种登录方式的状态里。</summary>
    private int _ddRunGen;

    /// <summary>弹窗里那行进度。服务一直在报（重取新码、连第几个 CM 节点），只是原先界面写死了
    /// 「正在连接…」没接上 —— 用户看到的就是「一直卡在正在连接」。长文案会撑破弹窗，截到 48 字。</summary>
    private string DdQrHint => _ddQrState.Length > 48 ? _ddQrState[..48] + "…" : _ddQrState;

    /// <summary>码下面那行：等扫时给操作说明，服务一报别的（换码 / 授权成功收尾）就换成进度。
    /// 这里原先挂的是 s.team 长链接（用户要求去掉），链接本身仍写在 juni-grid.log 里。</summary>
    private string DdQrScanHint =>
        string.IsNullOrWhiteSpace(_ddQrState) || _ddQrState.StartsWith("等待手机扫码")
            || _ddQrState.StartsWith(Loc.T("等待手机扫码确认…"))
            ? "用 Steam 手机 App 扫这张码"
            : DdQrHint;

    private void OnQrImgError()
    {
        if (_ddDone) return;
        _ddQrFailed = true;
        ClearDdQrImage();
    }

    private bool DdAuthorized => Cfg.Current.DepotQrLoggedIn;

    /// <summary>授权账号与本机 Steam 客户端账号的异同说明（跟在"下载免密"后面）。</summary>
    private string GetDdAccountSuffix()
    {
        var acc = Cfg.Current.SteamCmdAccount;
        if (string.IsNullOrWhiteSpace(acc)) return "";
        if (_steam.Found && string.Equals(acc, _steam.AccountName, StringComparison.OrdinalIgnoreCase))
            return LocService.Tr("（本机 Steam 账号）");
        return $"（授权账号：{acc}）";
    }

    private void OpenDdQr()
    {
        if (_ddDone) return;
        // 只拦「真有版本在下载/排队」：下载与授权共用 Steam 会话，下载在飞时重新授权会互踢。
        // 不能按 SteamSessionBusy 一刀切 —— 占着会话的可能只是上一路扫码/登录的收尾进程
        // （2026-11-16 实机：没有下载却报「有版本正在下载」，授权窗再也打不开）。
        // 会话闸本身允许 3 路并发（唯一 loginid 不互踢），满了才拦。
        if (Center.Snapshot().Any(t => t.Kind == "gameversion" && t.Status is "running" or "paused"))
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("有版本正在下载，等它下完（或先在任务中心取消）再重新授权"), "err");
            return;
        }
        // 没有下载也没有 DD 进程 ⇒ 占着闸的只可能是卡死的收尾路：回收孤儿会话再开门
        if (!System.Diagnostics.Process.GetProcessesByName("DepotDownloader").Any())
            DepotDownloaderService.ReapOrphanSessions();
        if (DepotDownloaderService.SteamSessionCount >= 3)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("Steam 会话已满（3 路都在跑），等一路结束再重新授权"), "err");
            return;
        }
        // 重开＝放弃旧路：先掐再换 CTS。不掐的话旧扫码/账密路没人取消，占着会话闸
        // 一直重试到自然死（2026-11-16 实机：开+刷新凑满 3 路，关窗后授权再也打不开）。
        CancelQrRun();
        CancelPwdRun();
        _ddQrOpen = true;
        _ddDone = false;
        _ddOpenGen++;
        _ddPwdPassword = "";
        _ddGuardCode = "";
        _ddGuardOpen = false;
        ClearDdQrImage();
        _ddQrFailed = false;
        _ddPwdError = null;
        _ddQrState = "正在准备扫码组件…";
        _ddQrBusy = true;
        _ddQrCts = new CancellationTokenSource();
        StateHasChanged();
        _ = RunDdQrAsync();
    }

    // 首次安装组件会下载并解压。页面打开后后台预热，扫码时不再等这一段。
    private async Task WarmDepotDownloaderAsync()
    {
        try
        {
            await DepotQr.EnsureDepotDownloaderAsync();
        }
        catch (Exception ex)
        {
            // 预热不影响正常使用；真正扫码时会给出可见错误。
            AppLog.Warn("DepotDownloader", "授权组件后台预热失败: " + ex.Message);
        }
    }

    private async Task RunDdQrAsync()
    {
        var gen = ++_ddRunGen;
        var progress = new Progress<DepotDownloaderService.Progress>(p =>
            _ = InvokeAsync(() =>
            {
                if (gen != _ddRunGen) return;   // 已经被切走的那一路，不许再改界面
                _ddQrState = string.IsNullOrEmpty(p.Line) ? p.State : p.Line;
                StateHasChanged();
            }));
        try
        {
            var account = await DepotQr.QrLoginOnlyAsync(
                dataUri => InvokeAsync(() =>
                {
                    if (gen != _ddRunGen) return;
                    _ddQrDataUri = dataUri;
                    StateHasChanged();
                }),
                progress, _ddQrCts?.Token ?? CancellationToken.None,
                onAsciiLines: lines => InvokeAsync(() =>
                {
                    if (gen != _ddRunGen) return;
                    _ddQrLines = lines;
                    StateHasChanged();
                }),
                // 上一张码随 Steam 连接一起作废了：撤干净，等下一路刷出的新码
                onStale: () => InvokeAsync(() => { if (gen == _ddRunGen) ClearDdQrImage(); }));

            await CompleteDdLoginAsync(account, gen);
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                if (gen != _ddRunGen) return;   // 用户已经切到账密/关窗：别把"已取消"盖到别人头上
                _ddQrBusy = false;
                // 被切走/关窗的取消不算失败；真失败才挂「二维码获取失败」+原位刷新
                _ddQrFailed = ex is not OperationCanceledException;
                ClearDdQrImage();   // 走到这儿那张 challenge 已经作废，不许留在屏上让人扫
            });
        }
    }

    /// <summary>登录成功后的统一收尾（扫码 / 账密两条路共用）。</summary>
    private async Task CompleteDdLoginAsync(string account, int gen, bool cancelRun = true)
    {
        var openGen = _ddOpenGen;
        var completed = false;
        await InvokeAsync(() =>
        {
            if (gen != _ddRunGen) return;
            var cfg = Cfg.Current;
            cfg.DepotQrLoggedIn = true;
            if (!string.IsNullOrWhiteSpace(account)) cfg.SteamCmdAccount = account.Trim();
            // 记进令牌名单：下次这个账号走账密登录时知道本机有令牌可复用（两趟防任意密码）
            if (!string.IsNullOrWhiteSpace(account)
                && !cfg.SteamTokenAccounts.Contains(account.Trim(), StringComparer.OrdinalIgnoreCase))
                cfg.SteamTokenAccounts.Add(account.Trim());
            Cfg.Save(cfg);

            // 成功即掐掉另一路。原先这里只看 busy 标志、不掐进程：用户在等登录时点过
            // 「刷新二维码」，那一路会把 _ddQrBusy 顶成 true，下面那句「没人在跑才关窗」
            // 就永远不成立 —— 弹窗从此关不掉（2026-11-16 实测：成功后 120ms 点刷新 → 挂死）。
            if (cancelRun) { try { _ddQrCts?.Cancel(); } catch { } }
            _ddRunGen++;                    // 旧登录进度不再写回已关闭的界面
            _ddQrBusy = false;
            _ddPwdBusy = false;
            _ddQrFailed = false;
            _ddPwdError = null;
            _ddGuardOpen = false;
            _ddGuardSuccess = false;
            _ddGuardTcs?.TrySetResult(null);
            _ddGuardTcs = null;
            _ddGuardCode = "";
            _ddGuardBusy = false;
            _ddMobileConfirm = false;
            _ddPwdRunPassword = null;
            _ddPwdPassword = "";      // 成功即抹掉表单里那一份
            _ddQrState = "授权成功";
            ClearDdQrImage();   // 撤掉旧码，避免成功后还显示二维码
            _ddDone = true;
            _ddQrOpen = false;
            completed = true;
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("Steam 下载授权成功，历史版本下载已免密"));
            StateHasChanged();
        });
        if (!completed) return;
        await Task.Delay(600, CancellationToken.None);
        await InvokeAsync(() =>
        {
            if (openGen != _ddOpenGen) return;   // 期间被关掉又重开：这次关窗作废
            _ddDone = false;
            _ddQrOpen = false;
            StateHasChanged();
        });
    }

    // ─── 账号密码登录 ───────────────────────────────────────────────────────

    /// <summary>掐掉扫码那路（点「登录」时调用）。同账号两路登录会互踢，必须先取消；
    /// gen 自增让被取消那路收尾时认不出自己，不会把状态写回界面。</summary>
    private void CancelQrRun()
    {
        if (_ddQrBusy) { try { _ddQrCts?.Cancel(); } catch { } }
        _ddRunGen++;
        _ddQrBusy = false;
        _ddQrFailed = false;
        _ddQrState = "";
        ClearDdQrImage();
    }

    /// <summary>掐掉账密那路（点扫码刷新时调用），放掉等 Guard 码的 Task。</summary>
    private void CancelPwdRun()
    {
        if (_ddPwdBusy) { try { _ddQrCts?.Cancel(); } catch { } }
        _ddRunGen++;
        _ddPwdBusy = false;
        _ddGuardOpen = false;
        _ddGuardCode = "";
        _ddGuardBusy = false;
        _ddGuardSuccess = false;
        _ddMobileConfirm = false;
        _ddGuardTcs?.TrySetResult(null);
        _ddGuardTcs = null;
    }

    /// <summary>右栏刷新 / 启动扫码：先取消账密，再开一路扫码。</summary>
    private void RestartQrAsync()
    {
        if (_ddDone) return;   // 已经成功、正在关窗：别把收尾那一下顶掉
        CancelPwdRun();
        CancelQrRun();   // 刷新也是换一路：旧扫码路不掐就是占闸僵尸（同上实机）
        _ddPwdError = null;
        _ddQrFailed = false;
        _ddQrState = "正在准备扫码组件…";
        _ddQrBusy = true;
        _ddQrCts = new CancellationTokenSource();
        StateHasChanged();
        _ = RunDdQrAsync();
    }

    /// <summary>账密表单里按 Enter = 点「登录」（登录中/收尾中不重复触发）。</summary>
    private async Task OnDdLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_ddPwdBusy && !_ddDone) await RunDdPasswordAsync();
    }

    /// <summary>本机 DD 是否存过这个账号的令牌：决定账密登录走单趟还是两趟。
    /// 名单外 = 无令牌可复用 → 单趟真验且只问一次验证码；名单内 = 两趟防「任意密码成功」。
    /// 旧配置没名单时用当前已授权账号兜底（令牌桶里至少必有它）。</summary>
    private bool TokenLikelyPresent(string account)
    {
        var c = Cfg.Current;
        return c.SteamTokenAccounts.Contains(account, StringComparer.OrdinalIgnoreCase)
            || (c.DepotQrLoggedIn && string.Equals(c.SteamCmdAccount, account, StringComparison.OrdinalIgnoreCase));
    }

    private async Task RunDdPasswordAsync()
    {
        if (_ddDone) return;   // 上一次已经成功，正在关窗
        // 扫码还在跑（哪怕手机已确认、仍在加载）→ 先掐掉它，账密接管。两路不能并存。
        CancelQrRun();
        if (!System.Diagnostics.Process.GetProcessesByName("DepotDownloader").Any())
            DepotDownloaderService.ReapOrphanSessions();
        var acc = (_ddPwdAccount ?? "").Trim();
        var pwd = _ddPwdPassword ?? "";
        if (acc.Length == 0)
        {
            _ddPwdError = LocService.Tr("请填写 Steam 账号名（登录名，不是昵称）");
            StateHasChanged();
            return;
        }
        if (pwd.Length == 0)
        {
            _ddPwdError = LocService.Tr("请填写 Steam 密码");
            StateHasChanged();
            return;
        }

        // 立刻从表单状态里抹掉：界面上不再留第二份，只有本次运行持有它（_ddPwdRunPassword，
        // 供「改为输入验证码」回落重开；跑完/关窗即清）。
        // 服务层不存字段、不写日志（DescribeArgsForLog 打码）、不进 config —— 见 PasswordLoginOnlyAsync。
        _ddPwdRunPassword = pwd;
        var preferCode = _ddPreferCode;
        _ddPreferCode = false;
        _ddPwdPassword = "";
        _ddPwdError = null;
        _ddGuardError = false;
        _ddGuardBusy = false;
        _ddGuardSuccess = false;
        _ddGuardOpen = preferCode;
        _ddGuardCode = "";
        _ddGuardPrompt = "";
        _ddPwdLive = "";
        _ddMobileConfirm = false;
        _ddPwdBusy = true;
        _ddQrState = "正在用账号密码登录…";
        _ddQrCts = new CancellationTokenSource();
        StateHasChanged();

        var gen = ++_ddRunGen;
        var progress = new Progress<DepotDownloaderService.Progress>(p =>
            _ = InvokeAsync(() => HandleDdPasswordProgress(p, gen)));
        try
        {
            await DepotQr.PasswordLoginOnlyAsync(
                acc, pwd, TokenLikelyPresent(acc), AskDdGuardCodeAsync, progress, _ddQrCts.Token, preferCode,
                onAuthenticated: account => CompleteDdLoginAsync(account, gen, cancelRun: false));
        }
        catch (Exception ex)
        {
            AppLog.Warn("DepotDownloader", "账密登录未成功：" + ex.Message);
            await InvokeAsync(() =>
            {
                if (gen != _ddRunGen) { AppLog.Warn("DepotDownloader", "账密登录收尾被丢弃（已被切走）"); return; }
                _ddDone = false;
                _ddPwdRunPassword = null;
                _ddPwdBusy = false;
                _ddGuardOpen = false;
                _ddGuardCode = "";
                _ddGuardBusy = false;
                _ddGuardSuccess = false;
                _ddMobileConfirm = false;
                _ddPwdError = ex is OperationCanceledException ? null : ex.Message;
                StateHasChanged();
            });
        }
    }

    private void HandleDdPasswordProgress(DepotDownloaderService.Progress p, int gen)
    {
        if (gen != _ddRunGen || _ddDone) return;
        _ddQrState = string.IsNullOrEmpty(p.Line) ? p.State : p.Line;
        _ddPwdLive = p.State;
        if (p.Line is not null && DepotDownloaderService.LooksLikeGuardCodeRejected(p.Line))
        {
            _ddGuardError = true;
            _ddGuardBusy = false;
            _ = JS.InvokeVoidAsync("junigridJs.guardSlotsError");
        }
        if (p.Line is not null && DepotDownloaderService.LooksLikeMobileConfirmPrompt(p.Line))
            _ddMobileConfirm = true;
        if (p.Line is not null && DepotDownloaderService.LooksLikeLoginSuccess(p.Line))
        {
            _ddDone = true;
            _ddQrOpen = false;
            _ddMobileConfirm = false;
            ShowGuardSuccess();
        }
        StateHasChanged();
    }

    /// <summary>
    /// 服务层要 Guard 码时的回调。<b>必须</b>走 InvokeAsync 到 UI 线程再改状态；
    /// 同时挂上取消令牌 —— 用户关窗时服务那一路会抛取消，这个 Task 不能永远挂着。
    /// </summary>
    private async Task<string?> AskDdGuardCodeAsync(string prompt, CancellationToken guardCt)
    {
        var tcs = new TaskCompletionSource<string?>(TaskCreationOptions.RunContinuationsAsynchronously);
        await InvokeAsync(() =>
        {
            if (_ddDone || !_ddPwdBusy || guardCt.IsCancellationRequested)
            {
                tcs.TrySetResult(null);
                return;
            }
            var pendingCode = _ddGuardOpen && _ddGuardBusy && _ddGuardTcs is null ? _ddGuardCode : "";
            _ddGuardTcs = tcs;
            _ddGuardPrompt = (prompt ?? "").Trim();
            _ddGuardCode = pendingCode;
            _ddGuardBusy = pendingCode.Length > 0;
            _ddGuardSuccess = false;
            _ddMobileConfirm = false;
            _ddGuardOpen = true;
            _ddQrState = "需要 Steam Guard 验证码";
            if (pendingCode.Length > 0)
            {
                _ddGuardTcs = null;
                tcs.TrySetResult(pendingCode);
            }
            StateHasChanged();
        });
        using var reg = (_ddQrCts?.Token ?? CancellationToken.None)
            .Register(() => tcs.TrySetResult(null));
        // 问码绑进程生命周期：进程退了（手机批准/令牌命中/失败）登录不再需要码，
        // 弹窗立刻收掉 —— 不许出现「进程死了弹窗还在问码」的僵尸态。
        // 成功洗白态例外：它有自己的 1.2s 退场计时。
        using var regGuard = guardCt.Register(() =>
        {
            tcs.TrySetResult(null);
            _ = InvokeAsync(() =>
            {
                if (_ddGuardTcs != tcs || _ddGuardSuccess) return;
                _ddGuardOpen = false;
                _ddGuardBusy = false;
                _ddGuardTcs = null;
                StateHasChanged();
            });
        });
        return await tcs.Task;
    }

    private void SubmitDdGuardCode()
    {
        if (_ddDone) return;
        var code = (_ddGuardCode ?? "").Trim();
        if (code.Length == 0) return;
        var tcs = _ddGuardTcs;
        _ddGuardTcs = null;
        // 弹窗不关：切「正在验证」态等 Steam 判定。判错：红染 drain 后再要一次；
        // 判对：成功行触发洗白+对勾，1.2s 后自动退场。
        _ddGuardBusy = true;
        _ddQrState = tcs is null ? "正在连接 Steam，连接后自动提交…" : "正在提交验证码…";
        StateHasChanged();
        tcs?.TrySetResult(code);
    }

    /// <summary>验证通过：整行槽位洗白 + 对勾升起（CodeSlots 的 success 形状），1.2s 后收弹窗。</summary>
    private void ShowGuardSuccess()
    {
        if (!_ddGuardOpen || _ddGuardSuccess) return;
        _ddGuardSuccess = true;
        _ddGuardBusy = false;
        _ddGuardError = false;
        _ = JS.InvokeVoidAsync("junigridJs.guardSlotsSuccess");
        var gen = _ddRunGen;
        _ = Task.Delay(1200).ContinueWith(_ => InvokeAsync(() =>
        {
            if (gen != _ddRunGen || !_ddGuardSuccess) return;
            _ddGuardOpen = false;
            _ddGuardSuccess = false;
            _ddGuardTcs = null;
            StateHasChanged();
        }));
    }

    [JSInvokable]
    public void OnGuardSlotsComplete(string code)
    {
        _ddGuardCode = code;
        SubmitDdGuardCode();
    }

    [JSInvokable]
    public void OnGuardSlotsEdit()
    {
        if (!_ddGuardError) return;
        _ddGuardError = false;
        StateHasChanged();
    }

    /// <summary>弹窗取消 = 终止本次登录尝试（只放掉验证码的话 DD 会干等到静默超时）。</summary>
    private void CancelGuardPopup()
    {
        if (_ddDone) return;
        CancelPwdRun();
        StateHasChanged();
    }

    private bool PrepareCodeLogin()
    {
        if (_ddPwdRunPassword is null || _ddDone) return false;
        _ddPwdPassword = _ddPwdRunPassword;
        _ddPreferCode = true;
        CancelPwdRun();
        _ddGuardOpen = true;
        _ddGuardPrompt = "";
        StateHasChanged();
        return true;
    }

    private void SwitchToCodeLogin()
    {
        if (PrepareCodeLogin()) _ = RunDdPasswordAsync();
    }

    /// <summary>撤掉界面上的二维码。出过码后再失败 ⇒ challenge 已随 DD 进程退出作废，

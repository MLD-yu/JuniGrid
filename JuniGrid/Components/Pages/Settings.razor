@namespace JuniGrid.Components.Pages
@page "/settings"
@using JuniGrid.Components
@implements IDisposable
@inject ConfigService Cfg
@inject GameService Game
@inject SteamService Steam
@inject NexusService NexusApi
@inject NexusOAuthService OAuth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject StorageService Storage
@inject MemoryService Mem
@inject DepotDownloaderService DepotQr
@inject LauncherService Launcher
@inject TaskCenterService Center

<div class="jg-page">
    <h1 style="margin-top:0">@Loc.T("设置")</h1>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("账号")</div>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:8px;">
            <div style="display:flex;align-items:center;gap:10px;">
                @if (_steam.Found && _steam.AvatarDataUri is not null)
                {
                    <img src="@_steam.AvatarDataUri" alt="steam" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    @* 未登录 / 拿不到头像 → 用项目内置 Steam 圆标兜底（与 Nexus 兜底图标同款式） *@
                    <img src="assets/steam.svg" alt="steam" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                <div style="flex:1">
                    <div style="font-weight:600;display:flex;align-items:center;gap:6px;">
                        Steam · @(_steam.Found ? (_steam.PersonaName ?? _steam.AccountName ?? Loc.T("已登录")) : Loc.T("未登录"))
                        @if (DdAuthorized)
                        {
                            <span class="jg-auth-badge">@Loc.T("下载已授权")</span>
                        }
                    </div>
                    <div style="font-size:12px;opacity:.65">
                        @if (DdAuthorized)
                        {
                            <text>@Loc.F("历史版本下载免密{0}", GetDdAccountSuffix())</text>
                        }
                        else
                        {
                            <text>@Loc.T("Steam 客户端级登录，切换账号请在 Steam 里操作；下载历史版本前需扫码授权")</text>
                        }
                    </div>
                </div>
                @if (DdAuthorized)
                {
                    <button class="jg-nexus-logout-btn" @onclick="DdRevoke">@Loc.T("解除授权")</button>
                }
                else
                {
                    <button class="jg-nexus-login-btn" @onclick="OpenDdQr">@Loc.T("扫码授权")</button>
                }
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                @if (!string.IsNullOrEmpty(_nexusAvatar))
                {
                    <img src="@_nexusAvatar" alt="nexus" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    <img src="assets/nav/nexus.svg" alt="nexus" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                <div style="flex:1">
                    <div style="font-weight:600;display:flex;align-items:center;gap:6px;">Nexus · @(string.IsNullOrEmpty(_nexusName) ? Loc.T("未登录") : _nexusName) @if (_nexusPremium) { <span class="jg-premium-badge">Premium</span> }</div>
                    <div style="font-size:12px;opacity:.65">@(string.IsNullOrEmpty(_nexusName) ? Loc.T("登录后可使用 Nexus 下载与安装") : Loc.T("Nexus Mods 账号已登录"))</div>
                </div>
                @if (!string.IsNullOrEmpty(_nexusName))
                {
                    <button class="jg-nexus-logout-btn" @onclick="NexusLogout">@Loc.T("退出 Nexus")</button>
                }
                else
                {
                    <button class="jg-nexus-login-btn" @onclick='() => Nav.NavigateTo("/nexus?login=1")'>@Loc.T("登录")</button>
                }
            </div>
        </div>
    </div>

    @* ─── Steam 下载授权：扫码弹窗 ─── *@
    @if (_ddQrOpen)
    {
        @* 用全站 .jg-modal-overlay（z-index 99998）：内联的 1000 会被 .jg-sort-dd(9500) 盖过，
           导致扫码进行中还能点背后的语言/主题下拉 *@
        <div class="jg-modal-overlay" @onclick="CloseDdQr">
            <div class="jg-modal" style="padding:18px 22px" @onclick:stopPropagation>
                <div style="font-weight:600;margin-bottom:10px">@Loc.T("Steam 扫码授权")</div>

                @if (!string.IsNullOrEmpty(_ddQrError))
                {
                    <div class="jg-qr-err">@Loc.T(_ddQrError)</div>
                }

                @if (_ddQrLines is { Count: >= 27 })
                {
                    @* 矢量码：白底 + 静区足，手机比 PNG data URI 好扫；台子按码自己的比例收（不占方形） *@
                    <div class="jg-qr-stage vector">
                        <QrAsciiImage Lines="_ddQrLines" Size="340" />
                    </div>
                    <div class="jg-qr-hint">@Loc.T(DdQrScanHint)</div>
                }
                else if (!string.IsNullOrEmpty(_ddQrDataUri))
                {
                    <div class="jg-qr-stage">
                        <img class="qr" src="@_ddQrDataUri" alt='@Loc.T("扫码授权")'
                             @onerror="OnQrImgError"/>
                    </div>
                    <div class="jg-qr-hint">@Loc.T(DdQrScanHint)</div>
                }
                else if (!string.IsNullOrEmpty(_ddQrError) && !_ddQrBusy)
                {
                    <div class="jg-qr-stage fail">
                        <div class="veil"></div>
                        <div class="hub"><span class="bang">!</span></div>
                    </div>
                }
                else
                {
                    @* 连接中：模糊码底 + 加载环，下面一行短进度（长文案会撑破弹窗，截到 48 字） *@
                    <div class="jg-qr-stage">
                        <div class="veil"></div>
                        <div class="hub"><div class="ring"></div></div>
                    </div>
                    <div class="jg-qr-hint">@(string.IsNullOrWhiteSpace(_ddQrState) ? Loc.T("正在连接…") : DdQrHint)</div>
                }

                <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px">
                    @if (_ddQrBusy)
                    {
                        @* 出码截止是 20 秒，不该让人干等：点一下 1 秒内掐掉这一路马上重开，
                           而且这次重开不占用重试次数（用户主动要的，不是失败） *@
                        <button type="button" class="jg-path-btn" @onclick="KickQrRetry">@Loc.T("立即重开")</button>
                    }
                    <button type="button" class="jg-path-btn" @onclick="CloseDdQr">@(_ddQrBusy ? Loc.T("取消") : Loc.T("关闭"))</button>
                </div>
            </div>
        </div>
    }


    @* ── i18n：界面语言（复用 Mod 管理页同款自定义下拉，不用原生 select）── *@
    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("界面语言")</div>
        <div class="jg-sort-dd jg-lang-dd @(_langOpen ? "open" : "")" data-dd="lang" style="margin-top:8px; width:fit-content; max-width:100%">
            <button class="jg-sort-trigger" @onclick="ToggleLang">
                @(Loc.Lang == "en" ? "English" : "简体中文")
                <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="jg-sort-menu">
                <button class="jg-sort-item @(Loc.Lang == "zh" ? "active" : "")" @onclick='() => PickLang("zh")'>@Loc.T("简体中文")</button>
                <button class="jg-sort-item @(Loc.Lang == "en" ? "active" : "")" @onclick='() => PickLang("en")'>English</button>
            </div>
        </div>
        <div class="jg-dd-overlay @(_langOpen ? "open" : "")" data-dd="lang" @onclick="CloseLang"></div>
    </div>

    @* ── 颜色主题（data-accent 轴；纯 CSS 变量，切换即时全站重上色，无需重载）── *@
    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("颜色主题")</div>
        <div class="jg-accent-grid">
            @foreach (var a in Accents)
            {
                var accent = a.Key == "system" ? SystemHex : a.Accent;
                var cur = Cfg.Current.Accent == a.Key;
                <button class="jg-accent-card @(cur ? "cur" : "")" @onclick="() => SetAccent(a.Key)">
                    <span class="jg-accent-mock" style="@($"--mock-accent:{accent}")">
                        <span class="jg-mock-bar"></span>
                        <span class="jg-mock-dot @(cur ? "on" : "")"></span>
                        <span class="jg-mock-panel"><i></i><i></i></span>
                    </span>
                    <span class="jg-accent-name">@(Loc.Lang == "en" ? a.En : a.Zh)</span>
                </button>
            }
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("游戏目录")</div>
        <input class="jg-ver-input" style="margin-top:6px" @bind="_gamePath"
               placeholder='@Loc.T("例：C:\\Program Files (x86)\\Steam\\steamapps\\common\\Stardew Valley")' />

        <div style="display:flex;gap:8px;margin-top:8px">
            <button type="button" class="jg-path-btn" @onclick="Pick">@Loc.T("浏览...")</button>
            <button type="button" class="jg-path-btn" @onclick="AutoDetect">@Loc.T("自动检测")</button>
            <button type="button" class="jg-path-btn primary" @onclick="Save">@Loc.T("保存")</button>
        </div>

        @* ─── v1.2.4：游戏版本锁定 —— Steam 版才有 appmanifest，非 Steam 目录自动降级为说明文字 ─── *@
        @if (_manifestPath is not null)
        {
            <div class="jg-switch-col" style="margin-top:10px">
                <div class="jg-switch-row @(_manifestLocked ? "on" : "")" @onclick="ToggleLockGameVersion">
                    <span style="display:flex;align-items:center;gap:8px">
                        <span>@Loc.T("锁定游戏版本")</span>
                        <span class="jg-help-tip">
                            <span class="jg-help-tip-btn">?</span>
                            <span class="jg-help-tip-bubble">@Loc.T("开启后 Steam 无法更新游戏本体（含 Steam 启动前的强制更新），当前版本会一直保持可玩 —— 适合想留在旧版本搭配旧 mod 的玩家。想更新游戏时，先关闭本开关再启动。")</span>
                        </span>
                    </span>
                    <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                </div>
            </div>
        }
        else
        {
            <div style="font-size:12px;opacity:.6;margin-top:8px">@Loc.T("未找到 Steam 版清单文件（appmanifest）—— 版本锁定仅适用于 Steam 版游戏目录。")</div>
        }

    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("Nexus 安装")</div>
        <div class="jg-switch-col">
            @* ─── v1.2.5：一个开关管两头 —— 应用内详情页按钮走不走浏览器，以及系统层
               HKCU\Software\Classes\nxm 归谁（浏览器点「Mod Manager Download」时 Windows 交给谁，
               注册表只有一个值，谁最后写谁赢）。原先是两行开关，已合并。─── *@
            <div class="jg-switch-row @(_oneClickInstall ? "on" : "")" @onclick="ToggleOneClick">
                <span style="display:flex;align-items:center;gap:8px">
                    <span>@Loc.T("一键安装")</span>
                    <span class="jg-help-tip">
                        <span class="jg-help-tip-btn">?</span>
                        <span class="jg-help-tip-bubble">@Loc.T("详情页点「安装」时免弹浏览器，直接在后台下载并装进 Mods。")<br />@Loc.T("同时接管 Nexus 下载链接：在网页点「Mod Manager Download」会直接交给 JuniGrid 下载，而不是 Vortex 等其它管理器。")<br />@Loc.T("注意：开着时 JuniGrid 每次启动都会重新接管一次；关闭则把链接交还给之前接管它的管理器（Vortex / NMM），若那个管理器已经不存在，就清空这条注册。")</span>
                    </span>
                </span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
            <div class="jg-switch-row @(_autoInstall ? "on" : "") @(!_nexusPremium ? "disabled" : "")" @onclick="ToggleAutoInstall">
                <span style="display:flex;align-items:center;gap:8px">
                    <span>@Loc.T("自动安装更新")</span>
                    @if (!_nexusPremium)
                    {
                        @* v1.x：GSAP 弹性 tooltip 问号（仅非 Premium 显示），hover 弹出、移开立即消失 *@
                        <span class="jg-help-tip">
                            <span class="jg-help-tip-btn">?</span>
                            <span class="jg-help-tip-bubble">@Loc.T("此功能仅 Nexus Mods Premium 用户可用")<br />@Loc.T("当 mod 管理页面有 mod 需要更新时，系统会自动为您更新")</span>
                        </span>
                    }
                </span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("内容过滤")</div>
        <div class="jg-switch-col">
            @* 单一开关。默认关 = 一律排除成人内容；开 = 应用不加成人条件，
               列表随登录用户 Nexus 账号的成人内容设置执行（服务端强制），应用永不覆盖账号偏好 *@
            <div class="jg-switch-row @(_showAdult ? "on" : "")" @onclick="ToggleShowAdult">
                <span>@Loc.T("显示成人内容")</span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="display:inline-flex;align-items:center;gap:6px;cursor:pointer" @onclick='() => Nav.NavigateTo("/tasks")'>
            <div style="font-weight:600">@Loc.T("任务管理")</div>
            <img src="assets/task-arrow.svg" alt='@Loc.T("前往任务管理")' style="width:14px;height:14px;opacity:.75" />
        </div>
        <div class="jg-switch-col">
            <div class="jg-switch-row @(_showTaskDock ? "on" : "")" @onclick="ToggleTaskDock">
                <span style="display:flex;align-items:center;gap:8px">
                    <span>@Loc.T("打开任务管理悬浮窗")</span>
                </span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("内存管理")</div>
        <div style="font-size:12px;opacity:.65;margin-top:2px">@Loc.T("定时保养自身与 WebView2；系统占用告急时连同游戏一并释放")</div>

        <div class="jg-mem-line" style="margin-top:8px">
                @Loc.F("系统 {0}，可用 {1}（{2}%）· 自身 {3}", FmtMb(_mem?.SysTotalBytes), FmtMb(_mem?.SysAvailBytes), Pct(), FmtMb(_mem?.AppWorkingSet))
        </div>

        <div class="jg-kv-grid" style="margin-top:10px">
            <div class="jg-kv">
                <div class="k">@Loc.T("自身进程")</div>
                <div class="v">@FmtMb(_mem?.AppWorkingSet)<span class="jg-kv-sub">GC @FmtMb(_mem?.AppGcBytes)</span></div>
            </div>
            <div class="jg-kv">
                <div class="k">@Loc.T("WebView2 子进程")</div>
                <div class="v">@FmtMb(_mem?.WebViewWorkingSet)<span class="jg-kv-sub">@Loc.F("{0} 个进程", _mem?.WebViewProcCount ?? 0)</span></div>
            </div>
            <div class="jg-kv">
                <div class="k">@Loc.T("游戏进程")</div>
                <div class="v">@(_mem is { GameRunning: true } ? FmtMb(_mem.GameWorkingSet) : Loc.T("未运行"))</div>
            </div>
            <div class="jg-kv">
                <div class="k">@Loc.T("系统内存占用")</div>
                <div class="v">@Pct()%</div>
            </div>
        </div>

        <div class="jg-switch-col" style="margin-top:6px">
            <div class="jg-switch-row @(_memTimer ? "on" : "")" @onclick="ToggleMemTimer">
                <span>@Loc.T("定时自动压缩")</span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
            @* 滑杆面板：初始隐藏由 Blazor 的 style 决定（不依赖 JS 时序），开合动画由 JS 弹性播放 *@
            <div class="jg-slider-panel" style="@(_memTimer ? null : "display:none")" @ref="_timerPanel">
                <div class="jg-slider-row">
                    <span class="jg-slider-label">@Loc.T("定时释放")</span>
                    <div class="e-slider" data-min="5" data-max="240" data-step="5" data-suffix='@Loc.T("分")' @ref="_timerSlider">
                        <div class="es-track-wrap"><div class="es-track"><div class="es-fill"></div></div></div>
                        <span class="es-value"></span>
                    </div>
                </div>
            </div>
            <div class="jg-switch-row @(_memThreshold ? "on" : "")" @onclick="ToggleMemThreshold">
                <span>@Loc.T("占用阈值自动压缩")</span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
            <div class="jg-slider-panel" style="@(_memThreshold ? null : "display:none")" @ref="_thresholdPanel">
                <div class="jg-slider-row">
                    <span class="jg-slider-label">@Loc.T("占用阈值")</span>
                    <div class="e-slider" data-min="50" data-max="95" data-step="1" data-suffix="%" @ref="_thresholdSlider">
                        <div class="es-track-wrap"><div class="es-track"><div class="es-fill"></div></div></div>
                        <span class="es-value"></span>
                    </div>
                </div>
            </div>
        </div>

        <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
            <button type="button" class="jg-path-btn" @onclick="CompressNow">@Loc.T("立即压缩")</button>
            <button type="button" class="jg-path-btn" @onclick="TrimGameNow">@Loc.T("清理游戏内存")</button>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("缓存与存储")</div>
        <div style="font-size:12px;opacity:.65;margin-top:2px">@Loc.T("各类缓存占用统计、清理与统一缓存目录")</div>

        <div class="jg-mem-line" style="margin-top:8px;display:flex;align-items:center;gap:8px">
            <span>@Loc.F("可清理缓存共 {0}", FmtMb(Storage.TotalKnownBytes))</span>
        </div>

        <div style="margin-top:4px">
            @foreach (var c in _cats)
            {
                @if (c.Id == "vercache")
                {
                    @* ─── v1.4.4：游戏版本缓存手风琴（箭头在标题右侧） ─── *@
                    <div class="jg-store-row" style="flex-direction:column;align-items:stretch;gap:0">
                        <div style="display:flex;align-items:center;gap:10px;padding:9px 2px">
                            <button type="button" class="jg-acc-head" style="padding:0;flex:1;min-width:0;flex-direction:row"
                                    aria-expanded="@(_verAccOpen ? "true" : "false")"
                                    aria-controls="jg-vercache-panel" @onclick="ToggleVerCache">
                                <span class="jg-store-main" style="flex:1;min-width:0">
                                    <span class="jg-store-name" style="display:flex;align-items:center;gap:6px">
                                        @Loc.T(c.Name)
                                        <svg class="jg-acc-chev" viewBox="0 0 16 16" fill="none" aria-hidden="true"
                                             style="display:inline-block;vertical-align:middle">
                                            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        @if (c.Movable) { <span class="jg-store-tag">@Loc.T("可迁移")</span> }
                                    </span>
                                    <span class="jg-store-path" title="@c.DisplayPath" style="display:block">@Loc.T(c.Note) · @c.DisplayPath</span>
                                </span>
                            </button>
                            <div class="jg-store-size">@FmtSize(c.Id)</div>
                            <button type="button" class="jg-mini-btn" @onclick='() => OpenCatFolder(c)'>@Loc.T("打开")</button>
                        </div>
                        <div id="jg-vercache-panel" class="jg-acc-panel @(_verAccOpen ? "open" : "")">
                            <div class="jg-acc-inner">
                                @if (_verCaches.Count == 0)
                                {
                                    <div class="jg-acc-empty">@Loc.T("尚未下载任何历史版本。在「游戏版本管理」里切换版本后会缓存在这里。")</div>
                                }
                                @foreach (var v in _verCaches)
                                {
                                    <div class="jg-acc-item">
                                        <span class="jg-acc-item-name">@Loc.T(v.Label)</span>
                                        <span class="jg-acc-item-size">@ResumableDownload.FormatBytes(v.SizeBytes)</span>
                                        <button type="button" class="jg-mini-btn danger-outline"
                                                @onclick="() => AskDeleteVerCache(v)">@Loc.T("删除")</button>
                                    </div>
                                }
                                @* 版本包之外的附属目录：删的代价不同的东西分行放（SMAPI 本体删了要重装、
                                   Mod 暂存里是用户的东西 → 那条走回收站），每条带「?」讲清是什么。 *@
                                @foreach (var b in _verBuckets)
                                {
                                    <div class="jg-acc-item">
                                        <span class="jg-acc-item-name" style="display:flex;align-items:center;gap:6px">
                                            @Loc.T(b.Kind.Name)
                                            <span class="jg-help-tip">
                                                <span class="jg-help-tip-btn">?</span>
                                                <span class="jg-help-tip-bubble">@Loc.T(b.Kind.Tip)</span>
                                            </span>

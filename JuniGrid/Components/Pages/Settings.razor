    private void CloseDdQr()
    {
        if (_ddDone)
        {
            _ddQrOpen = false;
            StateHasChanged();
            return;
        }
        _ddRunGen++;
        if (_ddQrBusy || _ddPwdBusy) { try { _ddQrCts?.Cancel(); } catch { } }
        // 关窗等于放弃：把密码与等码状态一起清掉，别让它们在组件里活到下次打开
        _ddPwdRunPassword = null;
        _ddPwdPassword = "";
        _ddGuardCode = "";
        _ddGuardOpen = false;
        _ddGuardBusy = false;
        _ddGuardSuccess = false;
        _ddMobileConfirm = false;
        _ddGuardTcs?.TrySetResult(null);
        _ddGuardTcs = null;
        _ddQrBusy = false;
        _ddPwdBusy = false;
        _ddQrFailed = false;
        _ddPwdError = null;
        _ddQrOpen = false;
        // 关窗也要抬 gen：成功后的那次延时关窗会认这一代，别让它落到下一次打开的窗上；
        // _ddDone 必须一起清，否则它会一直挂着，把下次「登录」直接拦掉。
        _ddDone = false;
        _ddOpenGen++;
        StateHasChanged();
    }


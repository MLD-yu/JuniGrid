@code {
    private SteamProfile _steam = SteamProfile.None;

    // i18n：语言下拉（复用 .jg-sort-dd 结构 + dropdownToggle 的 GSAP 动画）。
    // 选中 → 持久化并触发 Loc.OnChanged，本页就地重渲染。
    private bool _langOpen;
    private async Task ToggleLang()
    {
        _langOpen = !_langOpen;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-lang-dd", _langOpen); } catch { }
    }
    private async Task CloseLang()
    {
        if (!_langOpen) return;
        _langOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-lang-dd", false); } catch { }
    }
    private async Task PickLang(string lang)
    {
        _langOpen = false;
        try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-lang-dd", false); } catch { }
        Loc.SetLang(lang);
    }

    private void OnLocChanged() => InvokeAsync(StateHasChanged);

    // 颜色主题：data-accent 是纯 CSS 变量轴，切换即时全站重上色（无需重载/重渲染）。
    // "system" 用 Windows 系统色作强调色、按钮保持中性；其余走 base.css 主题块。
    private string SystemHex => JuniGrid.App.GetSystemAccentHex() ?? "#7aa2ff";

    private static readonly (string Key, string Zh, string En, string Accent)[] Accents =
    {
        ("system",    "默认",   "Default",   ""),
        ("forest",    "森林绿", "Forest",    "#2f9e5c"),
        ("mint",      "薄荷青", "Mint",      "#12a0a0"),
        ("honey",     "蜂蜜金", "Honey",     "#e0a512"),
        ("parchment", "羊皮纸", "Parchment", "#b07b45"),
        ("sky",       "天蓝",   "Sky",       "#2f80d8"),
        ("rose",      "玫红",   "Rose",      "#dd4a72"),
    };

    private void SetAccent(string key)
    {
        var c = Cfg.Current;
        if (string.Equals(c.Accent, key, StringComparison.OrdinalIgnoreCase)) return;
        c.Accent = key;
        Cfg.Save(c);
        _ = JS.InvokeVoidAsync("junigridJs.applyAccent", key, SystemHex);
        StateHasChanged();   // 刷新选中态描边
    }
    private string _nexusName = "";
    private string? _nexusAvatar;
    private bool   _nexusPremium;
    private bool   _sponsorWechat = true;

    private void NexusLogout()
    {
        OAuth.Logout();   // 清空 OAuth2 令牌、已挂载的 Bearer 以及缓存的账号字段
        _nexusName = ""; _nexusAvatar = null; _nexusPremium = false;
        _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("已退出 Nexus 登录"));
        StateHasChanged();
    }

    // ─── Steam 下载授权（DepotDownloader 扫码）───
    private bool _ddQrOpen;
    private bool _ddQrBusy;
    private string? _ddQrDataUri;
    private IReadOnlyList<string>? _ddQrLines;
    private string _ddQrState = "";
    private string? _ddQrError;
    private CancellationTokenSource? _ddQrCts;

    /// <summary>弹窗里那行进度。服务一直在报（重取新码、连第几个 CM 节点），只是原先界面写死了
    /// 「正在连接…」没接上 —— 用户看到的就是「一直卡在正在连接」。长文案会撑破弹窗，截到 48 字。</summary>
    private string DdQrHint => _ddQrState.Length > 48 ? _ddQrState[..48] + "…" : _ddQrState;

    /// <summary>码下面那行：等扫时给操作说明，服务一报别的（换码 / 授权成功收尾）就换成进度。
    /// 这里原先挂的是 s.team 长链接（用户要求去掉），链接本身仍写在 juni-grid.log 里。</summary>
    private string DdQrScanHint =>
        string.IsNullOrWhiteSpace(_ddQrState) || _ddQrState.StartsWith("等待手机扫码")
            || _ddQrState.StartsWith(Loc.T("等待手机扫码确认…"))
            ? "用 Steam 手机 App 扫这张码"
            : DdQrHint;

    private void OnQrImgError()
    {
        _ddQrError = LocService.Tr("二维码图片加载失败，请点取消后重试");
        StateHasChanged();
    }

    private bool DdAuthorized => Cfg.Current.DepotQrLoggedIn;

    /// <summary>授权账号与本机 Steam 客户端账号的异同说明（跟在"下载免密"后面）。</summary>
    private string GetDdAccountSuffix()
    {
        var acc = Cfg.Current.SteamCmdAccount;
        if (string.IsNullOrWhiteSpace(acc)) return "";
        if (_steam.Found && string.Equals(acc, _steam.AccountName, StringComparison.OrdinalIgnoreCase))
            return LocService.Tr("（本机 Steam 账号）");
        return $"（授权账号：{acc}）";
    }

    private void OpenDdQr()
    {
        // 同账号只允许一路 Steam 会话：下载在飞时再起一路扫码，会把那一路顶掉（实测互踢）
        if (DepotDownloaderService.SteamSessionBusy)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("有版本正在下载，等它下完（或先在任务中心取消）再重新授权"), "err");
            return;
        }
        _ddQrOpen = true;
        ClearDdQrImage();
        _ddQrError = null;
        _ddQrState = "正在准备扫码组件…";
        _ddQrBusy = true;
        _ddQrCts = new CancellationTokenSource();
        StateHasChanged();
        _ = RunDdQrAsync();
    }

    // 首次安装组件会下载并解压。页面打开后后台预热，扫码时不再等这一段。
    private async Task WarmDepotDownloaderAsync()
    {
        try
        {
            await DepotQr.EnsureDepotDownloaderAsync();
        }
        catch (Exception ex)
        {
            // 预热不影响正常使用；真正扫码时会给出可见错误。
            AppLog.Warn("DepotDownloader", "授权组件后台预热失败: " + ex.Message);
        }
    }

    private async Task RunDdQrAsync()
    {
        var progress = new Progress<DepotDownloaderService.Progress>(p =>
            _ = InvokeAsync(() =>
            {
                _ddQrState = string.IsNullOrEmpty(p.Line) ? p.State : p.Line;
                StateHasChanged();
            }));
        try
        {
            var account = await DepotQr.QrLoginOnlyAsync(
                dataUri => InvokeAsync(() =>
                {
                    _ddQrDataUri = dataUri;
                    StateHasChanged();
                }),
                progress, _ddQrCts?.Token ?? CancellationToken.None,
                onAsciiLines: lines => InvokeAsync(() =>
                {
                    _ddQrLines = lines;
                    StateHasChanged();
                }),
                // 上一张码随 Steam 连接一起作废了：撤干净，等下一路刷出的新码
                onStale: () => InvokeAsync(ClearDdQrImage));

            await InvokeAsync(() =>
            {
                var cfg = Cfg.Current;
                cfg.DepotQrLoggedIn = true;
                if (!string.IsNullOrWhiteSpace(account)) cfg.SteamCmdAccount = account.Trim();
                Cfg.Save(cfg);
                _ddQrBusy = false;
                _ddQrState = "授权成功";
                ClearDdQrImage();   // 撤掉旧码，避免成功后还显示二维码
                _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("Steam 下载授权成功，历史版本下载已免密"));
                StateHasChanged();
            });
            // 稍候自动关窗，让用户看到 toast / 状态
            await Task.Delay(900, CancellationToken.None);
            await InvokeAsync(() =>
            {
                if (!_ddQrBusy)
                {
                    _ddQrOpen = false;
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _ddQrBusy = false;
                _ddQrError = ex is OperationCanceledException ? "已取消" : ex.Message;
                ClearDdQrImage();   // 走到这儿那张 challenge 已经作废，不许留在屏上让人扫
            });
        }
    }

    /// <summary>撤掉界面上的二维码。出过码后再失败 ⇒ challenge 已随 DD 进程退出作废，
    /// 留着就是让人扫一张死码（手机端只报「加载二维码失败」，实测 03:45:20 出码 / 03:45:36 掉线）。</summary>
    /// <summary>「立即重开」：掐掉当前这一路连接，马上开下一路（服务层 1 秒内响应，
    /// 且不占用重试次数）。省得人对着 20 秒出码截止干等。</summary>
    private void KickQrRetry()
    {
        DepotDownloaderService.RequestKickNow();
        _ddQrState = "正在按你的要求重开一路连接…";
        StateHasChanged();
    }

    private void ClearDdQrImage()
    {
        _ddQrDataUri = null;
        _ddQrLines = null;
        StateHasChanged();
    }

    private void CloseDdQr()
    {
        if (_ddQrBusy) { try { _ddQrCts?.Cancel(); } catch { } }
        _ddQrOpen = false;
        StateHasChanged();
    }

    private void DdRevoke()
    {
        var cfg = Cfg.Current;
        cfg.DepotQrLoggedIn = false;
        Cfg.Save(cfg);
        _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("已解除 Steam 下载授权，下次下载需重新扫码"));
        StateHasChanged();
    }

    private async Task LoadAccountsAsync()
    {        // Q4: 全部从 config 缓存瞬读，不再进设置页就拉网
        _steam = Steam.GetProfile();
        var cfg = Cfg.Current;
        _nexusName = cfg.NexusUserName;
        _nexusPremium = cfg.NexusIsPremium;
        // v1.08.2：只信 image/* 的缓存 —— 旧版本曾把 profile_url（网页链接）的下载结果当头像缓存，
        // data:text/html 之类坏数据每次进页都命中，头像自然「对不上」
        var cached = cfg.NexusAvatarDataUri;
        _nexusAvatar = cached is not null && cached.StartsWith("data:image/", StringComparison.Ordinal) ? cached : null;
        // v1.08.2：已登录则后台自愈刷新（validate 已按 user_id 构造真实头像直链），拉到不同才写回缓存；
        // 不 await —— 设置页首屏不因网络等待延迟
        if (NexusService.IsAuthenticated) _ = RefreshNexusAvatarAsync();
    }

    private async Task RefreshNexusAvatarAsync()
    {
        try
        {
            var cfg = Cfg.Current;
            var u = await NexusApi.ValidateAsync();
            if (u is null || string.IsNullOrEmpty(u.Avatar)) return;
            var fresh = await NexusApi.FetchAvatarAsync(u.Avatar);
            if (string.IsNullOrEmpty(fresh)) return;
            _nexusName = string.IsNullOrEmpty(u.Name) ? _nexusName : u.Name;
            _nexusPremium = u.IsPremium;
            // 名字/Premium 也写回 config：老版本登录只落了 key + 头像缓存，
            // 不写回的话每次进设置页都要闪 1s「未登录」等这次 validate 自愈
            if (cfg.NexusUserName != _nexusName || cfg.NexusIsPremium != _nexusPremium)
            {
                cfg.NexusUserName = _nexusName;
                cfg.NexusIsPremium = _nexusPremium;
                Cfg.Save(cfg);
            }
            if (fresh != _nexusAvatar)
            {
                _nexusAvatar = fresh;
                cfg.NexusAvatarDataUri = fresh;
                Cfg.Save(cfg);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch { /* 网络失败保持缓存显示，静默 */ }
    }


    private string _gamePath = "";
    private bool _oneClickInstall;
    private bool _autoInstall;

    // ─── v1.2.4：游戏版本锁定（阻止 Steam 自动更新，玩旧版用）───
    // UI 状态以清单文件的只读属性为准（文件可能被 Steam/用户改掉），配置项只在切换时落盘；
    // Steam 启动路径还有一次启动前补锁兜底（LauncherService.LaunchSteam）。
    private string? _manifestPath;
    private bool _manifestLocked;

    private void ProbeManifest()
    {
        _manifestPath = SteamService.FindAppManifest(Cfg.Current.GamePath, Cfg.Current.SteamAppId);
        _manifestLocked = SteamService.IsGameVersionLocked(_manifestPath);
    }

    private void ToggleLockGameVersion()
    {
        if (_manifestPath is null) return;
        var want = !_manifestLocked;
        var (ok, err) = SteamService.SetGameVersionLock(_manifestPath, want);
        if (!ok)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", err, "err");
            return;
        }
        _manifestLocked = want;
        var cfg = Cfg.Current;
        cfg.LockGameVersion = want;
        Cfg.Save(cfg);
        _ = JS.InvokeVoidAsync("junigridJs.toast", want
            ? LocService.Tr("已锁定游戏版本 —— Steam 不会再自动更新本体，可一直玩当前版本")
            : LocService.Tr("已解除锁定 —— 下次通过 Steam 启动会正常更新游戏"));
        StateHasChanged();
    }


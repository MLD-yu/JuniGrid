    protected override async Task OnInitializedAsync()
    {
        // i18n：语言切换后就地重渲染本页（不整页 reload，避免闪一下）
        Loc.OnChanged += OnLocChanged;
        await LoadAccountsAsync();
        _gamePath = Cfg.Current.GamePath;        _oneClickInstall = Cfg.Current.EnableOneClickInstall;
        _builtinWeb = Cfg.Current.EnableBuiltinWebDownload;
        // v1.3.4：启动项（只读一个路径 + 最多几个 exe 的版本资源，够快，不必丢后台）
        _launcherExe = Cfg.Current.SmapiLauncherExe;
        RefreshLauncherStatus();
        // 重 IO 丢后台：ProbeManifest 扫 Steam 清单 + ListStagedPackages 过 52 个版本包，
        // 同步跑会把首屏整个卡住（「点设置进半天」就是这里）
        _ = Task.Run(() =>
        {
            try { ProbeManifest(); } catch { }
            try { LoadVerCaches(); } catch { }
            _ = InvokeAsync(StateHasChanged);
        });
        _autoInstall = Cfg.Current.EnableAutoInstall && _nexusPremium;   // 非会员一律默认关闭
        if (!_nexusPremium && Cfg.Current.EnableAutoInstall)
        {
            // 非会员时把残留的开启态落盘为关闭，避免其他页直接读 config 误触发自动安装
            Cfg.Current.EnableAutoInstall = false;
            Cfg.Save(Cfg.Current);
        }
        _showAdult = Cfg.Current.ShowAdultContent;
        _showTaskDock = Cfg.Current.ShowTaskDock;

        // v0.2.1：内存管理 —— 订阅快照推送（5s 一次），离开页面时 Dispose 退订
        Mem.OnSnapshot += OnMemSnap;
        ConfigService.Saved += OnCfgSaved;   // v1.1.4：设置页停留时悬浮球被右键隐藏 → 开关 UI 同步
        _mem = Mem.GetSnapshot();
        _memTimer = Cfg.Current.MemTimerEnabled;
        _memTimerMinutes = Math.Clamp(Cfg.Current.MemTimerMinutes, 5, 240);
        _memThreshold = Cfg.Current.MemThresholdEnabled;
        _memThresholdPercent = Math.Clamp(Cfg.Current.MemThresholdPercent, 50, 95);

        // v0.2.1：缓存与存储 —— 首次进入或过期后后台重算占用
        Storage.OnStats += OnStorageStats;
        _cats = Storage.GetCategories();
        Storage.RefreshAll();
        Center.OnChanged += OnCenterChangedForVerCache;   // v1.4.5：版本下载完成 → 手风琴自动刷新
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // v1.1.6：特效绑定包进 firstRender —— 内存快照每 5s 推一次触发重渲染，
        // 旧版每次渲染都发 4 个 JS interop 初始化调用（靠 JS 侧防重复标记兜底，纯浪费往返）
        if (firstRender)
        {
            _ = WarmDepotDownloaderAsync();
            // 特效绑定全部 fire-and-forget —— 串行 await 会把交互拖到 6 次往返之后
            // （JS 侧有防重复绑定标记，晚到也安全）
            _ = JS.InvokeVoidAsync("junigridJs.initGsapFx");
            _ = JS.InvokeVoidAsync("junigridJs.initPixelHover");
            _ = JS.InvokeVoidAsync("junigridJs.initCursorGrid", ".jg-cursor-grid");
            _ = JS.InvokeVoidAsync("junigridJs.initLogoLoop", ".jg-logoloop");
            _ = JS.InvokeVoidAsync("junigridJs.squishSwitchInit");
            // v0.2.2：弹性滑杆绑定（值变化经 OnElasticValue 回调落配置）
            try
            {
                _sliderCb = DotNetObjectReference.Create(this);
                _ = JS.InvokeVoidAsync("junigridJs.elasticInit", _timerSlider, "timer", (double)_memTimerMinutes, _sliderCb);
                _ = JS.InvokeVoidAsync("junigridJs.elasticInit", _thresholdSlider, "threshold", (double)_memThresholdPercent, _sliderCb);
            }
            catch { }
        }

        // Guard 弹窗的槽位输入：开 → 挂载 JS；关 → 拆监听。弹窗 DOM 由 @if 管，
        // 这里只补 JS 侧的生命周期（重渲染不会重建槽位节点，监听一直有效）。
        if (_ddGuardOpen && !_guardMounted)
        {
            _guardMounted = true;
            _guardRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("junigridJs.guardSlotsInit", "#jg-guard-slots", _guardRef);
        }
        else if (!_ddGuardOpen && _guardMounted)
        {
            _guardMounted = false;
            await JS.InvokeVoidAsync("junigridJs.guardSlotsDestroy");
        }
    }
    private void ToggleOneClick()
    {
        _oneClickInstall = !_oneClickInstall;
        SaveOneClickInstall();
    }

    private void ToggleAutoInstall()
    {
        if (!_nexusPremium) return;
        _autoInstall = !_autoInstall;
        SaveAutoInstall();
    }

    /// <summary>v1.3.84：内置网页取链开关。关掉只是不再开窗口 —— Premium 的 API 直链照旧走。</summary>
    private void ToggleBuiltinWeb()
    {
        _builtinWeb = !_builtinWeb;
        var cfg = Cfg.Current;
        cfg.EnableBuiltinWebDownload = _builtinWeb;
        Cfg.Save(cfg);
        StateHasChanged();
    }

    private void ToggleShowAdult()
    {
        _showAdult = !_showAdult;
        SaveShowAdult();
    }

    private void SaveOneClickInstall()
    {
        var cfg = Cfg.Current;
        cfg.EnableOneClickInstall = _oneClickInstall;
        Cfg.Save(cfg);
        // 同一个开关还管 nxm:// 注册：立刻生效，不用等下次启动；
        // 关闭时把注册交还给被我们压掉的管理器（抢注前已备份原值），交还不了才删。
        if (_oneClickInstall) JuniGrid.App.ClaimNxmHandlerNow();
        else JuniGrid.App.ReleaseNxmHandler();
        _ = JS.InvokeVoidAsync("junigridJs.toast",
            _oneClickInstall ? LocService.Tr("已由 JuniGrid 接收 Nexus 下载链接") : LocService.Tr("已让出 Nexus 下载链接"), "ok");
    }

    private void SaveAutoInstall()
    {
        var cfg = Cfg.Current;
        // 双保险：非会员即使在 UI 外被置为 true 也不生效
        cfg.EnableAutoInstall = _autoInstall && cfg.NexusIsPremium;
        Cfg.Save(cfg);
    }

    // 目录有效 = 游戏本体在即可。SMAPI 不是必需品（用户可以选择游玩官方模式），
    // 没装 SMAPI 只影响提示文案，不再拦截保存
    private static bool IsValidGamePath(string? p)
        => !string.IsNullOrWhiteSpace(p)
           && Directory.Exists(p)
           && File.Exists(Path.Combine(p, "Stardew Valley.exe"));

    /// <summary>装了没有：与启动/自检同一口径（见 <see cref="SmapiLauncher"/>）——
    /// 改名的启动器也算装了，否则这里会对着一个能正常玩的目录说「未检测到 SMAPI」。</summary>
    private bool HasSmapi(string? p)
        => SmapiLauncher.ExeFor(p, _launcherExe) is not null;

    private void SaveGamePath()
    {
        var cfg = Cfg.Current;
        cfg.GamePath = _gamePath;
        cfg.SmapiLauncherExe = (_launcherExe ?? "").Trim();   // 两个输入框共用一个「保存」
        Cfg.Save(cfg);
        ProbeManifest();   // v1.2.4：目录变了 → Steam 清单与锁状态重探
        RefreshLauncherStatus();
        _ = JS.InvokeVoidAsync("junigridJs.toast", HasSmapi(_gamePath)
            ? LocService.Tr("已保存游戏目录")
            : LocService.Tr("已保存游戏目录（未检测到 SMAPI，可通过首页「Steam 官方」启动游玩）"));
    }

    /// <summary>启动项状态行。<b>一切以「这一次实际会用哪个」为准</b>（<see cref="SmapiLauncher.Resolve"/>）——
    /// 那一份判定同时管着启动、日志与报错文案，状态行自说自话的话，用户看到的和真跑起来的会是两回事。
    /// <para>v1.6.14：填过的路径失效时不再直接报红。切换游戏版本后那份绝对路径必然指不到新目录，
    /// 而改名的壳本来就能靠版本资源认出来 —— 这时继续按目录识别才是用户要的结果，
    /// 只在"识别也失败了"的时候才需要他动手。</para></summary>
    private void RefreshLauncherStatus()
    {
        var configured = (_launcherExe ?? "").Trim();
        var pick = SmapiLauncher.Resolve(_gamePath, configured);

        // 指定的那份真的在 ⇒ 按它说（还没落盘的用户输入也算）
        if (pick.Origin == LauncherOrigin.Custom && pick.ExePath is { } custom)
        {
            // SMAPI 的壳按「自己所在的目录」找本体 —— 指到别处（桌面、下载文件夹）基本启动不起来，
            // 但仍然允许保存，只把话说在前面。
            if (!IsInGameRoot(custom, _gamePath))
                (_launcherStatus, _launcherWarn) = (LocService.Tf(
                    "使用指定启动项：{0}（它不在游戏目录下，SMAPI 可能找不到游戏本体）", Path.GetFileName(custom)), true);
            else
                (_launcherStatus, _launcherWarn) = (LocService.Tf("使用指定启动项：{0}", Path.GetFileName(custom)), false);
            return;
        }

        // 剩下的都是"按目录自动识别"的结果。填过东西却没生效时，要先把这句话说出来，
        // 否则用户会以为「已自动识别到 X」是对他那一行的确认。
        var prefix = configured.Length > 0 && pick.Warning is not null ? pick.Warning + "；" : "";
        switch (pick.Origin)
        {
            case LauncherOrigin.Standard:
                (_launcherStatus, _launcherWarn) =
                    (prefix + LocService.Tr("自动：使用游戏目录下的 StardewModdingAPI.exe"), false);
                break;
            case LauncherOrigin.Renamed:
                (_launcherStatus, _launcherWarn) = (prefix + LocService.Tf(
                    "已自动识别到改名的启动器：{0}（留空即可，换版本会按当时的目录重新认）", pick.ExeName), false);
                break;
            case LauncherOrigin.Ambiguous:
                (_launcherStatus, _launcherWarn) = (prefix + LocService.Tf(
                    "游戏目录里有多个像 SMAPI 启动器的 exe（{0}），无法确定用哪个 —— 请点「浏览...」指定",
                    string.Join("、", pick.Candidates.Select(Path.GetFileName))), true);
                break;
            default:
                // 分成两种：装过 SMAPI（有 smapi-internal）但壳不见了 vs 这一版压根没装。
                // 两种情况该做的事完全不同 —— 一个要去找壳，一个要去装 SMAPI。
                var installed = !string.IsNullOrWhiteSpace(_gamePath)
                                && Directory.Exists(Path.Combine(_gamePath, "smapi-internal"));
                (_launcherStatus, _launcherWarn) = installed
                    ? (LocService.Tr("这个游戏目录装过 SMAPI，但找不到启动器（可能被删掉或改成了认不出来的名字）—— 点「浏览...」选中它，或重新安装一次 SMAPI"), true)
                    : (LocService.Tr("这个版本的游戏目录里还没装 SMAPI —— 到「Mod 管理」页点「下载安装 SMAPI」即可，装好后这里会自动认出来"), false);
                break;
        }
    }

    private static bool IsInGameRoot(string exePath, string? gamePath)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(gamePath)) return true;   // 没配目录就没法比，不误报
            var exeDir = Path.GetDirectoryName(Path.GetFullPath(exePath));
            var gameDir = Path.GetFullPath(gamePath).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            return exeDir is not null
                && string.Equals(exeDir.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                                 gameDir, StringComparison.OrdinalIgnoreCase);
        }
        catch { return true; }
    }

    /// <summary>输入框改了但还没落盘 —— 只更新状态行，别偷偷写配置（用户可能只是路过看看）。</summary>
    private void OnLauncherTyped()
    {
        RefreshLauncherStatus();
        StateHasChanged();
    }

    private void PickLauncher()
    {
        var picked = FilePicker.PickExe(
            LocService.Tr("选择 SMAPI 启动器（StardewModdingAPI.exe 或改名后的它）"),
            string.IsNullOrWhiteSpace(_launcherExe) ? _gamePath : _launcherExe);
        if (picked is null) return;
        _launcherExe = picked;
        SaveLauncher();
    }

    /// <summary>自动识别：走的就是启动时那套判定（<see cref="SmapiLauncher.Resolve"/>），
    /// 认出唯一一个就填进去落盘 —— 让「这次碰巧能启动」变成「以后都能启动」。</summary>
    private void AutoFindLauncher()
    {
        var pick = SmapiLauncher.Resolve(_gamePath, null);
        switch (pick.Origin)
        {
            case LauncherOrigin.Renamed when pick.ExePath is { } exe:
                _launcherExe = exe;
                SaveLauncher();
                _ = JS.InvokeVoidAsync("junigridJs.toast",
                    LocService.Tf("已识别到启动器：{0}", pick.ExeName), "ok");
                return;
            case LauncherOrigin.Standard:
                // 标准壳就在标准位置：指定它没有收益（升级 SMAPI 后仍是同一个），保持"自动"最稳
                _ = JS.InvokeVoidAsync("junigridJs.toast",
                    LocService.Tr("游戏目录里就是标准的 StardewModdingAPI.exe，不需要额外指定"), "ok");
                return;
            case LauncherOrigin.Ambiguous:
                _ = JS.InvokeVoidAsync("junigridJs.toast",
                    LocService.Tr("认出多个候选，无法确定用哪个 —— 请点「浏览...」自己选"), "err");
                break;
            default:
                // 不再一律说"没找到，去手动指定"：这一版压根没装 SMAPI 时，手动指定是个死胡同。
                // 状态行那边已经按「装过 / 没装过」分好了话，直接把它说给用户听。
                RefreshLauncherStatus();
                _ = JS.InvokeVoidAsync("junigridJs.toast", _launcherStatus,
                    _launcherWarn ? "err" : "ok");
                StateHasChanged();
                return;
        }
        RefreshLauncherStatus();
        StateHasChanged();
    }

    private void ClearLauncher()
    {
        _launcherExe = "";
        SaveLauncher();
    }

    private void SaveLauncher()
    {
        var cfg = Cfg.Current;
        cfg.SmapiLauncherExe = (_launcherExe ?? "").Trim();
        Cfg.Save(cfg);          // Save 内部会把它的进程名同步进判活名单
        _launcherExe = cfg.SmapiLauncherExe;
        RefreshLauncherStatus();
        StateHasChanged();
    }

    private bool _detecting;

    // 探测整体丢线程池（Game.DetectGamePathAsync）：旧版同步跑在渲染线程上，
    // 一旦碰上没就绪的盘（网络映射盘/拔掉的移动硬盘）整个界面就冻在那儿。
    private async Task AutoDetect()
    {
        if (_detecting) return;
        _detecting = true;
        StateHasChanged();
        try
        {
            var detected = await Game.DetectGamePathAsync(Cfg.Current.SteamAppId, refresh: true);
            if (!string.IsNullOrEmpty(detected))
            {
                _gamePath = detected;
                if (IsValidGamePath(detected))
                {
                    SaveGamePath();
                }
                else
                {
                    _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("检测到目录，但里面没有 Stardew Valley.exe，请手动选择游戏目录"), "err");
                }
            }
            else
            {
                _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("未自动检测到游戏目录，请点「浏览...」手动选择"), "err");
            }
        }
        finally
        {
            _detecting = false;
            StateHasChanged();
        }
    }

    private void Pick()
    {
        // 从输入框当前填的目录开始浏览
        var picked = FolderPicker.Pick(LocService.Tr("选择 Stardew Valley 游戏目录"), _gamePath);
        if (picked is null) return;
        _gamePath = picked;
        if (IsValidGamePath(_gamePath))
        {
            SaveGamePath();
        }
        else
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("请选择包含 Stardew Valley.exe 的游戏目录"), "err");
        }
    }

    private void Save()
    {
        if (!IsValidGamePath(_gamePath))
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("目录无效：请填写包含 Stardew Valley.exe 的游戏目录"), "err");
            return;
        }
        SaveGamePath();
    }
}

    /// <summary>开关切换：展开 = 先让 Blazor 摘掉 display:none 再播动画；
    /// 收起 = 趁面板还可见先播收拢动画，播完才真正隐藏（保证两个方向的动画都能看见）。</summary>
    private async Task ToggleMemTimer()
    {
        if (_memTimer)
        {
            await AnimatePanelAsync(_timerPanel, false);
            _memTimer = false;
        }
        else
        {
            _memTimer = true;
            StateHasChanged();
            await AnimatePanelAsync(_timerPanel, true);
        }
        SaveMemCfg();
        StateHasChanged();
    }

    private async Task ToggleMemThreshold()
    {
        if (_memThreshold)
        {
            await AnimatePanelAsync(_thresholdPanel, false);
            _memThreshold = false;
        }
        else
        {
            _memThreshold = true;
            StateHasChanged();
            await AnimatePanelAsync(_thresholdPanel, true);
        }
        SaveMemCfg();
        StateHasChanged();
    }

    /// <summary>滑杆面板随开关弹性开合（与下拉菜单同款 GSAP 曲线，见 interop.js collapseToggle）。
    /// JS 万一不可用：上面的 try/catch 让开关仍然立即生效，只是没有动画。</summary>
    private async Task AnimatePanelAsync(ElementReference el, bool open)
    {
        try { await JS.InvokeVoidAsync("junigridJs.collapseToggle", el, open); } catch { }
    }
    private void SaveMemCfg()
    {
        var cfg = Cfg.Current;
        cfg.MemTimerEnabled = _memTimer;
        cfg.MemTimerMinutes = _memTimerMinutes;
        cfg.MemThresholdEnabled = _memThreshold;
        cfg.MemThresholdPercent = _memThresholdPercent;
        Cfg.Save(cfg);
    }

    /// <summary>弹性滑杆拖动结束回调（JS → .NET）：落值 + 保存。</summary>
    [JSInvokable]
    public void OnElasticValue(string id, double value)
    {
        if (id == "timer") _memTimerMinutes = (int)Math.Clamp(value, 5, 240);
        else if (id == "threshold") _memThresholdPercent = (int)Math.Clamp(value, 50, 95);
        else return;
        SaveMemCfg();
        StateHasChanged();
    }

    private async Task CompressNow()
    {
        // 一键全压：自身（GC + 工作集换出）+ WebView2 子进程（工作集换出）
        var (before, after) = await Task.Run(() => Mem.CompressSelf());
        var msg = LocService.Tf("自身 {0} → {1}", ResumableDownload.FormatBytes(before), ResumableDownload.FormatBytes(after));
        var wv = await Task.Run(() => Mem.TrimWebView2());
        if (wv.count > 0)
            msg += LocService.Tf("；WebView2（{0} 进程）{1} → {2}", wv.count, ResumableDownload.FormatBytes(wv.before), ResumableDownload.FormatBytes(wv.after));
        _mem = Mem.GetSnapshot();
        StateHasChanged();
        await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("已压缩：") + msg);
    }

    private async Task TrimGameNow()
    {
        var n = await Task.Run(() => Mem.TrimGameWorkingSet());
        await JS.InvokeVoidAsync("junigridJs.toast",
            n > 0 ? LocService.Tf("已清理 {0} 个游戏进程的工作集", n) : "游戏未在运行", n > 0 ? null : "err");
    }

    // ─── v0.2.1：缓存与存储 ───
    private List<StorageCategory> _cats = new();

    // ─── v1.4.4：游戏版本缓存手风琴 ───
    private bool _verAccOpen;
    private List<DepotDownloaderService.StagedPackage> _verCaches = new();
    private (StorageService.StagingBucketKind Kind, string Path, long Bytes)[] _verBuckets = Array.Empty<(StorageService.StagingBucketKind, string, long)>();

    private void LoadVerCaches()
    {
        try
        {
            _verCaches = DepotQr.ListStagedPackages();
            AppLog.Warn("Storage", $"版本缓存列表：{_verCaches.Count} 项 " +
                string.Join(", ", _verCaches.Select(v => v.Label + ":" + v.SizeBytes)));
        }
        catch (Exception ex)
        {
            AppLog.Warn("Storage", "列出版本缓存失败: " + ex.Message);
            _verCaches = new();
        }
        LoadVerBuckets();
    }

    /// <summary>depot-staging 里的附属目录。大小要遍历目录树（Mods 备份可能几百 MB），
    /// 所以先以「计算中」占位、后台算完再填 —— 直接在本方法里算会卡住 UI 线程。</summary>
    private void LoadVerBuckets()
    {
        var rows = StorageService.ListStagingBuckets();
        _verBuckets = rows;
        if (rows.Length == 0) return;
        _ = Task.Run(() =>
        {
            var filled = StorageService.ListStagingBuckets();
            _ = InvokeAsync(() => { _verBuckets = filled; StateHasChanged(); });
        });
    }

    /// <summary>v1.4.5：下载任务结束自动刷新手风琴列表（之前只在展开时加载一次，
    /// 下载完成后新版本不出现，让人以为"只剩一个版本"）。刷新后强制面板高度归位 auto——
    /// GSAP 展开动画会把 height 固定为当时内容的高度，内容变多后不归位就会溢出/裁剪。</summary>
    private void OnCenterChangedForVerCache()
    {
        _ = InvokeAsync(async () =>
        {
            if (!_verAccOpen) return;
            var running = Center.Snapshot().Any(t => t.Kind == "gameversion" && t.Status == "running");
            if (!running)
            {
                LoadVerCaches();
                StateHasChanged();
                await Task.Delay(50);   // 等 Blazor 把新条目渲染进 DOM 再量高
                try { await JS.InvokeVoidAsync("junigridJs.eval",
                    "var p=document.querySelector('#jg-vercache-panel'); if(p&&p.classList.contains('open')){p.style.height='auto';p.style.overflow='';}"); }
                catch { }
            }
        });
    }

    private async Task ToggleVerCache()
    {
        _verAccOpen = !_verAccOpen;
        // 每次展开都重新扫盘 —— 避免只显示上次缓存的一条
        if (_verAccOpen) LoadVerCaches();
        await InvokeAsync(StateHasChanged);
        // 等 Blazor 把全部条目渲染进 DOM 再量高，否则 GSAP 只按旧内容高度展开
        await Task.Delay(30);
        try { await JS.InvokeVoidAsync("junigridJs.accordionToggle", "#jg-vercache-panel", _verAccOpen); } catch { }
        if (_verAccOpen)
        {
            await Task.Delay(420);   // 等展开动画结束
            try { await JS.InvokeVoidAsync("junigridJs.eval",
                "var p=document.querySelector('#jg-vercache-panel'); if(p&&p.classList.contains('open')){p.style.height='auto';p.style.overflow='';p.style.maxHeight='320px';}"); }
            catch { }
        }
    }

    // 版本缓存是硬删（Depot.DeleteStagedPackage → Directory.Delete），不进回收站、删了要重下几 GB
    // 才回得来，所以走上面那个确认弹窗；点「删除」只记目标，确认才真删。
    private DepotDownloaderService.StagedPackage? _pendingDeleteVer;
    private (StorageService.StagingBucketKind Kind, string Path, long Bytes)? _pendingBucket;

    private void AskDeleteVerCache(DepotDownloaderService.StagedPackage pkg)
    {
        _pendingDeleteVer = pkg;
        _pendingCleanId = null;
        _confirmCleanAll = false;
    }

    private async Task DoDeleteVerCache()
    {
        var pkg = _pendingDeleteVer;
        _pendingDeleteVer = null;
        if (pkg is null) return;
        if (!DepotQr.DeleteStagedPackage(pkg.ManifestId))
        {
            await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("删除失败（文件可能被占用）"), "err");
            return;
        }
        LoadVerCaches();
        _cats = Storage.GetCategories();
        _ = Storage.RefreshAllAsync(force: true);
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tf("已删除版本缓存 {0}", pkg.Label));
    }

    private string FmtSize(string id)
    {
        if (Storage.IsComputing(id)) return LocService.Tr("计算中…");
        var b = Storage.GetSize(id);
        return b < 0 ? "—" : ResumableDownload.FormatBytes(b);
    }

    private void OnStorageStats() => _ = InvokeAsync(StateHasChanged);

    private async Task CleanCat(string id)
    {
        var msg = await Storage.CleanCategoryAsync(id);
        _cats = Storage.GetCategories();
        await JS.InvokeVoidAsync("junigridJs.toast", msg);
    }

    private bool _restoringSaves;

    private async Task RestoreSaves()
    {
        if (_restoringSaves) return;
        _restoringSaves = true;
        try
        {
            var msg = await Storage.RestoreHiddenSavesAsync();
            _cats = Storage.GetCategories();
            await JS.InvokeVoidAsync("junigridJs.toast", msg);
        }
        finally { _restoringSaves = false; }
    }

    // ─── 确认弹窗：单项清理、一键清理、删某个版本缓存共用同一个框 ───
    private string? _pendingCleanId;
    private bool _confirmCleanAll;

    private string ConfirmTitle => _pendingDeleteVer is not null ? "删除版本缓存"
        : _pendingBucket is not null ? (_pendingBucket.Value.Kind.Danger ? Loc.F("移出{0}", Loc.T(_pendingBucket.Value.Kind.Name)) : Loc.F("删除{0}", Loc.T(_pendingBucket.Value.Kind.Name)))
        : _confirmCleanAll ? "一键清理缓存" : "清理缓存";
    private string ConfirmOkLabel => _pendingDeleteVer is not null || _pendingBucket is not null
        ? Loc.T(_pendingBucket is { } pb && pb.Kind.Danger ? "确认移出" : "确认删除") : Loc.T("确认清理");
    private string ConfirmBody => _pendingDeleteVer is not null ? DeleteVerConfirmText
        : _pendingBucket is not null ? BucketConfirmText : CleanConfirmText;

    private string BucketConfirmText
    {
        get
        {
            var b = _pendingBucket!.Value;
            return b.Kind.Danger
                ? Loc.F("{0}（{1}）里的 mod 会移到游戏卸载回收站，不直接删。\n\n{2}\n\n反悔的话：在「缓存与存储」那行「游戏卸载回收站」里能拿回来；清空那个回收站之后就真没了。", Loc.T(b.Kind.Name), ResumableDownload.FormatBytes(b.Bytes), Loc.T(b.Kind.Tip))
                : Loc.F("{0}（{1}）将被删除。\n\n{2}", Loc.T(b.Kind.Name), ResumableDownload.FormatBytes(b.Bytes), Loc.T(b.Kind.Tip));
        }
    }

    private void AskDeleteBucket((StorageService.StagingBucketKind Kind, string Path, long Bytes) b)
    {
        _pendingBucket = b; _pendingCleanId = null; _confirmCleanAll = false; _pendingDeleteVer = null;
    }

    private async Task DoDeleteBucket()
    {
        var b = _pendingBucket;
        _pendingBucket = null;
        if (b is null) return;
        var msg = await Storage.CleanStagingBucketAsync(b.Value.Kind.Key);
        _cats = Storage.GetCategories();
        LoadVerCaches();
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("junigridJs.toast", msg);
    }

    private string DeleteVerConfirmText
    {
        get
        {
            var v = _pendingDeleteVer!;
            // 正文（含"抽屉里还存着 N 个 mod 文件夹"）走服务层单一口径 —— 版本管理弹窗删的是
            // 同一个目录，两处不能一个报 mod 一个不报。这里只补本机授权这一句事实。
            return DepotDownloaderService.DeletePackConfirmText(v)
                 + "\n\nSteam 授权还在，重新下载不用再扫一次码。";
        }
    }

    private async Task DoConfirm()
    {
        if (_pendingDeleteVer is not null) await DoDeleteVerCache();
        else if (_pendingBucket is not null) await DoDeleteBucket();
        else await DoClean();
    }

    private string CleanConfirmText
    {
        get
        {
            if (_confirmCleanAll)
            {
                var n = _cats.Count(x => x.Cleanable && x.Id != "vercache");
                return Loc.T("将逐个清理全部可清理缓存（不含游戏版本缓存 —— 每个版本的去留在版本管理里单独决定）。\n\n")
                     + Loc.T("正在使用的文件会自动跳过；游戏卸载回收站清空后无法恢复。");
            }
            var c = _cats.FirstOrDefault(x => x.Id == _pendingCleanId);
            if (c is null) return Loc.T("确定清理吗？");
            return Loc.F("将清理「{0}」。\n\n{1}\n\n正在使用的文件会自动跳过。", Loc.T(c.Name), Loc.T(c.Tip));
        }
    }

    private void AskClean(string id) { _confirmCleanAll = false; _pendingCleanId = id; }
    private void AskCleanAll() { _pendingCleanId = null; _confirmCleanAll = true; }
    private void CancelClean()
    {
        _pendingCleanId = null; _confirmCleanAll = false; _pendingDeleteVer = null; _pendingBucket = null;
    }

    private async Task DoClean()
    {
        var all = _confirmCleanAll;
        var id = _pendingCleanId;
        CancelClean();
        if (all)
        {
            // 版本缓存不参与一键清理 —— 每个历史版本的去留在版本管理里单独决定
            foreach (var c in _cats.Where(x => x.Cleanable && x.Id != "vercache").ToList())
                await Storage.CleanCategoryAsync(c.Id);
            await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("全部缓存已处理完（版本缓存不受影响），详见任务记录"));
        }
        else if (id is not null)
        {
            await CleanCat(id);
        }
    }

    private async Task RefreshStats()
    {
        var ok = await Storage.RefreshAllAsync(force: true);
        await JS.InvokeVoidAsync("junigridJs.toast",
            ok ? LocService.Tr("占用刷新成功") : LocService.Tr("占用刷新失败 请重试"), ok ? null : "err");
    }

    // ─── 更改统一缓存目录：可迁移项（下载/SMAPI/WebView2/Mods 备份）一起跟着走 ───
    private string? _pendingRoot;


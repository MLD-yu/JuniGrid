@namespace JuniGrid.Components.Pages
@page "/settings"
@using JuniGrid.Components
@implements IDisposable
@inject ConfigService Cfg
@inject GameService Game
@inject SteamService Steam
@inject NexusService NexusApi
@inject NexusOAuthService OAuth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject StorageService Storage
@inject MemoryService Mem
@inject DepotDownloaderService DepotQr
@inject LauncherService Launcher
@inject TaskCenterService Center

<div class="jg-page">
    <h1 style="margin-top:0">@Loc.T("设置")</h1>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("账号")</div>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:8px;">
            <div style="display:flex;align-items:center;gap:10px;">
                @if (_steam.Found && _steam.AvatarDataUri is not null)
                {
                    <img src="@_steam.AvatarDataUri" alt="steam" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    @* 未登录 / 拿不到头像 → 用项目内置 Steam 圆标兜底（与 Nexus 兜底图标同款式） *@
                    <img src="assets/steam.svg" alt="steam" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                <div style="flex:1">
                    <div style="font-weight:600;display:flex;align-items:center;gap:6px;">
                        Steam · @(_steam.Found ? (_steam.PersonaName ?? _steam.AccountName ?? Loc.T("已登录")) : Loc.T("未登录"))
                        @if (DdAuthorized)
                        {
                            <span class="jg-auth-badge">@Loc.T("下载已授权")</span>
                        }
                    </div>
                    <div style="font-size:12px;opacity:.65">
                        @if (DdAuthorized)
                        {
                            <text>@Loc.F("历史版本下载免密{0}", GetDdAccountSuffix())</text>
                        }
                        else
                        {
                            <text>@Loc.T("Steam 客户端级登录，切换账号请在 Steam 里操作；下载历史版本前需登录授权")</text>
                        }
                    </div>
                </div>
                @if (DdAuthorized)
                {
                    <button class="jg-nexus-logout-btn" @onclick="DdRevoke">@Loc.T("解除授权")</button>
                }
                else
                {
                    <button class="jg-nexus-login-btn" @onclick="OpenDdQr">@Loc.T("登录授权")</button>
                }
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                @if (!string.IsNullOrEmpty(_nexusAvatar))
                {
                    <img src="@_nexusAvatar" alt="nexus" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    <img src="assets/nav/nexus.svg" alt="nexus" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                <div style="flex:1">
                    <div style="font-weight:600;display:flex;align-items:center;gap:6px;">Nexus · @(string.IsNullOrEmpty(_nexusName) ? Loc.T("未登录") : _nexusName) @if (_nexusPremium) { <span class="jg-premium-badge">Premium</span> }</div>
                    <div style="font-size:12px;opacity:.65">@(string.IsNullOrEmpty(_nexusName) ? Loc.T("登录后可使用 Nexus 下载与安装") : Loc.T("Nexus Mods 账号已登录"))</div>
                </div>
                @if (!string.IsNullOrEmpty(_nexusName))
                {
                    <button class="jg-nexus-logout-btn" @onclick="NexusLogout">@Loc.T("退出 Nexus")</button>
                }
                else
                {
                    <button class="jg-nexus-login-btn" @onclick='() => Nav.NavigateTo("/nexus?login=1")'>@Loc.T("登录")</button>
                }
            </div>
        </div>
    </div>

    @* ─── Steam 下载授权：左账密 / 右扫码 并排（仿 Steam 官方登录页）───
       任何时刻只有一路登录活着：点「登录」取消扫码，点扫码刷新取消账密（同账号两路会互踢）。 *@
    @if (_ddQrOpen)
    {
        @* 遮罩不关窗：密码敲一半、验证码刚复制好时，点别处不该把整个登录丢掉；关它只用下面的按钮。 *@
        <div class="jg-modal-overlay" data-backdrop-keep>
            <div class="jg-modal jg-steam-login" @onclick:stopPropagation>
                <div class="jg-steam-cols">
                    @* 左：账号密码。标签在上、输入框满列宽、主按钮贴在列底 —— 与右列二维码底边齐平。 *@
                    <div class="jg-steam-col">
                        <div class="jg-steam-col-title">@Loc.T("用账号名称登录")</div>
                        <label class="jg-steam-label" for="jg-dd-acc">@Loc.T("账号名称")</label>
                        <input id="jg-dd-acc" class="jg-ver-input" placeholder="@Loc.T("登录名，不是昵称")"
                               @bind="_ddPwdAccount" @bind:event="oninput" disabled="@_ddPwdBusy"
                               @onkeydown="OnDdLoginKeyDown"/>
                        <label class="jg-steam-label" for="jg-dd-pwd">@Loc.T("密码")</label>
                        <input id="jg-dd-pwd" class="jg-ver-input" type="password" placeholder="@Loc.T("Steam 密码")"
                               @bind="_ddPwdPassword" @bind:event="oninput" disabled="@_ddPwdBusy" autocomplete="off"
                               @onkeydown="OnDdLoginKeyDown"/>
                        @if (!string.IsNullOrEmpty(_ddPwdError))
                        {
                            <div class="jg-qr-err jg-steam-err">@Loc.T(_ddPwdError)</div>
                        }
                        <div class="jg-steam-actions">
                            <button type="button" class="jg-steam-submit" disabled="@_ddPwdBusy"
                                    @onclick="RunDdPasswordAsync">
                                @if (_ddPwdBusy)
                                {
                                    <span class="jg-steam-submit-busy"><span class="jg-login-spinner"></span>@Loc.T("正在登录…")</span>
                                }
                                else
                                {
                                    @Loc.T("登录")
                                }
                            </button>
                        </div>
                    </div>

                    <div class="jg-steam-col">
                        <div class="jg-steam-col-title">@Loc.T("或者用二维码登录")</div>
                        @if (_ddQrLines is { Count: >= 27 })
                        {
                            <div class="jg-qr-stage vector"><QrAsciiImage Lines="_ddQrLines" Size="420" /></div>
                            <div class="jg-qr-hint">@Loc.T(DdQrScanHint)</div>
                        }
                        else if (!string.IsNullOrEmpty(_ddQrDataUri))
                        {
                            <div class="jg-qr-stage">
                                <img class="qr" src="@_ddQrDataUri" alt='@Loc.T("扫码登录")' @onerror="OnQrImgError"/>
                            </div>
                            <div class="jg-qr-hint">@Loc.T(DdQrScanHint)</div>
                        }
                        else if (_ddQrFailed)
                        {
                            @* 失败只说一件事 + 原位刷新，不堆长文案 *@
                            <div class="jg-qr-stage fail">
                                <div class="veil"></div>
                                <button type="button" class="jg-qr-refresh" title="@Loc.T("刷新二维码")"
                                        @onclick="RestartQrAsync">⟳</button>
                            </div>
                            <div class="jg-qr-hint">@Loc.T("二维码获取失败")</div>
                        }
                        else if (_ddQrBusy)
                        {
                            <div class="jg-qr-stage"><div class="veil"></div><div class="hub"><div class="ring"></div></div></div>
                            <div class="jg-qr-hint">@Loc.T("正在获取二维码…")</div>
                        }
                        else if (_ddDone)
                        {
                            @* 授权成功那一瞬：右栏也跟着表个态，别在这 600ms 里还摆一颗刷新按钮 *@
                            <div class="jg-qr-stage"><div class="veil"></div><div class="hub"><div class="ring"></div></div></div>
                            <div class="jg-qr-hint">@Loc.T("授权成功")</div>
                        }
                        else if (_ddPwdBusy)
                        {
                            @* 账密那路在跑：右栏只说明「这一路在用」，不再摆刷新按钮 ——
                               那颗按钮曾经在登录成功的瞬间被点到，把已经在关的弹窗又拉回运行态。
                               提示行兼作实时进度位（连接重试/收尾等），高度有预留不跳窗。 *@
                            <div class="jg-qr-stage"><div class="veil"></div><div class="hub"><div class="ring"></div></div></div>
                            <div class="jg-qr-hint">@(string.IsNullOrEmpty(_ddPwdLive) ? Loc.T("正在用账号密码登录…") : _ddPwdLive)</div>
                        }
                        else
                        {
                            <div class="jg-qr-stage fail">
                                <div class="veil"></div>
                                <button type="button" class="jg-qr-refresh" title="@Loc.T("刷新二维码")"
                                        @onclick="RestartQrAsync">⟳</button>
                            </div>
                            <div class="jg-qr-hint">@Loc.T("扫码登录")</div>
                        }
                    </div>
                </div>
                <div class="jg-steam-footer">
                    @if (_ddQrFailed)
                    {
                        <button type="button" class="jg-path-btn" @onclick="GoSteamDownload">@Loc.T("改用 Steam 下载（免扫码）")</button>
                    }
                    <button type="button" class="jg-path-btn" @onclick="CloseDdQr">@((_ddQrBusy || _ddPwdBusy) ? Loc.T("取消") : Loc.T("关闭"))</button>
                </div>
            </div>
        </div>
    }


    @* ─── Steam Guard 验证码：独立弹窗 + CodeSlots 式槽位输入 ───
       输满 5 位自动提交；提交后弹窗留着等 Steam 的判定 ——
       判错：红染倒序退场后再要一次；判对：登录收尾统一关窗。 *@
    @if (_ddGuardOpen)
    {
        <div class="jg-modal-overlay jg-guard-overlay" data-backdrop-keep>
            <div class="jg-modal jg-guard-modal">
                <div class="jg-modal-title">@Loc.T("Steam Guard 验证码")</div>
                <div class="jg-guard-sub">
                    @if (_ddGuardSuccess)
                    {
                        @* 空分支是故意的：否则会落到下面 else，把「请输入验证码」在成功那 1.2s 里又摆回来 *@
                    }
                    else if (_ddGuardError)
                    {
                        <span class="jg-guard-err">@Loc.T("上一条验证码不正确，请重新输入")</span>
                    }
                    else if (_ddGuardBusy)
                    {
                        <span class="jg-guard-busy"><span class="jg-login-spinner"></span>@Loc.T(string.IsNullOrEmpty(_ddGuardPrompt) ? "正在连接 Steam，连接后自动提交…" : "正在验证…")</span>
                    }
                    else
                    {
                        <span>@Loc.T("输入手机令牌 App 或邮箱里的 5 位验证码，输满自动提交")</span>
                    }
                </div>
                <div id="jg-guard-slots" class="gs">
                    <div class="gs-row">
                        <input class="gs-input" type="text" autocomplete="one-time-code" aria-label="Steam Guard code" />
                        @for (var i = 0; i < 5; i++)
                        {
                            <span class="gs-slot"><span class="gs-fill"></span><span class="gs-digit"></span></span>
                        }
                        <span class="gs-caret"><span class="gs-caret-line"></span></span>
                        <span class="gs-wash" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>
                        </span>
                    </div>
                </div>
                <div>
                    <button type="button" class="jg-guard-cancel" disabled="@((_ddGuardBusy && !string.IsNullOrEmpty(_ddGuardPrompt)) || _ddGuardSuccess)"
                            @onclick="CancelGuardPopup">@Loc.T("取消")</button>
                </div>
            </div>
        </div>
    }

    @* 手机确认与验证码弹窗互斥，仅按 Steam 返回的验证方式显示。 *@
    @if (_ddMobileConfirm)
    {
        <div class="jg-modal-overlay jg-guard-overlay" data-backdrop-keep>
            <div class="jg-modal jg-guard-modal">
                <div class="jg-modal-title">@Loc.T("使用 Steam 手机应用来确认登录…")</div>
                <div class="jg-mobile-wait"><span class="jg-login-spinner large"></span></div>
                <div style="display:flex; gap:8px; justify-content:center; flex-wrap:wrap;">
                    <button type="button" class="jg-guard-cancel" @onclick="SwitchToCodeLogin">@Loc.T("改为输入代码")</button>
                    <button type="button" class="jg-guard-cancel" @onclick="CancelGuardPopup">@Loc.T("取消")</button>
                </div>
            </div>
        </div>
    }

    @* ── i18n：界面语言（复用 Mod 管理页同款自定义下拉，不用原生 select）── *@
    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("界面语言")</div>
        <div class="jg-sort-dd jg-lang-dd @(_langOpen ? "open" : "")" data-dd="lang" style="margin-top:8px; width:fit-content; max-width:100%">
            <button class="jg-sort-trigger" @onclick="ToggleLang">
                @(Loc.Lang == "en" ? "English" : "简体中文")
                <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="jg-sort-menu">
                <button class="jg-sort-item @(Loc.Lang == "zh" ? "active" : "")" @onclick='() => PickLang("zh")'>@Loc.T("简体中文")</button>
                <button class="jg-sort-item @(Loc.Lang == "en" ? "active" : "")" @onclick='() => PickLang("en")'>English</button>
            </div>
        </div>
        <div class="jg-dd-overlay @(_langOpen ? "open" : "")" data-dd="lang" @onclick="CloseLang"></div>
    </div>

    @* ── 颜色主题（data-accent 轴；纯 CSS 变量，切换即时全站重上色，无需重载）── *@
    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("颜色主题")</div>
        <div class="jg-accent-grid">
            @foreach (var a in Accents)
            {
                var accent = a.Key == "system" ? SystemHex : a.Accent;
                var cur = Cfg.Current.Accent == a.Key;
                <button class="jg-accent-card @(cur ? "cur" : "")" data-key="@a.Key" @onclick="(e) => SetAccent(a.Key, e)">
                    <span class="jg-accent-mock" style="@($"--mock-accent:{accent}")">
                        <span class="jg-mock-bar"></span>
                        <span class="jg-mock-dot @(cur ? "on" : "")"></span>
                        <span class="jg-mock-panel"><i></i><i></i></span>
                    </span>
                    <span class="jg-accent-name">@(Loc.Lang == "en" ? a.En : a.Zh)</span>
                </button>
            }
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("游戏目录")</div>
        <input class="jg-ver-input" style="margin-top:6px" @bind="_gamePath"
               placeholder='@Loc.T("例：C:\\Program Files (x86)\\Steam\\steamapps\\common\\Stardew Valley")' />

        <div style="display:flex;gap:8px;margin-top:8px">
            <button type="button" class="jg-path-btn" @onclick="Pick">@Loc.T("浏览...")</button>
            <button type="button" class="jg-path-btn" @onclick="AutoDetect" disabled="@_detecting">@Loc.T("自动检测")</button>
            <button type="button" class="jg-path-btn primary" @onclick="Save">@Loc.T("保存")</button>
        </div>

        @* ─── v1.3.4：启动项 ───
           SMAPI 的启动壳就是根目录一个朴素的 StardewModdingAPI.exe，很多人改名成 SMAPI.exe
           好在文件夹里一眼看见。改名不影响运行，但我们按文件名硬找就会报「未找到 SMAPI」。
           留空 = 自动（标准壳 → 根目录里认得出来的改名壳）；指定了就只认指定的那个。 *@
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--jg-line)">
            <div style="display:flex;align-items:center;gap:6px">
                <span style="font-weight:600">@Loc.T("启动项")</span>
                <span class="jg-help-tip">
                    <span class="jg-help-tip-btn">?</span>
                    <span class="jg-help-tip-bubble">@Loc.T("留空 = 每次启动都按当前游戏目录自动认：先找 StardewModdingAPI.exe，找不到就在根目录里认出改了名的壳（SMAPI.exe、启动MOD.exe 都行，改名不影响它的版本信息）。切换游戏版本后也是按当时的目录重新认，不需要为每个版本各填一次。")</span>
                </span>
            </div>
            <input class="jg-ver-input" style="margin-top:6px" @bind="_launcherExe" @bind:after="OnLauncherTyped"
                   placeholder='@Loc.T("留空 = 自动（游戏目录下的 StardewModdingAPI.exe）")' />
            <div style="display:flex;gap:8px">
                <button type="button" class="jg-path-btn" @onclick="PickLauncher">@Loc.T("浏览...")</button>
                <button type="button" class="jg-path-btn" @onclick="AutoFindLauncher">@Loc.T("自动识别")</button>
                <button type="button" class="jg-path-btn" @onclick="ClearLauncher">@Loc.T("恢复默认")</button>
            </div>
            <div style="margin-top:8px;font-size:12px;line-height:1.5;word-break:break-all;
                        color:@(_launcherWarn ? "var(--jg-danger)" : "var(--jg-text-3)")">@_launcherStatus</div>
        </div>

        @* ─── v1.2.4：游戏版本锁定 —— Steam 版才有 appmanifest，非 Steam 目录自动降级为说明文字 ─── *@
        @if (_manifestPath is not null)
        {
            <div class="jg-switch-col" style="margin-top:10px">
                <div class="jg-switch-row @(_manifestLocked ? "on" : "")" @onclick="ToggleLockGameVersion">
                    <span style="display:flex;align-items:center;gap:8px">
                        <span>@Loc.T("锁定游戏版本")</span>
                        <span class="jg-help-tip">
                            <span class="jg-help-tip-btn">?</span>
                            <span class="jg-help-tip-bubble">@Loc.T("开启后 Steam 无法更新游戏本体（含 Steam 启动前的强制更新），当前版本会一直保持可玩 —— 适合想留在旧版本搭配旧 mod 的玩家。想更新游戏时，先关闭本开关再启动。")</span>
                        </span>
                    </span>
                    <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                </div>
            </div>
        }
        else
        {
            <div style="font-size:12px;opacity:.6;margin-top:8px">@Loc.T("未找到 Steam 版清单文件（appmanifest）—— 版本锁定仅适用于 Steam 版游戏目录。")</div>
        }

    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">@Loc.T("Nexus 安装")</div>
        <div class="jg-switch-col">
            @* ─── v1.2.5：一个开关管两头 —— 应用内详情页按钮走不走浏览器，以及系统层
               HKCU\Software\Classes\nxm 归谁（浏览器点「Mod Manager Download」时 Windows 交给谁，
               注册表只有一个值，谁最后写谁赢）。原先是两行开关，已合并。─── *@
            <div class="jg-switch-row @(_oneClickInstall ? "on" : "")" @onclick="ToggleOneClick">
                <span style="display:flex;align-items:center;gap:8px">
                    <span>@Loc.T("一键安装")</span>
                    <span class="jg-help-tip">
                        <span class="jg-help-tip-btn">?</span>
                        <span class="jg-help-tip-bubble">@Loc.T("详情页点「安装」时免弹浏览器，直接在后台下载并装进 Mods。")<br />@Loc.T("同时接管 Nexus 下载链接：在网页点「Mod Manager Download」会直接交给 JuniGrid 下载，而不是 Vortex 等其它管理器。")<br />@Loc.T("注意：开着时 JuniGrid 每次启动都会重新接管一次；关闭则把链接交还给之前接管它的管理器（Vortex / NMM），若那个管理器已经不存在，就清空这条注册。")</span>
                    </span>
                </span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
            <div class="jg-switch-row @(_autoInstall ? "on" : "") @(!_nexusPremium ? "disabled" : "")" @onclick="ToggleAutoInstall">
                <span style="display:flex;align-items:center;gap:8px">
                    <span>@Loc.T("自动安装更新")</span>
                    @if (!_nexusPremium)
                    {
                        @* v1.x：GSAP 弹性 tooltip 问号（仅非 Premium 显示），hover 弹出、移开立即消失 *@
                        <span class="jg-help-tip">
                            <span class="jg-help-tip-btn">?</span>
                            <span class="jg-help-tip-bubble">@Loc.T("此功能仅 Nexus Mods Premium 用户可用")<br />@Loc.T("当 mod 管理页面有 mod 需要更新时，系统会自动为您更新")</span>
                        </span>
                    }
                </span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
            @* v1.3.84：内置网页取链的总闸。关掉后不再开 WebView2 窗口，
               免费账号也就拿不到直链（Premium 走 API，不受影响）。 *@
            <div class="jg-switch-row @(_builtinWeb ? "on" : "")" @onclick="ToggleBuiltinWeb">
                <span style="display:flex;align-items:center;gap:8px">
                    <span>@Loc.T("通过内置 N 网网页下载")</span>
                </span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>

@namespace JuniGrid.Components.Pages
@page "/settings"
@using JuniGrid.Components
@implements IDisposable
@inject ConfigService Cfg
@inject GameService Game
@inject SteamService Steam
@inject NexusService NexusApi
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject StorageService Storage
@inject MemoryService Mem
@inject DepotDownloaderService DepotQr
@inject LauncherService Launcher
@inject TaskCenterService Center

<div class="jg-page">
    <h1 style="margin-top:0">设置</h1>
    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">账号</div>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:8px;">
            <div style="display:flex;align-items:center;gap:10px;">
                @if (_steam.Found && _steam.AvatarDataUri is not null)
                {
                    <img src="@_steam.AvatarDataUri" alt="steam" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    @* 未登录 / 拿不到头像 → 用项目内置 Steam 圆标兜底（与 Nexus 兜底图标同款式） *@
                    <img src="assets/steam.svg" alt="steam" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                <div style="flex:1">
                    <div style="font-weight:600;display:flex;align-items:center;gap:6px;">
                        Steam · @(_steam.Found ? (_steam.PersonaName ?? _steam.AccountName ?? "已登录") : "未登录")
                        @if (DdAuthorized)
                        {
                            <span class="jg-premium-badge" style="background:#2e7d32">下载已授权</span>
                        }
                    </div>
                    <div style="font-size:12px;opacity:.65">
                        @if (DdAuthorized)
                        {
                            <text>历史版本下载免密@(GetDdAccountSuffix())</text>
                        }
                        else
                        {
                            <text>Steam 客户端级登录，切换账号请在 Steam 里操作；下载历史版本前需扫码授权</text>
                        }
                    </div>
                </div>
                @if (DdAuthorized)
                {
                    <button class="jg-nexus-logout-btn" @onclick="DdRevoke">解除授权</button>
                }
                else
                {
                    <button class="jg-nexus-login-btn" @onclick="OpenDdQr">扫码授权</button>
                }
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                @if (!string.IsNullOrEmpty(_nexusAvatar))
                {
                    <img src="@_nexusAvatar" alt="nexus" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    <img src="assets/nav/nexus.svg" alt="nexus" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                }
                <div style="flex:1">
                    <div style="font-weight:600;display:flex;align-items:center;gap:6px;">Nexus · @(string.IsNullOrEmpty(_nexusName) ? "未登录" : _nexusName) @if (_nexusPremium) { <span class="jg-premium-badge">Premium</span> }</div>
                    <div style="font-size:12px;opacity:.65">@(string.IsNullOrEmpty(_nexusName) ? "登录后可使用 Nexus 下载与安装" : "Nexus Mods 账号已登录")</div>
                </div>
                @if (!string.IsNullOrEmpty(_nexusName))
                {
                    <button class="jg-nexus-logout-btn" @onclick="NexusLogout">退出 Nexus</button>
                }
                else
                {
                    <button class="jg-nexus-login-btn" @onclick='() => Nav.NavigateTo("/nexus?login=1")'>登录</button>
                }
            </div>
        </div>
    </div>

    @* ─── Steam 下载授权：扫码弹窗 ─── *@
    @if (_ddQrOpen)
    {
        <div style="position:fixed;inset:0;background:rgba(0,0,0,.65);display:flex;align-items:center;justify-content:center;z-index:1000" @onclick="CloseDdQr">
            <div class="jg-card" style="max-width:420px;padding:18px 22px" @onclick:stopPropagation>
                <div style="font-weight:600;margin-bottom:10px">Steam 扫码授权</div>

                @if (!string.IsNullOrEmpty(_ddQrError))
                {
                    <div class="jg-qr-err">@_ddQrError</div>
                }

                @if (_ddQrLines is { Count: >= 27 })
                {
                    @* 矢量码：白底 + 静区足，手机比 PNG data URI 好扫；台子按码自己的比例收（不占方形） *@
                    <div class="jg-qr-stage vector">
                        <QrAsciiImage Lines="_ddQrLines" Size="340" />
                    </div>
                    <div class="jg-qr-hint">@DdQrScanHint</div>
                }
                else if (!string.IsNullOrEmpty(_ddQrDataUri))
                {
                    <div class="jg-qr-stage">
                        <img class="qr" src="@_ddQrDataUri" alt="扫码授权"
                             @onerror="OnQrImgError"/>
                    </div>
                    <div class="jg-qr-hint">@DdQrScanHint</div>
                }
                else if (!string.IsNullOrEmpty(_ddQrError) && !_ddQrBusy)
                {
                    <div class="jg-qr-stage fail">
                        <div class="veil"></div>
                        <div class="hub"><span class="bang">!</span></div>
                    </div>
                }
                else
                {
                    @* 连接中：模糊码底 + 加载环，下面一行短进度（长文案会撑破弹窗，截到 48 字） *@
                    <div class="jg-qr-stage">
                        <div class="veil"></div>
                        <div class="hub"><div class="ring"></div></div>
                    </div>
                    <div class="jg-qr-hint">@(string.IsNullOrWhiteSpace(_ddQrState) ? "正在连接…" : DdQrHint)</div>
                }

                <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px">
                    @if (_ddQrBusy)
                    {
                        @* 出码截止是 20 秒，不该让人干等：点一下 1 秒内掐掉这一路马上重开，
                           而且这次重开不占用重试次数（用户主动要的，不是失败） *@
                        <button type="button" class="jg-path-btn" @onclick="KickQrRetry">立即重开</button>
                    }
                    <button type="button" class="jg-path-btn" @onclick="CloseDdQr">@(_ddQrBusy ? "取消" : "关闭")</button>
                </div>
            </div>
        </div>
    }


    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">游戏目录</div>
        <input class="jg-ver-input" style="margin-top:6px" @bind="_gamePath"
               placeholder="例：C:\Program Files (x86)\Steam\steamapps\common\Stardew Valley" />

        <div style="display:flex;gap:8px;margin-top:8px">
            <button type="button" class="jg-path-btn" @onclick="Pick">浏览...</button>
            <button type="button" class="jg-path-btn" @onclick="AutoDetect">自动检测</button>
            <button type="button" class="jg-path-btn primary" @onclick="Save">保存</button>
        </div>

        @* ─── v1.2.4：游戏版本锁定 —— Steam 版才有 appmanifest，非 Steam 目录自动降级为说明文字 ─── *@
        @if (_manifestPath is not null)
        {
            <div class="jg-switch-col" style="margin-top:10px">
                <div class="jg-switch-row @(_manifestLocked ? "on" : "")" @onclick="ToggleLockGameVersion">
                    <span style="display:flex;align-items:center;gap:8px">
                        <span>锁定游戏版本</span>
                        <span class="jg-help-tip">
                            <span class="jg-help-tip-btn">?</span>
                            <span class="jg-help-tip-bubble">开启后 Steam 无法更新游戏本体（含 Steam 启动前的强制更新），当前版本会一直保持可玩 —— 适合想留在旧版本搭配旧 mod 的玩家。想更新游戏时，先关闭本开关再启动。</span>
                        </span>
                    </span>
                    <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                </div>
            </div>
        }
        else
        {
            <div style="font-size:12px;opacity:.6;margin-top:8px">未找到 Steam 版清单文件（appmanifest）—— 版本锁定仅适用于 Steam 版游戏目录。</div>
        }

    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">Nexus 安装</div>
        <div class="jg-switch-col">
            <div class="jg-switch-row @(_oneClickInstall ? "on" : "")" @onclick="ToggleOneClick">
                <span style="display:flex;align-items:center;gap:8px">
                    <span>一键安装</span>
                </span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
            <div class="jg-switch-row @(_autoInstall ? "on" : "") @(!_nexusPremium ? "disabled" : "")" @onclick="ToggleAutoInstall">
                <span style="display:flex;align-items:center;gap:8px">
                    <span>自动安装更新</span>
                    @if (!_nexusPremium)
                    {
                        @* v1.x：GSAP 弹性 tooltip 问号（仅非 Premium 显示），hover 弹出、移开立即消失 *@
                        <span class="jg-help-tip">
                            <span class="jg-help-tip-btn">?</span>
                            <span class="jg-help-tip-bubble">此功能仅 Nexus Mods Premium 用户可用<br />当 mod 管理页面有 mod 需要更新时，系统会自动为您更新</span>
                        </span>
                    }
                </span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">内容过滤</div>
        <div class="jg-switch-col">
            @* 单一开关。默认关 = 一律排除成人内容；开 = 应用不加成人条件，
               列表随登录用户 Nexus 账号的成人内容设置执行（服务端强制），应用永不覆盖账号偏好 *@
            <div class="jg-switch-row @(_showAdult ? "on" : "")" @onclick="ToggleShowAdult">
                <span>显示成人内容</span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="display:inline-flex;align-items:center;gap:6px;cursor:pointer" @onclick='() => Nav.NavigateTo("/tasks")'>
            <div style="font-weight:600">任务管理</div>
            <img src="assets/task-arrow.svg" alt="前往任务管理" style="width:14px;height:14px;opacity:.75" />
        </div>
        <div class="jg-switch-col">
            <div class="jg-switch-row @(_showTaskDock ? "on" : "")" @onclick="ToggleTaskDock">
                <span style="display:flex;align-items:center;gap:8px">
                    <span>打开任务管理悬浮窗</span>
                </span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">内存管理</div>
        <div style="font-size:12px;opacity:.65;margin-top:2px">定时保养自身与 WebView2；系统占用告急时连同游戏一并释放</div>

        <div class="jg-mem-line" style="margin-top:8px">
            系统 @FmtMb(_mem?.SysTotalBytes)，可用 @FmtMb(_mem?.SysAvailBytes)（@Pct()%）· 自身 @FmtMb(_mem?.AppWorkingSet)
        </div>

        <div class="jg-kv-grid" style="margin-top:10px">
            <div class="jg-kv">
                <div class="k">自身进程</div>
                <div class="v">@FmtMb(_mem?.AppWorkingSet)<span class="jg-kv-sub">GC @FmtMb(_mem?.AppGcBytes)</span></div>
            </div>
            <div class="jg-kv">
                <div class="k">WebView2 子进程</div>
                <div class="v">@FmtMb(_mem?.WebViewWorkingSet)<span class="jg-kv-sub">@(_mem?.WebViewProcCount ?? 0) 个进程</span></div>
            </div>
            <div class="jg-kv">
                <div class="k">游戏进程</div>
                <div class="v">@(_mem is { GameRunning: true } ? FmtMb(_mem.GameWorkingSet) : "未运行")</div>
            </div>
            <div class="jg-kv">
                <div class="k">系统内存占用</div>
                <div class="v">@Pct()%</div>
            </div>
        </div>

        <div class="jg-switch-col" style="margin-top:6px">
            <div class="jg-switch-row @(_memTimer ? "on" : "")" @onclick="ToggleMemTimer">
                <span>定时自动压缩</span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
            @* 滑杆面板：初始隐藏由 Blazor 的 style 决定（不依赖 JS 时序），开合动画由 JS 弹性播放 *@
            <div class="jg-slider-panel" style="@(_memTimer ? null : "display:none")" @ref="_timerPanel">
                <div class="jg-slider-row">
                    <span class="jg-slider-label">定时释放</span>
                    <div class="e-slider" data-min="5" data-max="240" data-step="5" data-suffix="分" @ref="_timerSlider">
                        <div class="es-track-wrap"><div class="es-track"><div class="es-fill"></div></div></div>
                        <span class="es-value"></span>
                    </div>
                </div>
            </div>
            <div class="jg-switch-row @(_memThreshold ? "on" : "")" @onclick="ToggleMemThreshold">
                <span>占用阈值自动压缩</span>
                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
            </div>
            <div class="jg-slider-panel" style="@(_memThreshold ? null : "display:none")" @ref="_thresholdPanel">
                <div class="jg-slider-row">
                    <span class="jg-slider-label">占用阈值</span>
                    <div class="e-slider" data-min="50" data-max="95" data-step="1" data-suffix="%" @ref="_thresholdSlider">
                        <div class="es-track-wrap"><div class="es-track"><div class="es-fill"></div></div></div>
                        <span class="es-value"></span>
                    </div>
                </div>
            </div>
        </div>

        <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
            <button type="button" class="jg-path-btn" @onclick="CompressNow">立即压缩</button>
            <button type="button" class="jg-path-btn" @onclick="TrimGameNow">清理游戏内存</button>
        </div>
    </div>

    <div class="jg-card" style="margin-top:12px">
        <div style="font-weight:600">缓存与存储</div>
        <div style="font-size:12px;opacity:.65;margin-top:2px">各类缓存占用统计、清理与统一缓存目录</div>

        <div class="jg-mem-line" style="margin-top:8px;display:flex;align-items:center;gap:8px">
            <span>可清理缓存共 @FmtMb(Storage.TotalKnownBytes)</span>
        </div>

        <div style="margin-top:4px">
            @foreach (var c in _cats)
            {
                @if (c.Id == "vercache")
                {
                    @* ─── v1.4.4：游戏版本缓存手风琴（箭头在标题右侧） ─── *@
                    <div class="jg-store-row" style="flex-direction:column;align-items:stretch;gap:0">
                        <div style="display:flex;align-items:center;gap:10px;padding:9px 2px">
                            <button type="button" class="jg-acc-head" style="padding:0;flex:1;min-width:0;flex-direction:row"
                                    aria-expanded="@(_verAccOpen ? "true" : "false")"
                                    aria-controls="jg-vercache-panel" @onclick="ToggleVerCache">
                                <span class="jg-store-main" style="flex:1;min-width:0">
                                    <span class="jg-store-name" style="display:flex;align-items:center;gap:6px">
                                        @c.Name
                                        <svg class="jg-acc-chev" viewBox="0 0 16 16" fill="none" aria-hidden="true"
                                             style="display:inline-block;vertical-align:middle">
                                            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        @if (c.Movable) { <span class="jg-store-tag">可迁移</span> }
                                    </span>
                                    <span class="jg-store-path" title="@c.DisplayPath" style="display:block">@c.Note · @c.DisplayPath</span>
                                </span>
                            </button>
                            <div class="jg-store-size">@FmtSize(c.Id)</div>
                            <button type="button" class="jg-mini-btn" @onclick='() => OpenCatFolder(c)'>打开</button>
                        </div>
                        <div id="jg-vercache-panel" class="jg-acc-panel @(_verAccOpen ? "open" : "")">
                            <div class="jg-acc-inner">
                                @if (_verCaches.Count == 0)
                                {
                                    <div class="jg-acc-empty">尚未下载任何历史版本。在「游戏版本管理」里切换版本后会缓存在这里。</div>
                                }
                                @foreach (var v in _verCaches)
                                {
                                    <div class="jg-acc-item">
                                        <span class="jg-acc-item-name">@v.Label</span>
                                        <span class="jg-acc-item-size">@ResumableDownload.FormatBytes(v.SizeBytes)</span>
                                        <button type="button" class="jg-mini-btn danger-outline"
                                                @onclick="() => AskDeleteVerCache(v)">删除</button>
                                    </div>
                                }
                                @* 版本包之外的附属目录：删的代价不同的东西分行放（SMAPI 本体删了要重装、
                                   Mod 暂存里是用户的东西 → 那条走回收站），每条带「?」讲清是什么。 *@
                                @foreach (var b in _verBuckets)
                                {
                                    <div class="jg-acc-item">
                                        <span class="jg-acc-item-name" style="display:flex;align-items:center;gap:6px">
                                            @b.Kind.Name
                                            <span class="jg-help-tip">
                                                <span class="jg-help-tip-btn">?</span>
                                                <span class="jg-help-tip-bubble">@b.Kind.Tip</span>
                                            </span>
                                        </span>
                                        <span class="jg-acc-item-size">@(b.Bytes < 0 ? "计算中…" : ResumableDownload.FormatBytes(b.Bytes))</span>
                                        <button type="button" class="jg-mini-btn danger-outline"
                                                @onclick="() => AskDeleteBucket(b)">删除</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    continue;
                }
                <div class="jg-store-row">
                    <div class="jg-store-main">
                        <div class="jg-store-name">
                            @c.Name
                            @if (c.Movable) { <span class="jg-store-tag">可迁移</span> }
                            @if (!c.Cleanable) { <span class="jg-store-tag">固定</span> }
                        </div>
                        <div class="jg-store-path" title="@c.DisplayPath">@c.Note · @c.DisplayPath</div>
                    </div>
                    <div class="jg-store-size">@FmtSize(c.Id)</div>
                    @if (c.Cleanable)
                    {
                        <button type="button" class="jg-mini-btn" @onclick='() => AskClean(c.Id)'>清理</button>
                    }
                    <button type="button" class="jg-mini-btn" @onclick='() => OpenCatFolder(c)'>打开</button>
                </div>
            }
        </div>

        <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;align-items:center">
            <button type="button" class="jg-path-btn" @onclick="ChangeCacheRoot">更改缓存目录…</button>
            @if (!string.IsNullOrWhiteSpace(Cfg.Current.CacheRoot))
            {
                <button type="button" class="jg-path-btn" @onclick="ResetCacheRoot">恢复默认位置</button>
            }
            <button type="button" class="jg-path-btn" @onclick='() => RefreshStats()'>刷新占用</button>
            <button type="button" class="jg-path-btn primary" @onclick="AskCleanAll">一键清理</button>
        </div>
        <div class="jg-note" style="margin-top:6px">可迁移项统一存进缓存目录 更改时自动迁移 WebView2 在重启应用后生效 游戏回收站由游戏目录决定 设置数据固定不可迁移</div>
    </div>

    <div class="jg-card jg-cursor-grid" style="margin-top:12px">
        <div style="font-weight:600">关于</div>
        <div class="jg-about">
            <div class="jg-about-main">
                <div class="jg-about-leftcol">
                    <div class="jg-about-title-row">
                        <span class="jg-pixel-title">JuniGrid</span>
                        <span class="jg-about-title-side">
                            <span class="jg-shiny">· v@(AppInfo.Version)</span>
                            <span class="jg-about-desc">Your helper for Stardew Valley.</span>
                        </span>
                    </div>
                    <div class="jg-author-row">
                        <span>作者：</span>
                        <img src="assets/author-avatar.jpg" alt="MLD avatar" class="jg-author-avatar" />
                        <span class="jg-pixel-name">MLD</span>
                    </div>
                    <div class="jg-logoloop" aria-label="联系方式">
                        <div class="jg-ll-track">
                            <ul class="jg-ll-seq">
                                <li class="jg-ll-item">
                                    <a class="jg-ll-link" href="https://github.com/MLD-yu" target="_blank" rel="noreferrer noopener" title="GitHub">
                                        <img src="assets/logos/logo-github.svg" alt="GitHub" />
                                    </a>
                                </li>
                                <li class="jg-ll-item">
                                    <a class="jg-ll-link" href="javascript:void(0)" data-copy="yu2109292229@gmail.com" title="Gmail">
                                        <img src="assets/logos/logo-gmail.svg" alt="Gmail" />
                                    </a>
                                </li>
                                <li class="jg-ll-item">
                                    <a class="jg-ll-link" href="https://space.bilibili.com/385452339" target="_blank" rel="noreferrer noopener" title="哔哩哔哩">
                                        <img src="assets/logos/logo-bilibili.svg" alt="哔哩哔哩" />
                                    </a>
                                </li>
                                <li class="jg-ll-item">
                                    <a class="jg-ll-link" href="https://www.douyin.com/user/MS4wLjABAAAAFva5cHzXf-dy_N7_4sKzjVHRBXj7_mkQ9EzTUXI96QM?from_tab_name=main" target="_blank" rel="noreferrer noopener" title="抖音">
                                        <img src="assets/logos/logo-douyin.svg?v=2" alt="抖音" />
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="jg-sponsor">
                    <div class="jg-sponsor-title">赞助支持：</div>
                    <div class="jg-sponsor-sub">如果它能帮到你，可以请作者喝杯咖啡</div>
                    <div class="jg-sponsor-tabs">
                        <button type="button" class="jg-sponsor-tab @(_sponsorWechat ? "active" : "")" @onclick='() => _sponsorWechat = true'>微信</button>
                        <button type="button" class="jg-sponsor-tab @(!_sponsorWechat ? "active" : "")" @onclick='() => _sponsorWechat = false'>支付宝</button>
                    </div>
                    <img class="jg-sponsor-qr"
                         src="@(_sponsorWechat ? "assets/sponsor-wechat.jpg" : "assets/sponsor-alipay.jpg")"
                         alt="@(_sponsorWechat ? "微信赞赏码" : "支付宝收款码")" />
                </div>
            </div>
        </div>
    </div>
</div>

@if (_pendingRoot is not null)
{
    <div class="jg-modal-overlay" @onclick="CancelChangeRoot">
        <div class="jg-modal" @onclick:stopPropagation>
            <div class="jg-modal-title">更改缓存目录</div>
            <div class="jg-modal-body">
                下载/安装临时、SMAPI 安装包、Mods 备份将立即迁移到：<br />
                <b>@_pendingRoot</b><br /><br />
                WebView2 数据在重启应用后自动迁移（正在使用的文件除外，留在原处可稍后清理）。
            </div>
            <div class="jg-modal-actions">
                <button class="jg-path-btn" data-modal-close @onclick="CancelChangeRoot">取消</button>
                <button class="jg-path-btn primary" @onclick="ConfirmChangeRoot">开始迁移</button>
            </div>
        </div>
    </div>
}

@if (_pendingCleanId is not null || _confirmCleanAll || _pendingDeleteVer is not null || _pendingBucket is not null)
{
    <div class="jg-modal-overlay" @onclick="CancelClean">
        <div class="jg-modal" @onclick:stopPropagation>
            <div class="jg-modal-title">@ConfirmTitle</div>
            <div class="jg-modal-body">@ConfirmBody</div>
            <div class="jg-modal-actions">
                <button class="jg-path-btn" data-modal-close @onclick="CancelClean">取消</button>
                <button class="jg-path-btn primary" @onclick="DoConfirm">@ConfirmOkLabel</button>
            </div>
        </div>
    </div>
}

@code {
    private SteamProfile _steam = SteamProfile.None;
    private string _nexusName = "";
    private string? _nexusAvatar;
    private bool   _nexusPremium;
    private bool   _sponsorWechat = true;

    private void NexusLogout()
    {
        var cfg = Cfg.Current;
        cfg.NexusApiKey = "";
        cfg.NexusUserName = "";
        cfg.NexusProfileUrl = "";
        cfg.NexusIsPremium = false;
        cfg.NexusAvatarDataUri = "";
        Cfg.Save(cfg);
        _nexusName = ""; _nexusAvatar = null; _nexusPremium = false;
        _ = JS.InvokeVoidAsync("junigridJs.toast", "已退出 Nexus 登录");
        StateHasChanged();
    }

    // ─── Steam 下载授权（DepotDownloader 扫码）───
    private bool _ddQrOpen;
    private bool _ddQrBusy;
    private string? _ddQrDataUri;
    private IReadOnlyList<string>? _ddQrLines;
    private string _ddQrState = "";
    private string? _ddQrError;
    private CancellationTokenSource? _ddQrCts;

    /// <summary>弹窗里那行进度。服务一直在报（重取新码、连第几个 CM 节点），只是原先界面写死了
    /// 「正在连接…」没接上 —— 用户看到的就是「一直卡在正在连接」。长文案会撑破弹窗，截到 48 字。</summary>
    private string DdQrHint => _ddQrState.Length > 48 ? _ddQrState[..48] + "…" : _ddQrState;

    /// <summary>码下面那行：等扫时给操作说明，服务一报别的（换码 / 授权成功收尾）就换成进度。
    /// 这里原先挂的是 s.team 长链接（用户要求去掉），链接本身仍写在 juni-grid.log 里。</summary>
    private string DdQrScanHint =>
        string.IsNullOrWhiteSpace(_ddQrState) || _ddQrState.StartsWith("等待手机扫码")
            ? "用 Steam 手机 App 扫这张码"
            : DdQrHint;

    private void OnQrImgError()
    {
        _ddQrError = "二维码图片加载失败，请点取消后重试";
        StateHasChanged();
    }

    private bool DdAuthorized => Cfg.Current.DepotQrLoggedIn;

    /// <summary>授权账号与本机 Steam 客户端账号的异同说明（跟在"下载免密"后面）。</summary>
    private string GetDdAccountSuffix()
    {
        var acc = Cfg.Current.SteamCmdAccount;
        if (string.IsNullOrWhiteSpace(acc)) return "";
        if (_steam.Found && string.Equals(acc, _steam.AccountName, StringComparison.OrdinalIgnoreCase))
            return "（本机 Steam 账号）";
        return $"（授权账号：{acc}）";
    }

    private void OpenDdQr()
    {
        // 同账号只允许一路 Steam 会话：下载在飞时再起一路扫码，会把那一路顶掉（实测互踢）
        if (DepotDownloaderService.SteamSessionBusy)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", "有版本正在下载，等它下完（或先在任务中心取消）再重新授权", "err");
            return;
        }
        _ddQrOpen = true;
        ClearDdQrImage();
        _ddQrError = null;
        _ddQrState = "正在准备扫码组件…";
        _ddQrBusy = true;
        _ddQrCts = new CancellationTokenSource();
        StateHasChanged();
        _ = RunDdQrAsync();
    }

    // 首次安装组件会下载并解压。页面打开后后台预热，扫码时不再等这一段。
    private async Task WarmDepotDownloaderAsync()
    {
        try
        {
            await DepotQr.EnsureDepotDownloaderAsync();
        }
        catch (Exception ex)
        {
            // 预热不影响正常使用；真正扫码时会给出可见错误。
            AppLog.Warn("DepotDownloader", "授权组件后台预热失败: " + ex.Message);
        }
    }

    private async Task RunDdQrAsync()
    {
        var progress = new Progress<DepotDownloaderService.Progress>(p =>
            _ = InvokeAsync(() =>
            {
                _ddQrState = string.IsNullOrEmpty(p.Line) ? p.State : p.Line;
                StateHasChanged();
            }));
        try
        {
            var account = await DepotQr.QrLoginOnlyAsync(
                dataUri => InvokeAsync(() =>
                {
                    _ddQrDataUri = dataUri;
                    StateHasChanged();
                }),
                progress, _ddQrCts?.Token ?? CancellationToken.None,
                onAsciiLines: lines => InvokeAsync(() =>
                {
                    _ddQrLines = lines;
                    StateHasChanged();
                }),
                // 上一张码随 Steam 连接一起作废了：撤干净，等下一路刷出的新码
                onStale: () => InvokeAsync(ClearDdQrImage));

            await InvokeAsync(() =>
            {
                var cfg = Cfg.Current;
                cfg.DepotQrLoggedIn = true;
                if (!string.IsNullOrWhiteSpace(account)) cfg.SteamCmdAccount = account.Trim();
                Cfg.Save(cfg);
                _ddQrBusy = false;
                _ddQrState = "授权成功";
                ClearDdQrImage();   // 撤掉旧码，避免成功后还显示二维码
                _ = JS.InvokeVoidAsync("junigridJs.toast", "Steam 下载授权成功，历史版本下载已免密");
                StateHasChanged();
            });
            // 稍候自动关窗，让用户看到 toast / 状态
            await Task.Delay(900, CancellationToken.None);
            await InvokeAsync(() =>
            {
                if (!_ddQrBusy)
                {
                    _ddQrOpen = false;
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _ddQrBusy = false;
                _ddQrError = ex is OperationCanceledException ? "已取消" : ex.Message;
                ClearDdQrImage();   // 走到这儿那张 challenge 已经作废，不许留在屏上让人扫
            });
        }
    }

    /// <summary>撤掉界面上的二维码。出过码后再失败 ⇒ challenge 已随 DD 进程退出作废，
    /// 留着就是让人扫一张死码（手机端只报「加载二维码失败」，实测 03:45:20 出码 / 03:45:36 掉线）。</summary>
    /// <summary>「立即重开」：掐掉当前这一路连接，马上开下一路（服务层 1 秒内响应，
    /// 且不占用重试次数）。省得人对着 20 秒出码截止干等。</summary>
    private void KickQrRetry()
    {
        DepotDownloaderService.RequestKickNow();
        _ddQrState = "正在按你的要求重开一路连接…";
        StateHasChanged();
    }

    private void ClearDdQrImage()
    {
        _ddQrDataUri = null;
        _ddQrLines = null;
        StateHasChanged();
    }

    private void CloseDdQr()
    {
        if (_ddQrBusy) { try { _ddQrCts?.Cancel(); } catch { } }
        _ddQrOpen = false;
        StateHasChanged();
    }

    private void DdRevoke()
    {
        var cfg = Cfg.Current;
        cfg.DepotQrLoggedIn = false;
        Cfg.Save(cfg);
        _ = JS.InvokeVoidAsync("junigridJs.toast", "已解除 Steam 下载授权，下次下载需重新扫码");
        StateHasChanged();
    }

    private async Task LoadAccountsAsync()
    {        // Q4: 全部从 config 缓存瞬读，不再进设置页就拉网
        _steam = Steam.GetProfile();
        var cfg = Cfg.Current;
        _nexusName = cfg.NexusUserName;
        _nexusPremium = cfg.NexusIsPremium;
        // v1.08.2：只信 image/* 的缓存 —— 旧版本曾把 profile_url（网页链接）的下载结果当头像缓存，
        // data:text/html 之类坏数据每次进页都命中，头像自然「对不上」
        var cached = cfg.NexusAvatarDataUri;
        _nexusAvatar = cached is not null && cached.StartsWith("data:image/", StringComparison.Ordinal) ? cached : null;
        // v1.08.2：已登录则后台自愈刷新（validate 已按 user_id 构造真实头像直链），拉到不同才写回缓存；
        // 不 await —— 设置页首屏不因网络等待延迟
        if (!string.IsNullOrEmpty(cfg.NexusApiKey)) _ = RefreshNexusAvatarAsync();
    }

    private async Task RefreshNexusAvatarAsync()
    {
        try
        {
            var cfg = Cfg.Current;
            var u = await NexusApi.ValidateAsync(cfg.NexusApiKey);
            if (u is null || string.IsNullOrEmpty(u.Avatar)) return;
            var fresh = await NexusApi.FetchAvatarAsync(u.Avatar);
            if (string.IsNullOrEmpty(fresh)) return;
            _nexusName = string.IsNullOrEmpty(u.Name) ? _nexusName : u.Name;
            _nexusPremium = u.IsPremium;
            // 名字/Premium 也写回 config：老版本登录只落了 key + 头像缓存，
            // 不写回的话每次进设置页都要闪 1s「未登录」等这次 validate 自愈
            if (cfg.NexusUserName != _nexusName || cfg.NexusIsPremium != _nexusPremium)
            {
                cfg.NexusUserName = _nexusName;
                cfg.NexusIsPremium = _nexusPremium;
                Cfg.Save(cfg);
            }
            if (fresh != _nexusAvatar)
            {
                _nexusAvatar = fresh;
                cfg.NexusAvatarDataUri = fresh;
                Cfg.Save(cfg);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch { /* 网络失败保持缓存显示，静默 */ }
    }


    private string _gamePath = "";
    private bool _oneClickInstall;
    private bool _autoInstall;

    // ─── v1.2.4：游戏版本锁定（阻止 Steam 自动更新，玩旧版用）───
    // UI 状态以清单文件的只读属性为准（文件可能被 Steam/用户改掉），配置项只在切换时落盘；
    // Steam 启动路径还有一次启动前补锁兜底（LauncherService.LaunchSteam）。
    private string? _manifestPath;
    private bool _manifestLocked;

    private void ProbeManifest()
    {
        _manifestPath = SteamService.FindAppManifest(Cfg.Current.GamePath, Cfg.Current.SteamAppId);
        _manifestLocked = SteamService.IsGameVersionLocked(_manifestPath);
    }

    private void ToggleLockGameVersion()
    {
        if (_manifestPath is null) return;
        var want = !_manifestLocked;
        var (ok, err) = SteamService.SetGameVersionLock(_manifestPath, want);
        if (!ok)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", err, "err");
            return;
        }
        _manifestLocked = want;
        var cfg = Cfg.Current;
        cfg.LockGameVersion = want;
        Cfg.Save(cfg);
        _ = JS.InvokeVoidAsync("junigridJs.toast", want
            ? "已锁定游戏版本 —— Steam 不会再自动更新本体，可一直玩当前版本"
            : "已解除锁定 —— 下次通过 Steam 启动会正常更新游戏");
        StateHasChanged();
    }

    // ─── 显示成人内容：单一开关，默认关（一律排除；开 = 跟随登录账号的账号设置）───
    private bool _showAdult;

    private bool _showTaskDock;

    private void ToggleTaskDock()
    {
        _showTaskDock = !_showTaskDock;
        var cfg = Cfg.Current;
        cfg.ShowTaskDock = _showTaskDock;
        Cfg.Save(cfg);
    }

    // ─── v0.2.1：内存管理 ───
    private MemoryService.MemorySnapshot? _mem;
    private bool _memTimer;
    private int _memTimerMinutes = 30;
    private bool _memThreshold;
    private int _memThresholdPercent = 80;
    private ElementReference _timerPanel;      // v0.2.2：滑杆面板，随开关弹性开合
    private ElementReference _thresholdPanel;
    private ElementReference _timerSlider;     // v0.2.2：弹性滑杆（React Bits ElasticSlider 风格）
    private ElementReference _thresholdSlider;
    private DotNetObjectReference<Settings>? _sliderCb;

    private static string FmtMb(long? bytes)
        => bytes is null or < 0 ? "—" : ResumableDownload.FormatBytes(bytes.Value);

    private string Pct() => _mem is null ? "—" : _mem.SysPercent.ToString("F0");

    private void OnMemSnap(MemoryService.MemorySnapshot snap) =>
        _ = InvokeAsync(() => { _mem = snap; StateHasChanged(); });

    /// <summary>开关切换：展开 = 先让 Blazor 摘掉 display:none 再播动画；
    /// 收起 = 趁面板还可见先播收拢动画，播完才真正隐藏（保证两个方向的动画都能看见）。</summary>
    private async Task ToggleMemTimer()
    {
        if (_memTimer)
        {
            await AnimatePanelAsync(_timerPanel, false);
            _memTimer = false;
        }
        else
        {
            _memTimer = true;
            StateHasChanged();
            await AnimatePanelAsync(_timerPanel, true);
        }
        SaveMemCfg();
        StateHasChanged();
    }

    private async Task ToggleMemThreshold()
    {
        if (_memThreshold)
        {
            await AnimatePanelAsync(_thresholdPanel, false);
            _memThreshold = false;
        }
        else
        {
            _memThreshold = true;
            StateHasChanged();
            await AnimatePanelAsync(_thresholdPanel, true);
        }
        SaveMemCfg();
        StateHasChanged();
    }

    /// <summary>滑杆面板随开关弹性开合（与下拉菜单同款 GSAP 曲线，见 interop.js collapseToggle）。
    /// JS 万一不可用：上面的 try/catch 让开关仍然立即生效，只是没有动画。</summary>
    private async Task AnimatePanelAsync(ElementReference el, bool open)
    {
        try { await JS.InvokeVoidAsync("junigridJs.collapseToggle", el, open); } catch { }
    }
    private void SaveMemCfg()
    {
        var cfg = Cfg.Current;
        cfg.MemTimerEnabled = _memTimer;
        cfg.MemTimerMinutes = _memTimerMinutes;
        cfg.MemThresholdEnabled = _memThreshold;
        cfg.MemThresholdPercent = _memThresholdPercent;
        Cfg.Save(cfg);
    }

    /// <summary>弹性滑杆拖动结束回调（JS → .NET）：落值 + 保存。</summary>
    [JSInvokable]
    public void OnElasticValue(string id, double value)
    {
        if (id == "timer") _memTimerMinutes = (int)Math.Clamp(value, 5, 240);
        else if (id == "threshold") _memThresholdPercent = (int)Math.Clamp(value, 50, 95);
        else return;
        SaveMemCfg();
        StateHasChanged();
    }

    private async Task CompressNow()
    {
        // 一键全压：自身（GC + 工作集换出）+ WebView2 子进程（工作集换出）
        var (before, after) = await Task.Run(() => Mem.CompressSelf());
        var msg = $"自身 {ResumableDownload.FormatBytes(before)} → {ResumableDownload.FormatBytes(after)}";
        var wv = await Task.Run(() => Mem.TrimWebView2());
        if (wv.count > 0)
            msg += $"；WebView2（{wv.count} 进程）{ResumableDownload.FormatBytes(wv.before)} → {ResumableDownload.FormatBytes(wv.after)}";
        _mem = Mem.GetSnapshot();
        StateHasChanged();
        await JS.InvokeVoidAsync("junigridJs.toast", "已压缩：" + msg);
    }

    private async Task TrimGameNow()
    {
        var n = await Task.Run(() => Mem.TrimGameWorkingSet());
        await JS.InvokeVoidAsync("junigridJs.toast",
            n > 0 ? $"已清理 {n} 个游戏进程的工作集" : "游戏未在运行", n > 0 ? null : "err");
    }

    // ─── v0.2.1：缓存与存储 ───
    private List<StorageCategory> _cats = new();

    // ─── v1.4.4：游戏版本缓存手风琴 ───
    private bool _verAccOpen;
    private List<DepotDownloaderService.StagedPackage> _verCaches = new();
    private (StorageService.StagingBucketKind Kind, string Path, long Bytes)[] _verBuckets = Array.Empty<(StorageService.StagingBucketKind, string, long)>();

    private void LoadVerCaches()
    {
        try
        {
            _verCaches = DepotQr.ListStagedPackages();
            AppLog.Warn("Storage", $"版本缓存列表：{_verCaches.Count} 项 " +
                string.Join(", ", _verCaches.Select(v => v.Label + ":" + v.SizeBytes)));
        }
        catch (Exception ex)
        {
            AppLog.Warn("Storage", "列出版本缓存失败: " + ex.Message);
            _verCaches = new();
        }
        LoadVerBuckets();
    }

    /// <summary>depot-staging 里的附属目录。大小要遍历目录树（Mods 备份可能几百 MB），
    /// 所以先以「计算中」占位、后台算完再填 —— 直接在本方法里算会卡住 UI 线程。</summary>
    private void LoadVerBuckets()
    {
        var rows = StorageService.ListStagingBuckets();
        _verBuckets = rows;
        if (rows.Length == 0) return;
        _ = Task.Run(() =>
        {
            var filled = StorageService.ListStagingBuckets();
            _ = InvokeAsync(() => { _verBuckets = filled; StateHasChanged(); });
        });
    }

    /// <summary>v1.4.5：下载任务结束自动刷新手风琴列表（之前只在展开时加载一次，
    /// 下载完成后新版本不出现，让人以为"只剩一个版本"）。刷新后强制面板高度归位 auto——
    /// GSAP 展开动画会把 height 固定为当时内容的高度，内容变多后不归位就会溢出/裁剪。</summary>
    private void OnCenterChangedForVerCache()
    {
        _ = InvokeAsync(async () =>
        {
            if (!_verAccOpen) return;
            var running = Center.Snapshot().Any(t => t.Kind == "gameversion" && t.Status == "running");
            if (!running)
            {
                LoadVerCaches();
                StateHasChanged();
                await Task.Delay(50);   // 等 Blazor 把新条目渲染进 DOM 再量高
                try { await JS.InvokeVoidAsync("junigridJs.eval",
                    "var p=document.querySelector('#jg-vercache-panel'); if(p&&p.classList.contains('open')){p.style.height='auto';p.style.overflow='';}"); }
                catch { }
            }
        });
    }

    private async Task ToggleVerCache()
    {
        _verAccOpen = !_verAccOpen;
        // 每次展开都重新扫盘 —— 避免只显示上次缓存的一条
        if (_verAccOpen) LoadVerCaches();
        await InvokeAsync(StateHasChanged);
        // 等 Blazor 把全部条目渲染进 DOM 再量高，否则 GSAP 只按旧内容高度展开
        await Task.Delay(30);
        try { await JS.InvokeVoidAsync("junigridJs.accordionToggle", "#jg-vercache-panel", _verAccOpen); } catch { }
        if (_verAccOpen)
        {
            await Task.Delay(420);   // 等展开动画结束
            try { await JS.InvokeVoidAsync("junigridJs.eval",
                "var p=document.querySelector('#jg-vercache-panel'); if(p&&p.classList.contains('open')){p.style.height='auto';p.style.overflow='';p.style.maxHeight='320px';}"); }
            catch { }
        }
    }

    // 版本缓存是硬删（Depot.DeleteStagedPackage → Directory.Delete），不进回收站、删了要重下几 GB
    // 才回得来，所以走上面那个确认弹窗；点「删除」只记目标，确认才真删。
    private DepotDownloaderService.StagedPackage? _pendingDeleteVer;
    private (StorageService.StagingBucketKind Kind, string Path, long Bytes)? _pendingBucket;

    private void AskDeleteVerCache(DepotDownloaderService.StagedPackage pkg)
    {
        _pendingDeleteVer = pkg;
        _pendingCleanId = null;
        _confirmCleanAll = false;
    }

    private async Task DoDeleteVerCache()
    {
        var pkg = _pendingDeleteVer;
        _pendingDeleteVer = null;
        if (pkg is null) return;
        if (!DepotQr.DeleteStagedPackage(pkg.ManifestId))
        {
            await JS.InvokeVoidAsync("junigridJs.toast", "删除失败（文件可能被占用）", "err");
            return;
        }
        LoadVerCaches();
        _cats = Storage.GetCategories();
        _ = Storage.RefreshAllAsync(force: true);
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("junigridJs.toast", $"已删除版本缓存 {pkg.Label}");
    }

    private string FmtSize(string id)
    {
        if (Storage.IsComputing(id)) return "计算中…";
        var b = Storage.GetSize(id);
        return b < 0 ? "—" : ResumableDownload.FormatBytes(b);
    }

    private void OnStorageStats() => _ = InvokeAsync(StateHasChanged);

    private async Task CleanCat(string id)
    {
        var msg = await Storage.CleanCategoryAsync(id);
        _cats = Storage.GetCategories();
        await JS.InvokeVoidAsync("junigridJs.toast", msg);
    }

    // ─── 确认弹窗：单项清理、一键清理、删某个版本缓存共用同一个框 ───
    private string? _pendingCleanId;
    private bool _confirmCleanAll;

    private string ConfirmTitle => _pendingDeleteVer is not null ? "删除版本缓存"
        : _pendingBucket is not null ? (_pendingBucket.Value.Kind.Danger ? "移出" + _pendingBucket.Value.Kind.Name : "删除" + _pendingBucket.Value.Kind.Name)
        : _confirmCleanAll ? "一键清理缓存" : "清理缓存";
    private string ConfirmOkLabel => _pendingDeleteVer is not null || _pendingBucket is not null
        ? (_pendingBucket is { } pb && pb.Kind.Danger ? "确认移出" : "确认删除") : "确认清理";
    private string ConfirmBody => _pendingDeleteVer is not null ? DeleteVerConfirmText
        : _pendingBucket is not null ? BucketConfirmText : CleanConfirmText;

    private string BucketConfirmText
    {
        get
        {
            var b = _pendingBucket!.Value;
            return b.Kind.Danger
                ? $"{b.Kind.Name}（{ResumableDownload.FormatBytes(b.Bytes)}）里的 mod 会移到游戏卸载回收站，不直接删。\n\n{b.Kind.Tip}\n\n反悔的话：在「缓存与存储」那行「游戏卸载回收站」里能拿回来；清空那个回收站之后就真没了。"
                : $"{b.Kind.Name}（{ResumableDownload.FormatBytes(b.Bytes)}）将被删除。\n\n{b.Kind.Tip}";
        }
    }

    private void AskDeleteBucket((StorageService.StagingBucketKind Kind, string Path, long Bytes) b)
    {
        _pendingBucket = b; _pendingCleanId = null; _confirmCleanAll = false; _pendingDeleteVer = null;
    }

    private async Task DoDeleteBucket()
    {
        var b = _pendingBucket;
        _pendingBucket = null;
        if (b is null) return;
        var msg = await Storage.CleanStagingBucketAsync(b.Value.Kind.Key);
        _cats = Storage.GetCategories();
        LoadVerCaches();
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("junigridJs.toast", msg);
    }

    private string DeleteVerConfirmText
    {
        get
        {
            var v = _pendingDeleteVer!;
            // 正文（含"抽屉里还存着 N 个 mod 文件夹"）走服务层单一口径 —— 版本管理弹窗删的是
            // 同一个目录，两处不能一个报 mod 一个不报。这里只补本机授权这一句事实。
            return DepotDownloaderService.DeletePackConfirmText(v)
                 + "\n\nSteam 授权还在，重新下载不用再扫一次码。";
        }
    }

    private async Task DoConfirm()
    {
        if (_pendingDeleteVer is not null) await DoDeleteVerCache();
        else if (_pendingBucket is not null) await DoDeleteBucket();
        else await DoClean();
    }

    private string CleanConfirmText
    {
        get
        {
            if (_confirmCleanAll)
            {
                var n = _cats.Count(x => x.Cleanable && x.Id != "vercache");
                return $"将逐个清理全部可清理缓存（不含游戏版本缓存 —— 每个版本的去留在版本管理里单独决定）。\n\n"
                     + "正在使用的文件会自动跳过；游戏卸载回收站清空后无法恢复。";
            }
            var c = _cats.FirstOrDefault(x => x.Id == _pendingCleanId);
            if (c is null) return "确定清理吗？";
            return $"将清理「{c.Name}」。\n\n{c.Tip}\n\n正在使用的文件会自动跳过。";
        }
    }

    private void AskClean(string id) { _confirmCleanAll = false; _pendingCleanId = id; }
    private void AskCleanAll() { _pendingCleanId = null; _confirmCleanAll = true; }
    private void CancelClean()
    {
        _pendingCleanId = null; _confirmCleanAll = false; _pendingDeleteVer = null; _pendingBucket = null;
    }

    private async Task DoClean()
    {
        var all = _confirmCleanAll;
        var id = _pendingCleanId;
        CancelClean();
        if (all)
        {
            // 版本缓存不参与一键清理 —— 每个历史版本的去留在版本管理里单独决定
            foreach (var c in _cats.Where(x => x.Cleanable && x.Id != "vercache").ToList())
                await Storage.CleanCategoryAsync(c.Id);
            await JS.InvokeVoidAsync("junigridJs.toast", "全部缓存已处理完（版本缓存不受影响），详见任务记录");
        }
        else if (id is not null)
        {
            await CleanCat(id);
        }
    }

    private async Task RefreshStats()
    {
        var ok = await Storage.RefreshAllAsync(force: true);
        await JS.InvokeVoidAsync("junigridJs.toast",
            ok ? "占用刷新成功" : "占用刷新失败 请重试", ok ? null : "err");
    }

    // ─── 更改统一缓存目录：可迁移项（下载/SMAPI/WebView2/Mods 备份）一起跟着走 ───
    private string? _pendingRoot;

    private void ChangeCacheRoot()
    {
        var dlg = new Microsoft.Win32.OpenFolderDialog { Title = "选择缓存目录" };
        if (dlg.ShowDialog() == true) _pendingRoot = dlg.FolderName;
    }

    private void CancelChangeRoot() => _pendingRoot = null;

    private async Task ConfirmChangeRoot()
    {
        var root = _pendingRoot;
        _pendingRoot = null;
        if (string.IsNullOrWhiteSpace(root)) return;
        var msg = await Storage.MigrateCacheRootAsync(root);
        _cats = Storage.GetCategories();
        await JS.InvokeVoidAsync("junigridJs.toast", msg);
    }

    private async Task ResetCacheRoot()
    {
        var msg = await Storage.MigrateCacheRootAsync(null);
        _cats = Storage.GetCategories();
        await JS.InvokeVoidAsync("junigridJs.toast", msg);
    }

    private void OpenCatFolder(StorageCategory c)
    {
        try
        {
            var p = c.DisplayPath;
            if (!Directory.Exists(p)) Directory.CreateDirectory(p);
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(p) { UseShellExecute = true });
        }
        catch { }
    }

    public void Dispose()
    {
        Mem.OnSnapshot -= OnMemSnap;
        ConfigService.Saved -= OnCfgSaved;   // v1.1.4
        Storage.OnStats -= OnStorageStats;
        Center.OnChanged -= OnCenterChangedForVerCache;
        _sliderCb?.Dispose();
    }

    // v1.1.4：配置被其它入口改动（悬浮球右键隐藏等）时，把「打开任务管理悬浮窗」
    // 开关的 UI 拉回配置真值 —— 只回读这一个字段，不碰用户正在编辑的其它控件
    private void OnCfgSaved() => InvokeAsync(() =>
    {
        _showTaskDock = Cfg.Current.ShowTaskDock;
        StateHasChanged();
    });


    private void SaveShowAdult()
    {
        var cfg = Cfg.Current;
        cfg.ShowAdultContent = _showAdult;
        Cfg.Save(cfg);   // ConfigService.Save 内部同步 NexusService 的成人内容查询开关
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        _gamePath = Cfg.Current.GamePath;        _oneClickInstall = Cfg.Current.EnableOneClickInstall;
        // 重 IO 丢后台：ProbeManifest 扫 Steam 清单 + ListStagedPackages 过 52 个版本包，
        // 同步跑会把首屏整个卡住（「点设置进半天」就是这里）
        _ = Task.Run(() =>
        {
            try { ProbeManifest(); } catch { }
            try { LoadVerCaches(); } catch { }
            _ = InvokeAsync(StateHasChanged);
        });
        _autoInstall = Cfg.Current.EnableAutoInstall && _nexusPremium;   // 非会员一律默认关闭
        if (!_nexusPremium && Cfg.Current.EnableAutoInstall)
        {
            // 非会员时把残留的开启态落盘为关闭，避免其他页直接读 config 误触发自动安装
            Cfg.Current.EnableAutoInstall = false;
            Cfg.Save(Cfg.Current);
        }
        _showAdult = Cfg.Current.ShowAdultContent;
        _showTaskDock = Cfg.Current.ShowTaskDock;

        // v0.2.1：内存管理 —— 订阅快照推送（5s 一次），离开页面时 Dispose 退订
        Mem.OnSnapshot += OnMemSnap;
        ConfigService.Saved += OnCfgSaved;   // v1.1.4：设置页停留时悬浮球被右键隐藏 → 开关 UI 同步
        _mem = Mem.GetSnapshot();
        _memTimer = Cfg.Current.MemTimerEnabled;
        _memTimerMinutes = Math.Clamp(Cfg.Current.MemTimerMinutes, 5, 240);
        _memThreshold = Cfg.Current.MemThresholdEnabled;
        _memThresholdPercent = Math.Clamp(Cfg.Current.MemThresholdPercent, 50, 95);

        // v0.2.1：缓存与存储 —— 首次进入或过期后后台重算占用
        Storage.OnStats += OnStorageStats;
        _cats = Storage.GetCategories();
        Storage.RefreshAll();
        Center.OnChanged += OnCenterChangedForVerCache;   // v1.4.5：版本下载完成 → 手风琴自动刷新
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // v1.1.6：特效绑定包进 firstRender —— 内存快照每 5s 推一次触发重渲染，
        // 旧版每次渲染都发 4 个 JS interop 初始化调用（靠 JS 侧防重复标记兜底，纯浪费往返）
        if (firstRender)
        {
            _ = WarmDepotDownloaderAsync();
            // 特效绑定全部 fire-and-forget —— 串行 await 会把交互拖到 6 次往返之后
            // （JS 侧有防重复绑定标记，晚到也安全）
            _ = JS.InvokeVoidAsync("junigridJs.initGsapFx");
            _ = JS.InvokeVoidAsync("junigridJs.initPixelHover");
            _ = JS.InvokeVoidAsync("junigridJs.initCursorGrid", ".jg-cursor-grid");
            _ = JS.InvokeVoidAsync("junigridJs.initLogoLoop", ".jg-logoloop");
            _ = JS.InvokeVoidAsync("junigridJs.squishSwitchInit");
            // v0.2.2：弹性滑杆绑定（值变化经 OnElasticValue 回调落配置）
            try
            {
                _sliderCb = DotNetObjectReference.Create(this);
                _ = JS.InvokeVoidAsync("junigridJs.elasticInit", _timerSlider, "timer", (double)_memTimerMinutes, _sliderCb);
                _ = JS.InvokeVoidAsync("junigridJs.elasticInit", _thresholdSlider, "threshold", (double)_memThresholdPercent, _sliderCb);
            }
            catch { }
        }
    }
    private void ToggleOneClick()
    {
        _oneClickInstall = !_oneClickInstall;
        SaveOneClickInstall();
    }

    private void ToggleAutoInstall()
    {
        if (!_nexusPremium) return;
        _autoInstall = !_autoInstall;
        SaveAutoInstall();
    }

    private void ToggleShowAdult()
    {
        _showAdult = !_showAdult;
        SaveShowAdult();
    }

    private void SaveOneClickInstall()
    {
        var cfg = Cfg.Current;
        cfg.EnableOneClickInstall = _oneClickInstall;
        Cfg.Save(cfg);
    }

    private void SaveAutoInstall()
    {
        var cfg = Cfg.Current;
        // 双保险：非会员即使在 UI 外被置为 true 也不生效
        cfg.EnableAutoInstall = _autoInstall && cfg.NexusIsPremium;
        Cfg.Save(cfg);
    }

    // 目录有效 = 游戏本体在即可。SMAPI 不是必需品（用户可以选择游玩官方模式），
    // 没装 SMAPI 只影响提示文案，不再拦截保存
    private static bool IsValidGamePath(string? p)
        => !string.IsNullOrWhiteSpace(p)
           && Directory.Exists(p)
           && File.Exists(Path.Combine(p, "Stardew Valley.exe"));

    private static bool HasSmapi(string? p)
        => !string.IsNullOrWhiteSpace(p) && File.Exists(Path.Combine(p, "StardewModdingAPI.exe"));

    private void SaveGamePath()
    {
        var cfg = Cfg.Current;
        cfg.GamePath = _gamePath;
        Cfg.Save(cfg);
        ProbeManifest();   // v1.2.4：目录变了 → Steam 清单与锁状态重探
        _ = JS.InvokeVoidAsync("junigridJs.toast", HasSmapi(_gamePath)
            ? "已保存游戏目录"
            : "已保存游戏目录（未检测到 SMAPI，可通过首页「Steam 官方」启动游玩）");
    }

    private void AutoDetect()
    {
        var detected = Game.DetectGamePath();
        if (!string.IsNullOrEmpty(detected))
        {
            _gamePath = detected;
            if (IsValidGamePath(detected))
            {
                SaveGamePath();
            }
            else
            {
                _ = JS.InvokeVoidAsync("junigridJs.toast", "检测到目录，但里面没有 Stardew Valley.exe，请手动选择游戏目录", "err");
            }
        }
        else
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", "未自动检测到游戏目录，请点「浏览...」手动选择", "err");
        }
    }

    private void Pick()
    {
        var dlg = new Microsoft.Win32.OpenFolderDialog
        {
            Title = "选择 Stardew Valley 游戏目录"
        };
        if (dlg.ShowDialog() == true)
        {
            _gamePath = dlg.FolderName;
            if (IsValidGamePath(_gamePath))
            {
                SaveGamePath();
            }
            else
            {
                _ = JS.InvokeVoidAsync("junigridJs.toast", "请选择包含 Stardew Valley.exe 的游戏目录", "err");
            }
        }
    }

    private void Save()
    {
        if (!IsValidGamePath(_gamePath))
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", "目录无效：请填写包含 Stardew Valley.exe 的游戏目录", "err");
            return;
        }
        SaveGamePath();
    }
}

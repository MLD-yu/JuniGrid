    private string CleanConfirmText
    {
        get
        {
            var hasPausedCheckpoint = Center.Snapshot().Any(t => t.Status == "paused"
                && !string.IsNullOrWhiteSpace(t.PartialDownloadPath));
            if (_confirmCleanAll)
            {
                var n = _cats.Count(x => x.Cleanable && x.Id != "vercache");
                var message = Loc.T("将逐个清理全部可清理缓存（不含游戏版本缓存 —— 每个版本的去留在版本管理里单独决定）。\n\n")
                    + Loc.T("SMAPI 本体、没归到版本的 Mod、没搬完的残包也一起清；后两者里的 mod 移入游戏卸载回收站，不直接删。\n\n")
                    + Loc.T("正在使用的文件会自动跳过；游戏卸载回收站清空后无法恢复。");
                if (hasPausedCheckpoint)
                    message += "\n\n" + Loc.T("下载缓存也会清理暂停任务的断点；之后继续这些任务时需要重新下载。");
                return message;
            }
            var c = _cats.FirstOrDefault(x => x.Id == _pendingCleanId);
            if (c is null) return Loc.T("确定清理吗？");
            var pausedDownloadNote = c.Id == "downloads" && hasPausedCheckpoint
                ? "\n\n" + Loc.T("暂停任务的下载断点也会删除；之后继续这些任务时需要重新下载。")
                : "";
            return Loc.F("将清理「{0}」。\n\n{1}\n\n正在使用的文件会自动跳过。", Loc.T(c.Name), Loc.T(c.Tip)) + pausedDownloadNote;
        }
    }

    private void AskClean(string id) { _confirmCleanAll = false; _pendingCleanId = id; }
    private void AskCleanAll() { _pendingCleanId = null; _confirmCleanAll = true; }
    private void CancelClean()
    {
        _pendingCleanId = null; _confirmCleanAll = false; _pendingDeleteVer = null;
    }

    private async Task DoClean()
    {
        var all = _confirmCleanAll;
        var id = _pendingCleanId;
        CancelClean();
        if (all)
        {
            // 版本缓存不参与一键清理 —— 每个历史版本的去留在版本管理里单独决定
            foreach (var c in _cats.Where(x => x.Cleanable && x.Id != "vercache").ToList())
                await Storage.CleanCategoryAsync(c.Id);
            // 附属目录（SMAPI 本体 / 没归到版本的 Mod / 没搬完的残包）不再单独成行，
            // 跟一键清理走；后两者里的 mod 由 CleanStagingBucketAsync 移入游戏卸载回收站。
            foreach (var b in StorageService.ListStagingBuckets())
                await Storage.CleanStagingBucketAsync(b.Kind.Key);
            await JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("全部缓存已处理完（版本缓存不受影响），详见任务记录"));
        }
        else if (id is not null)
        {
            await CleanCat(id);
        }
    }


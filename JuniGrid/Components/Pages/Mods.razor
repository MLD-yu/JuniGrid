    /// <summary>弹窗里现场建分类：建完直接选中它，剩下的等用户点「继续安装」。</summary>
    private void CreateLocalPackCategory()
    {
        var name = _localPackNewName.Trim();
        if (name.Length == 0) { _localPackDialogError = Loc.T("先输入一个分类名"); return; }
        if (name.Length > 20) name = name[..20];
        if (ExistingCategories().Any(c => string.Equals(c, name, StringComparison.OrdinalIgnoreCase)))
        {
            // 名字和已有分类撞了：当成「就选它」，不再建重复项
            _localPackCat = name;
            CloseLocalPackNewRow();
            _localPackDialogError = null;
            StateHasChanged();
            return;
        }
        var cfg = Cfg.Current;
        if (!cfg.ModUserCategoryOrder.Contains(name, StringComparer.OrdinalIgnoreCase))
            cfg.ModUserCategoryOrder.Add(name);
        // 新建行选过的图跟着分类一起落盘（默认小鸡就不写键，配置里不留无意义项）
        var icon = CategoryIconService.NormalizeSpec(_localPackNewIcon);
        if (!string.Equals(icon, CategoryIconService.DefaultSpec, StringComparison.OrdinalIgnoreCase))
            cfg.ModCategoryIcon[name] = icon;
        Cfg.Save(cfg);
        _categoryRev++;
        _localPackCat = name;
        _localPackNewOpen = false;
        _localPackNewName = "";
        _localPackNewIcon = CategoryIconService.DefaultSpec;
        _localPackDialogError = null;
        StateHasChanged();
    }

    /// <summary>顶栏刷新信号（只有已停留在本页时才会触发）。
    /// 重新扫描 + 强制全量重查更新（无视 60 分钟 TTL）。</summary>
    private void OnPageRefresh(string key)
    {
        if (key != "mods" || _disposed
            || Interlocked.Exchange(ref _pageRefreshInProgress, 1) != 0) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                _initialLoading = true;
                StateHasChanged();
                // v1.1.6：手动刷新也要做多副本清理（preScanned 路径会跳过 Rescan 里的清理）
                var scanned = await Task.Run(() =>
                {
                    try { ModSvc.CleanupDuplicateCopiesIfChanged(Cfg.Current.GamePath, force: true); }
                    catch (Exception ex) { AppLog.Warn("Mods", "多副本清理失败: " + ex.Message); }
                    return ModSvc.Scan(Cfg.Current.GamePath);
                });
                if (_disposed) return;
                Rescan(scanned);
                _initialLoading = false;
                await CheckUpdates(force: true);
                // v1.08：刷新同时重新探测 SMAPI（安装/升级后 exe 已变，静态缓存是旧版本）
                // 并强制重查远端新版 —— 此前刷新永远拿 5 分钟缓存，看不到刚装好的新状态。
                // v1.3.4：freshRead —— 绕开 Windows 版本资源缓存（覆盖安装后立即读拿旧值）。
                _smapiVersion = Game.ProbeSmapiVersion(Cfg.Current.GamePath, freshRead: true);
                _svSmapiPath = Cfg.Current.GamePath;
                _svSmapiVersionCache = _smapiVersion;
                _smapiIcon = Game.GetSmapiIconDataUri(Cfg.Current.GamePath);
                // v1.1.8：旧版游戏必须查对应 tag，不能刷成 latest 4.x
                _smapiUpdate = SmapNeedsOld
                    ? await Updater.CheckSmapiForGameAsync(_smapiVersion, _gameVer, force: true)
                    : await Updater.CheckSmapiAsync(_smapiVersion, force: true);
                StateHasChanged();
                // vNext：手动刷新 = 从头看起 —— 归顶并把 0 写进滚动存档，
                // 否则刷新后不滚动就离开，下次回来会恢复到刷新前的旧位置
                try { await JS.InvokeVoidAsync("junigridJs.setScroll", ".jg-main", 0); } catch { }
                try { await JS.InvokeVoidAsync("junigridJs.saveScrollKey", "modslist", 0, false); } catch { }
            }
            finally { Volatile.Write(ref _pageRefreshInProgress, 0); }
        });
    }

    private int _pageRefreshInProgress;

    // v0.72.8：释放 FileSystemWatcher —— 旧版只解绑 Installer，watcher 从不销毁。
    // 每次离开 /mods 再回来就叠一个新 watcher，N 次往返 = N 个 watcher 同时监听 Mods/，
    // 批量改名 63 次触发 63×N 个 Rescan 回调 → UI 卡死（"进详情再回来才卡"的根因）。
    private bool _disposed;

    // v1.8.x：本地压缩包安装进行中（禁掉「从文件安装」按钮，并挡住重入）
    private bool _localPacksBusy;

    /// <summary>离开本页时叫停在飞的 N 网扇出（更新检查 / 精查 / 封面与分类回填）。
    /// AUP 二审盯着的就是这个：旧写法 Dispose 只解绑事件，那几路扇出会一路打完才停，
    /// 表现成「人已经不在 Mods 页了，客户端还在连着发请求」，同时占着 NexusService 的 2 个槽，
    /// 让下一个页面的请求排在后面（用户在别处看到的「进页卡一下」）。
    /// 只叫停<b>只读</b>的检测与回填；「自动更新」那条流水线（RunUpdatePipeline）会真下载装机，
    /// 离开页面不能把它掐在半截，所以那边不接这个令牌。
    /// 只 Cancel 不 Dispose —— 组件释放后仍可能有旧续体读 Token，别留 ObjectDisposedException 的口子。</summary>
    private readonly CancellationTokenSource LeaveCts = new();
    private CancellationToken Leave => LeaveCts.Token;

    public void Dispose()
    {
        _disposed = true;
        // 本地导入的分类弹窗还开着就离页了：把等待中的安装流程放掉，别让它永远挂在 Task 上
        try { _localPackPickTcs?.TrySetResult(null); } catch { }
        _localPackPickTcs = null;
        _localPackPickOpen = false;
        // 长按拖拽的 JS 回调引用：本页销毁后就别再往一个死组件上回调
        try { _dragRef?.Dispose(); } catch { }
        _dragRef = null;
        // 图标选择器的滚动回调同理
        try { _iconScrollRef?.Dispose(); } catch { }
        _iconScrollRef = null;
        try { LeaveCts.Cancel(); } catch { }
        Installer.OnChanged -= OnInstallerChanged;
        PackThumbService.Changed -= OnThumbsChanged;
        PageRefresh.OnRefresh -= OnPageRefresh;
        Delivery.Delivered -= OnLocalPackDelivered;
        // vNext：留下扫描快照 —— 从其它页回来时先用它秒显列表，后台再重扫磁盘
        _svMods = _mods;
        _svFilter = _filter;
        _svSort = _sortMode;
        _svSearch = SearchText;
        _svSearchOpen = _searchOpen;
        if (_modsWatcherSlot is not null)
            DepotDownloaderService.UnregisterModWatcher(_modsWatcherSlot);
        _modsWatcherSlot = null;
        ReleaseModsWatcher();
    }

    private void OnInstallerChanged() =>
        InvokeAsync(RescanAndRestate);   // v1.1.6：清理+扫描移到后台线程

    private FileSystemWatcher? _modsWatcher;
    private int _pendingRescan;   // v0.72.8：watcher 事件合并闸门
    /// <summary>向版本切换登记的句柄持有者身份。切换期间由 DepotDownloaderService 回调
    /// Release/Reacquire —— 它拿不到也不该拿我们的字段，只通过这三个委托动它。</summary>
    private DepotDownloaderService.ModWatcherSlot? _modsWatcherSlot;

    /// <summary>真正放掉 Mods 目录句柄。⚠ 只设 EnableRaisingEvents=false 不算放：
    /// 句柄还开着，切换时整棵改名照样 ACCESS_DENIED（2026-09-23 真机连续三次切换全败）。</summary>
    private void ReleaseModsWatcher()
    {
        var w = _modsWatcher;
        _modsWatcher = null;
        if (w is null) return;
        try { w.EnableRaisingEvents = false; } catch { }
        try { w.Dispose(); } catch { }
    }

    /// <summary>建（或重建）Mods 监听。进页时建一次；版本切换结束后由切换那边回调再建一次。
    /// 幂等：已经有活的就不重复建 —— 旧版每离开/回到 /mods 就叠一个 watcher，
    /// 批量改名 63 次触发 63×N 个 Rescan 回调，UI 直接卡死。</summary>
    private void EnsureModsWatcher()
    {
        if (_disposed || _modsWatcher is not null) return;
        try
        {
            var modsDir = System.IO.Path.Combine(Cfg.Current.GamePath, "Mods");
            if (!Directory.Exists(modsDir)) return;

            var watcher = new FileSystemWatcher(modsDir)
            {
                IncludeSubdirectories = false,
                NotifyFilter = NotifyFilters.DirectoryName | NotifyFilters.FileName | NotifyFilters.LastWrite
            };
            // v0.72.8：disposed 守卫 + 事件合并 —— 组件销毁后已排队的回调不再回灌；
            // 短时间内多个文件事件合并为一次 RescanAndRestate（_pendingRescan 防抖）。
            FileSystemEventHandler onChange = (_, _) => QueueRescan();
            watcher.Created += onChange;
            watcher.Deleted += onChange;
            watcher.Renamed += (_, _) => QueueRescan();

            _modsWatcher = watcher;
            // ⚠ 两个回调都是**同步**直调，不走 InvokeAsync：释放必须发生在切换动手搬 Mods 之前，
            // 排到渲染器队列上就等于句柄还没放、改名照样 ACCESS_DENIED，闸门形同虚设。
            // FileSystemWatcher 的建与 Dispose 都不碰渲染树（不调 StateHasChanged），
            // 所以在切换那条后台线程上直接跑是安全的。
            _modsWatcherSlot ??= new DepotDownloaderService.ModWatcherSlot
            {
                Release = ReleaseModsWatcher,
                Reacquire = EnsureModsWatcher,
                IsLive = () => _modsWatcher is not null,
            };
            DepotDownloaderService.RegisterModWatcher(_modsWatcherSlot);
            watcher.EnableRaisingEvents = true;
        }
        catch { /* watcher 建不起来就算了，用户可点手动刷新 */ }
    }

    private void QueueRescan()
    {
        if (_disposed) return;
        // v1.3.18：安装/下载进行中直接不扫。
        // 解压是往 Mods 里连写成百上千个文件，watcher 每 120ms 就能凑满一次合并窗口
        // ⇒ 每一轮都是一次全盘 ModSvc.Scan（磁盘枚举）+ ReindexMods + 整页 StateHasChanged。
        // 装一个中等大小的包能让这个列表每秒重画好几遍，体感就是"边下边发木"。
        // 装完 Installer.OnChanged 会补一次完整重扫，所以这里丢掉事件不丢数据。
        if (Installer.Busy || ModDeleteService.Busy) return;
        if (Interlocked.Exchange(ref _pendingRescan, 1) == 1) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(120);   // 合并窗口：120ms 内的连续事件只触发一次
                if (_disposed || Installer.Busy || ModDeleteService.Busy) return;   // 等这 120ms 的工夫可能已经开始装/删了
                RescanAndRestate();
            }
            finally { Interlocked.Exchange(ref _pendingRescan, 0); }
        });
    }

    protected override async Task OnInitializedAsync()
    {
        // vNext：进页两条路 —— ①有跨页快照（从其它页回来）：直接用快照秒显列表，
        // 磁盘重扫丢到后台，扫完无感替换；②冷启动无快照：shimmer 骨架 + 后台线程扫描。
        if (_svMods is { Count: > 0 } snap)
        {
            _mods = snap;
            ReindexMods();
            _initialLoading = false;
            StateHasChanged();
            _ = InvokeAsync(async () =>
            {
                try
                {
                    // v1.1.6：preScanned 路径跳过 Rescan 内的清理 → 这里补做
                    var scanned = await Task.Run(() =>
                    {
                        try { ModSvc.CleanupDuplicateCopiesIfChanged(Cfg.Current.GamePath); }
                        catch (Exception ex) { AppLog.Warn("Mods", "多副本清理失败: " + ex.Message); }
                        return ModSvc.Scan(Cfg.Current.GamePath);
                    });
                    if (_disposed) return;
                    // v1.2.4：磁盘没人动（快照与重扫一致）→ 跳过 Rescan 整表替换，
                    // 省掉返回列表后的第二次全列表 diff 渲染；有变化才走原路。
                    if (SameScan(scanned, _mods)) return;
                    Rescan(scanned);
                    StateHasChanged();
                }
                catch { }
            });
        }
        else
        {
            // v0.59.0：首屏先亮 shimmer 骨架，Rescan 完再切成真实列表
            _initialLoading = true;
            StateHasChanged();
            await Task.Yield();  // 让骨架先渲染一帧
            // vNext：磁盘扫描移出 UI 线程 —— 几百个 mod 的 manifest 解析不再卡住渲染
            // v1.1.6：preScanned 路径跳过 Rescan 内的清理 → 这里补做
            var scanned = await Task.Run(() =>
            {
                try { ModSvc.CleanupDuplicateCopiesIfChanged(Cfg.Current.GamePath); }
                catch (Exception ex) { AppLog.Warn("Mods", "多副本清理失败: " + ex.Message); }
                return ModSvc.Scan(Cfg.Current.GamePath);
            });
            if (_disposed) return;
            Rescan(scanned);
            _initialLoading = false;
        }
        // v1.06.7：必须在 Rescan 之后恢复远端版本标记 —— _mods 就绪后按 folder 回填
        // 「⇑ 可更新」状态（快照路径同样要跑：新实例的 _states 是空的）。
        ApplyKnownRemoteVersions();
        StateHasChanged();
        // v1.2.6：「维护存疑」原先只在跑过一轮更新检查后才有数据，第一次进页整列徽标和筛选
        // 计数都是空的，看着像这功能没生效。首屏就单独预查一次 —— 免 Key、一次批量请求、
        // 10 分钟会话缓存，不碰 Nexus 精查那条链路。
        _ = KickoffCompatPrecheck();
        // 覆盖包不住在 Mods\ 里，mod 行那条 HasUpdate 链（要求 _thisEntry）对它们恒为 false。
        // 单独查一轮喂筛选条红点与「覆盖包」视图；未登录/网络失败全部静默，不误报。
        _ = GuardedFireAndForget(CheckOverlayUpdatesAsync(), "覆盖包版本检查");
        if (ActiveProfileName != "默认"
            && AllProfiles.Any(p => p.Name == ActiveProfileName))
        {
            _ = InvokeAsync(async () =>
            {
                // 延迟一帧让首屏渲染完，再应用存档
                await Task.Delay(300);
                await ApplyProfile(ActiveProfileName);
            });
        }

        // SMAPI 检查和 mod 更新检测互不依赖，一起跑；不要让 SMAPI 网络请求
        // 卡住整页，mod 行一进入页面就开始检查远端版本。
        var smapiTask = SmapNeedsOld
            ? Updater.CheckSmapiForGameAsync(_smapiVersion, _gameVer)
            : Updater.CheckSmapiAsync(_smapiVersion);
        // v0.68.3：进入 Mod 页时完全由「设置」页「自动安装更新」开关（EnableAutoInstall）判定，不再弹窗询问。
        _ = InvokeAsync(async () => { await AutoUpdateOnEnterAsync(); await InvokeAsync(StateHasChanged); });
        // v1.2.1：封面缓存被清空时进页即补（免 key GraphQL），不等用户点「检查更新」
        _ = InvokeAsync(async () =>
        {
            try
            {
                var missing = _mods.Any(m => m.NexusModId is not null
                    && string.IsNullOrEmpty(GetState(m.Folder).PictureUrl)
                    && !Cfg.Current.ModCovers.ContainsKey(m.Folder)
                    && !Cfg.Current.ModCovers.ContainsKey(NormCoverKey(m.Folder)));
                if (missing) await BackfillCoversAsync();
            }
            catch { }
        });

        // Q4: 监听 Mods 文件夹变化，用户直接扔进去的 mod 也能立刻出现。
        // 建/放/重建的完整生命周期在 EnsureModsWatcher / ReleaseModsWatcher —— 版本切换期间
        // 会由 DepotDownloaderService 回调把它们放掉再重建（详见 _modsWatcherSlot）。
        EnsureModsWatcher();

        _smapiUpdate = await smapiTask;
        if (_smapiUpdate is not null) StateHasChanged();
    }

    private void RescanAndRestate()
    {
        // v1.1.6：watcher / 安装完成回调等高频入口改走后台版重扫 ——
        // 多副本清理 + 全盘扫描都不再占 UI 线程（旧版在 UI 线程连扫 1-2 遍全盘）。
        _ = RescanInBackground();
    }

    private bool _bgRescanRunning;
    private bool _bgRescanQueued;

    /// <summary>目录改名代次（启禁用是 X ↔ .X 的改名）。后台扫描开始前记下它，扫完发现变了
    /// 就丢掉这份结果重扫 —— 扫描枚举到的是改名前/后的混合状态，旧路径读取失败会被
    /// ScanRaw 的局部容错当作「这一项不在」跳过，套用后这一行会消失一两秒再被下一轮补回来
    /// （2026-11-06 用户反馈：连点两下启禁，行消失一两秒又出现）。</summary>
    private int _renameEpoch;

    /// <summary>v1.1.6：后台版重扫 —— CleanupDuplicateCopies（含全盘枚举+目录搬移）与
    /// Scan 都放 Task.Run，回 UI 线程只套用结果。扫描期间再来的事件合并为一轮补扫，
    /// 最后一个事件不丢。调用方必须已在 UI 线程（三处入口均为 InvokeAsync 回调）。</summary>
    private async Task RescanInBackground()
    {
        // 切换版本期间绝不重扫：CleanupDuplicateCopies 自己就会搬目录，和切换并跑等于两条线程
        // 同时动 Mods（实测改名重试全失败，报的就是 Mods 里 .junigrid_trash 被占用）。
        // 切换结束时本来就会刷一次本页，这里丢掉请求不丢数据。
        if (DepotDownloaderService.IsApplyInProgress) return;
        // v1.3.19：删除正在搬目录时不扫 —— 半消失的目录会被当成"新发现"再建一行。
        if (ModDeleteService.Busy) return;
        if (_bgRescanRunning) { _bgRescanQueued = true; return; }
        _bgRescanRunning = true;
        try
        {
            while (true)
            {
                _bgRescanQueued = false;
                // v1.1.8：这一轮在后台线程跑，不冻窗口，但它也要记账 —— 点完开关之后
                // 那段"还在转"的时间全在这里头（磁盘忙完才 StateHasChanged）。
                var __t = System.Diagnostics.Stopwatch.GetTimestamp();
                double __cleanup = 0, __rehome = 0;
                var __epoch = Volatile.Read(ref _renameEpoch);
                var scanned = await Task.Run(() =>
                {
        try { ModSvc.CleanupDuplicateCopiesIfChanged(Cfg.Current.GamePath); }
                    catch (Exception ex) { AppLog.Warn("Mods", "多副本清理失败: " + ex.Message); }
                    __cleanup = ElapsedMs(__t);
                    // 孤儿区自动归位：判得出唯一归属才搬，判不出的一律留在收件箱；全程只移动不删除
                    try { DepotQr.RehomeOrphanMods(Cfg.Current.GamePath); }
                    catch (Exception ex) { AppLog.Warn("Mods", "孤儿 Mods 归位失败: " + ex.Message); }
                    __rehome = ElapsedMs(__t);
                    return ModSvc.Scan(Cfg.Current.GamePath);
                });
                ModsPerf($"后台重扫一轮",
                    ("判重清理", __cleanup), ("孤儿归位", __rehome - __cleanup),
                    ("磁盘扫描", ElapsedMs(__t) - __rehome));
                if (_disposed || DepotDownloaderService.IsApplyInProgress) return;
                if (__epoch != Volatile.Read(ref _renameEpoch))
                {
                    // 扫描期间目录被改名：这一份结果可能缺行（旧路径已不存在），不能套用
                    _bgRescanQueued = true;
                    continue;
                }
                Rescan(scanned);
                // v1.3.18：整页 diff 也记账。列表上千行时它自己就是一段可观的渲染线程
                // 占用，[Perf] 只说"被占住 N ms"，不知道是谁占的 —— 这里补上主体。
                var __t3 = System.Diagnostics.Stopwatch.GetTimestamp();
                StateHasChanged();
                var __render = ElapsedMs(__t3);
                if (__render >= 120)
                    ModsPerf($"重渲染 {_mods.Count} 项", ("StateHasChanged", __render));
                if (!_bgRescanQueued) return;
            }
        }
        finally { _bgRescanRunning = false; }
    }

    /// <summary>vNext：preScanned 允许调用方先在后台线程扫盘、再回到 UI 线程套用结果
    /// （扫描本身不碰 UI 状态，选中集合清理在 UI 线程做，避免与渲染并发）。
    /// preScanned 为 null 时才在当前线程清理+扫描 —— RescanInBackground 传入的结果
    /// 已包含清理，跳过避免 UI 线程重复全盘扫两遍。</summary>
    private void Rescan(IReadOnlyList<ModEntry>? preScanned = null)
    {
        // v1.1.4：同 UniqueID 多副本物理清理 —— SMAPI 直接读磁盘，UI 隐藏不够
        //（多余副本会让整包 Skipped）。基于原始扫描结果，先清理再正式扫描。
        var __t = System.Diagnostics.Stopwatch.GetTimestamp();
        double __cleanupMs = 0, __scanMs = 0;
        if (preScanned is null)
        {
            try { ModSvc.CleanupDuplicateCopiesIfChanged(Cfg.Current.GamePath); }
            catch (Exception __ex) { AppLog.Warn("Mods", "多副本清理失败: " + __ex.Message); }
            __cleanupMs = ElapsedMs(__t);
            var __t2 = System.Diagnostics.Stopwatch.GetTimestamp();
            _mods = ModSvc.Scan(Cfg.Current.GamePath);
            __scanMs = ElapsedMs(__t2);
        }
        else
        {
            _mods = preScanned;
        }
        ReindexMods();
        ModsPerf($"重扫 {preScanned?.Count ?? _mods.Count} 项",
            ("判重清理", __cleanupMs), ("磁盘扫描", __scanMs), ("建索引", ElapsedMs(__t) - __cleanupMs - __scanMs));
        // v1.1.2：备注对账 —— mod 更新会重置 manifest Name，这里补写备注（游戏未运行时）
        if (Cfg.Current.ModRemarks.Count > 0)
            _ = Task.Run(() => ModSvc.SyncAllRemarks(Cfg.Current.GamePath, Cfg));
        // 清掉已经不在列表里的选中项（v1.1.6：走索引字典，不再每个选中项全表扫）
        _selected.RemoveWhere(f => !_modsByFolder.ContainsKey(f));
        // v0.72.7：Rescan 只负责扫描 —— 不再偷偷启动 BackfillCoversAsync。
        // 旧版每次 Rescan 都叠加一个网络回填任务（初始化/批量/watcher 回调任意触发），
        // 是"偶发卡死"的核心放大器。封面回填改由显式入口按需启动（带并发闸门）。
    }

    private void ReindexMods()
    {
        // 细分计时：这一步实机曾出现 2,809ms（186 项 mod），把启动后首帧钉死 3 秒。
        // v1.3.29：阈值从 300ms 降到 50ms —— 实测切页时它稳定占 157ms，正好卡在阈值下面
        // 一个字都不写，导致「438ms 无可归因段」查不出是谁。降到 50ms 才能看到 4 段分解。
        // 同时压一个 PerfScope 标记，让 UI 卡顿探针能直接把它指出来。
        using var __perf = JuniGrid.Services.PerfScope.Enter("Mods/建索引");
        var __rsw = System.Diagnostics.Stopwatch.StartNew();
        _rowsLoaded = true;
        _modsByFolder = new Dictionary<string, ModEntry>(_mods.Count, StringComparer.OrdinalIgnoreCase);
        foreach (var m in _mods) _modsByFolder[m.Folder] = m;
        // 覆盖包行上的「宿主标签」用另一张按归一化目录名的索引，列表一变就得重建。
        _hostsByNorm = null;
        // v1.2.3：已装 UID 集合随重扫一并重建 —— MissingDeps/筛选计数/分组在渲染期被高频
        // 调用，旧写法每次访问 InstalledUids 都全表重建 HashSet（每页渲染 O(N²) 次分配）。
        _installedUids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _disabledUids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _installedVersions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in _mods)
            if (!string.IsNullOrWhiteSpace(m.UniqueID))
            {
                _installedUids.Add(m.UniqueID.Trim());
                _installedVersions[m.UniqueID.Trim()] = m.Version ?? "";
                if (m.Disabled) _disabledUids.Add(m.UniqueID.Trim());
            }
        // 捆绑包里不单独成行的子包：SMAPI 照样加载，所以依赖它不算缺（Enabled 那份进已装集合）；
        // 顶层被禁用时子包一起算禁用 —— 它们是「依赖被禁用」，不是「缺依赖」。
        // 子包没有条目也就没有版本号，版本判据对它们一律不指控（见 VersionUtil.IsOlderThan）。
        var __rA = __rsw.ElapsedMilliseconds;
        var hidden = ModSvc.HiddenChildUids;
        _installedUids.UnionWith(hidden.Enabled);
        _installedUids.UnionWith(hidden.Disabled);
        _disabledUids.UnionWith(hidden.Disabled);
        // v1.2.5：缺失依赖缓存随重扫一并失效（依赖列表与 UID 集合都只在重扫时变化）
        _missingDepsCache.Clear();
        _staleDepsCache.Clear();
        var __rB = __rsw.ElapsedMilliseconds;
        // 覆盖型包（汉化补丁）的健康度随重扫刷新。绝大多数人一条都没有 → 先短路，
        // 别为了空表去哈希文件。
        _overlayHealth = Cfg.Current.Overlays.Count > 0
            ? ModService.OverlayHealth(Cfg.Current.GamePath, Cfg.Current)
            : new ModService.OverlayReport(new(), new());
        // 健康度换了 ⇒ 覆盖包视图（含筛选红点）必须重算。以前这个账只在弹窗里读，
        // 现在筛选条也要读它，忘了这一句红点就会一直停在上一轮的结论上。
        InvalidateOverlayCache();
        // 缺失依赖的展示名后台解析，列表行才显示得出"是哪个 mod"而不是裸 UID。
        // 只在出现还没问出结果的 UID 时才真发请求（见 _depNameNoMatch），重扫不会反复打网络。
        var __rC = __rsw.ElapsedMilliseconds;
        var missingAll = TotalMissingUids;
        if (missingAll.Count > 0) _ = GuardedFireAndForget(ResolveDepNamesAsync(missingAll), "依赖名解析");
        // 「版本不够」那批：后台认一次"哪一页真有要求的那一版"（每个依赖每轮最多 2 次文件表查询，
        // 认过就缓存）。不这么做，这一行的链接只能退回本机那份来自的页 —— 那一页给不出要求的版本。
        if (StaleNeedsByUid().Count > 0) _ = GuardedFireAndForget(ResolveStaleDepProvidersAsync(), "依赖溯源");
        var __rD = __rsw.ElapsedMilliseconds;
        if (__rD > 50)
            AppLog.Warn("ModsPerf",
                $"[索引] 基础={__rA}ms 子包={__rB - __rA}ms 覆盖健康={__rC - __rB}ms 缺依赖={__rD - __rC}ms 合计={__rD}ms");
    }

    /// <summary>v1.2.4：返回列表的快照与重扫结果是否一致（文件夹/启禁/版本/N网ID）。
    /// 一致 = 磁盘没人动过，整表替换后的二次全列表渲染纯属浪费（几百行的 diff
    /// 在低端 WebView2 上就是"返回列表停顿一下"的主力之一），直接跳过。
    /// 顺序不同按不一致处理 → 退回旧行为，宁可多渲染一次也不会漏掉真实变化。</summary>
    private static bool SameScan(IReadOnlyList<ModEntry> a, IReadOnlyList<ModEntry> b)
    {
        if (a.Count != b.Count) return false;
        for (var i = 0; i < a.Count; i++)
        {
            var x = a[i]; var y = b[i];
            if (!string.Equals(x.Folder, y.Folder, StringComparison.OrdinalIgnoreCase)) return false;
            if (x.Disabled != y.Disabled) return false;
            if (!string.Equals(x.Version, y.Version, StringComparison.Ordinal)) return false;
            if (x.NexusModId != y.NexusModId) return false;
        }
        return true;
    }

    /// <summary>已装 UniqueID 集合（ReindexMods 时重建的缓存，勿在渲染期重算）。</summary>
    private HashSet<string> _installedUids = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>已装但被禁用（含随顶层一起禁掉的捆绑包子包）的 UniqueID。
    /// 「装了」与「能加载」是两件事：SMAPI 对禁用依赖照样把依赖方 Skipped，
    /// 而缺依赖判定看不出来 —— 这一集专门用来给那种行打「依赖被禁用」标签。</summary>
    private HashSet<string> _disabledUids = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>已装 UniqueID → manifest 里的 Version（ReindexMods 时重建）。
    /// 「装了」与「装得够新」是第三件事：SMAPI 对版本不足的依赖照样 Skipped 依赖方，
    /// 只看 UID 在不在的判据对这条完全静音（实测 完美手册 因 StardewUI 版本过旧被跳过）。</summary>
    private Dictionary<string, string> _installedVersions = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<StaleDepRow>> _staleDepsCache = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>一条「装了但版本低于要求」的依赖，带上门禁和实际到场的版本号。</summary>
    private sealed record StaleDepRow(string Uid, string Name, string Have, string Need);

    // ------------------------------------------------------------------
    // 行交互：左键多选 / hover 按钮
    // ------------------------------------------------------------------
    // ─── v1.5：行尾 … 菜单（单开互斥；纯 class 驱动，无需 JS）───
    // 关闭直接摘 open，无关闭动画：曾用 closing+200ms 做收起，.up 菜单在摘 open
    // 时会弹回按钮下方再淡出（「关闭动画闪到下面」）。硬关即可。
    private string? _menuFolder;
    private bool _menuFitPending;

    private void ToggleMenu(string folder)
    {
        if (_menuFolder == folder)
        {
            CloseMenu();
            return;
        }
        // v1.5.4：开行内「⋮」前先收掉排序下拉 —— 反向同样会叠（行提到 9500 压住 toolbar）。
        // CloseSort 内部已经判过 _sortOpen，没开时是空操作。
        _ = CloseSort();
        _menuFolder = folder;
        // 翻转判定要量的是「这一行有几个条目」的菜单最终矩形，而 StateHasChanged 只是排队渲染：
        // 在这里直接调 JS，浏览器收到的顺序是 JS 先、渲染批次后 ⇒ 量到的是没 .open 的旧 DOM，
        // up 永远加不上（实测最后一行菜单整块掉到视口外）。改挂到 OnAfterRenderAsync 里，DOM 一定已就位。
        _menuFitPending = true;
        StateHasChanged();
    }

    private void CloseMenu()
    {
        if (_menuFolder is null) return;
        _menuFolder = null;
        StateHasChanged();
    }

    private void MenuAct(Action act)
    {
        // 硬关菜单并立刻执行动作（弹窗/跳转），不阻塞用户点击
        _menuFolder = null;
        act();
        StateHasChanged();
    }

    private void ToggleSelect(string folder)
    {
        if (!_selected.Remove(folder)) _selected.Add(folder);
        _pendingBatchDelete = false;
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _pendingBatchDelete = false;
    }

    // ── v1.3.46：自定义分类（用户自己建的分组，不是 N 网官方分类）──────────────
    // 数据：Cfg.ModUserCategory[顶层目录或独立 mod 文件夹] = 分类名（一个 mod 只属于一个）。
    // 「按分类」视图按它分段；右侧导航跳段。分类的增删改只动分组，不碰 mod 文件。
    private sealed class CategorySection
    {
        public string Key = "";
        public string Label = "";
        public int Count;
        public int Index;
        public List<string> Names = new();
    }

    private List<CategorySection> _categorySections = new();
    /// <summary>被折叠的分类（键 = 分类名，"" = 未分类）。只活在本次会话，不落盘。</summary>
    private readonly HashSet<string> _collapsedCats = new(StringComparer.OrdinalIgnoreCase);
    private int _categoryRev;
    private bool _categoryDialogOpen;
    /// <summary>这一次「加入分类」作用于哪些行：批量条 = 勾选的那批；行内「…」= 这一行。
    /// 两者共用同一个对话框，但作用范围不能混。</summary>
    private List<string> _categoryTargets = new();
    private string _categoryNewName = "";
    /// <summary>新建分类时前面那颗图标（默认小鸡）。挑的图在"新建并加入"时跟着落盘。</summary>
    private string _categoryNewIcon = CategoryIconService.DefaultSpec;
    /// <summary>图标选择器借用「分类键」来定位当前在改谁；新建分类还没有名字，
    /// 就用这个不可能与真实分类名冲突的哨兵值占位。</summary>
    private const string NewCatIconKey = "\u0001new";
    /// <summary>「新分类名」输入框开没开 —— 平时不开，点 ＋ 才出现（v1.3.48）。</summary>
    private bool _categoryNewOpen;
    /// <summary>＋ 刚按下、输入框还没渲染出来 ⇒ 下一帧再把焦点送进去（autofocus 属性实测不生效）。</summary>
    private bool _categoryInputFocusPending;
    private string? _categoryDialogError;
    private string? _categoryHover;
    private string? _categoryMenu;
    private string? _categoryRenameFrom;
    private string _categoryRenameDraft = "";
    private string? _pendingCategoryAnchor;
    // v1.3.51：长按拖拽 —— 手势全在 JS 里，这里只留一个回调引用（首帧交给 JS）。
    private DotNetObjectReference<Mods>? _dragRef;
    private bool _dragInit;

    /// <summary>分类的登记单位：捆绑包记顶层目录，独立 mod 记自己的文件夹 ——
    /// 与列表的一行对齐（子包不单独归分类）。</summary>
    private static string CategoryKeyOf(ModEntry m)
    {
        var top = GroupKeyOf(m);
        return top.Length > 0 ? top : m.Folder;
    }

    private string CategoryOfGroup(ModGroup g)
    {
        var key = g.Key.Length > 0 ? g.Key : g.Items.Count > 0 ? g.Items[0].Folder : "";
        if (key.Length == 0 || !Cfg.Current.ModUserCategory.TryGetValue(key, out var c)) return "";
        // 2026-11-07：一个 mod 现在可以同时归进多个分类（安装弹窗支持多选），配置里存成
        // "9,10"。列表只按第一个分类摆（同一个 mod 不重复画行），其余分类只作标签保留。
        return FirstCategory(c);
    }

    /// <summary>配置里的分类值可能是多选拼起来的（<c>"9,10"</c>）—— 取第一个。
    /// 老配置是单值，原样返回。口径统一在 <see cref="ModCategoryUtil.First"/>。</summary>
    private static string FirstCategory(string? raw) => ModCategoryUtil.First(raw);

    /// <summary>一组（捆绑包或独立 mod）归哪个分类；"" = 未分类。</summary>
    private string CategoryOfUnit(ModGroup g) => CategoryOfGroup(g);

    /// <summary>单个 mod 归哪个分类（与列表那一行同一口径：捆绑包按顶层目录登记）。
    /// 段头「点一下全选」用它从当前视图里挑出这一段的成员。</summary>
    private string CategoryOfMod(ModEntry m)
        => Cfg.Current.ModUserCategory.TryGetValue(CategoryKeyOf(m), out var c) ? FirstCategory(c) : "";


    /// <summary>有没有任何已登记的自定义分类（含空分类）。没有时列表不画分段、右侧不出导航。</summary>
    private bool HasUserCategories()
        => Cfg.Current.ModUserCategoryOrder.Any(x => !string.IsNullOrWhiteSpace(x))
           || Cfg.Current.ModUserCategory.Values.Any(v => !string.IsNullOrWhiteSpace(v));

    /// <summary>分类的登记信息。查不到时给一个「未登记」的占位（<c>Index = -1</c>）：
    /// 它只用于取标签与排序（<c>Index &lt; 0</c> 排最后），绝不能退回 0 —— 0 是真实存在的
    /// 第一段，退回去就等于「把这一段当成第一段」，折叠/滚动会打到别人身上。</summary>
    private CategorySection CategorySectionOf(string key)
        => _categorySections.FirstOrDefault(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase))
           ?? new CategorySection { Key = key, Label = key.Length > 0 ? key : Loc.T("未分类"), Index = -1 };

    // ── 分类段的 DOM id ────────────────────────────────────────────────
    // v1.3.84：段头/段体的 id 不再用 _categorySections 里的序号。
    // 那段序号是「渲染这一刻」的排序结果，一旦登记表和屏上画的对不上（空分类没登记、
    // 平铺兜底把登记表清了、段序重排），两段就会共用同一个 id；catToggle/滚动全是
    // querySelector/getElementById 按 id 找一个元素 —— 撞车就是「点这个空分类，把有 mod
    // 的那一段折叠了」（2026-11-08 实机，id 全是 jg-cat-body-0）。
    // 分类名是用户输入（中文、空格、引号都可能有），不能直接拼进 id 与选择器，
    // 所以按名字发一个令牌 k1/k2…，一次会话内稳定、绝不重复。
    private readonly Dictionary<string, string> _catDomIds = new(StringComparer.OrdinalIgnoreCase);
    private int _catDomSeq;

    /// <summary>分类名 → 稳定 DOM 令牌（同一分类永远同一个令牌，与段序无关）。</summary>
    private string CatDomId(string key)
    {
        if (_catDomIds.TryGetValue(key, out var id)) return id;
        id = "k" + (++_catDomSeq).ToString();
        _catDomIds[key] = id;
        return id;
    }

    private string CatHeadAnchor(string key) => "jg-cat-" + CatDomId(key);
    private string CatBodyAnchor(string key) => "jg-cat-body-" + CatDomId(key);

    /// <summary>已有分类。v1.3.48：顺序与列表分段/右侧导航一致 —— 新建的在最前
    /// （ModUserCategoryOrder 是建分类时追加的，倒过来读就是最新在前）。之前弹窗是正序，
    /// 和屏上段的顺序正好相反 ⇒ 照着最上面那个分类去点弹窗第一行，加进去的是另一个。
    /// v1.3.46：成员搬空的分类也保留 —— 删除分类只有弹窗里那颗「×」和段头「…」两条显式
    /// 路径，搬走最后一个 mod 不等于删分类。</summary>
    private List<string> ExistingCategories()
    {
        var known = new List<string>();
        foreach (var c in Cfg.Current.ModUserCategoryOrder)
            if (!string.IsNullOrWhiteSpace(c) && !known.Contains(c, StringComparer.OrdinalIgnoreCase)) known.Add(c);
        var list = new List<string>(known);
        list.Reverse();                       // 最新建的在最前，和分段标题/右侧导航同一个顺序
        // 值可能是多选拼起来的 "9,10" —— 先拆开再收集，否则会把整串当成一个分类名
        var used = Cfg.Current.ModUserCategory.Values
            .SelectMany(v => ModCategoryUtil.Split(v))
            .Where(v => v.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase);
        foreach (var c in used)
            if (!list.Contains(c, StringComparer.OrdinalIgnoreCase))
                list.Add(c);                  // 名单外的老分类排最后（列表里也是垫底）
        return list;
    }

    /// <summary>这次要操作的行共同的分类："" = 都未分类；分类名 = 都一样；null = 来自不同分类。
    /// 对话框用它把当前分类那颗 chip 点亮（多选混分类时一颗都不亮）。</summary>
    private string? CommonCategory()
    {
        string? common = null;
        var first = true;
        foreach (var f in _categoryTargets)
        {
            var cat = "";
            if (_modsByFolder.TryGetValue(f, out var m))
                cat = Cfg.Current.ModUserCategory.TryGetValue(CategoryKeyOf(m), out var c) ? FirstCategory(c) : "";
            if (first) { common = cat; first = false; }
            else if (!string.Equals(common, cat, StringComparison.OrdinalIgnoreCase)) return null;
        }
        return first ? "" : common;
    }

    /// <summary>虚线加号：输入框平时不在屏上，所以先让它出现，下一帧再把焦点送进去。
    /// 已经开着就只聚焦 —— 重复点 ＋ 不该把他刚打的字清掉。</summary>
    private void FocusCategoryInput()
    {
        if (_categoryNewOpen)
        {
            _ = JS.InvokeVoidAsync("junigridJs.focusElement", ".jg-cat-dialog .jg-remark-input");
            return;
        }
        _categoryNewOpen = true;
        _categoryInputFocusPending = true;
    }

    private void OpenCategoryDialog()
    {
        if (_selected.Count == 0) return;
        _categoryTargets = _selected.ToList();
        _categoryDialogOpen = true;
        _categoryNewName = "";
        _categoryNewOpen = false;

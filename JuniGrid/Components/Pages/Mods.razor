    private async Task OpenDetail(ModEntry m)
    {
        if (m.NexusModId is not null)
        {
            // v0.72.2：诊断日志 —— 滚动链路此前全程静默，失败无迹可查。
            // jsVer 探测加载的 interop.js 是新是旧（WebView2 缓存旧 JS 时这里会现形）。
            try
            {
                var jsVer = await JS.InvokeAsync<string>("eval",
                    "(window.junigridJs && window.junigridJs.getScrollState) ? 'interop-new' : 'interop-OLD-CACHED'");
                var snap = await JS.InvokeAsync<ScrollSnapshot>("junigridJs.getScrollState", ".jg-main");
                _restoreScroll = snap.Y;
                _restoreAtBottom = snap.AtBottom;
                // v1.2.5：正常流程快照日志移除
                // v0.72.4：给 .jg-main 打「待恢复」标记 —— 返回后行列表在落位前保持隐藏，
                // 浏览器画不出「列表在顶部」的那一帧（闪屏根因）
                await JS.InvokeVoidAsync("junigridJs.markScrollRestorePending", ".jg-main");
                _scrollRestoreClassPending = true;
                // v0.71.2：双写 sessionStorage（scrollSpy 同 key）——静态字段在 Blazor 服务端路由缓存下时序不稳，
                // sessionStorage 是持久兜底；返回时 setScrollWhenReady 读哪个都行。
                await JS.InvokeVoidAsync("junigridJs.saveScrollKey", "modslist", _restoreScroll, _restoreAtBottom);
            }
            catch (Exception ex)
            {
                AppLog.Error("Mods", "[诊断] OpenDetail 快照失败: " + ex.Message);
            }
            Nav.NavigateTo($"mod/{m.NexusModId}" + (string.IsNullOrEmpty(m.UniqueID) ? "" : "/" + Uri.EscapeDataString(m.UniqueID)));
        }
    }


    private HashSet<string> InstalledUids => _installedUids;

    /// <summary>应用过滤 + 搜索后的 mod 列表。</summary>
    private IReadOnlyList<ModEntry> FilteredMods
    {
        get
        {
            IEnumerable<ModEntry> q = _mods;
            switch (_filter)
            {
                case "enabled": q = q.Where(m => !m.Disabled); break;
                case "disabled": q = q.Where(m => m.Disabled); break;
                case "updatable":
                    q = q.Where(m => IsUpdatable(m));
                    break;
                case "missing":
                    // v1.1.4：缺依赖筛选 —— 含 ContentPackFor 宿主缺失（SMAPI 同样会 Skipped）
                    // 版本过旧的那批也在这里：SMAPI 对两者的处置是同一条（依赖方不加载）
                    q = q.Where(m => MissingDeps(m).Count > 0 || StaleDeps(m).Count > 0);
                    break;
                case "broken":
                    q = q.Where(IsBroken);
                    break;
            }
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var s = SearchText.Trim();
                // 输入是纯数字时，当成 N 网尾号（NexusModId）模糊匹配，例如 4964794 或只输 9647 都能定位到。
                bool numeric = int.TryParse(s, out _);
                // v1.1.4：备注名/原名一并参与搜索 —— 列表标题显示"自动化(Automate)"，
                // 搜"自动化"或"Automate"都得能找到（备注在配置里，不在 m.Name 上）
                var remarks = Cfg.Current.ModRemarks;
                var originals = Cfg.Current.ModOriginalNames;
                q = q.Where(m =>
                    m.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || m.Author.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || m.UniqueID.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (remarks.TryGetValue(m.Folder, out var rk) && rk.Contains(s, StringComparison.OrdinalIgnoreCase))
                    || (originals.TryGetValue(m.Folder, out var og) && og.Contains(s, StringComparison.OrdinalIgnoreCase))
                    || (numeric && m.NexusModId is not null
                        && m.NexusModId.Value.ToString().Contains(s, StringComparison.Ordinal)));
            }
            return q.ToList();
        }
    }

    private int CountFor(string key) => key switch
    {
        "all" => _mods.Count,
        "enabled" => _mods.Count(m => !m.Disabled),
        "disabled" => _mods.Count(m => m.Disabled),
        "updatable" => _mods.Count(m => IsUpdatable(m)),
        "missing" => _mods.Count(m => MissingDeps(m).Count > 0 || StaleDeps(m).Count > 0),
        "broken" => _mods.Count(IsBroken),
        _ => 0,
    };

    // ── v1.2.5：SMAPI 社区兼容性判定（数据随上面的 smapi.io 批量预查一起取回）──
    // 词表按 SMAPI 那份库：ok / unknown / optional 都不构成提示，只有明确的负面判定才标。
    private static bool IsBadCompatStatus(string? s) =>
        !string.IsNullOrEmpty(s) && s is not ("ok" or "unknown" or "optional");

    /// <summary>「维护存疑」的口径 = 上游清单点名过的那些行，<b>包括已经在跑社区接手版的</b>：
    /// "原作者不 maintenance 了"这件事与"你还有没有东西要下"是两个事实，前者一条都不能漏，
    /// 否则这个筛选就成了"只列还能去装的那几个"。区别只在行上挂什么 —— 还有得装的给警告徽标
    /// （<see cref="BrokenBadge"/>），已兑现的给中性标签（<see cref="UnofficialTag"/>）。
    /// 计数只依赖第一次批量响应，不依赖后到的身份证据，所以切进来不会看到数字跳。</summary>
    private bool IsBroken(ModEntry m) =>
        _smapiPrecheckStatus is not null
        && _smapiPrecheckStatus.TryGetValue(m.Folder, out var st) && IsBadCompatStatus(st);

    /// <summary>这一行的身份证据还在路上，先别落徽标。只推迟"除替代版页面版本以外没有别的证据"的行：
    /// summary 里直接写了推荐版本号的（<c>&lt;small&gt;</c>）与"替代版就是自己那页"的当场就能判，
    /// 不该被推迟；解析彻底失败的行在证据标记落下后照常标出来，不会永远压着不报。</summary>
    private bool AltEvidenceInFlight(ModEntry m) => _altEvidencePending
        && AltOf(m) is null && AltVerOf(m) is null
        && string.IsNullOrEmpty(RecommendedVersion(BrokenRaw(m)));

    private string? BrokenBadge(ModEntry m)
    {
        if (_smapiPrecheckStatus is null
            || !_smapiPrecheckStatus.TryGetValue(m.Folder, out var st) || !IsBadCompatStatus(st)) return null;
        if (AltIsSelfNow(m) || AltEvidenceInFlight(m)) return null;
        return st switch
        {
            "unofficial" => Loc.T("需非官方版"),
            "workaround" => Loc.T("有替代版"),
            "broken"     => Loc.T("已失效"),
            "obsolete"   => Loc.T("已过期"),
            "abandoned"  => Loc.T("作者弃养"),
            _            => Loc.T("有问题"),
        };
    }

    /// <summary>被点名、但上游的建议早已兑现（你跑的就是它指的那一版）的行：<b>不报警告</b>，
    /// 只挂一条中性标签，把"原作者不干了、这是社区接手版"这条信息留着。撤徽标撤的是重复提醒，
    /// 不是这条事实 —— 什么都不说等于把已知信息删掉。与警告徽标互斥，但照样被「维护存疑」列出。</summary>
    private string? UnofficialTag(ModEntry m)
    {
        if (_smapiPrecheckStatus is null
            || !_smapiPrecheckStatus.TryGetValue(m.Folder, out var st) || !IsBadCompatStatus(st)) return null;
        if (AltEvidenceInFlight(m) || !AltIsSelfNow(m)) return null;
        return st == "unofficial" ? Loc.T("非官方接手") : Loc.T("作者已停更");
    }

    /// <summary>中性标签的落点：优先"你跑的这一版实际住在的那一页"（搜到的替代版页，或 summary
    /// 链接指的页），都没有才回落到它自己的页面。文案与点击共用这一个判据。</summary>
    internal static (string Url, bool OnForkPage) PickUnofficialTarget(
        string? rawSummary, (int ModId, string Name)? alt, int? nexusModId, string name, string folder)
    {
        var page = alt?.ModId ?? SummaryLinkId(rawSummary);
        if (page > 0) return ("https://www.nexusmods.com/stardewvalley/mods/" + page, true);
        // 实测：Wind Effects / SAAT / Show Birthdays 的接手版根本不住在 N 网 —— summary 里那条
        // 链接直接指向论坛帖或 GitHub releases。跳回早已停更的原页面没有意义，就去它给的那个地址。
        var link = MdLink.Match(rawSummary ?? "");
        if (link.Success && IsWebUrl(link.Groups[2].Value)) return (link.Groups[2].Value, true);
        if (nexusModId is int own && own > 0)
            return ("https://www.nexusmods.com/stardewvalley/mods/" + own, false);
        return ("https://www.nexusmods.com/stardewvalley/search?q="
            + Uri.EscapeDataString(string.IsNullOrWhiteSpace(name) ? folder : name), false);
    }

    private string UnofficialTip(ModEntry m)
    {
        var (_, onFork) = PickUnofficialTarget(BrokenRaw(m), AltOf(m), m.NexusModId, m.Name, m.Folder);
        return onFork
            ? Loc.F("你装的 {0} 就是社区接手的那一版 · 原作者已停更 · 点一下打开接手版页面", m.Version)
            : Loc.F("你装的 {0} 是社区接手版 · 原作者已停更 · 点一下打开原页面（已停更）", m.Version);
    }

    private void OpenUnofficial(ModEntry m) => UpdateService.OpenUrl(PickUnofficialTarget(
        BrokenRaw(m), AltOf(m), m.NexusModId, m.Name, m.Folder).Url);

    // ── v1.2.5：覆盖型包（汉化补丁）的标记、清单与还原 ──
    private ModService.OverlayReport _overlayHealth = new(new(), new());
    private string? _overlayHost;

    /// <summary>覆盖记录按宿主<b>顶层</b>目录名记账，而列表行的 m.Folder 可能是 "Top/Sub"
    /// （子包），且禁用态在磁盘上是 ".Top"。统一归一到不带点的顶层名再比。</summary>
    /// <summary>覆盖记录按「宿主目录」挂徽标，所以这里必须给到和记录里同一个形状：
    /// 顶层就是顶层名，捆绑包子包是「捆绑包/子包」（子包的汉化只该出现在子包那一行）。
    /// 禁用只是顶层改名（X → .X），点号在这里去掉。</summary>
    private static string OverlayHostOf(ModEntry m) => ModService.NormalizeOverlayHost(m.Folder);

    /// <summary>某个宿主行对应的「包」数与失效包数。记录是逐文件的（一个汉化重打包 146 条），
    /// 徽标要说包数 —— 显示「覆盖 ×146」等于骗人。</summary>
    private (int Packs, int StalePacks) OverlayPackStats(string host)
    {
        var groups = Cfg.Current.Overlays
            .Where(kv => ModService.NormalizeOverlayHost(kv.Value.Host)
                .Equals(host, StringComparison.OrdinalIgnoreCase))
            .GroupBy(kv => ModService.OverlaySlotOf(kv.Key), StringComparer.OrdinalIgnoreCase)
            .ToList();
        return (groups.Count, groups.Count(g => g.Any(kv => _overlayHealth.StaleKeys.Contains(kv.Key))));
    }

    private string? OverlayBadge(ModEntry m)
    {
        if (_overlayHost is not null) return null;
        if (!_overlayHealth.ByHost.ContainsKey(OverlayHostOf(m))) return null;
        return Loc.F("覆盖 ×{0}", OverlayPackStats(OverlayHostOf(m)).Packs);
    }

    private bool OverlayStale(ModEntry m) => OverlayPackStats(OverlayHostOf(m)).StalePacks > 0;

    private string OverlayTip(ModEntry m)
    {
        var s = OverlayPackStats(OverlayHostOf(m));
        return s.StalePacks > 0
            ? Loc.F("{0} 个覆盖包，其中 {1} 个已经不在了（宿主 mod 更新过）—— 点击查看或还原", s.Packs, s.StalePacks)
            : Loc.F("{0} 个覆盖包（汉化补丁等）—— 点击查看或还原", s.Packs);
    }

    private void OpenOverlayList(ModEntry m)
    {
        _overlayHost = OverlayHostOf(m);
        _ = GuardedFireAndForget(EnsureOverlayMetaAsync(), "元信息加载");
    }
    private void CloseOverlayList() => _overlayHost = null;

    /// <summary>卡片标题：优先 N 网解析来的 mod 名，退回包名，再退回"来自 N 网"。</summary>
    private static string OverlayTitle(OverlayRecord rec) =>
        !string.IsNullOrWhiteSpace(rec.PackTitle) ? rec.PackTitle
        : !string.IsNullOrWhiteSpace(rec.PackName) ? rec.PackName : LocService.Tr("来自 N 网");


    /// <summary>覆盖包不是装进 Mods 的 mod，没有本地行可点，所以详情页入口挂在卡片上。
    /// 路由的 UniqueID 段是可选的（"/mod/{ModId:int}/{UniqueID?}"），这里只有 N 网 id。</summary>
    private void GoOverlayDetail(OverlayRecord rec)
    {
        if (rec.NexusModId is not int id) return;
        CloseOverlayList();
        Nav.NavigateTo($"mod/{id}");
    }

    /// <summary>用记录里的 NexusModId 补齐显示名与封面，写回记录（一次性的，之后离线也认得）。</summary>
    private async Task EnsureOverlayMetaAsync()
    {
        var need = Cfg.Current.Overlays.Values
            .Where(v => v.NexusModId is int && string.IsNullOrEmpty(v.PackTitle))
            .ToList();
        foreach (var rec in need)
        {
            NexusModInfo? info;
            try { info = await Nexus.GetModAsync(rec.NexusModId!.Value); }
            catch { continue; }
            if (info is null || string.IsNullOrWhiteSpace(info.Name)) continue;
            rec.PackTitle = info.Name;
            rec.PackCover = info.PictureUrl ?? "";
            Cfg.Save(Cfg.Current);
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>一个「包」在某个宿主上的一组覆盖记录。汉化重打包会一次产生上百条逐文件记录
    /// （LewdDew 那个是 146 条），卡片必须一行一个包，开关和删除对整组生效。</summary>
    private sealed record OverlayGroup(string Host, string Slot, List<string> Keys,
        OverlayRecord Rec, bool AnyOn, int Stale);

    private List<OverlayGroup> OverlayGroups()
    {
        if (_overlayHost is null) return new List<OverlayGroup>();
        return Cfg.Current.Overlays
            .Where(kv => ModService.NormalizeOverlayHost(kv.Value.Host)
                .Equals(_overlayHost, StringComparison.OrdinalIgnoreCase))
            .GroupBy(kv => ModService.OverlaySlotOf(kv.Key), StringComparer.OrdinalIgnoreCase)
            .Select(g => new OverlayGroup(
                g.First().Value.Host,
                g.Key,
                g.Select(kv => kv.Key).OrderBy(k => k, StringComparer.OrdinalIgnoreCase).ToList(),
                g.First().Value,
                g.Any(kv => kv.Value.Enabled),
                g.Count(kv => _overlayHealth.StaleKeys.Contains(kv.Key))))
            .OrderBy(x => x.Rec.PackTitle.Length > 0 ? x.Rec.PackTitle : x.Rec.PackName,
                StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void ToggleOverlayGroup(OverlayGroup g, bool on)
    {
        var err = ModSvc.SetOverlayGroupEnabled(Cfg.Current.GamePath, g.Host, g.Slot, on, Cfg);
        if (err is not null) _ = JS.InvokeVoidAsync("junigridJs.toast", err, "err");
        else _ = RescanInBackground();
    }

    private void RevertOverlayGroup(OverlayGroup g)
    {
        // 整组都失效时没有东西可还原，销账而已 —— 两种结果说不同的话，别统一报"已还原"
        var gone = g.Stale == g.Keys.Count;
        var err = ModSvc.RevertOverlayGroup(Cfg.Current.GamePath, g.Host, g.Slot, Cfg);
        _ = JS.InvokeVoidAsync("junigridJs.toast",
            err ?? (gone ? Loc.T("已清除该覆盖记录") : Loc.T("已还原被覆盖的文件")), err is null ? "ok" : "err");
        if (err is null) Rescan();
    }

    // summary 是 markdown（"broken, use [unofficial version](https://…)"）。徽标悬停已经不抄整段了，
    // 这个正则只用来从里面抠出替代版本的链接，给点徽标跳转用。
    private static readonly System.Text.RegularExpressions.Regex MdLink =
        new(@"\[([^\]]*)\]\(([^)]+)\)", System.Text.RegularExpressions.RegexOptions.Compiled);

    private string? BrokenRaw(ModEntry m) =>
        _smapiPrecheckSummary is not null && _smapiPrecheckSummary.TryGetValue(m.Folder, out var s) ? s : null;

    /// <summary>徽标悬停只解释「这个标签是什么意思」+「点下去会到哪」。上游 summary 是整段英文、
    /// 还带展开后的长 N 网链接，直接贴上去会跑出屏幕被裁掉；跳转改由点徽标完成。</summary>
    private string BrokenTip(ModEntry m)
    {
        var st = _smapiPrecheckStatus is not null && _smapiPrecheckStatus.TryGetValue(m.Folder, out var s) ? s : "";
        var what = st switch
        {
            "unofficial" => Loc.T("官方版没跟上当前游戏版本，社区出了非官方跟进版"),
            "workaround" => Loc.T("原版有已知问题，社区给了替代版本"),
            "broken"     => Loc.T("社区兼容性库判定它在当前游戏版本上跑不起来"),
            "obsolete"   => Loc.T("游戏本体已经实现了，这个 mod 不再需要"),
            "abandoned"  => Loc.T("作者已弃养，将来大概率跟不上新版本"),
            _            => Loc.T("社区兼容性库判定这个 mod 在当前游戏版本上有问题"),
        };
        var (_, altName, kind) = PickBrokenFix(
            BrokenRaw(m), PrecheckUrlOf(m), AltOf(m), m.NexusModId, m.Name, m.Folder, AltIsSelfNow(m));
        if (BrokenRaw(m) is not { Length: > 0 }) return what;
        return kind switch
        {
            // 只有真的落到另一个 mod 上，才敢说"替代版本"四个字。
            // 上游直接给了链接时不重复贴链接本身（实测 5 条里 4 条是 60+ 字符的论坛长链，
            // 贴进悬停会跑出屏幕被裁掉），点名到具体哪个 mod 只在"我们按名字搜出来的"那种场合。
            0 => altName is { } an ? Loc.F("{0} · 替代版：{1} · 点徽标打开", what, an)
                                   : Loc.F("{0} · 点徽标打开替代版本", what),
            2 => Loc.F("{0} · 社区没留链接 · 点徽标去 N 网搜替代品", what),
            _ => Loc.F("{0} · 点徽标打开它的页面", what),
        };
    }

    /// <summary>只认真正的 http(s) 地址。上游那张表里有 <c>[Friends Forever (1.6)](#)</c>
    /// 这种占位锚点，丢给 ShellExecute 只会静默失败 —— 症状就是"徽标点了没反应"。</summary>
    private static bool IsWebUrl(string? s) =>
        !string.IsNullOrWhiteSpace(s)
        && (s.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("https://", StringComparison.OrdinalIgnoreCase));

    /// <summary>从 summary 的 markdown 链接里取「替代版的名字」：链接位是 <c>(#)</c> 占位时，
    /// 方括号里那段文字就是社区点名的替代品（实测 "⚠ use [Friends Forever (1.6)](#) instead."）。
    /// 有真链接时返回 null —— 那种直接开链接就行，不必再按名字搜。</summary>
    internal static string? BrokenAltName(string? rawSummary)
    {
        if (rawSummary is null) return null;
        var link = MdLink.Match(rawSummary);
        if (!link.Success) return null;
        if (IsWebUrl(link.Groups[2].Value)) return null;
        var text = link.Groups[1].Value.Trim();
        return text.Length > 1 ? text : null;
    }

    /// <summary>徽标落点。<paramref name="alt"/> 是按 <see cref="BrokenAltName"/> 的名字搜出来的
    /// 那个独立 mod（N 网 20702「Friends Forever (1.6)」，本体是 1738）。
    /// <paramref name="homeId"/> 是 smapi.io 报的 <c>main.url</c> 里那个号 ——「你装的这一版住在哪儿」。
    /// 返回 kind：0=落在替代版上、1=落在它自己/来源页、2=只能给搜索结果页。
    /// 提示文案与点击落点都出自这里，两者不会再各说各话。</summary>
    internal static (string Url, string? AltName, int Kind) PickBrokenFix(
        string? rawSummary, string? precheckUrl, (int ModId, string Name)? alt,
        int? nexusModId, string name, string folder, bool altIsSelf = false)
    {
        var usableAlt = altIsSelf ? null : alt;
        var link = rawSummary is null ? null : MdLink.Match(rawSummary);
        var url = link is { Success: true } ? link.Groups[2].Value : null;
        if (IsWebUrl(url) && !altIsSelf) return (url!, usableAlt?.Name, 0);
        // 上游没给链接，但我们按名字找到了另一个 mod ⇒ 这才是真的"打开替代版本"
        if (usableAlt is { } a)
            return ($"https://www.nexusmods.com/stardewvalley/mods/{a.ModId}", a.Name, 0);
        if (IsWebUrl(precheckUrl)) return (precheckUrl!, null, 1);
        if (nexusModId is int nid && nid > 0)
            return ($"https://www.nexusmods.com/stardewvalley/mods/{nid}", null, 1);
        if (IsWebUrl(url)) return (url!, null, 1);   // 链接就是自己这一页，仍然有地方可去
        // 兜底：搜索页是唯一一定落得地的地方
        return ("https://www.nexusmods.com/stardewvalley/search?q="
            + Uri.EscapeDataString(string.IsNullOrWhiteSpace(name) ? folder : name), null, 2);
    }

    private string? AltVerOf(ModEntry m) =>
        _smapiPrecheckAltVer is not null && _smapiPrecheckAltVer.TryGetValue(m.Folder, out var v) ? v : null;

    private string? MainVerOf(ModEntry m) =>
        _smapiPrecheckMainVer is not null && _smapiPrecheckMainVer.TryGetValue(m.Folder, out var v) ? v : null;

    /// <summary>警告徽标、中性标签、点击落点、提示文案四处必须用同一个判据 ——
    /// 否则会出现"行上说已兑现、点开的却是让你去下载的那一页"这种自相矛盾。
    /// （「维护存疑」的计数与筛选<b>不</b>走这里：被点名过的行一律列出，见 <see cref="IsBroken"/>。）</summary>
    private bool AltIsSelfNow(ModEntry m) =>
        AltIsSelf(BrokenRaw(m), AltOf(m), AltVerOf(m), m.Version, m.NexusModId, MainVerOf(m));

    private string? PrecheckUrlOf(ModEntry m) =>
        _smapiPrecheckUrl is not null && _smapiPrecheckUrl.TryGetValue(m.Folder, out var u) ? u : null;

    private (int ModId, string Name)? AltOf(ModEntry m) =>
        _smapiPrecheckAlt is not null && _smapiPrecheckAlt.TryGetValue(m.Folder, out var a) ? a : null;

    private void OpenBrokenFix(ModEntry m) => UpdateService.OpenUrl(PickBrokenFix(
        BrokenRaw(m), PrecheckUrlOf(m), AltOf(m), m.NexusModId, m.Name, m.Folder, AltIsSelfNow(m)).Url);

    /// <summary>被点名的 mod 里，上游只给了替代版名字没给链接的，按名字去 N 网把它找出来。
    /// 一个会话只查一次（静态缓存），且只查这几个 —— 实测 146 个里 6 个有徽标。
    /// 查不到就留空，落点自动降级成"它的页面/搜索页"，文案跟着降级。</summary>
    private static readonly Dictionary<string, (int ModId, string Name)?> SmapiAltCache = new();
    private Dictionary<string, (int ModId, string Name)?>? _smapiPrecheckAlt;

    private async Task ResolveAltsAndRefreshAsync(List<ModEntry> targets)
    {
        try { await ResolveBrokenAlternativesAsync(targets); }
        catch (Exception ex) { AppLog.Warn("Mods", "[替代版] 名字解析失败: " + ex.Message); }
        if (!_disposed) StateHasChanged();
    }

    private async Task ResolveBrokenAlternativesAsync(List<ModEntry> targets)
    {
        try
        {
            var found = new Dictionary<string, (int ModId, string Name)?>();
            // 快照必须在锁里取：首屏预查与「刷新」可能同时在跑，锁外复制会撞上
            // "Collection was modified"（静态缓存写方就在下面的 lock 里）。
            Dictionary<string, (int ModId, string Name)?> locked;
            lock (SmapiAltCache) locked = new Dictionary<string, (int ModId, string Name)?>(SmapiAltCache);
            foreach (var m in targets)
            {
                if (_disposed) return;
                var altName = BrokenAltName(
                    _smapiPrecheckSummary is not null && _smapiPrecheckSummary.TryGetValue(m.Folder, out var s) ? s : null);
                if (altName is null) continue;
                var key = string.IsNullOrEmpty(m.UniqueID) ? m.Folder : m.UniqueID;
                (int ModId, string Name)? hit;
                if (locked.TryGetValue(key, out var cached)) hit = cached;
                else
                {
                    // 故意**不**排除"我们自己那一页"：搜回来的号与它当前的版本号，
                    // 正是 AltIsSelf 判断"替代版=你手上这一版"的证据。
                    hit = await Nexus.FindModByNameAsync(altName);
                    lock (SmapiAltCache) SmapiAltCache[key] = hit;
                }
                if (hit is not null) found[m.Folder] = hit.Value;
            }
            // 「上游叫你去的那一页」当前的版本号 —— 判据②的数据源。两种来源都要覆盖：
            // 按名字搜出来的（Friends Forever），以及 summary 里直接给链接的（Adventurer's Guild 22591）。
            var vers = new Dictionary<string, string>();
            var pages = new Dictionary<string, int>();
            foreach (var m in targets)
            {
                var raw = _smapiPrecheckSummary is not null && _smapiPrecheckSummary.TryGetValue(m.Folder, out var sm0) ? sm0 : null;
                var page = found.TryGetValue(m.Folder, out var f) && f is { } fa ? fa.ModId : SummaryLinkId(raw);
                if (page > 0) pages[m.Folder] = page;
            }
            if (pages.Count > 0)
            {
                // 页号→版本查过一次就记住：否则每次点「刷新」都要重问一遍网络，
                // 而那几秒里证据是缺的 —— 徽标就会闪一下又消失。
                var need = pages.Values.Distinct().Where(p => !PageVerKnown(p)).ToArray();
                if (need.Length > 0)
                {
                    var fps = await Nexus.GetModFingerprintsBatchAsync(need);
                    if (fps is not null)
                        foreach (var (pid, fp) in fps)
                            if (!string.IsNullOrWhiteSpace(fp.Version))
                                lock (SmapiPageVerCache) SmapiPageVerCache[pid] = fp.Version;
                }
                foreach (var (folder, page) in pages)
                    if (TryGetPageVer(page, out var pv)) vers[folder] = pv;
            }
            // 两本字典必须**一起**上屏：先给"是哪一页"再给"那一页什么版本"，中间那一帧
            // AltIsSelf 会两条证据都抓不住（②要版本号、③页号对不上自己），于是警告徽标会闪出来
            // 再变回中性标签 —— 实测 150ms 采样抓到过这一次闪烁（t=3603 警告=1，300ms 后归 0）。
            _smapiPrecheckAlt = found;
            _smapiPrecheckAltVer = vers;
        }
        finally { _altEvidencePending = false; }
    }

    /// <summary>N 网页号 → 该页当前的版本号（跨本会话留着）。判据②「替代版页面当前版本==你装的」
    /// 靠它，查一次就够，不必每次刷新都重问。</summary>
    private static readonly Dictionary<int, string> SmapiPageVerCache = new();

    private static bool PageVerKnown(int page)
    {
        lock (SmapiPageVerCache) return SmapiPageVerCache.ContainsKey(page);
    }

    private static bool TryGetPageVer(int page, out string ver)
    {
        lock (SmapiPageVerCache) return SmapiPageVerCache.TryGetValue(page, out ver!);
    }

    // v1.08：检查失败（超时等）的 mod 数量 —— 驱动筛选栏提示与"可更新"红点
    private int FailedCheckCount => _states.Values.Count(s => s.Status == "failed");

    private void SetFilter(string key)
    {
        _filter = key;
        // v1.1.4：切换过滤后由 OnAfterRender 的 animatedListInit 重绑新行观察器。
        // 视口内的行当场展开不闪动，视口外的行滚动进入时播特效 —— 与首屏一致。
    }

    // v0.36.0：mod 列表 AnimatedList 滚动效果（进入视口 scale/opacity + 顶底渐变）
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 刚渲染出 .open 的「⋮」菜单：这时 DOM 里已有它的最终矩形，才能判断该不该翻到按钮上方
        if (_menuFitPending)
        {
            _menuFitPending = false;
            try { await JS.InvokeVoidAsync("junigridJs.fitModMenu"); } catch { }
        }
        // v0.71.1：从详情页返回时恢复滚动位置 —— setScrollWhenReady 轮询等容器高度足够再设
        // v0.72.0：带上离开时的「是否在底部」标记，恢复器不再用 y>limit 猜底部
        var dedicatedRan = false;
        if (!_initialLoading && _restoreScroll >= 0)
        {
            dedicatedRan = true;   // v1.06.8：本次走的是专用快照恢复，firstRender 兜底必须让位
            _entryRestoreRan = true;
            var y = _restoreScroll;
            var atBottom = _restoreAtBottom;
            _restoreScroll = -1;
            _restoreAtBottom = false;
            _scrollRestoreClassPending = false;
            // v1.2.5：正常流程诊断日志移除（AppLog 只有 WRN/ERR 两级，正常流程不应落 WRN）
            try
            {
                var reporter = DotNetObjectReference.Create(new ScrollRestoreReporter());
                await JS.InvokeVoidAsync("junigridJs.setScrollWhenReady", ".jg-main", y, atBottom, reporter);
            }
            catch (Exception ex)
            {
                AppLog.Error("Mods", "[诊断] 恢复滚动调用失败: " + ex.Message);
                try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
            }
        }
        else if (!_initialLoading && _scrollRestoreClassPending)
        {
            // v0.72.4：带着「待恢复」标记回到列表但没有可恢复快照
            // （如从详情页直接点了顶部导航再回来）→ 摘掉隐藏标记，行列表正常显示
            _scrollRestoreClassPending = false;
            _entryRestoreRan = true;
            try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
        }
        // v1.1.4：每次列表渲染后都重新绑定入场动画观察器。此前筛选/搜索切换走
        // _skipListAnimOnce 分支只解绑不重绑，新结果的行全部失去滚动特效，且回到
        // 「全部」后也不恢复。animatedListInit 对已绑定行是零开销跳过（__alBound），
        // 只对新增/未绑定的行做初始测量，逐帧渲染调用没有可感知开销。
        if (!_initialLoading)
        {
            try { await JS.InvokeVoidAsync("junigridJs.animatedListInit", ".jg-main", ".jg-modrows"); } catch { }
        }
        if (firstRender)
        {
            // v0.45.0：记忆 /mods 滚动位置 —— 进详情页再返回时恢复到原来滚动的高度，
            // 而不是回到页面顶部
            try { await JS.InvokeVoidAsync("junigridJs.scrollSpy", ".jg-main", "modslist", false); } catch { }
        }

        // vNext：进入页面统一恢复离开时的位置 —— 不再只限 popstate 返回。
        // 从其它页点导航图标回来（前进导航）同样恢复：scrollSpy 一直在往 modslist 键
        // 写「离开时的位置」，这里直接读它落位。冷启动 sessionStorage 为空（y≈0）
        // 自然不恢复；手动刷新不重建组件不走这里。专用快照（详情页返回）优先级更高。
        // vNext：等列表真实显示（_initialLoading=false）后才跑 —— 骨架屏期标记
        // 「待恢复」会把骨架本身也藏掉（.jg-modrows-skeleton 同名 class）。
        if (!_initialLoading && !_entryRestoreRan)
        {
            _entryRestoreRan = true;
            if (!dedicatedRan && _restoreScroll < 0)
            {
                try
                {
                    var y = await JS.InvokeAsync<double>("junigridJs.readScrollKey", "modslist");
                    if (y > 1)
                    {
                        // v1.2.5：正常流程诊断日志移除
                        // 先挂「待恢复」隐藏标记（.jg-main 跨导航持久），落位后由
                        // setScrollWhenReady 同帧揭开，避免「列表先在顶部闪一帧」
                        await JS.InvokeVoidAsync("junigridJs.markScrollRestorePending", ".jg-main");
                        var reporter = DotNetObjectReference.Create(new ScrollRestoreReporter());
                        await JS.InvokeVoidAsync("junigridJs.setScrollWhenReady", ".jg-main", y, false, reporter);
                    }
                }
                catch (Exception ex)
                {
                    AppLog.Error("Mods", "[诊断] 通用进入恢复失败: " + ex.Message);
                    try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
                }
            }
        }
    }

    /// <summary>vNext：通用进入恢复只跑一次的闸门（骨架屏期不跑，列表显示后的第一次渲染跑）。</summary>
    private bool _entryRestoreRan;

    /// <summary>v1.1.5：点击分组行 = 全选/取消全选该捆绑包的全部子包（已全选则清空）。</summary>
    private void ToggleGroupSelection(IEnumerable<ModEntry> items)
    {
        var allSelected = items.All(m => _selected.Contains(m.Folder));
        if (allSelected)
            foreach (var m in items) _selected.Remove(m.Folder);
        else
            foreach (var m in items) _selected.Add(m.Folder);
    }

    /// <summary>捆绑包折叠状态（按 <see cref="NormGroupKey"/> 记，值 = 展不展开）。
    /// 跨页面进出留住，跟筛选/排序快照同待遇。</summary>
    private static readonly Dictionary<string, bool> _groupOpen = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>分组身份：剥掉点前缀的顶层目录名。子包那层改名只动末段，但<b>启用</b>一个子包会把带点的
    /// 祖先一并解开（<c>.SVE/Sub → SVE/Sub</c>，见 ModService.SetDisabled v1.1.7），顶层名当场就变。
    /// 拿原始顶层名记"我展开过"，拨一下开关这条记录就对不上号 —— 症状是整包自己折回去。</summary>
    public static string NormGroupKey(string key) => key.TrimStart('.');

    // 面板/箭头的 DOM id：文件夹名里有空格、括号、中文，不能直接当选择器用；
    // 取进程内稳定的哈希（与 Tasks 页 "jgDrop-"+Guid 同一套约定，taskDrop 要的是选择器）。
    private static string SubPanelId(string key) => "jgSub-" + SubKeyHash(key);
    private static string SubArrowId(string key) => "jgArr-" + SubKeyHash(key);
    private static string SubKeyHash(string key)
        => ((uint)NormGroupKey(key).GetHashCode(StringComparison.Ordinal)).ToString("x8");

    /// <summary>这一包展不展开。人手动点过的以他为准；没点过时，筛过/搜过的结果一律展开 ——
    /// 那时列表已经是"你要找的那几条"，把命中的子包折进一行底下等于把人正在找的东西藏起来。</summary>
    private bool GroupOpen(string key)
    {
        var k = NormGroupKey(key);
        if (_groupOpen.TryGetValue(k, out var v)) return v;
        return _filter != "all" || !string.IsNullOrWhiteSpace(SearchText);
    }

    /// <summary>展开/收起动画借下载详情那支（<c>junigridJs.taskDrop</c>：GSAP 弹簧高度 +
    /// 箭头 back.out 旋转）；动画收尾清内联样式，稳态交给 CSS 的 .open，重渲染不会把面板打回隐藏。
    /// ⚠ 状态必须等 JS 调用回来之后再落：先落状态的话 Blazor 摘 .open 的那一帧比 GSAP 挂上内联
    /// 高度早（实测 19ms vs 29ms），CSS 的 height:0 会先把面板拍平，动画就成了 0→0 的空播（实测收起
    /// 是瞬间跳的）。等 JS 回来时内联高度已经在了，class 再怎么翻都被内联样式压住。</summary>
    private async Task ToggleGroupOpen(string key)
    {
        var want = !GroupOpen(key);
        try
        {
            await JS.InvokeVoidAsync("junigridJs.taskDrop", "#" + SubPanelId(key), "#" + SubArrowId(key), want);
        }
        catch { }
        _groupOpen[NormGroupKey(key)] = want;
    }

    /// <summary>缺失的依赖（声明在 Dependencies 里、但不在已装 UniqueID 集合中的项）。
    /// v1.1.4：ContentPackFor 宿主框架也算 —— SMAPI 会直接 Skipped 宿主缺失的内容包
    /// （如 [BL] Downtown Zuzu 缺 hootless.BusLocations），不提示用户根本不知道为啥跑不起来。
    /// v1.2.5：单次渲染会被 5 条路径反复调用（每行渲染 / CountFor("missing") /
    /// TotalMissingUids / MissingAffectedMods / 缺依赖筛选），每次 Concat+ToList+HashSet
    /// 全表嵌套。依赖与已装 UID 集合都只在 Rescan→ReindexMods 里重建，故按 folder 缓存、
    /// 在 ReindexMods 统一失效即可与旧行为完全一致（安装/卸载/启禁/重扫全部经过该入口）。</summary>
    private readonly Dictionary<string, List<string>> _missingDepsCache
        = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>已装、但当前被禁用的依赖 —— MissingDeps 的另一半。缺依赖是"没装"，
    /// 这条是"装着但关了"，两种在 SMAPI 那边的结果一样（依赖方被 Skipped），
    /// 但在启动器这边的出路完全不同：一个要去装，一个只要拨开关。</summary>
    private List<string> DisabledDeps(ModEntry m)
    {
        if (_disabledUids.Count == 0) return new List<string>();
        var deps = m.Dependencies.Concat(m.ContentPackIds).ToList();
        if (deps.Count == 0) return new List<string>();
        var uids = InstalledUids;
        return deps.Where(d => !string.IsNullOrWhiteSpace(d)
                && uids.Contains(d) && _disabledUids.Contains(d))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>点「依赖被禁」标签 → 把那些被禁用的依赖启用。走正常启用路径
    /// （联动、缓存迁移、重扫、写回存档都在里面），不自己复制那套收尾。</summary>
    private void EnableItsDependencies(ModEntry m)
    {
        var deps = DisabledDeps(m);
        var done = 0;
        foreach (var uid in deps)
        {
            var depMod = _mods.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.UniqueID)
                && x.UniqueID.Equals(uid, StringComparison.OrdinalIgnoreCase));
            if (depMod is null) continue;   // 不单独成行的捆绑包子包没有条目可点
            SetDisabled(depMod, false);
            done++;
        }
        if (done == 0)
            ShowNotice("ok", Loc.F("{0} 依赖的 {1} 是捆绑包里不单独成行的子包 —— 启用它的整包就行",
                m.Name, string.Join("、", deps)));
    }

    private List<string> MissingDeps(ModEntry m)
    {        if (_missingDepsCache.TryGetValue(m.Folder, out var cached)) return cached;
        var deps = m.Dependencies.Concat(m.ContentPackIds).ToList();
        List<string> missing;
        if (deps.Count == 0)
        {
            missing = new List<string>();
        }
        else
        {
            var uids = InstalledUids;
            missing = deps
                .Where(d => !string.IsNullOrWhiteSpace(d) && !uids.Contains(d))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        _missingDepsCache[m.Folder] = missing;
        return missing;
    }

    /// <summary>装了、但版本低于 manifest 要求的依赖 —— MissingDeps 之外的第三条出路。
    /// SMAPI 对「没装」和「装得不够新」的处置完全一样（依赖方整条 Skipped），
    /// 启动器这边的说法不一样：一个要去装，一个要换成更新的版本，所以分开列、一起装。</summary>
    private List<StaleDepRow> StaleDeps(ModEntry m)
    {
        if (_staleDepsCache.TryGetValue(m.Folder, out var cached)) return cached;
        var list = new List<StaleDepRow>();
        if (m.DependencyMinVersions.Count > 0)
        {
            foreach (var d in m.Dependencies.Concat(m.ContentPackIds))
            {
                var dep = d?.Trim();
                if (string.IsNullOrWhiteSpace(dep)
                    || !m.DependencyMinVersions.TryGetValue(dep, out var need)
                    || !_installedVersions.TryGetValue(dep, out var have)
                    || !VersionUtil.IsOlderThan(have, need)) continue;
                if (list.Any(x => x.Uid.Equals(dep, StringComparison.OrdinalIgnoreCase))) continue;
                var e = _mods.FirstOrDefault(x => string.Equals(x.UniqueID.Trim(), dep, StringComparison.OrdinalIgnoreCase));
                list.Add(new StaleDepRow(dep, string.IsNullOrWhiteSpace(e?.Name) ? dep : e!.Name,
                    string.IsNullOrWhiteSpace(have) ? "?" : have.Trim(), need.Trim()));
            }
        }
        _staleDepsCache[m.Folder] = list;
        return list;
    }

    /// <summary>这一行需要动手的依赖 = 没装的 + 装得不够新的（一键安装那条通道两者同走）。</summary>
    private List<string> DepsToInstall(ModEntry m)
    {
        var all = new List<string>(MissingDeps(m));   // 拷贝：MissingDeps 返回的是缓存里那个列表本体
        foreach (var s in StaleDeps(m))
            if (!all.Contains(s.Uid, StringComparer.OrdinalIgnoreCase)) all.Add(s.Uid);
        return all;
    }

    // ------------------------------------------------------------------
    // v1.2.0：一键安装缺失依赖（横幅 + 行级入口）
    // ------------------------------------------------------------------
    private List<string>? _pendingDepUids;   // 确认弹窗数据源；空列表 = 全部缺失依赖
    private bool _depInstalling;
    private string? _depError;
    // v1.2.1：依赖的展示名与封面（免 key 搜索异步填充）。列表行和确认弹窗共用这一本账，
    // 所以它<b>不随弹窗开关而清空</b> —— 否则每次打开弹窗都要把整批 UID 重新搜一遍。
    private readonly Dictionary<string, InstallService.DependencyDisplayInfo> _depNames
        = new(StringComparer.OrdinalIgnoreCase);
    // 搜过的 UID（含搜不到的）。没有这本账，每次重扫都会对同一批失败项重发搜索。
    private readonly HashSet<string> _depNameTried = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>并行解析依赖的展示名与封面（免 key 搜索；失败保持 UID 显示并标"未找到"）。</summary>
    private async Task ResolveDepNamesAsync(List<string> uids)
    {
        // 本机已装的依赖（「版本过旧」那批）名字本地条目就有，发搜索请求纯属白费
        var todo = uids.Where(u => !_depNameTried.Contains(u) && !_installedVersions.ContainsKey(u))
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (todo.Count == 0) return;
        foreach (var u in todo) _depNameTried.Add(u);
        await Task.WhenAll(todo.Select(async u =>
        {
            var info = await Installer.ResolveDependencyDisplayAsync(u, ParentNexusIdsForDep(u));
            if (info is not null)
            {
                _depNames[u] = info;
                await InvokeAsync(StateHasChanged);
            }
        }));
    }

    /// <summary>这个依赖是被哪些已装 mod 声明为前置的 → 那些父包的 Nexus 页面号。
    /// 官网的 Requirements 表（作者手填、每行直接带 modId）挂在<b>父包</b>身上，
    /// 所以要先回答"谁要求它"，才能去问"它到底是哪个 mod"。父包没有 Nexus 页面号
    /// （manifest UpdateKeys 缺失/无效）时这里就是空列表，解析退回全站搜索。</summary>
    private List<int> ParentNexusIdsForDep(string uid)
    {
        var ids = new List<int>();
        foreach (var m in _mods)
        {
            if (m.NexusModId is not > 0 || ids.Contains(m.NexusModId.Value)) continue;
            if (m.Dependencies.Concat(m.ContentPackIds)
                    .Any(d => string.Equals(d?.Trim(), uid, StringComparison.OrdinalIgnoreCase)))
                ids.Add(m.NexusModId.Value);
        }
        return ids;
    }

    /// <summary>行内展示：有名字就用名字；搜过却没搜到就带着 UID 明说"未找到对应 mod"，
    /// 而不是甩一串玩家看不懂的字符；还在搜就先给 UID。
    /// 同包子模块单独一条 —— 它压根没有 N 网页面，报"未找到"会让人以为我们搜过了却没有。</summary>
    private string DepLabel(string uid)
    {
        // 本机装着、只是版本不够的前置：名字和两个版本号本地就有，不必去搜，也不该只报个名字
        // —— 玩家要的是「哪个版本算够」，否则下一条「可更新」他自己还得去对 manifest。
        if (_staleByUid.TryGetValue(uid, out var stale))
            return Loc.F("{0}（本机 {1}，需要 ≥{2}）", stale.Name, stale.Have, stale.Need);
        if (_depNames.TryGetValue(uid, out var di) && !string.IsNullOrWhiteSpace(di.Name)) return di.Name!;
        if (ModService.BundledParentOf(uid, InstalledUids) is string parentUid)
        {
            var pe = _mods.FirstOrDefault(m => string.Equals(m.UniqueID.Trim(), parentUid,
                StringComparison.OrdinalIgnoreCase));
            if (pe is not null)
                return Loc.F("{0}（随「{1}」一起装）", uid,
                    string.IsNullOrWhiteSpace(pe.Name) ? pe.Folder : pe.Name);
        }
        return _depNameTried.Contains(uid)
            ? Loc.F("{0}（未找到对应 mod）", uid)
            : uid;
    }

    /// <summary>全部要动手的依赖并集（横幅 + 确认弹窗 + 一键安装入口）：
    /// 没装的 + 装了但版本不够的。SMAPI 对这两种都是「依赖方直接 Skipped」，
    /// 出路也都是去下一个够新的版本，所以共用一条通道、共用一个计数。</summary>
    private List<string> TotalMissingUids
    {
        get
        {
            var set = new List<string>();
            foreach (var m in _mods)
                foreach (var d in DepsToInstall(m))
                    if (!set.Contains(d, StringComparer.OrdinalIgnoreCase)) set.Add(d);
            return set;
        }
    }

    private int MissingAffectedMods => _mods.Count(m => MissingDeps(m).Count > 0 || StaleDeps(m).Count > 0);

    /// <summary>uids 为 null = 全部缺失依赖；否则只装这一批（传给确认弹窗与安装管线）。</summary>
    private void AskInstallMissingDeps(List<string>? uids)
    {
        _depError = null;
        _pendingDepUids = uids ?? new List<string>();
        // v1.2.1：弹窗立即打开（先显示 UID），封面/mod 名后台异步解析、逐个补上
        _ = GuardedFireAndForget(ResolveDepNamesAsync(_pendingDepUids.Count > 0 ? _pendingDepUids : TotalMissingUids),
            "依赖名解析");
    }

    /// <summary>fire-and-forget 的异常收尸：没人 await 的 Task 抛异常时，异常对象直到 GC 才被
    /// finalizer 线程重抛 —— 运行期界面无感知，日志里只留下一条迟到的
    /// 「ERR [Task] unobserved」（2026-10-05 02:34 实测两条，都指回Mods 页的封面回填）。
    /// 这里就地兜住并记成一条能定位的警告：至少让人知道"这次网络抖了"，而不是幽灵异常。</summary>
    private static async Task GuardedFireAndForget(Task t, string what)
    {
        try { await t.ConfigureAwait(false); }
        catch (OperationCanceledException) { /* 页面已离开，正常 */ }
        catch (Exception ex) { AppLog.Warn("Mods", what + "失败: " + ex.Message); }
    }

    private void CancelInstallDeps() => _pendingDepUids = null;

    /// <summary>v1.2.3：确认弹窗点依赖行 → 应用内 mod 详情页（/mod/{nexusId}/{uid}）。
    /// 未解析到 Nexus modId 的行（搜索失败）不可点，直接忽略。</summary>
    private void OpenDepDetail(InstallService.DependencyDisplayInfo? di)
    {
        if (di?.ModId is not int id) return;
        _pendingDepUids = null;   // 离开当前页前收起弹窗，返回列表时不残留
        Nav.NavigateTo($"mod/{id}" + (string.IsNullOrWhiteSpace(di.Uid) ? "" : "/" + Uri.EscapeDataString(di.Uid)));
    }

    /// <summary>v1.5.1：列表行里点依赖名（名字已解析出 Nexus 页面）→ 同一个详情页。
    /// uid 一起带上：详情页靠它判「本机装着但版本过旧」这条出路。</summary>
    private void OpenDepByUid(string uid, int nexusId)
    {
        if (nexusId <= 0) return;
        Nav.NavigateTo($"mod/{nexusId}" + (string.IsNullOrWhiteSpace(uid) ? "" : "/" + Uri.EscapeDataString(uid)));
    }

    /// <summary>这条依赖在本机是否装着、装着的话它的 Nexus 页面号是多少（0 = 没装/没登记）。
    /// 「装了但版本过旧」那批走这条 —— 本地条目本来就带 NexusModId，不必再发搜索。</summary>
    private int InstalledDepNexusId(string uid)
    {
        var e = _mods.FirstOrDefault(m => string.Equals(m.UniqueID.Trim(), uid.Trim(),
            StringComparison.OrdinalIgnoreCase));
        return e?.NexusModId ?? 0;
    }

    private async Task ConfirmInstallDeps()
    {
        if (_depInstalling) return;
        var uids = _pendingDepUids;
        _pendingDepUids = null;
        _depInstalling = true;
        _depError = null;
        try
        {
            // 空列表 = 全部缺失依赖；服务端每轮重扫磁盘，无需在此快照。
            // v1.2.3：把弹窗已解析出的 UID → modId 一并传给安装管线（免二次搜索，
            // 安装时照常做 UniqueID 校验）。等待期间 Installer.OnChanged 推动列表实时重扫。
            var pre = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (var kv in _depNames)
                if (kv.Value.ModId is int mid) pre[kv.Key] = mid;
            var err = await Installer.InstallMissingDependenciesAsync(
                uids is { Count: > 0 } ? uids : null, pre);
            if (err is not null && err != "已取消") _depError = err;
        }
        finally
        {
            _depInstalling = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>是否「有可用更新」：N 网 MAIN 文件版本/ fileId 口径（见 NexusUpdateTruth）。</summary>
    private bool IsUpdatable(ModEntry m)
    {
        if (m.IsConvertedPack) return false;
        var st = GetState(m.Folder);
        return NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, st.RemoteVersion, st.RemoteFileId);
    }

    /// <summary>按最外层文件夹分组（根目录直接受让的 mod 为 "" 组），再排成界面上的行序。</summary>
    private IReadOnlyList<ModGroup> Groups
    {
        get
        {
            var installed = InstalledUids;
            var units = OrderRows(FilteredMods, _sortMode);
            foreach (var u in units)
                u.Missing = u.Items
                    .Where(x => x.Dependencies is { Count: > 0 } || x.ContentPackIds is { Count: > 0 })
                    .SelectMany(x => x.Dependencies.Concat(x.ContentPackIds))
                    .Where(d => !string.IsNullOrWhiteSpace(d) && !installed.Contains(d))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
            return units;
        }
    }

    private static string GroupKeyOf(ModEntry m)
    {
        // Folder 形如 "SVE/[CP] xx" 或 "xx"：取第一个段作为分组。
        var idx = m.Folder.IndexOf('/');
        return idx > 0 ? m.Folder[..idx] : "";
    }

    /// <summary>界面上的一行：捆绑包 = 一行（Items 是它的子包），根目录散装 mod = 各自一行。
    /// 散装与捆绑包必须放进<b>同一个</b>序列排序 —— 旧写法先按"是不是捆绑包"分组再排，
    /// 结果所有捆绑包永远堆在列表末尾，刚下载的包看着像没下完。</summary>
    public sealed class ModGroup
    {
        public string Key = "";
        public List<ModEntry> Items = new();

        /// <summary>该分组内所有缺失依赖（不在已装集合中）的并集，去重。</summary>
        public List<string> Missing { get; set; } = new();

        /// <summary>行序用的名字：捆绑包是顶层目录名，散装 mod 是它自己的名字。</summary>
        public string SortName => Key.Length > 0 ? Key : Items[0].Name;
    }

    /// <summary>把扫描结果排成行序：组内按所选模式排，组间也按同一模式排（捆绑包不再沉底）。
    /// 档位名与界面标签是反着读的：<c>time-asc</c> = 「最新在前」，<c>time-desc</c> = 「最早在前」。</summary>
    public static List<ModGroup> OrderRows(IReadOnlyList<ModEntry> mods, string sortMode)
    {
        var units = new List<ModGroup>();
        foreach (var g in mods.GroupBy(GroupKeyOf))
        {
            var items = sortMode switch
            {
                "time-desc" => g.OrderBy(x => x.LastWrite).ToList(),
                "time-asc"  => g.OrderByDescending(x => x.LastWrite).ToList(),
                _           => g.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList(),
            };
            // 只有一个子包的"捆绑包"不是捆绑包：直接把那个子包端成普通一行 —— 不套父行、不给箭头、
            // 不加缩进（包壳里就一个 mod，展开/收起这一步是多此一举）。
            if (g.Key.Length > 0 && items.Count > 1) { units.Add(new ModGroup { Key = g.Key, Items = items }); continue; }
            // 根目录那一批拆开，才能和捆绑包混进同一次排序
            foreach (var m in items) units.Add(new ModGroup { Key = "", Items = new List<ModEntry> { m } });
        }
        // 捆绑包按它<b>最近</b>的那个子包争位置（最早在前则按它最旧的那个）——
        // 刚下载的一整包因此就排在刚下载的单包旁边，不再一律沉到列表末尾。
        return sortMode switch
        {
            "time-desc" => units.OrderBy(x => x.Items.Min(m => m.LastWrite)).ToList(),
            "time-asc"  => units.OrderByDescending(x => x.Items.Max(m => m.LastWrite)).ToList(),
            _           => units.OrderBy(x => x.SortName, StringComparer.OrdinalIgnoreCase).ToList(),
        };
    }

    private readonly Dictionary<string, ModUpdateState> _states = new();
    private static readonly Dictionary<string, RemoteVersionCache> _remoteVersionCache =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selected = new();

    private sealed class RemoteVersionCache(string version, DateTime at, string? url = null)
    {
        public string Version { get; } = version;
        public DateTime At { get; } = at;
        public string? Url { get; } = url;
    }

    private sealed class ModUpdateState
    {
        public string Status = "idle";   // idle/checking/latest/available/updating/updated/premium/failed
        public string? RemoteVersion;
        /// <summary>N 网最新 MAIN 文件的 FileId（与安装源同一口径；无则只能按版本字符串比）。</summary>
        public long? RemoteFileId;
        /// <summary>smapi.io 索引随建议版本一起给出的来源页。徽标上的版本号可能不在 N 网
        /// （非官方续作/换平台），这时跳转必须用它，否则跳过去的页面最新就是已装的那版。</summary>
        public string? RemoteUrl;
        public string? Message;
        public string? PictureUrl;       // N 网封面（检查更新时顺手拿到的）
        public int? CategoryId;          // v0.46.0：官网分类 ID（GetModAsync 顺手拿到）
    }

    private string SmapiDisplay =>
        _smapiVersion is null ? "未安装"
        : _smapiVersion == "installed" ? "已安装"
        : _smapiVersion;

    private ModUpdateState GetState(string folder) =>
        _states.TryGetValue(folder, out var s) ? s : new ModUpdateState();

    private void ApplyKnownRemoteVersions()
    {
        foreach (var m in _mods)
        {
            if (m.IsConvertedPack)
            {
                _states[m.Folder] = new ModUpdateState { Status = "latest" };
                continue;
            }
            if (!_remoteVersionCache.TryGetValue(m.Folder, out var entry)) continue;
            if (DateTime.UtcNow - entry.At > UpdateCheckTtl) continue;
            // 已装上该 N 网文件版本 → 恢复缓存时也不亮 ⇧
            var show = NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, entry.Version, null);
            _states[m.Folder] = new ModUpdateState
            {
                Status = show ? "available" : "latest",
                RemoteVersion = entry.Version,
                RemoteUrl = entry.Url,
            };
        }
    }

    // v0.44.0：更新检查结果缓存（folder -> 上次检查成功的 UTC 时间），
    // 60 分钟内重复点"检查更新"时跳过已查过的 mod，几百个 mod 也只发新/过期请求
    private static readonly Dictionary<string, DateTime> _lastCheckedUtc = new();
    private static readonly TimeSpan UpdateCheckTtl = TimeSpan.FromMinutes(60);

    // vNext：指纹缓存有效期 —— updatedAt 没变理论上就永远有效，这里仍设 7 天兜底，
    // 防止「文件列表变了但 updatedAt 没动」的极端情况（如作者删掉最新文件）长期滞留
    private static readonly TimeSpan FingerprintMaxAge = TimeSpan.FromDays(7);
    /// <summary>vNext：指纹缓存（Cfg.ModUpdateFingerprints）本轮有写入，需要落盘。</summary>
    private bool _fpDirty;

    private static void RememberRemoteVersion(string folder, string? version, string? url = null)
    {
        if (string.IsNullOrWhiteSpace(version)) return;
        _remoteVersionCache[folder] = new RemoteVersionCache(version, DateTime.UtcNow, url);
    }


    private string? GetCover(ModEntry m)
    {
        var st = GetState(m.Folder);
        if (st.PictureUrl is not null) return st.PictureUrl;
        if (Cfg.Current.ModCovers.TryGetValue(m.Folder, out var url)) return url;
        // v0.43.0：禁用后 folder 变为 ".X/..."，封面缓存仍停留在启用时的 "X/..." key，
        // 用规范化 key（去掉顶层 . 前缀）兜底，禁用/启用两种状态都能看到封面
        var norm = NormCoverKey(m.Folder);
        return norm != m.Folder && Cfg.Current.ModCovers.TryGetValue(norm, out var url2) ? url2 : null;
    }

    private static string NormCoverKey(string folder)
    {
        var parts = folder.Split('/');
        parts[0] = parts[0].TrimStart('.');
        return string.Join('/', parts);
    }

    // vNext：跨页静态快照 —— 离开 /mods 时把扫描结果留住；从其它页回来先用快照
    // 秒显列表（零磁盘 IO、零等待），后台再重扫磁盘刷新。组件销毁后仍存活。
    private static IReadOnlyList<ModEntry>? _svMods;
    // v1.2.6：工具条视图快照。原先只快照列表数据和滚动位置，筛选/排序/搜索没跟上 ——
    // 在「已启用」下进详情页返回后视图被打回「全部」，而滚动位置仍按已启用那批行恢复，
    // 两者对不上。四项必须同进退，所以一起存。
    private static string? _svFilter;
    private static string? _svSort;
    private static string? _svSearch;
    private static bool _svSearchOpen;
    // vNext：SMAPI 版本/图标探测结果跨页缓存（图标是 exe 抽取 + base64，每次进页都做太浪费）
    private static string? _svSmapiPath;
    private static string? _svSmapiVersionCache;
    private static string? _svSmapiIconCache;

    protected override void OnInitialized()
    {
        // v1.2.6：视图快照在 OnInitialized 恢复（比 OnInitializedAsync 更早，且同步）——
        // 放到后面会让首屏先亮一帧「全部」再翻成「已启用」。
        if (_svFilter is not null) _filter = _svFilter;
        if (_svSort is not null) _sortMode = _svSort;
        SearchText = _svSearch ?? "";
        _searchOpen = _svSearchOpen;
        // v1.08：从任务中心恢复 SMAPI 任务状态 —— 页面离开再回来组件会重建，
        // _smapiUpdating 归零会导致按钮重新可点、重复创建下载任务。
        _smapiUpdating = Center.Items.Any(t =>
            t.Status == "running" && t.Title.StartsWith("SMAPI", StringComparison.OrdinalIgnoreCase));
        var gp = Cfg.Current.GamePath;
        // v1.4.6：exe 版本 + SMAPI freshRead/抽图标都是重 IO，丢后台 ——
        // 同步跑会让每次进 Mod 管理都顿一下
        _ = Task.Run(() =>
        {
            var gv = Updater.GetGameVersion(gp);
            var smapiCacheKey = gp + "|" + gv;
            string? sv, icon;
            if (_svSmapiPath == smapiCacheKey && _svSmapiVersionCache is not null)
            {
                sv = _svSmapiVersionCache;
                icon = _svSmapiIconCache;
            }
            else
            {
                sv = Game.ProbeSmapiVersion(gp, freshRead: true);
                icon = Game.GetSmapiIconDataUri(gp);
                _svSmapiPath = smapiCacheKey;
                _svSmapiVersionCache = sv;
                _svSmapiIconCache = icon;
            }
            if (UpdateService.IsSmapiUnsupported(gv)) { sv = null; _svSmapiVersionCache = null; }
            return InvokeAsync(() =>
            {
                _gameVer = gv;
                _smapiVersion = sv;
                _smapiIcon = icon;
                StateHasChanged();
            });
        });
        Installer.OnChanged += OnInstallerChanged;
        // v1.06.7：顶栏点「当前页」Mod 管理图标 → 重新扫描 + 重新检查更新
        PageRefresh.OnRefresh += OnPageRefresh;
    }

    /// <summary>顶栏刷新信号（只有已停留在本页时才会触发）。
    /// 重新扫描 + 强制全量重查更新（无视 60 分钟 TTL）。</summary>
    private void OnPageRefresh(string key)
    {
        if (key != "mods" || _disposed) return;
        _ = InvokeAsync(async () =>
        {
            _initialLoading = true;
            StateHasChanged();
            // v1.1.6：手动刷新也要做多副本清理（preScanned 路径会跳过 Rescan 里的清理）
            var scanned = await Task.Run(() =>
            {
                try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
                catch (Exception ex) { AppLog.Warn("Mods", "多副本清理失败: " + ex.Message); }
                return ModSvc.Scan(Cfg.Current.GamePath);
            });
            if (_disposed) return;
            Rescan(scanned);
            _initialLoading = false;
            await CheckUpdates(force: true);
            // v1.08：刷新同时重新探测 SMAPI（安装/升级后 exe 已变，静态缓存是旧版本）
            // 并强制重查远端新版 —— 此前刷新永远拿 5 分钟缓存，看不到刚装好的新状态。
            // v1.3.4：freshRead —— 绕开 Windows 版本资源缓存（覆盖安装后立即读拿旧值）。
            _smapiVersion = Game.ProbeSmapiVersion(Cfg.Current.GamePath, freshRead: true);
            _svSmapiPath = Cfg.Current.GamePath;
            _svSmapiVersionCache = _smapiVersion;
            _smapiIcon = Game.GetSmapiIconDataUri(Cfg.Current.GamePath);
            // v1.1.8：旧版游戏必须查对应 tag，不能刷成 latest 4.x
            _smapiUpdate = SmapNeedsOld
                ? await Updater.CheckSmapiForGameAsync(_smapiVersion, _gameVer, force: true)
                : await Updater.CheckSmapiAsync(_smapiVersion, force: true);
            StateHasChanged();
            // vNext：手动刷新 = 从头看起 —— 归顶并把 0 写进滚动存档，
            // 否则刷新后不滚动就离开，下次回来会恢复到刷新前的旧位置
            try { await JS.InvokeVoidAsync("junigridJs.setScroll", ".jg-main", 0); } catch { }
            try { await JS.InvokeVoidAsync("junigridJs.saveScrollKey", "modslist", 0, false); } catch { }
        });
    }

    // v0.72.8：释放 FileSystemWatcher —— 旧版只解绑 Installer，watcher 从不销毁。
    // 每次离开 /mods 再回来就叠一个新 watcher，N 次往返 = N 个 watcher 同时监听 Mods/，
    // 批量改名 63 次触发 63×N 个 Rescan 回调 → UI 卡死（"进详情再回来才卡"的根因）。
    private bool _disposed;

    /// <summary>离开本页时叫停在飞的 N 网扇出（更新检查 / 精查 / 封面与分类回填）。
    /// AUP 二审盯着的就是这个：旧写法 Dispose 只解绑事件，那几路扇出会一路打完才停，
    /// 表现成「人已经不在 Mods 页了，客户端还在连着发请求」，同时占着 NexusService 的 2 个槽，
    /// 让下一个页面的请求排在后面（用户在别处看到的「进页卡一下」）。
    /// 只叫停<b>只读</b>的检测与回填；「自动更新」那条流水线（RunUpdatePipeline）会真下载装机，
    /// 离开页面不能把它掐在半截，所以那边不接这个令牌。
    /// 只 Cancel 不 Dispose —— 组件释放后仍可能有旧续体读 Token，别留 ObjectDisposedException 的口子。</summary>
    private readonly CancellationTokenSource LeaveCts = new();
    private CancellationToken Leave => LeaveCts.Token;

    public void Dispose()
    {
        _disposed = true;
        try { LeaveCts.Cancel(); } catch { }
        Installer.OnChanged -= OnInstallerChanged;
        PageRefresh.OnRefresh -= OnPageRefresh;
        // vNext：留下扫描快照 —— 从其它页回来时先用它秒显列表，后台再重扫磁盘
        _svMods = _mods;
        _svFilter = _filter;
        _svSort = _sortMode;
        _svSearch = SearchText;
        _svSearchOpen = _searchOpen;
        if (_modsWatcherSlot is not null)
            DepotDownloaderService.UnregisterModWatcher(_modsWatcherSlot);
        _modsWatcherSlot = null;
        ReleaseModsWatcher();
    }

    private void OnInstallerChanged() =>
        InvokeAsync(RescanAndRestate);   // v1.1.6：清理+扫描移到后台线程

    private FileSystemWatcher? _modsWatcher;
    private int _pendingRescan;   // v0.72.8：watcher 事件合并闸门
    /// <summary>向版本切换登记的句柄持有者身份。切换期间由 DepotDownloaderService 回调
    /// Release/Reacquire —— 它拿不到也不该拿我们的字段，只通过这三个委托动它。</summary>
    private DepotDownloaderService.ModWatcherSlot? _modsWatcherSlot;

    /// <summary>真正放掉 Mods 目录句柄。⚠ 只设 EnableRaisingEvents=false 不算放：
    /// 句柄还开着，切换时整棵改名照样 ACCESS_DENIED（2026-09-23 真机连续三次切换全败）。</summary>
    private void ReleaseModsWatcher()
    {
        var w = _modsWatcher;
        _modsWatcher = null;
        if (w is null) return;
        try { w.EnableRaisingEvents = false; } catch { }
        try { w.Dispose(); } catch { }
    }

    /// <summary>建（或重建）Mods 监听。进页时建一次；版本切换结束后由切换那边回调再建一次。
    /// 幂等：已经有活的就不重复建 —— 旧版每离开/回到 /mods 就叠一个 watcher，
    /// 批量改名 63 次触发 63×N 个 Rescan 回调，UI 直接卡死。</summary>
    private void EnsureModsWatcher()
    {
        if (_disposed || _modsWatcher is not null) return;
        try
        {
            var modsDir = System.IO.Path.Combine(Cfg.Current.GamePath, "Mods");
            if (!Directory.Exists(modsDir)) return;

            var watcher = new FileSystemWatcher(modsDir)
            {
                IncludeSubdirectories = false,
                NotifyFilter = NotifyFilters.DirectoryName | NotifyFilters.FileName | NotifyFilters.LastWrite
            };
            // v0.72.8：disposed 守卫 + 事件合并 —— 组件销毁后已排队的回调不再回灌；
            // 短时间内多个文件事件合并为一次 RescanAndRestate（_pendingRescan 防抖）。
            FileSystemEventHandler onChange = (_, _) => QueueRescan();
            watcher.Created += onChange;
            watcher.Deleted += onChange;
            watcher.Renamed += (_, _) => QueueRescan();

            _modsWatcher = watcher;
            // ⚠ 两个回调都是**同步**直调，不走 InvokeAsync：释放必须发生在切换动手搬 Mods 之前，
            // 排到渲染器队列上就等于句柄还没放、改名照样 ACCESS_DENIED，闸门形同虚设。
            // FileSystemWatcher 的建与 Dispose 都不碰渲染树（不调 StateHasChanged），
            // 所以在切换那条后台线程上直接跑是安全的。
            _modsWatcherSlot ??= new DepotDownloaderService.ModWatcherSlot
            {
                Release = ReleaseModsWatcher,
                Reacquire = EnsureModsWatcher,
                IsLive = () => _modsWatcher is not null,
            };
            DepotDownloaderService.RegisterModWatcher(_modsWatcherSlot);
            watcher.EnableRaisingEvents = true;
        }
        catch { /* watcher 建不起来就算了，用户可点手动刷新 */ }
    }

    private void QueueRescan()
    {
        if (_disposed) return;
        if (Interlocked.Exchange(ref _pendingRescan, 1) == 1) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(120);   // 合并窗口：120ms 内的连续事件只触发一次
                if (_disposed) return;
                RescanAndRestate();
            }
            finally { Interlocked.Exchange(ref _pendingRescan, 0); }
        });
    }

    protected override async Task OnInitializedAsync()
    {
        // vNext：进页两条路 —— ①有跨页快照（从其它页回来）：直接用快照秒显列表，
        // 磁盘重扫丢到后台，扫完无感替换；②冷启动无快照：shimmer 骨架 + 后台线程扫描。
        if (_svMods is { Count: > 0 } snap)
        {
            _mods = snap;
            ReindexMods();
            _initialLoading = false;
            StateHasChanged();
            _ = InvokeAsync(async () =>
            {
                try
                {
                    // v1.1.6：preScanned 路径跳过 Rescan 内的清理 → 这里补做
                    var scanned = await Task.Run(() =>
                    {
                        try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
                        catch (Exception ex) { AppLog.Warn("Mods", "多副本清理失败: " + ex.Message); }
                        return ModSvc.Scan(Cfg.Current.GamePath);
                    });
                    if (_disposed) return;
                    // v1.2.4：磁盘没人动（快照与重扫一致）→ 跳过 Rescan 整表替换，
                    // 省掉返回列表后的第二次全列表 diff 渲染；有变化才走原路。
                    if (SameScan(scanned, _mods)) return;
                    Rescan(scanned);
                    StateHasChanged();
                }
                catch { }
            });
        }
        else
        {
            // v0.59.0：首屏先亮 shimmer 骨架，Rescan 完再切成真实列表
            _initialLoading = true;
            StateHasChanged();
            await Task.Yield();  // 让骨架先渲染一帧
            // vNext：磁盘扫描移出 UI 线程 —— 几百个 mod 的 manifest 解析不再卡住渲染
            // v1.1.6：preScanned 路径跳过 Rescan 内的清理 → 这里补做
            var scanned = await Task.Run(() =>
            {
                try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
                catch (Exception ex) { AppLog.Warn("Mods", "多副本清理失败: " + ex.Message); }
                return ModSvc.Scan(Cfg.Current.GamePath);
            });
            if (_disposed) return;
            Rescan(scanned);
            _initialLoading = false;
        }
        // v1.06.7：必须在 Rescan 之后恢复远端版本标记 —— _mods 就绪后按 folder 回填
        // 「⇑ 可更新」状态（快照路径同样要跑：新实例的 _states 是空的）。
        ApplyKnownRemoteVersions();
        StateHasChanged();
        // v1.2.6：「维护存疑」原先只在跑过一轮更新检查后才有数据，第一次进页整列徽标和筛选
        // 计数都是空的，看着像这功能没生效。首屏就单独预查一次 —— 免 Key、一次批量请求、
        // 10 分钟会话缓存，不碰 Nexus 精查那条链路。
        _ = KickoffCompatPrecheck();
        if (ActiveProfileName != "默认"
            && AllProfiles.Any(p => p.Name == ActiveProfileName))
        {
            _ = InvokeAsync(async () =>
            {
                // 延迟一帧让首屏渲染完，再应用存档
                await Task.Delay(300);
                await ApplyProfile(ActiveProfileName);
            });
        }

        // SMAPI 检查和 mod 更新检测互不依赖，一起跑；不要让 SMAPI 网络请求
        // 卡住整页，mod 行一进入页面就开始检查远端版本。
        var smapiTask = SmapNeedsOld
            ? Updater.CheckSmapiForGameAsync(_smapiVersion, _gameVer)
            : Updater.CheckSmapiAsync(_smapiVersion);
        // v0.68.3：进入 Mod 页时完全由「设置」页「自动安装更新」开关（EnableAutoInstall）判定，不再弹窗询问。
        _ = InvokeAsync(async () => { await AutoUpdateOnEnterAsync(); await InvokeAsync(StateHasChanged); });
        // v1.2.1：封面缓存被清空时进页即补（免 key GraphQL），不等用户点「检查更新」
        _ = InvokeAsync(async () =>
        {
            try
            {
                var missing = _mods.Any(m => m.NexusModId is not null
                    && string.IsNullOrEmpty(GetState(m.Folder).PictureUrl)
                    && !Cfg.Current.ModCovers.ContainsKey(m.Folder)
                    && !Cfg.Current.ModCovers.ContainsKey(NormCoverKey(m.Folder)));
                if (missing) await BackfillCoversAsync();
            }
            catch { }
        });

        // Q4: 监听 Mods 文件夹变化，用户直接扔进去的 mod 也能立刻出现。
        // 建/放/重建的完整生命周期在 EnsureModsWatcher / ReleaseModsWatcher —— 版本切换期间
        // 会由 DepotDownloaderService 回调把它们放掉再重建（详见 _modsWatcherSlot）。
        EnsureModsWatcher();

        _smapiUpdate = await smapiTask;
        if (_smapiUpdate is not null) StateHasChanged();
    }

    private void RescanAndRestate()
    {
        // v1.1.6：watcher / 安装完成回调等高频入口改走后台版重扫 ——
        // 多副本清理 + 全盘扫描都不再占 UI 线程（旧版在 UI 线程连扫 1-2 遍全盘）。
        _ = RescanInBackground();
    }

    private bool _bgRescanRunning;
    private bool _bgRescanQueued;

    /// <summary>v1.1.6：后台版重扫 —— CleanupDuplicateCopies（含全盘枚举+目录搬移）与
    /// Scan 都放 Task.Run，回 UI 线程只套用结果。扫描期间再来的事件合并为一轮补扫，
    /// 最后一个事件不丢。调用方必须已在 UI 线程（三处入口均为 InvokeAsync 回调）。</summary>
    private async Task RescanInBackground()
    {
        // 切换版本期间绝不重扫：CleanupDuplicateCopies 自己就会搬目录，和切换并跑等于两条线程
        // 同时动 Mods（实测改名重试全失败，报的就是 Mods 里 .junigrid_trash 被占用）。
        // 切换结束时本来就会刷一次本页，这里丢掉请求不丢数据。
        if (DepotDownloaderService.IsApplyInProgress) return;
        if (_bgRescanRunning) { _bgRescanQueued = true; return; }
        _bgRescanRunning = true;
        try
        {
            while (true)
            {
                _bgRescanQueued = false;
                // v1.1.8：这一轮在后台线程跑，不冻窗口，但它也要记账 —— 点完开关之后
                // 那段"还在转"的时间全在这里头（磁盘忙完才 StateHasChanged）。
                var __t = System.Diagnostics.Stopwatch.GetTimestamp();
                double __cleanup = 0, __rehome = 0;
                var scanned = await Task.Run(() =>
                {
                    try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
                    catch (Exception ex) { AppLog.Warn("Mods", "多副本清理失败: " + ex.Message); }
                    __cleanup = ElapsedMs(__t);
                    // 孤儿区自动归位：判得出唯一归属才搬，判不出的一律留在收件箱；全程只移动不删除
                    try { DepotQr.RehomeOrphanMods(Cfg.Current.GamePath); }
                    catch (Exception ex) { AppLog.Warn("Mods", "孤儿 Mods 归位失败: " + ex.Message); }
                    __rehome = ElapsedMs(__t);
                    return ModSvc.Scan(Cfg.Current.GamePath);
                });
                ModsPerf($"后台重扫一轮",
                    ("判重清理", __cleanup), ("孤儿归位", __rehome - __cleanup),
                    ("磁盘扫描", ElapsedMs(__t) - __rehome));
                if (_disposed || DepotDownloaderService.IsApplyInProgress) return;
                Rescan(scanned);
                StateHasChanged();
                if (!_bgRescanQueued) return;
            }
        }
        finally { _bgRescanRunning = false; }
    }

    /// <summary>vNext：preScanned 允许调用方先在后台线程扫盘、再回到 UI 线程套用结果
    /// （扫描本身不碰 UI 状态，选中集合清理在 UI 线程做，避免与渲染并发）。
    /// preScanned 为 null 时才在当前线程清理+扫描 —— RescanInBackground 传入的结果
    /// 已包含清理，跳过避免 UI 线程重复全盘扫两遍。</summary>
    private void Rescan(IReadOnlyList<ModEntry>? preScanned = null)
    {
        // v1.1.4：同 UniqueID 多副本物理清理 —— SMAPI 直接读磁盘，UI 隐藏不够
        //（多余副本会让整包 Skipped）。基于原始扫描结果，先清理再正式扫描。
        var __t = System.Diagnostics.Stopwatch.GetTimestamp();
        double __cleanupMs = 0, __scanMs = 0;
        if (preScanned is null)
        {
            try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
            catch (Exception __ex) { AppLog.Warn("Mods", "多副本清理失败: " + __ex.Message); }
            __cleanupMs = ElapsedMs(__t);
            var __t2 = System.Diagnostics.Stopwatch.GetTimestamp();
            _mods = ModSvc.Scan(Cfg.Current.GamePath);
            __scanMs = ElapsedMs(__t2);
        }
        else
        {
            _mods = preScanned;
        }
        ReindexMods();
        ModsPerf($"重扫 {preScanned?.Count ?? _mods.Count} 项",
            ("判重清理", __cleanupMs), ("磁盘扫描", __scanMs), ("建索引", ElapsedMs(__t) - __cleanupMs - __scanMs));
        // v1.1.2：备注对账 —— mod 更新会重置 manifest Name，这里补写备注（游戏未运行时）
        if (Cfg.Current.ModRemarks.Count > 0)
            _ = Task.Run(() => ModSvc.SyncAllRemarks(Cfg.Current.GamePath, Cfg));
        // 清掉已经不在列表里的选中项（v1.1.6：走索引字典，不再每个选中项全表扫）
        _selected.RemoveWhere(f => !_modsByFolder.ContainsKey(f));
        // v0.72.7：Rescan 只负责扫描 —— 不再偷偷启动 BackfillCoversAsync。
        // 旧版每次 Rescan 都叠加一个网络回填任务（初始化/批量/watcher 回调任意触发），
        // 是"偶发卡死"的核心放大器。封面回填改由显式入口按需启动（带并发闸门）。
    }

    private void ReindexMods()
    {
        _rowsLoaded = true;
        _modsByFolder = new Dictionary<string, ModEntry>(_mods.Count, StringComparer.OrdinalIgnoreCase);
        foreach (var m in _mods) _modsByFolder[m.Folder] = m;
        // v1.2.3：已装 UID 集合随重扫一并重建 —— MissingDeps/筛选计数/分组在渲染期被高频
        // 调用，旧写法每次访问 InstalledUids 都全表重建 HashSet（每页渲染 O(N²) 次分配）。
        _installedUids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _disabledUids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _installedVersions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in _mods)
            if (!string.IsNullOrWhiteSpace(m.UniqueID))
            {
                _installedUids.Add(m.UniqueID.Trim());
                _installedVersions[m.UniqueID.Trim()] = m.Version ?? "";
                if (m.Disabled) _disabledUids.Add(m.UniqueID.Trim());
            }
        // 捆绑包里不单独成行的子包：SMAPI 照样加载，所以依赖它不算缺（Enabled 那份进已装集合）；
        // 顶层被禁用时子包一起算禁用 —— 它们是「依赖被禁用」，不是「缺依赖」。
        // 子包没有条目也就没有版本号，版本判据对它们一律不指控（见 VersionUtil.IsOlderThan）。
        var hidden = ModSvc.HiddenChildUids;
        _installedUids.UnionWith(hidden.Enabled);
        _installedUids.UnionWith(hidden.Disabled);
        _disabledUids.UnionWith(hidden.Disabled);
        // v1.2.5：缺失依赖缓存随重扫一并失效（依赖列表与 UID 集合都只在重扫时变化）
        _missingDepsCache.Clear();
        _staleDepsCache.Clear();
        // 覆盖型包（汉化补丁）的健康度随重扫刷新。绝大多数人一条都没有 → 先短路，
        // 别为了空表去哈希文件。
        _overlayHealth = Cfg.Current.Overlays.Count > 0
            ? ModService.OverlayHealth(Cfg.Current.GamePath, Cfg.Current)
            : new ModService.OverlayReport(new(), new());
        // 过旧依赖按 UID 汇总一份：行内标签和确认弹窗都要说清「本机多少、要多少」，
        // 而「要多少」记在提要求的那个 mod 身上，渲染期不该为了一行文字再反查全表。
        _staleByUid = new Dictionary<string, StaleDepRow>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in _mods)
            foreach (var s in StaleDeps(m))
                _staleByUid[s.Uid] = s;
        // 缺失依赖的展示名后台解析，列表行才显示得出"是哪个 mod"而不是裸 UID。
        // 只在出现没搜过的 UID 时才真发请求（见 _depNameTried），重扫不会反复打网络。
        var missingAll = TotalMissingUids;
        if (missingAll.Count > 0) _ = GuardedFireAndForget(ResolveDepNamesAsync(missingAll), "依赖名解析");
    }

    /// <summary>v1.2.4：返回列表的快照与重扫结果是否一致（文件夹/启禁/版本/N网ID）。
    /// 一致 = 磁盘没人动过，整表替换后的二次全列表渲染纯属浪费（几百行的 diff
    /// 在低端 WebView2 上就是"返回列表停顿一下"的主力之一），直接跳过。
    /// 顺序不同按不一致处理 → 退回旧行为，宁可多渲染一次也不会漏掉真实变化。</summary>
    private static bool SameScan(IReadOnlyList<ModEntry> a, IReadOnlyList<ModEntry> b)
    {
        if (a.Count != b.Count) return false;
        for (var i = 0; i < a.Count; i++)
        {
            var x = a[i]; var y = b[i];
            if (!string.Equals(x.Folder, y.Folder, StringComparison.OrdinalIgnoreCase)) return false;
            if (x.Disabled != y.Disabled) return false;
            if (!string.Equals(x.Version, y.Version, StringComparison.Ordinal)) return false;
            if (x.NexusModId != y.NexusModId) return false;
        }
        return true;
    }

    /// <summary>已装 UniqueID 集合（ReindexMods 时重建的缓存，勿在渲染期重算）。</summary>
    private HashSet<string> _installedUids = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>已装但被禁用（含随顶层一起禁掉的捆绑包子包）的 UniqueID。
    /// 「装了」与「能加载」是两件事：SMAPI 对禁用依赖照样把依赖方 Skipped，
    /// 而缺依赖判定看不出来 —— 这一集专门用来给那种行打「依赖被禁用」标签。</summary>
    private HashSet<string> _disabledUids = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>已装 UniqueID → manifest 里的 Version（ReindexMods 时重建）。
    /// 「装了」与「装得够新」是第三件事：SMAPI 对版本不足的依赖照样 Skipped 依赖方，
    /// 只看 UID 在不在的判据对这条完全静音（实测 完美手册 因 StardewUI 版本过旧被跳过）。</summary>
    private Dictionary<string, string> _installedVersions = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<StaleDepRow>> _staleDepsCache = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>UID → 过旧详情（ReindexMods 汇总）。给 DepLabel 和确认弹窗用。</summary>
    private Dictionary<string, StaleDepRow> _staleByUid = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>一条「装了但版本低于要求」的依赖，带上门禁和实际到场的版本号。</summary>
    private sealed record StaleDepRow(string Uid, string Name, string Have, string Need);

    // ------------------------------------------------------------------
    // 行交互：左键多选 / hover 按钮
    // ------------------------------------------------------------------
    // ─── v1.5：行尾 … 菜单（单开互斥；纯 class 驱动，无需 JS）───
    // 关闭直接摘 open，无关闭动画：曾用 closing+200ms 做收起，.up 菜单在摘 open
    // 时会弹回按钮下方再淡出（「关闭动画闪到下面」）。硬关即可。
    private string? _menuFolder;
    private bool _menuFitPending;

    private void ToggleMenu(string folder)
    {
        if (_menuFolder == folder)
        {
            CloseMenu();
            return;
        }
        _menuFolder = folder;
        // 翻转判定要量的是「这一行有几个条目」的菜单最终矩形，而 StateHasChanged 只是排队渲染：
        // 在这里直接调 JS，浏览器收到的顺序是 JS 先、渲染批次后 ⇒ 量到的是没 .open 的旧 DOM，
        // up 永远加不上（实测最后一行菜单整块掉到视口外）。改挂到 OnAfterRenderAsync 里，DOM 一定已就位。
        _menuFitPending = true;
        StateHasChanged();
    }

    private void CloseMenu()
    {
        if (_menuFolder is null) return;
        _menuFolder = null;
        StateHasChanged();
    }

    private void MenuAct(Action act)
    {
        // 硬关菜单并立刻执行动作（弹窗/跳转），不阻塞用户点击
        _menuFolder = null;
        act();
        StateHasChanged();
    }

    private void ToggleSelect(string folder)
    {
        if (!_selected.Remove(folder)) _selected.Add(folder);
        _pendingBatchDelete = false;
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _pendingBatchDelete = false;
    }

    // v0.41.0：全选当前过滤结果（只选看得见的，避免误选被过滤掉的）
    private void SelectAll()
    {
        foreach (var m in FilteredMods) _selected.Add(m.Folder);
        _pendingBatchDelete = false;
    }

    // ── 删除确认弹窗：取消 / 确定（单个走 Uninstall，批量走 BatchDelete）──
    private void CancelDeleteMods()
    {
        _pendingDeleteMod = null;
        _pendingBatchDelete = false;
    }

    private void ConfirmDeleteMods()
    {
        var mod = _pendingDeleteMod;
        var batch = _pendingBatchDelete;
        var toTrash = _deleteToTrash;
        _pendingDeleteMod = null;
        _pendingBatchDelete = false;
        if (mod is not null) Uninstall(mod, toTrash);
        else if (batch) BatchDelete(toTrash);
    }


    private bool SmapiUnsupported => UpdateService.IsSmapiUnsupported(_gameVer ?? Updater.GetGameVersion(Cfg.Current.GamePath));

    /// <summary>v1.1.8：已装 SMAPI 是否已落在推荐的大版本线上（3.7.3 vs 3.7 算匹配；4.x vs 3.x 不匹配）。</summary>
    private static bool SmapiMatchesRecommend(string installed, string recommended)
    {
        if (string.IsNullOrWhiteSpace(installed) || string.IsNullOrWhiteSpace(recommended)) return false;
        var a = installed.Split('.');
        var b = recommended.Split('.');
        // 推荐 3.x → 装的必须是 3.x；推荐 2.x → 装的必须是 2.x
        return a.Length > 0 && b.Length > 0 && a[0] == b[0];
    }


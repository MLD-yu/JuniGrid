    private void AskDeleteTrash(List<TrashItem> picked)
    {
        if (_trashDeleting) return;          // 删除进行中：再点只会叠第二条线程
        if (picked.Count > 0) _pendingTrashDelete = picked;
    }

    private void CancelDeleteTrash() => _pendingTrashDelete = null;

    private async Task ConfirmDeleteTrashAsync()
    {
        var picked = _pendingTrashDelete;
        _pendingTrashDelete = null;
        if (picked is null || _trashDeleting) return;
        var game = Cfg.Current.GamePath;
        if (string.IsNullOrWhiteSpace(game)) return;

        // v1.3.15：永久删除回收站里几 GB 的包，同步跑就是整界面钉死。
        // v1.3.32：删得慢不是问题，没反馈才是 —— 按钮变成「正在删除…（3/15）」并禁用，
        // 列表在删完后才刷新（中途刷会把正在删的行画回来）。
        _trashDeleting = true;
        _trashDeleteDone = 0;
        _trashDeleteTotal = picked.Count;
        _trashDeleteCurrent = picked[0].DisplayName;
        _trashDeleteFilesDone = 0;
        _trashDeleteFilesTotal = picked.Sum(x => Math.Max(0, x.FileCount));
        StateHasChanged();
        _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tf("正在永久删除 {0} 份快照…", picked.Count));

        var failed = 0;
        try
        {
            failed = await Task.Run(() => TrashService.DeletePermanently(game, picked, progress =>
                _ = InvokeAsync(() =>
                {
                    _trashDeleteDone = progress.ItemsDone;
                    _trashDeleteTotal = progress.ItemsTotal;
                    _trashDeleteCurrent = progress.CurrentFolder;
                    _trashDeleteFilesDone = progress.FilesDone;
                    _trashDeleteFilesTotal = progress.FilesTotal;
                    StateHasChanged();
                })));
        }
        catch (Exception ex)
        {
            AppLog.Warn("Trash", "永久删除异常: " + ex.Message);
        }
        finally
        {
            _trashDeleting = false;
        }

        if (failed > 0) AppLog.Warn("Trash", $"[永久删除] {failed} 份失败");
        _trashSelected.Clear();
        LoadTrash(forceRefresh: true);
        _ = JS.InvokeVoidAsync("junigridJs.toast", failed > 0
            ? LocService.Tf("已删除 {0} 份快照，{1} 份失败", picked.Count - failed, failed)
            : LocService.Tf("已永久删除 {0} 份快照", picked.Count));
        StateHasChanged();
    }


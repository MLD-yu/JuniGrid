    /// <summary>v1.1.8：启禁用耗时账本 —— 每次启禁用一行 INF，把各段拆开。
    /// 用 Info 不用 Warn：耗时是常态数据，混进 WRN 会把真告警淹掉（AppLog 里就是这么约定的）。</summary>
    private static double ElapsedMs(long fromTimestamp)
        => (System.Diagnostics.Stopwatch.GetTimestamp() - fromTimestamp) * 1000.0 / System.Diagnostics.Stopwatch.Frequency;

    private static void ModsPerf(string what, params (string Phase, double Ms)[] phases)
        => AppLog.Info("ModsPerf", $"{what} | " + string.Join(" ", phases.Select(p => $"{p.Phase}={p.Ms:F0}ms"))
            + $" | 合计 {phases.Sum(p => p.Ms):F0}ms");

    private void SetDisabled(ModEntry m, bool disabled)
    {
        // v1.1.8：改名/联动跑在 Blazor 的同步事件处理器里 = 占着 WPF 的 UI 调度线程，
        // 这一段多长窗口就冻多长（点一下没反应、悬停动画全停）。所以先记账，再决定挪哪段。
        var oldFolder = m.Folder;
        var __t = System.Diagnostics.Stopwatch.GetTimestamp();
        var err = ModSvc.SetDisabled(Cfg.Current.GamePath, m.Folder, disabled);
        var __renameMs = ElapsedMs(__t);
        if (err is not null) ShowNotice("err", err);
        else
        {
            // v0.46.0：依赖联动（仿 Stardrop）——
            // 禁用：把依赖它的已启用 mod 也禁用；启用：把它依赖的已禁用 mod 也启用
            __t = System.Diagnostics.Stopwatch.GetTimestamp();
            var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var renamed = new List<string> { oldFolder };
            if (disabled) DisableDependents(m.UniqueID, visited, x => { renamed.Add(x.Folder); SetDisabledDirect(x, true); });
            else EnableDependencies(m, visited, x => { renamed.Add(x.Folder); SetDisabledDirect(x, false); });
            var __cascadeMs = ElapsedMs(__t);
            ShowNotice("ok", $"已{(disabled ? "禁用" : "启用")} {m.Name}");
            // v0.42.0：重命名 .X <-> X 后把 update state + 封面缓存迁移到新名字，
            // 否则 GetCover 按新 folder 名查不到缓存会落回首字母占位块
            __t = System.Diagnostics.Stopwatch.GetTimestamp();
            MigrateFolderCaches(oldFolder, DisabledName(oldFolder, disabled));
            // v1.7.1：启用时祖先目录可能被一并解点（.SVE/Sub → SVE/Sub），
            // 同级其它子包的路径也要跟着走，否则内存里还握着 .SVE/... 的旧名
            if (!disabled) MigrateAncestorRenames(oldFolder);
            // 就地改名后立刻重建索引：后台那轮重扫要到几百毫秒之后，这期间
            // _modsByFolder 若还握着旧名，选中/查找都会对不上（_selected 会被误清）。
            ReindexMods();
            var __migrateMs = ElapsedMs(__t);
            ModsPerf($"单{(disabled ? "禁" : "启")} {oldFolder}",
                ("改名", __renameMs), ("联动", __cascadeMs), ("缓存迁移+内存改名", __migrateMs));
            // v1.1.8：权威核对那一轮不再无条件排 —— 顶层改名 watcher 一定会收到事件
            // （120ms 合并后自己扫一次），再自己排一轮就是同一份盘扫两遍（实测每次
            // 多烧 0.5~1.3s 磁盘）。只有它看不见的才需要自己补：子包级改名（监听没开
            // IncludeSubdirectories）和 watcher 根本没建起来的情况。
            if (_modsWatcher is null || renamed.Any(f => f.Contains('/')))
                RescanAndRestate();
        }
        __t = System.Diagnostics.Stopwatch.GetTimestamp();
        // v1.6.8：启禁用改变肖像页内容 → 实时重扫
        PageRefresh.Request("portraits");
        // v0.49.0：状态变化后立即写回当前存档
        PersistCurrentToActive();
        Cfg.Save(Cfg.Current);
        ModsPerf("　↳ 收尾", ("肖像刷新+存档+配置", ElapsedMs(__t)));
    }

    private void Uninstall(ModEntry m, bool toTrash)
    {
        var err = ModSvc.Uninstall(Cfg.Current.GamePath, m.Folder, toTrash);
        if (err is not null) ShowNotice("err", err);
        else ShowNotice("ok", toTrash ? $"已移入回收站 {m.Name}" : $"已删除 {m.Name}");
        Rescan();
        // v1.6.8：删除/卸载可能移除肖像包 → 让已打开的肖像页实时重扫
        PageRefresh.Request("portraits");
    }

    // ------------------------------------------------------------------
    // 批量处理
    // ------------------------------------------------------------------
    /// <summary>不做依赖联动的底层启禁（联动递归用，避免无限循环）。</summary>
    private void SetDisabledDirect(ModEntry m, bool disabled)
    {
        var err = ModSvc.SetDisabled(Cfg.Current.GamePath, m.Folder, disabled);
        if (err is not null) { AppLog.Warn("Mods", $"联动{(disabled ? "禁用" : "启用")} {m.Folder} 失败：{err}"); return; }
        MigrateFolderCaches(m.Folder, DisabledName(m.Folder, disabled));
        if (!disabled) MigrateAncestorRenames(m.Folder);
    }

    /// <summary>启用时 ModService.SetDisabled 会解开被禁用的祖先目录（.SVE → SVE）。
    /// 这里把内存里所有挂在这条祖先下的条目路径一并改写，否则同级子包仍握着旧名。</summary>
    private void MigrateAncestorRenames(string folder)
    {
        var segs = folder.Replace('\\', '/').Split('/');
        for (var i = 0; i < segs.Length - 1; i++)
        {
            if (!segs[i].StartsWith('.')) continue;
            var ancOld = string.Join('/', segs.Take(i + 1));
            var ancNew = string.Join('/', segs.Take(i + 1).Select(s => s.TrimStart('.')));
            ApplyRenameInMemory(ancOld, ancNew);
            MigrateDictKey(Cfg.Current.ModCovers, ancOld, ancNew);
            MigrateDictKey(Cfg.Current.ModCategories, ancOld, ancNew);
        }
    }

    /// <summary>启禁用的改名落到磁盘后，把这条改名同步到内存与缓存里：
    /// 列表条目的 folder/启禁态、update state、封面与分类缓存的 key。
    /// newFolder 由调用方给 —— 单条启禁改的是路径末段（Top/Sub ↔ Top/.Sub），
    /// 切存档改的是整条顶层（Top/Sub ↔ .Top/Sub），两种都不是一个 bool 能表达清楚的。
    /// 只做字符串改写，不碰磁盘 —— 所以可以在事件处理器里同步跑（微秒级）。</summary>
    private void MigrateFolderCaches(string folder, string newFolder)
    {
        if (newFolder == folder) return;
        ApplyRenameInMemory(folder, newFolder);
        if (_states.TryGetValue(folder, out var st)) { _states[newFolder] = st; _states.Remove(folder); }
        MigrateDictKey(Cfg.Current.ModCovers, folder, newFolder);
        MigrateDictKey(Cfg.Current.ModCategories, folder, newFolder);
        _coversDirty = true;
        Cfg.Save(Cfg.Current);
    }

    /// <summary>改名只落在路径最后一段（v1.1.5 的子包级启禁：Top/Sub ↔ Top/.Sub），
    /// 与 ModService.SetDisabled 同一个约定。旧写法用 TrimStart/StartsWith 判整条路径，
    /// 子包那种 "Top/.Sub" 算出来还是原样 → 缓存 key 一直不迁移。
    /// v1.7.1：启用时同步剥掉祖先段的 . 前缀 —— ModService.SetDisabled 会解开被禁用的
    /// 父目录（.SVE/Sub → SVE/Sub），这里不跟着改就会把缓存迁到旧路径上。</summary>
    private static string DisabledName(string folder, bool disabled)
    {
        var parts = folder.Replace('\\', '/').Split('/');
        if (disabled)
        {
            var name = parts[^1];
            var target = name.StartsWith('.') ? name : "." + name;
            parts[^1] = target;
        }
        else
        {
            for (var i = 0; i < parts.Length; i++)
                parts[i] = parts[i].TrimStart('.');
        }
        return string.Join('/', parts);
    }

    /// <summary>把一次 folder 改名同步进内存列表：顶层改名会波及它下面所有子包条目，按前缀整片改。
    /// 与切存档那条增量更新路径同一个做法，让开关立刻翻，不必等全盘重扫。</summary>
    private void ApplyRenameInMemory(string oldFolder, string newFolder)
    {
        var prefix = oldFolder + '/';
        foreach (var e in _mods)
        {
            var rest = string.Equals(e.Folder, oldFolder, StringComparison.OrdinalIgnoreCase) ? ""
                : e.Folder.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? e.Folder[oldFolder.Length..]
                : null;
            if (rest is null) continue;
            e.Folder = newFolder + rest;
            e.Disabled = e.Folder.StartsWith('.') || e.Folder.Contains("/.");
        }
    }

    private static void MigrateDictKey(Dictionary<string, string> dict, string oldKey, string newKey)
    {
        if (dict.TryGetValue(oldKey, out var v)) { dict[newKey] = v; dict.Remove(oldKey); }
    }

    private async Task BatchSetDisabled(bool disabled)
    {
        // v0.72.7：批量启禁移入后台线程（与 ApplyProfile 同模式）——旧版在 UI 线程
        // 同步跑 N 次 Directory.Move，63 个 mod 直接卡死窗口。watcher OFF/ON 加
        // try/finally，中途异常不会永久关掉文件监听。
        var topLevels = _selected
            .Select(f => f.Split('/')[0])
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var gamePath = Cfg.Current.GamePath;
        var selCount = _selected.Count;

        if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = false;
        List<string> failedTops;
        try
        {
            failedTops = await Task.Run(() =>
            {
                var f = new List<string>();
                foreach (var top in topLevels)
                    if (ModSvc.SetDisabled(gamePath, top, disabled) is not null)
                        f.Add(top);
                return f;
            });
        }
        finally
        {
            if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = true;
        }
        var failed = failedTops.Count;

        ShowNotice(failed == 0 ? "ok" : "err",
            failed == 0
                ? $"已{(disabled ? "禁用" : "启用")} {selCount} 个mod"
                : $"{failed} 个操作失败");
        ClearSelection();
        // v1.6.8：批量启禁改变肖像页内容 → 实时重扫
        PageRefresh.Request("portraits");

        // v0.72.9：批量改名后统一迁移封面/分类缓存 —— v0.72.7 把 MigrateFolderCaches
        // 从批量路径里漏掉了，导致改名后 _states/ModCovers/ModCategories 的 key 还是
        // 旧 folder 名，GetCover/GetNexusCategory 查不到 → 封面消失、分类落回"代码 Mod"。
        // v1.1.8：改名没成功的那些不能迁（磁盘还是旧名，内存跟着改就走样了）
        var __t = System.Diagnostics.Stopwatch.GetTimestamp();
        var failedSet = new HashSet<string>(failedTops, StringComparer.OrdinalIgnoreCase);
        foreach (var top in topLevels)
            if (!failedSet.Contains(top))
                MigrateFolderCaches(top, DisabledName(top, disabled));
        ReindexMods();
        ModsPerf($"批量{(disabled ? "禁" : "启")} {topLevels.Count} 个顶层",
            ("内存改名+缓存迁移", ElapsedMs(__t)));

        // v1.1.8：批量启禁期间 watcher 是关着的，不会有文件事件来补这一轮，
        // 所以这里必须显式排一次后台重扫（原来是同步 Rescan()，148 项实测冻 481ms）。
        RescanAndRestate();
        // v0.72.9：显式触发一次封面回填（带并发闸门，不会叠加）——批量改名后 folder 变了，
        // 需要重新拉取新 key 下的封面。
        if (!string.IsNullOrWhiteSpace(_apiKey)) _ = BackfillCoversAsync();

        PersistCurrentToActive();
        Cfg.Save(Cfg.Current);
    }

    private void BatchDelete(bool toTrash)
    {
        _pendingBatchDelete = false;
        var count = _selected.Count;
        var failed = 0;
        foreach (var folder in _selected.ToList())
            if (ModSvc.Uninstall(Cfg.Current.GamePath, folder, toTrash) is not null)
                failed++;

        ShowNotice(failed == 0 ? "ok" : "err",
            failed == 0
                ? toTrash ? $"已移入回收站 {count} 个 mod" : $"已删除 {count} 个 mod"
                : $"{failed} 个删除失败");
        ClearSelection();
        Rescan();
    }

    private async Task BatchUpdate()
    {
        // v0.68.0：批量更新 —— 严格按「验证过的 Premium」分流：
        //  免费用户 → 系统浏览器依次打开每个所选 mod 的 N 网文件页（有几个跳几个），
        //            v0.68.2：有 N 网源的一律跳 N 网（双源 mod 也能跳转了）；
        //            只有纯 GitHub 源（无 N 网源）的才系统内免费直更；
        //  会员     → 全部在系统内依次自动更新（N 网优先），不跳任何网页。
        var selectedMods = _mods.Where(m => _selected.Contains(m.Folder)).ToList();
        if (selectedMods.Count == 0)
        {
            ShowNotice("err", "没有选中的 mod。");
            return;
        }
        var isPremium = Cfg.Current.NexusIsPremium;
        var ghTargets = selectedMods
            .Where(m => m.NexusModId is null && m.GitHubRepo is not null && !m.Disabled).ToList();

        if (!isPremium)
        {
            var webTargets = selectedMods
                .Where(m => m.NexusModId is not null).ToList();
            foreach (var m in webTargets)
            {
                // 非官方续作那一版不在 N 网页面上 —— 有来源页就先跳它
                UpdateService.OpenUrl(OffsiteUpdateUrl(m, GetState(m.Folder))
                    ?? $"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
                await Task.Delay(200);   // 逐个弹出，避免多标签被浏览器合并/拦截
            }
            if (webTargets.Count > 0)
                ShowNotice("ok", $"已打开 {webTargets.Count} 个 mod 的官网下载页（免费账户请在网页手动下载）");
            if (webTargets.Count == 0 && ghTargets.Count == 0)
            {
                ShowNotice("err", "所选 mod 都没有 Nexus ID / GitHub 源，无法更新（多为本地/其他来源 mod）");
                return;
            }
            if (ghTargets.Count > 0)
            {
                ShowNotice("ok", $"正在系统内更新 {ghTargets.Count} 个 GitHub 源 mod…");
                await RunUpdatePipeline(ghTargets);
            }
            return;
        }

        var targets = selectedMods
            .Where(m => (m.NexusModId is not null || m.GitHubRepo is not null) && !m.Disabled)
            .ToList();
        if (targets.Count == 0)
        {
            ShowNotice("err", "选中的 Mod 没有可自动更新的（缺 Nexus/GitHub 更新标识或已禁用）。");
            return;
        }
        ShowNotice("ok", $"正在系统内依次更新 {targets.Count} 个 mod…（后台进行，完成后会提示）");
        if (!string.IsNullOrEmpty(_apiKey))
            _ = BackfillCoversAsync();
        await RunUpdatePipeline(targets);
        // v0.68.1：GitHub 源 release 没挂 zip、系统内装不了的，补开其下载页
        foreach (var m in targets)
        {
            if (GetState(m.Folder).Status == "available" && m.GitHubRepo is not null)
            { OpenUpdateDownloadPage(m); await Task.Delay(200); }
        }
    }

    /// <summary>v0.41.0：给所有缺封面的 mod（含被禁用的）补拉 Nexus 封面。
    /// v0.72.7：单实例并发闸门 —— 同一时间最多一个回填任务在跑。
    /// vNext：串行逐个拉改为并发 6 路（与更新检测共用并发预算）——几十个缺封面
    /// 时旧版要串行等几十个网络往返，封面慢速「逐个冒出来」。</summary>
    private int _backfillRunning;

    private async Task BackfillCoversAsync()
    {
        // 旧包装方法 BackfillCoversCoreAsync 里 try 块递归调自己（而非真实现），
        // 闸门一开就死循环爆栈 —— 直接删掉，闸门挪进本方法开头
        if (Interlocked.Exchange(ref _backfillRunning, 1) == 1) return;
        try
        {
            var need = _mods
                .Where(m => m.NexusModId is not null)
                .Where(m => string.IsNullOrEmpty(GetState(m.Folder).PictureUrl)
                            && !Cfg.Current.ModCovers.ContainsKey(m.Folder)
                            && !Cfg.Current.ModCovers.ContainsKey(NormCoverKey(m.Folder)))
                .ToList();
            if (need.Count == 0) return;

            // v1.2.1：优先走免 API Key 的 GraphQL 批量指纹（自带 pictureUrl）——
            // 配置被清零后用户往往没登录/无 key，旧逻辑只在有 key 时回填，封面永远回不来
            var still = new List<ModEntry>();
            try
            {
                var ids = need.Where(m => m.NexusModId is not null).Select(m => m.NexusModId!.Value).ToList();
                var batch = await Nexus.GetModFingerprintsBatchAsync(ids);
                if (batch is not null)
                {
                    foreach (var m in need)
                    {
                        if (m.NexusModId is int id && batch.TryGetValue(id, out var fp)
                            && !string.IsNullOrEmpty(fp.PictureUrl))
                        {
                            GetState(m.Folder).PictureUrl = fp.PictureUrl;
                            Cfg.Current.ModCovers[m.Folder] = fp.PictureUrl;
                            _coversDirty = true;
                        }
                        else still.Add(m);
                    }
                }
                else still.AddRange(need);
            }
            catch (Exception ex) { AppLog.Warn("Mods", "封面批量回填失败: " + ex.Message); still.AddRange(need); }

            // 剩下的才走需要 key 的单查（没 key 就跳过）
            if (still.Count > 0 && !string.IsNullOrEmpty(_apiKey))
            {
                var semaphore = new SemaphoreSlim(2);
                await Task.WhenAll(still.Select(async m =>
                {
                    await semaphore.WaitAsync();
                    try
                    {
                        var info = await Nexus.GetModAsync(_apiKey, m.NexusModId!.Value);
                        if (info is not null && !string.IsNullOrEmpty(info.PictureUrl))
                        {
                            GetState(m.Folder).PictureUrl = info.PictureUrl;
                            Cfg.Current.ModCovers[m.Folder] = info.PictureUrl;
                            _coversDirty = true;
                        }
                        if (info?.CategoryId is int cid)
                        {
                            GetState(m.Folder).CategoryId = cid;
                            if (Cfg.Current.NexusCategories.TryGetValue(cid, out var cname))
                                Cfg.Current.ModCategories[m.Folder] = cname;
                        }
                    }
                    catch (Exception ex) { AppLog.Warn("Mods", "封面回填失败(" + m.Folder + "): " + ex.Message); }
                    finally { semaphore.Release(); }
                }));
            }

            if (_coversDirty)
            {
                Cfg.Save(Cfg.Current);
                _coversDirty = false;
                AppLog.Warn("Mods", "封面回填完成，ModCovers=" + Cfg.Current.ModCovers.Count);
            }
            await InvokeAsync(StateHasChanged);
        }
        finally { Interlocked.Exchange(ref _backfillRunning, 0); }
    }

    // ------------------------------------------------------------------
    // 更新检查 + 自动更新
    // ------------------------------------------------------------------

    private async Task AutoUpdateOnEnterAsync()
    {
        // v0.68.3：进入 Mod 页的自动更新策略 —— 完全由「设置」页的
        // 「自动安装更新」开关（EnableAutoInstall，仅 Premium 可开）决定，不再弹窗询问。
        //  ① 开关关 / 免费账号 → 只做 CheckOnlyOne 检测标记 ⇧，绝不装
        //  ② 开关开（Premium） → 检查完对所有可更新项直接跑 RunUpdatePipeline 系统内装
        await CheckUpdates();

        if (!Cfg.Current.NexusIsPremium || !Cfg.Current.EnableAutoInstall) return;

        var targets = _mods.Where(IsUpdatable).ToList();
        if (targets.Count == 0) return;
        ShowNotice("ok", $"正在自动更新 {targets.Count} 个 mod…");
        await RunUpdatePipeline(targets);
        // GitHub 源 release 没挂 zip 附件的，补开其下载页
        foreach (var m in targets)
        {
            if (GetState(m.Folder).Status == "available" && m.GitHubRepo is not null)
            { OpenUpdateDownloadPage(m); await Task.Delay(200); }
        }
    }

    private async Task CheckUpdates(bool force = false)
    {
        // v1.08：禁用的 mod 也检查更新 —— 用户禁用 ≠ 不想更新，只查不装，无副作用
        // v1.6.8：凡有 UniqueID 的 mod 都参与更新检查 —— smapi.io 批量快道免 Key
        // 按 UID 比对版本（不再要求 manifest 必须带 UpdateKeys/安装来源标记）
        // vP0：JuniGrid 转换的 Portraiture→CP 包不参与 —— 本地 Version=1.0.0 是
        // 转换器占位，NexusModId 边车指向原素材包，比对必然误报「有更新」。
        var targets = _mods
            .Where(m => !m.IsConvertedPortraitPack)
            .Where(m => m.NexusModId is not null || m.GitHubRepo is not null
                        || !string.IsNullOrEmpty(m.UniqueID))
            // v0.44.0：60 分钟内已查过的跳过（瞬时不发请求），远程版本状态仍保留显示
            // v1.06.7：force=true（顶栏点当前页图标刷新）无视 TTL 强制全量重查 ——
            // 否则装了旧版 mod 后刷新，mod 在 1 小时内被查过就直接跳过，「检查不到更新」
            .Where(m => force || !_lastCheckedUtc.TryGetValue(m.Folder, out var t)
                        || DateTime.UtcNow - t > UpdateCheckTtl)
            .ToList();

        // v0.46.0：首次检查更新时顺手拉官方分类表（有 key 才拉得动）
        if (!string.IsNullOrEmpty(_apiKey)) _ = EnsureCategoriesAsync();

        // v1.6.8：未配 Nexus Key 时不再丢弃 N 网源 mod —— smapi.io 快道免 Key 即可
        // 判定可更新；需要 Key 的 files.json 精查只在配了 Key 的机器上参与。

        // vNext：没有要查的（全部命中 TTL / 没配 key 且无 GitHub 源）→ 静默返回，
        // 不再亮「正在检查更新…」状态（切页回来时每次都空闪一下）
        if (targets.Count == 0) return;

        // vNext：列表已可见，检查状态只显示在标题小字里，不再整页换骨架屏
        _checkingUpdates = true;
        StateHasChanged();

        // v0.41.0：封面补拉 —— 禁用 mod 不参与更新检查，但封面照常用 Nexus detail 拉一次，
        // 避免"禁用即丢封面"。只做最轻量的 GetModAsync，拿到 PictureUrl 存缓存，不触发任何更新逻辑。
        // vNext：挪到检查流水线【之后】—— 指纹快道已顺手把封面带回来（绝大多数零请求），
        // 剩下的（批次失败/GitHub 源/禁用行）再由这里兜底，不再与版本检查抢连接和限流窗口。
        // v0.68.0：检查走「只检测」流水线（CheckOnlyOne 不下载不安装），
        // 安装只能由用户确认后走 RunUpdatePipeline。
        await RunCheckPipeline(targets);
        // 封面回填不依赖 API Key（GraphQL 免 key）——配置清零后这里必须能跑
        _ = BackfillCoversAsync();
    }

    /// <summary>v0.68.0：只检测版本、绝不下载安装的并行流水线。
    /// vNext：先跑「指纹批量快道」—— 一次免 key 的 GraphQL 批量（50 个/批）拿全部 Nexus mod
    /// 的 updatedAt，与持久化指纹逐字比对：一致的 mod 直接复用上次精查到的最新 MAIN 文件
    /// 版本（文件列表没变，结果不会过期），整批零请求秒回；只有指纹变化/缓存缺失/批次
    /// 没返回的少数 mod 才落到逐个 files.json 精查，精查结果连同新指纹回写缓存。
    /// 常规进页（重启应用后 / 超 60 分钟 TTL）从 N 个请求塌缩到 ~N/50 个，微光骨架
    /// 从几十秒降到约 1 秒。批次整体失败时全部走精查（与旧版行为一致，宁可慢不可错）。</summary>
    // ------------------------------------------------------------------
    // v1.08：国内快道 —— smapi.io 官方 web API 批量预查
    // 一次 POST 查全部 mod（Cloudflare 国内直连约 1 秒，不挂 VPN 也不超时）。
    // folder → 最新版本号；null = 快道没查到该 mod（继续走 Nexus 精查）。
    // 整体请求失败时整个字段为 null，行为退回原来的 Nexus/GitHub 流程。
    // ------------------------------------------------------------------
    private Dictionary<string, string?>? _smapiPrecheck;

    // 快道同时给出的来源页（folder → url）：非官方续作的版本在 N 网页面上不存在，
    // 跳转要用它，否则点「更新」打开的是打不到那一版的旧页面。
    private Dictionary<string, string?>? _smapiPrecheckUrl;

    // v1.08：预查结果会话级缓存 uid → (最新版, 来源页, 时间)。10 分钟内重复刷新直接命中，
    // 连 smapi.io 那一个请求都省掉。null 版本（快道确认已最新）同样缓存。
    private static readonly Dictionary<string, (string? Ver, string? Url, DateTime At)> SmapiPrecheckCache = new();
    private static readonly TimeSpan SmapiPrecheckTtl = TimeSpan.FromMinutes(10);

    private static readonly HttpClient SmapiWebHttp = CreateSmapiWebHttp();
    private static HttpClient CreateSmapiWebHttp()
    {
        var h = new HttpClient();
        h.DefaultRequestHeaders.UserAgent.ParseAdd("JuniGrid-Launcher");
        h.Timeout = TimeSpan.FromSeconds(15);
        return h;
    }

    /// <summary>smapi.io 的 /api/mods 必须要 apiVersion（当前 SMAPI 版本号），否则它对每个 mod 都回
    /// 「ApiVersion or InstalledVersion are null」且不给 suggestedUpdate —— 我们原先没带这个字段，
    /// 又只读 version、把 errors 丢了，所以整条快道一直在静默空转。</summary>
    private static string? _smapiApiVersion;
    private string? ApiVersionForPrecheck()
    {
        if (!string.IsNullOrWhiteSpace(_smapiApiVersion)) return _smapiApiVersion;
        var raw = _smapiVersion ?? Game.ProbeSmapiVersion(Cfg.Current.GamePath, freshRead: false);
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var parts = raw.Split('.');
        _smapiApiVersion = parts.Length >= 2 ? string.Join('.', parts.Take(3)) : raw;
        return _smapiApiVersion;
    }

    private async Task SmapiBatchPrecheck(List<ModEntry> targets)
    {
        _smapiPrecheck = null;
        _smapiPrecheckUrl = null;
        if (targets.Count == 0) return;
        var apiVersion = ApiVersionForPrecheck();
        if (apiVersion is null)
        {
            AppLog.Warn("Mods", "[国内快道] 拿不到本机 SMAPI 版本，跳过 smapi.io 预查（走 Nexus/GitHub 精查）");
            return;
        }

        var keyOf = (ModEntry m) => string.IsNullOrEmpty(m.UniqueID) ? $"FAKE.Nexus.{m.NexusModId ?? 0}" : m.UniqueID;

        // v1.08：先吃会话缓存 —— 全部命中就零请求完成预查
        var needFetch = new List<ModEntry>();
        foreach (var m in targets)
        {
            if (SmapiPrecheckCache.TryGetValue(keyOf(m), out var hit)
                && DateTime.UtcNow - hit.At < SmapiPrecheckTtl)
                continue;
            needFetch.Add(m);
        }
        if (needFetch.Count == 0)
        {
            _smapiPrecheck = targets.ToDictionary(
                m => m.Folder,
                m => SmapiPrecheckCache.TryGetValue(keyOf(m), out var h) ? h.Ver : null);
            _smapiPrecheckUrl = targets.ToDictionary(
                m => m.Folder,
                m => SmapiPrecheckCache.TryGetValue(keyOf(m), out var h) ? h.Url : null);
            return;
        }

        // 同 UniqueID/ID 装了多份（本体+旧副本）时同 id 只发一次，结果共享回填
        var payload = System.Text.Json.JsonSerializer.Serialize(new
        {
            apiVersion,
            mods = needFetch.Select(m => new
            {
                id = keyOf(m),
                // 转换包不带原包 updateKey —— 否则 smapi.io 会把原 N 网版本
                // 挂到合成 UID 上，装成 1.0.0 永远显示可更新
                updateKeys = m.IsConvertedPortraitPack
                    ? Array.Empty<string>()
                    : (m.NexusModId is int nid ? new[] { $"nexus:{nid}" } : Array.Empty<string>())
                      .Concat(m.GitHubRepo is string gh ? new[] { $"github:{gh}" } : Array.Empty<string>()).ToArray(),
                installedVersion = m.Version,
            }),
        });

        try
        {
            using var resp = await SmapiWebHttp.PostAsync(
                "https://smapi.io/api/v4.0.0/mods",
                new StringContent(payload, System.Text.Encoding.UTF8, "application/json"));
            if (!resp.IsSuccessStatusCode) return;
            using var doc = System.Text.Json.JsonDocument.Parse(await resp.Content.ReadAsStringAsync());

            var versionById = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
            var urlById = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
            int noSuggestion = 0;
            foreach (var item in doc.RootElement.EnumerateArray())
            {
                var id = item.TryGetProperty("id", out var i) ? i.GetString() : null;
                string? ver = null, srcUrl = null;
                if (item.TryGetProperty("suggestedUpdate", out var su)
                    && su.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    if (su.TryGetProperty("version", out var v)) ver = v.GetString();
                    // 来源页跟着建议版本一起给（例：Bus Locations 的 1.2.2-unofficial.1-Xytronix
                    // → https://smapi.io/mods#bus-locations）。原先只读 version 把它丢了，
                    // 跳转只能回落到 N 网文件页，而那页最新就是玩家已装的 1.2.0。
                    if (su.TryGetProperty("url", out var u)) srcUrl = u.GetString();
                }
                if (ver is null && item.TryGetProperty("errors", out var errs)
                    && errs.ValueKind == System.Text.Json.JsonValueKind.Array && errs.GetArrayLength() > 0)
                    noSuggestion++;   // 多半是这个 mod 没写 UpdateKeys，smapi.io 认不出它
                if (!string.IsNullOrEmpty(id))
                {
                    versionById[id] = ver;
                    urlById[id] = string.IsNullOrWhiteSpace(srcUrl) ? null : srcUrl;
                }
            }
            if (noSuggestion > 0)
                AppLog.Warn("Mods", $"[国内快道] smapi.io 对 {noSuggestion}/{needFetch.Count} 个 mod 没给版本建议"
                    + "（通常是 manifest 里没有 UpdateKeys，只有走启动器安装的才有）");

            foreach (var m in targets)
            {
                var k = keyOf(m);
                if (versionById.TryGetValue(k, out var v))
                    SmapiPrecheckCache[k] = (v ?? "", urlById.TryGetValue(k, out var u) ? u : null, DateTime.UtcNow);
            }
            _smapiPrecheck = targets.ToDictionary(
                m => m.Folder,
                m => SmapiPrecheckCache.TryGetValue(keyOf(m), out var h) ? h.Ver : null);
            _smapiPrecheckUrl = targets.ToDictionary(
                m => m.Folder,
                m => SmapiPrecheckCache.TryGetValue(keyOf(m), out var h) ? h.Url : null);
            // 值语义：非空字符串 = 快道给出的最新版本；空字符串 = 快道确认已是最新；
            // null = 快道没覆盖（无 UpdateKey / 不在索引）→ 精查兜底。
        }
        catch (Exception ex)
        {
            AppLog.Warn("Mods", "[国内快道] smapi.io 预查失败（退回 Nexus/GitHub）: " + ex.Message);
        }
    }

    private async Task RunCheckPipeline(List<ModEntry> targets)
    {
        // v1.08：smapi.io 快道与 Nexus 指纹批查并行跑（原先串行，白等一个网络往返）；
        // 预查结果在精查阶段开始前才真正需要。
        var smapiTask = SmapiBatchPrecheck(targets);

        var precise = targets;
        Dictionary<int, string>? fpUpdatedAt = null;   // modId → 批量指纹的 updatedAt（精查成功后回写缓存用）
        if (!string.IsNullOrEmpty(_apiKey))
        {
            var nexusIds = targets.Where(m => m.NexusModId is not null).Select(m => m.NexusModId!.Value).ToList();
            if (nexusIds.Count > 0)
            {
                var fps = await Nexus.GetModFingerprintsBatchAsync(nexusIds);
                if (fps is not null)
                {
                    fpUpdatedAt = fps.ToDictionary(kv => kv.Key, kv => kv.Value.UpdatedAt);
                    var rest = new List<ModEntry>();
                    foreach (var m in targets)
                    {
                        if (m.NexusModId is int id && fps.TryGetValue(id, out var fp))
                        {
                            _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
                            // 顺手补封面：批次免费带 pictureUrl，绝大多数封面回填请求就此消失
                            if (!string.IsNullOrEmpty(fp.PictureUrl)
                                && string.IsNullOrEmpty(GetState(m.Folder).PictureUrl)
                                && !Cfg.Current.ModCovers.ContainsKey(m.Folder)
                                && !Cfg.Current.ModCovers.ContainsKey(NormCoverKey(m.Folder)))
                            {
                                Cfg.Current.ModCovers[m.Folder] = fp.PictureUrl;
                                _coversDirty = true;
                            }
                            if (Cfg.Current.ModUpdateFingerprints.TryGetValue(id, out var cached)
                                && string.Equals(cached.UpdatedAt, fp.UpdatedAt, StringComparison.Ordinal)
                                && !string.IsNullOrWhiteSpace(cached.LatestFileVersion)
                                && DateTime.UtcNow - cached.CheckedAtUtc < FingerprintMaxAge)
                            {
                                // 指纹一致 → 远端文件列表没变 → 上次精查的文件版本直接复用
                                var cachedFid = cached.LatestFileId != 0 ? cached.LatestFileId : (long?)null;
                                var show = NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, cached.LatestFileVersion, cachedFid);
                                RememberRemoteVersion(m.Folder, cached.LatestFileVersion);
                                _states[m.Folder] = new ModUpdateState
                                {
                                    Status = show ? "available" : "latest",
                                    RemoteVersion = cached.LatestFileVersion,
                                    RemoteFileId = cachedFid,
                                };
                                continue;
                            }
                        }
                        rest.Add(m);   // 指纹缺失/有变化/无缓存/GitHub 源 → 逐个精查
                    }
                    precise = rest;
                    StateHasChanged();   // 快道结果先上屏，精查的状态让 ⇧ 慢慢冒出来
                }
            }
        }

        await smapiTask;   // v1.08：精查前等快道结果（此时通常已并行完成）

        // v1.6.8：未配 Nexus API Key → 跳过需要 Key 的 files.json 精查，
        // 全部按 smapi.io 快道的版本号判定可更新（更新动作走行内 ⇧ 手动通道）；
        // 快道没覆盖的 mod 静默记 latest（不打扰）；GitHub 源照旧精查。
        if (string.IsNullOrEmpty(_apiKey))
        {
            var gitHubRest = new List<ModEntry>();
            foreach (var m in precise)
            {
                var preVer = _smapiPrecheck is not null
                    && _smapiPrecheck.TryGetValue(m.Folder, out var v0) ? v0 : null;
                if (preVer is null && m.GitHubRepo is not null) { gitHubRest.Add(m); continue; }
                if (preVer is null)
                {
                    _states[m.Folder] = new ModUpdateState { Status = "latest" };
                    _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
                    continue;
                }
                var showPre = NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, preVer, null);
                RememberRemoteVersion(m.Folder, preVer);
                _states[m.Folder] = new ModUpdateState
                {
                    Status = showPre ? "available" : "latest",
                    RemoteVersion = preVer,
                };
            }
            precise = gitHubRest;
        }

        if (precise.Count > 0)
        {
            // AUP 二审：原 32 路 files.json 精查过猛；工作项 3 路，网络层仍有 ApiGate=2 硬顶
            var semaphore = new SemaphoreSlim(3);
            // vNext：同 modId 的精查请求全流水线共享一次（一个 mod 装了两份只发一个请求）
            var byId = new System.Collections.Concurrent.ConcurrentDictionary<int, Task<NexusFileInfo?>>();
            await Task.WhenAll(precise.Select(async m =>
            {
                await semaphore.WaitAsync();
                try { await CheckOnlyOne(m, byId, fpUpdatedAt); }
                finally { semaphore.Release(); }
            }));
        }

        if (_fpDirty)
        {
            // 顺手清掉已卸载 mod 的残留指纹，缓存不无限膨胀
            var liveIds = _mods.Where(m => m.NexusModId is not null).Select(m => m.NexusModId!.Value).ToHashSet();
            foreach (var staleId in Cfg.Current.ModUpdateFingerprints.Keys.Where(id => !liveIds.Contains(id)).ToList())
                Cfg.Current.ModUpdateFingerprints.Remove(staleId);
        }
        if (_coversDirty || _fpDirty)
        {
            Cfg.Save(Cfg.Current);
            _coversDirty = false;
            _fpDirty = false;
        }
        // vNext：检查期间列表已可见（不再换骨架屏），人为保底 0.6s 延迟已删
        _checkingUpdates = false;
        StateHasChanged();
    }

    /// <summary>
    /// v0.68.0：单个 mod 的「只检测」—— 拉远端版本号 + 封面 + 分类，
    /// 有可更新版本只打 ⇧ 标记，绝不发起下载安装。
    /// （从 UpdateOne 拆出：检查与安装分离是「询问后再更新」的前提）
    /// </summary>
    private async Task CheckOnlyOne(ModEntry m,
        System.Collections.Concurrent.ConcurrentDictionary<int, Task<NexusFileInfo?>>? sharedFetch = null,
        IReadOnlyDictionary<int, string>? fpUpdatedAt = null,
        bool isRetry = false)
    {
        var prevRemote = _states.TryGetValue(m.Folder, out var prev) ? prev.RemoteVersion : null;
        var st = _states[m.Folder] = new ModUpdateState { Status = "checking", RemoteVersion = prevRemote };
        _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
        if (m.IsConvertedPortraitPack)
        {
            // 转换包：内容已随最近一次转换落地，不与 N 网原包版本比对
            st.Status = "latest";
            st.RemoteVersion = null;
            return;
        }
        try
        {
            // v1.08：smapi.io 批量快道命中 → 零请求直接采用结果。
            //   非空 = 快道给出的最新版本；空字符串 = 快道确认已是最新；
            //   null = 快道没覆盖该 mod（无 UpdateKey/不在索引），继续原流程精查。
            if (_smapiPrecheck is not null && _smapiPrecheck.TryGetValue(m.Folder, out var preVer))
            {
                if (preVer is not null)
                {
                    if (preVer.Length > 0)
                    {
                        st.RemoteVersion = preVer;
                        st.RemoteUrl = _smapiPrecheckUrl is not null
                            && _smapiPrecheckUrl.TryGetValue(m.Folder, out var preUrl) ? preUrl : null;
                        RememberRemoteVersion(m.Folder, preVer, st.RemoteUrl);
                        var showPre = NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, preVer, null);
                        // 快道只给版本号、不给 fileId，所以「这条文件我装过了」的四条判据里
                        // 靠 fileId 的三条全部无从下手 —— 判成「有更新」时不能就此收工，
                        // 让 N 网精查（拿得到 fileId）复核一次，否则 .nxm 刚装完的最新版
                        // 永远亮着 ⇧（实测 mod 30482 装完 15 分钟后仍提示 1.4.0）。
                        // 精查没给出结论时，末尾仍按快道的版本号收口（没 key 的用户不受影响）。
                        if (!(showPre && m.NexusModId is not null && !string.IsNullOrEmpty(_apiKey)))
                        {
                            st.Status = showPre ? "available" : "latest";
                            NotifyCheckProgress();
                            return;
                        }
                    }
                    else
                    {
                        st.RemoteVersion = null;
                        st.Status = "latest";
                        NotifyCheckProgress();
                        return;
                    }
                }
            }

            // v0.68.2：N 网源优先检测，无 N 网源或拉取失败才查 GitHub
            // v0.72.0：检测源与安装源统一 —— 以 files.json 最新 MAIN 文件的版本为准
            // （与 UpdateOne/一键直装 GetLatestMainFileAsync 同一权威源）。旧逻辑取
            // mods/{id}.json 顶层 version（作者手填，常滞后于主文件），才会出现
            // 「本地 1.3.0 判无更新、点更新却装出 1.3.1」的自相矛盾。
            if (m.NexusModId is not null && !string.IsNullOrEmpty(_apiKey))
            {
                // vNext：同 modId 的精查结果在流水线内共享 —— 一个 mod 装了两份（本体+旧副本）
                // 只发一次 files.json 请求，两行共用结果
                NexusFileInfo? file;
                if (sharedFetch is not null)
                    file = await sharedFetch.GetOrAdd(m.NexusModId!.Value,
                        k => Nexus.GetLatestMainFileAsync(_apiKey, k, installedFolder: m.Folder));
                else
                    file = await Nexus.GetLatestMainFileAsync(_apiKey, m.NexusModId!.Value, installedFolder: m.Folder);
                var remoteVer = string.IsNullOrWhiteSpace(file?.Version) ? null : file!.Version;
                if (remoteVer is null)
                {
                    // 主文件没写版本号的兜底：退回 mod 顶层 version（顺带补封面；
                    // 常规缺封面由 BackfillCoversAsync 单独负责，这里不多花请求）
                    var info = await Nexus.GetModAsync(_apiKey, m.NexusModId!.Value);
                    if (!string.IsNullOrEmpty(info?.Version))
                    {
                        remoteVer = info!.Version;
                        if (!string.IsNullOrEmpty(info.PictureUrl))
                        {
                            st.PictureUrl = info.PictureUrl;
                            Cfg.Current.ModCovers[m.Folder] = info.PictureUrl;
                            _coversDirty = true;
                        }
                    }
                }
                if (remoteVer is not null)
                {
                    // 启动器曾下过这一 fileId → 自动校准版本，不再误报「可更新」
                    var healed = NexusUpdateTruth.TryHealFromPriorDownload(
                        Cfg.Current, m, file?.FileId ?? 0, remoteVer, Cfg.Current.GamePath ?? "");
                    if (healed) Cfg.Save(Cfg.Current);
                    st.RemoteVersion = remoteVer;
                    st.RemoteFileId = file?.FileId;
                    RememberRemoteVersion(m.Folder, remoteVer);
                    // 权威判定：N 网 MAIN 文件 fileId/版本 vs 本地有效版本（含安装记录）
                    st.Status = NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, remoteVer, file?.FileId)
                        ? "available" : "latest";
                    // vNext：精查成功 → 连同本轮批量的 updatedAt 指纹一起写入持久化缓存，
                    // 下次进页指纹没变就直接复用这个版本号（快道零请求命中的数据源）
                    if (fpUpdatedAt is not null && fpUpdatedAt.TryGetValue(m.NexusModId!.Value, out var ua))
                    {
                        Cfg.Current.ModUpdateFingerprints[m.NexusModId!.Value] = new ModUpdateFingerprintEntry
                        {
                            UpdatedAt = ua,
                            LatestFileVersion = remoteVer,
                            LatestFileId = file?.FileId ?? 0,
                            CheckedAtUtc = DateTime.UtcNow,
                        };
                        _fpDirty = true;
                    }
                    NotifyCheckProgress();
                    return;
                }
            }

            // GitHub 兜底：无 N 网源（或 N 网查询失败）的 mod
            if (m.GitHubRepo is not null)
            {
                var gh = await Updater.CheckModGitHubAsync(m.GitHubRepo);
                if (gh is not null)
                {
                    st.RemoteVersion = gh.Tag;
                    RememberRemoteVersion(m.Folder, gh.Tag);
                    st.Status = VersionUtil.IsNewer(gh.Tag, m.Version) ? "available" : "latest";
                    NotifyCheckProgress();
                    return;
                }
            }

            if (st.Status is "checking")
                st.Status = NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, st.RemoteVersion, st.RemoteFileId)
                    ? "available" : "latest";
        }
        catch (Exception ex)
        {
            // v1.08：超时/网络抖动自动重试一次；仍失败才标红并给中文友好提示
            if (!isRetry && IsTransientNetworkError(ex))
            {
                await Task.Delay(800);
                await CheckOnlyOne(m, sharedFetch, fpUpdatedAt, isRetry: true);
                return;
            }
            st.Status = "failed"; st.Message = FriendlyUpdateError(ex);
        }
        NotifyCheckProgress();
    }

    /// <summary>检查进度防抖上屏 —— 精查 32 路并发，每个 mod 完成都直接 StateHasChanged
    /// 会让整页列表（几百行）每秒重渲染几十次，低端机上返回列表后肉眼可见的卡顿根源。
    /// 与 CoverCacheService.Changed 同款 500ms 合并：进度状态晚半秒上屏无感知，
    /// 流水线结束处仍有最终一次全量渲染兜底。</summary>
    private int _checkNotifyPending;

    private void NotifyCheckProgress()
    {
        if (Interlocked.Exchange(ref _checkNotifyPending, 1) == 1) return;
        _ = Task.Run(async () =>
        {
            await Task.Delay(500);
            Interlocked.Exchange(ref _checkNotifyPending, 0);
            if (_disposed) return;
            await InvokeAsync(StateHasChanged);
        });
    }

    /// <summary>请求超时/网络失败 → 中文友好提示；其余异常保留原始信息方便排查。</summary>
    private static string FriendlyUpdateError(Exception ex)
    {
        if (ex is TaskCanceledException or OperationCanceledException
            || ex.Message?.Contains("HttpClient.Timeout", StringComparison.Ordinal) == true)
            return "检查更新超时（Nexus 连接不稳），已自动重试仍失败，请稍后重试";
        if (ex is HttpRequestException)
            return "网络连接失败，请检查网络后重试";
        return ex.Message ?? "未知错误";
    }

    private static bool IsTransientNetworkError(Exception ex)
        => ex is TaskCanceledException or OperationCanceledException or HttpRequestException
           || ex.Message?.Contains("HttpClient.Timeout", StringComparison.Ordinal) == true;

    private async Task RunUpdatePipeline(List<ModEntry> targets)
    {
        StateHasChanged();

        // AUP 二审：更新流水线 16 → 3；网络层 ApiGate=2 仍是硬顶
        var semaphore = new SemaphoreSlim(3);
        await Task.WhenAll(targets.Select(async m =>
        {
            await semaphore.WaitAsync();
            try { await UpdateOne(m); }
            finally { semaphore.Release(); }
        }));

        if (_coversDirty)
        {
            Cfg.Save(Cfg.Current);   // 把顺手拿到的封面缓存落盘
            _coversDirty = false;
        }

        _checkingUpdates = false;

        var states = targets.Select(t => GetState(t.Folder)).ToList();
        var updated = states.Count(s => s.Status == "updated");
        var failed = states.Count(s => s.Status == "failed");
        var premiumBlocked = states.Count(s => s.Status == "premium");
        if (updated > 0) Rescan();
        // v0.68.0：合并为一条完成汇总（原来两条 toast 互相顶掉），
        // 且 premium 被拦（免费账号误进流水线）也要给明确反馈，不再「没反应」
        var manualGh = states.Count(s => s.Status == "available");
        if (updated > 0 || failed > 0 || premiumBlocked > 0 || manualGh > 0)
            ShowNotice(failed == 0 && premiumBlocked == 0 ? "ok" : "err",
                $"已自动更新 {updated} 个 Mod ✔"
                + (failed > 0 ? $"，{failed} 个失败（原因见各行提示）" : "")
                + (premiumBlocked > 0 ? $"，{premiumBlocked} 个需 Premium 会员（可点行内更新按钮跳官网手动下载）" : "")
                + (manualGh > 0 ? $"，{manualGh} 个发布页未挂安装包，已打开下载页/可点行内 ⇧ 手动更新" : ""));

        // vNext：人为保底 0.6s「加载观感」延迟已删 —— 更新中状态都在行内实时呈现

        StateHasChanged();
    }

    private async Task UpdateOne(ModEntry m, bool isRetry = false)
    {
        // v0.61.0：新建 state 时保留旧 RemoteVersion，避免可更新列表在检查瞬间被清空再重建（图三闪烁）
        var prevRemote = _states.TryGetValue(m.Folder, out var prev) ? prev.RemoteVersion : null;
        var st = _states[m.Folder] = new ModUpdateState { Status = "checking", RemoteVersion = prevRemote };
        _lastCheckedUtc[m.Folder] = DateTime.UtcNow;
        // v1.2.5：开始检查属高频中间态（16 路并发每个 mod 都触发一次），改走 500ms 合并节流；
        // 后续终态（available/premium/failed/updated/latest）仍立即 StateHasChanged。
        NotifyCheckProgress();
        try
        {
            // ── ① Nexus 源优先（v0.68.2）：有 N 网源的 mod 一律先走 N 网检测与下载，
            //    SDV-辉光这类双源 mod 不再被 GitHub 源「截胡」（免费用户批量更新也能跳 N 网）──
            if (m.NexusModId is not null && !string.IsNullOrEmpty(_apiKey))
            {
                // v0.72.0：先解析「最新 MAIN 文件」，检测与安装共用这一个权威源。
                // 旧逻辑检测用 mods/{id}.json 顶层 version、安装才查 files.json 主文件，
                // 两处版本号对不上时出现「说没更新、一点更新却装出更高版」。
                var file = await Nexus.GetLatestMainFileAsync(_apiKey, m.NexusModId!.Value, installedFolder: m.Folder);
                var remoteVer = string.IsNullOrWhiteSpace(file?.Version) ? null : file!.Version;
                if (remoteVer is null)
                {
                    // 主文件没写版本号的兜底：退回 mod 顶层 version（顺带补封面）
                    var info = await Nexus.GetModAsync(_apiKey, m.NexusModId!.Value);
                    if (!string.IsNullOrEmpty(info?.Version))
                    {
                        remoteVer = info!.Version;
                        if (!string.IsNullOrEmpty(info.PictureUrl))
                        {
                            st.PictureUrl = info.PictureUrl;
                            Cfg.Current.ModCovers[m.Folder] = info.PictureUrl;
                            _coversDirty = true;
                        }
                    }
                }

                if (remoteVer is not null)
                {
                    var healed = NexusUpdateTruth.TryHealFromPriorDownload(
                        Cfg.Current, m, file?.FileId ?? 0, remoteVer, Cfg.Current.GamePath ?? "");
                    if (healed) Cfg.Save(Cfg.Current);
                    st.RemoteVersion = remoteVer;
                    st.RemoteFileId = file?.FileId;
                    RememberRemoteVersion(m.Folder, remoteVer);

                    // N 网 MAIN 文件口径：已装上同一 fileId/文件版本 → 不再报可更新
                    if (NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, remoteVer, file?.FileId))
                    {
                        // ── 发现新版本 → N 网直链自动下载安装，不跳网站 ──
                        if (file is null)
                        {
                            // 判定可更新却拿不到可下载文件 → 标记可更新走行内 ⇧ 手动通道，不再硬报失败
                            st.Status = "available"; st.Message = null;
                            StateHasChanged(); return;
                        }
                        st.Status = "updating";
                        st.Message = $"发现新版本 {remoteVer}（Nexus 源），正在自动更新…";
                        NotifyCheckProgress();

                        var dl = await Nexus.GetDownloadUrlAsync(_apiKey, m.NexusModId!.Value, file.FileId);
                        if (dl.NeedsPremium)
                        {
                            st.Status = "premium";
                            st.Message = null;   // 极简：只在版本号后加紫色 ⇧ new 标签，不再显示黄色说明
                            StateHasChanged(); return;
                        }
                        if (dl.Url is null)
                        {
                            st.Status = "failed"; st.Message = "获取下载地址失败：" + dl.Error;
                            StateHasChanged(); return;
                        }

                        var zip = Path.Combine(StoragePaths.DownloadsDir,
                            $"mod-{m.NexusModId}-{file.FileId}.zip");
                        Directory.CreateDirectory(Path.GetDirectoryName(zip)!);
                        await DownloadWithTask(
                            dl.Url, zip,
                            $"更新 Mod「{m.Name}」",
                            $"正在下载 {m.Name}…",
                            (msg, pct, spd) => { st.Message = msg; NotifyCheckProgress(); });

                        var err = ModSvc.InstallUpdate(Cfg.Current.GamePath, m.Folder, zip, out var newVer);
                        if (err is null)
                        {
                            st.Status = "updated";
                            st.Message = null;
                            Cfg.Current.ModLastDownload[m.NexusModId!.Value.ToString()] = DateTime.Now.ToString("yyyy-MM-dd");
                            Cfg.Current.ModFileLastDownload[file.FileId.ToString()] = DateTime.Now.ToString("yyyy-MM-dd");
                            // 版本号优先用装出来的 manifest（zip 内 Version），N 网 file.Version 常为空
                            var ver = !string.IsNullOrWhiteSpace(newVer) ? newVer! : remoteVer;
                            NexusUpdateTruth.RecordInstall(Cfg.Current, m, file.FileId, ver, Cfg.Current.GamePath ?? "");
                            if (!string.IsNullOrWhiteSpace(ver)) m.Version = ver!;
                            st.RemoteVersion = remoteVer;
                            st.RemoteFileId = file.FileId;
                            Cfg.Save(Cfg.Current);
                        }
                        else
                        {
                            st.Status = "failed"; st.Message = "安装失败：" + err;
                        }
                        StateHasChanged();
                        return;
                    }

                    // N 网已最新：双源 mod 继续查 GitHub 兜底；纯 N 网 mod 直接定稿
                    if (m.GitHubRepo is null)
                    {
                        st.Status = "latest"; st.Message = null;
                        StateHasChanged(); return;
                    }
                }
            }

            // ── ② GitHub 兜底：纯 GitHub 源（无 N 网源）、或 N 网查询失败的双源 mod ──
            if (m.GitHubRepo is not null)
            {
                var gh = await Updater.CheckModGitHubAsync(m.GitHubRepo);
                if (gh is not null)
                {
                    st.RemoteVersion = gh.Tag;
                    RememberRemoteVersion(m.Folder, gh.Tag);
                    if (VersionUtil.IsNewer(gh.Tag, m.Version) && gh.ZipUrl is not null)
                    {
                        st.Status = "updating";
                        st.Message = $"发现新版本 {gh.Tag}（GitHub 源），正在自动更新…";
                        NotifyCheckProgress();

                        var ghZip = Path.Combine(StoragePaths.DownloadsDir,
                            "gh-" + m.GitHubRepo.Replace('/', '-') + ".zip");
                        Directory.CreateDirectory(Path.GetDirectoryName(ghZip)!);
                        await DownloadWithTask(
                            gh.ZipUrl, ghZip,
                            $"更新 Mod「{m.Name}」",
                            $"正在下载 {m.Name}（GitHub 源）…",
                            (msg, pct, spd) => { st.Message = msg; NotifyCheckProgress(); });

                        // expectedUniqueId 安全锁：多 Mod 共用仓库时防止装错
                        var ghErr = ModSvc.InstallUpdate(Cfg.Current.GamePath, m.Folder, ghZip,
                            out var ghNewVer,
                            expectedUniqueId: string.IsNullOrEmpty(m.UniqueID) ? null : m.UniqueID);
                        if (ghErr is null)
                        {
                            st.Status = "updated";
                            st.Message = null;
                        }
                        else
                        {
                            st.Status = "failed";
                            st.Message = "GitHub 更新失败：" + ghErr;
                        }
                        StateHasChanged();
                        return;
                    }
                    if (VersionUtil.IsNewer(gh.Tag, m.Version))
                    {
                        st.Status = "available";
                        st.Message = $"GitHub {gh.Tag}";
                        StateHasChanged();
                        return;
                    }
                }
            }

            // 两源都无更新 / 都查询失败 → 保持原有远端标记或定为最新
            if (st.Status is "checking")
            {
                st.Status = st.RemoteVersion is not null && VersionUtil.IsNewer(st.RemoteVersion, m.Version)
                    ? "available" : "latest";
                st.Message = null;
            }
        }
        catch (OperationCanceledException)
        {
            // v1.1.7：用户在任务中心暂停/取消 —— 不是更新失败
            st.Status = st.Status == "updating" ? "available" : st.Status;
            st.Message = null;
        }
        catch (Exception ex)
        {
            // v1.08：超时/网络抖动自动重试一次；仍失败才标红并给中文友好提示
            if (!isRetry && IsTransientNetworkError(ex))
            {
                await Task.Delay(800);
                await UpdateOne(m, isRetry: true);
                return;
            }
            st.Status = "failed"; st.Message = FriendlyUpdateError(ex);
        }
        StateHasChanged();
    }

    /// <summary>
    /// Mod 下载也走任务中心（右下角任务胶囊 + /tasks 页），
    /// 和 SMAPI 更新共用同一个下载页面。下载时上报百分比/速度/当前步骤。
    /// v1.1.7：传入任务 CT —— 暂停/取消会真正中断下载；半截包可续传。
    /// </summary>
    private async Task DownloadWithTask(
        string url, string zipPath, string taskTitle, string startMsg,
        Action<string, double?, double?>? onTick = null, CancellationToken ct = default)
    {
        var task = Center.Start(taskTitle, "download");
        try
        {
            Center.Report(task, startMsg, 0, 0);
            onTick?.Invoke(startMsg, null, null);
            var progress = new Progress<NexusDownloadProgress>(p =>
                _ = InvokeAsync(() =>
                {
                    Center.Report(task, p.Message, p.Percent, p.SpeedMBps);
                    onTick?.Invoke(p.Message, p.Percent, p.SpeedMBps);
                }));
            // v1.08：GitHub 资源直连失败（国内 443 被拒）自动切换镜像前缀重试；
            // Nexus CDN 是签名 URL，镜像无法代理，维持直连。
            if (url.Contains("github.com/", StringComparison.OrdinalIgnoreCase)
                && !url.StartsWith("https://api.github.com/", StringComparison.Ordinal))
            {
                Exception? last = null;
                foreach (var candidate in UpdateService.GithubUrls(url))
                {
                    try
                    {
                        if (candidate != url)
                        {
                            try { System.IO.File.Delete(zipPath); } catch { }
                            Center.Report(task, "GitHub 直连失败，切换镜像下载…", 0, 0);
                        }
                        await Nexus.DownloadFileAsync(candidate, zipPath, progress, ct);
                        Center.Finish(task, true, "下载完成");
                        return;
                    }
                    catch (Exception ex) when (ex is not OperationCanceledException) { last = ex; }
                }
                throw last!;
            }

            await Nexus.DownloadFileAsync(url, zipPath, progress, ct);
            Center.Finish(task, true, "下载完成");
        }
        catch (OperationCanceledException)
        {
            if (task.Status != "paused")
                Center.Finish(task, false, "已取消");
            throw;
        }
        catch (Exception ex)
        {
            Center.Finish(task, false, ex.Message);
            throw;
        }
    }

    /// <summary>
    /// SMAPI 一键自动更新：后台下载官方安装包 → 无人值守运行
    /// SMAPI.Installer.exe（--install --no-prompt --game-path），
    /// 全程不弹窗口、不跳浏览器，装完自动刷新状态。
    /// </summary>
    /// <summary>v0.36.0：未安装 SMAPI 时的一键下载安装 —— 与 UpdateSmapi 共用同一个
    /// 全自动安装器（RunSmapiInstallerAsync 内部就是下载 zip + 静默部署文件），
    /// 用户不需要任何手动操作。</summary>
    private async Task InstallSmapi()
    {
        if (_smapiUpdating) return;
        // v1.08：任务中心级防重 —— 页面重建导致 _smapiUpdating 归零的间隙也拦得住
        if (Center.Items.Any(t => t.Status == "running"
                && t.Title.StartsWith("SMAPI", StringComparison.OrdinalIgnoreCase)))
        { ShowNotice("err", "SMAPI 任务进行中，请等它完成"); return; }

        // v1.1.8：历史版本与 latest 同管线 —— 没缓存时按当前游戏版本现拉对应 tag
        if (_smapiUpdate is null || _smapiUpdate.InstallerZipUrl is null)
        {
            _smapiUpdate = SmapNeedsOld
                ? await Updater.CheckSmapiForGameAsync(_smapiVersion, _gameVer, force: true)
                : await Updater.CheckSmapiAsync(_smapiVersion, force: true);
            StateHasChanged();
        }
        if (_smapiUpdate is null || _smapiUpdate.LatestVersion is null || _smapiUpdate.InstallerZipUrl is null)
        {
            ShowNotice("err", _smapiUpdate?.Error ?? "还没拿到 SMAPI 下载地址，请稍后再试（或检查网络）。");
            return;
        }

        _smapiUpdating = true;
        StateHasChanged();

        var task = Center.Start($"SMAPI {_smapiUpdate.LatestVersion}", "install");

        // v1.1.7：整段可重入 —— 暂停后继续重新挂 worker
        async Task RunAsync(CancellationToken ct)
        {
            var progress = new Progress<UpdateService.InstallProgress>(p =>
                _ = InvokeAsync(() => Center.Report(task, p.Message, p.Percent, p.SpeedMBps)));
            try
            {
                var err = await Updater.RunSmapiInstallerAsync(
                    _smapiUpdate, Cfg.Current.GamePath, progress, ct);

                if (err is null)
                {
                    Center.Finish(task, true, $"SMAPI {_smapiUpdate.LatestVersion} 安装完成");
                    _smapiVersion = Game.ProbeSmapiVersion(Cfg.Current.GamePath, freshRead: true);
                    _svSmapiVersionCache = _smapiVersion;
                    // v1.1.8：装完仍按当前游戏版本查，旧版不要刷回 latest
                    _smapiUpdate = SmapNeedsOld
                        ? await Updater.CheckSmapiForGameAsync(_smapiVersion, _gameVer)
                        : await Updater.CheckSmapiAsync(_smapiVersion);
                    // 安装完成后重新扫描 mod 列表（SMAPI 自带 ConsoleCommands/SaveBackup 会进列表）
                    _ = InvokeAsync(RescanAndRestate);
                }
                else if (err.Contains("已取消") || err.Contains("已暂停"))
                {
                    // RunSmapiInstallerAsync 现在会把 OCE 抛出；err 分支兜底
                }
                else
                {
                    Center.Finish(task, false, err);
                }
            }
            catch (OperationCanceledException)
            {
                if (task.Status != "paused")
                    Center.Finish(task, false, "已取消");
            }
            catch (Exception ex)
            {
                Center.Finish(task, false, ex.Message);
            }
            finally
            {
                if (task.Status is "done" or "failed")
                    Center.UnregisterResume(task);
            }
        }

        Center.RegisterResume(task, async ct =>
        {
            _smapiUpdating = true;
            await InvokeAsync(StateHasChanged);
            try { await RunAsync(ct); }
            finally
            {
                _smapiUpdating = false;
                await InvokeAsync(StateHasChanged);
            }
        });

        // v1.08：不再自动跳转任务页 —— 右下角任务胶囊即可看进度，不打断当前页面
        try
        {
            await RunAsync(task.Cts.Token);
        }
        finally
        {
            _smapiUpdating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateSmapi()
    {
        if (_smapiUpdating) return;
        if (Center.Items.Any(t => t.Status == "running"
                && t.Title.StartsWith("SMAPI", StringComparison.OrdinalIgnoreCase)))
        { ShowNotice("err", "SMAPI 任务进行中，请等它完成"); return; }
        if (_smapiUpdate is null || _smapiUpdate.LatestVersion is null) return;

        _smapiUpdating = true;
        StateHasChanged();

        var task = Center.Start($"SMAPI {_smapiUpdate.LatestVersion}", "update");

        async Task RunAsync(CancellationToken ct)
        {
            var progress = new Progress<UpdateService.InstallProgress>(p =>
                _ = InvokeAsync(() => Center.Report(task, p.Message, p.Percent, p.SpeedMBps)));
            try
            {
                var err = await Updater.RunSmapiInstallerAsync(
                    _smapiUpdate, Cfg.Current.GamePath, progress, ct);

                if (err is null)
                {
                    Center.Finish(task, true, $"SMAPI 已更新到 {_smapiUpdate.LatestVersion}");
                    // v1.3.4：freshRead 重探（绕开 Windows 版本资源缓存，否则立即读会拿到
                    // 旧版本号误报可更新）+ 同步静态缓存（否则下次进页 OnInitialized 又用旧值）
                    _smapiVersion = Game.ProbeSmapiVersion(Cfg.Current.GamePath, freshRead: true);
                    _svSmapiPath = Cfg.Current.GamePath;
                    _svSmapiVersionCache = _smapiVersion;
                    // v1.1.8：旧版游戏装完仍查对应 tag
                    _smapiUpdate = SmapNeedsOld
                        ? await Updater.CheckSmapiForGameAsync(_smapiVersion, _gameVer)
                        : await Updater.CheckSmapiAsync(_smapiVersion);
                }
                else if (err.Contains("已取消") || err.Contains("已暂停"))
                {
                }
                else
                {
                    Center.Finish(task, false, err);
                }
            }
            catch (OperationCanceledException)
            {
                if (task.Status != "paused")
                    Center.Finish(task, false, "已取消");
            }
            catch (Exception ex)
            {
                Center.Finish(task, false, ex.Message);
            }
            finally
            {
                if (task.Status is "done" or "failed")
                    Center.UnregisterResume(task);
            }
        }

        Center.RegisterResume(task, async ct =>
        {
            _smapiUpdating = true;
            await InvokeAsync(StateHasChanged);
            try { await RunAsync(ct); }
            finally
            {
                _smapiUpdating = false;
                await InvokeAsync(StateHasChanged);
            }
        });

        // 立即跳到任务页看进度（右下角胶囊也会同步显示）
        Nav.NavigateTo("/tasks");

        try
        {
            await RunAsync(task.Cts.Token);
        }
        finally
        {
            _smapiUpdating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>v0.68.1：打开该 mod 的下载页（GitHub releases 优先，其次 Nexus 文件页）。</summary>
    private static void OpenUpdateDownloadPage(ModEntry m)
    {
        if (m.GitHubRepo is not null)
            UpdateService.OpenUrl($"https://github.com/{m.GitHubRepo}/releases/latest");
        else if (m.NexusModId is not null)
            UpdateService.OpenUrl($"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
    }

    private void ShowNotice(string kind, string text)
    {
        // v0.43.1：成功/删除 → 黑底白字 toast；报错 → 红底白字 toast；同时全部落日志
        if (kind == "err") AppLog.Error("Mods", text); else AppLog.Warn("Mods", text);
        _ = JS.InvokeVoidAsync("junigridJs.toast", text, kind == "err" ? "err" : "ok");
    }

}

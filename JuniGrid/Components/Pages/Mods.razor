@namespace JuniGrid.Components.Pages
@page "/mods"
@inject ConfigService Cfg
@inject ModService ModSvc
@inject GameService Game
@inject UpdateService Updater
@inject NexusService Nexus
@inject InstallService Installer
@inject UpdateQueueService Queue
@inject PageRefreshService PageRefresh
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TaskCenterService Center
@inject CoverCacheService Covers
@implements IDisposable

<div class="jg-page">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px">
        <div>
            <div style="display:flex;align-items:center;gap:14px">
                <h1 style="margin-top:0;margin-bottom:4px">Mod 管理</h1>
                @* v1.07.3：普通文件夹图标，点击打开 Mods 目录；data-tip 与导航栏同款胶囊提示 *@
                <button class="jg-mods-folder-btn" data-tip="打开 mods 文件夹" aria-label="打开 mods 文件夹"
                        @onclick="OpenModsRootFolder">
                    <svg viewBox="0 0 1024 1024" width="32" height="32" fill="#f2b544">
                        <path d="M855.04 385.024q19.456 2.048 38.912 10.24t33.792 23.04 21.504 37.376 2.048 54.272q-2.048 8.192-8.192 40.448t-14.336 74.24-18.432 86.528-19.456 76.288q-5.12 18.432-14.848 37.888t-25.088 35.328-36.864 26.112-51.2 10.24l-567.296 0q-21.504 0-44.544-9.216t-42.496-26.112-31.744-40.96-12.288-53.76l0-439.296q0-62.464 33.792-97.792t95.232-35.328l503.808 0q22.528 0 46.592 8.704t43.52 24.064 31.744 35.84 12.288 44.032l0 11.264-53.248 0q-40.96 0-95.744-0.512t-116.736-0.512-115.712-0.512-92.672-0.512l-47.104 0q-26.624 0-41.472 16.896t-23.04 44.544q-8.192 29.696-18.432 62.976t-18.432 61.952q-10.24 33.792-20.48 65.536-2.048 8.192-2.048 13.312 0 17.408 11.776 29.184t29.184 11.776q31.744 0 43.008-39.936l54.272-198.656q133.12 1.024 243.712 1.024l286.72 0z"/>
                    </svg>
                </button>
            </div>
            <div style="opacity:.7;font-size:13px">
                @* v1.08：骨架屏只负责磁盘扫描阶段；检查更新期间列表照常显示 *@
                @if (_initialLoading) { <span>正在加载 mod 列表…</span> }
                else { <text>共 @_mods.Count 个（@_mods.Count(m => !m.Disabled) 已启用）</text> }
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
            @* v0.47.0：存档下拉挪到最右；GSAP easeReverse 弹性开合（参照官方 demo）*@
            <div class="jg-profile-dd @(_profileOpen ? "open" : "")">
                @* v0.71.4：重命名挪到下拉按钮右边 —— 点铅笔后按钮变输入框、铅笔变确定，改名只在这一个位置发生 *@
                @if (_renamingProfile is not null)
                {
                    <input class="jg-profile-input jg-profile-headinput" maxlength="30"
                           value="@_renameBuffer"
                           @oninput="e => _renameBuffer = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="e => OnRenameKey(e, _renamingProfile!)"
                           @onclick:stopPropagation />
                    <button class="jg-profile-headconfirm" data-tip="确定" aria-label="确定"
                            @onclick="() => ConfirmRename(_renamingProfile!)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                            <path d="M20 6 9 17l-5-5"/>
                        </svg>
                    </button>
                }
                else
                {
                    <button class="jg-sort-trigger" @onclick="ToggleProfile">
                        @ActiveProfileName
                        <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    @if (ActiveProfileName != "默认")
                    {
                        <button class="jg-profile-rename jg-profile-headrename" data-tip="重命名" aria-label="重命名"
                                @onclick="() => StartRenameProfile(ActiveProfileName)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#3d3d3d" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                                <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                <path d="m15 5 4 4"/>
                            </svg>
                        </button>
                    }
                }
                <div class="jg-sort-menu jg-profile-menu">
                    @foreach (var p in AllProfiles)
                    {
                        <div class="jg-profile-item @(p.Name == ActiveProfileName ? "active" : "")">
                            @* v0.71.4：菜单项只负责切换/删除；重命名统一由下拉按钮右侧的铅笔入口发起 *@
                            <button class="jg-profile-name"
                                    @onclick="() => ApplyProfileKeepOpen(p.Name)">@p.Name</button>
                            @if (p.Name != "默认")
                            {
                                <button class="jg-profile-del" @onclick="() => AskDeleteProfile(p.Name)">×</button>
                            }
                        </div>
                    }
                    <div class="jg-profile-item">
                        @if (_addingProfile)
                        {
                            <input class="jg-profile-input" placeholder="存档名称" maxlength="30"
                                   @bind="_newProfileName" @bind:event="oninput" />
                            <button class="jg-profile-name" style="font-weight:600;flex:none" @onclick="ConfirmAddProfile">确定</button>
                        }
                        else
                        {
                            @* 虚线胶囊 + 悬停胶囊提示（导航栏同款 data-tip 风格）*@
                            <button class="jg-profile-addcap" data-tip="新建存档" aria-label="新建存档" @onclick="StartAddProfile">
                                <span class="plus">＋</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── SMAPI 永远第一个显示（用自己的 exe 图标，不用 emoji）── *@
    <div class="jg-card jg-smapi-card" style="margin-top:12px">
        <div style="display:flex;align-items:center;gap:12px">
            @* v0.37.0：exe 抽不到图标时用自带的 pufferchick 兜底，不再显示灰色 S 占位块 *@
            @if (_smapiIcon is not null)
            {
                <img class="jg-modrow-icon" src="@_smapiIcon" alt="SMAPI" />
            }
            else
            {
                <img class="jg-modrow-icon" src="assets/smapi-pufferchick.svg" alt="SMAPI"
                     style="border-radius:8px;background:#fff;padding:2px" />
            }
            <div style="min-width:0;flex:1">
                <div style="font-weight:700">
                    SMAPI
                    <span style="opacity:.6;font-weight:400;font-size:12px">Mod 加载器</span>
                </div>
                <div style="opacity:.75;font-size:12.5px;margin-top:3px">
                    @if (_smapiVersion is null)
                    {
                        @* v0.36.0：未安装时的专属提示 *@
                        @if (_smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
                        {
                            <span>未安装 · 最新版 @_smapiUpdate.LatestVersion，点右侧按钮一键下载安装</span>
                        }
                        else if (_smapiUpdate is { Error: not null })
                        {
                            <span style="color:#c50f1f">未安装 · 获取版本信息失败（@_smapiUpdate.Error）</span>
                        }
                        else
                        {
                            <span>未安装 · 正在获取最新版本…</span>
                        }
                    }
                    else
                    {
                        <text>当前版本：@SmapiDisplay</text>
                        @if (_smapiUpdate is { HasUpdate: true })
                        {
                            <span style="color:#b4009e;font-weight:600"> ⇧ 新版本 @_smapiUpdate.LatestVersion 可用</span>
                        }
                    }
                </div>
            </div>
            @* v0.36.0：未安装 -> 一键下载安装；已装有更新 -> 更新。两条路都走同一个全自动安装器 *@
            @if (_smapiVersion is null && _smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="InstallSmapi">
                    @(_smapiUpdating ? "正在安装…" : $"⬇ 下载安装 SMAPI {_smapiUpdate.LatestVersion}")
                </button>
            }
            else if (_smapiUpdate is { HasUpdate: true })
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="UpdateSmapi">
                    @(_smapiUpdating ? "正在更新…" : $"⬇ 更新到 {_smapiUpdate.LatestVersion}")
                </button>
            }
        </div>
    </div>

    @if (_mods.Count == 0)
    {
        <div class="jg-card" style="margin-top:12px">
            Mods 文件夹为空或未定位到游戏。请先在「设置」里选择游戏目录。
        </div>
    }

    @* ── v0.34.0 工具条：排序在前 → 筛选 chips → 搜索（点击向右延伸，SVG 图标） ── *@
    <div class="jg-mods-toolbar">
        <div class="jg-sort-dd @(_sortOpen ? "open" : "")">
            <button class="jg-sort-trigger" @onclick="ToggleSort">
                排序方式
                <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="jg-sort-menu">
                <button class="jg-sort-item @(_sortMode == "time-asc" ? "active" : "")" @onclick='() => SetSort("time-asc")'>最新在前</button>
                <button class="jg-sort-item @(_sortMode == "time-desc" ? "active" : "")" @onclick='() => SetSort("time-desc")'>最早在前</button>
                <button class="jg-sort-item @(_sortMode == "alpha" ? "active" : "")" @onclick='() => SetSort("alpha")'>首字母</button>
            </div>
        </div>
        @* v0.71.6：排序下拉打开时铺一层透明遮罩，点"除下拉框本身以外"的地方即收回 *@
        @if (_sortOpen)
        {
            <div class="jg-dd-overlay" @onclick="CloseSort"></div>
        }
        <div class="jg-chips" role="group" style="align-items:center">
        @foreach (var f in _filterOptions)
        {
            <button class="jg-chip @(_filter == f.Key ? "active" : "")"
                    style="@(f.Key == "updatable" && FailedCheckCount > 0 ? "position:relative" : "")"
                    @onclick="() => SetFilter(f.Key)">
                @f.Label<span style="opacity:.7;font-weight:400"> · @CountFor(f.Key)</span>
                @if (f.Key == "updatable" && FailedCheckCount > 0)
                {
                    @* v1.08：有检查失败的 mod → 可更新标签右上角小红点 *@
                    <span style="position:absolute;top:-3px;right:-3px;width:8px;height:8px;border-radius:50%;background:#e81123;box-shadow:0 0 0 2px var(--jg-bg,#fff)"></span>
                }
            </button>
        }
        @if (FailedCheckCount > 0)
        {
            <span style="font-size:12px;color:#c50f1f;opacity:.85;white-space:nowrap">更新检查超时，请检查网络（@FailedCheckCount 个未完成）</span>
        }
        else if (_checkingUpdates)
        {
            <span style="font-size:12px;opacity:.6;white-space:nowrap">正在检查更新…</span>
        }
        </div>
        <div class="jg-search-x @(_searchOpen ? "open" : "")">
            <button class="jg-search-btn" @onclick="ToggleSearch">
                <img src="assets/search.svg" alt="搜索" style="width:18px;height:18px;display:block" />
            </button>
            <div class="jg-search-field">
                <input class="jg-search-input" placeholder="搜mod名/N网尾号"
                       @bind="SearchText" @bind:event="oninput" />
                <button class="jg-search-clear" @onclick="ClearSearchAndClose">✕</button>
            </div>
        </div>
    </div>

    @* ── 单行 mod 列表 ── *@
    @* v1.06.9：首次加载 或 检查更新未完成 → 一律显示 shimmer 骨架屏，真实列表 display:none *@
    @if (_initialLoading)
    {
        <div class="jg-modrows jg-modrows-skeleton">
            @for (var i = 0; i < 8; i++)
            {
                <div class="jg-modrow-shimmer">
                    <div class="jg-shimmer jg-shimmer-avatar"></div>
                    <div class="jg-shimmer-lines">
                        <div class="jg-shimmer jg-shimmer-line" style="width:38%"></div>
                        <div class="jg-shimmer jg-shimmer-line" style="width:68%"></div>
                    </div>
                    <div class="jg-shimmer jg-shimmer-pill"></div>
                </div>
            }
        </div>
    }
    <div class="jg-modrows" style="@(_initialLoading ? "display:none" : "")">
        @foreach (var group in Groups)
        {
            @if (group.Key != "")
            {
                var isCollapsed = _collapsed.Contains(group.Key);
                <div class="jg-group-head" @onclick="() => ToggleGroup(group.Key)">
                    <span>@(isCollapsed ? "▶" : "▼")</span>
                    <span style="font-weight:600">@group.Key</span>
                    <span style="opacity:.55;font-size:11.5px">（@group.Items.Count 个）</span>
                    @if (group.Missing.Count > 0)
                    {
                        <span style="color:#c50f1f;font-size:11.5px"> ⚠️ 缺失依赖 @group.Missing.Count</span>
                    }
                </div>
            }

            @if (group.Key == "" || !_collapsed.Contains(group.Key))
            {
                @foreach (var m in group.Items)
                {
                    var st = GetState(m.Folder);
                    var cover = GetCover(m);
                    var missing = MissingDeps(m);
                    <div class="jg-modrow @(_selected.Contains(m.Folder) ? "selected" : "")"
                         @key="m.Folder"
                         data-al
                         @onclick="() => ToggleSelect(m.Folder)">

                        @if (cover is not null)
                        {
                            <img class="jg-modrow-icon" src="@cover" loading="lazy" alt="" />
                        }
                        else
                        {
                            <div class="jg-modrow-icon jg-modrow-icon-fallback">
                                @(m.Name.Length > 0 ? m.Name[..1].ToUpperInvariant() : "?")
                            </div>
                        }

                        <div class="jg-modrow-text">
                            <div class="jg-modrow-title">
                                <span class="name">@RemarkName(m)</span>
                                <span class="divider">|</span>
                                <span class="ver">@m.Version</span>
                                @if (st.RemoteVersion is not null && IsNewer(st.RemoteVersion, m.Version))
                                {
                                    <span class="upd">⇧ @st.RemoteVersion</span>
                                }
                                else if (st.Status is "updating")
                                {
                                    <span class="upd">⇧ 更新中…</span>
                                }
                                @if (m.Disabled)
                                {
                                    <span class="jg-tag">已禁用</span>
                                }
                                @if (!m.HasManifest)
                                {
                                    <span class="jg-tag" style="background:rgba(232,17,35,.12);color:#c50f1f">无清单</span>
                                }
                            </div>
                            <div class="jg-modrow-desc">
                                @if (GetNexusCategory(m) is { } _cat)
                                {
                                    <span class="jg-cat">@_cat</span>
                                }
                                @(string.IsNullOrWhiteSpace(m.Description) ? m.Folder : m.Description)
                            </div>
                            @if (missing.Count > 0)
                            {
                                <div class="jg-mod-updmsg failed" style="white-space:normal">
                                    ⚠️ 缺少依赖：@string.Join("、", missing)
                                </div>
                            }
                            @* v1.08：检查失败/超时不再在行内显示红字，统一收进筛选栏提示 *@
                        </div>

                        @* ── hover 浮现的操作按钮 ── *@
                        <div class="jg-modrow-actions">
                            @if (m.NexusModId is not null
                                 && st.RemoteVersion is not null
                                 && IsNewer(st.RemoteVersion, m.Version))
                            {
                                @* v0.41.0：只有确定有新版本才显示更新按钮；已是1.0（st.RemoteVersion 为 null 或不更高）一律不渲染 *@
                                <button class="jg-rowbtn upd"
                                        data-tip="更新"
                                        @onclick:stopPropagation @onclick="() => OpenUpdatePage(m)">
                                    <svg class="jg-rowbtn-icon" viewBox="0 0 1024 1024" aria-hidden="true">
                                        <path d="M512 68.571429a441.897143 441.897143 0 1 1-172.571429 34.822857A440.514286 440.514286 0 0 1 512 68.571429m0-68.571429C229.234286 0 0 229.234286 0 512s229.234286 512 512 512 512-229.234286 512-512S794.765714 0 512 0z"/>
                                        <path d="M709.291429 409.142857L541.394286 230.137143a34.205714 34.205714 0 0 0-29.108572-16.102857h-0.708571a34.285714 34.285714 0 0 0-29.234286 16.125714L314.685714 409.142857a34.285714 34.285714 0 0 0 50.057143 46.857143L477.714286 335.462857v440.228572a34.285714 34.285714 0 0 0 68.571428 0V335.508571L659.28 456a34.285714 34.285714 0 0 0 50.011429-46.857143z"/>
                                    </svg>
                                </button>
                            }
                            @if (m.NexusModId is not null)
                            {
                                <button class="jg-rowbtn" data-tip="mod 详情"
                                        @onclick:stopPropagation @onclick="() => OpenDetail(m)">
                                    <svg class="jg-rowbtn-icon" viewBox="0 0 1024 1024" aria-hidden="true">
                                        <path d="M182.044444 256m-28.444444 0a28.444444 28.444444 0 1 0 56.888889 0 28.444444 28.444444 0 1 0-56.888889 0Z"/>
                                        <path d="M182.044444 199.111111c-34.133333 0-56.888889 22.755556-56.888888 56.888889s22.755556 56.888889 56.888888 56.888889 56.888889-22.755556 56.888889-56.888889-22.755556-56.888889-56.888889-56.888889z"/>
                                        <path d="M182.044444 512m-28.444444 0a28.444444 28.444444 0 1 0 56.888889 0 28.444444 28.444444 0 1 0-56.888889 0Z"/>
                                        <path d="M182.044444 455.111111c-34.133333 0-56.888882 22.755556-56.888882 56.888889s22.755549 56.888882 56.888882 56.888882 56.888882-22.755549 56.888882-56.888882-22.755549-56.888882-56.888882-56.888882z"/>
                                        <path d="M182.044444 768m0 0a28.444444 28.444444 0 1 0 56.888889 0 28.444444 28.444444 0 1 0-56.888889 0Z"/>
                                        <path d="M182.044444 711.111111c-34.133333 0-56.889333 22.755556-56.889333 56.888889s22.756 56.888889 56.889333 56.888889 56.889333-22.755556 56.889333-56.888889-22.756-56.888889-56.889333-56.888889z"/>
                                        <path d="M381.155556 256h512"/>
                                        <path d="M893.155556 284.444444h-512c-17.066667 0-28.444444-11.377778-28.444445-28.444444s11.377778-28.444444 28.444445-28.444444h512c17.066667 0 28.444444 11.377778 28.444444 28.444444s-17.066667 28.444444-28.444444 28.444444z"/>
                                        <path d="M381.155556 512h512"/>
                                        <path d="M893.155556 540.444444h-512c-17.066667 0-28.444444-11.377778-28.444445-28.444444s11.377778-28.444444 28.444445-28.444444h512c17.066667 0 28.444444 11.377778 28.444444 28.444444s-17.066667 28.444444-28.444444 28.444444z"/>
                                        <path d="M381.155556 768h512"/>
                                        <path d="M893.155556 796.444444h-512c-17.066667 0-28.444444-11.377778-28.444445-28.444444s11.377778-28.444444 28.444445-28.444444h512c17.066667 0 28.444444 11.377778 28.444444 28.444444s-17.066667 28.444444-28.444444 28.444444z"/>
                                    </svg>
                                </button>
                            }
                            <button class="jg-rowbtn" data-tip="备注/重命名"
                                    @onclick:stopPropagation @onclick="() => OpenRemark(m)">
                                <img class="jg-rowbtn-icon" src="assets/actions/rename.svg" alt="" draggable="false" />
                            </button>
                            <button class="jg-rowbtn" data-tip="打开文件所在位置"
                                    @onclick:stopPropagation @onclick="() => OpenFolder(m)">
                                <img class="jg-rowbtn-icon" src="assets/actions/folder.svg" alt="" draggable="false" />
                            </button>
                            @if (m.Disabled)
                            {
                                <button class="jg-rowbtn" data-tip="启用"
                                        @onclick:stopPropagation @onclick="() => SetDisabled(m, false)">
                                    <img class="jg-rowbtn-icon" src="assets/actions/enable.svg" alt="" draggable="false" />
                                </button>
                            }
                            else
                            {
                                <button class="jg-rowbtn" data-tip="禁用"
                                        @onclick:stopPropagation @onclick="() => SetDisabled(m, true)">
                                    <img class="jg-rowbtn-icon" src="assets/actions/disable.svg" alt="" draggable="false" />
                                </button>
                            }
                            <button class="jg-rowbtn danger" data-tip="删除"
                                    @onclick:stopPropagation @onclick="() => _pendingDeleteMod = m">
                                <img class="jg-rowbtn-icon" src="assets/actions/delete.svg" alt="" draggable="false" />
                            </button>
                        </div>
                    </div>
                }
            }
        }

        @if (FilteredMods.Count == 0)
        {
            <div class="jg-card" style="margin-top:4px">没有符合条件的 mod（试试清空搜索 / 切换过滤）。</div>
        }
    </div>
</div>

@* ── 批量操作悬浮条（左键多选后出现）── *@
@if (_selected.Count > 0)
{
    @* v0.42.0：纯图标按钮（SVG 文件）+ 胶囊提示（data-tip，禁用按钮也有）+ 全选在最前 *@
    var anyUpdatable = _selected.Any(f => _mods.FirstOrDefault(m => m.Folder == f) is { } mm && IsUpdatable(mm));
    var anyDisabled  = _selected.Any(f => _mods.FirstOrDefault(m => m.Folder == f)?.Disabled == true);
    var anyEnabled   = _selected.Any(f => _mods.FirstOrDefault(m => m.Folder == f)?.Disabled == false);
    <div class="jg-batchbar-anchor">
    <div class="jg-batchbar">
        <span class="jg-batchbar-count">已选择 @_selected.Count 个</span>
        <button class="jg-mini-btn jg-ico" data-tip="全选" @onclick="SelectAll">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 5.5h4M4 12h4M4 18.5h4"/>
                <path d="M10 4.5l1.8 1.8L15.5 2.6"/>
                <path d="M10 11l1.8 1.8 3.7-3.7"/>
                <path d="M10 17.5l1.8 1.8 3.7-3.7"/>
            </svg>
        </button>
        <button class="jg-mini-btn jg-ico" data-tip="批量更新" disabled="@(_selected.Count == 0 || !anyUpdatable)" @onclick="BatchUpdate">
            <img src="assets/actions/batch-update.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip="启用" disabled="@(!anyDisabled)" @onclick="() => BatchSetDisabled(false)">
            <img src="assets/actions/enable.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip="禁用" disabled="@(!anyEnabled)" @onclick="() => BatchSetDisabled(true)">
            <img src="assets/actions/disable.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn danger-outline jg-ico" data-tip="删除" @onclick="() => _pendingBatchDelete = true">
            <img src="assets/actions/delete.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip="取消选择" @onclick="ClearSelection">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18"/>
            </svg>
        </button>
    </div>
</div>
}

@* ── 备注/重命名弹窗（给 mod 起中文备注，列表里显示成 备注(原名)）── *@
@if (_remarkFolder is not null)
{
    <div class="jg-dlg-overlay" @onclick:stopPropagation>
        <div class="jg-dialog jg-remark-dialog">
            <div class="jg-remark-title">给这个 mod 起备注</div>
            <div class="jg-remark-mod">@(_remarkOriginal)</div>
            <input class="jg-remark-input" maxlength="20" placeholder="输入备注（最多 20 字，留空则清除）"
                   @bind=" _remarkInput" @bind:event="oninput" @onkeydown="OnRemarkKeydown"
                   autofocus />
            <div class="jg-remark-count">@_remarkInput.Length / 20</div>
            <div class="jg-dialog-actions">
                <button class="jg-btn" @onclick="CancelRemark">取消</button>
                <button class="jg-btn primary" @onclick="SaveRemark">保存</button>
            </div>
        </div>
    </div>
}

    @if (_profileOpen)
    {
        @* v0.71.6：存档下拉打开时铺透明遮罩，点"除下拉框本身以外"的地方收回。
           存档 dd z-index:9500 高于遮罩 9000，点菜单本身不会误触发。 *@
        <div class="jg-dd-overlay" @onclick="CloseProfile"></div>
    }

    @* v0.46.0：删除存档确认对话框 *@
    @if (_deletingProfile is not null)
    {
        <div class="jg-modal-overlay" @onclick="CancelDeleteProfile">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">删除存档</div>
                <div class="jg-modal-body">确定删除「@_deletingProfile」存档吗？（仅删除 mod 存档，对游戏内的存档无影响）</div>
                <div class="jg-modal-actions">
                    <button class="jg-mini-btn" @onclick="CancelDeleteProfile">取消</button>
                    <button class="jg-mini-btn danger" @onclick="ConfirmDeleteProfile">删除</button>
                </div>
            </div>
        </div>
    }

    @* 删除 mod 确认对话框（单个 / 批量共用，替代旧的行内二段式确认） *@
    @if (_pendingDeleteMod is not null || _pendingBatchDelete)
    {
        <div class="jg-modal-overlay" @onclick="CancelDeleteMods">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">删除 mod</div>
                <div class="jg-modal-body">确定删除所选mod？</div>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" @onclick="CancelDeleteMods">取消</button>
                    <button type="button" class="jg-pill-danger" @onclick="ConfirmDeleteMods">确定删除</button>
                </div>
            </div>
        </div>
    }

@code {
    private IReadOnlyList<ModEntry> _mods = Array.Empty<ModEntry>();
    // v0.59.0：首次进入页面的 shimmer 加载态
    private bool _initialLoading = true;
    // v0.60.0：更新检查期间的 shimmer 加载态
    private bool _checkingUpdates = false;
    private string _apiKey = "";
    private string? _smapiVersion;
    private string? _smapiIcon;
    private SmapiUpdateInfo? _smapiUpdate;
    private bool _smapiUpdating;
    private long _checkingTick;
    private ModEntry? _pendingDeleteMod;   // 待确认删除的单个 mod（弹窗确认后真正卸载）
    private bool _pendingBatchDelete;      // 待确认的批量删除（弹窗确认后真正卸载）
    private bool _coversDirty;

    // ---- 备注/重命名弹窗 ----
    private string? _remarkFolder;      // null = 弹窗关闭；否则为当前编辑备注的 mod Folder
    private string _remarkOriginal = "";
    private string _remarkInput = "";

    // ---- 过滤 / 分组 / 依赖缺失 ----
    private string _filter = "all";
    private string SearchText { get; set; } = "";

    // v0.32.0：排序（alpha 首字母 / time-desc 时间倒序 / time-asc 时间正序）+ 下拉/搜索展开状态
    private string _sortMode = "time-asc";
    private bool _sortOpen;
    private bool _searchOpen;

    // ── v0.46.0：存档（Profile）系统，仿 Stardrop ──
    private bool _profileOpen;
    private string? _renamingProfile;
    private string _renameBuffer = "";

    /// <summary>v0.71.1：双击开启重命名。</summary>
    private void StartRenameProfile(string name)
    {
        _renamingProfile = name;
        _renameBuffer = name;
        // v1.08：改名时收起存档下拉 —— 输入框+确定按钮已经独立成头，下拉继续开着
        // 只会挡视线，还允许同时点别的存档项，状态容易乱。
        if (_profileOpen)
        {
            _profileOpen = false;
            _ = JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false);
        }
    }

    private void OnRenameKey(KeyboardEventArgs e, string oldName)
    {
        if (e.Key == "Enter") _ = ConfirmRename(oldName);
        else if (e.Key == "Escape") { _renamingProfile = null; _renameBuffer = ""; }
    }

    private async Task ConfirmRename(string oldName)
    {
        var newName = _renameBuffer.Trim();
        _renamingProfile = null;
        _renameBuffer = "";
        if (string.IsNullOrEmpty(newName) || newName == oldName) return;
        if (AllProfiles.Any(p => p.Name == newName))
        {
            ShowNotice("err", "已存在同名存档：" + newName);
            return;
        }
        try
        {
            var p = Cfg.Current.ModProfiles.FirstOrDefault(x => x.Name == oldName);
            if (p is not null) p.Name = newName;
            if (Cfg.Current.ActiveProfile == oldName) Cfg.Current.ActiveProfile = newName;
            Cfg.Save(Cfg.Current);
            ShowNotice("ok", $"已重命名为「{newName}」");
        }
        catch (Exception ex) { ShowNotice("err", "重命名失败：" + ex.Message); }
    }

    /// <summary>v0.71.1：点存档切换后保持下拉框打开（方便连续切换对比）。</summary>
    private async Task ApplyProfileKeepOpen(string name)
    {
        await ApplyProfile(name);
        // 不关 _profileOpen —— 用户可能想连续切几个存档
    }

    private bool _addingProfile;
    private string _newProfileName = "";
    private string? _deletingProfile;

    private List<ModProfile> AllProfiles
    {
        get
        {
            var list = Cfg.Current.ModProfiles;
            // v1.08：按名字（忽略大小写）去重 —— 历史 bug 曾写入重名档（如两个"默认"、
            // 空壳"Default"）。同名保留第一个；若已有的空壳而后来的有启用清单，则用后者替换。
            var deduped = new List<ModProfile>();
            foreach (var p in list)
            {
                var same = deduped.FirstOrDefault(x => x.Name.Equals(p.Name, StringComparison.OrdinalIgnoreCase));
                if (same is null) { deduped.Add(p); continue; }
                if ((same.EnabledModUids?.Count ?? 0) == 0 && (p.EnabledModUids?.Count ?? 0) > 0)
                    deduped[deduped.IndexOf(same)] = p;
            }
            if (deduped.Count == 0 || deduped[0].Name != "默认")
                deduped.Insert(0, new ModProfile { Name = "默认" });
            if (deduped.Count != list.Count)
                Cfg.Current.ModProfiles = deduped;   // 去重结果同步回配置，下次落盘即修复
            return deduped;
        }
    }

    private string ActiveProfileName =>
        string.IsNullOrWhiteSpace(Cfg.Current.ActiveProfile) ? "默认" : Cfg.Current.ActiveProfile;

    /// <summary>把当前启用集合写回 ActiveProfile（"默认"档是运行时视图，不参与持久化）。</summary>
    private void PersistCurrentToActive()
    {
        var active = ActiveProfileName;
        // v0.71.4："默认"存档同样快照 —— 旧版直接 return，"默认"的启用清单永远停在旧状态，
        // 切出去再切回来会被"还原"成陈旧清单（用户看到的串档另一根因）。
        var p = Cfg.Current.ModProfiles.FirstOrDefault(x => x.Name.Equals(active, StringComparison.OrdinalIgnoreCase));
        if (p is null) return;
        // v0.50.0：写回前先重扫，确保 _mods 反映磁盘真实状态（否则依赖联动刚改完、
        // _mods 还是旧的，写回的是陈旧数据 → 串档）
        // v0.51.0：Stardrop 式纯净快照——存当前真实启用的全部 mod，不排除联动项
        // （排除联动项反而导致状态不一致，是串档根因）
        p.EnabledModUids = _mods
            .Where(m => !m.Disabled && !string.IsNullOrWhiteSpace(m.UniqueID))
            .Select(m => m.UniqueID)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }



    private async Task ToggleProfile()
    {
        if (_deletingProfile is not null) return;   // v1.08：删除确认期间禁开
        _profileOpen = !_profileOpen;
        // v1.08：两个下拉互斥 —— 开存档就关排序
        if (_profileOpen && _sortOpen)
        {
            _sortOpen = false;
            try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-sort-dd", false); } catch { }
        }
        _renamingProfile = null; _renameBuffer = "";   // v0.71.4：开合下拉时退出重命名态
        if (!_profileOpen) { _addingProfile = false; _newProfileName = ""; }
        try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", _profileOpen); } catch { }
    }

    private async Task CloseProfile()
    {
        if (!_profileOpen) return;
        _profileOpen = false;
        _addingProfile = false; _newProfileName = "";
        try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false); } catch { }
    }

    private void StartAddProfile() { _addingProfile = true; _newProfileName = ""; }

    private async Task ConfirmAddProfile()
    {
        var name = _newProfileName.Trim();
        _addingProfile = false;
        _newProfileName = "";
        if (string.IsNullOrWhiteSpace(name)) return;
        if (AllProfiles.Any(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            ShowNotice("err", "已存在同名存档：" + name);
            return;
        }
        // v0.49.0：先把当前启用状态写回旧存档，防止切档后串档
        PersistCurrentToActive();
        // 新存档以当前启用状态为快照（仿 Stardrop：新建 = 记录此刻启用的 mod）
        var p = new ModProfile
        {
            Name = name,
            EnabledModUids = _mods.Where(m => !m.Disabled && !string.IsNullOrWhiteSpace(m.UniqueID))
                                  .Select(m => m.UniqueID).ToList()
        };
        Cfg.Current.ModProfiles.Add(p);
        Cfg.Current.ActiveProfile = name;
        Cfg.Save(Cfg.Current);
        _profileOpen = false;
        // v0.49.0：显式关闭 JS 下拉动画状态，修"创建后下拉失效"
        try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false); } catch { }
        ShowNotice("ok", $"已创建存档「{name}」");
    }

    private void AskDeleteProfile(string name)
    {
        _deletingProfile = name;
        // v1.08：弹删除确认框时把排序下拉也一并收起
        if (_sortOpen)
        {
            _sortOpen = false;
            _ = JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-sort-dd", false);
        }
        if (_profileOpen)
        {
            _profileOpen = false;
            _ = JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false);
        }
    }
    private void CancelDeleteProfile() => _deletingProfile = null;

    private async Task ConfirmDeleteProfile()
    {
        var name = _deletingProfile;
        _deletingProfile = null;
        if (name is null) return;
        var wasActive = ActiveProfileName == name;
        Cfg.Current.ModProfiles.RemoveAll(p => p.Name == name);
        if (wasActive)
        {
            // v0.71.4：不要先设 ActiveProfile 再调 ApplyProfile —— 旧顺序会让 ApplyProfile 里
            // name == ActiveProfileName 直接 return，磁盘 mod 状态根本没切回默认（删除后"默认"
            // 显示成被删存档的状态就是这个根因）。此时旧存档已从列表移除，ApplyProfile 内的
            // PersistCurrentToActive 找不到它 → 不会误写，切完由 ApplyProfile 自己置 ActiveProfile。
            await ApplyProfile("默认");
        }
        Cfg.Save(Cfg.Current);
        ShowNotice("ok", $"已删除存档「{name}」");
    }

    /// <summary>切换存档：按存档记录的 UniqueID 集合批量启禁（含依赖联动），其他全部禁用。</summary>
    private async Task ApplyProfile(string name)
    {
        if (name == ActiveProfileName) return;
        // v0.50.0：写回前先 Rescan 拿磁盘真实状态，防止写陈旧数据 → 串档
        Rescan();
        PersistCurrentToActive();
        var profile = AllProfiles.FirstOrDefault(p => p.Name == name);
        if (profile is null) return;

        var wantEnabled = new HashSet<string>(profile.EnabledModUids, StringComparer.OrdinalIgnoreCase);
        // 依赖联动：要启用的 mod 的依赖也要跟着启用（递归闭包）
        ExpandWithDependencies(wantEnabled);

        // v0.72.8：按"顶层物理目录"去重收集操作 —— 多分包 mod（如 Weather Wonders - Beta
        // 下的 [CS]/[DLL]/[FTM]）的多个子条目共享同一顶层目录，旧版按子条目各 Move 一次，
        // 第一条改名成功后后续条目必然"找不到 Mod 文件夹"。现在每个顶层目录只 Move 一次。
        var topOps = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);  // topLevel → disable
        foreach (var m in _mods)
        {
            var uid = m.UniqueID;
            var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
            if (m.Disabled == !shouldEnable)
                continue;
            var top = m.Folder.Split('/')[0];
            topOps.TryAdd(top, !shouldEnable);
        }

        if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = false;
        try
        {
            var gamePath = Cfg.Current.GamePath;
            // v0.72.8：结构化错误结果，不再用字符串 Split(':') 反解析（文件夹名含 ':' 会截断）
            var errs = await Task.Run(() =>
            {
                var list = new List<(string Folder, string Error)>();
                foreach (var (top, disable) in topOps)
                {
                    var err = ModSvc.SetDisabled(gamePath, top, disable);
                    if (err is not null) list.Add((top, err));
                }
                return list;
            });
            foreach (var (folder, err) in errs)
                AppLog.Warn("Mods", $"存档切换失败：{folder} - {err}");

            // 增量更新内存状态：按子条目统一更新 Disabled + Folder + 缓存迁移
            var errTops = new HashSet<string>(errs.Select(e => e.Folder), StringComparer.OrdinalIgnoreCase);
            foreach (var m in _mods)
            {
                var uid = m.UniqueID;
                var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
                if (m.Disabled == !shouldEnable) continue;
                var top = m.Folder.Split('/')[0];
                if (errTops.Contains(top)) continue;   // 该顶层目录改名失败，跳过其所有子条目
                var disable = !shouldEnable;
                var newFolder = disable
                    ? (m.Folder.StartsWith('.') ? m.Folder : "." + m.Folder)
                    : m.Folder.TrimStart('.');
                if (newFolder != m.Folder)
                {
                    MigrateFolderCaches(m.Folder, disable);
                    m.Folder = newFolder;
                }
                m.Disabled = disable;
            }
        }
        finally
        {
            if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = true;
        }

        Cfg.Current.ActiveProfile = name;
        Cfg.Save(Cfg.Current);
        ShowNotice("ok", $"已切换到存档「{name}」");
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>把要启用的集合按依赖闭包扩展：A 依赖 B，则启用 A 必须启用 B（递归）。</summary>
    private void ExpandWithDependencies(HashSet<string> uids)
    {
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var queue = new Queue<string>(uids);
        while (queue.Count > 0)
        {
            var cur = queue.Dequeue();
            if (!byUid.TryGetValue(cur, out var mod)) continue;
            foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
            {
                if (!string.IsNullOrWhiteSpace(dep) && uids.Add(dep))
                    queue.Enqueue(dep);   // 新加入的依赖自己可能还有依赖
            }
        }
    }

    /// <summary>禁用某 mod 时，把"依赖它的已启用 mod"也一并禁用（递归）——Stardrop 同款联动。</summary>
    private void DisableDependents(string uniqueId, HashSet<string> visited, Action<ModEntry> disableOne)
    {
        if (string.IsNullOrWhiteSpace(uniqueId) || !visited.Add(uniqueId)) return;
        foreach (var m in _mods)
        {
            if (m.Disabled || string.IsNullOrWhiteSpace(m.UniqueID)) continue;
            if (m.Dependencies.Concat(m.ContentPackIds)
                   .Any(d => d.Equals(uniqueId, StringComparison.OrdinalIgnoreCase)))
            {
                disableOne(m);
                DisableDependents(m.UniqueID, visited, disableOne);
            }
        }
    }

    /// <summary>启用某 mod 时，把它依赖的已禁用 mod 一并启用（递归）。</summary>
    private void EnableDependencies(ModEntry mod, HashSet<string> visited, Action<ModEntry> enableOne)
    {
        if (string.IsNullOrWhiteSpace(mod.UniqueID) || !visited.Add(mod.UniqueID)) return;
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
        {
            if (string.IsNullOrWhiteSpace(dep) || !byUid.TryGetValue(dep, out var depMod)) continue;
            if (depMod.Disabled)
            {
                enableOne(depMod);
                EnableDependencies(depMod, visited, enableOne);
            }
        }
    }

    /// <summary>官网分类（Nexus 官方分类名，缓存于 config）。无缓存则回退 manifest 分类。</summary>
    private string? GetNexusCategory(ModEntry m)
    {
        // 已缓存的官方分类名
        if (Cfg.Current.ModCategories.TryGetValue(m.Folder, out var name)) return name;
        var norm = m.Folder.Split('/'); norm[0] = norm[0].TrimStart('.');
        var key = string.Join('/', norm);
        if (key != m.Folder && Cfg.Current.ModCategories.TryGetValue(key, out name)) return name;
        // 有 category_id 但没缓存名称表 → 等 EnsureCategoriesAsync 拉取
        var st = GetState(m.Folder);
        if (st.CategoryId is int cid && Cfg.Current.NexusCategories.TryGetValue(cid, out name))
            return name;
        // 兜底：manifest 粗分类
        return string.IsNullOrEmpty(m.Category) ? null : m.Category;
    }

    /// <summary>分类表为空且有 API Key → 拉一次官方分类表并缓存。</summary>
    private async Task EnsureCategoriesAsync()
    {
        if (Cfg.Current.NexusCategories.Count > 0 || string.IsNullOrWhiteSpace(_apiKey)) return;
        try
        {
            var cats = await Nexus.GetCategoriesAsync(_apiKey);
            if (cats is { Count: > 0 })
            {
                Cfg.Current.NexusCategories = cats;
                Cfg.Save(Cfg.Current);
            }
        }
        catch (Exception ex) { AppLog.Warn("Mods", "分类表拉取失败: " + ex.Message); }
    }

    private string SortLabel => _sortMode switch
    {
        "time-desc" => "最早在前",
        "time-asc"  => "最新在前",
        _           => "首字母",

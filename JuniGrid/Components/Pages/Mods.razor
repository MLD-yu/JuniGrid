    /// <summary>切换存档：按存档记录的 UniqueID 集合批量启禁（含依赖联动），其他全部禁用。</summary>
    private async Task ApplyProfile(string name)
    {
        if (name == ActiveProfileName) return;
        var __tAll = System.Diagnostics.Stopwatch.GetTimestamp();
        // v0.50.0：写回前先 Rescan 拿磁盘真实状态，防止写陈旧数据 → 串档。
        // v1.1.8：判重清理+全盘扫描挪后台 —— 同步跑会在 UI 线程冻住整窗（几百 mod 秒级）。
        var __t = System.Diagnostics.Stopwatch.GetTimestamp();
        var scanned = await Task.Run(() =>
        {
            try { ModSvc.CleanupDuplicateCopies(Cfg.Current.GamePath); }
            catch (Exception ex) { AppLog.Warn("Mods", "多副本清理失败: " + ex.Message); }
            return ModSvc.Scan(Cfg.Current.GamePath);
        });
        Rescan(scanned);
        var __rescanMs = ElapsedMs(__t);
        PersistCurrentToActive();
        var profile = AllProfiles.FirstOrDefault(p => p.Name == name);
        if (profile is null) return;

        var wantEnabled = new HashSet<string>(profile.EnabledModUids, StringComparer.OrdinalIgnoreCase);
        // 依赖联动：要启用的 mod 的依赖也要跟着启用（递归闭包）
        ExpandWithDependencies(wantEnabled);

        // v0.72.8：按"顶层物理目录"去重收集操作 —— 多分包 mod（如 Weather Wonders - Beta
        // 下的 [CS]/[DLL]/[FTM]）的多个子条目共享同一顶层目录，旧版按子条目各 Move 一次，
        // 第一条改名成功后后续条目必然"找不到 Mod 文件夹"。现在每个顶层目录只 Move 一次。
        var topOps = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);  // topLevel → disable
        foreach (var m in _mods)
        {
            var uid = m.UniqueID;
            var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
            if (m.Disabled == !shouldEnable)
                continue;
            var top = m.Folder.Split('/')[0];
            topOps.TryAdd(top, !shouldEnable);
        }

        if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = false;
        try
        {
            var gamePath = Cfg.Current.GamePath;
            // v0.72.8：结构化错误结果，不再用字符串 Split(':') 反解析（文件夹名含 ':' 会截断）
            // v1.1.8：顶层目录互不依赖，并行改名 —— 启用集合差得越多顶层越多，
            // 串行 + 占用重试 Sleep 会把切档拖成分钟级。
            __t = System.Diagnostics.Stopwatch.GetTimestamp();
            var errs = await Task.Run(() =>
            {
                var bag = new System.Collections.Concurrent.ConcurrentBag<(string Folder, string Error)>();
                if (topOps.Count > 0)
                {
                    var dop = Math.Clamp(topOps.Count, 2, 8);
                    Parallel.ForEach(topOps,
                        new ParallelOptions { MaxDegreeOfParallelism = dop },
                        kv =>
                        {
                            var err = ModSvc.SetDisabled(gamePath, kv.Key, kv.Value);
                            if (err is not null) bag.Add((kv.Key, err));
                        });
                }
                return bag.ToList();
            });
            var __renameMs = ElapsedMs(__t);
            foreach (var (folder, err) in errs)
                AppLog.Warn("Mods", $"存档切换失败：{folder} - {err}");

            // 增量更新内存状态：按子条目统一更新 Disabled + Folder + 缓存迁移。
            // persist:false —— 整轮只在末尾 Cfg.Save 一次，避免每条迁移都广播 Saved
            // （AccountPanel.ProbeVersions 会对 exe 做 FileVersionInfo，N 条就探 N 次）。
            __t = System.Diagnostics.Stopwatch.GetTimestamp();
            var errTops = new HashSet<string>(errs.Select(e => e.Folder), StringComparer.OrdinalIgnoreCase);
            foreach (var m in _mods)
            {
                var uid = m.UniqueID;
                var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
                if (m.Disabled == !shouldEnable) continue;
                var top = m.Folder.Split('/')[0];
                if (errTops.Contains(top)) continue;   // 该顶层目录改名失败，跳过其所有子条目
                var disable = !shouldEnable;
                // 切存档是整个顶层改名（Top/Sub → .Top/Sub），不是子包级末段改名
                var newFolder = disable
                    ? (m.Folder.StartsWith('.') ? m.Folder : "." + m.Folder)
                    : m.Folder.TrimStart('.');
                MigrateFolderCaches(m.Folder, newFolder, persist: false);   // 内部把条目 folder 一并改掉
                m.Disabled = disable;
            }
            var __migrateMs = ElapsedMs(__t);
            ModsPerf($"切档「{name}」 {topOps.Count} 个顶层",
                ("写回前重扫", __rescanMs), ("并行改名", __renameMs), ("缓存迁移", __migrateMs));
        }
        finally
        {
            if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = true;
        }

        SetActiveProfileName(name);
        Cfg.Save(Cfg.Current);
        ShowNotice("ok", LocService.Tf("已切换到存档「{0}」", name));
        ModsPerf("　↳ 切档收尾", ("合计", ElapsedMs(__tAll) - __rescanMs));
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>把要启用的集合按依赖闭包扩展：A 依赖 B，则启用 A 必须启用 B（递归）。</summary>
    private void ExpandWithDependencies(HashSet<string> uids)
    {
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var queue = new Queue<string>(uids);
        while (queue.Count > 0)
        {
            var cur = queue.Dequeue();
            if (!byUid.TryGetValue(cur, out var mod)) continue;
            foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
            {
                if (!string.IsNullOrWhiteSpace(dep) && uids.Add(dep))
                    queue.Enqueue(dep);   // 新加入的依赖自己可能还有依赖
            }
        }
    }

    /// <summary>禁用某 mod 时，把"依赖它的已启用 mod"也一并禁用（递归）——Stardrop 同款联动。</summary>
    private void DisableDependents(string uniqueId, HashSet<string> visited, Action<ModEntry> disableOne)
    {
        if (string.IsNullOrWhiteSpace(uniqueId) || !visited.Add(uniqueId)) return;
        foreach (var m in _mods)
        {
            if (m.Disabled || string.IsNullOrWhiteSpace(m.UniqueID)) continue;
            if (m.Dependencies.Concat(m.ContentPackIds)
                   .Any(d => d.Equals(uniqueId, StringComparison.OrdinalIgnoreCase)))
            {
                disableOne(m);
                DisableDependents(m.UniqueID, visited, disableOne);
            }
        }
    }

    /// <summary>启用某 mod 时，把它依赖的已禁用 mod 一并启用（递归）。</summary>
    private void EnableDependencies(ModEntry mod, HashSet<string> visited, Action<ModEntry> enableOne)
    {
        if (string.IsNullOrWhiteSpace(mod.UniqueID) || !visited.Add(mod.UniqueID)) return;
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
        {
            if (string.IsNullOrWhiteSpace(dep) || !byUid.TryGetValue(dep, out var depMod)) continue;
            if (depMod.Disabled)
            {
                enableOne(depMod);
                EnableDependencies(depMod, visited, enableOne);
            }
        }
    }

    /// <summary>官网分类（Nexus 官方分类名，缓存于 config）。无缓存则回退 manifest 分类。</summary>
    private string? GetNexusCategory(ModEntry m)
    {
        // 已缓存的官方分类名
        if (Cfg.Current.ModCategories.TryGetValue(m.Folder, out var name)) return name;
        var norm = m.Folder.Split('/'); norm[0] = norm[0].TrimStart('.');
        var key = string.Join('/', norm);
        if (key != m.Folder && Cfg.Current.ModCategories.TryGetValue(key, out name)) return name;
        // 有 category_id 但没缓存名称表 → 等 EnsureCategoriesAsync 拉取
        var st = GetState(m.Folder);
        if (st.CategoryId is int cid && Cfg.Current.NexusCategories.TryGetValue(cid, out name))
            return name;
        // 兜底：manifest 粗分类
        return string.IsNullOrEmpty(m.Category) ? null : m.Category;
    }

    /// <summary>分类表为空且有 API Key → 拉一次官方分类表并缓存。</summary>
    private async Task EnsureCategoriesAsync()
    {
        if (Cfg.Current.NexusCategories.Count > 0 || !NexusService.IsAuthenticated) return;
        try
        {
            var cats = await Nexus.GetCategoriesAsync();
            if (cats is { Count: > 0 })
            {
                Cfg.Current.NexusCategories = cats;
                Cfg.Save(Cfg.Current);
            }
        }
        catch (Exception ex) { AppLog.Warn("Mods", "分类表拉取失败: " + ex.Message); }
    }

    /// <summary>这个 mod 的官网分类是不是已经能显示了 —— 与 GetNexusCategory 的前两档同口径
    /// （含禁用行的 "." 前缀变体），否则回填会每次都把已解决的行重查一遍。</summary>
    private bool HasCachedCategory(string folder)
    {
        if (Cfg.Current.ModCategories.ContainsKey(folder)) return true;
        var norm = folder.Split('/'); norm[0] = norm[0].TrimStart('.');
        var key = string.Join('/', norm);
        return key != folder && Cfg.Current.ModCategories.ContainsKey(key);
    }

    private int _catBackfillRunning;

    /// <summary>官网分类回填。刻意和 BackfillCoversAsync 分开：封面只在【缺封面】时才发请求，
    /// 而分类要覆盖所有带 NexusModId 的行。实测 119 个 mod 只有 3 个有分类 —— 因为旧路径下分类是
    /// 封面回填的副产品（still 集合），封面缓存齐了就永远轮不到。</summary>
    private async Task BackfillCategoriesAsync()
    {
        if (Interlocked.Exchange(ref _catBackfillRunning, 1) == 1) return;
        try
        {
            await EnsureCategoriesAsync();
            if (Cfg.Current.NexusCategories.Count == 0) return;   // 分类表还没拉到，下次再说
            var tried = new HashSet<string>(Cfg.Current.ModCategoryTried, StringComparer.OrdinalIgnoreCase);
            var need = _mods
                .Where(m => m.NexusModId is not null && !HasCachedCategory(m.Folder) && !tried.Contains(m.Folder))
                .ToList();
            if (need.Count == 0) return;

            var markFrom = Cfg.Current.ModCategoryTried.Count;
            var found = 0;
            var semaphore = new SemaphoreSlim(2);
            await Task.WhenAll(need.Select(async m =>
            {
                if (Leave.IsCancellationRequested) return;   // 已离开本页 ⇒ 分类回填不占下一屏的槽
                await semaphore.WaitAsync();
                try
                {
                    var info = await Nexus.GetModAsync(m.NexusModId!.Value);
                    if (info?.CategoryId is int cid && Cfg.Current.NexusCategories.TryGetValue(cid, out var cname))
                    {
                        Cfg.Current.ModCategories[m.Folder] = cname;
                        found++;
                    }
                    else
                        Cfg.Current.ModCategoryTried.Add(m.Folder);   // 官网确实没给分类，或这行查不动
                }
                catch (Exception ex)
                {
                    AppLog.Warn("Mods", "分类回填失败(" + m.Folder + "): " + ex.Message);
                    Cfg.Current.ModCategoryTried.Add(m.Folder);
                }
                finally { semaphore.Release(); }
            }));

            // 整批几乎全空 = 大概率是被限流/Key 失效，不是这些 mod 真没分类。
            // 这时把刚记下的 tried 撤回去，下次进页面还能重试；否则一次 403 就把全部行永久判死。
            if (found <= 1 && need.Count > 8)
            {
                Cfg.Current.ModCategoryTried.RemoveRange(markFrom, Cfg.Current.ModCategoryTried.Count - markFrom);
                AppLog.Warn("Mods", $"分类回填：{need.Count} 个只命中 {found} 个，判为整体失败，不记已试过");
                return;
            }

            AppLog.Warn("Mods", $"分类回填：查 {need.Count} 个，命中 {found} 个，累计已试过 {Cfg.Current.ModCategoryTried.Count} 个");
            Cfg.Save(Cfg.Current);
            await InvokeAsync(StateHasChanged);
        }
        finally { Interlocked.Exchange(ref _catBackfillRunning, 0); }
    }


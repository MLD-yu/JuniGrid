    private void AskRestoreTrash(List<TrashItem> picked)
    {
        if (picked.Count == 0) return;
        var conflicting = picked.FirstOrDefault(x => x.AlsoInMods);
        if (conflicting is not null)
        {
            _pendingRestore = picked;
            _pendingRestoreName = conflicting.DisplayName;
            return;
        }
        _ = DoRestoreAsync(picked, overwrite: false);
    }

    private void CancelRestoreTrash() => _pendingRestore = null;

    private void ConfirmRestoreTrash()
    {
        var picked = _pendingRestore;
        _pendingRestore = null;
        if (picked is not null) _ = DoRestoreAsync(picked, overwrite: true);
    }

    private async Task DoRestoreAsync(List<TrashItem> picked, bool overwrite)
    {
        var game = Cfg.Current.GamePath;
        if (string.IsNullOrWhiteSpace(game)) return;
        // v1.3.15：还原也是"把整棵目录搬回 Mods"的重活，几个大包就是几秒的
        // Directory.Move —— 站在渲染线程上同样会冻界面。整段丢线程池。
        var failed = await Task.Run(() =>
        {
            var bad = 0;
            foreach (var it in picked)
            {
                var err = TrashService.Restore(game, it, null, overwrite);
                if (err is not null) { bad++; AppLog.Warn("Trash", err); }
            }
            return bad;
        });
        if (failed > 0) AppLog.Warn("Trash", $"[还原] {failed} 份失败");
        _trashSelected.Clear();
        LoadTrash(forceRefresh: true);
        RefreshAfterTrashChange();
    }


    /// <summary>切换存档：按存档记录的 UniqueID 集合批量启禁（含依赖联动），其他全部禁用。</summary>
    private async Task ApplyProfile(string name)
    {
        if (name == ActiveProfileName) return;
        // v0.50.0：写回前先 Rescan 拿磁盘真实状态，防止写陈旧数据 → 串档
        Rescan();
        PersistCurrentToActive();
        var profile = AllProfiles.FirstOrDefault(p => p.Name == name);
        if (profile is null) return;

        var wantEnabled = new HashSet<string>(profile.EnabledModUids, StringComparer.OrdinalIgnoreCase);
        // 依赖联动：要启用的 mod 的依赖也要跟着启用（递归闭包）
        ExpandWithDependencies(wantEnabled);

        // v0.72.8：按"顶层物理目录"去重收集操作 —— 多分包 mod（如 Weather Wonders - Beta
        // 下的 [CS]/[DLL]/[FTM]）的多个子条目共享同一顶层目录，旧版按子条目各 Move 一次，
        // 第一条改名成功后后续条目必然"找不到 Mod 文件夹"。现在每个顶层目录只 Move 一次。
        var topOps = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);  // topLevel → disable
        foreach (var m in _mods)
        {
            var uid = m.UniqueID;
            var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
            if (m.Disabled == !shouldEnable)
                continue;
            var top = m.Folder.Split('/')[0];
            topOps.TryAdd(top, !shouldEnable);
        }

        if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = false;
        try
        {
            var gamePath = Cfg.Current.GamePath;
            // v0.72.8：结构化错误结果，不再用字符串 Split(':') 反解析（文件夹名含 ':' 会截断）
            var errs = await Task.Run(() =>
            {
                var list = new List<(string Folder, string Error)>();
                foreach (var (top, disable) in topOps)
                {
                    var err = ModSvc.SetDisabled(gamePath, top, disable);
                    if (err is not null) list.Add((top, err));
                }
                return list;
            });
            foreach (var (folder, err) in errs)
                AppLog.Warn("Mods", $"存档切换失败：{folder} - {err}");

            // 增量更新内存状态：按子条目统一更新 Disabled + Folder + 缓存迁移
            var errTops = new HashSet<string>(errs.Select(e => e.Folder), StringComparer.OrdinalIgnoreCase);
            foreach (var m in _mods)
            {
                var uid = m.UniqueID;
                var shouldEnable = !string.IsNullOrWhiteSpace(uid) && wantEnabled.Contains(uid);
                if (m.Disabled == !shouldEnable) continue;
                var top = m.Folder.Split('/')[0];
                if (errTops.Contains(top)) continue;   // 该顶层目录改名失败，跳过其所有子条目
                var disable = !shouldEnable;
                // 切存档是整个顶层改名（Top/Sub → .Top/Sub），不是子包级末段改名
                var newFolder = disable
                    ? (m.Folder.StartsWith('.') ? m.Folder : "." + m.Folder)
                    : m.Folder.TrimStart('.');
                MigrateFolderCaches(m.Folder, newFolder);   // 内部把条目 folder 一并改掉
                m.Disabled = disable;
            }
        }
        finally
        {
            if (_modsWatcher is not null) _modsWatcher.EnableRaisingEvents = true;
        }

        SetActiveProfileName(name);
        Cfg.Save(Cfg.Current);
        ShowNotice("ok", $"已切换到存档「{name}」");
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>把要启用的集合按依赖闭包扩展：A 依赖 B，则启用 A 必须启用 B（递归）。</summary>
    private void ExpandWithDependencies(HashSet<string> uids)
    {
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var queue = new Queue<string>(uids);
        while (queue.Count > 0)
        {
            var cur = queue.Dequeue();
            if (!byUid.TryGetValue(cur, out var mod)) continue;
            foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
            {
                if (!string.IsNullOrWhiteSpace(dep) && uids.Add(dep))
                    queue.Enqueue(dep);   // 新加入的依赖自己可能还有依赖
            }
        }
    }

    /// <summary>禁用某 mod 时，把"依赖它的已启用 mod"也一并禁用（递归）——Stardrop 同款联动。</summary>
    private void DisableDependents(string uniqueId, HashSet<string> visited, Action<ModEntry> disableOne)
    {
        if (string.IsNullOrWhiteSpace(uniqueId) || !visited.Add(uniqueId)) return;
        foreach (var m in _mods)
        {
            if (m.Disabled || string.IsNullOrWhiteSpace(m.UniqueID)) continue;
            if (m.Dependencies.Concat(m.ContentPackIds)
                   .Any(d => d.Equals(uniqueId, StringComparison.OrdinalIgnoreCase)))
            {
                disableOne(m);
                DisableDependents(m.UniqueID, visited, disableOne);
            }
        }
    }

    /// <summary>启用某 mod 时，把它依赖的已禁用 mod 一并启用（递归）。</summary>
    private void EnableDependencies(ModEntry mod, HashSet<string> visited, Action<ModEntry> enableOne)
    {
        if (string.IsNullOrWhiteSpace(mod.UniqueID) || !visited.Add(mod.UniqueID)) return;
        var byUid = _mods.Where(m => !string.IsNullOrWhiteSpace(m.UniqueID))
                         .GroupBy(m => m.UniqueID, StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        foreach (var dep in mod.Dependencies.Concat(mod.ContentPackIds))
        {
            if (string.IsNullOrWhiteSpace(dep) || !byUid.TryGetValue(dep, out var depMod)) continue;
            if (depMod.Disabled)
            {
                enableOne(depMod);
                EnableDependencies(depMod, visited, enableOne);
            }
        }
    }

    /// <summary>官网分类（Nexus 官方分类名，缓存于 config）。无缓存则回退 manifest 分类。</summary>
    private string? GetNexusCategory(ModEntry m)
    {
        // 已缓存的官方分类名
        if (Cfg.Current.ModCategories.TryGetValue(m.Folder, out var name)) return name;
        var norm = m.Folder.Split('/'); norm[0] = norm[0].TrimStart('.');
        var key = string.Join('/', norm);
        if (key != m.Folder && Cfg.Current.ModCategories.TryGetValue(key, out name)) return name;
        // 有 category_id 但没缓存名称表 → 等 EnsureCategoriesAsync 拉取
        var st = GetState(m.Folder);
        if (st.CategoryId is int cid && Cfg.Current.NexusCategories.TryGetValue(cid, out name))
            return name;
        // 兜底：manifest 粗分类
        return string.IsNullOrEmpty(m.Category) ? null : m.Category;
    }

    /// <summary>分类表为空且有 API Key → 拉一次官方分类表并缓存。</summary>
    private async Task EnsureCategoriesAsync()

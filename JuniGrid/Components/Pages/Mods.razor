    private void OpenRemark(ModEntry m)
    {
        CloseDropdownsForDialog();
        _remarkFolder = m.Folder;
        _remarkOriginal = m.Name;
        Cfg.Current.ModRemarks.TryGetValue(m.Folder, out var cur);
        _remarkInput = cur ?? "";
    }

    private void CancelRemark() => _remarkFolder = null;

    /// <summary>Motion characters-remaining 同款：计数显示「剩余可输入数」（20→0），每次输入弹一下。
    /// 空格不计数也不显示（含全角空格/Tab，输入即被滤掉）；满 20 后 maxlength 挡输入，
    /// 此时再尝试打字（keydown）让 0 放大提醒 —— 见 OnRemarkKeydown。</summary>
    private async Task OnRemarkInput(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        var filtered = v.Replace(" ", "").Replace("\u3000", "").Replace("\t", "");
        _remarkInput = filtered;
        if (filtered != v)
            try { await JS.InvokeVoidAsync("junigridJs.setRemarkValue", filtered); } catch { }
        try { await JS.InvokeVoidAsync("junigridJs.remarkCountBump", filtered.Length >= 20); } catch { }
    }

    private void SaveRemark()
    {
        var folder = _remarkFolder;
        if (folder is not null)
        {
            var text = _remarkInput.Trim();
            if (text.Length > 20) text = text[..20];
            if (text.Length == 0) Cfg.Current.ModRemarks.Remove(folder);
            else Cfg.Current.ModRemarks[folder] = text;
            Cfg.Save(Cfg.Current);
            // v1.1.2：备注同步进 manifest.json —— 游戏内 GMCM 标题用备注名（空备注 = 还原原名）
            var f = folder;
            var r = text;
            _ = Task.Run(() =>
            {
                var err = ModSvc.ApplyRemarkToManifest(Cfg.Current.GamePath, f, r, Cfg.Current.ModOriginalNames);
                if (err is not null)
                    AppLog.Warn("Mods", $"[备注同步] {f}: {err}");
                else
                {
                    // v1.2.5：备注写入成功属正常流程，不再落 WRN 日志
                    // 修复：ApplyRemarkToManifest 会把原名记进 ModOriginalNames（还原时移除），
                    // 但那是本 Task 里的内存改动 —— 上面的 Cfg.Save 早已跑完，之后若没有任何
                    // 别的保存，退出程序原名记录就丢了 → 列表括号里的原名消失（自动化/Automate 的根因）。
                    // 同步成功后立刻补一次落盘，把备注/原名/manifest 三者一起钉住。
                    try { Cfg.Save(Cfg.Current); } catch { }
                }
            });
        }
        _remarkFolder = null;
    }

    private void OnRemarkKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveRemark();
        else if (e.Key == "Escape") CancelRemark();
        // 满 20 后 maxlength 已挡住输入；此时再尝试打字（单字符键）让剩余数「0」放大提醒
        else if (_remarkInput.Length >= 20 && e.Key.Length == 1)
            _ = JS.InvokeVoidAsync("junigridJs.remarkCountBump", true);
    }

    /// <summary>列表显示的 mod 名：有备注则显示成 “备注(原名)”，否则走原名/翻译。
    /// v1.1.4：manifest 已被同步成备注名时（重扫后 m.Name == 备注），直接显示备注，
    /// 原名取自 ModOriginalNames 存档，避免出现"自动化(自动化)"。</summary>
    private string RemarkName(ModEntry m)
    {
        if (Cfg.Current.ModRemarks.TryGetValue(m.Folder, out var remark)
            && !string.IsNullOrWhiteSpace(remark))
        {
            var original = Cfg.Current.ModOriginalNames.TryGetValue(m.Folder, out var o)
                ? o : m.Name;
            if (!string.Equals(original, remark, StringComparison.Ordinal))
                return $"{remark}({original})";
            return remark;
        }
        return m.Name;
    }

    /// <summary>smapi.io 随「建议版本」一起给出的来源页 —— 那一版真正的出处。
    /// 只在有 N 网源、且它指的不是这个 N 网页面时才算外来链接（纯 GitHub 源走系统内直更更省事，
    /// 不能被网页抢走；同一页面开两次也没意义）。实测 Bus Locations：徽标
    /// 1.2.2-unofficial.1-Xytronix，而 N 网 2905 最新文件仍是玩家已装的 1.2.0。</summary>
    private static string? OffsiteUpdateUrl(ModEntry m, ModUpdateState st)
    {
        if (string.IsNullOrWhiteSpace(st.RemoteUrl)) return null;
        if (!st.RemoteUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return null;
        // 纯 GitHub 源：系统内能直更，别让网页抢走这条路
        if (m.NexusModId is null && m.GitHubRepo is not null) return null;
        // 指回同一个 N 网页面时不必重复打开
        if (m.NexusModId is int nid
            && st.RemoteUrl.Contains($"/stardewvalley/mods/{nid}", StringComparison.OrdinalIgnoreCase)) return null;
        return st.RemoteUrl;
    }

    private void OpenUpdatePage(ModEntry m)
    {
        // v0.68.2：N 网源优先 —— 有 Nexus ID 的 mod（含 SDV-辉光这类双源 mod）
        // 免费用户一律跳 N 网文件页手动下载；会员系统内直装（走 N 网直链）。
        // 只有「纯 GitHub 源」（无 N 网源）的 mod 才走系统内 GitHub 更新。
        var isPremium = Cfg.Current.NexusIsPremium;
        var st0 = GetState(m.Folder);
        var offsite = OffsiteUpdateUrl(m, st0);
        if (offsite is not null && !isPremium)
        {
            UpdateService.OpenUrl(offsite);
            ShowNotice("ok", LocService.Tf("已打开 {0} 的来源页 —— N 网原页面没有这一版，", st0.RemoteVersion) +
                LocService.Tr("在页面上找「非官方/续作」那条文件下载"));
            return;
        }
        if ((isPremium && m.NexusModId is not null)
            || (m.NexusModId is null && m.GitHubRepo is not null))
        {
            _ = InvokeAsync(async () =>
            {
                await UpdateOne(m);
                var st = GetState(m.Folder);
                if (st.Status == "updated")
                {
                    ShowNotice("ok", LocService.Tf("已更新 {0} ✔", m.Name));
                    Rescan();
                }
                else if (st.Status == "premium" && m.NexusModId is not null)
                {
                    // 账号实际非会员（403）→ 回退打开官网手动下载
                    UpdateService.OpenUrl(offsite
                        ?? $"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
                    ShowNotice("err", LocService.Tr("当前 Nexus 账号非 Premium，已为你打开下载页"));
                }
                else if (st.Status == "failed")
                {
                    ShowNotice("err", LocService.Tf("更新失败：{0}", st.Message));
                }
                else if (st.Status == "available")
                {
                    // v0.68.1：检测到有新版但系统内下载不可行（如 GitHub release 没挂 zip 附件）
                    // → 回退打开对应下载页（GitHub releases / Nexus 文件页），不再「点了没反应」
                    if (offsite is not null) UpdateService.OpenUrl(offsite);
                    else OpenUpdateDownloadPage(m);
                    ShowNotice("ok", LocService.Tf("已打开 {0} 的下载页，请手动下载 {1}", m.Name, st.RemoteVersion));
                }
                StateHasChanged();
            });
            return;
        }
        if (m.NexusModId is not null)
            UpdateService.OpenUrl(
                $"https://www.nexusmods.com/stardewvalley/mods/{m.NexusModId}?tab=files");
    }


    {
        var active = ActiveProfileName;
        var p = AllProfiles.FirstOrDefault(x => x.Name.Equals(active, StringComparison.OrdinalIgnoreCase));
        if (p is null) return;
        p.EnabledModUids = _mods
            .Where(m => !m.Disabled && !string.IsNullOrWhiteSpace(m.UniqueID))
            .Select(m => m.UniqueID)

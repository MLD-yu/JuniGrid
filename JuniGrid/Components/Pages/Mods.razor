@namespace JuniGrid.Components.Pages
@page "/mods"
@inject ConfigService Cfg
@inject ModService ModSvc
@inject GameService Game
@inject UpdateService Updater
@inject NexusService Nexus
@inject InstallService Installer
@inject PageRefreshService PageRefresh
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TaskCenterService Center
@inject DepotDownloaderService DepotQr
@implements IDisposable

<div class="jg-page">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px">
        <div>
            <div style="display:flex;align-items:center;gap:14px">
                <h1 style="margin-top:0;margin-bottom:4px">@Loc.T("Mod 管理")</h1>
                @* v1.07.3：普通文件夹图标，点击打开 Mods 目录；data-tip 与导航栏同款胶囊提示 *@
                <button class="jg-mods-folder-btn" data-tip='@Loc.T("打开 mods 文件夹")' aria-label='@Loc.T("打开 mods 文件夹")'
                        @onclick="OpenModsRootFolder">
                    <svg viewBox="0 0 1024 1024" width="32" height="32" fill="#f2b544">
                        <path d="M855.04 385.024q19.456 2.048 38.912 10.24t33.792 23.04 21.504 37.376 2.048 54.272q-2.048 8.192-8.192 40.448t-14.336 74.24-18.432 86.528-19.456 76.288q-5.12 18.432-14.848 37.888t-25.088 35.328-36.864 26.112-51.2 10.24l-567.296 0q-21.504 0-44.544-9.216t-42.496-26.112-31.744-40.96-12.288-53.76l0-439.296q0-62.464 33.792-97.792t95.232-35.328l503.808 0q22.528 0 46.592 8.704t43.52 24.064 31.744 35.84 12.288 44.032l0 11.264-53.248 0q-40.96 0-95.744-0.512t-116.736-0.512-115.712-0.512-92.672-0.512l-47.104 0q-26.624 0-41.472 16.896t-23.04 44.544q-8.192 29.696-18.432 62.976t-18.432 61.952q-10.24 33.792-20.48 65.536-2.048 8.192-2.048 13.312 0 17.408 11.776 29.184t29.184 11.776q31.744 0 43.008-39.936l54.272-198.656q133.12 1.024 243.712 1.024l286.72 0z"/>
                    </svg>
                </button>
            </div>
            <div style="opacity:.7;font-size:13px">
                @* v1.08：骨架屏只负责磁盘扫描阶段；检查更新期间列表照常显示 *@
                @if (_initialLoading) { <span>@Loc.T("正在加载 mod 列表…")</span> }
                else { <text>@Loc.F("共 {0} 个（{1} 已启用）", _mods.Count, _mods.Count(m => !m.Disabled))</text> }
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
            @* v0.47.0：存档下拉挪到最右；GSAP easeReverse 弹性开合（参照官方 demo）*@
            <div class="jg-profile-dd @(_profileOpen ? "open" : "")" data-dd="profile">
                @* v0.71.4：重命名挪到下拉按钮右边 —— 点铅笔后按钮变输入框、铅笔变确定，改名只在这一个位置发生 *@
                @if (_renamingProfile is not null)
                {
                    <input class="jg-profile-input jg-profile-headinput" maxlength="30"
                           value="@_renameBuffer"
                           @oninput="e => _renameBuffer = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="e => OnRenameKey(e, _renamingProfile!)"
                           @onclick:stopPropagation />
                    <button class="jg-profile-headconfirm" data-tip='@Loc.T("确定")' aria-label='@Loc.T("确定")'
                            @onclick="() => ConfirmRename(_renamingProfile!)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                            <path d="M20 6 9 17l-5-5"/>
                        </svg>
                    </button>
                }
                else
                {
                    <button class="jg-sort-trigger" @onclick="ToggleProfile">
                        @Loc.T(ActiveProfileName)
                        <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    @if (ActiveProfileName != "默认")
                    {
                        <button class="jg-profile-rename jg-profile-headrename" data-tip='@Loc.T("重命名")' aria-label='@Loc.T("重命名")'
                                @onclick="() => StartRenameProfile(ActiveProfileName)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                                <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                <path d="m15 5 4 4"/>
                            </svg>
                        </button>
                    }
                }
                <div class="jg-sort-menu jg-profile-menu">
                    @foreach (var p in AllProfiles)
                    {
                        <div class="jg-profile-item @(p.Name == ActiveProfileName ? "active" : "")">
                            @* v0.71.4：菜单项只负责切换/删除；重命名统一由下拉按钮右侧的铅笔入口发起 *@
                            <button class="jg-profile-name"
                                    @onclick="() => ApplyProfileAndClose(p.Name)">@Loc.T(p.Name)</button>
                            @if (p.Name != "默认")
                            {
                                <button class="jg-profile-del" @onclick="() => AskDeleteProfile(p.Name)">×</button>
                            }
                        </div>
                    }
                    <div class="jg-profile-item">
                        @if (_addingProfile)
                        {
                            <input class="jg-profile-input" placeholder='@Loc.T("存档名称")' maxlength="30"
                                   @bind="_newProfileName" @bind:event="oninput" />
                            <button class="jg-profile-name" style="font-weight:600;flex:none" @onclick="ConfirmAddProfile">@Loc.T("确定")</button>
                        }
                        else
                        {
                            @* 虚线胶囊 + 悬停胶囊提示（导航栏同款 data-tip 风格）*@
                            <button class="jg-profile-addcap" data-tip='@Loc.T("新建存档")' aria-label='@Loc.T("新建存档")' @onclick="StartAddProfile">
                                <span class="plus">＋</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── SMAPI 永远第一个显示（用自己的 exe 图标，不用 emoji）── *@
    <div class="jg-card jg-smapi-card" style="margin-top:12px">
        <div style="display:flex;align-items:center;gap:12px">
            @* v0.37.0：exe 抽不到图标时用自带的 pufferchick 兜底，不再显示灰色 S 占位块 *@
            @if (_smapiIcon is not null)
            {
                <img class="jg-modrow-icon" src="@_smapiIcon" alt="SMAPI" />
            }
            else
            {
                <img class="jg-modrow-icon" src="assets/smapi-pufferchick.svg" alt="SMAPI"
                     style="border-radius:8px;background:var(--jg-card);padding:2px" />
            }
            <div style="min-width:0;flex:1">
                <div style="font-weight:700">
                    SMAPI
                    <span style="opacity:.6;font-weight:400;font-size:12px">@Loc.T("Mod 加载器")</span>
                </div>
                <div style="opacity:.75;font-size:12.5px;margin-top:3px">
                    @if (_smapiVersion is null)
                    {
                        @if (SmapNeedsOld && _smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
                        {
                            <span>@Loc.F("未安装 · 当前游戏 {0} 适配 SMAPI {1}，点右侧按钮一键下载安装", GameVerDisplay, _smapiUpdate.LatestVersion)</span>
                        }
                        else if (SmapNeedsOld)
                        {
                            <span style="color:#f0b95a">
                                @Loc.F("当前游戏 {0} ·", GameVerDisplay)
                                @(SmapiUnsupported ? Loc.T("无一键适配 SMAPI，可去 Nexus 手动找历史包") : Loc.F("推荐 {0}", SmapRecommendShort))
                            </span>
                        }
                        else if (_smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
                        {
                            <span>@Loc.F("未安装 · 最新版 {0}，点右侧按钮一键下载安装", _smapiUpdate.LatestVersion)</span>
                        }
                        else if (_smapiUpdate is { Error: not null })
                        {
                            <span style="color:#c50f1f">@Loc.F("未安装 · 获取版本信息失败（{0}）", _smapiUpdate.Error)</span>
                        }
                        else
                        {
                            <span>@Loc.T("未安装 · 正在获取版本信息…")</span>
                        }
                    }
                    else
                    {
                        <text>@Loc.F("当前版本：{0}", SmapiDisplay)</text>
                        @if (_smapiUpdate is { HasUpdate: true, LatestVersion: not null } && !SmapNeedsOld)
                        {
                            @* 新版本徽标：右箭头 + 「新版本」+ 版本号；点版本号直接更新 *@
                            <button type="button" class="jg-newver" disabled="@_smapiUpdating"
                                    title="@(_smapiUpdating ? Loc.T("正在更新…") : Loc.F("点击更新到 {0}", _smapiUpdate.LatestVersion!))"
                                    @onclick="UpdateSmapi">
                                <svg class="jg-newver-arrow" viewBox="0 0 1024 1024" aria-hidden="true">
                                    <path d="M560 512.414C560 453.643 512.357 406 453.586 406H204.414C145.643 406 98 453.643 98 512.414v0.172C98 571.357 145.643 619 204.414 619h249.172C512.357 619 560 571.357 560 512.586v-0.172z" fill="currentColor"/>
                                    <path d="M630.024 211.105l20.067 16.805 124.46 103.419L818 366.98v0.146l39.008 33.527 24.734 21.15c22.165 18.618 35.789 41.557 41.386 65.588 5.395 23.169 2.94 47.343-7.045 69.656-7.398 16.532-19.033 32.047-34.867 45.347l-21.025 17.62a128.674 128.674 0 0 1-3.92 3.425l-40.2 33.659-42.484 35.575-118.372 99.341a133.759 133.759 0 0 1-5.123 4.078l-20.068 16.805c-36.162 30.236-79.744 36.785-117.069 22.211-24.069-9.397-45.542-27.555-60.722-53.889l-2.171-3.77c-5.856-13.007-9.497-27.58-10.563-43.322l-0.455 0.443s41.854-154.592 41.854-222.471-41.758-212.887-41.758-212.887c0.035-19.354 3.923-37.113 10.923-52.66l2.171-3.77c14.42-25.015 34.524-42.636 57.131-52.395a112.775 112.775 0 0 1 3.59-1.494c37.325-14.574 80.907-8.024 117.069 22.212z" fill="currentColor"/>
                                </svg>
                                <span class="jg-newver-label">@Loc.T("新版本")</span>
                                @if (_smapiUpdating)
                                {
                                    <span class="jg-newver-num">@Loc.T("更新中…")</span>
                                }
                                else
                                {
                                    <span class="jg-newver-num">@_smapiUpdate.LatestVersion</span>
                                }
                            </button>
                        }
                        else if (SmapNeedsOld)
                        {
                            <span style="color:#f0b55a">@Loc.F(" · 当前游戏 {0}", GameVerDisplay)
                                @(SmapiUnsupported ? Loc.T("无一键适配 SMAPI") : Loc.F("适合 {0}", SmapRecommendShort))</span>
                        }
                    }
                </div>
            </div>
            @* v1.1.8/1.1.9：历史版本与 4.5.2 同管线；旧版按钮按本地映射秒出，不等 GitHub *@
            @if (NeedsCompatibleOldSmapi)
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="InstallSmapi">
                    @(_smapiUpdating ? Loc.T("正在安装…") : (_smapiVersion is null ? Loc.F("⬇ 下载安装 {0}", CompatibleOldSmapiLabel) : Loc.F("⬇ 安装适配的 {0}", CompatibleOldSmapiLabel)))
                </button>
            }
            else if (_smapiVersion is null && _smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="InstallSmapi">
                    @(_smapiUpdating ? Loc.T("正在安装…") : Loc.F("⬇ 下载安装 SMAPI {0}", _smapiUpdate.LatestVersion))
                </button>
            }
            else if (_smapiVersion is null && SmapNeedsOld && SmapiUnsupported)
            {
                <a class="jg-update-link" style="width:auto;padding:8px 16px;text-decoration:none"
                   href="@SmapRecommendUrl" target="_blank" rel="noopener"> @Loc.T("去 Nexus 找历史包") </a>
            }
            else if (_smapiUpdate is { HasUpdate: true } && !SmapNeedsOld)
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="UpdateSmapi">
                    @(_smapiUpdating ? Loc.T("正在更新…") : Loc.F("⬇ 更新到 {0}", _smapiUpdate.LatestVersion))
                </button>
            }
        </div>
    </div>

    @if (_rowsLoaded && _mods.Count == 0)
    {
        <div class="jg-card" style="margin-top:12px"> @Loc.T("Mods 文件夹为空或未定位到游戏。请先在「设置」里选择游戏目录。") </div>
    }

    @* ── v0.34.0 工具条：排序在前 → 筛选 chips → 搜索（点击向右延伸，SVG 图标） ── *@
    <div class="jg-mods-toolbar">
        <div class="jg-sort-dd @(_sortOpen ? "open" : "")" data-dd="sort">
            <button class="jg-sort-trigger" @onclick="ToggleSort"> @Loc.T("排序方式") <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="jg-sort-menu">
                <button class="jg-sort-item @(_sortMode == "time-asc" ? "active" : "")" @onclick='() => SetSort("time-asc")'>@Loc.T("最新在前")</button>
                <button class="jg-sort-item @(_sortMode == "time-desc" ? "active" : "")" @onclick='() => SetSort("time-desc")'>@Loc.T("最早在前")</button>
                <button class="jg-sort-item @(_sortMode == "alpha" ? "active" : "")" @onclick='() => SetSort("alpha")'>@Loc.T("首字母")</button>
            </div>
        </div>
        @* v1.1.2：遮罩改常驻 DOM + class 随状态绑定（原 @if 渲染比 JS 慢一拍：
           dropdownToggle 同帧翻转 .open 时遮罩元素还不存在，开菜单后点外部收不掉） *@
        <div class="jg-dd-overlay @(_sortOpen ? "open" : "")" data-dd="sort" @onclick="CloseSort"></div>
        <div class="jg-chips" role="group" style="align-items:center">
        @foreach (var f in _filterOptions)
        {
            <button class="jg-chip @(_filter == f.Key ? "active" : "")"
                    style="@(f.Key == "updatable" && FailedCheckCount > 0 ? "position:relative" : "")"
                    data-tip="@FilterTip(f.Key)"
                    @onclick="() => SetFilter(f.Key)">
                @Loc.T(f.Label)<span style="opacity:.7;font-weight:400"> · @CountFor(f.Key)</span>
                @if (f.Key == "updatable" && FailedCheckCount > 0)
                {
                    @* v1.08：有检查失败的 mod → 可更新标签右上角小红点 *@
                    <span style="position:absolute;top:-3px;right:-3px;width:8px;height:8px;border-radius:50%;background:#e81123;box-shadow:0 0 0 2px var(--jg-bg)"></span>
                }
            </button>
        }
        </div>
        @* 状态字必须在 .jg-chips 外面：chips 是 flex-wrap:wrap，6 个 chip 正好占满一行，
           状态字排在其后就必然被折到第二行，变成一行孤儿字（他截图实测）。工具条本身 nowrap，
           放外面就贴着 chips 右侧同一行（实测状态字 top 286 / chips 279–310，同一行内）。 *@
        @if (FailedCheckCount > 0)
        {
            <span style="font-size:12px;color:#c50f1f;opacity:.85;white-space:nowrap;flex-shrink:0">@Loc.F("更新检查超时，请检查网络（{0} 个未完成）", FailedCheckCount)</span>
        }
        else if (_checkingUpdates)
        {
            <span style="font-size:12px;opacity:.6;white-space:nowrap;flex-shrink:0">@Loc.T("正在检查更新…")</span>
        }
        <div class="jg-search-x @(_searchOpen ? "open" : "")">
            <button class="jg-search-btn" @onclick="ToggleSearch">
                <img src="assets/search.svg" alt='@Loc.T("搜索")' style="width:18px;height:18px;display:block" />
            </button>
            <div class="jg-search-field">
                <input class="jg-search-input" placeholder='@Loc.T("搜mod名/N网尾号")'
                       @bind="SearchText" @bind:event="oninput" />
                <button class="jg-search-clear" @onclick="ClearSearchAndClose">✕</button>
            </div>
        </div>
    </div>

    @* ── v1.2.0：缺失依赖横幅 + 一键安装 ── *@
    @if (!_initialLoading && TotalMissingUids.Count > 0)
    {
        <div class="jg-card" style="margin-top:12px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;border-left:3px solid #f2b544">
            <span style="font-size:13px"> @Loc.T("检测到") <b>@TotalMissingUids.Count</b>@Loc.F(" 个依赖没装或版本过旧，影响 {0} 个 mod ", MissingAffectedMods)</span>
            <button class="jg-pill-dark" style="padding:7px 16px;font-size:12.5px"
                    disabled="@(_depInstalling || Installer.Busy)"
                    @onclick="() => AskInstallMissingDeps(null)">
                @(_depInstalling ? Loc.T("正在安装…（进度见右下角任务）") : Loc.T("一键安装/更新依赖"))
            </button>
            <button class="jg-pill-ghost" style="padding:7px 14px;font-size:12.5px"
                    @onclick='() => SetFilter("missing")'>@Loc.T("查看列表")</button>
            @if (_depError is not null)
            {
                <span style="color:#c50f1f;font-size:12.5px">@Loc.T(_depError)</span>
            }
        </div>
    }

    @* ── 单行 mod 列表 ── *@
    @* v1.06.9：首次加载 或 检查更新未完成 → 一律显示 shimmer 骨架屏，真实列表 display:none *@
    @if (_initialLoading)
    {
        <div class="jg-modrows jg-modrows-skeleton">
            @for (var i = 0; i < 8; i++)
            {
                <div class="jg-modrow-shimmer">
                    <div class="jg-shimmer jg-shimmer-avatar"></div>
                    <div class="jg-shimmer-lines">
                        <div class="jg-shimmer jg-shimmer-line" style="width:38%"></div>
                        <div class="jg-shimmer jg-shimmer-line" style="width:68%"></div>
                    </div>
                    <div class="jg-shimmer jg-shimmer-pill"></div>
                </div>
            }
        </div>
    }
    <div class="jg-modrows" style="@(_initialLoading ? "display:none" : "")">
        @foreach (var group in Groups)
        {
            var bundle = group.Key != "";
            var open = !bundle || GroupOpen(group.Key);
            @if (bundle)
            {
                @* 捆绑包 = 一行父包：封面取包里第一个有封面的子包（同一个 mod 的包），
                   点箭头才展开子包。点整行仍是全选/取消全选该捆绑包（v1.1.5 的行为，没删）。 *@
                var selInGroup = group.Items.Count(m => _selected.Contains(m.Folder));
                var gcover = group.Items.Select(GetCover).FirstOrDefault(c => c is not null);
                var gOn = group.Items.All(m => !m.Disabled);   // 全选框口径：全开才亮，有一个没开就是关
                @* 选中标题上那行「（N 个/已选 N 个）」的父行照子行同款样式画：
                   点父行就是整包全选，画得不一样会让人以为这行不参与选择。 *@
                <div class="jg-modrow jg-group-head @(selInGroup == group.Items.Count ? "selected" : "")" @key="@("b:" + group.Key)" data-al
                     @onclick="() => ToggleGroupSelection(group.Items)">
                    @if (gcover is not null)
                    {
                        <img class="jg-modrow-icon" src="@gcover" loading="lazy" alt="" />
                    }
                    else
                    {
                        <div class="jg-modrow-icon jg-modrow-icon-fallback">@group.Key.TrimStart('.')[..1].ToUpperInvariant()</div>
                    }
                    <div class="jg-modrow-text">
                        <div class="jg-modrow-title">
                            <span class="name">@group.Key</span>
                            <span class="divider">|</span>
                            <span class="ver">@(selInGroup > 0 ? Loc.F("（{0} 个/已选 {1} 个）", group.Items.Count, selInGroup) : Loc.F("（{0} 个）", group.Items.Count))</span>
                            @if (group.Missing.Count > 0)
                            {
                                <span class="jg-tag broken">@Loc.F(" 缺失依赖 {0}", group.Missing.Count)</span>
                            }
                        </div>
                    </div>
                    <div class="jg-modrow-end" @onclick:stopPropagation>
                        @* 整包开关：口径与「全选」复选框一致 —— 全开才亮，有一个没开就显示关；点下去把整包推成反面。
                           动手的是顶层一次改名（.Bundle ↔ Bundle），外加把包里每个子包的依赖联动跑一遍
                           （与子包那颗开关同一套 EnableDependencies / DisableDependents）。
                           ⚠ 参数是"要不要禁用"，与子包那颗的 !m.Disabled 同一个方向 —— 传反了
                           就是"已经开着再开一次"，被 ModService 的空操作闸门原地吞掉（实测点两下没反应）。 *@
                        <button class="jg-modrow-switch jg-squish-host @(gOn ? "on" : "")" role="switch"
                                aria-checked="@gOn" data-tip="@(gOn ? Loc.T("禁用") : Loc.T("启用"))"
                                aria-label="@(gOn ? Loc.T("禁用") : Loc.T("启用"))"
                                @onclick="() => _ = SetBundleDisabled(group, gOn)">
                            <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                        </button>
                        <button class="jg-rowbtn" data-tip="@(open ? Loc.T("收起子包") : Loc.T("展开子包"))"
                                aria-label="@(open ? Loc.T("收起子包") : Loc.T("展开子包"))"
                                aria-expanded="@(open ? "true" : "false")"
                                @onclick="() => ToggleGroupOpen(group.Key)">
                            <svg class="jg-acc-arrow @(open ? "open" : "")" id="@SubArrowId(group.Key)" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </div>
                </div>
            }

            @* 子包永远在 DOM 里，折起时由面板 CSS 藏（height:0）—— 折叠动画要能量到真实高度，
               条件渲染的话面板一出现就是满高，只能"啪"地跳出来（GSAP 那支弹簧就没得播了）。
               散装 mod 走的是同一个面板，但它 open 恒为 true，面板对它就是一层无样式的外壳。 *@
            <div class="jg-bundle-subs @(open ? "open" : "")" id="@(bundle ? SubPanelId(group.Key) : null)">
            @foreach (var m in group.Items)
            {
                    var st = GetState(m.Folder);
                    var cover = GetCover(m);
                    var missing = MissingDeps(m);
                    var stale = StaleDeps(m);
                    var toInstall = DepsToInstall(m);
                    @* v1.1.8：@key 换成"启禁用不会变"的身份键（UID，没 UID 的散装文件夹退回 folder）。
                       旧 key 是 Folder#序号 —— 启禁用就是把 Folder 改名（X ↔ .X），于是每次点开关
                       这一行都被销毁重建：封面重新解码闪一下、正在跑的开关动画被掐断、
                       列表位置一变还会连带重建别的好几行。两种键各加前缀，互不撞（同名 UID/folder 也不会串）。 *@
                    <div class="jg-modrow @(bundle ? "jg-modrow-sub" : "") @(_selected.Contains(m.Folder) ? "selected" : "")"
                         @key="@(string.IsNullOrEmpty(m.UniqueID) ? "f:" + m.Folder : "u:" + m.UniqueID)"
                         data-al
                         @onclick="() => ToggleSelect(m.Folder)">

                        @if (cover is not null)
                        {
                            <img class="jg-modrow-icon" src="@cover" loading="lazy" alt="" />
                        }
                        else
                        {
                            <div class="jg-modrow-icon jg-modrow-icon-fallback">
                                @(m.Name.Length > 0 ? m.Name[..1].ToUpperInvariant() : "?")
                            </div>
                        }

                        <div class="jg-modrow-text">
                            <div class="jg-modrow-title">
                                <span class="name">@RemarkName(m)</span>
                                <span class="divider">|</span>
                                @* 有效本地版本：优先展示「启动器已装上的 N 网文件版本」，
                                   避免作者忘改 manifest 时列表永远停在 0.0.1 *@
                                <span class="ver">@NexusUpdateTruth.EffectiveLocalVersion(Cfg.Current, m)</span>
                                @if (m.IsConvertedPack)
                                {
                                    <span class="jg-tag" data-tip='@Loc.T("JuniGrid 把 Portraiture 素材转成的 CP 包，不参与 N 网版本比对")'>@Loc.T("已转换")</span>
                                }
                                else if (NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, st.RemoteVersion, st.RemoteFileId))
                                {
                                    @* 新版本徽标：右箭头 + 「新版本」+ 版本号；点版本号打开下载页 *@
                                    <button type="button" class="jg-newver"
                                            title='@Loc.F("点击打开 {0} 的下载页", st.RemoteVersion)'
                                            @onclick="() => OpenUpdatePage(m)" @onclick:stopPropagation="true">
                                        <svg class="jg-newver-arrow" viewBox="0 0 1024 1024" aria-hidden="true">
                                            <path d="M560 512.414C560 453.643 512.357 406 453.586 406H204.414C145.643 406 98 453.643 98 512.414v0.172C98 571.357 145.643 619 204.414 619h249.172C512.357 619 560 571.357 560 512.586v-0.172z" fill="currentColor"/>
                                            <path d="M630.024 211.105l20.067 16.805 124.46 103.419L818 366.98v0.146l39.008 33.527 24.734 21.15c22.165 18.618 35.789 41.557 41.386 65.588 5.395 23.169 2.94 47.343-7.045 69.656-7.398 16.532-19.033 32.047-34.867 45.347l-21.025 17.62a128.674 128.674 0 0 1-3.92 3.425l-40.2 33.659-42.484 35.575-118.372 99.341a133.759 133.759 0 0 1-5.123 4.078l-20.068 16.805c-36.162 30.236-79.744 36.785-117.069 22.211-24.069-9.397-45.542-27.555-60.722-53.889l-2.171-3.77c-5.856-13.007-9.497-27.58-10.563-43.322l-0.455 0.443s41.854-154.592 41.854-222.471-41.758-212.887-41.758-212.887c0.035-19.354 3.923-37.113 10.923-52.66l2.171-3.77c14.42-25.015 34.524-42.636 57.131-52.395a112.775 112.775 0 0 1 3.59-1.494c37.325-14.574 80.907-8.024 117.069 22.212z" fill="currentColor"/>
                                        </svg>
                                        <span class="jg-newver-label">@Loc.T("新版本")</span>
                                        <span class="jg-newver-num">@st.RemoteVersion</span>
                                    </button>
                                }
                                else if (st.Status is "updating")
                                {
                                    <span class="jg-newver">
                                        <svg class="jg-newver-arrow" viewBox="0 0 1024 1024" aria-hidden="true">
                                            <path d="M560 512.414C560 453.643 512.357 406 453.586 406H204.414C145.643 406 98 453.643 98 512.414v0.172C98 571.357 145.643 619 204.414 619h249.172C512.357 619 560 571.357 560 512.586v-0.172z" fill="currentColor"/>
                                            <path d="M630.024 211.105l20.067 16.805 124.46 103.419L818 366.98v0.146l39.008 33.527 24.734 21.15c22.165 18.618 35.789 41.557 41.386 65.588 5.395 23.169 2.94 47.343-7.045 69.656-7.398 16.532-19.033 32.047-34.867 45.347l-21.025 17.62a128.674 128.674 0 0 1-3.92 3.425l-40.2 33.659-42.484 35.575-118.372 99.341a133.759 133.759 0 0 1-5.123 4.078l-20.068 16.805c-36.162 30.236-79.744 36.785-117.069 22.211-24.069-9.397-45.542-27.555-60.722-53.889l-2.171-3.77c-5.856-13.007-9.497-27.58-10.563-43.322l-0.455 0.443s41.854-154.592 41.854-222.471-41.758-212.887-41.758-212.887c0.035-19.354 3.923-37.113 10.923-52.66l2.171-3.77c14.42-25.015 34.524-42.636 57.131-52.395a112.775 112.775 0 0 1 3.59-1.494c37.325-14.574 80.907-8.024 117.069 22.212z" fill="currentColor"/>
                                        </svg>
                                        <span class="jg-newver-num">@Loc.T("更新中…")</span>
                                    </span>
                                }
                                @if (m.Disabled)
                                {
                                    <span class="jg-tag">@Loc.T("已禁用")</span>
                                }
                                @if (!m.HasManifest)
                                {
                                    <span class="jg-tag" style="background:rgba(232,17,35,.12);color:#c50f1f">@Loc.T("无清单")</span>
                                }
                                @* v1.2.6：依赖装着但被禁用了 —— SMAPI 照样把依赖方 Skipped，
                                   而「缺依赖」抓不到它（确实装了）。单独一条标签，点一下开依赖。 *@
                                @if (!m.Disabled && DisabledDeps(m) is { Count: > 0 } offDeps)
                                {
                                    <span class="jg-tag broken"
                                          data-tip='@Loc.F("{0} 依赖的 {1} 当前被禁用 —— 游戏里 SMAPI 会跳过 {0}（不是没装，是装着但关了）。点一下把依赖打开。", m.Name, string.Join("、", offDeps))'
                                          @onclick="() => EnableItsDependencies(m)" @onclick:stopPropagation="true">@Loc.T("依赖被禁")</span>
                                }
                                @* v1.2.5：SMAPI 社区兼容性库点名「在当前游戏版本上有问题」的 mod。
                                   只标负面判定 —— 库里查不到的（实测本机约 1/3）一律不标，
                                   否则玩家会把"没数据"读成"已检查通过"。点徽标直达替代版本。 *@
                                @if (BrokenBadge(m) is { } broken)
                                {
                                    <span class="jg-tag broken" data-tip="@BrokenTip(m)"
                                          @onclick="() => OpenBrokenFix(m)" @onclick:stopPropagation="true">@broken</span>
                                }
                                @* 上游的建议早已兑现（你跑的就是它指的那一版）→ 不报警告，但也不能变成"什么都没说过"：
                                   挂一条中性标签留着"原作者不干了、这是接手版"这条信息。
                                   这些行照样算进「维护存疑」，只是不用警告色。 *@
                                @if (UnofficialTag(m) is { } unof)
                                {
                                    <span class="jg-tag" data-tip="@UnofficialTip(m)"
                                          @onclick="() => OpenUnofficial(m)" @onclick:stopPropagation="true">@unof</span>
                                }
                                @* v1.2.5：有覆盖型包（汉化补丁）盖在这个 mod 上。点开看清单、可逐个还原。
                                   失效要单独标出来 —— 宿主 mod 更新会把覆盖整个端走，不标就等于骗人说覆盖还在生效。 *@
                                @if (OverlayBadge(m) is { } ovd)
                                {
                                    <span class="jg-tag @(OverlayStale(m) ? "broken" : "")" data-tip="@OverlayTip(m)"
                                          @onclick="() => OpenOverlayList(m)" @onclick:stopPropagation="true">@ovd</span>
                                }
                            </div>
                            <div class="jg-modrow-desc">
                                @if (GetNexusCategory(m) is { } _cat)
                                {
                                    <span class="jg-cat">@_cat</span>
                                }
                                @(string.IsNullOrWhiteSpace(m.Description) ? m.Folder : m.Description)
                            </div>
                            @if (missing.Count > 0)
                            {
                                @* v1.2.5：显示解析出的 mod 名而不是裸 UID —— 玩家看到
                                   "ChaseXavier.Miku" 这种字符串并不能知道要下哪个 mod。
                                   v1.5.1：名字做成可点入口，点了直接进那个 mod 的详情页
                                   （解析不到 Nexus 页面的保持纯文字：宁可不给入口，
                                   也不能把人领到别人的 mod 页上）。 *@
                                <div class="jg-mod-updmsg failed" style="white-space:normal">
                                    @Loc.F(" 缺少依赖：{0} ", "")
                                    @for (var i = 0; i < missing.Count; i++)
                                    {
                                        if (i > 0) { <text>、</text> }
                                        var depUid = missing[i];
                                        var depDi = _depNames.TryGetValue(depUid, out var dd) ? dd : null;
                                        var depId = depDi?.ModId ?? InstalledDepNexusId(depUid);
                                        @if (depId is > 0)
                                        {
                                            <button type="button" class="jg-dep-link" @onclick:stopPropagation="true"
                                                    title="@Loc.T("点击查看 mod 详情")"
                                                    @onclick="() => OpenDepByUid(depUid, depId)">@DepLabel(depUid)</button>
                                        }
                                        else
                                        {
                                            <span>@DepLabel(depUid)</span>
                                        }
                                    }
                                </div>
                            }
                            @if (stale.Count > 0)
                            {
                                @* SMAPI 对「装得不够新」和对「没装」的处置一模一样（本 mod 整条 Skipped），
                                   所以同样标红；带上本机版本与要求的版本，玩家才知道该把谁换成哪一版。
                                   v1.5.1：装了的那批本地条目自带 NexusModId，点名字直接开详情页。 *@
                                <div class="jg-mod-updmsg failed" style="white-space:normal">
                                    @Loc.F(" 依赖版本过旧：{0} ", "")
                                    @for (var i = 0; i < stale.Count; i++)
                                    {
                                        if (i > 0) { <text>、</text> }
                                        var staleUid = stale[i].Uid;
                                        var staleDi = _depNames.TryGetValue(staleUid, out var sd) ? sd : null;
                                        var staleId = staleDi?.ModId ?? InstalledDepNexusId(staleUid);
                                        @if (staleId is > 0)
                                        {
                                            <button type="button" class="jg-dep-link" @onclick:stopPropagation="true"
                                                    title="@Loc.T("点击查看 mod 详情")"
                                                    @onclick="() => OpenDepByUid(staleUid, staleId)">@DepLabel(staleUid)</button>
                                        }
                                        else
                                        {
                                            <span>@DepLabel(staleUid)</span>
                                        }
                                    }
                                </div>
                            }
                            @* v1.08：检查失败/超时不再在行内显示红字，统一收进筛选栏提示 *@
                        </div>

                        @* ── v1.5：行尾操作区（玩家动力式）—— 开关直管启停；
                           详情/更新/依赖/备注/打开/删除全部收进 … 菜单。
                           整块 stopPropagation：点这里不算选中行。 ── *@
                        <div class="jg-modrow-end" @onclick:stopPropagation>
                            @* v1.1.8：换成设置页那颗挤压回弹开关（.jg-switch + junigrid.switch.js）；
                               .jg-squish-host = 这条开关自己就是拖拽宿主（设置页那边宿主是整行） *@
                            <button class="jg-modrow-switch jg-squish-host @(m.Disabled ? "" : "on")" role="switch"
                                    aria-checked="@(!m.Disabled)" data-tip="@(m.Disabled ? Loc.T("启用") : Loc.T("禁用"))"
                                    aria-label="@(m.Disabled ? Loc.T("启用") : Loc.T("禁用"))"
                                    @onclick="() => SetDisabled(m, !m.Disabled)">
                                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                            </button>

                            <div class="jg-sort-dd jg-modmenu @(_menuFolder == m.Folder ? "open" : "")" data-dd="modmenu">
                                <button class="jg-rowbtn jg-modmenu-btn" data-tip='@Loc.T("更多操作")' aria-label='@Loc.T("更多操作")'
                                        @onclick="() => ToggleMenu(m.Folder)">
                                    <svg class="jg-rowbtn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <circle cx="12" cy="5" r="1.9"/>
                                        <circle cx="12" cy="12" r="1.9"/>
                                        <circle cx="12" cy="19" r="1.9"/>
                                    </svg>
                                </button>
                                <div class="jg-sort-menu">
                                    @if (toInstall.Count > 0)
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => AskInstallMissingDeps(toInstall))">@Loc.F(" 安装/更新依赖（{0}） ", toInstall.Count)</button>
                                    }
                                    @if (!m.IsConvertedPack
                                         && m.NexusModId is not null
                                         && NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, st.RemoteVersion, st.RemoteFileId))
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenUpdatePage(m))">@Loc.F(" 更新到 {0} ", st.RemoteVersion)</button>
                                    }
                                    @if (m.IsConvertedPack && m.NexusModId is not null)
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenUpdatePage(m))"> @Loc.T("打开 N 网原包页") </button>
                                    }
                                    @if (m.NexusModId is not null)
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => _ = OpenDetail(m))">@Loc.T("mod 详情")</button>
                                    }
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenRemark(m))">@Loc.T("备注 / 重命名")</button>
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenFolder(m))">@Loc.T("打开文件所在位置")</button>
                                    <button class="jg-sort-item danger" @onclick="() => MenuAct(() => AskDeleteMod(m))">@Loc.T("删除")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            }

        @if (_rowsLoaded && FilteredMods.Count == 0)
        {
            @* 两种"空"是两件事，分开说：被条件筛空了 ≠ 一个都没装。
               样式与图二那套空态共用（.jg-pk-empty* 是全局类，不是 packs 页专属）。 *@
            var bySearch = SearchText.Trim().Length > 0;
            var byFilter = _filter != "all";
            <div class="jg-pk-empty jg-mods-empty">
                @if (bySearch || byFilter)
                {
                    <svg class="jg-pk-empty-art" viewBox="0 0 220 120" fill="none" aria-hidden="true">
                        <rect x="30" y="20" width="96" height="13" rx="6.5" stroke="currentColor" stroke-width="2.5" opacity=".4"/>
                        <rect x="30" y="46" width="70" height="13" rx="6.5" stroke="currentColor" stroke-width="2.5" opacity=".26"/>
                        <rect x="30" y="72" width="86" height="13" rx="6.5" stroke="currentColor" stroke-width="2.5" opacity=".16"/>
                        <circle cx="146" cy="56" r="26" stroke="currentColor" stroke-width="2.5" opacity=".9"/>
                        <path d="m166 76 18 18" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity=".9"/>
                        <path d="M136 56h20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity=".9"/>
                    </svg>
                    <div class="jg-pk-empty-title">@Loc.T("没有符合条件的 mod")</div>
                    @* 不放按钮：清搜索词就在右上搜索框的 ✕，换档就在上面那排 chips —— 屏上已有的出口不重复给。 *@
                }
                else
                {
                    <svg class="jg-pk-empty-art" viewBox="0 0 220 120" fill="none" aria-hidden="true">
                        <path d="M56 34h30l9 11h59a8 8 0 0 1 8 8v33a8 8 0 0 1-8 8H56a8 8 0 0 1-8-8V42a8 8 0 0 1 8-8Z" stroke="currentColor" stroke-width="2.5" opacity=".9"/>
                        <path d="M48 63h114" stroke="currentColor" stroke-width="2.5" opacity=".35"/>
                        <path d="M110 74v22M99 85h22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity=".9"/>
                        <path d="M176 24l2.6 6 6 2.6-6 2.6-2.6 6-2.6-6-6-2.6 6-2.6Z" fill="currentColor" opacity=".85"/>
                    </svg>
                    <div class="jg-pk-empty-title">@Loc.T("还没有装 mod")</div>
                    <button type="button" class="jg-pill-dark" @onclick='() => Nav.NavigateTo("nexus")'>
                        <svg class="jg-pt-act-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg> @Loc.T("去 Nexus Mods 找 mod")
                    </button>
                    <div class="jg-pk-empty-note">@Loc.T("只盖本体图片的素材包在内容包页。")</div>
                }
            </div>
        }
    </div>
</div>

@* ── 批量操作悬浮条（左键多选后出现）── *@
@if (_selected.Count > 0)
{
    @* v0.42.0：纯图标按钮（SVG 文件）+ 胶囊提示（data-tip，禁用按钮也有）+ 全选在最前 *@
    var anyUpdatable = _selected.Any(f => _modsByFolder.TryGetValue(f, out var mm) && IsUpdatable(mm));
    var anyDisabled  = _selected.Any(f => _modsByFolder.TryGetValue(f, out var mm2) && mm2.Disabled);
    var anyEnabled   = _selected.Any(f => _modsByFolder.TryGetValue(f, out var mm3) && !mm3.Disabled);
    <div class="jg-batchbar-anchor">
    <div class="jg-batchbar">
        <span class="jg-batchbar-count">@Loc.F("已选择 {0} 个", _selected.Count)</span>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("全选")' @onclick="SelectAll">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 5.5h4M4 12h4M4 18.5h4"/>
                <path d="M10 4.5l1.8 1.8L15.5 2.6"/>
                <path d="M10 11l1.8 1.8 3.7-3.7"/>
                <path d="M10 17.5l1.8 1.8 3.7-3.7"/>
            </svg>
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("批量更新")' disabled="@(_selected.Count == 0 || !anyUpdatable)" @onclick="BatchUpdate">
            <img src="assets/actions/batch-update.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("启用")' disabled="@(!anyDisabled)" @onclick="() => BatchSetDisabled(false)">
            <img src="assets/actions/enable.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("禁用")' disabled="@(!anyEnabled)" @onclick="() => BatchSetDisabled(true)">
            <img src="assets/actions/disable.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn danger-outline jg-ico" data-tip='@Loc.T("删除")' @onclick="AskBatchDelete">
            <img src="assets/actions/delete.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("取消选择")' @onclick="ClearSelection">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18"/>
            </svg>
        </button>
    </div>
</div>
}

@* ── 备注/重命名弹窗（给 mod 起中文备注，列表里显示成 备注(原名)）── *@
@if (_remarkFolder is not null)
{
    <div class="jg-dlg-overlay" @onclick:stopPropagation>
        <div class="jg-dialog jg-remark-dialog">
            <div class="jg-remark-title">@Loc.T("给这个 mod 起备注")</div>
            <div class="jg-remark-mod">@(_remarkOriginal)</div>
            @* Motion characters-remaining 同款：输入框内右侧显示「剩余可输入数」（空=20，逐键递减到 0），
               每次输入由 GSAP 弹一下；空格不计数不显示（OnRemarkInput 过滤），满格后尝试输入 0 放大提醒 *@
            <div class="jg-remark-field">
                <input class="jg-remark-input @(_remarkInput.Length >= 16 ? "near-limit" : "")" maxlength="20" placeholder='@Loc.T("输入备注")'
                       value="@_remarkInput" @oninput="OnRemarkInput" @onkeydown="OnRemarkKeydown"
                       autofocus />
                <span class="jg-remark-count @(_remarkInput.Length >= 20 ? "full" : _remarkInput.Length >= 16 ? "warn" : "")">@(20 - _remarkInput.Length)</span>
            </div>
            <div class="jg-dialog-actions">
                <button class="jg-btn" @onclick="CancelRemark">@Loc.T("取消")</button>
                <button class="jg-btn primary" @onclick="SaveRemark">@Loc.T("保存")</button>
            </div>
        </div>
    </div>
}

    @* v0.71.6：存档下拉打开时铺透明遮罩，点"除下拉框本身以外"的地方收回。
       v1.1.2：改常驻 DOM + class 随状态绑定 —— 原 @if 渲染比 profileDropdown 的
       同帧 .open 翻转慢一拍，遮罩永远追不上菜单，点外部收不掉。 *@
    @* v1.5：行尾 … 菜单遮罩 —— 所有行共用一个键，点外部收回。
       open 必须写进 class：写在 class 外只会生成 HTML 属性，CSS .jg-dd-overlay.open 永远匹配不上，
       遮罩 pointer-events 一直是 none，点外部收不掉（只能再点 … 关）。 *@
    <div class="jg-dd-overlay @(_menuFolder is not null ? "open" : "")" data-dd="modmenu" @onclick="CloseMenu"></div>

    <div class="jg-dd-overlay @(_profileOpen ? "open" : "")" data-dd="profile" @onclick="CloseProfile"></div>

    @* v0.46.0：删除存档确认对话框 *@
    @if (_deletingProfile is not null)
    {
        <div class="jg-modal-overlay" @onclick="CancelDeleteProfile">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">@Loc.T("删除存档")</div>
                <div class="jg-modal-body">@Loc.F("确定删除「{0}」存档吗？（仅删除 mod 存档，对游戏内的存档无影响）", _deletingProfile)</div>
                <div class="jg-modal-actions">
                    <button class="jg-mini-btn" data-modal-close @onclick="CancelDeleteProfile">@Loc.T("取消")</button>
                    <button class="jg-mini-btn danger" @onclick="ConfirmDeleteProfile">@Loc.T("删除")</button>
                </div>
            </div>
        </div>
    }

    @* 删除 mod 确认对话框（单个 / 批量共用，替代旧的行内二段式确认） *@
    @if (_pendingDeleteMod is not null || _pendingBatchDelete)
    {
        <div class="jg-modal-overlay" @onclick="CancelDeleteMods">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">@Loc.T("删除 mod")</div>
                <div class="jg-modal-body">@Loc.T("确定删除所选mod？")</div>
                <label class="jg-modal-trash-opt">
                    <input type="checkbox" @bind="_deleteToTrash" />
                    <span>@Loc.T("移入mod回收站（不勾选将彻底删除）")</span>
                </label>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" data-modal-close @onclick="CancelDeleteMods">@Loc.T("取消")</button>
                    <button type="button" class="jg-pill-danger" @onclick="ConfirmDeleteMods">@Loc.T("确定删除")</button>
                </div>
            </div>
        </div>
    }


    @* ── v1.2.0：一键安装缺失依赖 —— 确认弹窗（空列表 = 全部缺失依赖）── *@
    @if (_pendingDepUids is not null)
    {
        var depList = _pendingDepUids.Count > 0 ? _pendingDepUids : TotalMissingUids;
        <div class="jg-modal-overlay" @onclick="CancelInstallDeps">
            <div class="jg-modal" @onclick:stopPropagation style="max-width:540px">
                <div class="jg-modal-title">@Loc.T("安装缺失依赖")</div>
                <div class="jg-modal-body">@Loc.F(" 将从 Nexus 下载并安装以下 {0} 个依赖（装上后新暴露的传递依赖会自动跟进）： ", depList.Count)<div class="jg-dep-list">
                        @foreach (var u in depList)
                        {
                            var di = _depNames.TryGetValue(u, out var dd) ? dd : null;
                            var clickable = di?.ModId is not null;
                            var coverData = di?.CoverUrl;
                            <div class="jg-dep-row" data-clickable="@clickable"
                                 style="display:flex;align-items:center;gap:10px;min-width:0;@(clickable ? "cursor:pointer" : "")"
                                 title="@(clickable ? Loc.T("点击查看 mod 详情") : "")"
                                 @onclick="() => OpenDepDetail(di)">
                                @if (coverData is not null)
                                {
                                    <img src="@coverData" alt="" loading="lazy"
                                         style="width:34px;height:34px;border-radius:6px;object-fit:cover;flex:none;pointer-events:none" />
                                }
                                else
                                {
                                    <div class="jg-modrow-icon jg-modrow-icon-fallback"
                                         style="width:34px;height:34px;border-radius:6px;flex:none;font-size:14px">
                                        @(u.Length > 0 ? u[..1].ToUpperInvariant() : "?")
                                    </div>
                                }
                                <div style="flex:1;min-width:0;pointer-events:none">
                                    <div style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(di?.Name ?? u)</div>
                                    @if (di?.Name is not null)
                                    {
                                        <div style="font-size:11px;opacity:.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@u</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div style="margin-top:8px;font-size:12px;opacity:.6"> @Loc.T("每个依赖都会在下载后校验 manifest UniqueID，防止装错 mod；SMAPI 本体需单独安装。") </div>
                </div>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" data-modal-close @onclick="CancelInstallDeps">@Loc.T("取消")</button>
                    <button type="button" class="jg-pill-dark" disabled="@(_depInstalling || Installer.Busy)"
                            @onclick="ConfirmInstallDeps">@Loc.T("开始安装")</button>
                </div>
            </div>
        </div>
    }

    @* ── v1.2.0：依赖安装结果弹窗（手动项附 Nexus 链接）──
       v1.3.4：已删除 —— 手动依赖的页面本来就会自动在浏览器打开，结果弹窗是重复打扰；
       任务中心的完成摘要（"已安装 X 个；Y 个需手动"）足够。 *@

    @* ── v1.2.5：盖在某个 mod 上的覆盖包清单 ──
       覆盖的本质是"往别人的 mod 目录里写文件"，所以必须看得见、能撤回；
       否则用户只会发现 mod 变了却查不到是谁干的。 ── *@
    @if (_overlayHost is not null)
    {
        <div class="jg-modal-overlay" @onclick="CloseOverlayList">
            <div class="jg-modal" @onclick:stopPropagation style="max-width:560px">
                <div class="jg-modal-title">@Loc.F("盖在「{0}」上的覆盖包", _overlayHost)</div>
                <div class="jg-modal-body">
                    <div class="jg-dep-list">
                        @foreach (var g in OverlayGroups())
                        {
                            var rec = g.Rec;
                            var gone = g.Stale > 0;
                            var title = OverlayTitle(rec);
                            var canOpen = rec.NexusModId is int;
                            <div class="jg-dep-row" style="display:flex;align-items:center;gap:10px;min-width:0">
                                @* 封面 + 名字这一块就是「进这个汉化包的 N 网详情页」的入口；
                                   名字被省略号截断，所以整块挂 data-tip 显示全名。 *@
                                <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0;@(canOpen ? "cursor:pointer" : "")"
                                     data-tip="@title" @onclick="() => GoOverlayDetail(rec)" @onclick:stopPropagation="true">
                                    @if (!string.IsNullOrEmpty(rec.PackCover))
                                    {
                                        <img src="@rec.PackCover" alt="" loading="lazy"
                                             style="width:34px;height:34px;border-radius:6px;object-fit:cover;flex:none" />
                                    }
                                    else
                                    {
                                        <div class="jg-modrow-icon jg-modrow-icon-fallback"
                                             style="width:34px;height:34px;border-radius:6px;flex:none;font-size:14px">
                                            @(title.Length > 0 ? title[..1].ToUpperInvariant() : "?")
                                        </div>
                                    }
                                    <div style="flex:1;min-width:0">
                                        <div style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@title</div>
                                        <div style="font-size:11px;opacity:.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                            @(g.Keys.Count == 1 ? g.Rec.RelPath : Loc.F("{0} 个文件", g.Keys.Count))
                                            @if (gone)
                                            {
                                                <span style="color:#c50f1f"> · @Loc.T("已不在")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @* 开关就是启用/停用本身：关掉时把原文件放回去、开着时从我们留的副本再放上去，
                                   不需要重新下载汉化包。已失效的那行打开开关等于重新应用一次。
                                   宿主必须是 button + .jg-modrow-switch（display:flex）：写成裸 span 的话
                                   .jg-switch 那颗轨道也是 inline，40x22 宽高不生效，实机只剩一个黑点
                                   （同 portraits.css 那条 2026-09-30 的坑）。 *@
                                <button type="button" class="jg-modrow-switch jg-squish-host @(g.AnyOn ? "on" : "")" role="switch"
                                        aria-checked="@g.AnyOn" data-tip="@Loc.T("打开即启用此覆盖包")"
                                        @onclick="() => ToggleOverlayGroup(g, !g.AnyOn)" @onclick:stopPropagation="true">
                                    <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                                </button>
                                @* 已失效的那行不叫"还原"：宿主目录被重装过，磁盘上那份就是上游新版，
                                   没有东西可以还原，点它只是把这条账销掉。 *@
                                <button type="button" class="jg-pill-ghost"
                                        @onclick="() => RevertOverlayGroup(g)">@(gone ? Loc.T("清除记录") : Loc.T("删除"))</button>
                            </div>
                        }
                    </div>
                    @* 只留这一句：宿主 mod 更新把覆盖端走，是唯一会让人"以为覆盖还在生效"的坑。
                       说的是覆盖包，不是汉化 —— 这条通道贴图包、兼容包也走。 *@
                    <div style="margin-top:8px;font-size:12px;opacity:.6">@Loc.T("宿主 mod 更新过一次的话覆盖包会失效，打开一次开关就能重新应用。")</div>
                </div>
                @* 这里不放「全部删除」：那颗金色主按钮 + 无确认 = 一眼被当成"保存/确定"，
                   按下去就把宿主 mod 上所有覆盖包（汉化本体）全删了。逐行的「删除」够用。 *@
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" @onclick="CloseOverlayList">@Loc.T("关闭")</button>
                </div>
            </div>
        </div>
    }

@code {
    private IReadOnlyList<ModEntry> _mods = Array.Empty<ModEntry>();

    /// <summary>列表有没有被真正填过一次。首帧在扫描完成前就渲染，那时 _mods 必然是空的，
    /// 两句"Mods 文件夹为空…""没有符合条件的 mod…"会在每次进页时闪一下 —— 说的是假话。
    /// 只在 ReindexMods（每一条给 _mods 赋值的路径都走它）里置位。</summary>
    private bool _rowsLoaded;
    // v1.1.6：folder → 条目索引。批量操作条与选中清理原先用 FirstOrDefault/Any 全表扫
    //（选中数 × mod 数），几百 mod + 多选时每次渲染做几万次字符串比较。
    private Dictionary<string, ModEntry> _modsByFolder = new(StringComparer.OrdinalIgnoreCase);
    // v0.59.0：首次进入页面的 shimmer 加载态
    private bool _initialLoading = true;
    // v0.60.0：更新检查期间的 shimmer 加载态
    private bool _checkingUpdates = false;
    private string? _smapiVersion;
    private string? _gameVer;

    /// <summary>展示用游戏版本：历史切换后用营销号（1.0），而不是 exe 内部号（1.0.5900）。</summary>
    private string GameVerDisplay
    {
        get
        {
            var cfg = Cfg.Current;
            return UpdateService.DisplayGameVersion(
                _gameVer ?? Updater.GetGameVersion(cfg.GamePath),
                cfg.LastHistoricalLabel,
                cfg.LastHistoricalInternalVersion);
        }
    }

    /// <summary>游戏本体不是 1.6+ 时，最新 SMAPI 4.x 不兼容，禁止一键装 4.x。</summary>
    private bool SmapNeedsOld
    {
        get
        {
            var g = _gameVer ?? Updater.GetGameVersion(Cfg.Current.GamePath);
            if (string.IsNullOrWhiteSpace(g)) return false;
            return UpdateService.RecommendSmapiTag(g) != UpdateService.SmapiLatest;
        }
    }

    private string SmapRecommendShort
    {
        get
        {
            var tag = UpdateService.RecommendSmapiTag(_gameVer);
            if (tag is null) return LocService.Tr("无一键适配包");
            if (tag == UpdateService.SmapiLatest) return "SMAPI 4.x";
            return "SMAPI " + tag;
        }
    }

    /// <summary>本地推荐 tag（不联网）。历史版按钮文案/是否可装都用它，不等 GitHub。</summary>
    private string? SmapRecommendTag =>
        UpdateService.RecommendSmapiTag(_gameVer ?? Updater.GetGameVersion(Cfg.Current.GamePath));

    /// <summary>v1.1.9：旧版游戏要装适配 SMAPI —— 未装，或已装大版本与推荐不符。纯本地判定，按钮秒出。</summary>
    private bool NeedsCompatibleOldSmapi
    {
        get
        {
            if (SmapiUnsupported) return false;
            var tag = SmapRecommendTag;
            if (tag is null || tag == UpdateService.SmapiLatest) return false;
            return _smapiVersion is null || !SmapiMatchesRecommend(_smapiVersion, tag);
        }
    }

    private string CompatibleOldSmapiLabel
    {
        get
        {
            var tag = SmapRecommendTag;
            return tag is null || tag == UpdateService.SmapiLatest ? SmapRecommendShort : "SMAPI " + tag;
        }
    }

    /// <summary>过旧版本（1.0/1.1 等）：没有 GitHub 一键包，按钮只链到 Nexus。</summary>
    private bool SmapiUnsupported => UpdateService.IsSmapiUnsupported(_gameVer ?? Updater.GetGameVersion(Cfg.Current.GamePath));

    /// <summary>v1.1.8：已装 SMAPI 是否已落在推荐的大版本线上（3.7.3 vs 3.7 算匹配；4.x vs 3.x 不匹配）。</summary>
    private static bool SmapiMatchesRecommend(string installed, string recommended)
    {
        if (string.IsNullOrWhiteSpace(installed) || string.IsNullOrWhiteSpace(recommended)) return false;
        var a = installed.Split('.');
        var b = recommended.Split('.');
        // 推荐 3.x → 装的必须是 3.x；推荐 2.x → 装的必须是 2.x
        return a.Length > 0 && b.Length > 0 && a[0] == b[0];
    }

    private string SmapRecommendUrl
    {
        get
        {
            var (_, url) = UpdateService.RecommendSmapi(_gameVer);
            return url ?? "https://www.nexusmods.com/stardewvalley/mods/2400?tab=files";
        }
    }
    private string? _smapiIcon;
    private SmapiUpdateInfo? _smapiUpdate;
    private bool _smapiUpdating;
    private ModEntry? _pendingDeleteMod;   // 待确认删除的单个 mod（弹窗确认后真正卸载）
    private bool _pendingBatchDelete;      // 待确认的批量删除（弹窗确认后真正卸载）
    // v1.09：删除确认弹窗里的"移入mod回收站"复选框 —— 默认不勾（沿用旧的彻底删除），
    // 勾选后删除的 mod 进 Mods/.junigrid_trash 常驻回收站，可从 设置→存储 打开手动还原
    private bool _deleteToTrash;
    private bool _coversDirty;

    // ---- 备注/重命名弹窗 ----
    private string? _remarkFolder;      // null = 弹窗关闭；否则为当前编辑备注的 mod Folder
    private string _remarkOriginal = "";
    private string _remarkInput = "";

    // ---- 过滤 / 分组 / 依赖缺失 ----
    private string _filter = "all";
    private string SearchText { get; set; } = "";

    // v0.32.0：排序（alpha 首字母 / time-desc 时间倒序 / time-asc 时间正序）+ 下拉/搜索展开状态
    private string _sortMode = "time-asc";
    private bool _sortOpen;
    private bool _searchOpen;

    // ── v0.46.0：存档（Profile）系统，仿 Stardrop ──
    private bool _profileOpen;
    private string? _renamingProfile;
    private string _renameBuffer = "";

    /// <summary>v0.71.1：双击开启重命名。</summary>
    private void StartRenameProfile(string name)
    {
        _renamingProfile = name;
        _renameBuffer = name;
        // v1.08：改名时收起存档下拉 —— 输入框+确定按钮已经独立成头，下拉继续开着
        // 只会挡视线，还允许同时点别的存档项，状态容易乱。
        if (_profileOpen)
        {
            _profileOpen = false;
            _ = JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-profile-dd", false);
        }
    }

    private void OnRenameKey(KeyboardEventArgs e, string oldName)
    {
        if (e.Key == "Enter") _ = ConfirmRename(oldName);
        else if (e.Key == "Escape") { _renamingProfile = null; _renameBuffer = ""; }
    }

    private async Task ConfirmRename(string oldName)
    {
        var newName = _renameBuffer.Trim();
        _renamingProfile = null;
        _renameBuffer = "";
        if (string.IsNullOrEmpty(newName) || newName == oldName) return;
        if (AllProfiles.Any(p => p.Name == newName))
        {
            ShowNotice("err", LocService.Tr("已存在同名存档：") + newName);
            return;
        }
        try
        {
            var key = ProfileGameKey;
            var p = Cfg.Current.ModProfiles.FirstOrDefault(x =>
                x.Name == oldName
                && string.Equals(x.GameVersion, key, StringComparison.OrdinalIgnoreCase));
            if (p is not null) p.Name = newName;
            if (ActiveProfileName == oldName) SetActiveProfileName(newName);
            Cfg.Save(Cfg.Current);
            ShowNotice("ok", LocService.Tf("已重命名为「{0}」", newName));
        }
        catch (Exception ex) { ShowNotice("err", LocService.Tr("重命名失败：") + ex.Message); }
    }

    /// <summary>点存档项切换：应用后收起下拉 —— 切换完成即收，与常规下拉交互一致
    /// （旧版故意保持打开想方便连续切换，实测反而像「没切上、关不掉」）。</summary>
    private async Task ApplyProfileAndClose(string name)
    {
        await ApplyProfile(name);
        if (_profileOpen)
        {
            _profileOpen = false;
            _addingProfile = false; _newProfileName = "";
            try { await JS.InvokeVoidAsync("junigridJs.dropdownToggle", ".jg-profile-dd", false); } catch { }
        }
    }

    private bool _addingProfile;
    private string _newProfileName = "";
    private string? _deletingProfile;

    /// <summary>当前游戏版本的存档键（展示号，如 1.6.15 / 1.4 / 1.0）。切版本后存档互不串。</summary>
    private string ProfileGameKey =>
        UpdateService.DisplayGameVersion(
            _gameVer ?? Updater.GetGameVersion(Cfg.Current.GamePath),
            Cfg.Current.LastHistoricalLabel,
            Cfg.Current.LastHistoricalInternalVersion);

    private List<ModProfile> AllProfiles
    {
        get
        {
            var key = ProfileGameKey;
            // 迁移：旧配置里没写 GameVersion 的存档，归到当前版本（只迁一次）
            var migrated = false;
            foreach (var p in Cfg.Current.ModProfiles)
            {
                if (string.IsNullOrWhiteSpace(p.GameVersion))
                {
                    p.GameVersion = key;
                    migrated = true;
                }
            }
            if (migrated)
            {
                if (!Cfg.Current.ActiveProfileByGame.ContainsKey(key)
                    && !string.IsNullOrWhiteSpace(Cfg.Current.ActiveProfile))
                    Cfg.Current.ActiveProfileByGame[key] = Cfg.Current.ActiveProfile;
            }

            var list = Cfg.Current.ModProfiles
                .Where(p => string.Equals(p.GameVersion, key, StringComparison.OrdinalIgnoreCase))
                .ToList();
            // v1.08：按名字（忽略大小写）去重 —— 历史 bug 曾写入重名档
            var deduped = new List<ModProfile>();
            foreach (var p in list)
            {
                var same = deduped.FirstOrDefault(x => x.Name.Equals(p.Name, StringComparison.OrdinalIgnoreCase));
                if (same is null) { deduped.Add(p); continue; }
                if ((same.EnabledModUids?.Count ?? 0) == 0 && (p.EnabledModUids?.Count ?? 0) > 0)
                    deduped[deduped.IndexOf(same)] = p;
            }
            if (deduped.Count == 0 || deduped[0].Name != "默认")
                deduped.Insert(0, new ModProfile { Name = "默认", GameVersion = key });
            return deduped;
        }
    }

    private string ActiveProfileName
    {
        get
        {

    @* ── v1.2.0：依赖安装结果弹窗（手动项附 Nexus 链接）──
       v1.3.4：已删除 —— 手动依赖的页面本来就会自动在浏览器打开，结果弹窗是重复打扰；
       任务中心的完成摘要（"已安装 X 个；Y 个需手动"）足够。 *@

@code {
    private IReadOnlyList<ModEntry> _mods = Array.Empty<ModEntry>();
    // v1.1.6：folder → 条目索引。批量操作条与选中清理原先用 FirstOrDefault/Any 全表扫
    //（选中数 × mod 数），几百 mod + 多选时每次渲染做几万次字符串比较。
    private Dictionary<string, ModEntry> _modsByFolder = new(StringComparer.OrdinalIgnoreCase);
    // v0.59.0：首次进入页面的 shimmer 加载态
    private bool _initialLoading = true;
    // v0.60.0：更新检查期间的 shimmer 加载态
    private bool _checkingUpdates = false;
    private string _apiKey = "";
    private string? _smapiVersion;
    private string? _gameVer;

    /// <summary>展示用游戏版本：历史切换后用营销号（1.0），而不是 exe 内部号（1.0.5900）。</summary>
    private string GameVerDisplay
    {
        get
        {
            var cfg = Cfg.Current;
            return UpdateService.DisplayGameVersion(
                _gameVer ?? Updater.GetGameVersion(cfg.GamePath),
                cfg.LastHistoricalLabel,
                cfg.LastHistoricalInternalVersion);
        }
    }

    /// <summary>游戏本体不是 1.6+ 时，最新 SMAPI 4.x 不兼容，禁止一键装 4.x。</summary>
    private bool SmapNeedsOld
    {
        get
        {
            var g = _gameVer ?? Updater.GetGameVersion(Cfg.Current.GamePath);
            if (string.IsNullOrWhiteSpace(g)) return false;
            return UpdateService.RecommendSmapiTag(g) != UpdateService.SmapiLatest;
        }
    }

    private string SmapRecommendShort
    {
        get
        {
            var tag = UpdateService.RecommendSmapiTag(_gameVer);
            if (tag is null) return "无一键适配包";
            if (tag == UpdateService.SmapiLatest) return "SMAPI 4.x";
            return "SMAPI " + tag;
        }
    }

    /// <summary>本地推荐 tag（不联网）。历史版按钮文案/是否可装都用它，不等 GitHub。</summary>
    private string? SmapRecommendTag =>
        UpdateService.RecommendSmapiTag(_gameVer ?? Updater.GetGameVersion(Cfg.Current.GamePath));

    /// <summary>v1.1.9：旧版游戏要装适配 SMAPI —— 未装，或已装大版本与推荐不符。纯本地判定，按钮秒出。</summary>
    private bool NeedsCompatibleOldSmapi
    {
        get
        {
            if (SmapiUnsupported) return false;
            var tag = SmapRecommendTag;
            if (tag is null || tag == UpdateService.SmapiLatest) return false;
            return _smapiVersion is null || !SmapiMatchesRecommend(_smapiVersion, tag);
        }
    }

    private string CompatibleOldSmapiLabel
    {
        get
        {
            var tag = SmapRecommendTag;
            return tag is null || tag == UpdateService.SmapiLatest ? SmapRecommendShort : "SMAPI " + tag;
        }
    }

    /// <summary>过旧版本（1.0/1.1 等）：没有 GitHub 一键包，按钮只链到 Nexus。</summary>
    private bool SmapiUnsupported => UpdateService.IsSmapiUnsupported(_gameVer ?? Updater.GetGameVersion(Cfg.Current.GamePath));

    /// <summary>v1.1.8：已装 SMAPI 是否已落在推荐的大版本线上（3.7.3 vs 3.7 算匹配；4.x vs 3.x 不匹配）。</summary>
    private static bool SmapiMatchesRecommend(string installed, string recommended)
    {
        if (string.IsNullOrWhiteSpace(installed) || string.IsNullOrWhiteSpace(recommended)) return false;
        var a = installed.Split('.');
        var b = recommended.Split('.');
        // 推荐 3.x → 装的必须是 3.x；推荐 2.x → 装的必须是 2.x
        return a.Length > 0 && b.Length > 0 && a[0] == b[0];
    }

    private string SmapRecommendUrl
    {
        get
        {
            var (_, url) = UpdateService.RecommendSmapi(_gameVer);
            return url ?? "https://www.nexusmods.com/stardewvalley/mods/2400?tab=files";
        }
    }
    private string? _smapiIcon;
    private SmapiUpdateInfo? _smapiUpdate;
    private bool _smapiUpdating;
    private ModEntry? _pendingDeleteMod;   // 待确认删除的单个 mod（弹窗确认后真正卸载）
    private ModEntry? _pendingConvert;     // 待确认「转成 CP 肖像包」的裸素材目录
    private bool _pendingBatchDelete;      // 待确认的批量删除（弹窗确认后真正卸载）
    // v1.09：删除确认弹窗里的"移入mod回收站"复选框 —— 默认不勾（沿用旧的彻底删除），
    // 勾选后删除的 mod 进 Mods/.junigrid_trash 常驻回收站，可从 设置→存储 打开手动还原
    private bool _deleteToTrash;
    private bool _coversDirty;

    // ---- 备注/重命名弹窗 ----
    private string? _remarkFolder;      // null = 弹窗关闭；否则为当前编辑备注的 mod Folder
    private string _remarkOriginal = "";
    private string _remarkInput = "";

    // ---- 过滤 / 分组 / 依赖缺失 ----
    private string _filter = "all";
    private string SearchText { get; set; } = "";

    // v0.32.0：排序（alpha 首字母 / time-desc 时间倒序 / time-asc 时间正序）+ 下拉/搜索展开状态
    private string _sortMode = "time-asc";
    private bool _sortOpen;
    private bool _searchOpen;

    // ── v0.46.0：存档（Profile）系统，仿 Stardrop ──
    private bool _profileOpen;
    private string? _renamingProfile;
    private string _renameBuffer = "";

    /// <summary>v0.71.1：双击开启重命名。</summary>
    private void StartRenameProfile(string name)
    {
        _renamingProfile = name;
        _renameBuffer = name;
        // v1.08：改名时收起存档下拉 —— 输入框+确定按钮已经独立成头，下拉继续开着
        // 只会挡视线，还允许同时点别的存档项，状态容易乱。
        if (_profileOpen)
        {
            _profileOpen = false;
            _ = JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false);
        }
    }

    private void OnRenameKey(KeyboardEventArgs e, string oldName)
    {
        if (e.Key == "Enter") _ = ConfirmRename(oldName);
        else if (e.Key == "Escape") { _renamingProfile = null; _renameBuffer = ""; }
    }

    private async Task ConfirmRename(string oldName)
    {
        var newName = _renameBuffer.Trim();
        _renamingProfile = null;
        _renameBuffer = "";
        if (string.IsNullOrEmpty(newName) || newName == oldName) return;
        if (AllProfiles.Any(p => p.Name == newName))
        {
            ShowNotice("err", "已存在同名存档：" + newName);
            return;
        }
        try
        {
            var key = ProfileGameKey;
            var p = Cfg.Current.ModProfiles.FirstOrDefault(x =>
                x.Name == oldName
                && string.Equals(x.GameVersion, key, StringComparison.OrdinalIgnoreCase));
            if (p is not null) p.Name = newName;
            if (ActiveProfileName == oldName) SetActiveProfileName(newName);
            Cfg.Save(Cfg.Current);
            ShowNotice("ok", $"已重命名为「{newName}」");
        }
        catch (Exception ex) { ShowNotice("err", "重命名失败：" + ex.Message); }
    }

    /// <summary>点存档项切换：应用后收起下拉 —— 切换完成即收，与常规下拉交互一致
    /// （旧版故意保持打开想方便连续切换，实测反而像「没切上、关不掉」）。</summary>
    private async Task ApplyProfileAndClose(string name)
    {
        await ApplyProfile(name);
        if (_profileOpen)
        {
            _profileOpen = false;
            _addingProfile = false; _newProfileName = "";
            try { await JS.InvokeVoidAsync("junigridJs.profileDropdown", ".jg-profile-dd", false); } catch { }
        }
    }

    private bool _addingProfile;
    private string _newProfileName = "";
    private string? _deletingProfile;

    /// <summary>当前游戏版本的存档键（展示号，如 1.6.15 / 1.4 / 1.0）。切版本后存档互不串。</summary>
    private string ProfileGameKey =>
        UpdateService.DisplayGameVersion(
            _gameVer ?? Updater.GetGameVersion(Cfg.Current.GamePath),
            Cfg.Current.LastHistoricalLabel,
            Cfg.Current.LastHistoricalInternalVersion);

    private List<ModProfile> AllProfiles
    {
        get
        {
            var key = ProfileGameKey;
            // 迁移：旧配置里没写 GameVersion 的存档，归到当前版本（只迁一次）
            var migrated = false;
            foreach (var p in Cfg.Current.ModProfiles)
            {
                if (string.IsNullOrWhiteSpace(p.GameVersion))
                {
                    p.GameVersion = key;
                    migrated = true;
                }
            }
            if (migrated)
            {
                if (!Cfg.Current.ActiveProfileByGame.ContainsKey(key)
                    && !string.IsNullOrWhiteSpace(Cfg.Current.ActiveProfile))
                    Cfg.Current.ActiveProfileByGame[key] = Cfg.Current.ActiveProfile;
            }

            var list = Cfg.Current.ModProfiles
                .Where(p => string.Equals(p.GameVersion, key, StringComparison.OrdinalIgnoreCase))
                .ToList();
            // v1.08：按名字（忽略大小写）去重 —— 历史 bug 曾写入重名档
            var deduped = new List<ModProfile>();
            foreach (var p in list)
            {
                var same = deduped.FirstOrDefault(x => x.Name.Equals(p.Name, StringComparison.OrdinalIgnoreCase));
                if (same is null) { deduped.Add(p); continue; }
                if ((same.EnabledModUids?.Count ?? 0) == 0 && (p.EnabledModUids?.Count ?? 0) > 0)
                    deduped[deduped.IndexOf(same)] = p;
            }
            if (deduped.Count == 0 || deduped[0].Name != "默认")
                deduped.Insert(0, new ModProfile { Name = "默认", GameVersion = key });
            return deduped;
        }
    }


    }

    private void ConfirmCategoryRename()
    {
        var from = _categoryRenameFrom;
        if (from is null) return;
        var to = _categoryRenameDraft.Trim();
        if (to.Length == 0) { _categoryDialogError = Loc.T("先输入一个分类名"); return; }
        if (to.Length > 20) to = to[..20];
        if (string.Equals(from, to, StringComparison.OrdinalIgnoreCase)) { _categoryRenameFrom = null; _categoryDialogError = null; return; }
        var cfg = Cfg.Current;
        foreach (var k in cfg.ModUserCategory
                     .Where(kv => string.Equals(kv.Value, from, StringComparison.OrdinalIgnoreCase))
                     .Select(kv => kv.Key).ToList())
            cfg.ModUserCategory[k] = to;
        var idx = cfg.ModUserCategoryOrder.FindIndex(x => string.Equals(x, from, StringComparison.OrdinalIgnoreCase));
        if (idx >= 0)
        {
            if (!cfg.ModUserCategoryOrder.Contains(to, StringComparer.OrdinalIgnoreCase)) cfg.ModUserCategoryOrder[idx] = to;
            else cfg.ModUserCategoryOrder.RemoveAt(idx);
        }
        else if (!cfg.ModUserCategoryOrder.Contains(to, StringComparer.OrdinalIgnoreCase))
            cfg.ModUserCategoryOrder.Add(to);
        // 图标跟着分类走：不改这一项的话，用户挑好的图会在改名后掉回默认小鸡
        var iconKey = cfg.ModCategoryIcon.Keys.FirstOrDefault(k => string.Equals(k, from, StringComparison.OrdinalIgnoreCase));
        if (iconKey is not null)
        {
            var spec = cfg.ModCategoryIcon[iconKey];
            cfg.ModCategoryIcon.Remove(iconKey);
            cfg.ModCategoryIcon[to] = spec;
        }
        Cfg.Save(cfg);
        if (_collapsedCats.Remove(from)) _collapsedCats.Add(to);
        _categoryRev++;
        _categoryRenameFrom = null;
        _categoryDialogError = null;
        ShowNotice("ok", LocService.Tf("已重命名为「{0}」", to));
        StateHasChanged();
    }

    private void DeleteCategory(string name)
    {
        _categoryMenu = null;
        var cfg = Cfg.Current;
        // 值可能是多选拼起来的 "a,b" —— 逐条拆开判断，只摘掉要删的那个名字，
        // 其余分类原样留着（旧写法比整串，多选条目根本匹配不上，会留下悬空的分类名）。
        foreach (var (k, v) in cfg.ModUserCategory.ToList())
        {
            var parts = ModCategoryUtil.Split(v);
            if (!parts.Any(x => string.Equals(x, name, StringComparison.OrdinalIgnoreCase))) continue;
            var rest = parts.Where(x => !string.Equals(x, name, StringComparison.OrdinalIgnoreCase)).ToArray();
            if (rest.Length == 0) cfg.ModUserCategory.Remove(k);
            else cfg.ModUserCategory[k] = ModCategoryUtil.Join(rest);
        }
        cfg.ModUserCategoryOrder.RemoveAll(x => string.Equals(x, name, StringComparison.OrdinalIgnoreCase));
        // 分类没了，它的图标也没意义 —— 留着只会在下次建同名分类时"诈尸"
        var deadIcon = cfg.ModCategoryIcon.Keys.FirstOrDefault(k => string.Equals(k, name, StringComparison.OrdinalIgnoreCase));
        if (deadIcon is not null) cfg.ModCategoryIcon.Remove(deadIcon);
        Cfg.Save(cfg);
        _collapsedCats.Remove(name);
        _categoryRev++;
        if (_categoryHover == name) _categoryHover = null;
        ShowNotice("ok", LocService.Tf("已删除分类「{0}」，里面的 mod 已移到未分类", name));
        StateHasChanged();
    }

    /// <summary>悬停导航杠：点亮这根杠，并把卡片挪到它旁边。卡片只能待在滚动区外面（否则被
    /// overflow 裁掉），所以它的高度得由 JS 量出那根杠的位置再写进 CSS 变量 —— 以前卡片钉在
    /// 整列的中部，悬停最上面那根杠时卡片却出现在屏幕中间。</summary>
    private void HoverCategory(string key)
    {
        _categoryHover = key;
        var i = _categorySections.FindIndex(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase));
        if (i >= 0) _ = JS.InvokeVoidAsync("junigridJs.setCatCardY", i);
    }

    /// <summary>点右侧导航：目标段可能还在渐进渲染之外（首帧只画 40 行）——先全画，
    /// 渲染完再滚（见 OnAfterRenderAsync 里的 _pendingCategoryAnchor）。</summary>
    private async Task ScrollToCategory(string key)
    {
        var anchor = CatHeadAnchor(key);
        // v1.3.48：段头本来就画出来了（前面那几十行里的段）就直接滚，别再把整份列表一次画完。
        // 全量渲染 200+ 行实测两次占住 UI 线程约 350ms —— 点最上面那根杠换来的是这一下卡顿，
        // 而落点本来就就在屏幕上，等于白闪。
        var rendered = false;
        try { rendered = await JS.InvokeAsync<bool>("junigridJs.hasElement", anchor); } catch { }
        if (rendered)
        {
            try { await JS.InvokeVoidAsync("junigridJs.scrollToCategory", anchor); } catch { }
            return;
        }
        _renderLimit = 0;
        _pendingCategoryAnchor = anchor;
        StateHasChanged();
    }

    /// <summary>按当前行序切出分类段（段名/数量/前几个 mod 名），顺带给右侧导航的序号。
    /// 只统计当前视图里看得见的行 —— 筛选/搜索之后导航与列表说的是同一批东西。
    /// <para>返回值 = 这次到底要不要分段。以前是「清空登记表 + 把 SectionHeader 改 null」的
    /// 副作用式退场，但调用方紧接着又把 SectionHeader 赋了回来 —— 结果段头照样画、登记表却是
    /// 空的，所有段都拿到兜底序号 0、段体共用 jg-cat-body-0，点一个空分类会把有 mod 的那段
    /// 折叠掉（2026-11-08 实机）。改成明确返回，由调用方决定平铺。</para></summary>
    private bool BuildCategorySections(IReadOnlyList<ModGroup> groups)
    {
        _categorySections = new List<CategorySection>();
        // v1.3.47：分类不再是一种排序方式 —— 这个函数只按「当前有没有分类」决定画不画，
        // 不能再拿 _sortMode 当闸门（那样段头照画、右侧导航却永远是空的）。
        foreach (var g in groups)
        {
            var key = CategoryOfGroup(g);
            var sec = _categorySections.FirstOrDefault(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase));
            if (sec is null)
            {
                sec = new CategorySection { Key = key, Label = key.Length > 0 ? key : Loc.T("未分类"), Index = _categorySections.Count };
                _categorySections.Add(sec);
            }
            sec.Count += g.Items.Count;
            if (sec.Names.Count < 8)
                sec.Names.Add(g.Key.Length > 0 ? g.Key : g.Items[0].Name);
        }
        // 一个自定义分类都没有时，「按分类」等价于全部未分类 —— 别摆一根只有「未分类」的导航杠
        // 和一行孤零零的段头，直接按普通列表画。
        // ⚠ 必须连「有没有自定义分类」一起判：只有「未分类」在的时候才退化。否则
        // 「分类都空着（mod 全在未分类）」也会走进来直接 return，空分类既没段头也没导航杠
        // —— 2026-11-07 用户反馈「侧边栏不显示这个无 mod 的标签」。
        if (ExistingCategories().Count == 0
            && _categorySections.Count == 1 && _categorySections[0].Key.Length == 0)
        {
            _categorySections.Clear();
            return false;                       // 调用方按普通列表画（不要把 SectionHeader 赋回去）
        }

        // v1.3.78：**没有任何 mod 的分类也要画段头**。
        // 段头就是长按拖拽的落点（data-cat-key），空分类不画等于「新建了分类却拖不进去」
        // —— 2026-11-07 用户反馈。补一个 Groups 为空的段即可：不占行、但能接 drop。
        // v1.3.83：只在「全部 + 没搜索」时补 —— 那是唯一能拖拽的视图，也是空分类唯一有用的场合。
        // 已启用/已禁用/可更新这类筛选下，一个没有成员的分类只会白占一行（用户同日要求）。
        if (_filter == "all" && string.IsNullOrWhiteSpace(SearchText))
        {
            foreach (var c in ExistingCategories())
                if (!_categorySections.Any(x => string.Equals(x.Key, c, StringComparison.OrdinalIgnoreCase)))
                    _categorySections.Add(new CategorySection { Key = c, Label = c, Index = _categorySections.Count });
        }

        // 重排：**和拖动/列表排序用同一个口径**（CategoryDisplayOrder，屏上从上到下）。
        // 这里以前是「名单去掉未分类 → 倒排 → 未分类垫底」，和列表排序、拖动那两套各自为政，
        // 于是空分类补出来的位置、拖动算出来的位置、屏上的位置三者对不上
        // —— 拖动看起来「拖了但没动」（2026-11-09 用户反馈）。
        var dispOrder = CategoryDisplayOrder();
        _categorySections = _categorySections
            .OrderBy(s =>
            {
                var i = dispOrder.FindIndex(x => string.Equals(x, s.Key, StringComparison.OrdinalIgnoreCase));
                return i < 0 ? int.MaxValue : i;         // 没登记的段排最后
            })
            .ToList();
        // 重编 Index —— 只管「段的先后」与右侧导航的次序（段体的 DOM id 已改成按名字取，
        // 不再依赖这个序号：序号一旦和屏上的段对不上就会指错人）
        for (var i = 0; i < _categorySections.Count; i++) _categorySections[i].Index = i;
        return true;
    }

    // v0.41.0：全选当前过滤结果（只选看得见的，避免误选被过滤掉的）

    private void OnRenameKey(KeyboardEventArgs e, string oldName)
    {
        if (e.Key == "Enter") _ = ConfirmRename(oldName);
        else if (e.Key == "Escape") { _renamingProfile = null; _renameBuffer = ""; }
    }

    private async Task ConfirmRename(string oldName)
    {
        var newName = _renameBuffer.Trim();
        _renamingProfile = null;
        _renameBuffer = "";
        if (string.IsNullOrEmpty(newName) || newName == oldName) return;
        if (AllProfiles.Any(p => p.Name == newName))
        {
            ShowNotice("err", LocService.Tr("已存在同名存档：") + newName);
            return;
        }
        try
        {
            var key = ProfileGameKey;
            var p = Cfg.Current.ModProfiles.FirstOrDefault(x =>
                x.Name == oldName
                && string.Equals(x.GameVersion, key, StringComparison.OrdinalIgnoreCase));
            if (p is not null) p.Name = newName;
            if (ActiveProfileName == oldName) SetActiveProfileName(newName);
            Cfg.Save(Cfg.Current);
            ShowNotice("ok", LocService.Tf("已重命名为「{0}」", newName));
        }
        catch (Exception ex) { ShowNotice("err", LocService.Tr("重命名失败：") + ex.Message); }
    }


    private void CloseCategoryDialog() { _categoryDialogOpen = false; _categoryNewOpen = false; _categoryDialogError = null; }
    private async Task OnCategoryNameInput(ChangeEventArgs e)
    {
        _categoryNewName = e.Value?.ToString() ?? "";
        _categoryDialogError = null;
        try { await JS.InvokeVoidAsync("junigridJs.remarkCountBump", _categoryNewName.Length >= 20, ".jg-cat-count-new"); } catch { }
    }

    private async Task OnCategoryRenameInput(ChangeEventArgs e)
    {
        _categoryRenameDraft = e.Value?.ToString() ?? "";
        _categoryDialogError = null;
        try { await JS.InvokeVoidAsync("junigridJs.remarkCountBump", _categoryRenameDraft.Length >= 20, ".jg-cat-count-rename"); } catch { }
    }

    private void OnCategoryNameKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") CreateCategoryFromInput();
        else if (e.Key == "Escape") CloseCategoryDialog();
        else if (_categoryNewName.Length >= 20 && e.Key.Length == 1)
            _ = JS.InvokeVoidAsync("junigridJs.remarkCountBump", true, ".jg-cat-count-new");
    }

    private void OnCategoryRenameKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ConfirmCategoryRename();
        else if (e.Key == "Escape") { _categoryRenameFrom = null; _categoryDialogError = null; }
        else if (_categoryRenameDraft.Length >= 20 && e.Key.Length == 1)
            _ = JS.InvokeVoidAsync("junigridJs.remarkCountBump", true, ".jg-cat-count-rename");
    }

    private void CreateCategoryFromInput()
    {
        var name = _categoryNewName.Trim();
        if (name.Length == 0) { _categoryDialogError = Loc.T("先输入一个分类名"); return; }
        if (name.Length > 20) name = name[..20];
        var icon = _categoryNewIcon;
        AssignSelectedCategory(name);
        // 新建行前面那颗图标：建的时候一起落盘（还是默认小鸡就不写配置 —— 默认值不占键）
        if (!string.Equals(icon, CategoryIconService.DefaultSpec, StringComparison.OrdinalIgnoreCase)
            && Cfg.Current.ModUserCategoryOrder.Contains(name, StringComparer.OrdinalIgnoreCase))
        {
            Cfg.Current.ModCategoryIcon[name] = icon;
            Cfg.Save(Cfg.Current);
        }
        _categoryNewIcon = CategoryIconService.DefaultSpec;
    }

    private void AssignSelectedCategory(string? category)
    {
        var cfg = Cfg.Current;
        var tops = _categoryTargets
            .Select(f => _modsByFolder.TryGetValue(f, out var m) ? CategoryKeyOf(m) : null)
            .Where(k => !string.IsNullOrWhiteSpace(k)).Select(k => k!)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (tops.Count == 0) return;
        var name = category?.Trim() ?? "";
        foreach (var k in tops)
        {
            if (name.Length == 0) cfg.ModUserCategory.Remove(k);
            else cfg.ModUserCategory[k] = name;
        }
        if (name.Length > 0 && !cfg.ModUserCategoryOrder.Contains(name, StringComparer.OrdinalIgnoreCase))
            cfg.ModUserCategoryOrder.Add(name);
        Cfg.Save(cfg);
        _categoryRev++;
        _categoryDialogOpen = false;
        _categoryNewOpen = false;
        _categoryDialogError = null;
        // v1.3.48：这里以前写死 `_sortMode = "cat"` —— 分类早就不是一种排序方式了，那一行会把
        // 用户选的「首字母 / 最早在前」悄悄改成按名字排。分段本来就在 Groups 里做，不需要动排序。
        ClearSelection();
        ShowNotice("ok", name.Length == 0
            ? LocService.Tf("已把 {0} 项移出分类", tops.Count)
            : LocService.Tf("已把 {0} 项加入「{1}」", tops.Count, name));
        StateHasChanged();
    }

    private void ToggleCategoryMenu(string key) => _categoryMenu = _categoryMenu == key ? null : key;

    // ─────────────────────── 2026-11-09：分类图标 ───────────────────────
    // 图标值只存一个短字符串（logo / portrait:Abigail / item:72），真图由
    // CategoryIconService 从游戏本体 XNB 现裁现缓存 —— 配置里不塞 base64，
    // 换游戏目录、换贴图包都会自动跟着变。

    private bool _iconPickOpen;
    /// <summary>正在改图标的分类（"" = 未分类，它是合法值，所以用单独的 open 标记而不是 null 判空）。</summary>
    private string _iconPickKey = "";
    private string _iconTab = "default";
    private string _iconSearch = "";
    /// <summary>角色清单按游戏目录缓存一次：每次渲染都去枚举 148 个文件太浪费。</summary>
    private List<CategoryIconService.IconOption>? _iconPortraits;
    private string? _iconPortraitsFor;
    /// <summary>物品全量清单（700+ 件，首次解析 xnb 约 100ms，之后走缓存）。</summary>
    private List<CategoryIconService.IconOption>? _iconItems;
    private string? _iconItemsFor;
    /// <summary>物品网格一次画多少格 —— 700 个 &lt;img&gt; 一口气铺出来会卡，滚到底再续。</summary>
    private int _iconItemLimit = 140;
    private const int IconItemBatch = 140;
    /// <summary>滚动监听挂没挂（对话框一开就挂；元素随对话框销毁，关闭时复位）。</summary>
    private bool _iconScrollBound;
    private DotNetObjectReference<Mods>? _iconScrollRef;
    private bool _thumbRefreshQueued;

    private string IconSpecOf(string key)
        => key == NewCatIconKey
            ? CategoryIconService.NormalizeSpec(_categoryNewIcon)
            : key == LocalNewCatIconKey
                ? CategoryIconService.NormalizeSpec(_localPackNewIcon)
                : Cfg.Current.ModCategoryIcon.TryGetValue(key, out var s)
                    ? CategoryIconService.NormalizeSpec(s)
                    : CategoryIconService.DefaultSpec;

    /// <summary>段头那颗图标的 URL（还没生成好时返回 null，先画占位）。</summary>
    private string? CategoryIconUrl(string key)
        => CategoryIconService.Url(IconSpecOf(key), Cfg.Current.GamePath);

    private string IconCategoryLabel(string key)
        => key == NewCatIconKey ? Loc.T("新分类")
           : key == LocalNewCatIconKey ? Loc.T("新分类")
           : key.Length > 0 ? key : Loc.T("未分类");

    private void OpenIconPicker(string key)
    {
        _iconPickKey = key;
        _iconTab = "default";
        _iconSearch = "";
        _iconItemLimit = 140;
        _iconPickOpen = true;
        _iconScrollBound = false;     // 对话框是新元素，滚动监听要重新挂
        _categoryMenu = null;
        // 700 多件物品要解析两个 xnb：后台先热一遍，等用户点「物品」页签时基本上已经好了
        ItemCatalogService.Prewarm(Cfg.Current.GamePath);
    }

    private void CloseIconPicker()
    {
        _iconPickOpen = false;
        _iconScrollBound = false;
    }

    private void SwitchIconTab(string tab)
    {
        if (_iconTab == tab) return;
        _iconTab = tab;
        _iconSearch = "";
        _iconItemLimit = 140;
    }

    private void OnIconSearch(ChangeEventArgs e)
    {
        _iconSearch = e.Value?.ToString() ?? "";
        _iconItemLimit = 140;          // 换了搜索词就从第一批重新铺
    }

    /// <summary>当前页签下没画出来的条目数（只有物品页签会截断）。</summary>
    private int IconHiddenCount()
    {
        if (_iconTab != "item") return 0;
        var all = IconItemSource().Count;
        return Math.Max(0, all - _iconItemLimit);
    }

    /// <summary>JS 那边滚到底时回调：再铺一批（顺便把额度封顶，避免越滚越多次空调用）。</summary>
    [JSInvokable]
    public void LoadMoreIcons()
    {
        if (_disposed || !_iconPickOpen || _iconTab != "item") return;
        if (IconHiddenCount() <= 0) return;
        _iconItemLimit += IconItemBatch;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>物品全量清单（搜索过滤后）。</summary>
    private List<CategoryIconService.IconOption> IconItemSource()
    {
        var gp = Cfg.Current.GamePath;
        if (_iconItems is null || !string.Equals(_iconItemsFor, gp, StringComparison.OrdinalIgnoreCase))
        {
            _iconItems = CategoryIconService.Items(gp);
            _iconItemsFor = gp;
        }
        var q = _iconSearch.Trim();
        if (q.Length == 0) return _iconItems;
        return _iconItems
            .Where(o => o.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private IEnumerable<CategoryIconService.IconOption> IconOptions()
    {
        switch (_iconTab)
        {
            case "portrait":
            {
                var gp = Cfg.Current.GamePath;
                if (_iconPortraits is null || !string.Equals(_iconPortraitsFor, gp, StringComparison.OrdinalIgnoreCase))
                {
                    _iconPortraits = CategoryIconService.Portraits(gp);
                    _iconPortraitsFor = gp;
                }
                var q = _iconSearch.Trim();
                if (q.Length == 0) return _iconPortraits;
                return _iconPortraits
                    .Where(o => o.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                                || o.Spec.Contains(q, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            case "item":                return IconItemSource().Take(_iconItemLimit);
            default:
                // 2026-11-09：木牌 Logo 选项已删（400×220 的横条缩进方框只剩一条糊影，
                // 谁也不会真选它）——「默认」页签只剩那只鸡，也就是不设图标时的样子。
                return new[]
                {
                    new CategoryIconService.IconOption(CategoryIconService.DefaultSpec, Loc.T("星露谷小鸡"), "默认"),
                };
        }
    }

    /// <summary>「加入分类」列表里每行前面那颗图标（点一下就地换图标）。
    /// 没设过的分类走默认小鸡 —— 所以新建出来的分类天然带着小鸡图标。</summary>
    private RenderFragment CatIconButton(string key, string extraClass) => @<button
        type="button" class="jg-cat-icon @extraClass" data-tip='@Loc.T("点图标换一个")'
        aria-label='@Loc.T("点图标换一个")'
        @onclick="() => OpenIconPicker(key)" @onclick:stopPropagation="true">
        @if (CategoryIconUrl(key) is { } u)
        {
            <img src="@u" alt="" draggable="false" loading="lazy" decoding="async" />
        }
        else
        {
            <span class="jg-cat-icon-ph"></span>
        }
    </button>;

    private RenderFragment IconOptionButton(CategoryIconService.IconOption opt, string curSpec) => @<button        type="button" class="jg-icon-opt @(string.Equals(opt.Spec, curSpec, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
        data-tip="@opt.Name" @onclick="() => SetCategoryIcon(opt.Spec)">
        <span class="jg-icon-opt-img">
            @if (CategoryIconService.Url(opt.Spec, Cfg.Current.GamePath) is { } u)
            {
                <img src="@u" alt="" loading="lazy" decoding="async" />
            }
        </span>
        <span class="jg-icon-opt-name">@opt.Name</span>
    </button>;

    /// <summary>选定即落盘（点一下就走）。选回默认（小鸡）等于清掉这一项 —— 配置里不留下无意义的键。</summary>
    private void SetCategoryIcon(string spec)
    {
        var normalized = CategoryIconService.NormalizeSpec(spec);
        // 还在"新建分类"这一步：图先记在草稿上，等「新建并加入」时跟分类名一起落盘
        if (_iconPickKey == NewCatIconKey)
        {
            _categoryNewIcon = normalized;
            _iconPickOpen = false;
            _iconScrollBound = false;
            StateHasChanged();
            return;
        }
        // 本地导入弹窗里的新建行 —— 另一份草稿，别串到「加入分类」那一份去
        if (_iconPickKey == LocalNewCatIconKey)
        {
            _localPackNewIcon = normalized;
            _iconPickOpen = false;
            _iconScrollBound = false;
            StateHasChanged();
            return;
        }
        var cfg = Cfg.Current;
        if (string.Equals(normalized, CategoryIconService.DefaultSpec, StringComparison.OrdinalIgnoreCase))
            cfg.ModCategoryIcon.Remove(_iconPickKey);
        else
            cfg.ModCategoryIcon[_iconPickKey] = normalized;
        Cfg.Save(cfg);
        _iconPickOpen = false;
        _iconScrollBound = false;
        StateHasChanged();
    }

    /// <summary>XNB 解码是后台跑的一张一张出图：这里合并成"一批画一次"，
    /// 否则打开角色页签会连着重画一百多次（每次都要遍历整页）。</summary>
    private void OnThumbsChanged()
    {
        if (_disposed || _thumbRefreshQueued) return;
        _thumbRefreshQueued = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(220);
            _thumbRefreshQueued = false;
            if (!_disposed) StateHasChanged();
        });
    }

    /// <summary>段头复选框的三态：0 = 一个没选、1 = 选了一部分、2 = 全选。
    /// 口径与 <see cref="ToggleCategorySelectAll"/> 完全一致（都只看当前视图里的行），
    /// 否则会出现"框里打了勾、点一下却变成全不选"的错位。</summary>
    private int CategorySelectState(string key)
    {
        var total = 0;
        var picked = 0;
        foreach (var m in FilteredMods)
        {
            if (!string.Equals(CategoryOfMod(m), key, StringComparison.OrdinalIgnoreCase)) continue;
            total++;
            if (_selected.Contains(m.Folder)) picked++;
        }
        return total == 0 || picked == 0 ? 0 : picked == total ? 2 : 1;
    }

    /// <summary>勾上右侧复选框 = 全选 / 取消全选这一分类下的 mod。
    /// 只认<b>当前视图</b>里的行：搜索/筛选之后屏幕上有什么就选什么，
    /// 不把看不见的行也偷偷塞进选区（批量操作说的是"你看到的这些"）。</summary>
    private void ToggleCategorySelectAll(string key)
    {
        _categoryMenu = null;
        var set = FilteredMods
            .Where(m => string.Equals(CategoryOfMod(m), key, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (set.Count == 0) { StateHasChanged(); return; }
        var all = set.All(m => _selected.Contains(m.Folder));
        foreach (var m in set)
        {
            if (all) _selected.Remove(m.Folder);
            else _selected.Add(m.Folder);
        }
        StateHasChanged();
    }

    /// <summary>点段头：展开/收起这一段（只重排列表，不动盘上任何东西）。
    /// v1.3.49：先让 JS 播 height 0↔auto 的手风琴弹簧，动画回来再落折叠状态 ——
    /// 与捆绑包 ToggleGroupOpen 同一时序约束（先落状态会让 CSS 的 height:0 抢跑，动画空播）。</summary>
    private async Task ToggleCategoryCollapse(string key)
    {
        var collapse = !_collapsedCats.Contains(key);   // 本次动作：true = 收起
        try
        {
            // 按「分类名 → 稳定 id」取段体，不再按 _categorySections 的序号：
            // 序号和屏上的段对不上时（空分类未登记 / 平铺兜底清过登记表），
            // 序号会指到别人身上 —— 点空分类把有 mod 的那段折叠掉（2026-11-08 实机）。
            // 第二个参数是「是否展开」—— 与 collapse 相反，传反了就是收起时播展开（看着没反应）
            await JS.InvokeVoidAsync("junigridJs.catToggle", CatBodyAnchor(key), !collapse);
        }
        catch { }
        if (collapse) _collapsedCats.Add(key);
        else _collapsedCats.Remove(key);
        // 不作废 Groups 缓存：折叠/展开只改显示，行序与分组都没变（见 RenderedGroups 里的实时读）
        StateHasChanged();
    }

    // ── v1.3.51：长按拖拽的落点回调 ──
    // 手势本体在 junigrid.core.js（pointerdown 按住 320ms → ghost 跟手 → 松手）。
    // 这里只收两个字符串：源 key 与目标分类 key，映射与落库全在 C# 做：
    //   "c:分类名"      = 分类段头 → 重排分类
    //   "f:folder"      = 单个 mod 行
    //   "g:顶层目录"    = 整合成一行的那一包（整包一起归）
    // pos = "before"/"after"：落点在目标段头的上半还是下半。只有分类重排用得上
    //       （只看"落在哪个头上"分不清插在它前面还是后面 —— 界面上画的就是那条缝）。
    /// <summary>长按拖拽松手：源是分类 → 重排；源是 mod → 归入目标分类。</summary>
    [JSInvokable]
    public void OnLongPressDrop(string sourceKey, string targetCatKey, string pos = "")
    {
        if (string.IsNullOrEmpty(sourceKey)) return;

        if (sourceKey.StartsWith("c:", StringComparison.Ordinal))
        {
            MoveCategory(sourceKey[2..], targetCatKey, pos == "before");
            return;
        }

        var folders = FoldersOfDragKey(sourceKey);
        if (folders.Count == 0) return;

        var key = targetCatKey ?? "";
        var wasCollapsed = key.Length > 0 && _collapsedCats.Contains(key);
        AssignModsToCategory(folders, key);       // "" = 移出分类（丢到未分类段）
        if (wasCollapsed)
        {
            // 丢进一个折叠着的分类里，至少把它弹开让人看见结果（同款弹簧）
            _collapsedCats.Remove(key);
            _ = JS.InvokeVoidAsync("junigridJs.catToggle", CatBodyAnchor(key), true);
            StateHasChanged();
        }
    }

    /// <summary>v1.3.51 自检：等列表画出来后合成一次「按下 → 抬起」，看手势有没有被拿起。
    /// 只落在 mod 行自己身上（不落 drop），不会改分类数据；结果靠 OnDragProbe 的日志读。</summary>
    private async Task RunDragSelfTestAsync()
    {
        try
        {
            await Task.Delay(1500);
            if (_disposed) return;
            // ComponentBase 只有 InvokeAsync(Func<Task>)，没有泛型版 ⇒ 结果先落到局部量里
            string? r = null;
            await InvokeAsync(async () => r = await JS.InvokeAsync<string>("junigridJs.dragSelfTest"));
            AppLog.Info("Mods", "[拖动] 自检: " + (r ?? "(null)"));
        }
        catch (Exception ex) { AppLog.Warn("Mods", "[拖动] 自检失败: " + ex.Message); }
    }

    /// <summary>长按拖拽的阶段探针（来自 JS）：armed = 已拿起，drop = 松手落在某个分类上，
    /// drop-miss = 松手时指针下没有分类段头。只写日志，让「拖不动」能被定位到具体一步。</summary>
    [JSInvokable]
    public void OnDragProbe(string stage, string detail)
        => AppLog.Info("Mods", $"[拖动] {stage} {detail}");

    /// <summary>拖拽源 → 这一行实际代表哪些目录。整合行是整包，散装行就一个。</summary>
    private List<string> FoldersOfDragKey(string key)
    {
        if (key.StartsWith("f:", StringComparison.Ordinal))
            return new List<string> { key[2..] };
        if (key.StartsWith("g:", StringComparison.Ordinal))
        {
            var gk = key[2..];
            return _mods.Where(x => string.Equals(GroupKeyOf(x), gk, StringComparison.OrdinalIgnoreCase))
                        .Select(x => x.Folder).ToList();
        }
        return new List<string>();
    }

    /// <summary>把一个分类挪到另一个分类的前面/后面（重排 ModUserCategoryOrder）。
    /// before 来自落点：拖到目标段头上半 = 插到它前面，下半 = 插到它后面。
    /// ⚠ 名单是「倒序显示」的（末尾那条显示在最上面），所以统一换成「可见顺序」算、算完倒序写回；
    /// 可见顺序只有 <see cref="CategoryDisplayOrder"/> 一个来源，别再各自算一套。</summary>
    private void MoveCategory(string from, string to, bool before)
    {
        if (string.Equals(from, to, StringComparison.OrdinalIgnoreCase)) return;

        var disp = VisibleSectionOrder();
        var fi = disp.FindIndex(x => string.Equals(x, from, StringComparison.OrdinalIgnoreCase));
        var ti = disp.FindIndex(x => string.Equals(x, to, StringComparison.OrdinalIgnoreCase));
        if (fi < 0 || ti < 0) return;                        // 源/目标这两段现在没显示，没得挪

        var next = new List<string>(disp);
        next.RemoveAt(fi);
        var anchor = next.FindIndex(x => string.Equals(x, to, StringComparison.OrdinalIgnoreCase));
        if (anchor < 0) return;
        var at = before ? anchor : anchor + 1;               // 目标已因移除可能前移一格，重新定位
        if (at < 0) at = 0;
        if (at > next.Count) at = next.Count;
        next.Insert(at, from);

        if (next.SequenceEqual(disp, StringComparer.OrdinalIgnoreCase)) return;   // 挪了个寂寞，不落盘也不重画
        WriteCategoryOrder(next);
    }

    /// <summary>分类上移/下移一位 —— 长按拖拽之外的必经路径（也方便键盘/无鼠标场景）。</summary>
    private void MoveCategoryStep(string key, int dir)
    {
        var disp = VisibleSectionOrder();
        var i = disp.FindIndex(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase));
        var j = i + (dir < 0 ? -1 : 1);
        if (i < 0 || j < 0 || j >= disp.Count) return;
        (disp[i], disp[j]) = (disp[j], disp[i]);
        WriteCategoryOrder(disp);
    }

    /// <summary>分段视图的显示顺序（屏上从上到下）—— <b>唯一口径</b>：列表排序、空分类补位、
    /// 右侧导航、拖动重排全部走它。
    /// <para>名单是「从下往上」存的（末尾 = 显示最上），倒着读就是屏序。
    /// 「未分类」在这里就是一个普通的空字符串成员：名单里有它就按名单摆，没有（老配置）
    /// 才垫底 —— 以前这份顺序里把空字符串<b>过滤掉再单独垫底</b>，而排序又另外算了一套
    /// （<c>FindLastIndex + 1</c> 倒排），两边永远差一位：把未分类拖到最上，算出来的顺序
    /// 和原来完全相等，被当成「挪了个寂寞」直接丢掉；别的分类拖到未分类上下也一样没反应
    /// （2026-11-09 用户反馈「未分类不能拖动调整顺序、已分类的也拖不到它上下」）。</para>
    /// <para>名单里没登记的分类（老分类 / 手改过的配置）按名字插在「未分类」之前 ——
    /// 与旧的垫底口径一致，免得它们一出现就插进用户排好的队伍中间。</para></summary>
    private List<string> CategoryDisplayOrder()
    {
        var order = Cfg.Current.ModUserCategoryOrder;
        var disp = new List<string>();
        for (var i = order.Count - 1; i >= 0; i--)          // 名单倒着读 = 屏上从上到下
        {
            var c = order[i] ?? "";
            if (disp.Contains(c, StringComparer.OrdinalIgnoreCase)) continue;   // 脏配置去重
            disp.Add(c);
        }
        if (!disp.Contains("")) disp.Add("");                // 老配置没有未分类占位 → 垫底

        var extras = ExistingCategories()
            .Where(c => !disp.Contains(c, StringComparer.OrdinalIgnoreCase))
            .ToList();
        if (extras.Count > 0)
        {
            var at = disp.FindIndex(c => c.Length == 0);
            disp.InsertRange(at < 0 ? disp.Count : at, extras);
        }
        return disp;
    }

    /// <summary>段的「可见顺序」（= <see cref="CategoryDisplayOrder"/>，含 "" = 未分类）。
    /// 屏上确实显示了、但两个来源都没登记的段，按屏上的相对位置补进去 ——
    /// 否则一拖动就把它们丢了。</summary>
    private List<string> VisibleSectionOrder()
    {
        var disp = CategoryDisplayOrder();
        foreach (var sec in _categorySections)
            if (!disp.Contains(sec.Key, StringComparer.OrdinalIgnoreCase))
                disp.Add(sec.Key);
        return disp;
    }

    /// <summary>把可见顺序倒序写回名单并存盘。</summary>
    private void WriteCategoryOrder(List<string> visible)
    {
        var order = Cfg.Current.ModUserCategoryOrder;
        order.Clear();
        order.AddRange(visible.AsEnumerable().Reverse());
        Cfg.Save(Cfg.Current);
        _categoryRev++;
        StateHasChanged();
    }

    /// <summary>把一串 mod（folder 列表）归入某个分类。拖动 mod 行末端放到分类段头时走这里。</summary>
    private void AssignModsToCategory(IReadOnlyCollection<string> folders, string category)
    {
        var cfg = Cfg.Current;
        foreach (var f in folders)
        {
            var key = _modsByFolder.TryGetValue(f, out var m) ? CategoryKeyOf(m) : f;
            if (category.Length == 0) cfg.ModUserCategory.Remove(key);
            else cfg.ModUserCategory[key] = category;
        }
        if (category.Length > 0 && !cfg.ModUserCategoryOrder.Contains(category, StringComparer.OrdinalIgnoreCase))
            cfg.ModUserCategoryOrder.Add(category);
        Cfg.Save(cfg);
        _categoryRev++;
        StateHasChanged();
    }

    private void OpenCategoryRename(string from)
    {
        if (from.Length == 0) return;      // 「未分类」不是一个能改名的分类（双击别把它变成真分类）
        _categoryMenu = null;
        _categoryRenameFrom = from;
        _categoryRenameDraft = from;
        _categoryDialogError = null;
    }

    /// <summary>「…」→ 编辑：名字 + 图标一起改（2026-11-10 由「换个图标」「重命名分类」合并而来）。</summary>
    private void OpenCategoryEdit(string from)
    {

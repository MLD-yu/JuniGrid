    // ── 删除确认弹窗：取消 / 确定（单个走 Uninstall，批量走 BatchDelete）──
    private void CancelDeleteMods()
    {
        _pendingDeleteMod = null;
        _pendingBatchDelete = false;
        _pendingDeleteGroupFolders = null;
    }

    /// <summary>把「一组子包 folder」收敛成删除目标：整包全选时给**顶层目录**，
    /// 让 ModDeleteService 一次 <c>Directory.Move</c> 把整个包搬走。
    /// <para>2026-11-07 用户实机：某个子目录被占用时，逐个子目录 Move 会「删掉两个、剩一个」——
    /// 包被拆散了，剩下的那个还因为顶层目录结构变了掉进未分类。要么整包成功、要么整包不动，
    /// 就不能按子目录一个个来。</para>
    /// <para>只有在该顶层目录下的<b>所有</b>子包都在删除名单里时才收敛（混装包只删其中一个时
    /// 仍然逐个删，否则会误伤没被选中的兄弟）。</para></summary>
    private List<string> WholeGroupTargets(List<string> folders)
    {
        var targets = new List<string>();
        foreach (var byTop in folders.GroupBy(TopOf, StringComparer.OrdinalIgnoreCase))
        {
            var top = byTop.Key;
            var asked = byTop.ToList();
            if (top.Length == 0) { targets.AddRange(asked); continue; }

            // 这个顶层目录下当前扫描到的全部子包
            var members = _mods
                .Where(m => string.Equals(GroupKeyOf(m), top, StringComparison.OrdinalIgnoreCase))
                .Select(m => m.Folder)
                .ToList();
            // 散装 mod（GroupKeyOf = ""）不参与这个口径：它的 members 会是空，自然走下面逐个删
            var wholeGroup = members.Count > 1
                             && asked.Count == members.Count
                             && asked.All(a => members.Contains(a, StringComparer.OrdinalIgnoreCase));
            if (wholeGroup) targets.Add(top);
            else targets.AddRange(asked);
        }
        return targets;
    }

    private static string TopOf(string folder)
    {
        var i = folder.IndexOf('/');
        return i > 0 ? folder[..i] : "";
    }

    private void ConfirmDeleteMods()
    {
        var mod = _pendingDeleteMod;
        var batch = _pendingBatchDelete;
        var groupFolders = _pendingDeleteGroupFolders;
        var toTrash = _deleteToTrash;
        _pendingDeleteMod = null;
        _pendingBatchDelete = false;
        _pendingDeleteGroupFolders = null;

        if (mod is not null)
        {
            _ = StartDeleteAsync([mod.Folder], [mod.Name], toTrash);
        }
        else if (groupFolders is not null)
        {
            // 整合行删除：整包一起删。名字取第一个子包名（同页，名称一致）。
            var names = groupFolders.Select(f => _modsByFolder.TryGetValue(f, out var mm) ? mm.Name : f).ToList();
            _ = StartDeleteAsync(WholeGroupTargets(groupFolders), names, toTrash);
        }
        else if (batch)
        {
            // 先把名字抓下来 —— 删除过程中 _selected 会被清、_mods 会被重扫，
            // 目标必须在开工前固定住，否则删到一半目标就变了
            var picked = _mods.Where(m => _selected.Contains(m.Folder)).ToList();
            if (picked.Count == 0) return;
            _ = StartDeleteAsync(picked.Select(m => m.Folder).ToList(), picked.Select(m => m.Name).ToList(), toTrash);
        }
    }

    /// <summary>正在后台删除的文件夹。只用来把这几行画成「删除中」并挡住重复点击 ——
    /// 不是业务状态，重扫之后自然清空。</summary>
    private readonly HashSet<string> _deleting = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>0 = 没有删除在跑；1 = 有一批在后台。并发两批会把同一个目录搬两次。</summary>
    private int _delRunning;

    /// <summary>
    /// v1.3.15：删除 = 丢进后台，点完立刻回。
    /// <para>
    /// v1.3.14 的进度弹窗被去掉了：那个弹窗本身又是一层 <c>@onclick</c> + 每 90ms 一次
    /// <c>JS.InvokeVoidAsync</c>，在下载同时在跑的时候反而成了新的卡顿源。用户要的
    /// 其实很简单 —— 点删除，别卡；删完了告诉我一声。
    /// </para>
    /// <para>
    /// 所以这里只剩三件事：把目标记进 <see cref="_deleting"/> 立刻重渲一次（行变灰）、
    /// 把整批交给 <see cref="ModDeleteService"/>（它自己在 <c>Task.Run</c> 里跑）、
    /// 结束后 toast 一句再触发后台重扫。中间不传进度回调（<c>null</c>）——
    /// 没人看进度条了，就别再为它做 90ms 一次的跨线程回调。
    /// </para>
    /// </summary>
    private async Task StartDeleteAsync(IReadOnlyList<string> folders, IReadOnlyList<string> names, bool toTrash)
    {
        if (folders.Count == 0) return;
        if (Interlocked.CompareExchange(ref _delRunning, 1, 0) == 1)
        {
            ShowNotice("err", LocService.Tr("上一批删除还在后台进行，请等它结束"));
            return;
        }

        var label = folders.Count == 1
            ? LocService.Tf("「{0}」", names.FirstOrDefault() ?? folders[0])
            : LocService.Tf("{0} 个 mod", folders.Count);

        foreach (var f in folders)
        {
            // 目标可能是顶层目录（整包一次删）—— 行是按子包 folder 记的，要展开才点亮「删除中」
            if (_mods.Any(m => string.Equals(m.Folder, f, StringComparison.OrdinalIgnoreCase)))
            {
                _deleting.Add(f);
                continue;
            }
            var kids = _mods.Where(m => f.Length > 0
                                        && string.Equals(GroupKeyOf(m), f, StringComparison.OrdinalIgnoreCase))
                            .Select(m => m.Folder).ToList();
            if (kids.Count == 0) _deleting.Add(f);
            else foreach (var k in kids) _deleting.Add(k);
        }
        StateHasChanged();

        // v1.3.18：原来那句 toast 2.3 秒就没了，删一个几 GB 的包却要十几秒 ——
        // 用户盯着一个空界面不知道还在不在跑。换成常驻胶囊：圆环一直转、文案写清
        // 删的是谁，删除真的结束（成功或失败）才收走。
        _ = JS.InvokeVoidAsync("junigridJs.busyPill",
            toTrash ? LocService.Tf("正在移入回收站：{0}…", label)
                    : LocService.Tf("正在删除：{0}…", label));

        var kind = "ok";
        var msg = "";
        try
        {
            var res = await ModDeleteService.DeleteAsync(
                Cfg.Current.GamePath, folders, toTrash, Cfg, null, CancellationToken.None);

            if (res.AnyFailed)
            {
                kind = "err";
                msg = res.FirstError ?? LocService.Tf("{0} 个删除失败", res.Failed);
            }
            else
            {
                msg = toTrash
                    ? LocService.Tf("已移入回收站 {0} 个 mod", res.Deleted)
                    : LocService.Tf("已删除 {0} 个 mod", res.Deleted);
            }
        }
        catch (Exception ex)
        {
            kind = "err";
            msg = ex.Message;
        }
        finally
        {
            // 一次只跑一批（_delRunning 拦着），直接清空即可 —— 目标可能是顶层目录，
            // 按 folders 逐个 Remove 清不掉之前展开进去的子包 folder。
            _deleting.Clear();
            Interlocked.Exchange(ref _delRunning, 0);
            // 先收胶囊。它和结果 toast 是同一个固定落点，同时在场会叠成一坨。
            try { _ = JS.InvokeVoidAsync("junigridJs.busyPillHide"); } catch { }
        }

        ShowNotice(kind, msg);

        if (toTrash)
        {
            TrashService.Invalidate(Cfg.Current.GamePath);
            _trashLoaded = false;
        }

        ClearSelection();
        RescanAndRestate();
    }

    /// <summary>v0.71.0：跳详情前记住列表滚动位置（静态字段，组件销毁后仍存活）。</summary>
    private static double _restoreScroll = -1;
    /// <summary>v0.72.0：离开时是否已在底部 —— 恢复时 target=limit 的唯一依据，
    /// 取代旧版 setScrollWhenReady 里 "y > limit 就当到底" 的猜测。</summary>
    private static bool _restoreAtBottom;
    /// <summary>v0.72.4：.jg-main 上是否还挂着「待恢复」隐藏标记（jg-restore-pending）。
    /// 回到列表却没有快照可恢复时，用它兜底摘标记，防止行列表被永久隐藏。</summary>
    private static bool _scrollRestoreClassPending;

    /// <summary>v0.72.0：JS 滚动快照（y + 是否到底）。</summary>
    private sealed record ScrollSnapshot(
        [property: System.Text.Json.Serialization.JsonPropertyName("y")] double Y,
        [property: System.Text.Json.Serialization.JsonPropertyName("atBottom")] bool AtBottom);

    /// <summary>v0.72.2：滚动恢复结果回报（setScrollWhenReady 结束时回一次）。
    /// v1.2.5：正常流程的回报不再落 WRN 日志，仅保留回调契约。</summary>
    private sealed class ScrollRestoreReporter
    {
        [JSInvokable]
        public void Report(double target, double finalTop, int tries, string reason) { }
    }

    private async Task OpenDetail(ModEntry m)
    {
        if (m.NexusModId is not null)
        {
            // v0.72.2：诊断日志 —— 滚动链路此前全程静默，失败无迹可查。
            // jsVer 探测加载的 interop.js 是新是旧（WebView2 缓存旧 JS 时这里会现形）。
            try
            {
                var jsVer = await JS.InvokeAsync<string>("eval",
                    "(window.junigridJs && window.junigridJs.getScrollState) ? 'interop-new' : 'interop-OLD-CACHED'");
                var snap = await JS.InvokeAsync<ScrollSnapshot>("junigridJs.getScrollState", ".jg-main");
                _restoreScroll = snap.Y;
                _restoreAtBottom = snap.AtBottom;
                // v1.2.5：正常流程快照日志移除
                // v0.72.4：给 .jg-main 打「待恢复」标记 —— 返回后行列表在落位前保持隐藏，
                // 浏览器画不出「列表在顶部」的那一帧（闪屏根因）
                await JS.InvokeVoidAsync("junigridJs.markScrollRestorePending", ".jg-main");
                _scrollRestoreClassPending = true;
                // v0.71.2：双写 sessionStorage（scrollSpy 同 key）——静态字段在 Blazor 服务端路由缓存下时序不稳，
                // sessionStorage 是持久兜底；返回时 setScrollWhenReady 读哪个都行。
                await JS.InvokeVoidAsync("junigridJs.saveScrollKey", "modslist", _restoreScroll, _restoreAtBottom);
            }
            catch (Exception ex)
            {
                AppLog.Error("Mods", "[诊断] OpenDetail 快照失败: " + ex.Message);
            }
            Nav.NavigateTo($"mod/{m.NexusModId}" + (string.IsNullOrEmpty(m.UniqueID) ? "" : "/" + Uri.EscapeDataString(m.UniqueID)));
        }
    }


    {
        "all" => _mods.Count,
        "enabled" => _mods.Count(m => !m.Disabled),
        "disabled" => _mods.Count(m => m.Disabled),
        "updatable" => _mods.Count(m => IsUpdatable(m)),
        _ => 0,
    };


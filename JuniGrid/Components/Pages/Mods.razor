@using System.Collections.Concurrent
@namespace JuniGrid.Components.Pages
@page "/mods"
@inject ConfigService Cfg
@inject ModService ModSvc
@inject GameService Game
@inject UpdateService Updater
@inject NexusService Nexus
@inject InstallService Installer
@inject PageRefreshService PageRefresh
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TaskCenterService Center
@inject DepotDownloaderService DepotQr
@inject LocalPackDelivery Delivery
@implements IDisposable

<div class="jg-page">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px">
        <div>
            <div style="display:flex;align-items:center;gap:14px">
                @* 视图开关做成顶导航那种滑块胶囊：固定顺序、同字号同字重，
                   选中态由白色滑块平移承担（GSAP tab-select），不再改字号/挤位置。 *@
                <div class="jg-viewtabs" role="tablist">
                    <span class="jg-viewtabs-thumb"></span>
                    <button type="button" role="tab"
                            aria-selected="@(!_showTrash ? "true" : "false")"
                            class="jg-viewtabs-item @(!_showTrash ? "active" : "")"
                            @onclick="ShowModsView">@Loc.T("Mod 管理")</button>
                    <button type="button" role="tab"
                            aria-selected="@(_showTrash ? "true" : "false")"
                            class="jg-viewtabs-item @(_showTrash ? "active" : "")"
                            @onclick="ShowTrashView">@Loc.T("回收站")</button>
                </div>
                @* v1.07.3：普通文件夹图标，点击打开 Mods 目录；data-tip 与导航栏同款胶囊提示 *@
                @* v1.5.5：跟着当前视图走 —— mod 列表进 Mods，回收站进 .junigrid_trash *@
                <button class="jg-mods-folder-btn"
                        data-tip='@(_showTrash ? Loc.T("在资源管理器里打开回收站") : Loc.T("在资源管理器里打开 Mods"))'
                        aria-label='@(_showTrash ? Loc.T("在资源管理器里打开回收站") : Loc.T("在资源管理器里打开 Mods"))'
                        @onclick="OpenCurrentFolder">
                    <svg viewBox="0 0 1024 1024" width="32" height="32" fill="#f2b544">
                        <path d="M855.04 385.024q19.456 2.048 38.912 10.24t33.792 23.04 21.504 37.376 2.048 54.272q-2.048 8.192-8.192 40.448t-14.336 74.24-18.432 86.528-19.456 76.288q-5.12 18.432-14.848 37.888t-25.088 35.328-36.864 26.112-51.2 10.24l-567.296 0q-21.504 0-44.544-9.216t-42.496-26.112-31.744-40.96-12.288-53.76l0-439.296q0-62.464 33.792-97.792t95.232-35.328l503.808 0q22.528 0 46.592 8.704t43.52 24.064 31.744 35.84 12.288 44.032l0 11.264-53.248 0q-40.96 0-95.744-0.512t-116.736-0.512-115.712-0.512-92.672-0.512l-47.104 0q-26.624 0-41.472 16.896t-23.04 44.544q-8.192 29.696-18.432 62.976t-18.432 61.952q-10.24 33.792-20.48 65.536-2.048 8.192-2.048 13.312 0 17.408 11.776 29.184t29.184 11.776q31.744 0 43.008-39.936l54.272-198.656q133.12 1.024 243.712 1.024l286.72 0z"/>
                    </svg>
                </button>
                @* v1.8.x：从本地文件安装 —— 拖放之外的正规入口。
                   拖放在某些机器上可能不响应（WebView2 合成宿主的拖放行为不确定），
                   这条链路是纯 WPF 文件对话框，一定能用。 *@
                @if (!_showTrash)
                {
                    <button class="jg-mods-folder-btn"
                            data-tip='@Loc.T("从本地文件安装压缩包")'
                            aria-label='@Loc.T("从本地文件安装压缩包")'
                            disabled="@_localPacksBusy"
                            @onclick="PickLocalPacks">
                        <svg viewBox="0 0 24 24" width="30" height="30" fill="none"
                             stroke="#f2b544" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 16V4"/>
                            <path d="m7 9 5-5 5 5"/>
                            <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
                        </svg>
                    </button>
                }
            </div>
            <div style="opacity:.7;font-size:13px">
                @* v1.08：骨架屏只负责磁盘扫描阶段；检查更新期间列表照常显示 *@
                @if (_showTrash)
                {
                    @if (_trashLoaded)
                    {
                        <text>@Loc.F("回收站：{0} 个 mod · {1} 份快照 · 共 {2}", _trashGroups.Count, _trashItems.Count,
                            ResumableDownload.FormatBytes(_trashItems.Sum(x => x.Bytes)))</text>
                    }
                    else
                    {
                        <text>@Loc.T("回收站：读取中…")</text>
                    }
                }
                else if (_initialLoading) { <span>@Loc.T("正在加载 mod 列表…")</span> }
                else { <text>@Loc.F("共 {0} 个（{1} 已启用）", CountRows(_mods), CountRows(_mods.Where(m => !m.Disabled)))</text> }
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
            @* ★★ 存档下拉只在 mod 列表视图显示 —— 它是 mod 存档（启用状态快照），跟回收站无关。
               回收站视图下整块不渲染（否则用户会以为它管的是回收站里的快照）。 *@
            @if (!_showTrash)
            {
            @* v0.47.0：存档下拉挪到最右；GSAP easeReverse 弹性开合（参照官方 demo）*@
            <div class="jg-profile-dd @(_profileOpen ? "open" : "")" data-dd="profile">
                @* v0.71.4：重命名挪到下拉按钮右边 —— 点铅笔后按钮变输入框、铅笔变确定，改名只在这一个位置发生 *@
                @if (_renamingProfile is not null)
                {
                    <input class="jg-profile-input jg-profile-headinput" maxlength="30"
                           value="@_renameBuffer"
                           @oninput="e => _renameBuffer = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="e => OnRenameKey(e, _renamingProfile!)"
                           @onclick:stopPropagation />
                    <button class="jg-profile-headconfirm" data-tip='@Loc.T("确定")' aria-label='@Loc.T("确定")'
                            @onclick="() => ConfirmRename(_renamingProfile!)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                            <path d="M20 6 9 17l-5-5"/>
                        </svg>
                    </button>
                }
                else
                {
                    <button class="jg-sort-trigger" @onclick="ToggleProfile">
                        @Loc.T(ActiveProfileName)
                        <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    @if (ActiveProfileName != "默认")
                    {
                        <button class="jg-profile-rename jg-profile-headrename" data-tip='@Loc.T("重命名")' aria-label='@Loc.T("重命名")'
                                @onclick="() => StartRenameProfile(ActiveProfileName)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                                <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                <path d="m15 5 4 4"/>
                            </svg>
                        </button>
                    }
                }
                <div class="jg-sort-menu jg-profile-menu">
                    @foreach (var p in AllProfiles)
                    {
                        <div class="jg-profile-item @(p.Name == ActiveProfileName ? "active" : "")">
                            @* v0.71.4：菜单项只负责切换/删除；重命名统一由下拉按钮右侧的铅笔入口发起 *@
                            <button class="jg-profile-name"
                                    @onclick="() => ApplyProfileAndClose(p.Name)">@Loc.T(p.Name)</button>
                            @if (p.Name != "默认")
                            {
                                <button class="jg-profile-del" @onclick="() => AskDeleteProfile(p.Name)">×</button>
                            }
                        </div>
                    }
                    <div class="jg-profile-item">
                        @if (_addingProfile)
                        {
                            <input class="jg-profile-input" placeholder='@Loc.T("存档名称")' maxlength="30"
                                   @bind="_newProfileName" @bind:event="oninput" />
                            <button class="jg-profile-name" style="font-weight:600;flex:none" @onclick="ConfirmAddProfile">@Loc.T("确定")</button>
                        }
                        else
                        {
                            @* 虚线胶囊 + 悬停胶囊提示（导航栏同款 data-tip 风格）*@
                            <button class="jg-profile-addcap" data-tip='@Loc.T("新建存档")' aria-label='@Loc.T("新建存档")' @onclick="StartAddProfile">
                                <span class="plus">＋</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
            }
        </div>
    </div>

    @* ── SMAPI 永远第一个显示（用自己的 exe 图标，不用 emoji）── *@
    @* v1.5.5：回收站视图下 SMAPI 卡片没有意义，整块不渲染 *@
    @if (!_showTrash)
    {
    <div class="jg-card jg-smapi-card" style="margin-top:12px">
        <div style="display:flex;align-items:center;gap:12px">
            @* v0.37.0：exe 抽不到图标时用自带的 pufferchick 兜底，不再显示灰色 S 占位块 *@
            @if (_smapiIcon is not null)
            {
                <img class="jg-modrow-icon" src="@_smapiIcon" alt="SMAPI" />
            }
            else
            {
                <img class="jg-modrow-icon" src="assets/smapi-pufferchick.svg" alt="SMAPI"
                     style="border-radius:8px;background:var(--jg-card);padding:2px" />
            }
            <div style="min-width:0;flex:1">
                <div style="font-weight:700">
                    SMAPI
                    <span style="opacity:.6;font-weight:400;font-size:12px">@Loc.T("Mod 加载器")</span>
                </div>
                <div style="opacity:.75;font-size:12.5px;margin-top:3px">
                    @if (_smapiVersion is null)
                    {
                        @if (SmapNeedsOld && _smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
                        {
                            <span>@Loc.F("未安装 · 当前游戏 {0} 适配 SMAPI {1}，点右侧按钮一键下载安装", GameVerDisplay, _smapiUpdate.LatestVersion)</span>
                        }
                        else if (SmapNeedsOld)
                        {
                            <span style="color:#f0b95a">
                                @Loc.F("当前游戏 {0} ·", GameVerDisplay)
                                @(SmapiUnsupported ? Loc.T("无一键适配 SMAPI，可去 Nexus 手动找历史包") : Loc.F("推荐 {0}", SmapRecommendShort))
                            </span>
                        }
                        else if (_smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
                        {
                            <span>@Loc.F("未安装 · 最新版 {0}，点右侧按钮一键下载安装", _smapiUpdate.LatestVersion)</span>
                        }
                        else if (_smapiUpdate is { Error: not null })
                        {
                            <span style="color:#c50f1f">@Loc.F("未安装 · 获取版本信息失败（{0}）", _smapiUpdate.Error)</span>
                        }
                        else
                        {
                            <span>@Loc.T("未安装 · 正在获取版本信息…")</span>
                        }
                    }
                    else
                    {
                        <text>@Loc.F("当前版本：{0}", SmapiDisplay)</text>
                        @if (_smapiUpdate is { HasUpdate: true, LatestVersion: not null } && !SmapNeedsOld)
                        {
                            @* 新版本徽标：右箭头 + 「新版本」+ 版本号；点版本号直接更新 *@
                            <button type="button" class="jg-newver" disabled="@_smapiUpdating"
                                    title="@(_smapiUpdating ? Loc.T("正在更新…") : Loc.F("点击更新到 {0}", _smapiUpdate.LatestVersion!))"
                                    @onclick="UpdateSmapi">
                                <svg class="jg-newver-arrow" viewBox="0 0 1024 1024" aria-hidden="true">
                                    <path d="M560 512.414C560 453.643 512.357 406 453.586 406H204.414C145.643 406 98 453.643 98 512.414v0.172C98 571.357 145.643 619 204.414 619h249.172C512.357 619 560 571.357 560 512.586v-0.172z" fill="currentColor"/>
                                    <path d="M630.024 211.105l20.067 16.805 124.46 103.419L818 366.98v0.146l39.008 33.527 24.734 21.15c22.165 18.618 35.789 41.557 41.386 65.588 5.395 23.169 2.94 47.343-7.045 69.656-7.398 16.532-19.033 32.047-34.867 45.347l-21.025 17.62a128.674 128.674 0 0 1-3.92 3.425l-40.2 33.659-42.484 35.575-118.372 99.341a133.759 133.759 0 0 1-5.123 4.078l-20.068 16.805c-36.162 30.236-79.744 36.785-117.069 22.211-24.069-9.397-45.542-27.555-60.722-53.889l-2.171-3.77c-5.856-13.007-9.497-27.58-10.563-43.322l-0.455 0.443s41.854-154.592 41.854-222.471-41.758-212.887-41.758-212.887c0.035-19.354 3.923-37.113 10.923-52.66l2.171-3.77c14.42-25.015 34.524-42.636 57.131-52.395a112.775 112.775 0 0 1 3.59-1.494c37.325-14.574 80.907-8.024 117.069 22.212z" fill="currentColor"/>
                                </svg>
                                <span class="jg-newver-label">@Loc.T("新版本")</span>
                                @if (_smapiUpdating)
                                {
                                    <span class="jg-newver-num">@Loc.T("更新中…")</span>
                                }
                                else
                                {
                                    <span class="jg-newver-num">@_smapiUpdate.LatestVersion</span>
                                }
                            </button>
                        }
                        else if (SmapNeedsOld)
                        {
                            <span style="color:#f0b55a">@Loc.F(" · 当前游戏 {0}", GameVerDisplay)
                                @(SmapiUnsupported ? Loc.T("无一键适配 SMAPI") : Loc.F("适合 {0}", SmapRecommendShort))</span>
                        }
                    }
                </div>
            </div>
            @* v1.1.8/1.1.9：历史版本与 4.5.2 同管线；旧版按钮按本地映射秒出，不等 GitHub *@
            @if (NeedsCompatibleOldSmapi)
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="InstallSmapi">
                    @(_smapiUpdating ? Loc.T("正在安装…") : (_smapiVersion is null ? Loc.F("⬇ 下载安装 {0}", CompatibleOldSmapiLabel) : Loc.F("⬇ 安装适配的 {0}", CompatibleOldSmapiLabel)))
                </button>
            }
            else if (_smapiVersion is null && _smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="InstallSmapi">
                    @(_smapiUpdating ? Loc.T("正在安装…") : Loc.F("⬇ 下载安装 SMAPI {0}", _smapiUpdate.LatestVersion))
                </button>
            }
            else if (_smapiVersion is null && SmapNeedsOld && SmapiUnsupported)
            {
                <a class="jg-update-link" style="width:auto;padding:8px 16px;text-decoration:none"
                   href="@SmapRecommendUrl" target="_blank" rel="noopener"> @Loc.T("去 Nexus 找历史包") </a>
            }
            else if (_smapiUpdate is { HasUpdate: true } && !SmapNeedsOld)
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="UpdateSmapi">
                    @(_smapiUpdating ? Loc.T("正在更新…") : Loc.F("⬇ 更新到 {0}", _smapiUpdate.LatestVersion))
                </button>
            }
        </div>
    </div>
    }

    @if (!_showTrash && _rowsLoaded && _mods.Count == 0)
    {
        <div class="jg-card" style="margin-top:12px"> @Loc.T("Mods 文件夹为空或未定位到游戏。请先在「设置」里选择游戏目录。") </div>
    }

    @* ── v0.34.0 工具条：排序在前 → 筛选 chips → 搜索（点击向右延伸，SVG 图标） ── *@
    @* ★★ 回收站视图下整条工具条不渲染：它自带 40px 高 + 12px 上边距 + 粘性背景，
       只剩一个搜索按钮时会撑出一条横贯页面的空白带（用户截图实测）。
       搜索按钮改为并进下面回收站那一行按钮里。 *@
    @if (!_showTrash)
    {
    <div class="jg-mods-toolbar">
        <div class="jg-sort-dd @(_sortOpen ? "open" : "")" data-dd="sort">
            <button class="jg-sort-trigger" @onclick="ToggleSort"> @Loc.T("排序方式") <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="jg-sort-menu">
                <button class="jg-sort-item @(_sortMode == "time-asc" ? "active" : "")" @onclick='() => SetSort("time-asc")'>@Loc.T("最新在前")</button>
                <button class="jg-sort-item @(_sortMode == "time-desc" ? "active" : "")" @onclick='() => SetSort("time-desc")'>@Loc.T("最早在前")</button>
                <button class="jg-sort-item @(_sortMode == "alpha" ? "active" : "")" @onclick='() => SetSort("alpha")'>@Loc.T("首字母")</button>
            </div>
        </div>
        @* v1.1.2：遮罩改常驻 DOM + class 随状态绑定（原 @if 渲染比 JS 慢一拍：
           dropdownToggle 同帧翻转 .open 时遮罩元素还不存在，开菜单后点外部收不掉） *@
        <div class="jg-dd-overlay @(_sortOpen ? "open" : "")" data-dd="sort" @onclick="CloseSort"></div>
        <div class="jg-chips" role="group" style="align-items:center">
        @foreach (var f in _filterOptions)
        {
            // 「覆盖包」的红点：有失效或新版本的包时亮，点进去第一眼就能看到是哪几个。
            var overlayAlert = f.Key == "overlay" && OverlayAttentionCount > 0;
            var dot = (f.Key == "updatable" && FailedCheckCount > 0) || overlayAlert;
            <button class="jg-chip @(!_showTrash && _filter == f.Key ? "active" : "")"
                    style="@(dot ? "position:relative" : "")"
                    data-tip="@FilterTip(f.Key)"
                    @onclick="() => SetFilter(f.Key)">
                @Loc.T(f.Label)<span style="opacity:.7;font-weight:400"> · @CountFor(f.Key)</span>
                @if (dot)
                {
                    @* v1.08：有检查失败的 mod → 可更新标签右上角小红点 *@
                    <span style="position:absolute;top:-3px;right:-3px;width:8px;height:8px;border-radius:50%;background:#e81123;box-shadow:0 0 0 2px var(--jg-bg)"></span>
                }
            </button>
        }
        </div>
        @* 状态字必须在 .jg-chips 外面：chips 是 flex-wrap:wrap，6 个 chip 正好占满一行，
           状态字排在其后就必然被折到第二行，变成一行孤儿字（他截图实测）。工具条本身 nowrap，
           放外面就贴着 chips 右侧同一行（实测状态字 top 286 / chips 279–310，同一行内）。 *@
        @if (FailedCheckCount > 0)
        {
            <span style="font-size:12px;color:#c50f1f;opacity:.85;white-space:nowrap;flex-shrink:0">@Loc.F("更新检查超时，请检查网络（{0} 个未完成）", FailedCheckCount)</span>
        }
        else if (_checkingUpdates)
        {
            <span style="font-size:12px;opacity:.6;white-space:nowrap;flex-shrink:0">@Loc.T("正在检查更新…")</span>
        }
        <div class="jg-search-x @(_searchOpen ? "open" : "")">
            <button class="jg-search-btn" @onclick="ToggleSearch">
                <img src="assets/search.svg" alt='@Loc.T("搜索")' style="width:18px;height:18px;display:block" />
            </button>
            <div class="jg-search-field">
                <input class="jg-search-input" placeholder='@Loc.T("搜mod名/N网尾号")'
                       @bind="SearchText" @bind:event="oninput" />
                <button class="jg-search-clear" @onclick="ClearSearchAndClose">✕</button>
            </div>
        </div>
    </div>
    }

    @* ── v1.2.0：缺失依赖横幅 + 一键安装 ── *@
    @if (!_initialLoading && TotalMissingUids.Count > 0)
    {
        <div class="jg-card" style="margin-top:12px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;border-left:3px solid #f2b544">
            <span style="font-size:13px"> @Loc.T("检测到") <b>@TotalMissingUids.Count</b>@Loc.F(" 个依赖没装或版本过旧，影响 {0} 个 mod ", MissingAffectedMods)</span>
            <button class="jg-pill-dark" style="padding:7px 16px;font-size:12.5px"
                    disabled="@(_depInstalling || Installer.Busy)"
                    @onclick="() => AskInstallMissingDeps(null)">
                @(_depInstalling ? Loc.T("正在安装…（进度见右下角任务）") : Loc.T("一键安装/更新依赖"))
            </button>
            <button class="jg-pill-ghost" style="padding:7px 14px;font-size:12.5px"
                    @onclick='() => SetFilter("missing")'>@Loc.T("查看列表")</button>
            @if (_depError is not null)
            {
                <span style="color:#c50f1f;font-size:12.5px">@Loc.T(_depError)</span>
            }
        </div>
    }

    @* ── v1.5.5：回收站视图 —— 与 mod 列表同一套 .jg-modrow 卡片，只是行的内容换成快照 *@
    @if (_showTrash)
    {
        @* ★★ 去掉卡片边框：这一行只是回收站的工具条，加了 .jg-card 之后会画出一条横贯页面的
           框线，把标题和列表隔开，视觉上像"孔板"。保留内边距与圆角布局，只不要边框和底色。 *@
        @* ★★ 吸顶工具条：滚动时这排按钮（刷新/打开文件夹/全选/搜索）固定在顶部，随时可用。
           信息行已挪到标题下的副标题，这里只剩按钮。 *@
        <div class="jg-trash-sticky">
            <button class="jg-pill-ghost" style="padding:7px 14px;font-size:12.5px" @onclick="() => LoadTrash(forceRefresh: true)">@Loc.T("刷新")</button>
            @if (_trashItems.Count > 0)
            {
                var allSel = _trashSelected.Count >= _trashItems.Count;
                <button class="jg-pill-ghost" style="padding:7px 14px;font-size:12.5px" @onclick="() => SelectAllTrash(!allSel)">
                    @(allSel ? Loc.T("取消全选") : Loc.T("全选"))
                </button>
            }
            @if (_trashSelected.Count > 0 || _trashDeleting)
            {
                <button class="jg-pill-dark" style="padding:7px 16px;font-size:12.5px" disabled="@_trashDeleting" @onclick="AskRestoreTrash">@Loc.F("还原所选（{0}）", _trashSelected.Count)</button>
                @* v1.3.32：删除期间按钮就地变成进度条 —— 分钟级的删除必须看得见在动 *@
                <button class="jg-pill-danger" style="padding:7px 16px;font-size:12.5px" disabled="@_trashDeleting"
                        title='@(_trashDeleting ? Loc.F("正在删除 {0}：{1}/{2} 个文件", _trashDeleteCurrent, _trashDeleteFilesDone, _trashDeleteFilesTotal) : null)'
                        @onclick="AskDeleteTrash">
                    @(_trashDeleting
                        ? Loc.F("正在删除…（{0}/{1} · {2}%）", _trashDeleteDone, _trashDeleteTotal, TrashDeletePercent)
                        : Loc.F("永久删除所选（{0}）", _trashSelected.Count))
                </button>
            }
            @* ★★ 搜索并进这一行：回收站视图下整条 .jg-mods-toolbar 不渲染了（它空着会撑出一大条空白），
               但搜索还得留着 —— .jg-search-x 自带 margin-left:auto，会自动贴到最右。 *@
            <div class="jg-search-x @(_searchOpen ? "open" : "")" style="margin-left:auto">
                <button class="jg-search-btn" @onclick="ToggleSearch">
                    <img src="assets/search.svg" alt='@Loc.T("搜索")' style="width:18px;height:18px;display:block" />
                </button>
                <div class="jg-search-field">
                    <input class="jg-search-input" placeholder='@Loc.T("搜mod名/N网尾号")'
                           @bind="SearchText" @bind:event="oninput" />
                    <button class="jg-search-clear" @onclick="ClearSearchAndClose">✕</button>
                </div>
            </div>
        </div>

        @if (!_trashLoaded)
        {
            @* 后台在算文件大小/读 manifest，先用骨架占位 —— 不留白屏 *@
            <div class="jg-modrows jg-modrows-skeleton" style="margin-top:12px">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="jg-modrow-shimmer">
                        <div class="jg-shimmer jg-shimmer-avatar"></div>
                        <div class="jg-shimmer-lines">
                            <div class="jg-shimmer jg-shimmer-line" style="width:38%"></div>
                            <div class="jg-shimmer jg-shimmer-line" style="width:68%"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_trashItems.Count == 0)
        {
            @* 空态插画：与 mod 列表那套共用 .jg-pk-empty-art 样式（尺寸/主题色由 CSS 给）。
               v1.3.32：按「清空回收站」图标的轮廓重画成线条版 —— 原图是实心填充（fill），
               笔画粗细是路径几何本身，改不细；线条版才能用 stroke-width 控制，
               也才跟界面其余空态插画（同样是细线）风格一致。 *@
            <div class="jg-pk-empty jg-mods-empty">
                <svg class="jg-pk-empty-art" viewBox="0 0 1024 1024" fill="none" aria-hidden="true">
                    @* 提手 *@
                    <path d="M388 250v-82a44 44 0 0 1 44-44h160a44 44 0 0 1 44 44v82"
                          stroke="currentColor" stroke-width="26" stroke-linecap="round" stroke-linejoin="round"/>
                    @* 桶口横杆 *@
                    <path d="M150 250h724" stroke="currentColor" stroke-width="26" stroke-linecap="round"/>
                    @* 桶身（上宽下窄 + 圆角底） *@
                    <path d="M214 250l44 622a56 56 0 0 0 56 52h396a56 56 0 0 0 56-52l44-622"
                          stroke="currentColor" stroke-width="26" stroke-linecap="round" stroke-linejoin="round"/>
                    @* 叉号 *@
                    <path d="M412 452l200 200M612 452l-200 200"
                          stroke="currentColor" stroke-width="26" stroke-linecap="round"/>
                </svg>
                <div class="jg-pk-empty-title">@Loc.T("回收站是空的")</div>
            </div>
        }
        else
        {
            <div class="jg-modrows">
                @foreach (var g in _trashGroups)
                {
                    var open = _trashOpen.Contains(g.Name);
                    var gcover = TrashCover(g.Name);
                    var picked = AllSelected(g);
                    @* v1.5.5：整行点击 = 选中（与 mod 列表同一套 .jg-modrow.selected 高亮），
                       展开/收起走行尾那颗箭头，互不干扰。 *@
                    <div class="jg-modrow @(picked ? "selected" : "")" @key="g.Name" data-al
                         @onclick="() => SelectGroup(g, !picked)">
                        @if (gcover is not null)
                        {
                            <img class="jg-modrow-icon" src="@gcover" loading="lazy" alt="" />
                        }
                        else
                        {
                            <div class="jg-modrow-icon jg-modrow-icon-fallback">
                                @(g.Name.Length > 0 ? g.Name.TrimStart('.', '[', '~')[..1].ToUpperInvariant() : "?")
                            </div>
                        }
                        <div class="jg-modrow-text">
                            <div class="jg-modrow-title">
                                <span class="name">@g.Name</span>
                                <span class="divider">|</span>
                                <span class="ver">@(g.Items[0].Version)</span>
                                @if (g.Items.Any(x => x.AlsoInMods))
                                {
                                    <span class="jg-tag" data-tip='@Loc.T("Mods 里已有一份同名的 —— 这条通常可以清掉")'>@Loc.T("Mods 里已有")</span>
                                }
                                <span class="jg-tag" style="opacity:.65">@Loc.F("{0} 份 · {1}", g.Items.Count, ResumableDownload.FormatBytes(g.Items.Sum(x => x.Bytes)))</span>
                            </div>
                            <div class="jg-modrow-desc">@(g.Items[0].Description)</div>
                        </div>
                        <div class="jg-modrow-end" @onclick:stopPropagation>
                            <button type="button" class="jg-rowbtn" data-tip='@(open ? Loc.T("收起") : Loc.T("展开历史版本"))'
                                    aria-label='@(open ? Loc.T("收起") : Loc.T("展开历史版本"))'
                                    @onclick="() => ToggleTrashGroup(g.Name)">
                                <svg viewBox="0 0 12 12" width="12" height="12" fill="none"
                                     style="transition:transform .18s ease;transform:rotate(@(open ? "180deg" : "0deg"))">
                                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5"
                                          stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    @if (open)
                    {
                        @foreach (var it in g.Items)
                        {
                            var sel = _trashSelected.Contains(it.FolderName);
                            <div class="jg-modrow jg-modrow-sub @(sel ? "selected" : "")" @key="it.FolderName" data-al
                                 @onclick="() => SelectItem(it, !sel)">
                                <div class="jg-modrow-icon jg-modrow-icon-fallback" style="opacity:.5">
                                    @(it.DeletedAt?.ToString("MM-dd") ?? "?")
                                </div>
                                <div class="jg-modrow-text">
                                    <div class="jg-modrow-title">
                                        <span class="name">@(it.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? Loc.T("时间未知"))</span>
                                        <span class="divider">|</span>
                                        <span class="ver">@Loc.F("{0} 个文件 · {1}", it.FileCount, ResumableDownload.FormatBytes(it.Bytes))</span>
                                        @if (it.AlsoInMods)
                                        {
                                            <span class="jg-tag">@Loc.T("同名已在 Mods")</span>
                                        }
                                    </div>
                                </div>
                                <div class="jg-modrow-end" @onclick:stopPropagation>
                                    <button class="jg-rowbtn" data-tip='@Loc.T("还原这一份")' aria-label='@Loc.T("还原这一份")'
                                            disabled="@_trashDeleting" @onclick="() => AskRestoreOne(it)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px">
                                            <path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>
                                        </svg>
                                    </button>
                                    <button class="jg-rowbtn danger" data-tip='@Loc.T("永久删除这一份")' aria-label='@Loc.T("永久删除这一份")'
                                            disabled="@_trashDeleting" @onclick="() => AskDeleteOne(it)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px">
                                            <path d="M3 6h18"/><path d="M8 6V4h8v2"/>
                                            <path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        }
    }

    @* ── 单行 mod 列表 ── *@
    @* v1.06.9：首次加载 或 检查更新未完成 → 一律显示 shimmer 骨架屏，真实列表 display:none *@
    @if (!_showTrash && _initialLoading)
    {
        <div class="jg-modrows jg-modrows-skeleton">
            @for (var i = 0; i < 8; i++)
            {
                <div class="jg-modrow-shimmer">
                    <div class="jg-shimmer jg-shimmer-avatar"></div>
                    <div class="jg-shimmer-lines">
                        <div class="jg-shimmer jg-shimmer-line" style="width:38%"></div>
                        <div class="jg-shimmer jg-shimmer-line" style="width:68%"></div>
                    </div>
                    <div class="jg-shimmer jg-shimmer-pill"></div>
                </div>
            }
        </div>
    }
    @* ── 覆盖包视图：汉化补丁 / 贴图覆盖不住在 Mods\ 里，没有自己的行，
       这里是它们唯一的全局入口。行 = 一个包（不是一条逐文件记录）。
       2026-11-09 用户要求：整块照 Mod 行的样子做 —— 点行 = 选中（可多选），
       行尾是启停开关；批量条里给 启用 / 禁用 / 删除 / 批量更新。
       三改（同日）：**一段 = 一个宿主 mod**，段头就是那个 mod 的封面 + 真名
       （「Farm Queue · 2 个」），点一下折叠；没装宿主的一律归「未安装宿主 mod」。
       已失效的行只留「打开 N 网页面」和「删除」，重试走批量条的「启用」。 ── *@
    @if (!_showTrash && _filter == "overlay" && !_initialLoading)
    {
        var sections = OverlaySections();
        <div class="jg-modrows jg-overlayrows" style="margin-top:2px">
            @if (sections.Count == 0)
            {
                <div class="jg-card" style="font-size:13px;opacity:.7">
                    @Loc.T("没有覆盖包。汉化补丁、贴图覆盖这类包会出现在这里。")
                </div>
            }
            @foreach (var sec in sections)
            {
                @* 2026-11-09 四改：段头补上「全选这个宿主下的覆盖包」复选框（三态），
                   与 mod 分类段头同一颗 .jg-cat-check —— 否则想整段启用/删除只能一个个点。
                   位置也照那边：折叠箭头改为最右，复选框贴在计数后面。 *@
                var secSel = OverlaySectionSelectState(sec);
                @* 2026-11-09 三改：段头 = 一个宿主 mod 的封面 + 真名（跟 mod 分类段头同一套观感），
                   点一下折叠。不带图标选择器和「…」菜单：分组是按宿主算出来的，不是用户编辑的分类，
                   给编辑入口只会让人以为能改名、能拖 mod 进来。 *@
                <div class="jg-cat-head jg-ov-sechead @(sec.Collapsed ? "collapsed" : "")"
                     data-tip="@(sec.Collapsed ? Loc.T("点击展开这一组") : Loc.T("点击收起这一组"))"
                     @onclick="() => ToggleOverlaySection(sec.Key)">
                    @if (sec.Cover is not null)
                    {
                        <img class="jg-ov-secicon" src="@sec.Cover" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span class="jg-ov-secmark"></span>
                    }
                    <span class="jg-cat-head-name">@sec.Label</span>
                    <span class="jg-cat-head-n">@Loc.F("{0} 个", sec.Items.Count)</span>
                    <button class="jg-cat-check @(secSel == 2 ? "on" : secSel == 1 ? "some" : "")"
                            role="checkbox" aria-checked="@(secSel == 2 ? "true" : secSel == 1 ? "mixed" : "false")"
                            data-tip='@Loc.T("全选这一组覆盖包")' aria-label='@Loc.T("全选这一组覆盖包")'
                            @onclick="() => ToggleOverlaySectionSelectAll(sec)" @onclick:stopPropagation="true">
                        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            @if (secSel == 2)
                            {
                                <path d="M2.6 6.3L4.8 8.4L9.4 3.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            }
                            else if (secSel == 1)
                            {
                                <path d="M3 6h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            }
                        </svg>
                    </button>
                    <span class="jg-ov-secard">
                        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M3.5 4.5L6 7l2.5-2.5" stroke="currentColor" stroke-width="1.6"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </div>
                @* 段体与 mod 分类同一套 .jg-cat-body：折叠稳态靠 .collapsed，动画走 catToggle *@
                <div class="jg-cat-body @(sec.Collapsed ? "collapsed" : "")" id="@OverlaySecAnchor(sec.Key)">
                @foreach (var g in sec.Items)
                {
                var okey = OverlayKey(g);
                var picked = _overlaySelected.Contains(okey);
                var rec = g.Rec;
                var gone = g.Stale > 0;
                var title = OverlayTitle(rec);
                var canOpen = rec.NexusModId is int;
                var host = OverlayHostInfo(g.Host);
                var hostMod = HostIndex().TryGetValue(ModService.NormalizeOverlayHost(g.Host), out var hm) ? hm : null;
                // 能跳到哪个 id：装着的用本地条目，没装的用账本反查出来的那个
                var hostJumpId = host.Installed ? hostMod?.NexusModId : host.NexusModId;
                // 行尾要用的三个值在这里算好：Razor 只允许在循环体顶层写语句，
                // 写进 <div> 里会被当普通文本输出（编译报「不存在名称 swOn」就是这个）
                var swOn = !gone && g.AnyOn;
                var ovMenu = OverlayMenuId(g);
                @* 整行点击 = 选中（与 mod 行同一套 .selected 高亮）。行尾那几个控件各自
                   stopPropagation，点开关/删除不会顺手把行选上。 *@
                <div class="jg-modrow @(picked ? "selected" : "")" @key="okey" data-al
                     @onclick="() => ToggleOverlaySelect(g)">
                    @if (!string.IsNullOrEmpty(rec.PackCover))
                    {
                        <img class="jg-modrow-icon" src="@rec.PackCover" alt="" loading="lazy" />
                    }
                    else
                    {
                        <div class="jg-modrow-icon jg-modrow-icon-fallback">
                            @(title.Length > 0 ? title[..1].ToUpperInvariant() : "?")
                        </div>
                    }
                    <div class="jg-modrow-text">
                        <div class="jg-modrow-title">
                            <span class="name">@title</span>
                            <span class="divider">|</span>
                            <span class="ver">@(g.Keys.Count == 1 ? rec.RelPath : Loc.F("{0} 个文件", g.Keys.Count))</span>
                            @* 只在混合段（未安装宿主 / 头像）里标宿主：宿主 mod 那几段，
                               段头已经是「封面 + 名字」，行里再挂一遍纯属噪音。
                               2026-11-10：这块现在是入口 —— 点名字去宿主 mod 详情页
                               （装着的进本地详情，没装的去 N 网页面，都没有就不可点）。 *@
                            @if (sec.ShowHostOnRows)
                            {
                                @OverlayHostTag(hostMod, host, hostJumpId)
                            }
                            @if (gone)
                            {
                                @* tooltip 只留一句：以前那段把「原因 + 该怎么做」全写进去了，
                                   悬停出来是一条横贯整行的长条（截图 2026-11-10），读都不想读。
                                   怎么做已经由右边的开关本身表达了（关着，点一下重盖）。 *@
                                <span class="jg-tag danger"
                                      data-tip='@Loc.T("可能已经失效或者被删除了")'>@Loc.T("已失效")</span>
                            }
                            @if (g.HasUpdate)
                            {
                                <button type="button" class="jg-newver"
                                        title='@Loc.F("N 网已有新版本 {0}，点击更新", g.NewVersion)'
                                        @onclick="() => UpdateOverlayAsync(g)" @onclick:stopPropagation="true">
                                    <span class="jg-newver-label">@Loc.T("新版本")</span>
                                    <span class="jg-newver-num">@g.NewVersion</span>
                                </button>
                            }
                        </div>
                        <div class="jg-modrow-desc">
                            @Loc.T(g.AnyOn ? "已启用" : "已停用")
                            @if (rec.AppliedAtUtc > DateTime.MinValue)
                            {
                                <text> · </text>
                                @rec.AppliedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            }
                        </div>
                    </div>
                    <div class="jg-modrow-end" @onclick:stopPropagation>
                        @* 2026-11-09 四改：开关永远都在。
                           没失效的：开 = 在位，点一下关掉（还原原文件）。
                           失效的：**显示成"关"**（它现在确实没盖上），点它就是按留的副本
                           重新盖一次 —— 以前这里干脆不给开关，用户只能选中这行再去下面
                           批量条点「启用」，两步且要猜。 *@
                        <button type="button" class="jg-modrow-switch jg-squish-host @(swOn ? "on" : "")" role="switch"
                                aria-checked="@swOn"
                                data-tip="@(gone
                                    ? Loc.T("这个覆盖包已失效（宿主里没有它要盖的文件了）—— 开关是关的，点一下按留下的副本重新盖")
                                    : (g.AnyOn ? Loc.T("关闭即停用此覆盖包") : Loc.T("打开即启用此覆盖包")))"
                                @onclick="() => OnOverlaySwitch(g)">
                            <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                        </button>
                        @* 打开 N 网页面 / mod 详情 / 打开文件夹 / 重新应用 / 删除 全收进「…」，
                           跟 mod 行同一套结构（.jg-modmenu + .jg-sort-menu，关闭靠页面底部那层
                           .jg-dd-overlay，翻转定位靠 fitModMenu 复用同一个 _menuFolder）。 *@
                        <div class="jg-sort-dd jg-modmenu @(_menuFolder == ovMenu ? "open" : "")" data-dd="modmenu">
                            <button class="jg-rowbtn jg-modmenu-btn" data-tip='@Loc.T("更多操作")'
                                    aria-label='@Loc.T("更多操作")'
                                    @onclick="() => ToggleMenu(ovMenu)">
                                <svg class="jg-rowbtn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <circle cx="12" cy="5" r="1.9"/>
                                    <circle cx="12" cy="12" r="1.9"/>
                                    <circle cx="12" cy="19" r="1.9"/>
                                </svg>
                            </button>
                            <div class="jg-sort-menu">
                                @if (gone)
                                {
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => ReapplyOverlaysGroup(g))">@Loc.T("重新应用")</button>
                                }
                                @if (canOpen)
                                {
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => GoOverlayDetail(rec))">@Loc.T("打开 N 网页面")</button>
                                }
                                @if (hostMod is { NexusModId: not null } hostDetail)
                                {
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => _ = OpenDetail(hostDetail))">@Loc.T("宿主 mod 详情")</button>
                                }
                                @* 「打开文件所在位置」不再给：这个包本身不住在 Mods 里，
                                   打开的是宿主 mod 的目录 —— 用户要看宿主文件，直接点宿主名字
                                   或「宿主 mod 详情」更直接，多这一项只会让人以为能在这里找到包本体。 *@
                                <button class="jg-sort-item danger" @onclick="() => MenuAct(() => RevertOverlayGroup(g))">@Loc.T("删除")</button>
                            </div>
                        </div>
                    </div>
                </div>
                }
                </div>
            }
        </div>
    }
    <div class="jg-modrows" style="@(_initialLoading || _showTrash || _filter == "overlay" ? "display:none" : "")">
        @foreach (var sec in RenderedGroups())
        {
            @* v1.3.46：「按分类」视图的分段标题。id 给右侧导航做平滑滚动落点。
               v1.3.49：段头 + 段内 mod 组套进 .jg-cat-body，折叠时 GSAP 弹簧过渡（与捆绑包同款）。
               v1.3.51：不再画六点手柄 —— 长按段头就能拖（pointer 手势见 junigrid.core.js）。
               data-cat-key 是投放目标（"" = 未分类段，也能接收 mod）；
               data-drag-key 每段都有（v1.3.55：「未分类」也能拖 —— 想让它在最上面就拖上去）。 *@
            @if (sec.HasHeader)
            {
            var headSel = CategorySelectState(sec.Key);
            <div class="jg-cat-head @(sec.Collapsed ? "collapsed" : "")" id="@CatHeadAnchor(sec.Key)"
                 data-cat-key="@sec.Key"
                 data-drag-key="@("c:" + sec.Key)"
                 data-drag-label="@sec.Label"
                 data-tip="@(sec.Collapsed ? Loc.T("点击展开这个分类") : Loc.T("点击收起这个分类"))"
                 @onclick="() => ToggleCategoryCollapse(sec.Key)">
                @* 2026-11-09：分类图标 —— 素材全部取自游戏本体（Logo / 角色大头照 / 物品图鉴），
                   22px 方框 + object-fit:contain 装图，横的竖的都不会被切掉一块。
                   没设置过 = 游戏 Logo。换图标在右侧「…」菜单里。 *@
                @* 2026-11-10：图标本身就是按钮 —— 点一下直接换图标（"换个图标"菜单项留着当第二条路）。 *@
                <button class="jg-cat-icon" data-tip='@Loc.T("点击更换分类图标")'
                        aria-label='@Loc.T("点击更换分类图标")'
                        @onclick="() => OpenIconPicker(sec.Key)" @onclick:stopPropagation="true">
                    @if (CategoryIconUrl(sec.Key) is { } iconUrl)
                    {
                        <img src="@iconUrl" alt="" draggable="false" loading="lazy" decoding="async" />
                    }
                    else
                    {
                        <span class="jg-cat-icon-ph"></span>
                    }
                </button>
                <span class="jg-cat-head-name" title='@Loc.T("双击重命名分类")'
                      @ondblclick="() => OpenCategoryRename(sec.Key)"
                      @ondblclick:stopPropagation="true">@sec.Label</span>
                <span class="jg-cat-head-n">@Loc.F("{0} 个", sec.Groups.Sum(g => g.Items.Count))</span>
                @* 2026-11-10：交互回到用户要的样子 —— 段头主体点哪儿都能展开/收起；
                   右侧原先那颗折叠箭头改成<b>全选复选框</b>（全选 / 部分 / 空 三态），
                   两件事各占一块，互不干扰。 *@
                <button class="jg-cat-check @(headSel == 2 ? "on" : headSel == 1 ? "some" : "")"
                        role="checkbox" aria-checked="@(headSel == 2 ? "true" : headSel == 1 ? "mixed" : "false")"
                        data-tip='@Loc.T("全选这个分类下的 mod")'
                        aria-label='@Loc.T("全选这个分类下的 mod")'
                        @onclick="() => ToggleCategorySelectAll(sec.Key)"
                        @onclick:stopPropagation="true">
                    <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        @if (headSel == 2)
                        {
                            <path d="M2.6 6.3L4.8 8.4L9.4 3.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        }
                        else if (headSel == 1)
                        {
                            <path d="M3 6h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        }
                    </svg>
                </button>
                @* 2026-11-09：未分类也给「…」菜单 —— 它现在能排在任意位置，光靠长按拖拽
                   没鼠标就没法调；菜单里只留上移/下移（重命名、删除对未分类没意义）。 *@
                <button class="jg-cat-head-more" data-tip='@Loc.T("分类操作")' aria-label='@Loc.T("分类操作")'
                        @onclick="() => ToggleCategoryMenu(sec.Key)"
                        @onclick:stopPropagation="true">…</button>
                @if (_categoryMenu == sec.Key)
                {
                    @* 2026-11-10：拆成「换个图标 + 重命名分类」两项太碎 —— 合成一个「编辑」，
                       对话框里名字和图标一起改（图标本来也是分类的属性）。 *@
                    <div class="jg-cat-head-menu" @onclick:stopPropagation="true">
                        @if (sec.Key.Length > 0)
                        {
                            <button class="jg-sort-item" @onclick="() => OpenCategoryEdit(sec.Key)">@Loc.T("编辑")</button>
                        }
                        <button class="jg-sort-item" @onclick="() => MoveCategoryStep(sec.Key, -1)">@Loc.T("上移一位")</button>
                        <button class="jg-sort-item" @onclick="() => MoveCategoryStep(sec.Key, +1)">@Loc.T("下移一位")</button>
                        @if (sec.Key.Length > 0)
                        {
                            <button class="jg-sort-item danger" @onclick="() => DeleteCategory(sec.Key)">@Loc.T("删除分类（不删 mod）")</button>
                        }
                    </div>
                }
            </div>

            }
            @* 隐式段（不分段视图）没有可折叠的段头，给个固定 id 就够 —— 不能和
               「未分类」段共用令牌，那样又会撞同一个 id。 *@
            <div class="jg-cat-body @(sec.Collapsed ? "collapsed" : "")"
                 id="@(sec.HasHeader ? CatBodyAnchor(sec.Key) : "jg-cat-body-flat")">
            @foreach (var group in sec.Groups)
            {
            // v1.3.67：捆绑包**恢复展开式父行**（「（3 个）」+ 每个子包一行）。
            // v1.3.57 曾把「子包都指同一页」的包并成一行，但子包版本本来就可能各不相同
            // （作者常单独更新某个组件），并成一行只能显示其中一个版本，反而看不出差异
            // —— 2026-11-07 用户要求改回来。
            var bundle = group.Key != "";
            var open = !bundle || GroupOpen(group.Key);
            // 同一个 mod 的捆绑包：几个子包都指向同一页，只在父行亮一颗更新徽标。
            // 子包来自不同页面时这里为 null，仍在各自行上显示（不吞第二个来源）。
            var groupBadge = bundle ? GroupUpdateBadge(group) : null;
            var groupBadgeVer = groupBadge is null ? null : GetState(groupBadge.Folder).RemoteVersion;
            @if (bundle)
            {
                @* 捆绑包 = 一行父包：封面取包里第一个有封面的子包（同一个 mod 的包），
                   点箭头才展开子包。点整行仍是全选/取消全选该捆绑包（v1.1.5 的行为，没删）。 *@
                var selInGroup = group.Items.Count(m => _selected.Contains(m.Folder));
                var gcover = group.Items.Select(GetCover).FirstOrDefault(c => c is not null);
                var gOn = group.Items.All(m => !m.Disabled);   // 全选框口径：全开才亮，有一个没开就是关
                @* 选中标题上那行「（N 个/已选 N 个）」的父行照子行同款样式画：
                   点父行就是整包全选，画得不一样会让人以为这行不参与选择。 *@
                    <div class="jg-modrow jg-group-head @(selInGroup == group.Items.Count ? "selected" : "")" @key="@("b:" + group.Key)"
                         data-drag-key="@("g:" + group.Key)" data-drag-label="@group.Key"
                         data-al
                         @onclick="() => ToggleGroupSelection(group.Items)">
                    @if (gcover is not null)
                    {
                        <img class="jg-modrow-icon" src="@gcover" loading="lazy" alt="" />
                    }
                    else
                    {
                        <div class="jg-modrow-icon jg-modrow-icon-fallback">@group.Key.TrimStart('.')[..1].ToUpperInvariant()</div>
                    }
                    <div class="jg-modrow-text">
                        <div class="jg-modrow-title">
                            <span class="name">@group.Key</span>
                            <span class="divider">|</span>
                            <span class="ver">@(selInGroup > 0 ? Loc.F("（{0} 个/已选 {1} 个）", group.Items.Count, selInGroup) : Loc.F("（{0} 个）", group.Items.Count))</span>
                            @if (group.Missing.Count > 0)
                            {
                                <span class="jg-tag broken">@Loc.F(" 缺失依赖 {0}", group.Missing.Count)</span>
                            }
                            @if (groupBadge is not null && groupBadgeVer is not null)
                            {
                                @NewVersionBadge(groupBadge, groupBadgeVer)
                            }
                        </div>
                    </div>
                    <div class="jg-modrow-end" @onclick:stopPropagation>
                        @* 整包开关：口径与「全选」复选框一致 —— 全开才亮，有一个没开就显示关；点下去把整包推成反面。
                           动手的是顶层一次改名（.Bundle ↔ Bundle），外加把包里每个子包的依赖联动跑一遍
                           （与子包那颗开关同一套 EnableDependencies / DisableDependents）。
                           ⚠ 参数是"要不要禁用"，与子包那颗的 !m.Disabled 同一个方向 —— 传反了
                           就是"已经开着再开一次"，被 ModService 的空操作闸门原地吞掉（实测点两下没反应）。 *@
                        <button class="jg-modrow-switch jg-squish-host @(gOn ? "on" : "")" role="switch"
                                aria-checked="@gOn" data-tip="@(gOn ? Loc.T("禁用") : Loc.T("启用"))"
                                aria-label="@(gOn ? Loc.T("禁用") : Loc.T("启用"))"
                                @onclick="() => _ = SetBundleDisabled(group, gOn)">
                            <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                        </button>
                        <button class="jg-rowbtn" data-tip='@Loc.T("加入分类")' aria-label='@Loc.T("加入分类")'
                                @onclick="() => OpenCategoryForGroup(group)">
                            <svg class="jg-rowbtn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20.6 13.4 12 22l-9-9V4h9l8.6 8.6a1 1 0 0 1 0 1.4z"/>
                                <circle cx="7.5" cy="7.5" r="1.2" fill="currentColor" stroke="none"/>
                            </svg>
                        </button>
                        <button class="jg-rowbtn" data-tip="@(open ? Loc.T("收起子包") : Loc.T("展开子包"))"
                                aria-label="@(open ? Loc.T("收起子包") : Loc.T("展开子包"))"
                                aria-expanded="@(open ? "true" : "false")"
                                @onclick="() => ToggleGroupOpen(group.Key)">
                            <svg class="jg-acc-arrow @(open ? "open" : "")" id="@SubArrowId(group.Key)" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </div>
                </div>
            }

            @* 子包永远在 DOM 里，折起时由面板 CSS 藏（height:0）—— 折叠动画要能量到真实高度，
               条件渲染的话面板一出现就是满高，只能"啪"地跳出来（GSAP 那支弹簧就没得播了）。
               散装 mod 走的是同一个面板，但它 open 恒为 true，面板对它就是一层无样式的外壳。 *@
            <div class="jg-bundle-subs @(open ? "open" : "")" id="@(bundle ? SubPanelId(group.Key) : null)">
            @foreach (var m in group.Items)
            {
                    var st = GetState(m.Folder);
                    var cover = GetCover(m);
                    var missing = MissingDeps(m);
                    var stale = StaleDeps(m);
                    var needSmapi = SmapiTooOldNeed(m);
                    var toInstall = DepsToInstall(m);
                    @* v1.1.8：@key 换成"启禁用不会变"的身份键（UID，没 UID 的散装文件夹退回 folder）。
                       旧 key 是 Folder#序号 —— 启禁用就是把 Folder 改名（X ↔ .X），于是每次点开关
                       这一行都被销毁重建：封面重新解码闪一下、正在跑的开关动画被掐断、
                       列表位置一变还会连带重建别的好几行。两种键各加前缀，互不撞（同名 UID/folder 也不会串）。 *@
                    @* v1.3.51：长按这一行就能拖到分类段头上归类（手势在 junigrid.core.js）。
                       混装包的子行不给 data-drag-key —— 分类按顶层目录登记，拖一个子包等于把整包
                       搬走，会误导。
                       ⚠ Razor 注释不能写进标签的属性列表里：那样它会变成属性值的一部分，
                       浏览器 setAttribute 直接抛 InvalidCharacterError，整页渲染当场断掉。 *@
                    @* 2026-11-07 用户要求：拖父行和拖任一子行都必须迁移**整个捆绑包**。
                       分类按顶层目录登记（GroupKeyOf），子包单独归类没有意义 —— 整包只有一个归属。
                       所以子行的拖拽键也统一成 "g:<顶层目录>"；散装 mod（无顶层目录）才是 "f:<自身>"。
                       以前这里给捆绑包子行返回 null（完全不能拖），改成 null 等于让用户以为拖不动。 *@
                    <div class="jg-modrow @(bundle ? "jg-modrow-sub" : "") @(_selected.Contains(m.Folder) ? "selected" : "") @(_deleting.Contains(m.Folder) ? "jg-modrow-deleting" : "")"
                         data-drag-key="@(bundle ? "g:" + group.Key : "f:" + m.Folder)"
                         data-drag-label="@(bundle ? group.Key : RemarkName(m))"
                         @key="@(string.IsNullOrEmpty(m.UniqueID) ? "f:" + m.Folder : "u:" + m.UniqueID)"
                         data-al
                         @onclick="() => { if (!_deleting.Contains(m.Folder)) ToggleSelect(m.Folder); }">

                        @if (cover is not null)
                        {
                            <img class="jg-modrow-icon" src="@cover" loading="lazy" alt="" />
                        }
                        else
                        {
                            <div class="jg-modrow-icon jg-modrow-icon-fallback">
                                @(m.Name.Length > 0 ? m.Name[..1].ToUpperInvariant() : "?")
                            </div>
                        }

                        <div class="jg-modrow-text">
                            <div class="jg-modrow-title">
                                <span class="name">@RemarkName(m)</span>
                                <span class="divider">|</span>
                                @* 有效本地版本：优先展示「启动器已装上的 N 网文件版本」，
                                   避免作者忘改 manifest 时列表永远停在 0.0.1 *@
                                <span class="ver">@NexusUpdateTruth.EffectiveLocalVersion(Cfg.Current, m)</span>
                                @if (_deleting.Contains(m.Folder))
                                {
                                    @* v1.3.15：删除丢后台之后，行在重扫前还留在列表上 ——
                                       必须自己说明「它正在被删」，否则用户以为没反应又点一次 *@
                                    <span class="jg-tag jg-tag-deleting">@Loc.T("删除中…")</span>
                                }
                                @if (m.IsConvertedPack)
                                {
                                    <span class="jg-tag" data-tip='@Loc.T("JuniGrid 把 Portraiture 素材转成的 CP 包，不参与 N 网版本比对")'>@Loc.T("已转换")</span>
                                }
                                else if (groupBadge is null
                                    && NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, st.RemoteVersion, st.RemoteFileId))
                                {
                                    @* 新版本徽标：右箭头 + 「新版本」+ 版本号；点版本号打开下载页 *@
                                    @NewVersionBadge(m, st.RemoteVersion!)
                                }
                                else if (st.Status is "updating")
                                {
                                    <span class="jg-newver">
                                        <svg class="jg-newver-arrow" viewBox="0 0 1024 1024" aria-hidden="true">
                                            <path d="M560 512.414C560 453.643 512.357 406 453.586 406H204.414C145.643 406 98 453.643 98 512.414v0.172C98 571.357 145.643 619 204.414 619h249.172C512.357 619 560 571.357 560 512.586v-0.172z" fill="currentColor"/>
                                            <path d="M630.024 211.105l20.067 16.805 124.46 103.419L818 366.98v0.146l39.008 33.527 24.734 21.15c22.165 18.618 35.789 41.557 41.386 65.588 5.395 23.169 2.94 47.343-7.045 69.656-7.398 16.532-19.033 32.047-34.867 45.347l-21.025 17.62a128.674 128.674 0 0 1-3.92 3.425l-40.2 33.659-42.484 35.575-118.372 99.341a133.759 133.759 0 0 1-5.123 4.078l-20.068 16.805c-36.162 30.236-79.744 36.785-117.069 22.211-24.069-9.397-45.542-27.555-60.722-53.889l-2.171-3.77c-5.856-13.007-9.497-27.58-10.563-43.322l-0.455 0.443s41.854-154.592 41.854-222.471-41.758-212.887-41.758-212.887c0.035-19.354 3.923-37.113 10.923-52.66l2.171-3.77c14.42-25.015 34.524-42.636 57.131-52.395a112.775 112.775 0 0 1 3.59-1.494c37.325-14.574 80.907-8.024 117.069 22.212z" fill="currentColor"/>
                                        </svg>
                                        <span class="jg-newver-num">@Loc.T("更新中…")</span>
                                    </span>
                                }
                                @if (m.Disabled)
                                {
                                    <span class="jg-tag">@Loc.T("已禁用")</span>
                                }
                                @if (!m.HasManifest)
                                {
                                    <span class="jg-tag" style="background:rgba(232,17,35,.12);color:#c50f1f">@Loc.T("无清单")</span>
                                }
                                @* v1.2.6：依赖装着但被禁用了 —— SMAPI 照样把依赖方 Skipped，
                                   而「缺依赖」抓不到它（确实装了）。单独一条标签，点一下开依赖。
                                   ⚠ 变量先在外面算好：写在 @if 的模式变量会被 Razor 生成到
                                   属性写入的闭包里，编译器判不出「已赋值」（CS0165），
                                   整页编译直接断掉。 *@
                                @{ var offDeps = m.Disabled ? null : DisabledDeps(m); }
                                @if (offDeps is { Count: > 0 })
                                {
                                    @* v1.3.2：提示压成一句。原来那句「XX 依赖的 YY 当前被禁用 —— 游戏里 SMAPI
                                       会跳过 XX（不是没装，是装着但关了）。点一下把依赖打开。」横贯整屏，
                                       鼠标一停就糊住半个列表；标签本身已经写了「依赖被禁」，提示只要说能点。 *@
                                    <span class="jg-tag broken"
                                          data-tip='@Loc.T("点击启动依赖")'
                                          @onclick="() => EnableItsDependencies(m)" @onclick:stopPropagation="true">@Loc.T("依赖被禁")</span>
                                }
                                @* v1.2.5：SMAPI 社区兼容性库点名「在当前游戏版本上有问题」的 mod。
                                   只标负面判定 —— 库里查不到的（实测本机约 1/3）一律不标，
                                   否则玩家会把"没数据"读成"已检查通过"。点徽标直达替代版本。 *@
                                @if (BrokenBadge(m) is { } broken)
                                {
                                    <span class="jg-tag broken" data-tip="@BrokenTip(m)"
                                          @onclick="() => OpenBrokenFix(m)" @onclick:stopPropagation="true">@broken</span>
                                }
                                @* 上游的建议早已兑现（你跑的就是它指的那一版）→ 不报警告，但也不能变成"什么都没说过"：
                                   挂一条中性标签留着"原作者不干了、这是接手版"这条信息。
                                   这些行照样算进「维护存疑」，只是不用警告色。 *@
                                @if (UnofficialTag(m) is { } unof)
                                {
                                    <span class="jg-tag" data-tip="@UnofficialTip(m)"
                                          @onclick="() => OpenUnofficial(m)" @onclick:stopPropagation="true">@unof</span>
                                }
                                @* v1.2.5：有覆盖型包（汉化补丁）盖在这个 mod 上。点开看清单、可逐个还原。
                                   失效要单独标出来 —— 宿主 mod 更新会把覆盖整个端走，不标就等于骗人说覆盖还在生效。 *@
                                @if (OverlayBadge(m) is { } ovd)
                                {
                                    <span class="jg-tag @(OverlayStale(m) ? "broken" : "")" data-tip="@OverlayTip(m)"
                                          @onclick="() => OpenOverlayList(m)" @onclick:stopPropagation="true">@ovd</span>
                                }
                            </div>
                            <div class="jg-modrow-desc">
                                @if (GetNexusCategory(m) is { } _cat)
                                {
                                    <span class="jg-cat">@_cat</span>
                                }
                                @(string.IsNullOrWhiteSpace(m.Description) ? m.Folder : m.Description)
                            </div>
                            @if (missing.Count > 0)
                            {
                                @* v1.2.5：显示解析出的 mod 名而不是裸 UID —— 玩家看到
                                   "ChaseXavier.Miku" 这种字符串并不能知道要下哪个 mod。
                                   v1.5.1：名字做成可点入口，点了直接进那个 mod 的详情页
                                   （解析不到 Nexus 页面的保持纯文字：宁可不给入口，
                                   也不能把人领到别人的 mod 页上）。 *@
                                <div class="jg-mod-updmsg failed" style="white-space:normal">
                                    @Loc.F(" 缺少依赖：{0} ", "")
                                    @for (var i = 0; i < missing.Count; i++)
                                    {
                                        if (i > 0) { <text>、</text> }
                                        var depUid = missing[i];
                                        var depDi = _depNames.TryGetValue(depUid, out var dd) ? dd : null;
                                        var depId = depDi?.ModId ?? InstalledDepNexusId(depUid);
                                        @if (depId is > 0)
                                        {
                                            <button type="button" class="jg-dep-link" @onclick:stopPropagation="true"
                                                    title="@Loc.T("点击查看 mod 详情")"
                                                    @onclick="() => OpenDepByUid(depUid, depId)">@DepLabel(depUid)</button>
                                        }
                                        else
                                        {
                                            <span>@DepLabel(depUid)</span>
                                        }
                                    }
                                </div>
                            }
                            @if (stale.Count > 0)
                            {
                                @* SMAPI 对「装得不够新」和对「没装」的处置一模一样（本 mod 整条 Skipped），
                                   所以同样标红；带上本机版本与要求的版本，玩家才知道该把谁换成哪一版。
                                   v1.5.1：装了的那批本地条目自带 NexusModId，点名字直接开详情页。 *@
                                <div class="jg-mod-updmsg failed" style="white-space:normal">
                                    @Loc.F(" 依赖版本过旧：{0} ", "")
                                    @for (var i = 0; i < stale.Count; i++)
                                    {
                                        if (i > 0) { <text>、</text> }
                                        var staleRow = stale[i];
                                        var staleUid = staleRow.Uid;
                                        // 链接只认「文件版本表里逐字含有要求版本」的那一页；没认到就不给链接。
                                        // 宁可点不了，也不能把用户领到给不出那一版的页上（实机 2026-10-12：
                                        // 原先退回 InstalledDepNexusId，于是一遍遍领回 focustense 的 28870）。
                                        var staleId = _depProvider.TryGetValue(staleUid, out var prov)
                                            ? prov.Id ?? 0 : 0;
                                        @if (staleId is > 0)
                                        {
                                            <button type="button" class="jg-dep-link" @onclick:stopPropagation="true"
                                                    title="@Loc.T("点击查看 mod 详情")"
                                                    @onclick="() => OpenDepByUid(staleUid, staleId)">@DepLabel(staleUid, staleRow)</button>
                                        }
                                        else
                                        {
                                            <span>@DepLabel(staleUid, staleRow)</span>
                                        }
                                    }
                                </div>
                            }
                            @if (needSmapi is not null)
                            {
                                @* manifest 要的 SMAPI 比本机高：SMAPI 会把这一条整条跳过，
                                   原因得写在脸上，否则玩家只会看到「装了却不加载」。 *@
                                <div class="jg-mod-updmsg failed" style="white-space:normal">
                                    @Loc.F(" 需要 SMAPI {0} 或更高（本机 {1}） ", needSmapi, _smapiVersion)
                                </div>
                            }
                            @* v1.08：检查失败/超时不再在行内显示红字，统一收进筛选栏提示 *@
                        </div>

                        @* ── v1.5：行尾操作区（玩家动力式）—— 开关直管启停；
                           详情/更新/依赖/备注/打开/删除全部收进 … 菜单。
                           整块 stopPropagation：点这里不算选中行。 ── *@
                        <div class="jg-modrow-end" @onclick:stopPropagation>
                            @* v1.1.8：换成设置页那颗挤压回弹开关（.jg-switch + junigrid.switch.js）；
                               .jg-squish-host = 这条开关自己就是拖拽宿主（设置页那边宿主是整行） *@
                            <button class="jg-modrow-switch jg-squish-host @(!m.Disabled ? "on" : "")" role="switch"
                                    aria-checked="@(!m.Disabled)" data-tip="@(!m.Disabled ? Loc.T("禁用") : Loc.T("启用"))"
                                    aria-label="@(!m.Disabled ? Loc.T("禁用") : Loc.T("启用"))"
                                    @onclick="() => SetDisabled(m, !m.Disabled)">
                                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                            </button>

                            <div class="jg-sort-dd jg-modmenu @(_menuFolder == m.Folder ? "open" : "")" data-dd="modmenu">
                                <button class="jg-rowbtn jg-modmenu-btn" data-tip='@Loc.T("更多操作")' aria-label='@Loc.T("更多操作")'
                                        @onclick="() => ToggleMenu(m.Folder)">
                                    <svg class="jg-rowbtn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <circle cx="12" cy="5" r="1.9"/>
                                        <circle cx="12" cy="12" r="1.9"/>
                                        <circle cx="12" cy="19" r="1.9"/>
                                    </svg>
                                </button>
                                <div class="jg-sort-menu">
                                    @if (toInstall.Count > 0)
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => AskInstallMissingDeps(toInstall))">@Loc.F(" 安装/更新依赖（{0}） ", toInstall.Count)</button>
                                    }
                                    @if (!m.IsConvertedPack
                                         && m.NexusModId is not null
                                         && NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, st.RemoteVersion, st.RemoteFileId))
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenUpdatePage(m))">@Loc.F(" 更新到 {0} ", st.RemoteVersion)</button>
                                    }
                                    @if (m.IsConvertedPack && m.NexusModId is not null)
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenUpdatePage(m))"> @Loc.T("打开 N 网原包页") </button>
                                    }
                                    @if (m.NexusModId is not null)
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => _ = OpenDetail(m))">@Loc.T("mod 详情")</button>
                                    }
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenCategoryForRow(m))">@Loc.T("加入分类")</button>
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenRemark(m))">@Loc.T("备注 / 重命名")</button>
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenFolder(m))">@Loc.T("打开文件所在位置")</button>
                                    <button class="jg-sort-item danger" @onclick="() => MenuAct(() => AskDeleteMod(m))">@Loc.T("删除")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            }
            </div>
        }

        @if (!_showTrash && _rowsLoaded && FilteredMods.Count == 0)
        {
            @* 两种"空"是两件事，分开说：被条件筛空了 ≠ 一个都没装。
               样式与图二那套空态共用（.jg-pk-empty* 是全局类，不是 packs 页专属）。 *@
            var bySearch = SearchText.Trim().Length > 0;
            var byFilter = _filter != "all";
            <div class="jg-pk-empty jg-mods-empty">
                @if (bySearch || byFilter)
                {
                    <svg class="jg-pk-empty-art" viewBox="0 0 220 120" fill="none" aria-hidden="true">
                        <rect x="30" y="20" width="96" height="13" rx="6.5" stroke="currentColor" stroke-width="2.5" opacity=".4"/>
                        <rect x="30" y="46" width="70" height="13" rx="6.5" stroke="currentColor" stroke-width="2.5" opacity=".26"/>
                        <rect x="30" y="72" width="86" height="13" rx="6.5" stroke="currentColor" stroke-width="2.5" opacity=".16"/>
                        <circle cx="146" cy="56" r="26" stroke="currentColor" stroke-width="2.5" opacity=".9"/>
                        <path d="m166 76 18 18" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity=".9"/>
                        <path d="M136 56h20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity=".9"/>
                    </svg>
                    <div class="jg-pk-empty-title">@Loc.T("没有符合条件的 mod")</div>
                    @* 不放按钮：清搜索词就在右上搜索框的 ✕，换档就在上面那排 chips —— 屏上已有的出口不重复给。 *@
                }
                else
                {
                    <svg class="jg-pk-empty-art" viewBox="0 0 220 120" fill="none" aria-hidden="true">
                        <path d="M56 34h30l9 11h59a8 8 0 0 1 8 8v33a8 8 0 0 1-8 8H56a8 8 0 0 1-8-8V42a8 8 0 0 1 8-8Z" stroke="currentColor" stroke-width="2.5" opacity=".9"/>
                        <path d="M48 63h114" stroke="currentColor" stroke-width="2.5" opacity=".35"/>
                        <path d="M110 74v22M99 85h22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity=".9"/>
                        <path d="M176 24l2.6 6 6 2.6-6 2.6-2.6 6-2.6-6-6-2.6 6-2.6Z" fill="currentColor" opacity=".85"/>
                    </svg>
                    <div class="jg-pk-empty-title">@Loc.T("还没有装 mod")</div>
                    <button type="button" class="jg-pill-dark" @onclick='() => Nav.NavigateTo("nexus")'>
                        <svg class="jg-pt-act-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg> @Loc.T("去 Nexus Mods 找 mod")
                    </button>
                    <div class="jg-pk-empty-note">@Loc.T("只盖本体图片的素材包在内容包页。")</div>
                }
            </div>
        }
    </div>
</div>

@* v1.3.46：按分类视图的右侧导航 —— 一根短杠一个分类；悬停出卡（分类名 + 前几个 mod），
   点击平滑滚到分段标题。按分类视图且列表里真有分段时才显示。
   v1.3.48：杠列自己是一层（.jg-catnav-list）—— 标签多到一屏放不下时它封顶并可用滚轮滚，
   卡片留在这一层外面（放进滚动区会被 overflow 裁掉），纵向位置由 JS 跟着被悬停的那根杠走。 *@
@if (!_showTrash && !_initialLoading && _categorySections.Count > 0)
{
    <div class="jg-catnav" @onmouseleave="() => _categoryHover = null">
        <div class="jg-catnav-list">
            @foreach (var sec in _categorySections)
            {
                <button class="jg-catnav-dash @(_categoryHover == sec.Key ? "hot" : "")"
                        aria-label="@sec.Label"
                        @onmouseenter="() => HoverCategory(sec.Key)"
                        @onclick="() => ScrollToCategory(sec.Key)"></button>
            }
        </div>
        @if (_categoryHover is not null && CategorySectionOf(_categoryHover) is { } hov)
        {
            <div class="jg-catnav-card">
                @* 2026-11-10：卡片左边也放分类图标 —— 右侧那根杠只有 14px 线、卡片里原先只有名字，
                   光看「222」根本记不住是哪个分类（用户实机反馈）。图标 20px 方框 + contain，
                   跟段头那颗是同一张图、同一套缓存。 *@
                <div class="jg-catnav-title">
                    <span class="jg-catnav-icon">
                        @if (CategoryIconUrl(hov.Key) is { } hovIcon)
                        {
                            <img src="@hovIcon" alt="" draggable="false" />
                        }
                        else
                        {
                            <span class="jg-cat-icon-ph"></span>
                        }
                    </span>
                    <span class="jg-catnav-name">@hov.Label</span>
                </div>
            </div>
        }
    </div>
}

@* ── 批量操作悬浮条（左键多选后出现）── *@
@if (_selected.Count > 0 && _filter != "overlay")
{
    @* v0.42.0：纯图标按钮（SVG 文件）+ 胶囊提示（data-tip，禁用按钮也有）+ 全选在最前 *@
    var anyUpdatable = _selected.Any(f => _modsByFolder.TryGetValue(f, out var mm) && CanBatchUpdate(mm));
    var anyDisabled  = _selected.Any(f => _modsByFolder.TryGetValue(f, out var mm2) && mm2.Disabled);
    var anyEnabled   = _selected.Any(f => _modsByFolder.TryGetValue(f, out var mm3) && !mm3.Disabled);
    <div class="jg-batchbar-anchor">
    <div class="jg-batchbar">
        <span class="jg-batchbar-count">@Loc.F("已选择 {0} 个", _selected.Count)</span>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("全选")' @onclick="SelectAll">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 5.5h4M4 12h4M4 18.5h4"/>
                <path d="M10 4.5l1.8 1.8L15.5 2.6"/>
                <path d="M10 11l1.8 1.8 3.7-3.7"/>
                <path d="M10 17.5l1.8 1.8 3.7-3.7"/>
            </svg>
        </button>
        <button class="jg-mini-btn jg-ico"
                data-tip='@(anyUpdatable ? Loc.T("批量更新")
                    : Loc.T("选中的 Mod 没有可更新来源（缺 Nexus / GitHub 标识）"))'
                disabled="@(_selected.Count == 0 || !anyUpdatable)" @onclick="BatchUpdate">
            <img src="assets/actions/batch-update.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("加入分类")' @onclick="OpenCategoryDialog">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.6 13.4 12 22l-9-9V4h9l8.6 8.6a1 1 0 0 1 0 1.4z"/>
                <circle cx="7.5" cy="7.5" r="1.2" fill="currentColor" stroke="none"/>
            </svg>
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("启用")' disabled="@(!anyDisabled)" @onclick="() => BatchSetDisabled(false)">
            <img src="assets/actions/enable.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("禁用")' disabled="@(!anyEnabled)" @onclick="() => BatchSetDisabled(true)">
            <img src="assets/actions/disable.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn danger-outline jg-ico" data-tip='@Loc.T("删除")' @onclick="AskBatchDelete">
            <img src="assets/actions/delete.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("取消选择")' @onclick="ClearSelection">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18"/>
            </svg>
        </button>
    </div>
</div>
}

@* ── 覆盖包多选后的批量条：与 mod 那条同一套外观，只是动作换成
   启用 / 禁用 / 删除 / 批量更新（覆盖包没有分类、备注这些概念）。 ── *@
@if (!_showTrash && _filter == "overlay" && _overlaySelected.Count > 0)
{
    var ovSel = SelectedOverlayGroups();
    var ovAnyOn = ovSel.Any(g => g.AnyOn);
    @* 失效的也算"可以启用"：对它们点启用就是按留的副本重新盖一次（见 BatchSetOverlayEnabled），
       否则选中一批全开着但已经失效的包时，这颗按钮是灰的，用户没有别的重试入口。 *@
    var ovAnyOff = ovSel.Any(g => !g.AnyOn || g.Stale > 0);
    var ovAnyUpd = ovSel.Any(g => g.HasUpdate && g.Rec.NexusModId is int && g.UpdateFileId != 0);
    <div class="jg-batchbar-anchor">
    <div class="jg-batchbar">
        <span class="jg-batchbar-count">@Loc.F("已选择 {0} 个", ovSel.Count)</span>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("全选")' @onclick="SelectAllOverlays">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 5.5h4M4 12h4M4 18.5h4"/>
                <path d="M10 4.5l1.8 1.8L15.5 2.6"/>
                <path d="M10 11l1.8 1.8 3.7-3.7"/>
                <path d="M10 17.5l1.8 1.8 3.7-3.7"/>
            </svg>
        </button>
        <button class="jg-mini-btn jg-ico"
                data-tip='@(ovAnyUpd ? Loc.T("批量更新") : Loc.T("选中的覆盖包没有可自动更新的来源"))'
                disabled="@(!ovAnyUpd)" @onclick="BatchOverlayUpdate">
            <img src="assets/actions/batch-update.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("启用（已失效的会重新盖一次）")'
                disabled="@(!ovAnyOff)" @onclick="() => BatchSetOverlayEnabled(false)">
            <img src="assets/actions/enable.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("禁用")'
                disabled="@(!ovAnyOn)" @onclick="() => BatchSetOverlayEnabled(true)">
            <img src="assets/actions/disable.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn danger-outline jg-ico" data-tip='@Loc.T("删除")' @onclick="AskOverlayBatchDelete">
            <img src="assets/actions/delete.svg" alt="" draggable="false" />
        </button>
        <button class="jg-mini-btn jg-ico" data-tip='@Loc.T("取消选择")' @onclick="ClearOverlaySelection">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18"/>
            </svg>
        </button>
    </div>
</div>
}

@* ── 备注/重命名弹窗（给 mod 起中文备注，列表里显示成 备注(原名)）── *@
@if (_remarkFolder is not null)
{
    <div class="jg-dlg-overlay" @onclick:stopPropagation>
        <div class="jg-dialog jg-remark-dialog">
            <div class="jg-remark-title">@Loc.T("给这个 mod 起备注")</div>
            <div class="jg-remark-mod">@(_remarkOriginal)</div>
            @* Motion characters-remaining 同款：输入框内右侧显示「剩余可输入数」（空=20，逐键递减到 0），
               每次输入由 GSAP 弹一下；空格不计数不显示（OnRemarkInput 过滤），满格后尝试输入 0 放大提醒 *@
            <div class="jg-remark-field">
                <input class="jg-remark-input @(_remarkInput.Length >= 16 ? "near-limit" : "")" maxlength="20" placeholder='@Loc.T("输入备注")'
                       value="@_remarkInput" @oninput="OnRemarkInput" @onkeydown="OnRemarkKeydown" />
                <span class="jg-remark-count @(_remarkInput.Length >= 20 ? "full" : _remarkInput.Length >= 16 ? "warn" : "")">@(20 - _remarkInput.Length)</span>
            </div>
            <div class="jg-dialog-actions">
                <button class="jg-btn" @onclick="CancelRemark">@Loc.T("取消")</button>
                <button class="jg-btn primary" @onclick="SaveRemark">@Loc.T("保存")</button>
            </div>
        </div>
    </div>
}

@* v1.3.46：加入分类 —— 选已有分类点一下就走；也可以输入新名字新建并加入。 *@
@if (_categoryDialogOpen)
{
    <div class="jg-dlg-overlay" @onclick:stopPropagation>
        <div class="jg-dialog jg-remark-dialog jg-cat-dialog">
            <div class="jg-remark-title">@Loc.F("把选中的 {0} 个 mod 加入分类", _categoryTargets.Count)</div>
            @* v1.3.46：照「存档」下拉的竖排样式 —— 一行一个分类，选中行整行高亮，每行右侧一颗 ×。
               v1.3.48：分类多到一定高度就自己滚（弹窗不再被标签顶长），＋ 和输入框钉在列表下面
               跟着滚走的是分类行，不是这两个出口；输入框平时不出现，点了 ＋ 才出来并直接进焦点。 *@
            <div class="jg-cat-menu">
                <div class="jg-profile-item @(!_categoryNewOpen && CommonCategory() == "" ? "active" : "")">
                    @CatIconButton("", "jg-cat-icon-row")
                    <button class="jg-profile-name" @onclick="() => AssignSelectedCategory(null)">@Loc.T("未分类")</button>
                </div>
                @foreach (var c in ExistingCategories())
                {
                    <div class="jg-profile-item @(!_categoryNewOpen && CommonCategory() == c ? "active" : "")">
                        @* 2026-11-10：每行前面带分类图标（默认小鸡），点图标就地换 —— 不用先加进去再回头改 *@
                        @CatIconButton(c, "jg-cat-icon-row")
                        <button class="jg-profile-name" @onclick="() => AssignSelectedCategory(c)">@c</button>
                        <button class="jg-profile-del" data-tip='@Loc.T("删除这个分类（mod 回到未分类，不删 mod）")'
                                aria-label='@Loc.T("删除这个分类")'
                                @onclick="() => DeleteCategory(c)">×</button>
                    </div>
                }
            </div>
            <div class="jg-cat-foot">
                @* v1.3.72：＋ 原地变成输入框（以前是在下面再长出一行，位置会跳），
                   右侧字数计数器沿用同一套。 *@
                @if (!_categoryNewOpen)
                {
                    <button class="jg-profile-addcap" data-tip='@Loc.T("新建分类")' aria-label='@Loc.T("新建分类")'
                            @onclick="FocusCategoryInput"><span class="plus">＋</span></button>
                }
                else
                {
                    @* 2026-11-10：新建行前面也有一颗图标（默认小鸡），点它就能挑 —— 建出来直接带着图 *@
                    <div class="jg-cat-newrow">
                        @CatIconButton(NewCatIconKey, "jg-cat-icon-row")
                        <div class="jg-remark-field">
                            <input class="jg-remark-input @(_categoryNewName.Length >= 16 ? "near-limit" : "")" maxlength="20"
                                   placeholder='@Loc.T("新分类名")' value="@_categoryNewName"
                                   @oninput="OnCategoryNameInput" @onkeydown="OnCategoryNameKeydown" />
                            <span class="jg-remark-count jg-cat-count-new @(_categoryNewName.Length >= 20 ? "full" : _categoryNewName.Length >= 16 ? "warn" : "")">@(20 - _categoryNewName.Length)</span>
                        </div>
                    </div>
                }
            </div>
            @if (_categoryDialogError is not null)
            {
                <div class="jg-cat-err">@_categoryDialogError</div>
            }
            <div class="jg-dialog-actions">
                <button class="jg-btn" @onclick="CloseCategoryDialog">@Loc.T("取消")</button>
                @if (_categoryNewOpen)
                {
                    <button class="jg-btn primary" @onclick="CreateCategoryFromInput">@Loc.T("新建并加入")</button>
                }
            </div>
        </div>
    </div>
}

@* 2026-11-09：本地导入（拖放 / 从文件安装）—— 装之前先选分类。
   形状与「加入分类」一致：一行一个分类、带图标，也可以现场 ＋ 新建一个。
   ⚠ 2026-11-09 晚（用户口径）：**一个 mod 只属于一个分类** —— 这里改成单选，
   点另一个就是换过去，再点一下当前那个就是取消（回到未分类）。
   与它不同的是：这里点分类只是勾选，按「继续安装」才装；取消 = 这一批不装。 *@
@if (_localPackPickOpen)
{
    <div class="jg-dlg-overlay" @onclick:stopPropagation>
        <div class="jg-dialog jg-remark-dialog jg-cat-dialog jg-lppick-dialog">
            <div class="jg-remark-title">@Loc.T("安装到哪个分类？")</div>
            <div class="jg-lppick-sub">
                @Loc.F("待安装 {0} 个压缩包 · 选一个分类，不选就是未分类", _localPackPending.Count)
            </div>
            <div class="jg-cat-menu">
                <div class="jg-profile-item @(!_localPackNewOpen && _localPackCat.Length == 0 ? "active" : "")">
                    @CatIconButton("", "jg-cat-icon-row")
                    <button class="jg-profile-name" @onclick="ClearLocalPackCat">@Loc.T("未分类")</button>
                </div>
                @foreach (var c in ExistingCategories())
                {
                    var cc = c;
                    <div class="jg-profile-item @(!_localPackNewOpen && string.Equals(_localPackCat, cc, StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        @CatIconButton(cc, "jg-cat-icon-row")
                        <button class="jg-profile-name" @onclick="() => PickLocalPackCat(cc)">@cc</button>
                    </div>
                }
            </div>
            <div class="jg-cat-foot">
                @if (!_localPackNewOpen)
                {
                    <button class="jg-profile-addcap" data-tip='@Loc.T("新建分类")' aria-label='@Loc.T("新建分类")'
                            @onclick="FocusLocalPackNewInput"><span class="plus">＋</span></button>
                }
                else
                {
                    <div class="jg-cat-newrow">
                        @CatIconButton(LocalNewCatIconKey, "jg-cat-icon-row")
                        <div class="jg-remark-field">
                            <input class="jg-remark-input" maxlength="20"
                                   placeholder='@Loc.T("新分类名")' value="@_localPackNewName"
                                   @oninput="OnLocalPackNewInput" @onkeydown="OnLocalPackNewKeydown" />
                        </div>
                    </div>
                }
            </div>
            @if (_localPackDialogError is not null)
            {
                <div class="jg-cat-err">@_localPackDialogError</div>
            }
            <div class="jg-dialog-actions">
                <button class="jg-btn" @onclick="CancelLocalPackPick">@Loc.T("取消")</button>
                @if (_localPackNewOpen)
                {
                    <button class="jg-btn primary" @onclick="CreateLocalPackCategory">@Loc.T("新建并勾选")</button>
                }
                else
                {
                    <button class="jg-btn primary" @onclick="ConfirmLocalPackCategory">
                        @(_localPackCat.Length == 0 ? Loc.T("不分类，直接安装") : Loc.T("继续安装"))
                    </button>
                }
            </div>
        </div>
    </div>
}

@* 2026-11-10：编辑分类 —— 名字和图标一起改。
   原来菜单里「换个图标」和「重命名分类」是两项，用户要合成一个「编辑」：
   图标本来就是分类的一个属性，分开改反而像两件事。 *@
@if (_categoryRenameFrom is not null)
{
    var editKey = _categoryRenameFrom;
    <div class="jg-dlg-overlay" @onclick:stopPropagation>
        <div class="jg-dialog jg-remark-dialog jg-cat-dialog">
            <div class="jg-remark-title">@Loc.F("编辑分类「{0}」", editKey)</div>
            <div class="jg-cat-edit">
                <button class="jg-cat-icon jg-cat-icon-big" data-tip='@Loc.T("点图标换一个")'
                        aria-label='@Loc.T("点图标换一个")'
                        @onclick="() => OpenIconPicker(editKey)">
                    @if (CategoryIconUrl(editKey) is { } editIcon)
                    {
                        <img src="@editIcon" alt="" draggable="false" />
                    }
                    else
                    {
                        <span class="jg-cat-icon-ph"></span>
                    }
                </button>
                <span class="jg-cat-edit-hint">@Loc.T("点图标换一个")</span>
            </div>
            <div class="jg-remark-field">
                <input class="jg-remark-input @(_categoryRenameDraft.Length >= 16 ? "near-limit" : "")" maxlength="20"
                       placeholder='@Loc.T("新分类名")' value="@_categoryRenameDraft"
                       @oninput="OnCategoryRenameInput" @onkeydown="OnCategoryRenameKeydown" />
                <span class="jg-remark-count jg-cat-count-rename @(_categoryRenameDraft.Length >= 20 ? "full" : _categoryRenameDraft.Length >= 16 ? "warn" : "")">@(20 - _categoryRenameDraft.Length)</span>
            </div>
            @if (_categoryDialogError is not null)
            {
                <div class="jg-cat-err">@_categoryDialogError</div>
            }
            <div class="jg-dialog-actions">
                <button class="jg-btn" @onclick="() => { _categoryRenameFrom = null; _categoryDialogError = null; }">@Loc.T("取消")</button>
                <button class="jg-btn primary" @onclick="ConfirmCategoryRename">@Loc.T("保存")</button>
            </div>
        </div>
    </div>
}

@* 2026-11-09：分类图标选择器 —— 素材全部取自游戏本体：Logo / 角色大头照 / 物品图鉴。
   选完立刻落盘（点一下就走，没有"确定"），关闭走遮罩或底部按钮。 *@
@if (_iconPickOpen)
{
    var curIcon = IconSpecOf(_iconPickKey);
    <div class="jg-dlg-overlay" @onclick="CloseIconPicker">
        <div class="jg-dialog jg-cat-icon-dialog" @onclick:stopPropagation>
            <div class="jg-remark-title">@Loc.F("给「{0}」选个图标", IconCategoryLabel(_iconPickKey))</div>
            <div class="jg-icon-tabs">
                <button class="jg-icon-tab @(_iconTab == "default" ? "on" : "")" @onclick='() => SwitchIconTab("default")'>@Loc.T("默认")</button>
                <button class="jg-icon-tab @(_iconTab == "portrait" ? "on" : "")" @onclick='() => SwitchIconTab("portrait")'>@Loc.T("角色")</button>
                <button class="jg-icon-tab @(_iconTab == "item" ? "on" : "")" @onclick='() => SwitchIconTab("item")'>@Loc.T("物品")</button>
                @if (_iconTab != "default")
                {
                    <input class="jg-remark-input jg-icon-search" placeholder='@Loc.T(_iconTab == "item" ? "搜物品名" : "搜角色名")'
                           value="@_iconSearch" @oninput="OnIconSearch" />
                }
            </div>
            @* 2026-11-10：一次只铺一批，滚到底自动续 —— 不再有「显示更多」按钮
               （600 多件物品点按钮点到手酸）。滚动监听在 junigrid.taskdock.js。 *@
            <div class="jg-icon-grid">
                @foreach (var opt in IconOptions())
                {
                    @IconOptionButton(opt, curIcon)
                }
            </div>
            <div class="jg-dialog-actions">
                <button class="jg-btn" @onclick="CloseIconPicker">@Loc.T("关闭")</button>
            </div>
        </div>
    </div>
}

    @* v0.71.6：存档下拉打开时铺透明遮罩，点"除下拉框本身以外"的地方收回。
       v1.1.2：改常驻 DOM + class 随状态绑定 —— 原 @if 渲染比 profileDropdown 的
       同帧 .open 翻转慢一拍，遮罩永远追不上菜单，点外部收不掉。 *@
    @* v1.5：行尾 … 菜单遮罩 —— 所有行共用一个键，点外部收回。
       open 必须写进 class：写在 class 外只会生成 HTML 属性，CSS .jg-dd-overlay.open 永远匹配不上，
       遮罩 pointer-events 一直是 none，点外部收不掉（只能再点 … 关）。 *@
    <div class="jg-dd-overlay @(_menuFolder is not null ? "open" : "")" data-dd="modmenu" @onclick="CloseMenu"></div>

    <div class="jg-dd-overlay @(_profileOpen ? "open" : "")" data-dd="profile" @onclick="CloseProfile"></div>

    @* v0.46.0：删除存档确认对话框 *@
    @if (_deletingProfile is not null)
    {
        <div class="jg-modal-overlay" @onclick="CancelDeleteProfile">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">@Loc.T("删除存档")</div>
                <div class="jg-modal-body">@Loc.F("确定删除「{0}」存档吗？（仅删除 mod 存档，对游戏内的存档无影响）", _deletingProfile)</div>
                <div class="jg-modal-actions">
                    <button class="jg-mini-btn" data-modal-close @onclick="CancelDeleteProfile">@Loc.T("取消")</button>
                    <button class="jg-mini-btn danger" @onclick="ConfirmDeleteProfile">@Loc.T("删除")</button>
                </div>
            </div>
        </div>
    }

    @* 删除 mod 确认对话框（单个 / 批量共用，替代旧的行内二段式确认） *@
    @if (_pendingDeleteMod is not null || _pendingBatchDelete || _pendingDeleteGroupFolders is not null)
    {
        <div class="jg-modal-overlay" @onclick="CancelDeleteMods">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">@Loc.T("删除 mod")</div>
                <div class="jg-modal-body">@Loc.T("确定删除所选mod？")</div>
                <label class="jg-modal-trash-opt">
                    <input type="checkbox" @bind="_deleteToTrash" />
                    <span>@Loc.T("移入mod回收站（不勾选将彻底删除）")</span>
                </label>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" data-modal-close @onclick="CancelDeleteMods">@Loc.T("取消")</button>
                    <button type="button" class="jg-pill-danger" @onclick="ConfirmDeleteMods">@Loc.T("确定删除")</button>
                </div>
            </div>
        </div>
    }



    @* ── 覆盖包批量删除确认：会把盖上去的文件还原成原版，并删掉留下的副本 ── *@
    @if (_pendingOverlayDelete is not null)
    {
        <div class="jg-modal-overlay" @onclick="CancelOverlayBatchDelete">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">@Loc.T("删除覆盖包")</div>
                <div class="jg-modal-body">
                    @Loc.F("确定删除所选的 {0} 个覆盖包？", _pendingOverlayDelete.Count)
                    <br /><br />
                    @Loc.T("盖上去的文件会还原成原版，JuniGrid 留下的副本也会删掉；宿主 mod 本身不受影响。")
                </div>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" @onclick="CancelOverlayBatchDelete">@Loc.T("取消")</button>
                    <button type="button" class="jg-pill-danger" @onclick="ConfirmOverlayBatchDelete">@Loc.T("确定删除")</button>
                </div>
            </div>
        </div>
    }

    @* ── v1.5.5：回收站的还原冲突确认 —— 说清楚「现有的可能是新版」，执意才顶替 ── *@
    @if (_pendingRestore is not null)
    {
        <div class="jg-modal-overlay" @onclick="CancelRestoreTrash">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">@Loc.T("还原会顶替现有的 mod")</div>
                <div class="jg-modal-body">
                    @Loc.F("Mods 里已经有一个叫「{0}」的文件夹，它可能是你后来装的新版。", _pendingRestoreName)
                    <br /><br />
                    @Loc.T("继续还原会用回收站里的这份顶替它。现有那份不会被删 —— 它会先被移进回收站，之后还能再找回。")
                </div>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" @onclick="CancelRestoreTrash">@Loc.T("取消")</button>
                    <button type="button" class="jg-pill-danger" @onclick="ConfirmRestoreTrash">@Loc.T("仍然还原")</button>
                </div>
            </div>
        </div>
    }

    @* ── v1.5.5：永久删除确认，不可逆 ── *@
    @if (_pendingTrashDelete is not null)
    {
        <div class="jg-modal-overlay" @onclick="CancelDeleteTrash">
            <div class="jg-modal" @onclick:stopPropagation>
                <div class="jg-modal-title">@Loc.T("永久删除")</div>
                <div class="jg-modal-body">
                    @Loc.F("将从回收站彻底删除 {0} 份快照（{1}），无法恢复。", _pendingTrashDelete.Count,
                        ResumableDownload.FormatBytes(_pendingTrashDelete.Sum(x => x.Bytes)))
                </div>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" @onclick="CancelDeleteTrash">@Loc.T("取消")</button>
                    <button type="button" class="jg-pill-danger" @onclick="ConfirmDeleteTrashAsync">@Loc.T("永久删除")</button>
                </div>
            </div>
        </div>
    }
    @* ── v1.2.0：一键安装缺失依赖 —— 确认弹窗（空列表 = 全部缺失依赖）── *@
    @if (_pendingDepUids is not null)
    {
        var depList = _pendingDepUids.Count > 0 ? _pendingDepUids : TotalMissingUids;
        <div class="jg-modal-overlay" @onclick="CancelInstallDeps">
            <div class="jg-modal" @onclick:stopPropagation style="max-width:540px">
                <div class="jg-modal-title">@Loc.T("安装缺失依赖")</div>
                <div class="jg-modal-body">@Loc.F(" 将从 Nexus 下载并安装以下 {0} 个依赖（装上后新暴露的传递依赖会自动跟进）： ", depList.Count)<div class="jg-dep-list">
                        @foreach (var u in depList)
                        {
                            var di = _depNames.TryGetValue(u, out var dd) ? dd : null;
                            // 2026-11-07 用户实机：「完整手册」要的是 StardewUI Continued（43861，
                            // 版本 0.6.4-unofficial-mushymato.0），弹窗却显示 focustense 原版
                            // 「StardewUI」——因为本机装着的那份（0.6.1）复用了同一个 UniqueID
                            // 且挂在原版页上，弹窗就照它的自述来报。装了但版本不够的依赖，
                            // 「真正有那一版」的页（_depProvider）才是要点开/要下载的那一页。
                            if (_depProvider.TryGetValue(u, out var prov) && prov.Id is int pid && pid > 0)
                                di = new InstallService.DependencyDisplayInfo(u, prov.Name ?? di?.Name, pid, di?.CoverUrl);
                            var clickable = di?.ModId is not null;
                            var coverData = di?.CoverUrl;
                            <div class="jg-dep-row" data-clickable="@clickable"
                                 style="display:flex;align-items:center;gap:10px;min-width:0;@(clickable ? "cursor:pointer" : "")"
                                 title="@(clickable ? Loc.T("点击查看 mod 详情") : "")"
                                 @onclick="() => OpenDepDetail(di)">
                                @if (coverData is not null)
                                {
                                    <img src="@coverData" alt="" loading="lazy"
                                         style="width:34px;height:34px;border-radius:6px;object-fit:cover;flex:none;pointer-events:none" />
                                }
                                else
                                {
                                    <div class="jg-modrow-icon jg-modrow-icon-fallback"
                                         style="width:34px;height:34px;border-radius:6px;flex:none;font-size:14px">
                                        @(u.Length > 0 ? u[..1].ToUpperInvariant() : "?")
                                    </div>
                                }
                                <div style="flex:1;min-width:0;pointer-events:none">
                                    <div style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(di?.Name ?? u)</div>
                                    @if (di?.Name is not null)
                                    {
                                        <div style="font-size:11px;opacity:.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@u</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div style="margin-top:8px;font-size:12px;opacity:.6"> @Loc.T("每个依赖都会在下载后校验 manifest UniqueID，防止装错 mod；SMAPI 本体需单独安装。") </div>
                </div>
                <div class="jg-modal-actions">
                    <button type="button" class="jg-pill-ghost" data-modal-close @onclick="CancelInstallDeps">@Loc.T("取消")</button>
                    <button type="button" class="jg-pill-dark" disabled="@(_depInstalling || Installer.Busy)"
                            @onclick="ConfirmInstallDeps">@Loc.T("开始安装")</button>
                </div>
            </div>
        </div>
    }

    @* ── v1.2.0：依赖安装结果弹窗（手动项附 Nexus 链接）──
       v1.3.4：已删除 —— 手动依赖的页面本来就会自动在浏览器打开，结果弹窗是重复打扰；
       任务中心的完成摘要（"已安装 X 个；Y 个需手动"）足够。 *@

    @* ── v1.2.5：盖在某个 mod 上的覆盖包清单 ──
       覆盖的本质是"往别人的 mod 目录里写文件"，所以必须看得见、能撤回；
       否则用户只会发现 mod 变了却查不到是谁干的。 ── *@
    @if (_overlayHost is not null)
    {
        <div class="jg-modal-overlay" @onclick="CloseOverlayList">
            <div class="jg-modal" @onclick:stopPropagation style="max-width:560px">
                <div class="jg-modal-title">@Loc.F("盖在「{0}」上的覆盖包", _overlayHost)</div>
                <div class="jg-modal-body">
                    <div class="jg-dep-list">
                        @foreach (var g in OverlayGroups())
                        {
                            var rec = g.Rec;
                            var gone = g.Stale > 0;
                            var title = OverlayTitle(rec);
                            var canOpen = rec.NexusModId is int;
                            <div class="jg-dep-row" style="display:flex;align-items:center;gap:10px;min-width:0">
                                @* 封面 + 名字这一块就是「进这个汉化包的 N 网详情页」的入口；
                                   名字被省略号截断，所以整块挂 data-tip 显示全名。 *@
                                <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0;@(canOpen ? "cursor:pointer" : "")"
                                     data-tip="@title" @onclick="() => GoOverlayDetail(rec)" @onclick:stopPropagation="true">
                                    @if (!string.IsNullOrEmpty(rec.PackCover))
                                    {
                                        <img src="@rec.PackCover" alt="" loading="lazy"
                                             style="width:34px;height:34px;border-radius:6px;object-fit:cover;flex:none" />
                                    }
                                    else
                                    {
                                        <div class="jg-modrow-icon jg-modrow-icon-fallback"
                                             style="width:34px;height:34px;border-radius:6px;flex:none;font-size:14px">
                                            @(title.Length > 0 ? title[..1].ToUpperInvariant() : "?")
                                        </div>
                                    }
                                    <div style="flex:1;min-width:0">
                                        <div style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@title</div>
                                        <div style="font-size:11px;opacity:.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                            @(g.Keys.Count == 1 ? g.Rec.RelPath : Loc.F("{0} 个文件", g.Keys.Count))
                                            @if (gone)
                                            {
                                                <span style="color:#c50f1f"> · @Loc.T("已不在")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @* 开关就是启用/停用本身：关掉时把原文件放回去、开着时从我们留的副本再放上去，
                                   不需要重新下载汉化包。失效的那行不给开关 —— 它此刻是"开"的，
                                   拨一下只会把它关掉（用户以为在重新应用，其实什么都没盖）；
                                   与全局列表一致：失效只剩「删除」和（有页面时的）打开 N 网。
                                   宿主必须是 button + .jg-modrow-switch（display:flex）：写成裸 span 的话
                                   .jg-switch 那颗轨道也是 inline，40x22 宽高不生效，实机只剩一个黑点
                                   （同 portraits.css 那条 2026-09-30 的坑）。 *@
                                @if (!gone)
                                {
                                    <button type="button" class="jg-modrow-switch jg-squish-host @(g.AnyOn ? "on" : "")" role="switch"
                                            aria-checked="@g.AnyOn" data-tip="@Loc.T("打开即启用此覆盖包")"
                                            @onclick="() => ToggleOverlayGroup(g, !g.AnyOn)" @onclick:stopPropagation="true">
                                        <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                                    </button>
                                }
                                @* 已失效的那行不叫"还原"：宿主目录被重装过，磁盘上那份就是上游新版，
                                   没有东西可以还原，点它只是把这条账销掉。 *@
                                <button type="button" class="jg-pill-ghost"
                                        @onclick="() => RevertOverlayGroup(g)">@Loc.T("删除")</button>
                            </div>
                        }
                    </div>
                    @* 只留这一句：宿主 mod 更新会把覆盖端走，是唯一会让人"以为覆盖还在生效"的坑。
                       说的是覆盖包，不是汉化 —— 这条通道贴图包、兼容包也走。 *@
                    <div style="margin-top:8px;font-size:12px;opacity:.6">@Loc.T("宿主 mod 更新后，覆盖包会跟着自动重新盖上。这里显示失效的，是宿主里已经找不到那个文件（作者改了名或删掉了），需要重新下载新版本的覆盖包。")</div>
                </div>

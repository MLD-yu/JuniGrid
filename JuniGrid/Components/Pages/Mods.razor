    /// <summary>把当前启用集合写回 ActiveProfile（"默认"档是运行时视图，不参与持久化）。</summary>
    private void PersistCurrentToActive()
    {
        var active = ActiveProfileName;
        var p = AllProfiles.FirstOrDefault(x => x.Name.Equals(active, StringComparison.OrdinalIgnoreCase));
        if (p is null) return;
        p.EnabledModUids = _mods
            .Where(m => !m.Disabled && !string.IsNullOrWhiteSpace(m.UniqueID))
            .Select(m => m.UniqueID)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        // "默认"可能是 AllProfiles 临时插入、不在配置列表里的 —— 写回时补进去
        if (!Cfg.Current.ModProfiles.Any(x => ReferenceEquals(x, p) || (x.Name == p.Name && x.GameVersion == p.GameVersion)))
            Cfg.Current.ModProfiles.Add(p);
    }




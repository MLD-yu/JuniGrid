@namespace JuniGrid.Components.Pages
@page "/mods"
@inject ConfigService Cfg
@inject ModService ModSvc
@inject GameService Game
@inject UpdateService Updater
@inject NexusService Nexus
@inject InstallService Installer
@inject PageRefreshService PageRefresh
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TaskCenterService Center
@inject DepotDownloaderService DepotQr
@implements IDisposable

<div class="jg-page">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px">
        <div>
            <div style="display:flex;align-items:center;gap:14px">
                <h1 style="margin-top:0;margin-bottom:4px">Mod 管理</h1>
                @* v1.07.3：普通文件夹图标，点击打开 Mods 目录；data-tip 与导航栏同款胶囊提示 *@
                <button class="jg-mods-folder-btn" data-tip="打开 mods 文件夹" aria-label="打开 mods 文件夹"
                        @onclick="OpenModsRootFolder">
                    <svg viewBox="0 0 1024 1024" width="32" height="32" fill="#f2b544">
                        <path d="M855.04 385.024q19.456 2.048 38.912 10.24t33.792 23.04 21.504 37.376 2.048 54.272q-2.048 8.192-8.192 40.448t-14.336 74.24-18.432 86.528-19.456 76.288q-5.12 18.432-14.848 37.888t-25.088 35.328-36.864 26.112-51.2 10.24l-567.296 0q-21.504 0-44.544-9.216t-42.496-26.112-31.744-40.96-12.288-53.76l0-439.296q0-62.464 33.792-97.792t95.232-35.328l503.808 0q22.528 0 46.592 8.704t43.52 24.064 31.744 35.84 12.288 44.032l0 11.264-53.248 0q-40.96 0-95.744-0.512t-116.736-0.512-115.712-0.512-92.672-0.512l-47.104 0q-26.624 0-41.472 16.896t-23.04 44.544q-8.192 29.696-18.432 62.976t-18.432 61.952q-10.24 33.792-20.48 65.536-2.048 8.192-2.048 13.312 0 17.408 11.776 29.184t29.184 11.776q31.744 0 43.008-39.936l54.272-198.656q133.12 1.024 243.712 1.024l286.72 0z"/>
                    </svg>
                </button>
            </div>
            <div style="opacity:.7;font-size:13px">
                @* v1.08：骨架屏只负责磁盘扫描阶段；检查更新期间列表照常显示 *@
                @if (_initialLoading) { <span>正在加载 mod 列表…</span> }
                else { <text>共 @_mods.Count 个（@_mods.Count(m => !m.Disabled) 已启用）</text> }
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
            @* v0.47.0：存档下拉挪到最右；GSAP easeReverse 弹性开合（参照官方 demo）*@
            <div class="jg-profile-dd @(_profileOpen ? "open" : "")" data-dd="profile">
                @* v0.71.4：重命名挪到下拉按钮右边 —— 点铅笔后按钮变输入框、铅笔变确定，改名只在这一个位置发生 *@
                @if (_renamingProfile is not null)
                {
                    <input class="jg-profile-input jg-profile-headinput" maxlength="30"
                           value="@_renameBuffer"
                           @oninput="e => _renameBuffer = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="e => OnRenameKey(e, _renamingProfile!)"
                           @onclick:stopPropagation />
                    <button class="jg-profile-headconfirm" data-tip="确定" aria-label="确定"
                            @onclick="() => ConfirmRename(_renamingProfile!)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                            <path d="M20 6 9 17l-5-5"/>
                        </svg>
                    </button>
                }
                else
                {
                    <button class="jg-sort-trigger" @onclick="ToggleProfile">
                        @ActiveProfileName
                        <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    @if (ActiveProfileName != "默认")
                    {
                        <button class="jg-profile-rename jg-profile-headrename" data-tip="重命名" aria-label="重命名"
                                @onclick="() => StartRenameProfile(ActiveProfileName)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                                <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                <path d="m15 5 4 4"/>
                            </svg>
                        </button>
                    }
                }
                <div class="jg-sort-menu jg-profile-menu">
                    @foreach (var p in AllProfiles)
                    {
                        <div class="jg-profile-item @(p.Name == ActiveProfileName ? "active" : "")">
                            @* v0.71.4：菜单项只负责切换/删除；重命名统一由下拉按钮右侧的铅笔入口发起 *@
                            <button class="jg-profile-name"
                                    @onclick="() => ApplyProfileAndClose(p.Name)">@p.Name</button>
                            @if (p.Name != "默认")
                            {
                                <button class="jg-profile-del" @onclick="() => AskDeleteProfile(p.Name)">×</button>
                            }
                        </div>
                    }
                    <div class="jg-profile-item">
                        @if (_addingProfile)
                        {
                            <input class="jg-profile-input" placeholder="存档名称" maxlength="30"
                                   @bind="_newProfileName" @bind:event="oninput" />
                            <button class="jg-profile-name" style="font-weight:600;flex:none" @onclick="ConfirmAddProfile">确定</button>
                        }
                        else
                        {
                            @* 虚线胶囊 + 悬停胶囊提示（导航栏同款 data-tip 风格）*@
                            <button class="jg-profile-addcap" data-tip="新建存档" aria-label="新建存档" @onclick="StartAddProfile">
                                <span class="plus">＋</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── SMAPI 永远第一个显示（用自己的 exe 图标，不用 emoji）── *@
    <div class="jg-card jg-smapi-card" style="margin-top:12px">
        <div style="display:flex;align-items:center;gap:12px">
            @* v0.37.0：exe 抽不到图标时用自带的 pufferchick 兜底，不再显示灰色 S 占位块 *@
            @if (_smapiIcon is not null)
            {
                <img class="jg-modrow-icon" src="@_smapiIcon" alt="SMAPI" />
            }
            else
            {
                <img class="jg-modrow-icon" src="assets/smapi-pufferchick.svg" alt="SMAPI"
                     style="border-radius:8px;background:var(--jg-card);padding:2px" />
            }
            <div style="min-width:0;flex:1">
                <div style="font-weight:700">
                    SMAPI
                    <span style="opacity:.6;font-weight:400;font-size:12px">Mod 加载器</span>
                </div>
                <div style="opacity:.75;font-size:12.5px;margin-top:3px">
                    @if (_smapiVersion is null)
                    {
                        @if (SmapNeedsOld && _smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
                        {
                            <span>未安装 · 当前游戏 @GameVerDisplay 适配 SMAPI @_smapiUpdate.LatestVersion，点右侧按钮一键下载安装</span>
                        }
                        else if (SmapNeedsOld)
                        {
                            <span style="color:#f0b95a">
                                当前游戏 @GameVerDisplay ·
                                @(SmapiUnsupported ? "无一键适配 SMAPI，可去 Nexus 手动找历史包" : "推荐 " + SmapRecommendShort)
                            </span>
                        }
                        else if (_smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
                        {
                            <span>未安装 · 最新版 @_smapiUpdate.LatestVersion，点右侧按钮一键下载安装</span>
                        }
                        else if (_smapiUpdate is { Error: not null })
                        {
                            <span style="color:#c50f1f">未安装 · 获取版本信息失败（@_smapiUpdate.Error）</span>
                        }
                        else
                        {
                            <span>未安装 · 正在获取版本信息…</span>
                        }
                    }
                    else
                    {
                        <text>当前版本：@SmapiDisplay</text>
                        @if (_smapiUpdate is { HasUpdate: true } && !SmapNeedsOld)
                        {
                            <span style="color:#b4009e;font-weight:600"> ⇧ 新版本 @_smapiUpdate.LatestVersion 可用</span>
                        }
                        else if (SmapNeedsOld)
                        {
                            <span style="color:#f0b55a"> · 当前游戏 @GameVerDisplay
                                @(SmapiUnsupported ? "无一键适配 SMAPI" : "适合 " + SmapRecommendShort)</span>
                        }
                    }
                </div>
            </div>
            @* v1.1.8/1.1.9：历史版本与 4.5.2 同管线；旧版按钮按本地映射秒出，不等 GitHub *@
            @if (NeedsCompatibleOldSmapi)
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="InstallSmapi">
                    @(_smapiUpdating ? "正在安装…" : (_smapiVersion is null ? "⬇ 下载安装 " : "⬇ 安装适配的 ") + CompatibleOldSmapiLabel)
                </button>
            }
            else if (_smapiVersion is null && _smapiUpdate is { LatestVersion: not null, InstallerZipUrl: not null })
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="InstallSmapi">
                    @(_smapiUpdating ? "正在安装…" : $"⬇ 下载安装 SMAPI {_smapiUpdate.LatestVersion}")
                </button>
            }
            else if (_smapiVersion is null && SmapNeedsOld && SmapiUnsupported)
            {
                <a class="jg-update-link" style="width:auto;padding:8px 16px;text-decoration:none"
                   href="@SmapRecommendUrl" target="_blank" rel="noopener">
                    去 Nexus 找历史包
                </a>
            }
            else if (_smapiUpdate is { HasUpdate: true } && !SmapNeedsOld)
            {
                <button class="jg-update-link" style="width:auto;padding:8px 16px"
                        disabled="@_smapiUpdating" @onclick="UpdateSmapi">
                    @(_smapiUpdating ? "正在更新…" : $"⬇ 更新到 {_smapiUpdate.LatestVersion}")
                </button>
            }
        </div>
    </div>

    @if (_mods.Count == 0)
    {
        <div class="jg-card" style="margin-top:12px">
            Mods 文件夹为空或未定位到游戏。请先在「设置」里选择游戏目录。
        </div>
    }

    @* ── v0.34.0 工具条：排序在前 → 筛选 chips → 搜索（点击向右延伸，SVG 图标） ── *@
    <div class="jg-mods-toolbar">
        <div class="jg-sort-dd @(_sortOpen ? "open" : "")" data-dd="sort">
            <button class="jg-sort-trigger" @onclick="ToggleSort">
                排序方式
                <svg class="jg-sort-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="jg-sort-menu">
                <button class="jg-sort-item @(_sortMode == "time-asc" ? "active" : "")" @onclick='() => SetSort("time-asc")'>最新在前</button>
                <button class="jg-sort-item @(_sortMode == "time-desc" ? "active" : "")" @onclick='() => SetSort("time-desc")'>最早在前</button>
                <button class="jg-sort-item @(_sortMode == "alpha" ? "active" : "")" @onclick='() => SetSort("alpha")'>首字母</button>
            </div>
        </div>
        @* v1.1.2：遮罩改常驻 DOM + class 随状态绑定（原 @if 渲染比 JS 慢一拍：
           dropdownToggle 同帧翻转 .open 时遮罩元素还不存在，开菜单后点外部收不掉） *@
        <div class="jg-dd-overlay @(_sortOpen ? "open" : "")" data-dd="sort" @onclick="CloseSort"></div>
        <div class="jg-chips" role="group" style="align-items:center">
        @foreach (var f in _filterOptions)
        {
            <button class="jg-chip @(_filter == f.Key ? "active" : "")"
                    style="@(f.Key == "updatable" && FailedCheckCount > 0 ? "position:relative" : "")"
                    @onclick="() => SetFilter(f.Key)">
                @f.Label<span style="opacity:.7;font-weight:400"> · @CountFor(f.Key)</span>
                @if (f.Key == "updatable" && FailedCheckCount > 0)
                {
                    @* v1.08：有检查失败的 mod → 可更新标签右上角小红点 *@
                    <span style="position:absolute;top:-3px;right:-3px;width:8px;height:8px;border-radius:50%;background:#e81123;box-shadow:0 0 0 2px var(--jg-bg)"></span>
                }
            </button>
        }
        @if (FailedCheckCount > 0)
        {
            <span style="font-size:12px;color:#c50f1f;opacity:.85;white-space:nowrap">更新检查超时，请检查网络（@FailedCheckCount 个未完成）</span>
        }
        else if (_checkingUpdates)
        {
            <span style="font-size:12px;opacity:.6;white-space:nowrap">正在检查更新…</span>
        }
        </div>
        <div class="jg-search-x @(_searchOpen ? "open" : "")">
            <button class="jg-search-btn" @onclick="ToggleSearch">
                <img src="assets/search.svg" alt="搜索" style="width:18px;height:18px;display:block" />
            </button>
            <div class="jg-search-field">
                <input class="jg-search-input" placeholder="搜mod名/N网尾号"
                       @bind="SearchText" @bind:event="oninput" />
                <button class="jg-search-clear" @onclick="ClearSearchAndClose">✕</button>
            </div>
        </div>
    </div>

    @* ── v1.2.0：缺失依赖横幅 + 一键安装 ── *@
    @if (!_initialLoading && TotalMissingUids.Count > 0)
    {
        <div class="jg-card" style="margin-top:12px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;border-left:3px solid #f2b544">
            <span style="font-size:13px">
                检测到 <b>@TotalMissingUids.Count</b> 个缺失依赖，影响 @MissingAffectedMods 个 mod
            </span>
            <button class="jg-pill-dark" style="padding:7px 16px;font-size:12.5px"
                    disabled="@(_depInstalling || Installer.Busy)"
                    @onclick="() => AskInstallMissingDeps(null)">
                @(_depInstalling ? "正在安装…（进度见右下角任务）" : "一键安装缺失依赖")
            </button>
            <button class="jg-pill-ghost" style="padding:7px 14px;font-size:12.5px"
                    @onclick='() => SetFilter("missing")'>查看列表</button>
            @if (_depError is not null)
            {
                <span style="color:#c50f1f;font-size:12.5px">@_depError</span>
            }
        </div>
    }

    @* ── 单行 mod 列表 ── *@
    @* v1.06.9：首次加载 或 检查更新未完成 → 一律显示 shimmer 骨架屏，真实列表 display:none *@
    @if (_initialLoading)
    {
        <div class="jg-modrows jg-modrows-skeleton">
            @for (var i = 0; i < 8; i++)
            {
                <div class="jg-modrow-shimmer">
                    <div class="jg-shimmer jg-shimmer-avatar"></div>
                    <div class="jg-shimmer-lines">
                        <div class="jg-shimmer jg-shimmer-line" style="width:38%"></div>
                        <div class="jg-shimmer jg-shimmer-line" style="width:68%"></div>
                    </div>
                    <div class="jg-shimmer jg-shimmer-pill"></div>
                </div>
            }
        </div>
    }
    <div class="jg-modrows" style="@(_initialLoading ? "display:none" : "")">
        @foreach (var group in Groups)
        {
            @if (group.Key != "")
            {
                // v1.1.5：分组不再折叠，永远全展开。点击分组标题 = 全选/取消全选该捆绑包；
                // 计数随选择状态显示"（X 个）"或"（X 个/已选 Y 个）"。
                var selInGroup = group.Items.Count(m => _selected.Contains(m.Folder));
                <div class="jg-group-head" @onclick="() => ToggleGroupSelection(group.Items)">
                    <span style="font-weight:600">@group.Key</span>
                    <span style="opacity:.55;font-size:11.5px">@(selInGroup > 0 ? $"（{group.Items.Count} 个/已选 {selInGroup} 个）" : $"（{group.Items.Count} 个）")</span>
                    @if (group.Missing.Count > 0)
                    {
                        <span style="color:#c50f1f;font-size:11.5px"> 缺失依赖 @group.Missing.Count</span>
                    }
                </div>
            }

            @foreach (var m in group.Items)
            {
                    var st = GetState(m.Folder);
                    var cover = GetCover(m);
                    var missing = MissingDeps(m);
                    @* v1.1.8：@key 换成"启禁用不会变"的身份键（UID，没 UID 的散装文件夹退回 folder）。
                       旧 key 是 Folder#序号 —— 启禁用就是把 Folder 改名（X ↔ .X），于是每次点开关
                       这一行都被销毁重建：封面重新解码闪一下、正在跑的开关动画被掐断、
                       列表位置一变还会连带重建别的好几行。两种键各加前缀，互不撞（同名 UID/folder 也不会串）。 *@
                    <div class="jg-modrow @(_selected.Contains(m.Folder) ? "selected" : "")"
                         @key="@(string.IsNullOrEmpty(m.UniqueID) ? "f:" + m.Folder : "u:" + m.UniqueID)"
                         data-al
                         @onclick="() => ToggleSelect(m.Folder)">

                        @if (cover is not null)
                        {
                            <img class="jg-modrow-icon" src="@cover" loading="lazy" alt="" />
                        }
                        else
                        {
                            <div class="jg-modrow-icon jg-modrow-icon-fallback">
                                @(m.Name.Length > 0 ? m.Name[..1].ToUpperInvariant() : "?")
                            </div>
                        }

                        <div class="jg-modrow-text">
                            <div class="jg-modrow-title">
                                <span class="name">@RemarkName(m)</span>
                                <span class="divider">|</span>
                                @* 有效本地版本：优先展示「启动器已装上的 N 网文件版本」，
                                   避免作者忘改 manifest 时列表永远停在 0.0.1 *@
                                <span class="ver">@NexusUpdateTruth.EffectiveLocalVersion(Cfg.Current, m)</span>
                                @if (m.IsConvertedPortraitPack)
                                {
                                    <span class="jg-tag" data-tip="JuniGrid 把 Portraiture 素材转成的 CP 包，不参与 N 网版本比对">已转换</span>
                                }
                                else if (NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, st.RemoteVersion, st.RemoteFileId))
                                {
                                    <span class="upd jg-upd-jump" title="点击打开 @st.RemoteVersion 的下载页"
                                          @onclick="() => OpenUpdatePage(m)" @onclick:stopPropagation="true">⇧ @st.RemoteVersion</span>
                                }
                                else if (st.Status is "updating")
                                {
                                    <span class="upd">⇧ 更新中…</span>
                                }
                                @if (m.Disabled)
                                {
                                    <span class="jg-tag">已禁用</span>
                                }
                                @if (!m.HasManifest)
                                {
                                    <span class="jg-tag" style="background:rgba(232,17,35,.12);color:#c50f1f">无清单</span>
                                }
                            </div>
                            <div class="jg-modrow-desc">
                                @if (GetNexusCategory(m) is { } _cat)
                                {
                                    <span class="jg-cat">@_cat</span>
                                }
                                @(string.IsNullOrWhiteSpace(m.Description) ? m.Folder : m.Description)
                            </div>
                            @if (missing.Count > 0)
                            {
                                <div class="jg-mod-updmsg failed" style="white-space:normal">
                                    缺少依赖：@string.Join("、", missing)
                                </div>
                            }
                            @* v1.08：检查失败/超时不再在行内显示红字，统一收进筛选栏提示 *@
                        </div>

                        @* ── v1.5：行尾操作区（玩家动力式）—— 开关直管启停；
                           详情/更新/依赖/备注/打开/删除全部收进 … 菜单。
                           整块 stopPropagation：点这里不算选中行。 ── *@
                        <div class="jg-modrow-end" @onclick:stopPropagation>
                            @* v1.1.8：换成设置页那颗挤压回弹开关（.jg-switch + junigrid.switch.js）；
                               .jg-squish-host = 这条开关自己就是拖拽宿主（设置页那边宿主是整行） *@
                            <button class="jg-modrow-switch jg-squish-host @(m.Disabled ? "" : "on")" role="switch"
                                    aria-checked="@(!m.Disabled)" data-tip="@(m.Disabled ? "启用" : "禁用")"
                                    aria-label="@(m.Disabled ? "启用" : "禁用")"
                                    @onclick="() => SetDisabled(m, !m.Disabled)">
                                <span class="jg-switch"><span class="jg-switch-knob"></span></span>
                            </button>

                            <div class="jg-sort-dd jg-modmenu @(_menuFolder == m.Folder ? "open" : "") @(_menuClosingFolder == m.Folder ? "closing" : "")" data-dd="modmenu">
                                <button class="jg-rowbtn jg-modmenu-btn" data-tip="更多操作" aria-label="更多操作"
                                        @onclick="() => ToggleMenu(m.Folder)">
                                    <svg class="jg-rowbtn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <circle cx="12" cy="5" r="1.9"/>
                                        <circle cx="12" cy="12" r="1.9"/>
                                        <circle cx="12" cy="19" r="1.9"/>
                                    </svg>
                                </button>
                                <div class="jg-sort-menu">
                                    @if (missing.Count > 0)
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => AskInstallMissingDeps(missing))">
                                            安装缺失依赖（@missing.Count）
                                        </button>
                                    }
                                    @if (!m.IsConvertedPortraitPack
                                         && m.NexusModId is not null
                                         && NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, st.RemoteVersion, st.RemoteFileId))
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenUpdatePage(m))">
                                            更新到 @st.RemoteVersion
                                        </button>
                                    }
                                    @if (m.IsConvertedPortraitPack && m.NexusModId is not null)
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenUpdatePage(m))">
                                            打开 N 网原包页
                                        </button>
                                    }
                                    @if (m.NexusModId is not null)
                                    {
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => _ = OpenDetail(m))">mod 详情</button>
                                    }
                                    @if (LoosePortraitCandidate(m))
                                    {
                                        @* 手工拖进来的裸 PNG/XNB 素材目录：安装管线只在下装那一刻转换，
                                           这种手放的以前没人管 —— 给一个显式入口，点了才转 *@
                                        <button class="jg-sort-item" @onclick="() => MenuAct(() => AskConvertPortrait(m))">
                                            转成 CP 肖像包
                                        </button>
                                    }
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenRemark(m))">备注 / 重命名</button>
                                    <button class="jg-sort-item" @onclick="() => MenuAct(() => OpenFolder(m))">打开文件所在位置</button>
                                    <button class="jg-sort-item danger" @onclick="() => MenuAct(() => AskDeleteMod(m))">删除</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

        @if (FilteredMods.Count == 0)
        {
            <div class="jg-card" style="margin-top:4px">没有符合条件的 mod（试试清空搜索 / 切换过滤）。</div>
        }
    </div>
</div>

@* ── 批量操作悬浮条（左键多选后出现）── *@
@if (_selected.Count > 0)
{
    @* v0.42.0：纯图标按钮（SVG 文件）+ 胶囊提示（data-tip，禁用按钮也有）+ 全选在最前 *@
    var anyUpdatable = _selected.Any(f => _modsByFolder.TryGetValue(f, out var mm) && IsUpdatable(mm));

    /// <summary>列回收站。Measure 要遍历几千个文件读大小和 manifest —— 放后台线程跑，
    /// 否则切到回收站那一刻 UI 线程被 IO 堵住，页面卡一下（用户实测 2026-10-20）。</summary>
    private void LoadTrash(bool forceRefresh = false)
    {
        if (_trashLoading) return;
        _trashLoading = true;
        if (!_trashLoaded || forceRefresh)
        {
            _trashLoaded = false;
            StateHasChanged();
        }

        var game = Cfg.Current.GamePath;
        _ = Task.Run(() =>
        {
            List<TrashItem> items;
            try
            {
                items = string.IsNullOrWhiteSpace(game)
                    ? new List<TrashItem>()
                    : TrashService.List(game, forceRefresh);
            }
            catch (Exception ex)
            {
                AppLog.Warn("Trash", "列回收站失败: " + ex.Message);
                items = new List<TrashItem>();
            }
            var groups = items
                .GroupBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase)
                .Select(grp => new TrashGroup(grp.Key,
                    grp.OrderByDescending(x => x.DeletedAt ?? DateTime.MinValue).ToList()))
                .OrderBy(grp => grp.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            _ = InvokeAsync(async () =>
            {
                _trashItems = items;
                _trashCount = items.Count;
                _trashGroups = groups;
                var alive = items.Select(x => x.FolderName).ToHashSet();
                _trashSelected.RemoveWhere(f => !alive.Contains(f));
                _trashLoaded = true;
                _trashLoading = false;
                StateHasChanged();
                // v1.5.5：回收站行是异步回填的，OnAfterRender 的绑定时序不可靠 ——
                // 回填后显式绑定一次滚动入场观察器，和 mod 列表同一套效果（用户实测 2026-10-20）
                try { await JS.InvokeVoidAsync("junigridJs.animatedListInit", ".jg-main", ".jg-modrows"); } catch { }
            });
        });
    }


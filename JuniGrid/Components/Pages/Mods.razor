    {
        "broken" => Loc.T("SMAPI 兼容性清单给的维护状态（需非官方版 / 有替代版 / 已失效 / 已过期 / 作者弃养）"),
        // 「缺依赖」不再给提示：那句子太长，横在筛选条上方挡视线，标签本身已经说清了
        _ => null,
    };

    /// <summary>「找问题」的状态筛选（见 v1.3.56）：这些视图不按分类分段，
    /// 结果平铺 —— 否则「可更新 2」还要先躲开一堆分类段头才看得见那两行。
    /// v1.9.x：覆盖包同样是"找东西"的视图，而且它压根不是 ModEntry，不能进分类分段。</summary>
    private bool IsStatusFilter => _filter is "updatable" or "missing" or "broken" or "overlay";

    /// <summary>已装 UniqueID 集合（v1.2.3：指向 ReindexMods 维护的缓存，不再每次访问全表重建）。</summary>
    private HashSet<string> InstalledUids => _installedUids;

    /// <summary>应用过滤 + 搜索后的 mod 列表。</summary>
    private IReadOnlyList<ModEntry> FilteredMods
    {
        get
        {
            IEnumerable<ModEntry> q = _mods;
            switch (_filter)
            {
                case "enabled": q = q.Where(m => !m.Disabled); break;
                case "disabled": q = q.Where(m => m.Disabled); break;
                case "updatable":
                    q = q.Where(m => IsUpdatable(m));
                    break;
                case "missing":
                    // v1.1.4：缺依赖筛选 —— 含 ContentPackFor 宿主缺失（SMAPI 同样会 Skipped）
                    // 版本过旧的那批也在这里：SMAPI 对两者的处置是同一条（依赖方不加载）
                    // v1.9.x：manifest 要的 SMAPI 比本机新的也归这里 —— 同样是整条跳过
                    q = q.Where(m => MissingDeps(m).Count > 0 || StaleDeps(m).Count > 0
                        || SmapiTooOldNeed(m) is not null);
                    break;
                case "broken":
                    q = q.Where(IsBroken);
                    break;
                // 覆盖包不是 ModEntry，行由 AllOverlayGroups() 单独渲染 ——
                // 这里必须返回空集，否则底下的 mod 列表会在覆盖包视图里继续画一遍。
                case "overlay":
                    q = Enumerable.Empty<ModEntry>();
                    break;
            }
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var s = SearchText.Trim();
                // 输入是纯数字时，当成 N 网尾号（NexusModId）模糊匹配，例如 4964794 或只输 9647 都能定位到。
                bool numeric = int.TryParse(s, out _);
                // v1.1.4：备注名/原名一并参与搜索 —— 列表标题显示"自动化(Automate)"，
                // 搜"自动化"或"Automate"都得能找到（备注在配置里，不在 m.Name 上）
                var remarks = Cfg.Current.ModRemarks;
                var originals = Cfg.Current.ModOriginalNames;
                q = q.Where(m =>
                    m.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || m.Author.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || m.UniqueID.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (remarks.TryGetValue(m.Folder, out var rk) && rk.Contains(s, StringComparison.OrdinalIgnoreCase))
                    || (originals.TryGetValue(m.Folder, out var og) && og.Contains(s, StringComparison.OrdinalIgnoreCase))
                    || (numeric && m.NexusModId is not null
                        && m.NexusModId.Value.ToString().Contains(s, StringComparison.Ordinal)));
            }
            return q.ToList();
        }
    }

    private int CountFor(string key) => key switch
    {
        "all" => CountRows(_mods),
        "enabled" => CountRows(_mods.Where(m => !m.Disabled)),
        "disabled" => CountRows(_mods.Where(m => m.Disabled)),
        "updatable" => CountRows(_mods.Where(IsUpdatable)),
        "missing" => CountRows(_mods.Where(m => MissingDeps(m).Count > 0 || StaleDeps(m).Count > 0
            || SmapiTooOldNeed(m) is not null)),
        "broken" => CountRows(_mods.Where(IsBroken)),
        "overlay" => AllOverlayGroups().Count,
        _ => 0,
    };

    /// <summary>「共 N 个 / 可更新 N」里的 N 是<b>多少个 mod</b>，不是多少行 ——
    /// 捆绑包的父行只是包名，不该算一个 mod（子包 3 个就报 3）。
    /// <para>v1.3.67：捆绑包恢复展开式父行后，这里不需要再为「并成一行」打折。</para></summary>
    private static int CountRows(IEnumerable<ModEntry> set)
    {
        var n = 0;
        foreach (var g in set.GroupBy(GroupKeyOf, StringComparer.OrdinalIgnoreCase))
            n += g.Count();
        return n;
    }

    // ── v1.2.5：SMAPI 社区兼容性判定（数据随上面的 smapi.io 批量预查一起取回）──
    // 词表按 SMAPI 那份库：ok / unknown / optional 都不构成提示，只有明确的负面判定才标。
    private static bool IsBadCompatStatus(string? s) =>
        !string.IsNullOrEmpty(s) && s is not ("ok" or "unknown" or "optional");

    /// <summary>「维护存疑」的口径 = 上游清单点名过的那些行，<b>包括已经在跑社区接手版的</b>：
    /// "原作者不 maintenance 了"这件事与"你还有没有东西要下"是两个事实，前者一条都不能漏，
    /// 否则这个筛选就成了"只列还能去装的那几个"。区别只在行上挂什么 —— 还有得装的给警告徽标
    /// （<see cref="BrokenBadge"/>），已兑现的给中性标签（<see cref="UnofficialTag"/>）。
    /// 计数只依赖第一次批量响应，不依赖后到的身份证据，所以切进来不会看到数字跳。</summary>
    private bool IsBroken(ModEntry m) =>
        _smapiPrecheckStatus is not null
        && _smapiPrecheckStatus.TryGetValue(m.Folder, out var st) && IsBadCompatStatus(st);

    /// <summary>这一行的身份证据还在路上，先别落徽标。只推迟"除替代版页面版本以外没有别的证据"的行：
    /// summary 里直接写了推荐版本号的（<c>&lt;small&gt;</c>）与"替代版就是自己那页"的当场就能判，
    /// 不该被推迟；解析彻底失败的行在证据标记落下后照常标出来，不会永远压着不报。</summary>
    private bool AltEvidenceInFlight(ModEntry m) => _altEvidencePending
        && AltOf(m) is null && AltVerOf(m) is null
        && string.IsNullOrEmpty(RecommendedVersion(BrokenRaw(m)));

    private string? BrokenBadge(ModEntry m)
    {
        if (_smapiPrecheckStatus is null
            || !_smapiPrecheckStatus.TryGetValue(m.Folder, out var st) || !IsBadCompatStatus(st)) return null;
        if (AltIsSelfNow(m) || AltEvidenceInFlight(m)) return null;
        return st switch
        {
            "unofficial" => Loc.T("需非官方版"),
            "workaround" => Loc.T("有替代版"),
            "broken"     => Loc.T("已失效"),
            "obsolete"   => Loc.T("已过期"),
            "abandoned"  => Loc.T("作者弃养"),
            _            => Loc.T("有问题"),
        };
    }

    /// <summary>被点名、但上游的建议早已兑现（你跑的就是它指的那一版）的行：<b>不报警告</b>，
    /// 只挂一条中性标签，把"原作者不干了、这是社区接手版"这条信息留着。撤徽标撤的是重复提醒，
    /// 不是这条事实 —— 什么都不说等于把已知信息删掉。与警告徽标互斥，但照样被「维护存疑」列出。</summary>
    private string? UnofficialTag(ModEntry m)
    {
        if (_smapiPrecheckStatus is null
            || !_smapiPrecheckStatus.TryGetValue(m.Folder, out var st) || !IsBadCompatStatus(st)) return null;
        if (AltEvidenceInFlight(m) || !AltIsSelfNow(m)) return null;
        return st == "unofficial" ? Loc.T("非官方接手") : Loc.T("作者已停更");
    }

    /// <summary>中性标签的落点：优先"你跑的这一版实际住在的那一页"（搜到的替代版页，或 summary
    /// 链接指的页），都没有才回落到它自己的页面。文案与点击共用这一个判据。</summary>
    internal static (string Url, bool OnForkPage) PickUnofficialTarget(
        string? rawSummary, (int ModId, string Name)? alt, int? nexusModId, string name, string folder)
    {
        var page = alt?.ModId ?? SummaryLinkId(rawSummary);
        if (page > 0) return ("https://www.nexusmods.com/stardewvalley/mods/" + page, true);
        // 实测：Wind Effects / SAAT / Show Birthdays 的接手版根本不住在 N 网 —— summary 里那条
        // 链接直接指向论坛帖或 GitHub releases。跳回早已停更的原页面没有意义，就去它给的那个地址。
        var link = MdLink.Match(rawSummary ?? "");
        if (link.Success && IsWebUrl(link.Groups[2].Value)) return (link.Groups[2].Value, true);
        if (nexusModId is int own && own > 0)
            return ("https://www.nexusmods.com/stardewvalley/mods/" + own, false);
        return ("https://www.nexusmods.com/stardewvalley/search?q="
            + Uri.EscapeDataString(string.IsNullOrWhiteSpace(name) ? folder : name), false);
    }

    private string UnofficialTip(ModEntry m)
    {
        var (_, onFork) = PickUnofficialTarget(BrokenRaw(m), AltOf(m), m.NexusModId, m.Name, m.Folder);
        return onFork
            ? Loc.F("你装的 {0} 就是社区接手的那一版 · 原作者已停更 · 点一下打开接手版页面", m.Version)
            : Loc.F("你装的 {0} 是社区接手版 · 原作者已停更 · 点一下打开原页面（已停更）", m.Version);
    }

    private void OpenUnofficial(ModEntry m) => UpdateService.OpenUrl(PickUnofficialTarget(
        BrokenRaw(m), AltOf(m), m.NexusModId, m.Name, m.Folder).Url);

    // ── v1.2.5：覆盖型包（汉化补丁）的标记、清单与还原 ──
    private ModService.OverlayReport _overlayHealth = new(new(), new());
    private string? _overlayHost;

    /// <summary>覆盖记录按宿主<b>顶层</b>目录名记账，而列表行的 m.Folder 可能是 "Top/Sub"
    /// （子包），且禁用态在磁盘上是 ".Top"。统一归一到不带点的顶层名再比。</summary>
    /// <summary>覆盖记录按「宿主目录」挂徽标，所以这里必须给到和记录里同一个形状：
    /// 顶层就是顶层名，捆绑包子包是「捆绑包/子包」（子包的汉化只该出现在子包那一行）。
    /// 禁用只是顶层改名（X → .X），点号在这里去掉。</summary>
    private static string OverlayHostOf(ModEntry m) => ModService.NormalizeOverlayHost(m.Folder);

    /// <summary>某个宿主行对应的「包」数与失效包数。记录是逐文件的（一个汉化重打包 146 条），
    /// 徽标要说包数 —— 显示「覆盖 ×146」等于骗人。</summary>
    private (int Packs, int StalePacks) OverlayPackStats(string host)
    {
        var groups = Cfg.Current.Overlays
            .Where(kv => ModService.NormalizeOverlayHost(kv.Value.Host)
                .Equals(host, StringComparison.OrdinalIgnoreCase))
            .GroupBy(kv => ModService.OverlaySlotOf(kv.Key), StringComparer.OrdinalIgnoreCase)
            .ToList();
        return (groups.Count, groups.Count(g => g.Any(kv => _overlayHealth.StaleKeys.Contains(kv.Key))));
    }

    private string? OverlayBadge(ModEntry m)
    {
        if (_overlayHost is not null) return null;
        if (!_overlayHealth.ByHost.ContainsKey(OverlayHostOf(m))) return null;
        return Loc.F("覆盖 ×{0}", OverlayPackStats(OverlayHostOf(m)).Packs);
    }

    private bool OverlayStale(ModEntry m) => OverlayPackStats(OverlayHostOf(m)).StalePacks > 0;

    private string OverlayTip(ModEntry m)
    {
        var s = OverlayPackStats(OverlayHostOf(m));
        return s.StalePacks > 0
            ? Loc.F("{0} 个覆盖包，其中 {1} 个已经不在了（宿主 mod 更新过）—— 点击查看或还原", s.Packs, s.StalePacks)
            : Loc.F("{0} 个覆盖包（汉化补丁等）—— 点击查看或还原", s.Packs);
    }

    private void OpenOverlayList(ModEntry m)
    {
        _overlayHost = OverlayHostOf(m);
        _ = GuardedFireAndForget(EnsureOverlayMetaAsync(), "元信息加载");
    }
    private void CloseOverlayList() => _overlayHost = null;

    /// <summary>卡片标题：优先 N 网解析来的 mod 名，退回包名，再退回"来自 N 网"。</summary>
    private static string OverlayTitle(OverlayRecord rec) =>
        !string.IsNullOrWhiteSpace(rec.PackTitle) ? rec.PackTitle
        : !string.IsNullOrWhiteSpace(rec.PackName) ? rec.PackName : LocService.Tr("来自 N 网");


    /// <summary>覆盖包不是装进 Mods 的 mod，没有本地行可点，所以详情页入口挂在卡片上。
    /// 路由的 UniqueID 段是可选的（"/mod/{ModId:int}/{UniqueID?}"），这里只有 N 网 id。</summary>
    private void GoOverlayDetail(OverlayRecord rec)
    {
        if (rec.NexusModId is not int id) return;
        CloseOverlayList();
        Nav.NavigateTo($"mod/{id}");
    }

    /// <summary>用记录里的 NexusModId 补齐显示名与封面，写回记录（一次性的，之后离线也认得）。</summary>
    private async Task EnsureOverlayMetaAsync()
    {
        var need = Cfg.Current.Overlays.Values
            .Where(v => v.NexusModId is int && string.IsNullOrEmpty(v.PackTitle))
            .ToList();
        foreach (var rec in need)
        {
            NexusModInfo? info;
            try { info = await Nexus.GetModAsync(rec.NexusModId!.Value); }
            catch { continue; }
            if (info is null || string.IsNullOrWhiteSpace(info.Name)) continue;
            rec.PackTitle = info.Name;
            rec.PackCover = info.PictureUrl ?? "";
            Cfg.Save(Cfg.Current);
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>一个「包」在某个宿主上的一组覆盖记录。汉化重打包会一次产生上百条逐文件记录
    /// （LewdDew 那个是 146 条），卡片必须一行一个包，开关和删除对整组生效。</summary>
    private sealed record OverlayGroup(string Host, string Slot, List<string> Keys,
        OverlayRecord Rec, bool AnyOn, int Stale)
    {
        /// <summary>N 网上有比这里更新的 MAIN 文件。判不了（没装过记录 / 没登录 / 网络失败）
        /// 一律为 false —— 红点是"要你处理"的信号，猜不出来就不许亮。</summary>
        public bool HasUpdate { get; init; }
        public string? NewVersion { get; init; }
        /// <summary>N 网那条新 MAIN 的 fileId —— 「更新」按钮直接按它装，不走"最新 MAIN"再猜一次。</summary>
        public long UpdateFileId { get; init; }
    }

    /// <summary>覆盖包全局分组（跨宿主）。<see cref="OverlayGroups"/> 是它在「某个宿主」上的切片。
    /// <para>按「归一化宿主 + 槽位」分组：禁用态在磁盘上是 <c>.Top</c>，不归一化会让同一个包
    /// 在 Top 与 .Top 下各成一行。槽位是 <c>N{modId}</c> 或包名，同一个槽位盖在两家宿主上时
    /// 是两组 —— 它们是两份独立的落盘，必须能分别开关。</para></summary>
    private IReadOnlyList<OverlayGroup> AllOverlayGroups()
    {
        if (_overlayCache is not null && _overlayCacheRev == _overlayRev) return _overlayCache;
        var list = Cfg.Current.Overlays
            .GroupBy(kv => (Host: ModService.NormalizeOverlayHost(kv.Value.Host),
                            Slot: ModService.OverlaySlotOf(kv.Key)))
            .Select(g =>
            {
                var first = g.First().Value;
                var baseRec = new OverlayGroup(
                    first.Host,
                    g.Key.Slot,
                    g.Select(kv => kv.Key).OrderBy(k => k, StringComparer.OrdinalIgnoreCase).ToList(),
                    first,
                    g.Any(kv => kv.Value.Enabled),
                    g.Count(kv => _overlayHealth.StaleKeys.Contains(kv.Key)));
                return _overlayUpdates.TryGetValue(g.Key.Slot, out var up) && up.Has
                    ? baseRec with { HasUpdate = true, NewVersion = up.Ver, UpdateFileId = up.FileId }
                    : baseRec;
            })
            // 失效的最要紧，其次有新版，其余按名字 —— 红点点开第一眼就该看见要处理的那几行。
            .OrderBy(g => g.Stale > 0 ? 0 : g.HasUpdate ? 1 : 2)
            .ThenBy(g => g.Rec.PackTitle.Length > 0 ? g.Rec.PackTitle : g.Rec.PackName,
                StringComparer.OrdinalIgnoreCase)
            .ToList();
        _overlayCache = list;
        _overlayCacheRev = _overlayRev;
        return list;
    }

    private IReadOnlyList<OverlayGroup>? _overlayCache;
    private int _overlayCacheRev = -1;
    /// <summary>覆盖包视图的失效戳：账、副本、健康度、版本检查结论任一变化都要 ++。</summary>
    private int _overlayRev;

    // ── 覆盖包分组（2026-11-09 三改：一个宿主 mod 一段）────────────────────
    /// <summary>覆盖包列表的一段 = 一个宿主 mod。
    /// <para><see cref="Label"/> 是宿主 mod 的真名（不是目录名），<see cref="Cover"/> 是它的封面 ——
    /// 段头就是「封面 + 名字」，跟分类段头一个样子：用户看到的是「Farm Queue 3 个」，
    /// 不是「宿主 mod 27 个」。没装宿主的那一段没有封面，名字写「未安装宿主 mod」。</para>
    /// <para><see cref="ShowHostOnRows"/>：宿主是逐段唯一的，段头已经说明白了，行里再挂一遍
    /// 就是噪音；只有「未安装宿主 mod / 头像」这种混合段才需要逐行标出它原本盖在哪个目录上。</para></summary>
    private sealed record OverlaySection(string Key, string Label, string? Cover,
        List<OverlayGroup> Items, bool Collapsed, bool ShowHostOnRows);

    /// <summary>已折叠的分组。与 <see cref="_collapsedCats"/> 分开存：那边是 mod 分类，
    /// 键空间是用户的分类名，混进来会让「未安装宿主 mod」这种名字被当成真分类。</summary>
    private readonly HashSet<string> _collapsedOverlaySecs = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>按宿主 mod 分段：装着的宿主各占一段（封面 + 名字），
    /// 没装宿主的一律归到最后一段「未安装宿主 mod」。
    /// <para>「头像」不是第四种分类，而是「没装宿主、但确实是立绘/头像素材」的那些包 ——
    /// 它们塞进「未安装」段会让人以为是自己把 host mod 删了；有宿主的头像包照旧归宿主那一段。</para>
    /// <para>有失效或新版的段排前面：红点点开第一眼就该看见要处理的那几个宿主。</para>
    /// <para>空段不画：一个「0 个」的段头只会让人以为丢了东西。</para></summary>
    private IReadOnlyList<OverlaySection> OverlaySections()
    {
        var sections = new List<OverlaySection>();
        var portraits = new List<OverlayGroup>();
        var orphans = new List<OverlayGroup>();

        foreach (var grp in AllOverlayGroups()
                     .GroupBy(g => ModService.NormalizeOverlayHost(g.Host), StringComparer.OrdinalIgnoreCase))
        {
            var items = grp.ToList();
            if (grp.Key.Length > 0 && HostIndex().TryGetValue(grp.Key, out var m))
            {
                // 段内顺序沿用 AllOverlayGroups 的「失效 → 新版 → 名字」，GroupBy 保序
                sections.Add(new OverlaySection("h:" + grp.Key, RemarkName(m), GetCover(m), items,
                    _collapsedOverlaySecs.Contains("h:" + grp.Key), false));
            }
            else if (items.All(IsPortraitOverlay))
            {
                portraits.AddRange(items);
            }
            else
            {
                orphans.AddRange(items);
            }
        }

        // 有问题的段排前面，其余按名字 —— 段数可能二十来个，不排就只能靠找
        sections = sections
            .OrderBy(s => s.Items.Any(g => g.Stale > 0) ? 0 : s.Items.Any(g => g.HasUpdate) ? 1 : 2)
            .ThenBy(s => s.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();

        void Add(string key, string label, string? cover, List<OverlayGroup> items, bool hostOnRows)
        {
            if (items.Count == 0) return;
            sections.Add(new OverlaySection(key, label, cover, items,
                _collapsedOverlaySecs.Contains(key), hostOnRows));
        }
        Add("portrait", LocService.Tr("头像"), null, portraits, true);
        Add("nohost", LocService.Tr("未安装宿主 mod"), null, orphans, true);
        return sections;
    }

    /// <summary>混合段里逐行标注「这个包盖在哪个目录上」。宿主没装就写目录名 ——
    /// 段头已经说了没装，行里再写一遍「未安装宿主 mod」等于什么都没说。</summary>
    private string OverlayRowHostLabel(string host)
    {
        var norm = ModService.NormalizeOverlayHost(host);
        if (norm.Length == 0) return LocService.Tr("没有指定宿主");
        var seg = norm.Split('/')[^1];
        return seg.Length > 0 ? seg : norm;
    }

    /// <summary>这份覆盖包是不是「头像 / 立绘」类。<b>看落点，不看包名猜</b>：
    /// 真正决定它属于哪一类的是它盖了宿主里的哪个目录，名字只作兜底
    /// （汉化包里也有包名带 Portrait 其实翻的是文案的）。</summary>
    private bool IsPortraitOverlay(OverlayGroup g)
    {
        foreach (var k in g.Keys)
        {
            if (!Cfg.Current.Overlays.TryGetValue(k, out var r)) continue;
            var rel = r.RelPath.Replace('\\', '/').ToLowerInvariant();
            if (rel.Contains("portrait")) return true;
        }
        var name = (OverlayTitle(g.Rec) + "|" + g.Host).ToLowerInvariant();
        return name.Contains("portrait") || name.Contains("立绘") || name.Contains("头像");
    }

    /// <summary>段体 id。键里现在是宿主目录名（可能带 <c>:</c> <c>/</c> 和方括号），
    /// 直接拼进 id 不合法；catToggle 用 getElementById 取，所以只需唯一、不含空白。</summary>
    private static string OverlaySecAnchor(string key)
    {
        var sb = new System.Text.StringBuilder("jg-ov-sec-");
        foreach (var ch in key)
            sb.Append(char.IsLetterOrDigit(ch) ? ch : '_');
        return sb.ToString();
    }

    /// <summary>段头点击：折叠/展开这一组。与 <see cref="ToggleCategoryCollapse"/> 同一套时序
    /// （先让 JS 播手风琴，动画回来再落状态，否则 CSS 的 height:0 会抢跑）。</summary>
    private async Task ToggleOverlaySection(string key)
    {
        var collapse = !_collapsedOverlaySecs.Contains(key);
        try { await JS.InvokeVoidAsync("junigridJs.catToggle", OverlaySecAnchor(key), !collapse); }
        catch { }
        if (collapse) _collapsedOverlaySecs.Add(key);
        else _collapsedOverlaySecs.Remove(key);
        StateHasChanged();
    }

    /// <summary>账/健康度/开关/删除之后调用 —— 下一帧重算覆盖包分组。</summary>
    private void InvalidateOverlayCache() => _overlayRev++;

    /// <summary>筛选按钮上那颗红点的依据：有失效的，或者有新版本的。
    /// <para>只算「包」不算文件：一个汉化重打包上百年逐文件记录，按条数报会把 1 个包说成 146。</para></summary>
    private int OverlayAttentionCount => AllOverlayGroups().Count(g => g.Stale > 0 || g.HasUpdate);

    /// <summary>覆盖包的「有没有新版」。
    /// <para>与 Mods 行不同：覆盖包不在 <c>Mods\</c> 里，没有 <see cref="ModEntry"/>，
    /// 所以 <c>HasUpdate</c> 那条链（要求 <c>_thisEntry</c>）对它恒为 false。
    /// 这里换成「N 网最新 MAIN 文件」比「本机装这个覆盖包时记下的那条文件」：
    /// 安装时 <c>InstallService</c> 走 <c>RecordInstallByModId</c> 写了一条
    /// <c>ModNexusInstalls</c>（键是包名），FileId/文件版本都在里面。</para>
    /// <para>判不了就不报：没有安装记录、版本号为空、未登录、请求失败 —— 全部静默。
    /// 红点只用于"确实该处理"，宁可漏报也不许误报。</para></summary>
    private async Task CheckOverlayUpdatesAsync()
    {
        if (_disposed || !NexusService.IsAuthenticated) return;
        var groups = AllOverlayGroups();
        var changed = false;
        foreach (var g in groups)
        {
            if (_disposed) return;
            if (g.Rec.NexusModId is not int modId || modId <= 0) continue;
            if (_overlayUpdates.ContainsKey(g.Slot)) continue;
            // 本地那一版：这个 N 网页面上最近一次安装记录。取不到就没有比大小的基准。
            var local = Cfg.Current.ModNexusInstalls.Values
                .Where(r => r is not null && r.NexusModId == modId
                            && !string.IsNullOrWhiteSpace(r.RemoteVersion))
                .OrderByDescending(r => r.InstalledAtUtc)
                .FirstOrDefault();
            if (local is null) continue;
            try
            {
                var latest = await Nexus.GetLatestMainFileAsync(modId);
                if (latest is null || string.IsNullOrWhiteSpace(latest.Version)) continue;
                // fileId 相同 = 装的就是这一条，作者可能只是改了文件名/版本号写法
                if (latest.FileId != 0 && local.FileId != 0 && latest.FileId == local.FileId)
                {
                    _overlayUpdates[g.Slot] = (false, null, 0);
                    changed = true;
                    continue;
                }
                var has = VersionUtil.IsNewer(latest.Version, local.RemoteVersion);
                _overlayUpdates[g.Slot] = (has, has ? latest.Version : null, has ? latest.FileId : 0);
                changed = true;
            }
            catch (Exception ex)
            {
                // 未登录 / 网络 / API 限流：不写结论，下次进页或重扫会再试
                AppLog.Warn("Overlays", $"[覆盖包] 版本检查失败（{g.Slot}）：{ex.Message}");
            }
        }
        if (!changed) return;
        InvalidateOverlayCache();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>槽位 → 版本检查结论。FileId 只在新版那一格有意义（更新按钮按它直装）。</summary>
    private readonly Dictionary<string, (bool Has, string? Ver, long FileId)> _overlayUpdates
        = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>覆盖包的「更新」：直接装 N 网那条新 MAIN 文件。
    /// <para>覆盖包的更新本质就是"再装一次"——<c>ApplyOverlay</c> 用 <c>N{modId}</c> 作槽位，
    /// 新旧包落同一条记录，旧的副本目录会被 <c>DropReplacedStore</c> 清掉。
    /// 不提供这个按钮的话，用户只能去详情页 04 Files 里找出那条新文件 —— 而覆盖包在
    /// Mods\ 里没有行，详情页顶部那颗 CTA 又因为 <c>HasUpdate</c> 恒 false 而显示"已安装"且禁用。</para>
    /// <para>⚠ 上一版有、这一版没有的文件不会被这次的落盘清掉（<c>ApplyOverlay</c> 只遍历新包
    /// 的文件表）。遇到"作者删了几个语言副本"的情况会留残骸，那是另一处要补的清理。</para></summary>
    private async Task UpdateOverlayAsync(OverlayGroup g)
    {
        if (g.Rec.NexusModId is not int modId) return;
        if (g.UpdateFileId == 0)
        {
            // 没拿到 fileId（版本是比出来的、但文件表没给 id）→ 回详情页让用户挑
            GoOverlayDetail(g.Rec);
            return;
        }
        try
        {
            var err = await Installer.InstallModDirectAsync(modId, g.UpdateFileId, OverlayTitle(g.Rec));
            if (err is null)
            {
                _ = JS.InvokeVoidAsync("junigridJs.toast", Loc.T("已开始更新这个覆盖包，进度见任务中心"), "ok");
                // 装完再查一轮，把结论刷成"已是最新"
                _overlayUpdates.Remove(g.Slot);
                InvalidateOverlayCache();
                _ = GuardedFireAndForget(CheckOverlayUpdatesAsync(), "覆盖包版本复查");
            }
            else if (err.Contains("premium", StringComparison.OrdinalIgnoreCase))
                _ = JS.InvokeVoidAsync("junigridJs.toast",
                    Loc.T("应用内没能自动取到下载链接 —— 已为你打开系统浏览器，点 Mod Manager Download 即可自动安装"), "err");
            else
                _ = JS.InvokeVoidAsync("junigridJs.toast", Loc.T("更新失败：") + err, "err");
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", Loc.T("更新失败：") + ex.Message, "err");
        }
    }

    private List<OverlayGroup> OverlayGroups()
    {
        if (_overlayHost is null) return new List<OverlayGroup>();
        return AllOverlayGroups()
            .Where(g => ModService.NormalizeOverlayHost(g.Host)
                .Equals(_overlayHost, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void ToggleOverlayGroup(OverlayGroup g, bool on)
    {
        var err = ModSvc.SetOverlayGroupEnabled(Cfg.Current.GamePath, g.Host, g.Slot, on, Cfg);
        if (err is not null)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", err, "err");
            return;
        }
        // 打开一个包时，把盖着同一批文件的另一个包关掉 —— 两组写同一个文件，
        // 谁后盖谁赢，留着两个"已启用"只是骗人（汉化包的 zh.json 就是这种）。
        var alsoOff = on ? DisableConflictingOverlays(g) : new List<string>();
        InvalidateOverlayCache();
        _ = RescanInBackground();
        if (alsoOff.Count > 0)
            _ = JS.InvokeVoidAsync("junigridJs.toast",
                Loc.F("已启用「{0}」，同时停用了盖着同一批文件的「{1}」",
                    OverlayTitle(g.Rec), string.Join("」「", alsoOff)), "ok");
    }

    /// <summary>行尾那颗开关：正常包 = 开/关；失效包 = 按副本重新盖一次。
    /// <para>失效时开关一律画成"关"（它确实没盖上），点它就是重放 —— 以前这里不给开关，
    /// 用户得先选中这行、再去底部批量条点「启用」，两步且要猜。</para></summary>
    private void OnOverlaySwitch(OverlayGroup g)
    {
        if (g.Stale > 0) ReapplyOverlaysGroup(g);
        else ToggleOverlayGroup(g, !g.AnyOn);
    }

    /// <summary>单个包的「重新应用」：宿主换过版本后按 AppData 里留的副本再盖一遍。
    /// <para>两种结果必须分开报：盖不上的那几个正是「宿主里已经没有那个文件」
    /// （作者改名/删了），统一说"已重新应用"会让用户以为好了，游戏里其实还是原样。</para></summary>
    private void ReapplyOverlaysGroup(OverlayGroup g)
    {
        try
        {
            var (applied, blocked) = ModSvc.ReapplyOverlayGroup(Cfg.Current.GamePath, g.Host, g.Slot, Cfg);
            var msg = applied > 0
                ? (blocked > 0
                    ? Loc.F("已重新应用 {0} 个文件，还有 {1} 个盖不上（宿主里已经找不到它们）", applied, blocked)
                    : Loc.F("已重新应用 {0} 个文件", applied))
                : (blocked > 0
                    ? Loc.F("这 {0} 个文件在宿主里已经找不到，盖不上去 —— 作者可能改了名或删掉了", blocked)
                    : Loc.T("这些文件本来就在位，没有需要重新盖的"));
            _ = JS.InvokeVoidAsync("junigridJs.toast", msg, applied > 0 ? "ok" : "err");
            AppLog.Info("Overlays", $"[覆盖包] 重新应用「{OverlayTitle(g.Rec)}」：盖上 {applied}，盖不上 {blocked}");
        }
        catch (Exception ex)
        {
            // 以前这里没有兜底：服务层一抛异常，点击就"一点反应都没有"（界面不动、也没 toast）。
            _ = JS.InvokeVoidAsync("junigridJs.toast", Loc.T("重新应用失败：") + ex.Message, "err");
            AppLog.Warn("Overlays", $"[覆盖包] 重新应用「{OverlayTitle(g.Rec)}」异常：{ex}");
        }
        InvalidateOverlayCache();
        RescanAndRestate();
    }

    /// <summary>行内「…」菜单的键。用 <c>ov|</c> 前缀跟 mod 行的 folder 共用同一个
    /// <see cref="_menuFolder"/> —— 于是翻转定位（fitModMenu）、点空白处关闭（.jg-dd-overlay）
    /// 这些现成机制不用再实现一遍。</summary>
    private static string OverlayMenuId(OverlayGroup g) => "ov|" + OverlayKey(g);

    /// <summary>段头那颗复选框的三态：0 = 一个没选，1 = 选了一部分，2 = 整段全选。</summary>
    private int OverlaySectionSelectState(OverlaySection sec)
    {
        var n = sec.Items.Count(g => _overlaySelected.Contains(OverlayKey(g)));
        return n == 0 ? 0 : n >= sec.Items.Count ? 2 : 1;
    }

    private void ToggleOverlaySectionSelectAll(OverlaySection sec)
    {
        var all = sec.Items.All(g => _overlaySelected.Contains(OverlayKey(g)));
        foreach (var g in sec.Items)
        {
            var k = OverlayKey(g);
            if (all) _overlaySelected.Remove(k);
            else _overlaySelected.Add(k);
        }
        _pendingOverlayDelete = null;
        StateHasChanged();
    }

    /// <summary>关掉那些和目标包写同一批文件的其它包，返回被关掉的名字。
    /// 判据与批量启用那条完全一致（<see cref="OverlayTargetKeys"/>），两条路不会走出两种结果。</summary>
    private List<string> DisableConflictingOverlays(OverlayGroup keep)
    {
        var names = new List<string>();
        var mine = OverlayTargetKeys(keep);
        if (mine.Count == 0) return names;
        var keepKey = OverlayKey(keep);
        // 上面刚改过一条记录：先作废缓存再列，AnyOn 才是改完之后的值。
        InvalidateOverlayCache();
        foreach (var other in AllOverlayGroups())
        {
            if (OverlayKey(other) == keepKey || !other.AnyOn) continue;
            if (!OverlayTargetKeys(other).Overlaps(mine)) continue;
            if (ModSvc.SetOverlayGroupEnabled(Cfg.Current.GamePath, other.Host, other.Slot, false, Cfg) is null)
                names.Add(OverlayTitle(other.Rec));
        }
        return names;
    }

    private void RevertOverlayGroup(OverlayGroup g)
    {
        // 整组都失效时没有东西可还原，销账而已 —— 两种结果说不同的话，别统一报"已还原"
        var gone = g.Stale == g.Keys.Count;
        var err = ModSvc.RevertOverlayGroup(Cfg.Current.GamePath, g.Host, g.Slot, Cfg);
        _ = JS.InvokeVoidAsync("junigridJs.toast",
            err ?? (gone ? Loc.T("已清除该覆盖记录") : Loc.T("已还原被覆盖的文件")), err is null ? "ok" : "err");
        if (err is null)
        {
            _overlayUpdates.Remove(g.Slot);   // 包都没了，它的版本结论也不该留在红点里
            _overlaySelected.Remove(OverlayKey(g));
            InvalidateOverlayCache();
            RescanAndRestate();   // v1.3.15：后台扫，别冻界面
        }
    }

    // ── 覆盖包多选 / 批量（2026-11-09：照 Mod 行那套做） ────────────────────

    /// <summary>当前勾选的覆盖包，键 = 归一化宿主名 + '|' + 槽位。</summary>
    private readonly HashSet<string> _overlaySelected = new(StringComparer.OrdinalIgnoreCase);
    private List<OverlayGroup>? _pendingOverlayDelete;

    private static string OverlayKey(OverlayGroup g)
        => ModService.NormalizeOverlayHost(g.Host) + "|" + g.Slot;

    /// <summary>选中的包，顺序 = 列表顺序（"只启用排在最前的那个"就是按这个顺序取）。</summary>
    private List<OverlayGroup> SelectedOverlayGroups()
        => AllOverlayGroups().Where(g => _overlaySelected.Contains(OverlayKey(g))).ToList();

    private void ToggleOverlaySelect(OverlayGroup g)
    {
        var k = OverlayKey(g);
        if (!_overlaySelected.Remove(k)) _overlaySelected.Add(k);
        _pendingOverlayDelete = null;
        StateHasChanged();
    }

    private void ClearOverlaySelection()
    {
        _overlaySelected.Clear();
        StateHasChanged();
    }

    private void SelectAllOverlays()
    {
        var all = AllOverlayGroups();
        if (all.Count > 0 && _overlaySelected.Count >= all.Count) _overlaySelected.Clear();
        else foreach (var g in all) _overlaySelected.Add(OverlayKey(g));
        StateHasChanged();
    }

    /// <summary>这个包会改写宿主里的哪些文件 —— 互斥判据用它。
    /// <para>两组落在同一个文件上时，无论谁后盖都会把前一个顶掉（汉化包的 zh.json 就这德行），
    /// 所以这种包"只能启用一个"：批量启用时只留排在最前面的那个。</para></summary>
    private HashSet<string> OverlayTargetKeys(OverlayGroup g)
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var k in g.Keys)
        {
            if (!Cfg.Current.Overlays.TryGetValue(k, out var r)) continue;
            set.Add(ModService.NormalizeOverlayHost(r.Host) + "|" + r.RelPath);
        }
        return set;
    }

    private async Task BatchSetOverlayEnabled(bool disabled)
    {
        var groups = SelectedOverlayGroups();
        if (groups.Count == 0) return;

        var ok = 0;
        var reapplied = 0;
        var blocked = 0;
        var skipped = new List<OverlayGroup>();
        string? err = null;
        try
        {
            // 启用时才需要收敛：同一批文件只能有一个包在位。
            var targets = new List<OverlayGroup>();
            if (disabled)
            {
                targets.AddRange(groups);
            }
            else
            {
                var claimed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                foreach (var g in groups)
                {
                    var files = OverlayTargetKeys(g);
                    if (files.Any(claimed.Contains)) { skipped.Add(g); continue; }
                    claimed.UnionWith(files);
                    targets.Add(g);
                }
            }

            foreach (var g in targets)
            {
                // 失效的包：对它们来说「启用」就是按留的副本重新盖一次。
                if (!disabled && g.Stale > 0)
                {
                    var (a, b) = ModSvc.ReapplyOverlayGroup(Cfg.Current.GamePath, g.Host, g.Slot, Cfg);
                    reapplied += a;
                    blocked += b;
                    if (a > 0) ok++;      // 一个文件都没盖上就不算"启用成功"，只记进 blocked
                    continue;
                }
                err = ModSvc.SetOverlayGroupEnabled(Cfg.Current.GamePath, g.Host, g.Slot, !disabled, Cfg);
                if (err is not null) break;
                ok++;
            }
            // 被跳过、但本来开着的：它盖的是同一批文件，磁盘上现在已经是别人的版本了。
            // 一起关掉，"只启用一个"才算真的做到（否则界面会显示两个都开着）。
            if (!disabled)
            {
                foreach (var g in skipped.Where(x => x.AnyOn))
                    ModSvc.SetOverlayGroupEnabled(Cfg.Current.GamePath, g.Host, g.Slot, false, Cfg);
            }
            AppLog.Info("Overlays",
                $"[覆盖包] 批量{(disabled ? "停用" : "启用")}：包 {ok}，重放文件 {reapplied}，盖不上 {blocked}，跳过 {skipped.Count}");
        }
        catch (Exception ex)
        {
            // 这里以前没有兜底：服务层一抛异常，用户看到的就是"点了没反应"（没有 toast、界面不动）。
            err = Loc.T("操作失败：") + ex.Message;
            AppLog.Warn("Overlays", $"[覆盖包] 批量{(disabled ? "停用" : "启用")}异常：{ex}");
        }

        string? msg;
        if (err is not null) msg = err;
        else if (!disabled && ok == 0 && blocked > 0)
            msg = Loc.T("选中的覆盖包一个都没能盖回去 —— 宿主里已经没有它们要盖的那些文件了");
        else if (!disabled && ok == 0 && reapplied == 0 && blocked == 0)
            msg = Loc.T("选中的覆盖包本来就已经在位，没有需要重新盖的");
        else
        {
            var parts = new List<string>
            {
                disabled ? Loc.F("已停用 {0} 个覆盖包", ok) : Loc.F("已启用 {0} 个覆盖包", ok),
            };
            if (reapplied > 0) parts.Add(Loc.F("重新盖回 {0} 个文件", reapplied));
            if (blocked > 0) parts.Add(Loc.F("{0} 个文件在宿主里已经找不到", blocked));
            if (!disabled && skipped.Count > 0)
                parts.Add(Loc.F("{0} 个盖着同一批文件，只保留排在最前的那个", skipped.Count));
            msg = string.Join("；", parts);
        }
        _ = JS.InvokeVoidAsync("junigridJs.toast", msg, err is null ? "ok" : "err");
        InvalidateOverlayCache();
        RescanAndRestate();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>批量更新：逐个按「N 网最新 MAIN」装一遍。覆盖包的更新本质就是再装一次，
    /// 所以只能串行 —— 并行装同一个宿主上的两个包会互相盖。
    /// 没有 fileId 的（版本是比出来的、但没拿到文件表）不进批量，交给行上的「新版本」跳详情页。</summary>
    private async Task BatchOverlayUpdate()
    {
        var targets = SelectedOverlayGroups()
            .Where(g => g.HasUpdate && g.Rec.NexusModId is int && g.UpdateFileId != 0)
            .ToList();
        if (targets.Count == 0)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", LocService.Tr("选中的覆盖包没有可自动更新的来源"), "err");
            return;
        }
        var started = 0;
        foreach (var g in targets)
        {
            try
            {
                var err = await Installer.InstallModDirectAsync(
                    g.Rec.NexusModId!.Value, g.UpdateFileId, OverlayTitle(g.Rec));
                if (err is null)
                {
                    started++;
                    _overlayUpdates.Remove(g.Slot);   // 装完重查，别拿旧结论继续亮红点
                }
                else AppLog.Warn("Overlays", $"[覆盖包] 批量更新「{OverlayTitle(g.Rec)}」失败：{err}");
            }
            catch (Exception ex)
            {
                AppLog.Warn("Overlays", $"[覆盖包] 批量更新异常：{ex.Message}");
            }
        }
        _ = JS.InvokeVoidAsync("junigridJs.toast",
            started > 0 ? Loc.F("已开始更新 {0} 个覆盖包，进度见任务中心", started)
                        : Loc.T("更新没能开始，点行上的「新版本」去详情页手动挑文件"),
            started > 0 ? "ok" : "err");
        InvalidateOverlayCache();
        _ = GuardedFireAndForget(CheckOverlayUpdatesAsync(), "覆盖包版本复查");
        await InvokeAsync(StateHasChanged);
    }

    private void AskOverlayBatchDelete()
    {
        var sel = SelectedOverlayGroups();
        if (sel.Count == 0) return;
        _pendingOverlayDelete = sel;
        StateHasChanged();
    }

    private void CancelOverlayBatchDelete()
    {
        _pendingOverlayDelete = null;
        StateHasChanged();
    }

    private void ConfirmOverlayBatchDelete()
    {
        var list = _pendingOverlayDelete;
        _pendingOverlayDelete = null;
        if (list is null) return;

        var ok = 0;
        string? err = null;
        foreach (var g in list)
        {
            err = ModSvc.RevertOverlayGroup(Cfg.Current.GamePath, g.Host, g.Slot, Cfg);
            if (err is not null) break;
            ok++;
            _overlayUpdates.Remove(g.Slot);
            _overlaySelected.Remove(OverlayKey(g));
        }
        _ = JS.InvokeVoidAsync("junigridJs.toast",
            err ?? Loc.F("已删除 {0} 个覆盖包", ok), err is null ? "ok" : "err");
        InvalidateOverlayCache();
        RescanAndRestate();
        StateHasChanged();
    }

    // ── 覆盖包 → 宿主 mod 的显示信息 ────────────────────────────

    private Dictionary<string, ModEntry>? _hostsByNorm;

    /// <summary>宿主目录名（归一化后，去掉禁用点前缀）→ 那个 mod。
    /// 覆盖记录的 Host 是目录名，禁用态是 <c>.X</c>，所以必须走同一个归一化函数。</summary>
    private Dictionary<string, ModEntry> HostIndex()
    {
        if (_hostsByNorm is not null) return _hostsByNorm;
        var d = new Dictionary<string, ModEntry>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in _mods)
        {
            var k = ModService.NormalizeOverlayHost(m.Folder);
            if (k.Length > 0) d.TryAdd(k, m);
        }
        return _hostsByNorm = d;
    }

    /// <summary>行内那颗「宿主标签」的内容：封面 + 名字；宿主没装就说清楚。
    /// <para>只说 <c>Host</c> 那个目录名的话，用户看到 <c>[CP] Custom Menu Background</c>
    /// 得自己去列表里找是谁 —— 有封面和真名才认得出盖在哪个 mod 上。</para>
    /// <para><c>NexusModId</c>：宿主没装时从安装账本反查出来的 id，标签靠它变成可点
    /// （装着的宿主取本地条目自己的 id，不用查账本）。</para></summary>
    private (string Label, string? Cover, bool Installed, int? NexusModId) OverlayHostInfo(string host)
    {
        var norm = ModService.NormalizeOverlayHost(host);
        if (norm.Length == 0) return (LocService.Tr("没有指定宿主"), null, false, null);
        if (HostIndex().TryGetValue(norm, out var m))
            return (RemarkName(m), GetCover(m), true, m.NexusModId);
        // 没装：标签上写的是宿主目录名，不是「未安装宿主 mod」—— 段头已经说了没装，
        // 这里再写一遍等于什么都没说；用户要认的正是「它原来盖在谁身上」。
        return (OverlayRowHostLabel(host), null, false, HostNexusIdOf(norm));
    }

    /// <summary>宿主没装的时候，从安装账本里把它当初的 N 网 id 找回来。
    /// <para>覆盖包盖过的宿主绝大多数是我们自己装上去的，账本里留着「文件夹名 → id」，
    /// 目录被删/改名之后这条记录还在 —— 所以名字点一下仍然能到它的页面。</para>
    /// <para>匹配按可信度：全名 → 路径末段（账本里捆绑包子包的键是 <c>Top/Sub</c>）。
    /// 末段撞出两个不同 id 时一律当没查到：给错页面比不给入口更糟。</para></summary>
    private int? HostNexusIdOf(string norm)
    {
        if (norm.Length == 0) return null;
        var table = Cfg.Current.ModNexusInstalls;
        if (table.TryGetValue(norm, out var exact) && exact is { NexusModId: > 0 })
            return exact.NexusModId;

        var leaf = norm.Split('/')[^1];
        int? hit = null;
        foreach (var kv in table)
        {
            if (kv.Value is not { NexusModId: > 0 }) continue;
            var key = kv.Key.Replace('\\', '/').TrimEnd('/');
            if (!string.Equals(key, norm, StringComparison.OrdinalIgnoreCase)
                && !string.Equals(key.Split('/')[^1], leaf, StringComparison.OrdinalIgnoreCase)) continue;
            if (hit is not null && hit != kv.Value.NexusModId) return null;
            hit = kv.Value.NexusModId;
        }
        return hit;
    }

    /// <summary>行内「宿主标签」整块。能跳到就画成按钮，跳不了就保持纯标签 ——
    /// 一个点了没反应的东西，比一眼看出不可点更让人恼火。
    /// <para>按钮套 <c>.jg-tag</c>：标签那套底色/圆角/内边距都在，这里只补按钮的样式重置
    /// （见 mods.css 的 <c>.jg-hosttag-nav</c>）。</para></summary>
    private RenderFragment OverlayHostTag(ModEntry? hostMod,
        (string Label, string? Cover, bool Installed, int? NexusModId) host, int? jumpId) => @<text>
        @if (jumpId is not null)
        {
            <button type="button" class="jg-tag jg-hosttag jg-hosttag-nav"
                    data-missing="@(host.Installed ? null : "")"
                    data-tip="@(host.Installed
                        ? Loc.F("盖在「{0}」上 · 点一下打开这个 mod 的详情页", host.Label)
                        : Loc.F("宿主「{0}」没装了 · 点一下打开它的 N 网页面", host.Label))"
                    @onclick="() => OpenOverlayHost(hostMod, jumpId)"
                    @onclick:stopPropagation="true">
                @if (host.Cover is not null)
                {
                    <img src="@host.Cover" alt="" loading="lazy" />
                }
                <span class="jg-hosttag-name">@host.Label</span>
            </button>
        }
        else
        {
            <span class="jg-tag jg-hosttag" data-missing="@(host.Installed ? null : "")"
                  data-tip="@Loc.T("宿主 mod 没装或已不在 Mods 里，这个覆盖包现在不会生效")">
                @if (host.Cover is not null)
                {
                    <img src="@host.Cover" alt="" loading="lazy" />
                }
                <span class="jg-hosttag-name">@host.Label</span>
            </span>
        }
    </text>;

    /// <summary>点宿主名字 = 去宿主那里。装着的进本应用详情页（能直接更新/看文件），
    /// 没装的只能去 N 网页面 —— 本地没有它的行，这里就是唯一入口。</summary>
    private void OpenOverlayHost(ModEntry? hostMod, int? nexusModId)
    {
        if (hostMod is { NexusModId: not null })
        {
            _ = OpenDetail(hostMod);
            return;
        }
        if (nexusModId is not int id) return;
        CloseOverlayList();
        Nav.NavigateTo($"mod/{id}");
    }

    // summary 是 markdown（"broken, use [unofficial version](https://…)"）。徽标悬停已经不抄整段了，
    // 这个正则只用来从里面抠出替代版本的链接，给点徽标跳转用。
    private static readonly System.Text.RegularExpressions.Regex MdLink =
        new(@"\[([^\]]*)\]\(([^)]+)\)", System.Text.RegularExpressions.RegexOptions.Compiled);

    private string? BrokenRaw(ModEntry m) =>
        _smapiPrecheckSummary is not null && _smapiPrecheckSummary.TryGetValue(m.Folder, out var s) ? s : null;

    /// <summary>徽标悬停只解释「这个标签是什么意思」+「点下去会到哪」。上游 summary 是整段英文、
    /// 还带展开后的长 N 网链接，直接贴上去会跑出屏幕被裁掉；跳转改由点徽标完成。</summary>
    private string BrokenTip(ModEntry m)
    {
        var st = _smapiPrecheckStatus is not null && _smapiPrecheckStatus.TryGetValue(m.Folder, out var s) ? s : "";
        var what = st switch
        {
            "unofficial" => Loc.T("官方版没跟上当前游戏版本，社区出了非官方跟进版"),
            "workaround" => Loc.T("原版有已知问题，社区给了替代版本"),
            "broken"     => Loc.T("社区兼容性库判定它在当前游戏版本上跑不起来"),
            "obsolete"   => Loc.T("游戏本体已经实现了，这个 mod 不再需要"),
            "abandoned"  => Loc.T("作者已弃养，将来大概率跟不上新版本"),
            _            => Loc.T("社区兼容性库判定这个 mod 在当前游戏版本上有问题"),
        };
        var (_, altName, kind) = PickBrokenFix(
            BrokenRaw(m), PrecheckUrlOf(m), AltOf(m), m.NexusModId, m.Name, m.Folder, AltIsSelfNow(m));
        if (BrokenRaw(m) is not { Length: > 0 }) return what;
        return kind switch
        {
            // 只有真的落到另一个 mod 上，才敢说"替代版本"四个字。
            // 上游直接给了链接时不重复贴链接本身（实测 5 条里 4 条是 60+ 字符的论坛长链，
            // 贴进悬停会跑出屏幕被裁掉），点名到具体哪个 mod 只在"我们按名字搜出来的"那种场合。
            0 => altName is { } an ? Loc.F("{0} · 替代版：{1} · 点徽标打开", what, an)
                                   : Loc.F("{0} · 点徽标打开替代版本", what),
            2 => Loc.F("{0} · 社区没留链接 · 点徽标去 N 网搜替代品", what),
            _ => Loc.F("{0} · 点徽标打开它的页面", what),
        };
    }

    /// <summary>只认真正的 http(s) 地址。上游那张表里有 <c>[Friends Forever (1.6)](#)</c>
    /// 这种占位锚点，丢给 ShellExecute 只会静默失败 —— 症状就是"徽标点了没反应"。</summary>
    private static bool IsWebUrl(string? s) =>
        !string.IsNullOrWhiteSpace(s)
        && (s.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || s.StartsWith("https://", StringComparison.OrdinalIgnoreCase));

    /// <summary>从 summary 的 markdown 链接里取「替代版的名字」：链接位是 <c>(#)</c> 占位时，
    /// 方括号里那段文字就是社区点名的替代品（实测 "⚠ use [Friends Forever (1.6)](#) instead."）。
    /// 有真链接时返回 null —— 那种直接开链接就行，不必再按名字搜。</summary>
    internal static string? BrokenAltName(string? rawSummary)
    {
        if (rawSummary is null) return null;
        var link = MdLink.Match(rawSummary);
        if (!link.Success) return null;
        if (IsWebUrl(link.Groups[2].Value)) return null;
        var text = link.Groups[1].Value.Trim();
        return text.Length > 1 ? text : null;
    }

    /// <summary>徽标落点。<paramref name="alt"/> 是按 <see cref="BrokenAltName"/> 的名字搜出来的
    /// 那个独立 mod（N 网 20702「Friends Forever (1.6)」，本体是 1738）。
    /// <paramref name="homeId"/> 是 smapi.io 报的 <c>main.url</c> 里那个号 ——「你装的这一版住在哪儿」。
    /// 返回 kind：0=落在替代版上、1=落在它自己/来源页、2=只能给搜索结果页。
    /// 提示文案与点击落点都出自这里，两者不会再各说各话。</summary>
    internal static (string Url, string? AltName, int Kind) PickBrokenFix(
        string? rawSummary, string? precheckUrl, (int ModId, string Name)? alt,
        int? nexusModId, string name, string folder, bool altIsSelf = false)
    {
        var usableAlt = altIsSelf ? null : alt;
        var link = rawSummary is null ? null : MdLink.Match(rawSummary);
        var url = link is { Success: true } ? link.Groups[2].Value : null;
        if (IsWebUrl(url) && !altIsSelf) return (url!, usableAlt?.Name, 0);
        // 上游没给链接，但我们按名字找到了另一个 mod ⇒ 这才是真的"打开替代版本"
        if (usableAlt is { } a)
            return ($"https://www.nexusmods.com/stardewvalley/mods/{a.ModId}", a.Name, 0);
        if (IsWebUrl(precheckUrl)) return (precheckUrl!, null, 1);
        if (nexusModId is int nid && nid > 0)
            return ($"https://www.nexusmods.com/stardewvalley/mods/{nid}", null, 1);
        if (IsWebUrl(url)) return (url!, null, 1);   // 链接就是自己这一页，仍然有地方可去
        // 兜底：搜索页是唯一一定落得地的地方
        return ("https://www.nexusmods.com/stardewvalley/search?q="
            + Uri.EscapeDataString(string.IsNullOrWhiteSpace(name) ? folder : name), null, 2);
    }

    private string? AltVerOf(ModEntry m) =>
        _smapiPrecheckAltVer is not null && _smapiPrecheckAltVer.TryGetValue(m.Folder, out var v) ? v : null;

    private string? MainVerOf(ModEntry m) =>
        _smapiPrecheckMainVer is not null && _smapiPrecheckMainVer.TryGetValue(m.Folder, out var v) ? v : null;

    /// <summary>警告徽标、中性标签、点击落点、提示文案四处必须用同一个判据 ——
    /// 否则会出现"行上说已兑现、点开的却是让你去下载的那一页"这种自相矛盾。
    /// （「维护存疑」的计数与筛选<b>不</b>走这里：被点名过的行一律列出，见 <see cref="IsBroken"/>。）</summary>
    private bool AltIsSelfNow(ModEntry m) =>
        AltIsSelf(BrokenRaw(m), AltOf(m), AltVerOf(m), m.Version, m.NexusModId, MainVerOf(m));

    private string? PrecheckUrlOf(ModEntry m) =>
        _smapiPrecheckUrl is not null && _smapiPrecheckUrl.TryGetValue(m.Folder, out var u) ? u : null;

    private (int ModId, string Name)? AltOf(ModEntry m) =>
        _smapiPrecheckAlt is not null && _smapiPrecheckAlt.TryGetValue(m.Folder, out var a) ? a : null;

    private void OpenBrokenFix(ModEntry m) => UpdateService.OpenUrl(PickBrokenFix(
        BrokenRaw(m), PrecheckUrlOf(m), AltOf(m), m.NexusModId, m.Name, m.Folder, AltIsSelfNow(m)).Url);

    /// <summary>被点名的 mod 里，上游只给了替代版名字没给链接的，按名字去 N 网把它找出来。
    /// 一个会话只查一次（静态缓存），且只查这几个 —— 实测 146 个里 6 个有徽标。
    /// 查不到就留空，落点自动降级成"它的页面/搜索页"，文案跟着降级。</summary>
    private static readonly Dictionary<string, (int ModId, string Name)?> SmapiAltCache = new();
    private Dictionary<string, (int ModId, string Name)?>? _smapiPrecheckAlt;

    private async Task ResolveAltsAndRefreshAsync(List<ModEntry> targets)
    {
        try { await ResolveBrokenAlternativesAsync(targets); }
        catch (Exception ex) { AppLog.Warn("Mods", "[替代版] 名字解析失败: " + ex.Message); }
        if (!_disposed) StateHasChanged();
    }

    private async Task ResolveBrokenAlternativesAsync(List<ModEntry> targets)
    {
        try
        {
            var found = new Dictionary<string, (int ModId, string Name)?>();
            // 快照必须在锁里取：首屏预查与「刷新」可能同时在跑，锁外复制会撞上
            // "Collection was modified"（静态缓存写方就在下面的 lock 里）。
            Dictionary<string, (int ModId, string Name)?> locked;
            lock (SmapiAltCache) locked = new Dictionary<string, (int ModId, string Name)?>(SmapiAltCache);
            foreach (var m in targets)
            {
                if (_disposed) return;
                var altName = BrokenAltName(
                    _smapiPrecheckSummary is not null && _smapiPrecheckSummary.TryGetValue(m.Folder, out var s) ? s : null);
                if (altName is null) continue;
                var key = string.IsNullOrEmpty(m.UniqueID) ? m.Folder : m.UniqueID;
                (int ModId, string Name)? hit;
                if (locked.TryGetValue(key, out var cached)) hit = cached;
                else
                {
                    // 故意**不**排除"我们自己那一页"：搜回来的号与它当前的版本号，
                    // 正是 AltIsSelf 判断"替代版=你手上这一版"的证据。
                    hit = await Nexus.FindModByNameAsync(altName);
                    lock (SmapiAltCache) SmapiAltCache[key] = hit;
                }
                if (hit is not null) found[m.Folder] = hit.Value;
            }
            // 「上游叫你去的那一页」当前的版本号 —— 判据②的数据源。两种来源都要覆盖：
            // 按名字搜出来的（Friends Forever），以及 summary 里直接给链接的（Adventurer's Guild 22591）。
            var vers = new Dictionary<string, string>();
            var pages = new Dictionary<string, int>();
            foreach (var m in targets)
            {
                var raw = _smapiPrecheckSummary is not null && _smapiPrecheckSummary.TryGetValue(m.Folder, out var sm0) ? sm0 : null;
                var page = found.TryGetValue(m.Folder, out var f) && f is { } fa ? fa.ModId : SummaryLinkId(raw);
                if (page > 0) pages[m.Folder] = page;
            }
            if (pages.Count > 0)
            {
                // 页号→版本查过一次就记住：否则每次点「刷新」都要重问一遍网络，
                // 而那几秒里证据是缺的 —— 徽标就会闪一下又消失。
                var need = pages.Values.Distinct().Where(p => !PageVerKnown(p)).ToArray();
                if (need.Length > 0)
                {
                    var fps = await Nexus.GetModFingerprintsBatchAsync(need);
                    if (fps is not null)
                        foreach (var (pid, fp) in fps)
                            if (!string.IsNullOrWhiteSpace(fp.Version))
                                lock (SmapiPageVerCache) SmapiPageVerCache[pid] = fp.Version;
                }
                foreach (var (folder, page) in pages)
                    if (TryGetPageVer(page, out var pv)) vers[folder] = pv;
            }
            // 两本字典必须**一起**上屏：先给"是哪一页"再给"那一页什么版本"，中间那一帧
            // AltIsSelf 会两条证据都抓不住（②要版本号、③页号对不上自己），于是警告徽标会闪出来
            // 再变回中性标签 —— 实测 150ms 采样抓到过这一次闪烁（t=3603 警告=1，300ms 后归 0）。
            _smapiPrecheckAlt = found;
            _smapiPrecheckAltVer = vers;
        }
        finally { _altEvidencePending = false; }
    }

    /// <summary>N 网页号 → 该页当前的版本号（跨本会话留着）。判据②「替代版页面当前版本==你装的」
    /// 靠它，查一次就够，不必每次刷新都重问。</summary>
    private static readonly Dictionary<int, string> SmapiPageVerCache = new();

    private static bool PageVerKnown(int page)
    {
        lock (SmapiPageVerCache) return SmapiPageVerCache.ContainsKey(page);
    }

    private static bool TryGetPageVer(int page, out string ver)
    {
        lock (SmapiPageVerCache) return SmapiPageVerCache.TryGetValue(page, out ver!);
    }

    // v1.08：检查失败（超时等）的 mod 数量 —— 驱动筛选栏提示与"可更新"红点
    private int FailedCheckCount => _states.Values.Count(s => s.Status == "failed");

    private void SetFilter(string key)
    {
        _filter = key;
        // 覆盖包的勾选只在覆盖包视图里有效：切走就清掉，免得底部批量条跟着跑到别的视图里。
        if (key != "overlay") _overlaySelected.Clear();
        // v1.1.4：切换过滤后由 OnAfterRender 的 animatedListInit 重绑新行观察器。
        // 视口内的行当场展开不闪动，视口外的行滚动进入时播特效 —— 与首屏一致。
        // 覆盖包的版本检查是网络操作：进页那次可能未登录/没过网，点进来时补一轮。
        // 已有结论的槽位会被跳过，所以反复点这个 chip 不会反复打 API。
        if (key == "overlay") _ = GuardedFireAndForget(CheckOverlayUpdatesAsync(), "覆盖包版本检查");
    }

    // v0.36.0：mod 列表 AnimatedList 滚动效果（进入视口 scale/opacity + 顶底渐变）
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // v1.3.51：把长按拖拽的回调交给 JS（只需一次；JS 那边自己挂 pointer 监听）。
        // 放在最前 —— 下面渐进渲染那段每帧都会提前 return，排在它后面要等全部行画完才轮到。
        // ⚠ 以前这里 catch 空吞：WebView2 若缓存了旧版 JS（index.html 的 ?v= 没顶掉），
        // 这个函数根本不存在，interop 直接抛「Could not find …」，表现就是「拖动没反应」而日志干干净净。
        if (!_dragInit)
        {
            _dragInit = true;
            try
            {
                _dragRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("junigridJs.longPressDragInit", _dragRef);
                AppLog.Info("Mods", "[拖动] 长按手势已挂载");
            }
            catch (Exception ex)
            {
                AppLog.Error("Mods", "[拖动] 长按手势挂载失败（多半是 WebView2 缓存了旧 JS）: " + ex);
            }
            // 自检：合成一次按下/抬起，把手势有没有起来写进日志（不改任何数据）
            _ = RunDragSelfTestAsync();
        }

        // 2026-11-10：图标选择器的懒加载 —— 对话框一出现就把滚动监听挂上。
        // 只能在这里挂：DOM 没渲染出来时 document.querySelector 拿不到网格，
        // 而 @if 里的对话框不是每次渲染都重建（挂在 OnAfterRender 才稳）。
        if (_iconPickOpen && !_iconScrollBound)
        {
            _iconScrollBound = true;
            try
            {
                _iconScrollRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("junigridJs.iconGridInfinite", _iconScrollRef);
            }
            catch (Exception ex)
            {
                _iconScrollBound = false;
                AppLog.Warn("Mods", "[图标] 懒加载监听挂载失败: " + ex.Message);
            }
        }

        // v1.3.29 渐进渲染：这一帧只画了前 _renderLimit 行 → 放一帧让浏览器先画出来，
        // 再把额度翻倍补下一批。放在方法最前：它必须每帧都被判到，不能排在下面那些
        // JS 调用（placeViewThumb / 滚动恢复）后面被顺延。
        // 判据只用「额度 < 总行数」：拿 _renderShown 比额度会卡住 —— 组头计数与实际 DOM
        // 行数存在 1 行的边界差，实测补到第二批（119 对额度 120）就再也不动了。
        if (!_renderMorePending && !_initialLoading && !_showTrash
            && _renderLimit > 0 && _renderLimit < _renderTotalRows)
        {
            _renderMorePending = true;
            _renderLimit = Math.Min(_renderTotalRows, Math.Max(_renderLimit * 2, _renderLimit + 80));
            _renderShown = 0;   // 让下一帧重新统计
            try { await Task.Delay(16); } catch { }
            _renderMorePending = false;
            if (_disposed) return;
            StateHasChanged();
            // 本帧的活已经排给下一次渲染了；下面的视图滑块/滚动恢复等下一帧再跑，
            // 免得同一件事在一次补画里连做两遍。
            return;
        }

        // 视图开关：首帧落位；切换时让滑块像顶导航一样滑过去。
        // 只给列表播入场（不碰整页，避免切换时整页闪）；回收站列表异步回填，等它出现再播。
        try
        {
            if (firstRender)
                await JS.InvokeVoidAsync("junigridJs.placeViewThumb");
            if (_viewSwitched)
            {
                _viewSwitched = false;
                await JS.InvokeVoidAsync("junigridJs.placeViewThumb");
                if (!_showTrash || _trashLoaded)
                {
                    _trashEnterPending = false;
                    await JS.InvokeVoidAsync("junigridJs.playViewEnter");
                }
                else
                {
                    _trashEnterPending = true;
                }
            }
            else if (_trashEnterPending && _showTrash && _trashLoaded)
            {
                _trashEnterPending = false;
                await JS.InvokeVoidAsync("junigridJs.playViewEnter");
            }
        }
        catch { }

        // 刚渲染出 .open 的「⋮」菜单：这时 DOM 里已有它的最终矩形，才能判断该不该翻到按钮上方
        if (_menuFitPending)
        {
            _menuFitPending = false;
            try { await JS.InvokeVoidAsync("junigridJs.fitModMenu"); } catch { }
        }
        // 备注弹窗的输入框：autofocus 属性对它不生效（实测打开后焦点不在框里），必须等 DOM 就位后
        // 显式聚焦 —— 与上面 fitModMenu 同一个时机。
        if (_remarkFocusPending)
        {
            _remarkFocusPending = false;
            try { await JS.InvokeVoidAsync("junigridJs.focusElement", ".jg-remark-input"); } catch { }
        }
        // v1.3.48：点 ＋ 时输入框还不存在，这一帧它刚被渲染出来 ⇒ 此刻才把焦点送进去
        if (_categoryInputFocusPending)
        {
            _categoryInputFocusPending = false;
            try { await JS.InvokeVoidAsync("junigridJs.focusElement", ".jg-cat-dialog .jg-remark-input"); } catch { }
        }
        // v1.3.46：分类导航点完先全量渲染，这一帧再把滚动落到段头
        if (_pendingCategoryAnchor is not null)
        {
            var anchor = _pendingCategoryAnchor;
            _pendingCategoryAnchor = null;
            try { await JS.InvokeVoidAsync("junigridJs.scrollToCategory", anchor); } catch { }
        }
        // v0.71.1：从详情页返回时恢复滚动位置 —— setScrollWhenReady 轮询等容器高度足够再设
        // v0.72.0：带上离开时的「是否在底部」标记，恢复器不再用 y>limit 猜底部
        var dedicatedRan = false;
        if (!_initialLoading && _restoreScroll >= 0)
        {
            dedicatedRan = true;   // v1.06.8：本次走的是专用快照恢复，firstRender 兜底必须让位
            _entryRestoreRan = true;
            var y = _restoreScroll;
            var atBottom = _restoreAtBottom;
            _restoreScroll = -1;
            _restoreAtBottom = false;
            _scrollRestoreClassPending = false;
            // v1.2.5：正常流程诊断日志移除（AppLog 只有 WRN/ERR 两级，正常流程不应落 WRN）
            try
            {
                var reporter = DotNetObjectReference.Create(new ScrollRestoreReporter());
                await JS.InvokeVoidAsync("junigridJs.setScrollWhenReady", ".jg-main", y, atBottom, reporter);
            }
            catch (Exception ex)
            {
                AppLog.Error("Mods", "[诊断] 恢复滚动调用失败: " + ex.Message);
                try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
            }
        }
        else if (!_initialLoading && _scrollRestoreClassPending)
        {
            // v0.72.4：带着「待恢复」标记回到列表但没有可恢复快照
            // （如从详情页直接点了顶部导航再回来）→ 摘掉隐藏标记，行列表正常显示
            _scrollRestoreClassPending = false;
            _entryRestoreRan = true;
            try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
        }
        // v1.1.4：每次列表渲染后都重新绑定入场动画观察器。此前筛选/搜索切换走
        // _skipListAnimOnce 分支只解绑不重绑，新结果的行全部失去滚动特效，且回到
        // 「全部」后也不恢复。animatedListInit 对已绑定行是零开销跳过（__alBound），
        // 只对新增/未绑定的行做初始测量，逐帧渲染调用没有可感知开销。
        if (!_initialLoading)
        {
            try { await JS.InvokeVoidAsync("junigridJs.animatedListInit", ".jg-main", ".jg-modrows"); } catch { }
        }
        if (firstRender)
        {
            // v0.45.0：记忆 /mods 滚动位置 —— 进详情页再返回时恢复到原来滚动的高度，
            // 而不是回到页面顶部
            try { await JS.InvokeVoidAsync("junigridJs.scrollSpy", ".jg-main", "modslist", false); } catch { }
        }

        // vNext：进入页面统一恢复离开时的位置 —— 不再只限 popstate 返回。
        // 从其它页点导航图标回来（前进导航）同样恢复：scrollSpy 一直在往 modslist 键
        // 写「离开时的位置」，这里直接读它落位。冷启动 sessionStorage 为空（y≈0）
        // 自然不恢复；手动刷新不重建组件不走这里。专用快照（详情页返回）优先级更高。
        // vNext：等列表真实显示（_initialLoading=false）后才跑 —— 骨架屏期标记
        // 「待恢复」会把骨架本身也藏掉（.jg-modrows-skeleton 同名 class）。
        if (!_initialLoading && !_entryRestoreRan)
        {
            _entryRestoreRan = true;
            if (!dedicatedRan && _restoreScroll < 0)
            {
                try
                {
                    var y = await JS.InvokeAsync<double>("junigridJs.readScrollKey", "modslist");
                    if (y > 1)
                    {
                        // v1.2.5：正常流程诊断日志移除
                        // 先挂「待恢复」隐藏标记（.jg-main 跨导航持久），落位后由
                        // setScrollWhenReady 同帧揭开，避免「列表先在顶部闪一帧」
                        await JS.InvokeVoidAsync("junigridJs.markScrollRestorePending", ".jg-main");
                        var reporter = DotNetObjectReference.Create(new ScrollRestoreReporter());
                        await JS.InvokeVoidAsync("junigridJs.setScrollWhenReady", ".jg-main", y, false, reporter);
                    }
                }
                catch (Exception ex)
                {
                    AppLog.Error("Mods", "[诊断] 通用进入恢复失败: " + ex.Message);
                    try { await JS.InvokeVoidAsync("junigridJs.cancelScrollRestore", ".jg-main"); } catch { }
                }
            }
        }
    }

    /// <summary>vNext：通用进入恢复只跑一次的闸门（骨架屏期不跑，列表显示后的第一次渲染跑）。</summary>
    private bool _entryRestoreRan;

    /// <summary>v1.1.5：点击分组行 = 全选/取消全选该捆绑包的全部子包（已全选则清空）。</summary>
    private void ToggleGroupSelection(IEnumerable<ModEntry> items)
    {
        var allSelected = items.All(m => _selected.Contains(m.Folder));
        if (allSelected)
            foreach (var m in items) _selected.Remove(m.Folder);
        else
            foreach (var m in items) _selected.Add(m.Folder);
    }

    /// <summary>捆绑包折叠状态（按 <see cref="NormGroupKey"/> 记，值 = 展不展开）。
    /// 跨页面进出留住，跟筛选/排序快照同待遇。</summary>
    private static readonly Dictionary<string, bool> _groupOpen = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>分组身份：剥掉点前缀的顶层目录名。子包那层改名只动末段，但<b>启用</b>一个子包会把带点的
    /// 祖先一并解开（<c>.SVE/Sub → SVE/Sub</c>，见 ModService.SetDisabled v1.1.7），顶层名当场就变。
    /// 拿原始顶层名记"我展开过"，拨一下开关这条记录就对不上号 —— 症状是整包自己折回去。</summary>
    public static string NormGroupKey(string key) => key.TrimStart('.');

    // 面板/箭头的 DOM id：文件夹名里有空格、括号、中文，不能直接当选择器用；
    // 取进程内稳定的哈希（与 Tasks 页 "jgDrop-"+Guid 同一套约定，taskDrop 要的是选择器）。
    private static string SubPanelId(string key) => "jgSub-" + SubKeyHash(key);
    private static string SubArrowId(string key) => "jgArr-" + SubKeyHash(key);
    private static string SubKeyHash(string key)
        => ((uint)NormGroupKey(key).GetHashCode(StringComparison.Ordinal)).ToString("x8");

    /// <summary>这一包展不展开。人手动点过的以他为准；没点过时，筛过/搜过的结果一律展开 ——
    /// 那时列表已经是"你要找的那几条"，把命中的子包折进一行底下等于把人正在找的东西藏起来。</summary>
    private bool GroupOpen(string key)
    {
        var k = NormGroupKey(key);
        if (_groupOpen.TryGetValue(k, out var v)) return v;
        return _filter != "all" || !string.IsNullOrWhiteSpace(SearchText);
    }

    /// <summary>展开/收起动画借下载详情那支（<c>junigridJs.taskDrop</c>：GSAP 弹簧高度 +
    /// 箭头 back.out 旋转）；动画收尾清内联样式，稳态交给 CSS 的 .open，重渲染不会把面板打回隐藏。
    /// ⚠ 状态必须等 JS 调用回来之后再落：先落状态的话 Blazor 摘 .open 的那一帧比 GSAP 挂上内联
    /// 高度早（实测 19ms vs 29ms），CSS 的 height:0 会先把面板拍平，动画就成了 0→0 的空播（实测收起
    /// 是瞬间跳的）。等 JS 回来时内联高度已经在了，class 再怎么翻都被内联样式压住。</summary>
    private async Task ToggleGroupOpen(string key)
    {
        var want = !GroupOpen(key);
        try
        {
            await JS.InvokeVoidAsync("junigridJs.taskDrop", "#" + SubPanelId(key), "#" + SubArrowId(key), want);
        }
        catch { }
        _groupOpen[NormGroupKey(key)] = want;
    }

    /// <summary>缺失的依赖（声明在 Dependencies 里、但不在已装 UniqueID 集合中的项）。
    /// v1.1.4：ContentPackFor 宿主框架也算 —— SMAPI 会直接 Skipped 宿主缺失的内容包
    /// （如 [BL] Downtown Zuzu 缺 hootless.BusLocations），不提示用户根本不知道为啥跑不起来。
    /// v1.2.5：单次渲染会被 5 条路径反复调用（每行渲染 / CountFor("missing") /
    /// TotalMissingUids / MissingAffectedMods / 缺依赖筛选），每次 Concat+ToList+HashSet
    /// 全表嵌套。依赖与已装 UID 集合都只在 Rescan→ReindexMods 里重建，故按 folder 缓存、
    /// 在 ReindexMods 统一失效即可与旧行为完全一致（安装/卸载/启禁/重扫全部经过该入口）。</summary>
    private readonly Dictionary<string, List<string>> _missingDepsCache
        = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>已装、但当前被禁用的依赖 —— MissingDeps 的另一半。缺依赖是"没装"，
    /// 这条是"装着但关了"，两种在 SMAPI 那边的结果一样（依赖方被 Skipped），
    /// 但在启动器这边的出路完全不同：一个要去装，一个只要拨开关。</summary>
    private List<string> DisabledDeps(ModEntry m)
    {
        if (_disabledUids.Count == 0) return new List<string>();
        var deps = m.Dependencies.Concat(m.ContentPackIds).ToList();
        if (deps.Count == 0) return new List<string>();
        var uids = InstalledUids;
        return deps.Where(d => !string.IsNullOrWhiteSpace(d)
                && uids.Contains(d) && _disabledUids.Contains(d))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>点「依赖被禁」标签 → 把那些被禁用的依赖启用。走正常启用路径
    /// （联动、缓存迁移、重扫、写回存档都在里面），不自己复制那套收尾。</summary>
    private void EnableItsDependencies(ModEntry m)
    {
        var deps = DisabledDeps(m);
        var done = 0;
        foreach (var uid in deps)
        {
            var depMod = _mods.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.UniqueID)
                && x.UniqueID.Equals(uid, StringComparison.OrdinalIgnoreCase));
            if (depMod is null) continue;   // 不单独成行的捆绑包子包没有条目可点
            SetDisabled(depMod, false);
            done++;
        }
        if (done == 0)
            ShowNotice("ok", Loc.F("{0} 依赖的 {1} 是捆绑包里不单独成行的子包 —— 启用它的整包就行",
                m.Name, string.Join("、", deps)));
    }

    private List<string> MissingDeps(ModEntry m)
    {        if (_missingDepsCache.TryGetValue(m.Folder, out var cached)) return cached;
        var deps = m.Dependencies.Concat(m.ContentPackIds).ToList();
        List<string> missing;
        if (deps.Count == 0)
        {
            missing = new List<string>();
        }
        else
        {
            var uids = InstalledUids;
            missing = deps
                .Where(d => !string.IsNullOrWhiteSpace(d) && !uids.Contains(d))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        _missingDepsCache[m.Folder] = missing;
        return missing;
    }

    /// <summary>装了、但版本低于 manifest 要求的依赖 —— MissingDeps 之外的第三条出路。
    /// SMAPI 对「没装」和「装得不够新」的处置完全一样（依赖方整条 Skipped），
    /// 启动器这边的说法不一样：一个要去装，一个要换成更新的版本，所以分开列、一起装。
    /// <b>可选依赖也在这条判据里</b>：作者标 IsRequired=false 只是说"缺了也能用"，
    /// 装着却太旧时 SMAPI 照样整条跳过（实机 2026-10-29：Iconic Framework 与 Self Checkout
    /// 的 GMCM 都标了 false，仍因 1.12.0 &lt; 1.14.1 被跳过）。没装的可选依赖不在
    /// _installedVersions 里，自然不会产生这一行。</summary>
    private List<StaleDepRow> StaleDeps(ModEntry m)
    {
        if (_staleDepsCache.TryGetValue(m.Folder, out var cached)) return cached;
        var list = new List<StaleDepRow>();
        foreach (var dep in DependencyRules.StaleDepUids(m, _installedVersions))
        {
            var have = _installedVersions[dep];
            var need = m.DependencyMinVersions[dep];
            var e = _mods.FirstOrDefault(x => string.Equals(x.UniqueID.Trim(), dep, StringComparison.OrdinalIgnoreCase));
            list.Add(new StaleDepRow(dep, string.IsNullOrWhiteSpace(e?.Name) ? dep : e!.Name,
                string.IsNullOrWhiteSpace(have) ? "?" : have.Trim(), need.Trim()));
        }
        _staleDepsCache[m.Folder] = list;
        return list;
    }

    /// <summary>这一行需要动手的依赖 = 没装的 + 装得不够新的（一键安装那条通道两者同走）。</summary>
    private List<string> DepsToInstall(ModEntry m)
    {
        var all = new List<string>(MissingDeps(m));   // 拷贝：MissingDeps 返回的是缓存里那个列表本体
        foreach (var s in StaleDeps(m))
            if (!all.Contains(s.Uid, StringComparer.OrdinalIgnoreCase)) all.Add(s.Uid);
        return all;
    }

    // ------------------------------------------------------------------
    // v1.2.0：一键安装缺失依赖（横幅 + 行级入口）
    // ------------------------------------------------------------------
    private List<string>? _pendingDepUids;   // 确认弹窗数据源；空列表 = 全部缺失依赖
    private bool _depInstalling;
    private string? _depError;
    // v1.2.1：依赖的展示名与封面（免 key 搜索异步填充）。列表行和确认弹窗共用这一本账，
    // 所以它<b>不随弹窗开关而清空</b> —— 否则每次打开弹窗都要把整批 UID 重新搜一遍。
    private readonly ConcurrentDictionary<string, InstallService.DependencyDisplayInfo> _depNames
        = new(StringComparer.OrdinalIgnoreCase);
    // 问过、且确实认不出来的 UID。只记「有明确答复」的那一批 —— 断网/限流不算问过，
    // 否则一次抖动就把某个依赖永久钉成「未找到对应 mod」（实机 2026-10-29：Content Patcher
    // 还在搜的时候红字就先写死了结论，十几秒后它自己解析出了 1915）。
    private readonly ConcurrentDictionary<string, byte> _depNameNoMatch = new(StringComparer.OrdinalIgnoreCase);
    // 正在解析的 UID（防同一批里重复发请求）与最近一次尝试时刻（没问到的退避 60 秒，
    // 别让后台重扫把接口打爆）。
    private readonly ConcurrentDictionary<string, byte> _depNameResolving = new(StringComparer.OrdinalIgnoreCase);
    private readonly ConcurrentDictionary<string, DateTime> _depNameAttemptAt = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>并行解析依赖的展示名与封面（免 key 搜索；失败保持 UID 显示并标"未找到"）。</summary>
    /// <summary>「装了但版本不够」的依赖 → 真正有那一版的那一页（值为 null = 查过了，N 网没有这一版）。
    /// <para>判据只有一条：那一页的文件版本表里<b>逐字</b>含有父包要求的那个串
    /// （<see cref="InstallService.FindVersionProviderAsync"/>）。原先这一行的页面号退回
    /// <c>InstalledDepNexusId</c> = "本机这份来自哪一页"，于是把用户一遍遍领回 focustense 的 28870
    /// （整页最高 0.6.1），红字永远消不掉 —— 实机 2026-10-12。</para></summary>
    private readonly ConcurrentDictionary<string, (int? Id, string? Name)> _depProvider = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>正在溯源中的 UID —— 防「后台重扫」与「点开始安装」两路并发重复发请求，
    /// 也让 <see cref="EnsureStaleDepProvidersAsync"/> 能等到它们结束。</summary>
    private readonly ConcurrentDictionary<string, byte> _depProviderBusy = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>逐条依赖汇总"被要求到哪一版"（同一个依赖可能被几个父包各要不同版本）。</summary>
    private Dictionary<string, List<string>> StaleNeedsByUid()
    {
        var map = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var m in _mods)
            foreach (var s in StaleDeps(m))
            {
                if (!map.TryGetValue(s.Uid, out var l)) map[s.Uid] = l = new List<string>();
                if (!l.Contains(s.Need, StringComparer.OrdinalIgnoreCase)) l.Add(s.Need);
            }
        return map;
    }

    private async Task ResolveStaleDepProvidersAsync()
    {
        foreach (var (uid, list) in StaleNeedsByUid())
        {
            if (_depProvider.ContainsKey(uid)) continue;
            if (!_depProviderBusy.TryAdd(uid, 1)) continue;   // 另一路正在算它，别重复发请求
            try
            {
                var hit = await Installer.FindDependencyProviderAsync(
                    Cfg.Current, uid, list, InstalledDepNexusId(uid), ParentNexusIdsForDep(uid));
                if (_disposed) return;
                _depProvider[uid] = hit is null ? (null, null) : (hit.Value.Id, hit.Value.Name);
                await InvokeAsync(StateHasChanged);
            }
            finally { _depProviderBusy.TryRemove(uid, out _); }
        }
    }

    /// <summary>「开始安装」前必须跑的那一步：把「装了但版本不够」的依赖溯源等出来。
    /// <para>不等就会按本机那份自述的页去装。实机 2026-11-07 05:04：用户点一键安装时溯源
    /// 还没算完，于是从 28870（focustense 原版，整页最高 0.6.1）下了包，装完版本照样不够；
    /// 21 秒后日志才写出「命中页面 43861」（StardewUI Continued）—— 用户看到的就是
    /// 「明明要 Continued，装的却是 StardewUI」。</para>
    /// <para>溯源有缓存时是毫秒级，最坏几步搜索也就几秒。宁可等这几秒，也不要装错再来一轮。</para></summary>
    private async Task EnsureStaleDepProvidersAsync()
    {
        if (StaleNeedsByUid().Count == 0) return;
        try { await ResolveStaleDepProvidersAsync(); } catch (Exception ex) { AppLog.Warn("Mods", "依赖溯源等待失败：" + ex.Message); }
        // 另一路（后台重扫）可能正持有其中几条：等它写完，别抢先读到空值
        for (var i = 0; i < 40 && !_depProviderBusy.IsEmpty; i++)
        {
            try { await Task.Delay(150); } catch { break; }
        }
    }

    private async Task ResolveDepNamesAsync(List<string> uids)
    {
        var now = DateTime.UtcNow;
        var todo = new List<string>();
        var filledLocally = false;
        foreach (var u in uids.Distinct(StringComparer.OrdinalIgnoreCase))
        {
            if (_depNames.ContainsKey(u) || _depNameNoMatch.ContainsKey(u)
                || _depNameResolving.ContainsKey(u)) continue;
            // 本机已装的依赖（「版本过旧」那批）：名字/页面号/封面本地条目就有，不必发搜索请求。
            // 但必须照样灌进 _depNames —— 确认弹窗只认这本账；原先这里直接跳过已装项，
            // 弹窗里就只剩裸 UID（实机 2026-10-29：GMCM 明明装在列表里，弹窗显示
            // "spacechase0.GenericModConfigMenu"）。
            if (_installedVersions.ContainsKey(u))
            {
                var e = _mods.FirstOrDefault(x => string.Equals(x.UniqueID.Trim(), u,
                    StringComparison.OrdinalIgnoreCase));
                if (e is not null)
                {
                    _depNames[u] = new InstallService.DependencyDisplayInfo(u, RemarkName(e), e.NexusModId, GetCover(e));
                    filledLocally = true;
                    continue;
                }
            }
            if (!_depNameAttemptAt.TryGetValue(u, out var at) || now - at > TimeSpan.FromSeconds(60))
                todo.Add(u);
        }
        if (filledLocally) await InvokeAsync(StateHasChanged);
        if (todo.Count == 0) return;
        foreach (var u in todo) { _depNameResolving[u] = 1; _depNameAttemptAt[u] = now; }
        await Task.WhenAll(todo.Select(async u =>
        {
            try
            {
                var res = await Installer.ResolveDependencyDisplayAsync(u, ParentNexusIdsForDep(u));
                if (res.Status == InstallService.DependencyResolveStatus.Found && res.Info is { } info)
                {
                    _depNames[u] = info;
                    await InvokeAsync(StateHasChanged);
                }
                else if (res.Status == InstallService.DependencyResolveStatus.NotFound)
                {
                    // 只在这时才记成「问过了」—— 行内那句「未找到对应 mod」由它授权
                    _depNameNoMatch[u] = 1;
                    await InvokeAsync(StateHasChanged);
                }
                // Unknown（没问到）：不记账，等下一次重扫/进页再试
            }
            catch (Exception ex) { AppLog.Warn("Mods", "依赖名解析失败 " + u + ": " + ex.Message); }
            finally { _depNameResolving.TryRemove(u, out _); }
        }));
    }

    /// <summary>这个依赖是被哪些已装 mod 声明为前置的 → 那些父包的 Nexus 页面号。
    /// 官网的 Requirements 表（作者手填、每行直接带 modId）挂在<b>父包</b>身上，
    /// 所以要先回答"谁要求它"，才能去问"它到底是哪个 mod"。父包没有 Nexus 页面号
    /// （manifest UpdateKeys 缺失/无效）时这里就是空列表，解析退回全站搜索。</summary>
    private List<int> ParentNexusIdsForDep(string uid)
    {
        var ids = new List<int>();
        foreach (var m in _mods)
        {
            if (m.NexusModId is not > 0 || ids.Contains(m.NexusModId.Value)) continue;
            if (m.Dependencies.Concat(m.ContentPackIds)
                    .Any(d => string.Equals(d?.Trim(), uid, StringComparison.OrdinalIgnoreCase)))
                ids.Add(m.NexusModId.Value);
        }
        return ids;
    }

    /// <summary>行内展示：有名字就用名字；问过且确实没有才带着 UID 明说"未找到对应 mod"，
    /// 而不是甩一串玩家看不懂的字符；还在搜（或没问到）就先给 UID —— 空态不下结论。
    /// 同包子模块单独一条 —— 它压根没有 N 网页面，报"未找到"会让人以为我们搜过了却没有。</summary>
    private string DepLabel(string uid, StaleDepRow? stale = null)
    {
        // 「要多少」是（依赖方, 依赖）这一对的属性，不是依赖自己的：同一个 StardewUI，
        // 完美手册要 ≥0.6.4-unofficial-mushymato.0、Livestock Bazaar 要 ≥0.6.3-unofficial-mushymato.1。
        // 所以这个数字必须由调用方把它那一行的 StaleDepRow 递进来 —— 原先这里按 UID 查一张
        // 全局汇总表（_staleByUid，后写的覆盖先写的），两行都印成了同一个要求版本。
        if (stale is not null)
        {
            // 认得出「哪一页真有这一版」时，那一页的本名才是作者要的东西（实机：作者要的是
            // 「StardewUI Continued」，本机这份只是复用同一 UID 的 focustense 原版 0.6.1）；
            // 认不出就照旧报本机这份的自述 —— 不编名字。
            var shown = _depProvider.TryGetValue(uid, out var prov) && !string.IsNullOrWhiteSpace(prov.Name)
                ? prov.Name!.Trim() : stale.Name;
            return Loc.F("{0}（本机 {1}，需要 ≥{2}）", shown, stale.Have, stale.Need);
        }
        if (_depNames.TryGetValue(uid, out var di) && !string.IsNullOrWhiteSpace(di.Name)) return di.Name!;
        if (ModService.BundledParentOf(uid, InstalledUids) is string parentUid)
        {
            var pe = _mods.FirstOrDefault(m => string.Equals(m.UniqueID.Trim(), parentUid,
                StringComparison.OrdinalIgnoreCase));
            if (pe is not null)
                return Loc.F("{0}（随「{1}」一起装）", uid,
                    string.IsNullOrWhiteSpace(pe.Name) ? pe.Folder : pe.Name);
        }
        return _depNameNoMatch.ContainsKey(uid)
            ? Loc.F("{0}（未找到对应 mod）", uid)
            : uid;
    }

    /// <summary>全部要动手的依赖并集（横幅 + 确认弹窗 + 一键安装入口）：
    /// 没装的 + 装了但版本不够的。SMAPI 对这两种都是「依赖方直接 Skipped」，
    /// 出路也都是去下一个够新的版本，所以共用一条通道、共用一个计数。</summary>
    private List<string> TotalMissingUids
    {
        get
        {
            var set = new List<string>();
            foreach (var m in _mods)
                foreach (var d in DepsToInstall(m))
                    if (!set.Contains(d, StringComparer.OrdinalIgnoreCase)) set.Add(d);
            return set;
        }
    }

    /// <summary>横幅那行的「影响 N 个 mod」—— 只算依赖问题（没装 / 版本过旧），因为横幅的按钮
    /// 是「一键安装依赖」，修不了 SMAPI 太旧的那批。筛选栏的计数另算一路（见 CountFor）。</summary>
    private int MissingAffectedMods => _mods.Count(m => MissingDeps(m).Count > 0 || StaleDeps(m).Count > 0);

    /// <summary>manifest 声明的最低 SMAPI 版本高于本机实际会加载的版本 → 返回它要求的那一串。
    /// SMAPI 对这种情况的处置与缺前置一样：整条 Skipped（实机 2026-10-29：StardewUI 要 4.5.2、
    /// 实际跑 4.5.1）。判据在 <see cref="DependencyRules.SmapiTooOldNeed"/>，测试舱直接跑它。</summary>
    private string? SmapiTooOldNeed(ModEntry m)
        => DependencyRules.SmapiTooOldNeed(m.MinApiVersion, _smapiVersion);

    /// <summary>uids 为 null = 全部缺失依赖；否则只装这一批（传给确认弹窗与安装管线）。</summary>
    private void AskInstallMissingDeps(List<string>? uids)
    {
        _depError = null;
        _pendingDepUids = uids ?? new List<string>();
        // v1.2.1：弹窗立即打开（先显示 UID），封面/mod 名后台异步解析、逐个补上
        _ = GuardedFireAndForget(ResolveDepNamesAsync(_pendingDepUids.Count > 0 ? _pendingDepUids : TotalMissingUids),
            "依赖名解析");
    }

    /// <summary>fire-and-forget 的异常收尸：没人 await 的 Task 抛异常时，异常对象直到 GC 才被
    /// finalizer 线程重抛 —— 运行期界面无感知，日志里只留下一条迟到的
    /// 「ERR [Task] unobserved」（2026-10-05 02:34 实测两条，都指回Mods 页的封面回填）。
    /// 这里就地兜住并记成一条能定位的警告：至少让人知道"这次网络抖了"，而不是幽灵异常。</summary>
    private static async Task GuardedFireAndForget(Task t, string what)
    {
        try { await t.ConfigureAwait(false); }
        catch (OperationCanceledException) { /* 页面已离开，正常 */ }
        catch (Exception ex) { AppLog.Warn("Mods", what + "失败: " + ex.Message); }
    }

    private void CancelInstallDeps() => _pendingDepUids = null;

    /// <summary>v1.2.3：确认弹窗点依赖行 → 应用内 mod 详情页（/mod/{nexusId}/{uid}）。
    /// 未解析到 Nexus modId 的行（搜索失败）不可点，直接忽略。</summary>
    private void OpenDepDetail(InstallService.DependencyDisplayInfo? di)
    {
        if (di?.ModId is not int id) return;
        _pendingDepUids = null;   // 离开当前页前收起弹窗，返回列表时不残留
        Nav.NavigateTo($"mod/{id}" + (string.IsNullOrWhiteSpace(di.Uid) ? "" : "/" + Uri.EscapeDataString(di.Uid)));
    }

    /// <summary>v1.5.1：列表行里点依赖名（名字已解析出 Nexus 页面）→ 同一个详情页。
    /// uid 一起带上：详情页靠它判「本机装着但版本过旧」这条出路。</summary>
    private void OpenDepByUid(string uid, int nexusId)
    {
        if (nexusId <= 0) return;
        Nav.NavigateTo($"mod/{nexusId}" + (string.IsNullOrWhiteSpace(uid) ? "" : "/" + Uri.EscapeDataString(uid)));
    }

    /// <summary>这条依赖在本机是否装着、装着的话它的 Nexus 页面号是多少（0 = 没装/没登记）。
    /// 「装了但版本过旧」那批走这条 —— 本地条目本来就带 NexusModId，不必再发搜索。</summary>
    private int InstalledDepNexusId(string uid)
    {
        var e = _mods.FirstOrDefault(m => string.Equals(m.UniqueID.Trim(), uid.Trim(),
            StringComparison.OrdinalIgnoreCase));
        return e?.NexusModId ?? 0;
    }

    private async Task ConfirmInstallDeps()
    {
        if (_depInstalling) return;
        var uids = _pendingDepUids;
        _pendingDepUids = null;
        _depInstalling = true;
        _depError = null;
        try
        {
            // 先把「装了但版本不够」的依赖溯源等出来 —— 否则会按本机那份自述的页去装，
            // 装完版本照样不够（见 EnsureStaleDepProvidersAsync 的实机记录）。
            await EnsureStaleDepProvidersAsync();
            // 空列表 = 全部缺失依赖；服务端每轮重扫磁盘，无需在此快照。
            // v1.2.3：把弹窗已解析出的 UID → modId 一并传给安装管线（免二次搜索，
            // 安装时照常做 UniqueID 校验）。等待期间 Installer.OnChanged 推动列表实时重扫。
            var pre = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (var kv in _depNames)
                if (kv.Value.ModId is int mid) pre[kv.Key] = mid;
            // 「装了但版本不够」的那批：有版本证据的那一页覆盖掉本机自述的页 ——
            // 否则传下去的是原版页（UniqueID 相同，校验也会过），装了还是不达标，白跑一轮。
            foreach (var kv in _depProvider)
                if (kv.Value.Id is int provId && provId > 0) pre[kv.Key] = provId;
            var err = await Installer.InstallMissingDependenciesAsync(
                uids is { Count: > 0 } ? uids : null, pre);
            if (err is not null && err != "已取消") _depError = err;
        }
        finally
        {
            _depInstalling = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>是否「有可用更新」：N 网 MAIN 文件版本/ fileId 口径（见 NexusUpdateTruth）。</summary>
    private bool IsUpdatable(ModEntry m)
    {
        if (m.IsConvertedPack) return false;
        var st = GetState(m.Folder);
        return NexusUpdateTruth.ShouldShowUpdate(Cfg.Current, m, st.RemoteVersion, st.RemoteFileId);
    }

    /// <summary>「批量更新」按钮能不能点 —— 必须和 <see cref="BatchUpdate"/> 的取数口径一致，
    /// 否则会出现「按钮是亮的、点下去报没有可更新的」。差别只在两处：
    /// ① 只有 smapi.io 快道查到版本、没 Nexus/GitHub 标识的 mod 不算（点了也没地方下包）；
    /// ② 禁用与否<b>不</b>影响 —— 更新只换文件，不改变启停状态。</summary>
    private bool CanBatchUpdate(ModEntry m)
        => (m.NexusModId is not null || m.GitHubRepo is not null) && IsUpdatable(m);

    /// <summary>按最外层文件夹分组（根目录直接受让的 mod 为 "" 组），再排成界面上的行序。
    /// <para>v1.3.29：结果带缓存。这个 getter 每次渲染都会被访问一次，里面是「分组 + 两次排序 +
    /// 每行再算一遍缺失依赖」的全量 LINQ —— 187 个 mod 一帧就能造出上千个临时对象。实测切页
    /// 时 UI 线程被占住 344ms，其中这部分是纯重复劳动（一次渲染周期内输入根本没变）。
    /// 键取「数据引用 + 已装 UID 集合引用 + 筛选/搜索/排序」：重扫会换掉前两个的实例，
    /// 用户改筛选会换掉后三个，都能正确失效。</para></summary>
    private IReadOnlyList<ModGroup> Groups
    {
        get
        {
            if (_groupsCache is not null
                && ReferenceEquals(_groupsKeyMods, _mods)
                && ReferenceEquals(_groupsKeyUids, _installedUids)
                && _groupsKeyFilter == _filter
                && _groupsKeySearch == SearchText
                && _groupsKeySort == _sortMode
                && _groupsKeyCategoryRev == _categoryRev)
                return _groupsCache;

            var installed = InstalledUids;
            var units = OrderRows(FilteredMods, _sortMode);
            foreach (var u in units)
                u.Missing = u.Items
                    .Where(x => x.Dependencies is { Count: > 0 } || x.ContentPackIds is { Count: > 0 })
                    .SelectMany(x => x.Dependencies.Concat(x.ContentPackIds))
                    .Where(d => !string.IsNullOrWhiteSpace(d) && !installed.Contains(d))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

            // v1.3.47：自定义分类不再是一种「排序方式」—— 有分类就分段显示（重开应用也在），
            // 排序方式只决定段内顺序。段可折叠（折叠时只留段头一行）。
            // v1.3.48：段之间认「标签是哪一刻建的」—— ModUserCategoryOrder 是建分类时追加的
            // 名单，越靠末尾越新，倒过来排就是「新建的在最上面」。旧写法用「这一类里最新 mod
            // 的磁盘时间」，把几个老 mod 归进新标签时新标签反而沉到底下。
            // v1.3.56：状态筛选（可更新/缺依赖/维护存疑）是「找东西」的视图 —— 这几个 chip 的
            // 结果通常只有几条，按分类再切段只会把结果藏进一堆段头里，直接平铺。
            // v1.3.83：**搜索时也不分段** —— 搜「pov」一条没有，屏幕上却还立着三个空段头
            // （2026-11-07 用户截图）。搜到的几行本来就该挨在一起看。
            // v1.3.84：分段与否由 BuildCategorySections 明确返回，别再靠「清空登记表 + 改
            // SectionHeader」的副作用退场 —— 那个副作用会被紧跟着的 display 循环覆盖回去，
            // 于是「段头照画、登记表却是空的」：所有段拿到同一个兜底序号，段体 id 全部撞车，
            // 点空分类就会把有 mod 的那一段折叠掉（2026-11-08 实机）。
            var segmented = false;
            if (HasUserCategories() && !IsStatusFilter && string.IsNullOrWhiteSpace(SearchText))
            {
                // 段序唯一口径：CategoryDisplayOrder()（屏上从上到下）。这里以前自己算了一套
                // 「名单序号倒排 + 未分类垫底」，和拖动的 VisibleSectionOrder 口径不一致 ——
                // 拖未分类算出来和原样完全相等，被当成「挪了个寂寞」丢掉（2026-11-09 用户反馈）。
                var dispOrder = CategoryDisplayOrder();
                int SectionRank(string c)
                {
                    var i = dispOrder.FindIndex(x => string.Equals(x, c, StringComparison.OrdinalIgnoreCase));
                    return i < 0 ? int.MaxValue : i;         // 没登记的段排最后
                }
                units = units
                    .OrderBy(u => SectionRank(CategoryOfUnit(u)))
                    .ThenBy(u => CategoryOfUnit(u), StringComparer.OrdinalIgnoreCase)
                    .ToList();

                // ⚠ 先把行序排好再问能不能分段：登记表按「段在屏幕上出现的先后」定同名分类的次序
                segmented = BuildCategorySections(units);
            }
            if (segmented)
            {
                var display = new List<ModGroup>(units.Count + _categorySections.Count);
                string? lastCat = null;
                foreach (var u in units)
                {
                    var c = CategoryOfUnit(u);
                    var collapsed = _collapsedCats.Contains(c);
                    if (!string.Equals(c, lastCat, StringComparison.OrdinalIgnoreCase))
                    {
                        lastCat = c;
                        display.Add(new ModGroup
                        {
                            Key = "",
                            Items = new List<ModEntry>(),
                            SectionHeader = c,
                            SectionKey = c,
                            SectionCollapsed = collapsed,
                        });
                    }
                    // v1.3.49：折叠段的行仍进 display（进 DOM），只是渲染时被 .jg-cat-body 的
                    // height:0 藏起来 —— 手风琴动画要能量到真实高度，行得一直在 DOM 里。
                    u.SectionKey = c;
                    u.SectionCollapsed = collapsed;
                    display.Add(u);
                }
                units = display;
            }
            if (!segmented)
            {
                // 平铺视图：一个段头都不画
                _categorySections = new List<CategorySection>();
                foreach (var u in units)
                {
                    u.SectionHeader = null;
                    u.SectionKey = null;
                    u.SectionCollapsed = false;
                }
            }

            _groupsCache = units;
            _groupsKeyMods = _mods;
            _groupsKeyUids = _installedUids;
            _groupsKeyFilter = _filter;
            _groupsKeySearch = SearchText;
            _groupsKeySort = _sortMode;
            _groupsKeyCategoryRev = _categoryRev;
            // 列表内容变了 ⇒ 从头开始渐进渲染（否则换了筛选还按上一批的行数一次画光）
            _renderLimit = FirstRenderRows;
            return units;
        }
    }

    private IReadOnlyList<ModGroup>? _groupsCache;
    private IReadOnlyList<ModEntry>? _groupsKeyMods;
    private HashSet<string>? _groupsKeyUids;
    private string? _groupsKeyFilter;
    private string? _groupsKeySearch;
    private string? _groupsKeySort;
    private int _groupsKeyCategoryRev;

    // ── v1.3.29 渐进渲染 ──────────────────────────────────────────────
    // 实测（2026-11-04）：切到 Mods 页 UI 线程被占 344ms，而把列表用搜索框滤成 0 行后
    // 同样切一次「一条卡顿记录都没有」，重扫索引照跑 91ms —— 说明卡的是「行数 × 每行 DOM」，
    // 而不是任何一段业务代码。200 行一次性塞进 DOM，Blazor 的 RenderTreeDiff + 序列化都在
    // UI 线程同步跑完，界面就定在那儿。
    // 处理办法：首帧只画 40 行（几乎瞬间），剩下的在后续几帧里翻倍补齐（40→80→160→200）。
    // 总渲染量略增（重复 diff 已画过的行），但每帧占用降到几十毫秒，界面全程可交互。
    /// <summary>首帧渲染的行数。</summary>
    private const int FirstRenderRows = 40;
    /// <summary>本帧最多渲染多少行；0 = 不分批（全画）。由 Groups 缓存失效重置。</summary>
    private int _renderLimit = FirstRenderRows;
    /// <summary>上一帧实际画出了多少行（含捆绑包组头）。</summary>
    private int _renderShown;
    /// <summary>整个列表一共有多少行（含组头）。</summary>
    private int _renderTotalRows;
    /// <summary>已经排了一次补画，防止 OnAfterRenderAsync 重入。</summary>
    private bool _renderMorePending;

    /// <summary>本次渲染要画的分类段。分批时把最后一组按剩余额度切断（组头也算一行，
    /// 否则会出现"额度用完但组头全画出来"的一排空组）。折叠段的行照常进段（进 DOM 供手风琴
    /// 动画量高），只是渲染时被 .jg-cat-body 的 height:0 藏住。</summary>
    private IReadOnlyList<CatSection> RenderedGroups()
    {
        var all = Groups;
        var total = 0;
        foreach (var g in all) total += g.Items.Count + (g.Key.Length > 0 ? 1 : 0);
        _renderTotalRows = total;

        IReadOnlyList<ModGroup> picked;
        if (_renderLimit <= 0 || total <= _renderLimit)
        {
            _renderShown = total;
            picked = all;
        }
        else
        {
            var list = new List<ModGroup>(Math.Min(all.Count, 64));
            var shown = 0;
            foreach (var g in all)
            {
                var head = g.Key.Length > 0 ? 1 : 0;
                if (shown + head >= _renderLimit) break;
                var room = _renderLimit - shown - head;
                if (room <= 0) break;
                if (room >= g.Items.Count)
                {
                    list.Add(g);
                    shown += g.Items.Count + head;
                }
                else
                {
                    list.Add(new ModGroup { Key = g.Key, Items = g.Items.Take(room).ToList(), Missing = g.Missing });
                    shown += room + head;
                }
            }
            _renderShown = shown;
            picked = list;
        }

        // 扁平组 → 段结构：段头组（SectionHeader 非空）开一段，其后同段的 mod 组收进该段。
        // ⚠ 没有任何自定义分类时一个段头都没有 —— 此时退化成单个「隐式段」（不画段头），
        // 否则整份列表会被这段分组吃掉、界面一片空白。
        var sections = new List<CatSection>();
        CatSection? cur = null;
        foreach (var g in picked)
        {
            if (g.SectionHeader is not null)
            {
                var sec = CategorySectionOf(g.SectionHeader);
                cur = new CatSection
                {
                    Key = g.SectionKey ?? "",
                    Label = sec.Label,
                    Index = sec.Index,
                    // 折叠状态实时读 _collapsedCats（不烘进 Groups 缓存）：折叠只是显示状态，
                    // 为它作废缓存会把渐进渲染打回 40 行，列表先缩一截再补画。
                    Collapsed = _collapsedCats.Contains(g.SectionKey ?? ""),
                    HasHeader = true,
                };
                sections.Add(cur);
                continue;
            }
            if (cur is null)                 // 隐式段：无分类视图
            {
                cur = new CatSection { Key = "", Index = -1, HasHeader = false };
                sections.Add(cur);
            }
            cur.Groups.Add(g);
        }

        // v1.3.78：**一个 mod 都没有的分类也要画段头**。
        // 段头就是长按拖拽的落点（data-cat-key），空分类不进 picked（没有 unit），
        // 不补的话新建的分类在列表里根本画不出来、也就没法把 mod 拖进去
        // —— 2026-11-07 用户反馈「分类标签里没有任何 mod 就不要再隐藏了，否则没办法拖动进去」。
        // 只补段头不补行：Count 保持 0，段体为空。
        // v1.3.83：与 BuildCategorySections 同一条口径 —— 只有「全部 + 没搜索」才补，
        // 否则搜索/状态筛选下会凭空多出一排空段头（用户截图那个场景）。
        if (_filter == "all" && string.IsNullOrWhiteSpace(SearchText))
        {
            foreach (var c in ExistingCategories())
            {
                if (sections.Any(s => string.Equals(s.Key, c, StringComparison.OrdinalIgnoreCase))) continue;
                var meta = CategorySectionOf(c);
                sections.Add(new CatSection
                {
                    Key = c,
                    Label = meta.Label,
                    Index = meta.Index,
                    Collapsed = _collapsedCats.Contains(c),
                    HasHeader = true,
                });
            }
        }
        // 补进来的排在末尾，按段序重排（Index 来自 _categorySections，已按「最新建的在最上」编好）
        if (sections.Count > 1)
            sections = sections.OrderBy(s => s.Index < 0 ? int.MaxValue : s.Index).ToList();
        return sections;
    }

    private static string GroupKeyOf(ModEntry m)
    {
        // Folder 形如 "SVE/[CP] xx" 或 "xx"：取第一个段作为分组。
        var idx = m.Folder.IndexOf('/');
        return idx > 0 ? m.Folder[..idx] : "";
    }


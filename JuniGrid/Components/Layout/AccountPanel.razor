@namespace JuniGrid.Components.Layout
@inject ConfigService Cfg
@inject GameService Game
@inject LauncherService Launcher
@inject ModService ModSvc
@inject SteamService Steam
@inject UpdateService Updater
@inject PageRefreshService PageRefresh
@inject PlayTimeService PlayTime
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<aside class="jg-account">
    <div class="jg-mode-row">
        <div class="jg-mode-pills @(_cfg.LaunchMode)">
            <span class="jg-pill-thumb"></span>
            <button class="jg-pill @(_cfg.LaunchMode == "steam" ? "active" : "")"
                    disabled="@(_busy || _isRunning)" @onclick='() => SetMode("steam")'>
                <img src="assets/steam.svg" alt="Steam" style="width:18px;height:18px;vertical-align:-3px;margin-right:6px;" /> @Loc.T("官方") </button>
            @* 无适配 SMAPI 的版本（1.0/1.01）：置灰 + 悬停说明。这里用 aria-disabled 而不是
               disabled —— 真 disabled 的按钮浏览器不派发鼠标事件，提示气泡根本弹不出来。 *@
            <button class="@SmapiPillClass"
                    disabled="@(_busy || _isRunning)"
                    aria-disabled="@SmapiAriaDisabled"
                    data-tip="@SmapiTip"
                    @onclick='() => SetMode("smapi")'>
                <img src="assets/smapi-pufferchick.svg" alt="SMAPI" style="width:18px;height:18px;vertical-align:-3px;margin-right:6px;border-radius:4px;" />
                SMAPI
            </button>
        </div>
    </div>

    <div class="jg-account-mid">
        <div class="jg-avatar-wrap">
            @if (_profile.Found && _profile.AvatarDataUri is not null)
            {
                <img class="jg-avatar" src="@_profile.AvatarDataUri" alt='@Loc.T("Steam 头像")' />
            }
            else
            {
                @* 未检测到 Steam（或拿不到头像）→ 用项目内置 Steam 圆标兜底，不再是首字母色块 *@
                <img class="jg-avatar" src="assets/steam.svg" alt="Steam" />
            }
            @if (_isRunning)
            {
                <span class="jg-avatar-dot" title='@Loc.T("游戏运行中")'></span>
            }
        </div>

        <div class="jg-account-name">@AccountLabel</div>
        <div class="jg-account-sub">
            @(_cfg.LaunchMode == "steam" ? Loc.T("官方（无 Mod）") : Loc.T("SMAPI（带 Mod）"))
        </div>
    </div>

    <div class="jg-launch-row @(_isRunning ? "running" : (_launching ? "launching" : ""))">
    <button id="launch-btn"
            class="jg-launch-big"
            disabled="@_launching"
            @onclick="OnButtonClick">
        <span class="jg-launch-main">@MainButtonLabel</span>
        @if (!_isRunning && !_launching)
        {
            <span class="jg-launch-ver">@Loc.F(" 当前游戏版本：{0} ", DisplayVersion)@* v1.1.7：去掉「→ 有新版本」提示与跳转 —— 停在历史版本本来就是用户自己选的，
                   回到最新版走版本管理弹窗，主按钮上不再挂催促。 *@
            </span>
        }
    </button>

    <button class="jg-close-btn" data-tip="@(_launching ? Loc.T("取消启动") : Loc.T("关闭游戏"))" @onclick="OnButtonClick">
        ✕
    </button>
</div>
</aside>

@if (@_showConfirm)
{
    <div class="jg-dlg-overlay" @onclick="DismissConfirm">
        <div class="jg-dialog" @onclick:stopPropagation>
            <div class="jg-dialog-body">@Loc.T("关闭游戏可能会导致未保存的游戏进度丢失")<br />@Loc.T("是否确认关闭游戏？")</div>
            <div class="jg-dialog-actions">
                <button type="button" class="jg-pill-ghost" @onclick="DismissConfirm">@Loc.T("取消")</button>
                <button type="button" class="jg-pill-danger" @onclick="KillGame">@Loc.T("确认关闭")</button>
            </div>
        </div>
    </div>
}

@* 启动前的闸门（存档版本不匹配 / 云同步断在半路）：整段说明必须原样显示，并且带「仍然启动」这个出口。
   走 toast 的话文案会被 SummarizeLaunchError 截到 60 字，出口那半句正好被切掉 —— 没有出口的硬拦
   只会把人逼去用 Steam 直接启动，那条路我们连拦都拦不到。 *@
@if (_gateText is not null)
{
    <div class="jg-dlg-overlay" @onclick="DismissGate">
        <div class="jg-dialog" style="max-width:520px;text-align:left" @onclick:stopPropagation>
            <div class="jg-dialog-body" style="white-space:pre-line;max-height:52vh;overflow:auto">@_gateText</div>
            <div class="jg-dialog-actions">
                <button type="button" class="jg-pill-ghost" @onclick="DismissGate">@Loc.T("取消")</button>
                <button type="button" class="jg-pill-danger" @onclick="LaunchAnyway">@Loc.T("仍然启动")</button>
            </div>
        </div>
    </div>
}

@* 「已经为你启动了 N 次」的赞助提示：第 10 次启动第一次弹，之后每 7 天最多一次。
   两屏：文案页 → 收款码页（微信/支付宝 + 爱发电），版式参照 React Bits 的 Stepper：
   磨砂面板、胶囊标签、卡片式二维码、底部左返回右主按钮。
   弹窗属于 AccountPanel（常驻布局），所以启动后自动跳去日志页也不会把它带走。 *@
@if (_sponsorLaunchCount > 0)
{
    <div class="jg-dlg-overlay">
        <div class="jg-sponsor-panel" role="dialog" aria-modal="true" aria-label='@Loc.T("支持 JuniGrid")' @onclick:stopPropagation>
            <div class="jg-sponsor-viewport">
                @* 离场的那一屏临摹在绝对定位层里淡出：换屏这 150ms 里卡片还有内容可看，
                   而且它不参与高度计算，弹簧量的始终是新一屏的自然高度。 *@
                @if (_leavingStep is not null)
                {
                    <div class="jg-sponsor-pane jg-sponsor-pane--leaving" aria-hidden="true">
                        @(_leavingStep switch { 0 => StepMessage, 1 => StepQr, _ => StepForgotQr })
                    </div>
                }
                @* 换屏：@key 让这一屏重新挂载。这一屏先隐身（--waiting），高度弹簧由
                   OnAfterRender 里的 sponsorMorph 起跑；JS 在弹簧起跑时再加 --in，
                   保证"框够高了内容才浮现"—— 时序反过来就会在矮框里看到被切的按钮。 *@
                <div class="jg-sponsor-pane @(_leavingStep is not null ? "jg-sponsor-pane--waiting" : "")" @key="_sponsorStep">
                    @(_sponsorStep switch { 0 => StepMessage, 1 => StepQr, _ => StepForgotQr })
                </div>
            </div>
        </div>
    </div>
}

@code {

    private RenderFragment StepMessage => @<div class="jg-sponsor-stage">
        <div class="jg-sponsor-kicker">@Loc.F("第 {0} 次启动 · 共 {1} 小时", _sponsorLaunchCount, _sponsorPlayHours)</div>
        <h3 class="jg-sponsor-heading">@Loc.T("喜欢 JuniGrid 吗？")</h3>
        <p class="jg-sponsor-copy">
            @Loc.F("它已经为你启动了 {0} 次游戏。如果还算好用，能不能请作者喝杯咖啡？", _sponsorLaunchCount)
        </p>
        <div class="jg-sponsor-actions">
            <button type="button" class="jg-sponsor-btn ghost" @onclick="DismissSponsor">@Loc.T("这次算了吧")</button>
            <button type="button" class="jg-sponsor-btn solid" @onclick="ShowSponsorSupport">@Loc.T("支持作者")</button>
        </div>
    </div>;

    private RenderFragment StepQr => @<div class="jg-sponsor-stage">
        <div class="jg-sponsor-tabs">
            <button type="button" class="jg-sponsor-tab-btn @(_sponsorWechat ? "active" : "")" @onclick="() => SelectQr(true)">@Loc.T("微信")</button>
            <button type="button" class="jg-sponsor-tab-btn @(!_sponsorWechat ? "active" : "")" @onclick="() => SelectQr(false)">@Loc.T("支付宝")</button>
        </div>
        <div class="jg-sponsor-qr-shell @(_qrTick > 0 ? "jg-qr-anim" : "")" @key="_qrTick" data-dir="@(_qrDirection < 0 ? "left" : "right")">
            <img class="jg-sponsor-qr-img"
                 src="@(_sponsorWechat ? "assets/sponsor-wechat.jpg" : "assets/sponsor-alipay.jpg")"
                 alt="@(_sponsorWechat ? Loc.T("微信赞赏码") : Loc.T("支付宝收款码"))" />
        </div>
        <p class="jg-sponsor-tip">
            @Loc.T("请备注 QQ 或者微信号")
            <span class="jg-help-tip jg-help-tip--right">
                <span class="jg-help-tip-btn">?</span>
                <span class="jg-help-tip-bubble">@Loc.T("10元以上可以添加作者微信/QQ 并添加JuniGrid交流群 可抢先体验最新版JuniGrid或者新Mod")</span>
            </span>
        </p>
        <div class="jg-sponsor-divider"></div>
        <div class="jg-sponsor-or-row">
            <span>or</span>
            <button type="button" class="jg-sponsor-afdian" @onclick="OpenAfdian">@Loc.T("去爱发电")</button>
        </div>
        <div class="jg-sponsor-actions">
            <button type="button" class="jg-sponsor-btn ghost" @onclick="DismissSponsor">@Loc.T("关闭")</button>
            <button type="button" class="jg-sponsor-btn ghost" @onclick="ShowForgotQr">@Loc.T("忘记备注")</button>
            <button type="button" class="jg-sponsor-btn solid" @onclick="MarkSupported">@Loc.T("已支持")</button>
        </div>
    </div>;

    @* 第三屏：扫码付款时忘了写备注 —— 换成加好友二维码，让作者能凭备注把人认回来。 *@
    private RenderFragment StepForgotQr => @<div class="jg-sponsor-stage">
        <h3 class="jg-sponsor-heading jg-sponsor-heading--center">@Loc.T("请用微信扫码")</h3>
        <div class="jg-sponsor-qr-shell">
            <img class="jg-sponsor-qr-img" src="assets/sponsor-wechat-friend.jpg" alt='@Loc.T("微信二维码")' />
        </div>
        <div class="jg-sponsor-actions jg-sponsor-actions--center">
            <button type="button" class="jg-sponsor-btn ghost" @onclick="BackToQr">@Loc.T("返回")</button>
            <button type="button" class="jg-sponsor-btn solid" @onclick="DismissSponsor">@Loc.T("关闭")</button>
        </div>
    </div>;

    private JuniGridConfig _cfg = new();
    private SteamProfile _profile = SteamProfile.None;
    private string? _gameVersion;
    private bool _launching;
    private bool _isRunning;
    private bool _showConfirm;
    /// <summary>启动前闸门拦下来时要整段显示的说明（null = 没有待处理的闸门）。</summary>
    private string? _gateText;
    /// <summary>赞助提示要写的启动次数（0 = 不显示弹窗）。</summary>
    private int _sponsorLaunchCount;
    /// <summary>弹窗标题后面带的累计游玩时长（小时，弹出那一刻取一次快照，不再跳动）。</summary>
    private string _sponsorPlayHours = "0";
    /// <summary>赞助弹窗当前屏：0 = 文案页，1 = 收款码页。</summary>
    private int _sponsorStep;
    private int? _leavingStep;               // 正在淡出的那一屏（绝对定位层，活到弹簧结束）
    private int _sponsorRenderedStep = -1;   // 上次渲染的屏号：用来判断"这次是换屏还是首开"
    private bool _sponsorWechat = true;
    private int _qrTick;                     // 微信/支付宝切换计数：@key 换元素，重启滑入动画
    private int _qrDirection = 1;            // +1 切到支付宝（从右进），-1 切回微信
    private readonly CancellationTokenSource _cts = new();

    private bool _busy => _launching;

    private string AccountLabel =>
        _profile.Found
            ? (_profile.PersonaName ?? _profile.AccountName ?? "Steam 用户")
            : "未检测到 Steam 账户";

    private string MainButtonLabel =>
        Loc.T(_launching ? "启动中…" :
        _isRunning ? "运行中…" :
        "▶ 启动游戏");

    protected override void OnInitialized()
    {
        _cfg = Cfg.Current;

        if (string.IsNullOrWhiteSpace(_cfg.GamePath))
        {
            // 检测丢后台：同步跑在渲染线程上，碰上没就绪的盘（网络映射盘/拔掉的移动盘）
            // 会把整个侧栏冻住几十秒。探到再落盘 + 重探版本号。
            _ = Task.Run(async () =>
            {
                var detected = await Game.DetectGamePathAsync(_cfg.SteamAppId);
                if (string.IsNullOrEmpty(detected)) return;
                await InvokeAsync(() =>
                {
                    SaveCfg(c => c.GamePath = detected);
                    ProbeVersions();
                    StateHasChanged();
                });
            });
        }

        _profile = Steam.GetProfile();
        ProbeVersions();
        ConfigService.Saved += HandleCfgSaved;
        // 换版本后侧栏「当前游戏版本」要跟着重读，否则停在切换那次读到的空值上显示「未定位」
        PageRefresh.OnRefresh += OnPageRefresh;
    }

    private void OnPageRefresh(string key)
    {
        if (key != "version") return;
        _ = InvokeAsync(() => { ProbeVersions(); StateHasChanged(); });
    }

    protected override async Task OnInitializedAsync()
    {
        // 轮询真实游戏进程，让「关闭游戏」按钮对 SMAPI / Steam 官方两种模式都生效
        _ = PollRunningAsync();
        // 应用长期不关时，7 天的间隔到点也要弹（不依赖「启动游戏」这个动作）
        _ = SponsorPromptLoopAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        try { _cts.Dispose(); } catch { }   // v1.1.6：Cancel 后释放，轮询循环抛 OCE 正常退出
        ConfigService.Saved -= HandleCfgSaved;
        PageRefresh.OnRefresh -= OnPageRefresh;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 启动按钮：光标驱动的 3D 透视倾斜（GSAP quickTo）
            // v1.1.2：hover 像素溶解「点击启动！」遮罩已按需求移除，仅保留随鼠标倾斜
            try { await JS.InvokeVoidAsync("junigridJs.tiltPerspective", "#launch-btn"); } catch { }
            // 老用户更新后第一次打开就能看到赞助提示（次数早过 10 了），不必等下次启动游戏
            _ = CheckSponsorPromptAfterStartupAsync();
        }

        // 赞助弹窗换屏后播"小窗长大窗"的高度弹簧。首开（rendered=-1）不播，交给 CSS 入场。
        if (_sponsorLaunchCount > 0)
        {
            var step = _sponsorStep;
            var morph = _sponsorRenderedStep >= 0 && _sponsorRenderedStep != step;
            _sponsorRenderedStep = step;
            if (morph)
            {
                // 先把渲染屏号推进再 await：Blazor 的第二次 render 若闯进来，也不会重复启动
                try { await JS.InvokeVoidAsync("junigridJs.sponsorMorph"); }
                catch (Exception ex) { AppLog.Warn("AccountPanel", "换屏弹簧启动失败: " + ex.Message); }
            }
        }
        else
        {
            _sponsorRenderedStep = -1;
        }
    }

    private void ProbeVersions()
    {
        _gameVersion = Updater.GetGameVersion(_cfg.GamePath);

        // 有的版本压根没有可安装的 SMAPI（1.0/1.01），默认停在 SMAPI 模式就是「一点就失败」
        // （实测红条：未检测到 SMAPI…）。这类版本一律把默认页归到「官方」。
        if (_cfg.LaunchMode == "smapi" && SmapiUnavailable)
        {
            SaveCfg(c => c.LaunchMode = "steam");
            AppLog.Warn("AccountPanel", $"游戏 {_gameVersion} 无可用 SMAPI，启动模式已自动切到「官方」");
        }
    }

    /// <summary>在<b>最新</b>配置对象上做修改并落盘。不能直接改 _cfg 再 Cfg.Save(_cfg)：
    /// _cfg 只是组件初始化时抓的那一次引用，别的写入方 Save 时 Current 会被换成新对象，
    /// 这时 _cfg 就旧了 —— 再把它整个 Save 回去，会把人家刚落盘的字段一起回滚
    /// （实测把赞助记账抹回 null → 弹窗重新武装、每次启动都弹，2026-11-03）。</summary>
    private void SaveCfg(Action<JuniGridConfig> mutate)
    {
        var cfg = Cfg.Current;
        mutate(cfg);
        _cfg = cfg;
        Cfg.Save(cfg);
    }

    /// <summary>当前游戏版本没有适配的 SMAPI（不是「还没装」，是「装不了」）。</summary>
    private bool SmapiUnavailable => UpdateService.IsSmapiUnsupported(_gameVersion);

    private string SmapiPillClass => "jg-pill"
        + (_cfg.LaunchMode == "smapi" ? " active" : "")
        + (SmapiUnavailable ? " unavail" : "");
    private string? SmapiAriaDisabled => SmapiUnavailable ? "true" : null;
    private string? SmapiTip => SmapiUnavailable ? SmapiUnavailableTip : null;

    private string SmapiUnavailableTip
        => $"该游戏版本（{DisplayVersion}）没有可用的 SMAPI，只能用官方模式启动";

    // v1.1.2：设置页保存游戏目录后即时重探版本 —— AccountPanel 常驻 MainLayout 不会重建，
    // 之前保存后启动按钮一直「未定位」，要重启应用才消失。Saved 可能在后台线程触发 → InvokeAsync 回 UI（同 TaskDock.Refresh）。
    // v1.1.8：合并突发 —— 切档/批量启禁会对每个变更条目 Cfg.Save，每次 Saved 都 ProbeVersions
    // 就是对游戏 exe 连打 FileVersionInfo（启用集合差得越多越慢）。同一波只探一次。
    private int _probePending;

    private void HandleCfgSaved()
    {
        // v1.2.4：任何保存都要同步引用并重渲染。
        // v1.4.5：版本切换不会改游戏目录，但会改目录里的文件 —— 每次保存都重探版本号，
        // 否则切到 1.0 后按钮还停留在旧快照（实测：应用 1.0 后按钮一直显示 1.3.7269）。
        if (Interlocked.Exchange(ref _probePending, 1) == 1) return;
        InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(80);   // 吃掉同波后续 Save，只探一次
                _cfg = Cfg.Current;
                ProbeVersions();
                StateHasChanged();
            }
            finally { Interlocked.Exchange(ref _probePending, 0); }
        });
    }

    /// <summary>启动按钮上显示的版本号：文件内部版本号与最近一次应用的历史版本一致时，
    /// 显示对外的营销版本号（星露谷 1.4 的内部版本一直是 1.3.7269，直接显示会把人绕晕）。</summary>
    private string DisplayVersion
        => UpdateService.DisplayGameVersion(_gameVersion, _cfg.LastHistoricalLabel, _cfg.LastHistoricalInternalVersion);

    private void SetMode(string mode)
    {
        // 兜底：SMAPI 选项已经置灰，但键盘/脚本仍可能把点击送进来 —— 不能让用户
        // 停在一个「点启动必失败」的模式上。
        if (mode == "smapi" && SmapiUnavailable)
        {
            _ = JS.InvokeVoidAsync("junigridJs.toast", SmapiUnavailableTip, "err");
            return;
        }
        SaveCfg(c => c.LaunchMode = mode);
    }

    private async Task Launch()
    {
        // 覆盖包被禁用时不再弹窗拦一道：启停肖像由用户自己定（立绘页开关 / Mods 页禁用），
        // 启动自检会尊重禁用态并把选择留在配置里，重新启用后自动补齐。

        // 先给反馈再干活：把按钮翻成「启动中…」、让出 UI 线程并播动画，再真正启动，
        // 全程可被 ✕ 取消。（这里原本还要跑一次肖像全量扫描 + 覆盖包自检，随换肤子系统一起移除。）
        _launching = true;
        _launchCancelled = false;   // v1.1.2c：清掉上一次的取消标记
        StateHasChanged();
        try { await JS.InvokeVoidAsync("junigridJs.popAnimate", "#launch-btn"); } catch { }

        if (_launchCancelled) return;   // 被 ✕ 取消 → 不再启动

        // v1.3.1：点启动时重探本地版本 —— AccountPanel 常驻 MainLayout，游戏在启动器
        // 外被 Steam 更新/降级后按钮仍显示旧快照（用户报告"按钮显示 1.6.8 游戏里
        // 是 1.6.15"就是这个）。启动前对齐一次，显示与真实版本绝不打架。
        ProbeVersions();
        if (_launchCancelled) return;

        try
        {
            Steam.Refresh();
            _profile = Steam.GetProfile();
            StateHasChanged();

            // 放到后台线程：启动前可能要放回抽屉里暂存的档，那是同步磁盘活；
            // （本机实测抽屉里 439 MB）。留在 UI 线程上的话，点一次「启动游戏」界面会白屏十几秒，
            // 连「启动中…」都画不出来 —— 看着就是卡死。await 让出线程，状态先渲染出来。
            LaunchResult result = await Task.Run(() => _cfg.LaunchMode == "steam"
                ? Launcher.LaunchSteam(_cfg.SteamAppId)
                : Launcher.LaunchSmapi(_cfg.GamePath));

            if (result.Success)
            {
                SaveCfg(c =>
                {
                    c.LastLaunchTime = DateTime.Now.ToString("o");
                    c.TotalLaunchCount++;
                });
                _ = MaybeShowSponsorPromptAsync(_cfg.TotalLaunchCount);   // 第 10/100/200/500/1000… 次里程碑 → 弹一次赞助提示

                if (_cfg.LaunchMode == "smapi")
                {
                    // 跟 PCL 一样：SMAPI 启动后自动切到日志页看输出（运行态由进程轮询接管）
                    Nav.NavigateTo("/logs");
                }

                // 启动成功但进程可能还在被 Steam/运行时拉起：
                // 保持「启动中…」直到 IsGameRunning 真正为 true（或超时），避免回弹成「▶ 启动游戏」。
                _ = WaitForRunningAsync();
            }
            else if (result.GateKind is not null)
            {
                // 闸门主动拦下的（不是启动失败）：整段说明走弹窗，出口是「仍然启动」
                _gateText = result.Error;
                _launching = false;
                StateHasChanged();
            }
            else
            {
                // 启动失败 → toast 带上具体原因（此前只显示「启动失败」，
                // 没装 SMAPI 的用户完全不知道失败原因，也不知道该切官方模式）
                ShowToast(LocService.Tr("启动失败：") + SummarizeLaunchError(result.Error));
                _launching = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // v1.1.2：Launch 全程兜底 —— 此前 _launching=true 之后任何一步抛异常
            // （保存/导航/JS 调用等）都会让按钮永远卡在「启动中…」且无任何提示
            AppLog.Error("AccountPanel", "启动流程异常: " + ex.Message);
            ShowToast(LocService.Tr("启动流程异常：") + ex.Message);
            _launching = false;
            StateHasChanged();
        }
    }

    // 等待游戏真正进入运行态：期间按钮持续「启动中…」；超时/Steam 退出则回退为「▶ 启动游戏」。
    // v1.1.2c：任何退出路径（超时/取消/Steam 退出/异常）都保证复位 _launching，
    // 绝不让按钮永久卡在「启动中…」。
    // v1.1.2c：启动等待期的中途取消 —— 终断等待 + 关闭游戏进程（若已被拉起）。
    private volatile bool _launchCancelled;
    private volatile bool _cancelWatchdog;   // 取消清场看门狗运行中：期间轮询不把按钮翻成「运行中…」

    private void CancelLaunch()
    {
        if (!_launching) return;
        _launchCancelled = true;
        ShowToast(LocService.Tr("已取消本次启动"));
        _launching = false;    // WaitForRunningAsync 的 finally 也会兜底复位
        StateHasChanged();
        // Steam 的拉起管线可能在取消之后才把游戏进程拉出来（家庭共享校验要几秒），
        // 一次性 KillGame 会扑空 → 用看门狗持续清场 20s；期间若重新点启动则自动让位
        _cancelWatchdog = true;
        _ = Launcher.KillGameWatchdogAsync(20000, stopWhen: () => _launching || !_launchCancelled)
                .ContinueWith(_ => _cancelWatchdog = false);
    }

    private async Task WaitForRunningAsync(int timeoutMs = 45_000)
    {
        var deadline = Environment.TickCount64 + timeoutMs;
        var hinted = false;
        var steamGoneChecks = 0;
        var steamSeen = false;
        try
        {
            while (!_cts.IsCancellationRequested)
            {
                // 用户点了 ✕ 取消 → 立即退出（清场由 KillGameWatchdogAsync 接管）
                if (_launchCancelled) return;
                if (Launcher.IsGameRunning)
                {
                    // 真正进入了运行态：直接落地「运行中」，让「启动中」退出
                    _launching = false;
                    _isRunning = true;
                    StateHasChanged();
                    return;
                }
                // Steam 官方模式下 25 秒仍无游戏进程 → 大概率 Steam 在等用户处理
                // 弹窗（家庭共享「借用游戏」确认/登录/更新），或当前账号未拥有此游戏 ——
                // 之前只是默默干等，用户完全不知道 Steam 那边在等他点确认
                if (!hinted && _cfg.LaunchMode == "steam" && Environment.TickCount64 >= deadline - 20_000)
                {
                    hinted = true;
                    ShowToast(LocService.Tr("游戏尚未启动：请查看 Steam 是否弹出确认窗口。"));
                }
                // Steam 被关闭 → 没人能拉起游戏了，立即取消等待（之前要干等满超时，
                // 用户"关了 Steam 按钮还是启动中"的观感即来源于此）。
                // steam:// 协议拉起 Steam 需要几秒：先等见到过一次 Steam 才开始检测"消失"；
                // 若 12s 内 Steam 始终没出现，同样视为启动失败收场。
                if (_cfg.LaunchMode == "steam")
                {
                    if (LauncherService.IsSteamRunning) steamSeen = true;
                    if (steamSeen && !LauncherService.IsSteamRunning)
                    {
                        if (++steamGoneChecks >= 8)   // 连续 ~4s 不在才判定（防瞬间抖动）
                        {
                            ShowToast(LocService.Tr("Steam 已退出，已取消本次启动等待。"));
                            return;
                        }
                    }
                    else steamGoneChecks = 0;
                    if (!steamSeen && Environment.TickCount64 >= deadline - 30_000)
                    {
                        ShowToast(LocService.Tr("Steam 一直没有运行，已取消本次启动等待。可先启动 Steam 后再试，或改用 SMAPI。"));
                        return;
                    }
                }
                if (Environment.TickCount64 >= deadline)
                {
                    ShowToast(LocService.Tr("等待超时：未检测到游戏进程"));
                    return;
                }
                await Task.Delay(500, _cts.Token);
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _launching = false;
            StateHasChanged();
        }
    }

    // 主按钮统一入口：正在运行→弹确认框关游戏；否则启动。
    // v1.2.4：删掉「有更新 → 劫持成打开 Steam 商店」的分流 —— 本地旧版本本来就能玩
    //（SMAPI 模式不经过 Steam，Steam 模式想不被强升可锁版本），有更新时把启动入口
    // 换成更新入口，旧版玩家连「启动游戏」都点不到。更新意愿交给版本行上的箭头。
    private void OnButtonClick()
    {
        // v1.1.2c：启动等待期点 ✕ = 中途取消 —— 无论游戏有没有被拉起，直接终断等待并
        // 关闭游戏进程（与「运行中」的 ✕ 同一个按钮，行为按状态分流）
        if (_launching) { CancelLaunch(); return; }
        if (_isRunning)
        {
            _showConfirm = true;
            return;
        }
        _ = Launch();
    }

    // 取消关闭 / 点遮罩关闭 → 关闭确认框，不做任何事
    private void DismissConfirm()
    {
        _showConfirm = false;
    }

    // ── 「已经为你启动了 N 次」的赞助提示 ──
    // 里程碑（10/100/200/500，之后每 1000 次）必弹；没有里程碑时满 7 天兜底弹一次。
    // 启动游戏、启动器打开、以及应用长期不关时的定时检查都会走这里。
    // 先记账再显示 —— 弹窗一出来就算这次提示过了，不会有第二个并发检查再叠一层。
    private async Task MaybeShowSponsorPromptAsync(int launchCount, int promptDelayMs = 900)
    {
        try
        {
            // v1.2.12：记账从独立文件读（不跟整机共享的主配置混在一起）——
            // 主配置那份会被别的 JuniGrid 整份覆盖掉，抹掉「上次弹窗时间」就等于
            // 把弹窗重新武装，于是变成「每次启动都弹」（实机 2026-11-03）。
            var state = SponsorPromptState.LoadOrMigrate(Cfg.Current);
            var now = DateTime.Now;
            var should = SponsorPrompt.ShouldPrompt(launchCount, state.LastPromptedAt,
                                                    state.LastMilestone, now, state.Disabled);
            // 把判定输入与结论都记下来 —— 「为什么这次弹了/没弹」只看代码很难复现，
            // 而现场最常见的疑问正是这个（每次都弹）。一次启动最多三条，噪音可控。
            AppLog.Info("Sponsor",
                $"判定 count={launchCount} at={state.LastPromptedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "<null>"} " +
                $"里程碑={state.LastMilestone} supported={state.SupportedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "<null>"} " +
                $"disabled={state.Disabled} → {(should ? "弹" : "不弹")}");
            if (!should) return;
            if (SponsorPrompt.IsMilestone(launchCount) && launchCount > state.LastMilestone)
                state.LastMilestone = launchCount;
            state.LastPromptedAt = now;
            SponsorPromptState.Save(state);

            // 主配置里也留一份（给别的工具/老版本看得见），但它已经不是权威来源了。
            // SponsorPromptDisabled 这里恒为 false：老数据里的 true 已经在 LoadOrMigrate
            // 里转成「已支持」并清零，这一步顺手把主配置里那份旧 true 洗掉。
            var cfg = Cfg.Current;
            cfg.LastSponsorPromptAt = now;
            cfg.LastSponsorMilestone = state.LastMilestone;
            cfg.SponsorPromptDisabled = state.Disabled;
            Cfg.Save(cfg);

            await ShowSponsorPromptAsync(launchCount, promptDelayMs);
        }
        catch (Exception ex)
        {
            // 赞助提示永远不许影响启动流程 —— 它挂了最坏也就是这次没弹。
            AppLog.Warn("AccountPanel", "赞助提示未能显示: " + ex.Message);
        }
    }

    /// <summary>把弹窗摆到屏幕上。延迟一拍是为了让「启动中…」先落地 ——
    /// 弹窗和启动动画抢同一帧的话，用户会以为点了启动没反应。</summary>
    private async Task ShowSponsorPromptAsync(int launchCount, int delayMs = 900)
    {
        // 启动游戏那条路要等 900ms 让「启动中…」先落地；启动器打开这条路直接弹
        if (delayMs > 0) await Task.Delay(delayMs);
        await InvokeAsync(() =>
        {
            _sponsorLaunchCount = launchCount;
            // 游玩时长与首页「共 N 小时」同口径（PlayTimeService 全部年份秒数总和）
            _sponsorPlayHours = PlayTime.TotalSeconds <= 0
                ? "0" : (PlayTime.TotalSeconds / 3600.0).ToString("0.0");
            _sponsorStep = 0;
            _sponsorWechat = true;
            StateHasChanged();
        });
    }

    /// <summary>更新到这个版本后的第一次打开：老用户的启动次数早就过了 10，
    /// 不用等下次启动游戏 —— 首屏动画落定后补一次检查。</summary>
    private async Task CheckSponsorPromptAfterStartupAsync()
    {
        try
        {
            // 首屏落定就查，不再干等 2.5 秒 —— 之前加上启动 900ms 的延迟，用户体感要 4 秒以上
            await Task.Delay(200, _cts.Token);

            // 引导优先：它一出现就独占全屏，而且已经写过「看过」记档 —— 被盖住等于这次白弹。
            // 引导本次不弹时这个 Task 立刻完成，赞助提示的行为与之前完全一致。
            await StartupOverlayGate.WaitWelcomeAsync().WaitAsync(_cts.Token);

            await MaybeShowSponsorPromptAsync(Cfg.Current.TotalLaunchCount, promptDelayMs: 0);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { AppLog.Warn("AccountPanel", "启动时检查赞助提示失败: " + ex.Message); }
    }

    /// <summary>应用长期不关也要按 7 天节奏走 —— 每小时醒一次，到点就弹。</summary>
    private async Task SponsorPromptLoopAsync()
    {
        try
        {
            while (!_cts.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromHours(1), _cts.Token);
                await MaybeShowSponsorPromptAsync(Cfg.Current.TotalLaunchCount);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { AppLog.Warn("AccountPanel", "赞助提示定时检查异常: " + ex.Message); }
    }

    /// <summary>换屏：先量一下面板当前高度交给 JS 做弹簧，再换屏号。
    /// 新一屏的入场动画带 165ms 延迟 —— 等弹簧冲过目标高度之后内容才浮现，
    /// 所以"卡片在长大"的过程中不会有任何内容被裁掉（见 shell.css 的注释）。</summary>
    private async Task GoToSponsorStepAsync(int next)
    {
        if (next == _sponsorStep) return;
        try { await JS.InvokeVoidAsync("junigridJs.sponsorMeasure"); } catch { }
        _leavingStep = _sponsorStep;
        _sponsorStep = next;
        _ = ClearLeavingStepAsync();
    }

    private Task ShowSponsorSupport() => GoToSponsorStepAsync(1);

    private Task ShowForgotQr() => GoToSponsorStepAsync(2);

    private Task BackToQr() => GoToSponsorStepAsync(1);

    /// <summary>离场层留到弹簧跑完再摘（它 150ms 就淡透了，留着不挡视线也不吃鼠标）。</summary>
    private async Task ClearLeavingStepAsync()
    {
        try { await Task.Delay(700); } catch { }
        await InvokeAsync(() =>
        {
            _leavingStep = null;
            StateHasChanged();
        });
    }

    /// <summary>切微信/支付宝：换 key 让二维码卡片重新挂载，从而播放滑入+淡入动画。</summary>
    private void SelectQr(bool wechat)
    {
        if (_sponsorWechat == wechat) return;
        _qrDirection = wechat ? -1 : 1;
        _sponsorWechat = wechat;
        _qrTick++;
    }

    private void DismissSponsor()
    {
        _sponsorLaunchCount = 0;
        _sponsorStep = 0;
        _leavingStep = null;
        _sponsorRenderedStep = -1;   // 下次弹出还是"首开"，不播弹簧
    }

    /// <summary>用户在收款码页点了「已支持」：记下支持时间、致谢并收起弹窗。
    /// <para>这个按钮<b>不改变弹窗频率</b>：它没法验证用户到底付没付钱（扫码后点一下就算
    /// 「已支持」），所以只用 SupportedAt 记一笔账，提示节奏对所有人一致 —— 里程碑 + 7 天兜底。
    /// 将来「已捐赠用户专用无弹窗版」就靠这个字段区分。</para></summary>
    private void MarkSupported()
    {
        try
        {
            var state = SponsorPromptState.LoadOrMigrate(Cfg.Current);
            state.SupportedAt = DateTime.Now;
            SponsorPromptState.Save(state);
            AppLog.Info("Sponsor", "用户点了「已支持」→ 已记录支持时间（提示节奏不变，仍 7 天一次）");
        }
        catch (Exception ex)
        {
            // 记账失败不影响这次交互：最坏是下次按 7 天节奏再弹一次。
            AppLog.Warn("AccountPanel", "记录「已支持」失败: " + ex.Message);
        }
        DismissSponsor();
        _ = JS.InvokeVoidAsync("junigridJs.toast", Loc.T("谢谢你的支持！"), "ok");
    }

    /// <summary>爱发电主页用系统浏览器打开 —— WebView2 里 target=_blank 的行为不可靠，
    /// 不能让它把整个应用导航走。</summary>
    private void OpenAfdian()
    {
        try { MainWindow.OpenExternalUrl("https://ifdian.net/a/JuniGrid?tab=home"); }
        catch (Exception ex) { AppLog.Warn("AccountPanel", "打开爱发电失败: " + ex.Message); }
    }

    // 确认关闭游戏：先关确认框，再真正结束进程。
    // 关完必须回头再看一眼：Kill() 对被 Windows 错误报告扣住的进程（星谷闪退后尸体留在列表里，
    // 旁边挂着 WerFault.exe -u -p <pid>）不抛异常、也真的关不掉。这种沉默就是玩家报的
    // 「点关闭也没有用」，所以要把是谁、为什么说到屏幕上 —— 但只报实测到的原因，
    // 也不指挥人去任务管理器找：崩溃中的进程往往在玩家打字的几十秒里就被回收了，
    // 人去查一个查不到的 PID，只会反过来怀疑工具。
    private async Task KillGame()
    {
        _showConfirm = false;
        Launcher.KillGame();
        var stuck = await LauncherService.KillAgainAndExplain();
        if (stuck.Length == 0) return;
        ShowToast(LocService.Tf("这些游戏进程没能关闭：{0}",
            string.Join("、", stuck.Select(x => $"{x.Name} (PID {x.Pid}) — {x.Why}"))));
    }

    // 轮询真实游戏进程，让「关闭游戏」按钮在 SMAPI / Steam 官方两种模式都生效
    private async Task PollRunningAsync()
    {
        while (!_cts.IsCancellationRequested)
        {
            try
            {
                // 取消清场看门狗运行期间，Steam 迟到拉起的游戏进程不算「运行中」（马上会被清掉）
                var r = !_cancelWatchdog && Launcher.IsGameRunning;
                if (r != _isRunning)
                {
                    _isRunning = r;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { return; }
            catch (Exception ex)
            {
                // 这一轮抛了就退出循环的话，_isRunning 会永久冻在最后一次读到的 true 上，
                // 而代码里没有任何别的路径能把它翻回 false：之后点 ✕ 走的是「弹确认框 →
                // KillGame()」，系统里早就没有进程可杀，什么都不做、也不报错 ——
                // 玩家看到的就是「星谷闪退了，按钮一直运行中，点关闭也没用」。
                // 所以异常只能作废这一轮，不能让轮询死掉。
                AppLog.Warn("AccountPanel", "运行态轮询这一轮失败，1.5s 后重试: " + ex.Message);
            }
            try { await Task.Delay(1500, _cts.Token); }
            catch (OperationCanceledException) { return; }
        }
    }


    private void DismissGate()
    {
        _gateText = null;
        StateHasChanged();
    }

    /// <summary>
    /// 闸门弹窗上的「仍然启动」。闸门记住的是「这批读不了的档」这个指纹，90 秒内第二次点就放行并写日志 ——
    /// 所以这里只要原样再走一次启动流程，不需要任何绕过标记。
    /// </summary>
    private void LaunchAnyway()
    {
        _gateText = null;
        StateHasChanged();
        _ = Launch();
    }

    private void ShowToast(string text)
    {
        // v0.43.1：报错 → 红底白字 toast，同时落日志
        AppLog.Error("AccountPanel", text);
        _ = JS.InvokeVoidAsync("junigridJs.toast", text, "err");
    }

    /// <summary>
    /// v1.1.4：把启动失败的详细原因压成一行 toast 文案。
    /// SMAPI 缺失是最常见情形（官方模式用户刚填完目录就点 SMAPI 启动），
    /// 固定提示「装 SMAPI 或切官方模式」；其余取首行、超长截断。
    /// </summary>
    private static string SummarizeLaunchError(string? err)
    {
        if (string.IsNullOrWhiteSpace(err)) return LocService.Tr("未知原因");
        // 启动器这一档必须排在通用 SMAPI 判定之前：它说的不是"没装"，而是"没找到 / 认出多个"，
        // 压成「请先安装 SMAPI」会把用户引去重装（他明明装了，只是改了名）。
        if (err.Contains("SMAPI 启动器", StringComparison.OrdinalIgnoreCase))
            return LocService.Tr("没找到唯一的 SMAPI 启动器 —— 如果你把 StardewModdingAPI.exe 改了名，去「设置 → 启动项」里选中它");
        if (err.Contains("SMAPI", StringComparison.OrdinalIgnoreCase))
            return LocService.Tr("未检测到 SMAPI，请先安装 SMAPI，或在左上角切换「官方」模式启动");
        var line = err.Split('\n')[0].Trim().TrimEnd('。', '.');
        return line.Length > 60 ? line[..60] + "…" : line;
    }
}

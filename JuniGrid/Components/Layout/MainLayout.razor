@namespace JuniGrid.Components.Layout
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject TranslationService Trans
@inject NavigationManager Nav
@inject ConfigService Cfg
@inject LocalPackDelivery Delivery
@implements IDisposable

<div class="jg-shell" @onclick="OnAnyClickProbe" @onclick:stopPropagation="false">
    <TitleBar />

    <div class="jg-body">
        <AccountPanel />

        <div class="jg-content">
            <TopNav />
            <main class="jg-main">
                @Body
            </main>
            @* ── v1.1.2：返回顶部（Mod 管理 / Mod 详情 / Nexus 显示；滚过一屏才出现）──
               点击 GSAP 补间 scrollTop 丝滑滚回；放左边避开右下角任务中心悬浮球 ── *@
            <button id="jgBackTop" class="jg-backtop" data-tip='@Loc.T("回到顶部")' aria-label='@Loc.T("回到顶部")'>
                <img src="assets/back-top.svg" alt="" draggable="false" />
            </button>
        </div>
    </div>
</div>
<TaskDock />

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocChanged;
        Delivery.Delivered += OnLocalPackDelivered;
    }

    /// <summary>v1.8.x：有本地包送达时，若用户不在 Mod 管理页就带他过去 ——
    /// 安装结果、列表刷新都在那一页，留在原地装完等于什么都没看见。
    /// <para>真正的安装在 <c>Mods.razor</c>：它是唯一从队列里 <c>Take()</c> 的地方。
    /// 这里只管导航，不碰队列。</para></summary>
    private void OnLocalPackDelivered()
    {
        _ = InvokeAsync(() =>
        {
            try
            {
                if (!Nav.Uri.Contains("/mods", StringComparison.OrdinalIgnoreCase))
                    Nav.NavigateTo("/mods");
            }
            catch { }
        });
    }

    private void OnLocChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // v0.31.0：每次切页给 <main.jg-main> 播入场动画（PCL 风格）
        _ = InvokeAsync(async () =>
        {
            try { await JS.InvokeVoidAsync("junigridJs.playPageEnter"); } catch { }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)    {
        if (firstRender)
        {
            // 颜色主题 + 系统强调色：首帧应用（system 模式注入 Windows 强调色，其余走 CSS 主题块）
            try
            {
                var accentHex = await JS.InvokeAsync<string>("junigridJs.applyAccent",
                    Cfg.Current.Accent, JuniGrid.App.GetSystemAccentHex());
                MainWindow.ApplyAccent(accentHex);
            }
            catch { }
            // v0.20.0：不要一挂载完就通知 —— 那时 shell DOM 有了但 CSS 还没铺完，
            // WPF 层立刻淡入会看到深色兜底底色。让 JS 那边先等两帧 rAF + 一小段 stabilize，
            // 直到浅色主题真正绘制稳定，再通知 WPF 主窗淡入。
            // 兜底：调用失败（脚本未就绪）也不能变成未观察异常 —— App 侧另有 6s 强制揭示兜底。
            try { await JS.InvokeVoidAsync("junigridJs.splashUiReadyWhenStable"); }
            catch { }
            // v0.31.0：首次进入首页也播一次入场动画
            try { await JS.InvokeVoidAsync("junigridJs.playPageEnter"); } catch { }
            // v1.1.2：返回顶部按钮（滚动监听 + 路由显隐 + 点击丝滑回顶）
            try { await JS.InvokeVoidAsync("junigridJs.backTopInit"); } catch { }
            // v1.3.17：点击探针（JS 侧那半条）—— 与下面 OnAnyClickProbe 的 blazor 那半条配对
            if (Cfg.Current.UiClickProbe)
            {
                try { await JS.InvokeVoidAsync("junigridJs.clickProbe"); } catch { }
            }
            // v1.1.2：全局自动翻译观察器 —— 挂一次管所有页面，外文内容一出现就送翻
            try
            {
                await JS.InvokeVoidAsync("junigridJs.transInit",
                    Microsoft.JSInterop.DotNetObjectReference.Create(Trans));
                if (!Cfg.Current.TranslationEnabled)
                    await JS.InvokeVoidAsync("junigridJs.transSetEnabled", false);
            }
            catch { }
        }
    }

    /// <summary>
    /// v1.3.17：点击探针 —— 挂在 shell 最外层，靠 Blazor 的事件冒泡接住【任何】点击。
    /// <para>
    /// 实机反馈「点按钮一点反应都没有」时，只靠 [Perf] 探针分不清三种情况：
    /// ①点击根本没到 DOM（被某个全屏层吃掉 / 窗口没接到输入）；
    /// ②到了 DOM 但没送进 .NET（Blazor 电路异常）；
    /// ③进了 .NET 但处理器自己静默 return（_busy 之类的闸门）。
    /// 所以 JS 侧另有一条 <c>[Click] dom</c>（见 junigrid.ui.js 的 clickProbe），
    /// 这里写 <c>[Click] blazor</c>。三条日志一对，立刻能定位断在哪一段。
    /// </para>
    /// <para>只在诊断期开：Cfg.Current.UiClickProbe 为 false 时直接 return，零开销。</para>
    /// </summary>
    private void OnAnyClickProbe(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (!Cfg.Current.UiClickProbe) return;
        Services.AppLog.Info("Click", $"blazor 收到点击 | 页面={Nav.Uri} t={DateTime.Now:HH:mm:ss.fff}");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocChanged;
        Delivery.Delivered -= OnLocalPackDelivered;
    }
}

<!--
  启动流程（App.OnAppStartup）要求窗口先屏外挂载、Splash 播完再现身，
  系统级 CenterScreen 在 Show 时就会居中导致主窗提前露出，因此这里必须 Manual；
  真正的「所在显示器居中」由 MainWindow.RevealAtStartupPosition 在现身时计算。
-->
<Window x:Class="JuniGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JuniGrid.Components"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        Title="JuniGrid — Your Junimo helper"
        Height="1000" Width="1600"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#F3F6FB"
        ShowInTaskbar="True"
        Icon="Assets/junigrid-logo.ico">

    <!--
      AllowsTransparency must stay FALSE — WebView2 is a child HWND
      and layered/transparent windows cannot host it.
      Rounded corners come from DWM (see OnSourceInitialized).
    -->
    <!--
      CaptionHeight="0" 是关键：标题栏完全由 Blazor 自己画（jg-titlebar），
      拖动用 JS 回调调 DragMove（见 TitleBar.razor + junigridJs.enableWindowDrag）。
      之前 CaptionHeight="40" 会把顶部 40px 当作系统标题栏拦截，
      直接吃掉所有 Blazor 按钮（最小化/关闭）和内置浏览器工具栏的点击。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <blazor:BlazorWebView x:Name="blazorWebView"
                              HostPage="wwwroot/index.html"
                              Services="{StaticResource services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app"
                                      ComponentType="{x:Type local:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>

        <!-- ===== v1.1.2：主题切换圆形揭示覆盖层 =====
             切换主题时把旧主题页面截图铺在这里（盖在 WebView 上面），
             再用 OpacityMask 从开关位置挖一个不断变大的圆洞露出新主题。
             纯 WPF 绘制路径，完全绕开 WebView2 的 View Transitions 合成器缺陷。 -->
        <Image x:Name="ThemeRevealOverlay"
               Stretch="Fill"
               IsHitTestVisible="False"
               Visibility="Collapsed"/>

        <!-- 内置 Nexus 浏览器覆盖层已移除：统一改用系统浏览器跳转 -->

        <!-- ===== v1.8.x：本地 mod 压缩包拖放蒙层 =====
             必须用 WPF 画，不能用网页 DOM：外部拖放由注册在主窗 HWND 上的
             OLE drop target（WindowFileDropTarget）整层接管，网页收不到任何
             drag 事件。与 ThemeRevealOverlay 同级 —— 那一层已经证明 WPF 元素
             能盖在合成 WebView 之上。IsHitTestVisible=false：不挡任何交互。 -->
        <Border x:Name="DropHint"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Background="#CC0B1510">
            <Border x:Name="DropHintFrame"
                    Margin="36"
                    BorderBrush="#F3F6FB"
                    BorderThickness="3"
                    CornerRadius="18"
                    Background="#14F3F6FB">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="DropHintIconBg"
                            Width="136" Height="136"
                            CornerRadius="68"
                            Background="#24F3F6FB"
                            HorizontalAlignment="Center">
                        <Viewbox Width="80" Height="80"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <!-- 下载标志：箭头落进托盘，线条风格与 Mods 页的文件安装图标一致 -->
                                <Path Data="M12,4 V16 M7,11 L12,16 L17,11 M4,16 V18 A2,2 0 0 0 6,20 H18 A2,2 0 0 0 20,18 V16"
                                      Stroke="#FFF3F6FB"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="DropHintTitle"
                               Margin="0,26,0,0"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#FFF3F6FB"
                               HorizontalAlignment="Center"
                               Text="松手即安装"/>
                    <TextBlock x:Name="DropHintSub"
                               Margin="0,12,0,0"
                               FontSize="15"
                               Foreground="#B3F3F6FB"
                               HorizontalAlignment="Center"
                               Text="支持 zip / 7z / rar · mod / 内容包"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

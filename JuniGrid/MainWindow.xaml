<Window x:Class="JuniGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JuniGrid.Components"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JuniGrid — Your Junimo helper"
        Height="1110" Width="1974"
        MinHeight="864" MinWidth="1536"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#F3F6FB"
        ShowInTaskbar="True"
        Icon="Assets/junigrid-logo.ico">

    <!--
      AllowsTransparency must stay FALSE — WebView2 is a child HWND
      and layered/transparent windows cannot host it.
      Rounded corners come from DWM (see OnSourceInitialized).
    -->
    <!--
      CaptionHeight="0" 是关键：标题栏完全由 Blazor 自己画（jg-titlebar），
      拖动用 JS 回调调 DragMove（见 TitleBar.razor + junigridJs.enableWindowDrag）。
      之前 CaptionHeight="40" 会把顶部 40px 当作系统标题栏拦截，
      直接吃掉所有 Blazor 按钮（最小化/关闭）和内置浏览器工具栏的点击。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <blazor:BlazorWebView x:Name="blazorWebView"
                              HostPage="wwwroot/index.html"
                              Services="{StaticResource services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app"
                                      ComponentType="{x:Type local:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>

        <!-- ===== 内置 Nexus 浏览器：主窗口内的覆盖层 =====
             免费用户在这里点 Mod Manager Download，nxm:// 被拦截后自动安装。
             用独立的 WebView2 环境（自己的用户数据目录），避免和
             Blazor WebView 的状态冲突（0x8007139F）。 -->
        <!-- 嵌入内容区（而非全窗口覆盖）：让出标题栏40px + 侧栏232px + 顶导航46px，
             四周留页面内边距，看起来就是嵌在「Mod 管理」内容区里的浏览器面板。 -->
        <!-- 内置 Nexus 浏览器覆盖层已移除：统一改用系统浏览器跳转 -->
    </Grid>
</Window>

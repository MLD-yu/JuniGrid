<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JuniGridInstaller</RootNamespace>
    <AssemblyName>JuniGridSetup</AssemblyName>
    <!-- PE 版本资源里 FileDescription 只认 AssemblyTitle、CompanyName 只认 Company；
         不写就退化成 AssemblyName（用户属性页/UAC 上厂商显示「JuniGridSetup」）。
         注意 <ProductName> 对 apphost 无效，实测恒等于 AssemblyName，别往这儿加。 -->
    <AssemblyTitle>JuniGrid 安装程序</AssemblyTitle>
    <Company>JuniGrid</Company>
    <!-- 与主程序版本同步；build-installer.ps1 会从 JuniGrid.csproj 读取版本并覆盖它 -->
    <Version>1.2.9</Version>
    <ApplicationIcon>..\..\JuniGrid\Assets\junigrid-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- .NET 9 起 apphost 默认声明 CET 影子栈兼容，OS 便对整个进程执法：被注入的老 DLL
         或没打补丁的旧 ntdll 一违规就直接终止进程（Win11 21H2 那类停服机器启动即死）。
         关掉声明换老机器能起；代价是少一层 ROP 缓解，DEP/ASLR/CFG 不受影响。 -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.48.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\keyart.png" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- 安装内容：publish\sc 的 LZMA 固实容器（由 make-payload.ps1 / build-installer.ps1 经 PayloadTool 生成） -->
  <ItemGroup>
    <EmbeddedResource Include="payload.lz" Condition="Exists('payload.lz')" />
  </ItemGroup>

  <!-- payload.lz 缺失时兜底自动生成（正常走 build-installer.ps1） -->
  <Target Name="EnsurePayload" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildThisFileDirectory)payload.lz')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\make-payload.ps1&quot;" />
  </Target>

</Project>

<Window x:Class="JuniGridInstaller.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JuniGrid 安装"
        Width="500" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#0D0F12"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="0"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#2BC05A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3BD66B" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#22A44C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF5A66" />

    <!-- 主按钮：品牌绿大圆角 -->
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#0A140C" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="16" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#3AFFFFFF" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 文字幽灵按钮 -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C7FFFFFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1CFFFFFF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 文件夹按钮 -->
    <Style x:Key="FolderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标题栏按钮（最小化 / 关闭），Tag 可覆盖悬停底色 -->
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E6FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=#22FFFFFF}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- v1.0.18：退出确认对话框按钮（继续退出=黑底白字 / 取消=白底黑字），放在奶白卡片上 -->
    <Style x:Key="DarkPillButton" TargetType="Button">
      <Setter Property="Background" Value="#0D0F12" />
      <Setter Property="Foreground" Value="#F4F7F5" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="21" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#262B31" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LightPillButton" TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#0D0F12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="21" Background="{TemplateBinding Background}"
                    BorderBrush="#26000000" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EDEFE3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 深色复选框 -->
    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DDFFFFFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                      BorderThickness="1.5" BorderBrush="#66FFFFFF" Background="#14FFFFFF"
                      VerticalAlignment="Center">
                <Path x:Name="check" Data="M3,7.5 L7,11 L13.5,3.5"
                      Stroke="#0D0F12" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Margin="1,2,1,0" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="check" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="#99FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <!-- 立绘（顶部对齐，底部裁切）；完成时加模糊 -->
    <Image x:Name="KeyArt" Source="/Assets/keyart.png" Stretch="UniformToFill" VerticalAlignment="Top">
      <Image.Effect>
        <BlurEffect Radius="0" />
      </Image.Effect>
    </Image>

    <!-- 底部渐变遮罩，保证按钮可读 -->
    <Rectangle x:Name="BottomScrim" VerticalAlignment="Bottom" Height="300" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#000D0F12" Offset="0" />
          <GradientStop Color="#C80D0F12" Offset="0.72" />
          <GradientStop Color="#F20D0F12" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- 路径页的整窗压暗 -->
    <Rectangle x:Name="DimOverlay" Fill="#E00D0F12" Visibility="Collapsed" IsHitTestVisible="False" />

    <!-- ========== 欢迎页 ========== -->
    <Grid x:Name="WelcomeScreen">
      <StackPanel VerticalAlignment="Bottom" Margin="48,0,48,42">
        <Button x:Name="BtnInstallNow" Style="{StaticResource AccentButton}" Content="安　装" Height="58" FontSize="19" Click="OnInstallNow" />
        <Button x:Name="BtnAdvanced" Style="{StaticResource GhostButton}" Content="高 级 选 项" Margin="0,20,0,0" HorizontalAlignment="Center" Click="OnAdvanced" />
      </StackPanel>
    </Grid>

    <!-- ========== 路径页 ========== -->
    <Grid x:Name="PathScreen" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Bottom" Margin="36,0,36,36">
        <TextBlock Text="安装路径" FontSize="13" FontWeight="SemiBold" Foreground="#D9FFFFFF" />
        <Border CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" Height="52" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="54" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Margin="18,0,12,0" VerticalContentAlignment="Center"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#F4F7F5" CaretBrush="#F4F7F5" FontSize="14" />
            <Button x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource FolderButton}" Click="OnBrowse">
              <Path Data="M3.5,6.5 C3.5,5.4 4.4,4.5 5.5,4.5 H9.3 L11.3,6.5 H18.5 C19.6,6.5 20.5,7.4 20.5,8.5 V15.5 C20.5,16.6 19.6,17.5 18.5,17.5 H5.5 C4.4,17.5 3.5,16.6 3.5,15.5 Z"
                    Fill="#E6FFFFFF" Stretch="Uniform" Width="21" Height="21" />
            </Button>
          </Grid>
        </Border>
        <TextBlock x:Name="PathHint" Text="请输入有效的安装路径" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="4,8,0,0" Visibility="Collapsed" />
        <CheckBox x:Name="DeskShortcut" Content="创建桌面快捷方式" IsChecked="True" Margin="2,18,0,0" Style="{StaticResource DarkCheck}" />
        <Button x:Name="BtnInstall" Style="{StaticResource AccentButton}" Content="开 始 安 装" Height="56" FontSize="18" Margin="0,24,0,0" Click="OnInstall" />
        <Button x:Name="BtnBack" Style="{StaticResource GhostButton}" Content="返 回" Margin="0,16,0,0" HorizontalAlignment="Center" Click="OnBack" />
      </StackPanel>
    </Grid>

    <!-- ========== 安装进度页 ==========
         v1.0.17 布局：状态行在上，大号 已下载/总量 + 百分比 紧贴进度条上方（底部留 30 = 条高 12 + 18 间距） -->
    <Grid x:Name="ProgressScreen" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Bottom" Margin="36,0,36,30">
        <TextBlock x:Name="StatusText" Text="准备中…" FontSize="13" Foreground="#A6FFFFFF" TextTrimming="CharacterEllipsis" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SizeText" Text="" FontSize="20" FontWeight="Bold" Foreground="#F4F7F5" />
          <TextBlock x:Name="PercentText" Grid.Column="1" Text="" FontSize="20" FontWeight="Bold" Foreground="#F4F7F5" Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed">
          <Button x:Name="BtnRetry" Style="{StaticResource AccentButton}" Content="重　试" Height="42" FontSize="15" Width="120" Click="OnRetry" />
          <Button x:Name="BtnCloseErr" Style="{StaticResource GhostButton}" Content="关 闭" VerticalAlignment="Center" Margin="14,0,0,0" Click="OnCloseErr" />
        </StackPanel>
      </StackPanel>
      <Rectangle x:Name="ProgressTrack" VerticalAlignment="Bottom" Height="12" Fill="#4D2BC05A" />
      <Border x:Name="ProgressFill" VerticalAlignment="Bottom" Height="12" HorizontalAlignment="Left"
              Width="0" Background="{StaticResource AccentBrush}" />
      <!-- 完成态：底部中间 复选框 + 完成按钮 -->
      <StackPanel x:Name="DonePanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,46" Visibility="Collapsed">
        <CheckBox x:Name="LaunchAfterDone" Content="启动 JuniGrid" IsChecked="True" Style="{StaticResource DarkCheck}" HorizontalAlignment="Center" />
        <Button x:Name="BtnFinish" Style="{StaticResource AccentButton}" Content="完　成" Height="50" FontSize="16" Width="300" Margin="0,18,0,0" Click="OnFinish" />
      </StackPanel>
    </Grid>

    <!-- 完成态：居中标题 -->
    <TextBlock x:Name="DoneTitle" Text="安装完成" FontSize="30" FontWeight="Bold" Foreground="#F4F7F5"
               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock.Effect>
        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.6" Color="Black" />
      </TextBlock.Effect>
    </TextBlock>

    <!-- 品牌区：左上角 logo + 正常字体字样 + 版本 -->
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal">
        <Image Source="/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="JuniGrid" FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold" Foreground="#F4F7F5" VerticalAlignment="Center" Margin="10,2,0,0">
          <TextBlock.Effect>
            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.55" Color="Black" />
          </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="VersionText" Text="· v0.0.0" FontFamily="Segoe UI" FontSize="12" Foreground="#C7FFFFFF" VerticalAlignment="Center" Margin="8,3,0,0">
          <TextBlock.Effect>
            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5" Color="Black" />
          </TextBlock.Effect>
        </TextBlock>
      </StackPanel>
    </StackPanel>

    <!-- 窗口控制 -->
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Orientation="Horizontal">
      <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="最小化">
        <Path Data="M1,5 H11" Stroke="#E6FFFFFF" StrokeThickness="1.4" />
      </Button>
      <Button Style="{StaticResource ChromeButton}" Tag="#E81123" Click="OnClose" ToolTip="关闭">
        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#E6FFFFFF" StrokeThickness="1.4" />
      </Button>
    </StackPanel>

    <!-- ========== v1.0.17：安装进行中退出确认 ==========
         半途强退会留下半新半旧的文件（引擎无回滚，见 InstallerEngine），
         安装期间关窗（✕ / Alt+F4 / 任务栏关闭）先弹此确认；
         「继续退出」放行关闭（Closed → _cts.Cancel 在文件边界停止解压），「取消」继续安装 -->
    <Grid x:Name="ExitConfirmOverlay" Visibility="Collapsed">
      <Rectangle Fill="#A6000000" />
      <!-- v1.0.18：卡片改奶白 #FDFBDB（与更新气泡同色），文字反深色 -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="372"
              Background="#FDFBDB" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
          <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="28,26,28,24">
          <TextBlock Text="退出安装？" FontSize="17" FontWeight="Bold" Foreground="#171A12"
                     HorizontalAlignment="Center" />
          <TextBlock Text="安装未完成，强行退出可能导致文件损坏。" FontSize="13" Foreground="#4A4E3F"
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,0" />
          <TextBlock Text="之后可重新运行安装包继续安装。" FontSize="12" Foreground="#83866F"
                     HorizontalAlignment="Center" Margin="0,6,0,0" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button Style="{StaticResource DarkPillButton}" Content="继续退出" Width="132" Height="42" Click="OnForceExit" />
            <Button Style="{StaticResource LightPillButton}" Content="取 消" Width="110" Height="42" Margin="16,0,0,0" Click="OnCancelExit" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

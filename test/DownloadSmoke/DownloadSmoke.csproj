<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DownloadSmoke</AssemblyName>
  </PropertyGroup>
  <!-- 引用已构建的主程序：这个冒烟测试必须在“真实代码”上跑，不能复制一份逻辑。
       先 dotnet build JuniGrid/JuniGrid.csproj，再 build 本目录。 -->
  <ItemGroup>
    <Reference Include="JuniGrid">
      <HintPath>$(LOCALAPPDATA)\JuniGridBuild\Debug\net10.0-windows10.0.17763.0\JuniGrid.dll</HintPath>
    </Reference>
    <Reference Include="JuniGrid.Manifest">
      <HintPath>$(LOCALAPPDATA)\JuniGridBuild\Debug\net10.0-windows10.0.17763.0\JuniGrid.Manifest.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>

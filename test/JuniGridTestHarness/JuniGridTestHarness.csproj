<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- xunit.v3 自带 Microsoft.Testing.Platform 运行器：.NET 10 SDK 的 dotnet test 已弃用
         VSTest 集成，直接以可执行项目运行（dotnet run / 直接跑 exe）就是官方推荐的 MTP 方式 -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>JuniGridTestHarness</RootNamespace>
    <!-- 程序集名必须保持 JuniGridTestHarness：主项目 csproj 里已有
         <InternalsVisibleTo Include="JuniGridTestHarness" />（test-harness 时代的遗物），
         复用这个名字即可不改主项目任何文件拿到 internal（AtomicFile、ModService.ChooseFolderName）。 -->
    <AssemblyName>JuniGridTestHarness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- N 网真实返回的夹具（2026-10-07 抓取）：依赖解析回归用真实数据跑真实解析器，
         不靠手写 JSON（手写的形状容易和线上不一样，测了等于没测）。 -->
    <None Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\JuniGrid\JuniGrid.csproj" />
  </ItemGroup>

</Project>

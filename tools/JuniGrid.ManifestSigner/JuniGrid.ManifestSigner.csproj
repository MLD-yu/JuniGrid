<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JuniGrid.ManifestTool</RootNamespace>
    <AssemblyName>JuniGrid.ManifestSigner</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BaseOutputPath>$(LOCALAPPDATA)\JuniGridBuild\ManifestSigner\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\JuniGrid.Manifest\JuniGrid.Manifest.csproj" />
  </ItemGroup>

</Project>
